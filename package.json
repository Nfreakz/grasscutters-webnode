{
  "name": "grasscutters-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:web:wait\"",
    "dev:web": "astro dev --host 0.0.0.0 --port 4321",
    "dev:server": "tsx watch src/server/index.ts",
    "prebuild": "node scripts/gc-build-guard.mjs",
    "build": "astro build && node scripts/build-server.mjs && node scripts/prepare-hostinger-dist.mjs",
    "start": "node server.cjs",
    "preview": "npm run build && npm start",
    "check": "astro check",
    "format": "prettier . --write",
    "mysql:migrate-json": "node scripts/migrate-json-to-mysql.mjs",
    "sqlite:migrate-json": "node scripts/migrate-json-to-sqlite.mjs",
    "start:tsx": "tsx src/server/index.ts",
    "audit:project": "node scripts/project-audit.mjs",
    "quality": "node scripts/quality-gate.mjs",
    "quality:full": "node scripts/quality-gate.mjs --full",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "dev:web:wait": "node scripts/wait-for-api-and-start-web.mjs",
    "deps:baseline": "node scripts/dependency-baseline.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/node": "10.0.6",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "astro": "6.2.1",
    "concurrently": "9.2.1",
    "dotenv": "17.4.2",
    "esbuild": "0.27.7",
    "express": "5.2.1",
    "mysql2": "3.22.3",
    "sharp": "0.34.5",
    "sql.js": "1.14.1",
    "ssh2-sftp-client": "12.1.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/express": "5.0.6",
    "@types/node": "25.6.0",
    "prettier": "3.8.3"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
