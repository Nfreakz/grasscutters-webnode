---
import '../styles/global.css';
import '../styles/app-race-control.css';
import AuthHeader from '../components/AuthHeader.astro';
import PilotAvatarSystem from '../components/PilotAvatarSystem.astro';

const {
  title = 'GrassCutters Platform',
  description = 'GrassCutters Racing Platform',
  canonicalPath,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  noindex,
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || Astro.url.origin || 'https://grasscuttersracing.com').replace(/\/$/, '');
const normalizePath = (path) => {
  if (!path || path === '/') return '/';
  return path.replace(/\/$/, '');
};
const currentPathForSeo = normalizePath(Astro.url.pathname);
const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, siteUrl).toString();

const pageOgImages = {
  '/app': '/og/platform-og-v1531.png',
  '/hotlaps': '/og/hotlaps-og-v1531.png',
  '/combos': '/og/combos-og-v1531.png',
  '/pilotos': '/og/pilotos-og-v1531.png',
  '/perfil': '/og/perfil-og.png',
  '/login': '/og/login-og-v1531.png',
  '/herramientas/fov': '/og/fov-og-v1531.png',
  '/admin': '/og/admin-og.png',
};

/* GC_GLOBAL_SOCIAL_META_V15_31 START */
const routeSocialMeta = {
  '/app': {
    title: 'Panel | GrassCutters Racing',
    description: 'Panel de pista de GrassCutters Racing con combo activo, actividad reciente, hotlaps y accesos principales.',
    image: '/og/platform-og-v1531.png',
    imageAlt: 'Panel GrassCutters Racing',
  },
  '/hotlaps': {
    title: 'Hotlaps | GrassCutters Racing',
    description: 'Leaderboard de GrassCutters Racing con tiempos de referencia, filtros por piloto, coche, circuito y vueltas válidas.',
    image: '/og/hotlaps-og-v1531.png',
    imageAlt: 'Hotlaps GrassCutters Racing',
  },
  '/combos': {
    title: 'Combos | GrassCutters Racing',
    description: 'Centro de combos de GrassCutters Racing con circuitos, coches, actividad real y referencias para decidir dónde rodar.',
    image: '/og/combos-og-v1531.png',
    imageAlt: 'Combos GrassCutters Racing',
  },
  '/pilotos': {
    title: 'Pilotos | GrassCutters Racing',
    description: 'Directorio de pilotos de GrassCutters Racing con perfiles públicos, actividad reciente y datos desde stracker.',
    image: '/og/pilotos-og-v1531.png',
    imageAlt: 'Pilotos GrassCutters Racing',
  },
  '/herramientas/fov': {
    title: 'FOV Calculator | GrassCutters Racing',
    description: 'Calculadora de FOV para ajustar la visión del cockpit y mejorar la referencia en pista.',
    image: '/og/fov-og-v1531.png',
    imageAlt: 'FOV Calculator GrassCutters Racing',
  },
  '/login': {
    title: 'Login | GrassCutters Racing',
    description: 'Acceso a la plataforma GrassCutters Racing.',
    image: '/og/login-og-v1531.png',
    imageAlt: 'Login GrassCutters Racing',
  },
};

const exactRouteSocialMeta = routeSocialMeta[currentPathForSeo];

function resolveSeoText(value, fallback = '') {
  const text = compactSeoText(value, '');
  const generic = ['grasscutters racing platform', 'grasscutters platform', ''];
  if (generic.includes(text.toLowerCase())) return compactSeoText(fallback, text || fallback);
  return text || compactSeoText(fallback, '');
}
/* GC_GLOBAL_SOCIAL_META_V15_31 END */

function compactSeoText(value, fallback = '') {
  return String(value || fallback || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 220);
}

function absoluteSeoUrl(value) {
  const raw = String(value || '').trim();
  if (!raw) return new URL('/og/platform-og-v1531.png', siteUrl).toString();
  if (/^https?:\/\//i.test(raw)) return raw;
  return new URL(raw.startsWith('/') ? raw : '/' + raw, siteUrl).toString();
}

function seoImageMime(value) {
  const clean = String(value || '').split('?')[0].toLowerCase();
  if (clean.endsWith('.jpg') || clean.endsWith('.jpeg')) return 'image/jpeg';
  if (clean.endsWith('.webp')) return 'image/webp';
  if (clean.endsWith('.svg')) return 'image/svg+xml';
  return 'image/png';
}

const cleanTitle = resolveSeoText(title, exactRouteSocialMeta?.title || 'GrassCutters Platform');
const cleanDescription = resolveSeoText(description, exactRouteSocialMeta?.description || 'Panel de pista, hotlaps, combos y perfiles de GrassCutters Racing.');
const matchedOgImage = pageOgImages[currentPathForSeo] || Object.entries(pageOgImages).find(([prefix]) => currentPathForSeo.startsWith(prefix + '/'))?.[1];
const selectedOgImage = ogImage || exactRouteSocialMeta?.image || matchedOgImage || '/og/platform-og-v1531.png';
const absoluteOgImage = absoluteSeoUrl(selectedOgImage);
const cleanOgImageAlt = compactSeoText(ogImageAlt, exactRouteSocialMeta?.imageAlt || 'Imagen social de ' + cleanTitle);
const ogImageType = seoImageMime(selectedOgImage);
const shouldNoindex = noindex ?? (currentPathForSeo.startsWith('/admin') || currentPathForSeo.startsWith('/perfil'));


const current = normalizePath(Astro.url.pathname);
const championshipNavItems = [
  { href: '/campeonato', label: 'Campeonato ACSM', match: '/campeonato' },
  { href: '/historico', label: 'Histórico ACSM', match: '/historico' },
  { href: '/carreras-comunidad', label: 'Carreras no oficiales', match: '/carreras-comunidad' },
];
const ratingsNavItems = [
  { href: '/ratings', label: 'Safety Rating', match: '/ratings' },
  { href: '/ratings/gsr', label: 'GrassCutters Skill Rating', match: '/ratings/gsr' },
  { href: '/ratings/faq', label: 'FAQ', match: '/ratings/faq' },
];
const platformNavItems = [
  { href: '/app', label: 'Panel', match: '/app' },
  { href: '/hotlaps', label: 'Hotlaps', match: '/hotlaps' },
  { href: '/pilotos', label: 'Pilotos', match: '/pilotos' },
  { href: '/combos', label: 'Combos', match: '/combos' },
];
function appLayoutIsActive(match) {
  if (match === '/') return current === '/';
  return current === match || current.startsWith(`${match}/`);
}
function appLayoutGroupActive(items) {
  return items.some((item) => appLayoutIsActive(item.match));
}
const nav = [
  { href: '/app', label: 'Panel', code: '01' },
  { href: '/hotlaps', label: 'Hotlaps', code: '02' },
  { href: '/pilotos', label: 'Pilotos', code: '03' },
  { href: '/combos', label: 'Combos', code: '04' },
  {
    label: 'Herramientas',
    code: '05',
    children: [
      { href: '/herramientas/fov', label: 'FOV Calculator', code: '05.1' }
    ]
  },
  { href: '/perfil', label: 'Perfil', code: '06' },
  { href: '/admin', label: 'Admin', code: '07', adminOnly: true }
];
---
<!doctype html>
<html lang="es" data-theme="grasscutters" data-gc-scope="app" data-auth-ready="false" data-auth="unknown" data-admin="false">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={cleanDescription} />
    <meta name="robots" content={shouldNoindex ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="theme-color" content="#07110a" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content="GrassCutters Racing" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cleanOgImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={cleanOgImageAlt} />
    <meta name="twitter:url" content={canonicalUrl} />

    <title>{cleanTitle}</title>
  </head>
  <body>
    <a class="gc-skip" href="#contenido">Saltar al contenido</a>
    <div class="gc-shell">
      <div class="gc-nav-backdrop" data-menu-close></div>

      <aside class="gc-rail" aria-label="Panel lateral GrassCutters">
        <a class="gc-brand" href="/" aria-label="Ir a la home pública de GrassCutters Racing" title="Ir a la home pública">
          <span class="gc-brand__mark gc-brand__mark--logo"><img src="/images/newlogo.png" alt="" loading="eager" /></span>
          <span class="gc-brand__copy">
            <strong>GrassCutters</strong>
            <small>Racing Platform</small>
          </span>
        </a>

        <nav class="gc-railnav" aria-label="Navegación principal">
          {nav.map((item) => (
            item.children ? (
              <div class:list={['gc-railnav__group', { 'is-open': item.children.some((child) => normalizePath(child.href) === current) }]} data-nav-group>
                <button
                  class="gc-railnav__parent"
                  type="button"
                  aria-expanded={item.children.some((child) => normalizePath(child.href) === current) ? 'true' : 'false'}
                  data-nav-group-toggle>
                  <span>{item.code}</span>
                  <strong>{item.label}</strong>
                  <em>▾</em>
                </button>
                <div class="gc-railnav__children" data-nav-group-panel>
                  {item.children.map((child) => (
                    <a href={child.href} class="gc-railnav__child" aria-current={normalizePath(child.href) === current ? 'page' : undefined}>
                      <span>{child.code}</span>
                      <strong>{child.label}</strong>
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={normalizePath(item.href) === current ? 'page' : undefined} data-admin-only={item.adminOnly ? '' : undefined} hidden={item.adminOnly ? true : undefined}>
                <span>{item.code}</span>
                <strong>{item.label}</strong>
              </a>
            )
          ))}
        </nav>

        <div class="gc-railmeta gc-railmeta--system-v1535" aria-label="Estado técnico">
          <h3>Sistema</h3>
          <dl>
            <div><dt>Web</dt><dd>Astro</dd></div>
            <div><dt>API</dt><dd>Node</dd></div>
            <div><dt>DB</dt><dd>Stracker</dd></div>
          </dl>
        </div>
      </aside>

      <div class="gc-app">
        <header class="gc-topbar gc-app-public-header" data-app-public-header>
          <a class="gc-app-public-brand" href="/" aria-label="GrassCutters Racing - inicio">
            <span class="gc-app-public-brand__mark"><img src="/images/newlogo-512.webp" alt="" loading="eager" decoding="async" /></span>
            <span class="gc-app-public-brand__copy"><strong>GrassCutters</strong><small>Racing Community</small></span>
          </a>

          <nav class="gc-app-public-nav" aria-label="Navegación principal">
            <a href="/" class:list={[{ 'is-active': appLayoutIsActive('/') }]}>INICIO</a>
            <a href="/comunidad" class:list={[{ 'is-active': appLayoutIsActive('/comunidad') }]}>COMUNIDAD</a>
            <details class="gc-app-public-dropdown" data-active={appLayoutGroupActive(championshipNavItems) ? 'true' : undefined}>
              <summary>CAMPEONATO</summary>
              <div class="gc-app-public-dropdown__menu" role="menu" aria-label="Secciones de campeonato">
                {championshipNavItems.map((item) => (<a href={item.href} data-active={appLayoutIsActive(item.match) ? 'true' : undefined} role="menuitem">{item.label}</a>))}
              </div>
            </details>
            <details class="gc-app-public-dropdown" data-active={appLayoutGroupActive(ratingsNavItems) ? 'true' : undefined}>
              <summary>RATINGS</summary>
              <div class="gc-app-public-dropdown__menu" role="menu" aria-label="Secciones de ratings">
                {ratingsNavItems.map((item) => (<a href={item.href} data-active={appLayoutIsActive(item.match) ? 'true' : undefined} role="menuitem">{item.label}</a>))}
              </div>
            </details>
            <a href="/calendario" class:list={[{ 'is-active': appLayoutIsActive('/calendario') }]}>CALENDARIO</a>
            <a href="/archivo" class:list={[{ 'is-active': appLayoutIsActive('/archivo') }]}>ARCHIVO</a>
            <details class="gc-app-public-dropdown" data-active={appLayoutGroupActive(platformNavItems) ? 'true' : undefined}>
              <summary>PLATAFORMA</summary>
              <div class="gc-app-public-dropdown__menu" role="menu" aria-label="Secciones de plataforma">
                {platformNavItems.map((item) => (<a href={item.href} data-active={appLayoutIsActive(item.match) ? 'true' : undefined} role="menuitem">{item.label}</a>))}
              </div>
            </details>
          </nav>

          <div class="gc-app-public-actions gc-public-actions">
            <span class="gc-auth-status" data-auth-status hidden>Conectado</span>
            <a class="gc-login-link" href="/login" data-auth-link>Login</a>
            <button class="gc-auth-logout" type="button" data-auth-logout hidden>Salir</button>
          </div>
        </header>

        <main class="gc-main" id="contenido">
          <slot />
        </main>
      </div>
    </div>

    <style is:global>
      html[data-gc-scope="app"] .gc-shell{
        display:block!important;
        grid-template-columns:1fr!important;
      }
      html[data-gc-scope="app"] .gc-shell::before,
      html[data-gc-scope="app"] .gc-nav-backdrop,
      html[data-gc-scope="app"] .gc-rail,
      html[data-gc-scope="app"] .gc-menu-button{
        display:none!important;
      }
      html[data-gc-scope="app"] .gc-app{
        min-width:0!important;
        width:100%!important;
      }
      html[data-gc-scope="app"] .gc-main{
        width:min(1720px, calc(100vw - 48px))!important;
        max-width:1720px!important;
        margin:0 auto!important;
        padding:22px 0 56px!important;
        box-sizing:border-box!important;
      }

      html[data-gc-scope="app"] .gc-app-public-header{
        position:sticky!important;
        top:0!important;
        z-index:80!important;
        min-height:64px!important;
        display:grid!important;
        grid-template-columns:auto minmax(0,1fr) auto!important;
        align-items:center!important;
        gap:24px!important;
        width:100%!important;
        padding:0 28px!important;
        border-bottom:1px solid rgba(255,255,255,.07)!important;
        background:linear-gradient(180deg, rgba(2,6,4,.98), rgba(2,6,4,.92))!important;
        backdrop-filter:blur(14px)!important;
      }
      html[data-gc-scope="app"] .gc-app-public-brand{
        display:flex!important;
        align-items:center!important;
        gap:10px!important;
        color:#f4fff1!important;
        text-decoration:none!important;
        min-width:178px!important;
      }
      html[data-gc-scope="app"] .gc-app-public-brand__mark,
      html[data-gc-scope="app"] .gc-app-public-brand__mark img{
        width:42px!important;
        height:42px!important;
        object-fit:contain!important;
        display:block!important;
      }
      html[data-gc-scope="app"] .gc-app-public-brand__copy{
        display:grid!important;
        line-height:.9!important;
        text-transform:uppercase!important;
      }
      html[data-gc-scope="app"] .gc-app-public-brand__copy strong{
        color:#f4fff1!important;
        font-size:14px!important;
        font-weight:950!important;
        letter-spacing:.03em!important;
      }
      html[data-gc-scope="app"] .gc-app-public-brand__copy small{
        color:#96ff2f!important;
        font-family:var(--gc-mono,"JetBrains Mono",monospace)!important;
        font-size:9px!important;
        font-weight:950!important;
        letter-spacing:.12em!important;
      }
      html[data-gc-scope="app"] .gc-app-public-nav{
        display:flex!important;
        align-items:center!important;
        justify-content:center!important;
        gap:22px!important;
        min-width:0!important;
      }
      html[data-gc-scope="app"] .gc-app-public-nav > a,
      html[data-gc-scope="app"] .gc-app-public-dropdown > summary{
        position:relative!important;
        display:inline-flex!important;
        align-items:center!important;
        min-height:34px!important;
        padding:0 0 7px!important;
        border:0!important;
        background:transparent!important;
        color:rgba(244,255,241,.76)!important;
        font-family:var(--gc-mono,"JetBrains Mono",monospace)!important;
        font-size:11px!important;
        font-weight:950!important;
        letter-spacing:.10em!important;
        text-transform:uppercase!important;
        text-decoration:none!important;
        cursor:pointer!important;
        list-style:none!important;
      }
      html[data-gc-scope="app"] .gc-app-public-dropdown > summary::-webkit-details-marker{ display:none!important; }
      html[data-gc-scope="app"] .gc-app-public-dropdown > summary::after{ content:'⌄'; margin-left:5px; color:currentColor; font-size:10px; }
      html[data-gc-scope="app"] .gc-app-public-nav > a::before,
      html[data-gc-scope="app"] .gc-app-public-dropdown > summary::before{
        content:'';
        position:absolute;
        left:0;
        right:0;
        bottom:0;
        height:2px;
        background:#96ff2f;
        transform:scaleX(0);
        transform-origin:center;
        transition:transform .16s ease;
      }
      html[data-gc-scope="app"] .gc-app-public-nav > a:hover,
      html[data-gc-scope="app"] .gc-app-public-nav > a.is-active,
      html[data-gc-scope="app"] .gc-app-public-dropdown:hover > summary,
      html[data-gc-scope="app"] .gc-app-public-dropdown:focus-within > summary,
      html[data-gc-scope="app"] .gc-app-public-dropdown[data-active="true"] > summary{
        color:#96ff2f!important;
      }
      html[data-gc-scope="app"] .gc-app-public-nav > a:hover::before,
      html[data-gc-scope="app"] .gc-app-public-nav > a.is-active::before,
      html[data-gc-scope="app"] .gc-app-public-dropdown:hover > summary::before,
      html[data-gc-scope="app"] .gc-app-public-dropdown:focus-within > summary::before,
      html[data-gc-scope="app"] .gc-app-public-dropdown[data-active="true"] > summary::before{
        transform:scaleX(1);
      }
      html[data-gc-scope="app"] .gc-app-public-dropdown{
        position:relative!important;
        background:transparent!important;
        border:0!important;
      }
      html[data-gc-scope="app"] .gc-app-public-dropdown__menu{
        position:absolute!important;
        top:calc(100% + 8px)!important;
        left:50%!important;
        transform:translateX(-50%)!important;
        min-width:230px!important;
        display:none!important;
        padding:8px!important;
        border:1px solid rgba(150,255,47,.24)!important;
        background:rgba(2,7,4,.97)!important;
        box-shadow:0 18px 40px rgba(0,0,0,.34)!important;
      }
      html[data-gc-scope="app"] .gc-app-public-dropdown:hover .gc-app-public-dropdown__menu,
      html[data-gc-scope="app"] .gc-app-public-dropdown:focus-within .gc-app-public-dropdown__menu,
      html[data-gc-scope="app"] .gc-app-public-dropdown[open] .gc-app-public-dropdown__menu{
        display:grid!important;
        gap:4px!important;
      }
      html[data-gc-scope="app"] .gc-app-public-dropdown__menu a{
        display:block!important;
        padding:9px 10px!important;
        color:rgba(244,255,241,.78)!important;
        font-family:var(--gc-mono,"JetBrains Mono",monospace)!important;
        font-size:10px!important;
        font-weight:950!important;
        letter-spacing:.08em!important;
        text-transform:uppercase!important;
        text-decoration:none!important;
        border:1px solid transparent!important;
      }
      html[data-gc-scope="app"] .gc-app-public-dropdown__menu a:hover,
      html[data-gc-scope="app"] .gc-app-public-dropdown__menu a[data-active="true"]{
        color:#96ff2f!important;
        border-color:rgba(150,255,47,.32)!important;
        background:rgba(150,255,47,.08)!important;
      }
      html[data-gc-scope="app"] .gc-app-public-actions{
        display:flex!important;
        align-items:center!important;
        justify-content:flex-end!important;
        gap:10px!important;
        min-width:180px!important;
      }
      html[data-gc-scope="app"] .gc-app-public-actions .gc-user-menu-v1533{
        display:none;
      }
      html[data-gc-scope="app"][data-auth="true"] .gc-app-public-actions .gc-user-menu-v1533{
        display:flex!important;
      }
      html[data-gc-scope="app"] .gc-login-link,
      html[data-gc-scope="app"] .gc-auth-logout{
        color:rgba(244,255,241,.78)!important;
        font-family:var(--gc-mono,"JetBrains Mono",monospace)!important;
        font-size:10px!important;
        font-weight:950!important;
        letter-spacing:.10em!important;
        text-transform:uppercase!important;
        text-decoration:none!important;
        background:transparent!important;
        border:0!important;
      }
      @media(max-width:980px){
        html[data-gc-scope="app"] .gc-app-public-header{grid-template-columns:auto 1fr;gap:12px;padding-inline:16px!important;}
        html[data-gc-scope="app"] .gc-app-public-nav{grid-column:1 / -1;justify-content:flex-start;overflow:auto;gap:16px;padding-bottom:6px;}
        html[data-gc-scope="app"] .gc-app-public-actions{position:absolute;right:16px;top:18px;}
        html[data-gc-scope="app"] .gc-main{width:min(100%, calc(100vw - 24px))!important;padding-top:16px!important;}
      }
    </style>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.querySelector('[data-menu-toggle]');
        const closeTargets = document.querySelectorAll('[data-menu-close], .gc-railnav a');
        const setOpen = (open) => {
          root.classList.toggle('gc-nav-open', open);
          btn?.setAttribute('aria-expanded', String(open));
        };
        btn?.addEventListener('click', () => setOpen(!root.classList.contains('gc-nav-open')));
        closeTargets.forEach((el) => el.addEventListener('click', () => setOpen(false)));

        document.querySelectorAll('[data-nav-group]').forEach((group) => {
          const toggle = group.querySelector('[data-nav-group-toggle]');
          const panel = group.querySelector('[data-nav-group-panel]');
          if (!toggle || !panel) return;

          toggle.addEventListener('click', () => {
            const isOpen = group.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(isOpen));
          });
        });

        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
      })();
    </script>
    <PilotAvatarSystem />
    <AuthHeader />
  </body>
</html>
