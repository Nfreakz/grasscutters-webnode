  <div class="gc-floating-hero-story__quote">Comunidad, tandas y hierba en las ruedas.</div>
</section>

<script is:inline>
  (() => {
    const init = () => {
      const body = document.body;
      const logo = document.querySelector('[data-gc-floating-hero-logo]');
      const story = document.querySelector('[data-gc-floating-hero-story]');
      const storyClose = document.querySelector('[data-gc-floating-hero-story-close]');
      if (!body || !logo || !story) return;

      const route = String(body.dataset.publicRoute || window.location.pathname || '').replace(/\/$/, '') || '/';
      if (route === '/app' || route.startsWith('/app/')) {
        logo.hidden = true;
        story.hidden = true;
        return;
      }

      const storageKey = 'gc-floating-hero-logo-position-v40';
      const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

      const setPos = (x, y) => {
        const rect = logo.getBoundingClientRect();
        const maxX = Math.max(0, window.innerWidth - rect.width);
        const maxY = Math.max(0, window.innerHeight - rect.height);
        const nextX = clamp(x, 0, maxX);
        const nextY = clamp(y, 0, maxY);
        logo.style.setProperty('left', `${nextX}px`, 'important');
        logo.style.setProperty('top', `${nextY}px`, 'important');
        return { x: nextX, y: nextY };
      };

      const positionStory = () => {
        if (story.hidden) return;

        const logoRect = logo.getBoundingClientRect();
        const storyRect = story.getBoundingClientRect();
        const gap = 12;

        let left = logoRect.right + gap;
        if (left + storyRect.width > window.innerWidth - 12) {
          left = logoRect.left - storyRect.width - gap;
        }
        if (left < 12) left = 12;

        let top = logoRect.top + 8;
        if (top + storyRect.height > window.innerHeight - 12) {
          top = window.innerHeight - storyRect.height - 12;
        }
        if (top < 12) top = 12;

        story.style.setProperty('left', `${left}px`, 'important');
        story.style.setProperty('top', `${top}px`, 'important');
      };

      const openStory = () => {
        story.hidden = false;
        requestAnimationFrame(() => {
          positionStory();
          story.classList.add('is-open');
        });
      };

      const closeStory = () => {
        story.classList.remove('is-open');
        window.setTimeout(() => {
          if (!story.classList.contains('is-open')) story.hidden = true;
        }, 180);
      };

      const toggleStory = () => {
        if (story.hidden || !story.classList.contains('is-open')) openStory();
        else closeStory();
      };

      const updateScrollVisibility = () => {
        const shouldHide = window.scrollY > 80;
        logo.classList.toggle('is-scroll-hidden', shouldHide);
        if (shouldHide) closeStory();
      };

      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
        if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y)) {
          requestAnimationFrame(() => setPos(saved.x, saved.y));
        }
      } catch (_) {}

      let dragging = false;
      let moved = false;
      let startX = 0;
      let startY = 0;
      let startLeft = 0;
      let startTop = 0;
      let activePointerId = null;

      const begin = (clientX, clientY, pointerId = null) => {
        if (logo.classList.contains('is-scroll-hidden')) return;
        const rect = logo.getBoundingClientRect();
        dragging = true;
        moved = false;
        startX = clientX;
        startY = clientY;
        startLeft = rect.left;
        startTop = rect.top;
        activePointerId = pointerId;
        logo.classList.add('is-dragging');
      };

      const move = (clientX, clientY) => {
        if (!dragging) return;
        const dx = clientX - startX;
        const dy = clientY - startY;
        if (Math.abs(dx) > 2 || Math.abs(dy) > 2) moved = true;
        setPos(startLeft + dx, startTop + dy);
        positionStory();
      };

      const end = () => {
        if (!dragging) return;
        dragging = false;
        logo.classList.remove('is-dragging');
        const rect = logo.getBoundingClientRect();
        localStorage.setItem(storageKey, JSON.stringify({ x: rect.left, y: rect.top }));
        activePointerId = null;
      };

      if (window.PointerEvent) {
        logo.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          begin(event.clientX, event.clientY, event.pointerId);
          logo.setPointerCapture?.(event.pointerId);
          event.preventDefault();
          event.stopPropagation();
        });

        logo.addEventListener('pointermove', (event) => {
          if (!dragging || event.pointerId !== activePointerId) return;
          move(event.clientX, event.clientY);
          event.preventDefault();
          event.stopPropagation();
        });

        logo.addEventListener('pointerup', (event) => {
          if (event.pointerId !== activePointerId) return;
          logo.releasePointerCapture?.(event.pointerId);
          end();
          event.preventDefault();
          event.stopPropagation();
        });

        logo.addEventListener('pointercancel', end);
      }

      logo.addEventListener('mousedown', (event) => {
        if (window.PointerEvent) return;
        if (event.button !== 0) return;
        begin(event.clientX, event.clientY);
        event.preventDefault();
        event.stopPropagation();
      });

      window.addEventListener('mousemove', (event) => {
        if (window.PointerEvent || !dragging) return;
        move(event.clientX, event.clientY);
        event.preventDefault();
      });

      window.addEventListener('mouseup', () => {
        if (window.PointerEvent) return;
        end();
      });

      logo.addEventListener('touchstart', (event) => {
        if (window.PointerEvent) return;
        const touch = event.touches && event.touches[0];
        if (!touch) return;
        begin(touch.clientX, touch.clientY);
        event.preventDefault();
      }, { passive:false });

      window.addEventListener('touchmove', (event) => {
        if (window.PointerEvent || !dragging) return;
        const touch = event.touches && event.touches[0];
        if (!touch) return;
        move(touch.clientX, touch.clientY);
        event.preventDefault();
      }, { passive:false });

      window.addEventListener('touchend', () => {
        if (window.PointerEvent) return;
        end();
      });

      logo.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (logo.classList.contains('is-scroll-hidden')) return;
        if (moved) {
          moved = false;
          return;
        }
        toggleStory();
      });

      storyClose?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        closeStory();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeStory();
      });

      document.addEventListener('click', (event) => {
        if (story.hidden) return;
        const target = event.target;
        if (logo.contains(target) || story.contains(target)) return;
        closeStory();
      });

      window.addEventListener('scroll', updateScrollVisibility, { passive:true });

      window.addEventListener('resize', () => {
        const rect = logo.getBoundingClientRect();
        const pos = setPos(rect.left, rect.top);
        localStorage.setItem(storageKey, JSON.stringify(pos));
        positionStory();
        updateScrollVisibility();
      });

      updateScrollVisibility();
    };

    const initHomeEnhancements = () => {
      const champBtn = document.querySelector('.gc-home2-championship-btn');
      if (champBtn) {
        champBtn.textContent = 'Inscribirse al campeonato';
        champBtn.setAttribute('href', 'http://185.216.144.78:8840/championship/ad89ce26-0206-40f2-adec-451cf221d4e6/sign-up/steam');
        champBtn.setAttribute('target', '_blank');
        champBtn.setAttribute('rel', 'noreferrer');
        champBtn.classList.add('gc-home2-btn--primary');
        champBtn.style.setProperty('background', 'linear-gradient(135deg, #96ff2f, #80f016)', 'important');
        champBtn.style.setProperty('background-color', '#96ff2f', 'important');
        champBtn.style.setProperty('color', '#071006', 'important');
        champBtn.style.setProperty('border-color', 'rgba(150,255,47,.62)', 'important');
        champBtn.style.setProperty('box-shadow', '0 10px 34px rgba(150,255,47,.13)', 'important');
        champBtn.style.setProperty('min-height', '40px', 'important');
        champBtn.style.setProperty('height', '40px', 'important');
        champBtn.style.setProperty('padding', '0 20px', 'important');
        champBtn.style.setProperty('border-radius', '4px', 'important');
        champBtn.style.setProperty('opacity', '1', 'important');
        champBtn.style.setProperty('text-shadow', 'none', 'important');
      }

      const serverRows = document.querySelector('.gc-home2-server-rows--v8');
      if (serverRows && !serverRows.querySelector('[data-gc-server-combo-laps-row]')) {
        const row = document.createElement('div');
        row.setAttribute('data-gc-server-combo-laps-row', '');
        row.innerHTML = '<dt>Vueltas combo</dt><dd data-home2-server-combo-laps>--</dd>';
        const activeCarsRow = serverRows.querySelector('[data-home2-server-active-cars]')?.closest('div');
        if (activeCarsRow && activeCarsRow.nextSibling) serverRows.insertBefore(row, activeCarsRow.nextSibling);
        else serverRows.appendChild(row);
      }

      const firstValue = (obj, paths) => {
        for (const path of paths) {
          const parts = String(path).split('.');
          let cur = obj;
          for (const part of parts) {
            if (cur == null) break;
            cur = cur[part];
          }
          if (cur !== undefined && cur !== null && cur !== '') return cur;
        }
        return '';
      };

      const slugify = (value) => String(value || '')
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');

      const getArray = (payload) => {
        if (Array.isArray(payload)) return payload;
        if (!payload || typeof payload !== 'object') return [];
        for (const key of ['rows', 'laps', 'items', 'data', 'results', 'hotlaps', 'recentLaps']) {
          if (Array.isArray(payload[key])) return payload[key];
        }
        for (const value of Object.values(payload)) {
          if (Array.isArray(value)) return value;
        }
        return [];
      };

      const parseMs = (value) => {
        if (value === undefined || value === null || value === '') return Number.POSITIVE_INFINITY;
        if (typeof value === 'string' && value.includes(':')) {
          const [m, s] = value.split(':');
          const ms = ((Number(m) || 0) * 60 + (Number(s) || 0)) * 1000;
          return Number.isFinite(ms) && ms > 0 ? ms : Number.POSITIVE_INFINITY;
        }
        const n = Number(value);
        if (!Number.isFinite(n) || n <= 0) return Number.POSITIVE_INFINITY;
        return n > 1000 ? n : n * 1000;
      };

      const formatLap = (value) => {
        const ms = Math.round(parseMs(value));
        if (!Number.isFinite(ms) || ms === Number.POSITIVE_INFINITY) return '--';
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        const millis = ms % 1000;
        return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
      };

      const driverName = (row) => firstValue(row, ['driverName','pilotName','playerName','name','driver.displayName','driver.name','player.name','DriverName','steamName']) || 'Piloto';
      const carName = (row) => firstValue(row, ['carName','carDisplayName','carVisibleName','vehicle','car.displayName','car.name','Car','car']) || 'Coche';
      const trackName = (row) => firstValue(row, ['trackName','trackDisplayName','trackVisibleName','track.name','track.displayName','Track','track']) || '';

      const rowTrackMatches = (row, activeTrack) => {
        const wanted = slugify(activeTrack);
        if (!wanted || wanted === 'actualizando') return true;
        const got = slugify(trackName(row)).replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '');
        const cleanWanted = wanted.replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '');
        if (!got) return true;
        return got.includes(cleanWanted) || cleanWanted.includes(got);
      };

      const rowCarMatches = (row, activeCars) => {
        if (!activeCars.length) return true;
        const got = slugify(carName(row));
        if (!got) return true;
        return activeCars.some((car) => {
          const wanted = slugify(car);
          return wanted && (got.includes(wanted) || wanted.includes(got));
        });
      };

      const isValidLap = (row) => {
        const raw = firstValue(row, ['valid','isValid','Valid']);
        return !(raw === 0 || raw === false || raw === '0' || raw === 'false' || raw === 'no');
      };

      const avatarUrl = (row) => firstValue(row, ['avatarUrl','avatar_url','imageUrl','image','driver.avatarUrl','player.avatarUrl']) || '/images/pilot-avatar-default.png';

      const endpoints = [
        '/api/gc/recent-laps?limit=2500&sort=recent&valid=all',
        '/api/laps?limit=2500&sort=recent&valid=all',
        '/api/hotlaps?limit=2500&sort=recent&valid=all'
      ];

      const fetchRows = async () => {
        for (const endpoint of endpoints) {
          try {
            const res = await fetch(endpoint, { cache:'no-store' });
            if (!res.ok) continue;
            const payload = await res.json();
            const rows = getArray(payload);
            if (rows.length) return rows;
          } catch (_) {}
        }
        return [];
      };


      const findDirectComboLapTotal = (payload) => {
        if (!payload || typeof payload !== 'object') return null;

        const directKeys = [
          'activeComboLaps',
          'currentComboLaps',
          'comboLaps',
          'combo_laps',
          'comboLapCount',
          'combo_lap_count',
          'currentComboLapCount',
          'activeComboLapCount',
          'totalComboLaps',
          'total_combo_laps',
          'currentComboTotalLaps',
          'activeComboTotalLaps',
          'lapsInCombo',
          'laps_in_combo'
        ];

        const readNumber = (value) => {
          if (Array.isArray(value)) return null;
          const n = Number(String(value ?? '').replace(/[^0-9.-]/g, ''));
          return Number.isFinite(n) && n > 0 ? Math.round(n) : null;
        };

        const visit = (obj, depth = 0) => {
          if (!obj || typeof obj !== 'object' || depth > 5) return null;

          for (const key of directKeys) {
            if (Object.prototype.hasOwnProperty.call(obj, key)) {
              const n = readNumber(obj[key]);
              if (n !== null) return n;
            }
          }

          const comboLike = obj.combo || obj.currentCombo || obj.activeCombo || obj.current_combo || obj.active_combo || obj.raceCombo || obj.serverCombo;
          if (comboLike && typeof comboLike === 'object') {
            for (const key of ['totalLaps', 'lapCount', 'lapsCount', 'lapsTotal', 'validLaps', 'validLapCount']) {
              const n = readNumber(comboLike[key]);
              if (n !== null) return n;
            }
          }

          for (const value of Object.values(obj)) {
            if (value && typeof value === 'object' && !Array.isArray(value)) {
              const found = visit(value, depth + 1);
              if (found !== null) return found;
            }
          }

          return null;
        };

        return visit(payload);
      };

      const fetchDirectComboLapTotal = async () => {
        const endpoints = [
          '/api/gc/current-combo',
          '/api/gc/active-combo',
          '/api/gc/combo-current',
          '/api/gc/combo-summary',
          '/api/gc/combo',
          '/api/current-combo',
          '/api/combo/current',
          '/api/combos/current',
          '/api/race-control/current-combo',
          '/api/gc/server-summary',
          '/api/gc/server-stats',
          '/api/gc/stats',
          '/api/gc/overview',
          '/api/status'
        ];

        for (const endpoint of endpoints) {
          try {
            const res = await fetch(endpoint, { cache:'no-store' });
            if (!res.ok) continue;
            const payload = await res.json();
            const value = findDirectComboLapTotal(payload);
            if (value !== null) return value;
          } catch (_) {}
        }

        return null;
      };

      const renderNine = async () => {
        const host = document.querySelector('[data-home2-combo-ranking]');
        const comboLapsEl = document.querySelector('[data-home2-server-combo-laps]');
        if (!host && !comboLapsEl) return;

        const activeTrack = document.querySelector('[data-home2-now-title]')?.textContent
          || document.querySelector('[data-home2-track]')?.textContent
          || '';

        const activeCarsText = [
          document.querySelector('[data-home2-cars]')?.textContent,
          document.querySelector('[data-home2-best-car]')?.textContent
        ].filter(Boolean).join(' ');

        const activeCars = activeCarsText
          .split(/[,/·|]+/)
          .map((part) => part.replace(/esperando datos del combo/ig, '').trim())
          .filter(Boolean);

        if (comboLapsEl) {
          const directComboLaps = await fetchDirectComboLapTotal();
          comboLapsEl.textContent = directComboLaps !== null ? new Intl.NumberFormat('es-ES').format(directComboLaps) : '--';
          comboLapsEl.title = directComboLaps !== null
            ? 'Vueltas del combo desde endpoint directo'
            : 'Sin dato directo fiable de vueltas del combo';
        }

        const rows = await fetchRows();
        if (!rows.length) return;

        const trackRows = rows
          .filter((row) => rowTrackMatches(row, activeTrack));

        let comboRows = trackRows
          .filter((row) => rowCarMatches(row, activeCars));

        // Si el nombre exacto del coche no coincide entre API/web,
        // no dejamos el bloque a 0: manda el circuito activo.
        if (comboRows.length < 9) comboRows = trackRows.length ? trackRows : rows;

        if (!host) return;

        const byDriver = new Map();
        comboRows
          .filter((row) => parseMs(firstValue(row, ['lapTimeFormatted','timeFormatted','formattedLapTime','bestLapTimeFormatted','lapTime','lapMs','lapTimeMs','time','bestLap','bestLapTime'])) !== Number.POSITIVE_INFINITY)
          .forEach((row) => {
            const name = driverName(row);
            const guid = firstValue(row, ['playerId','driverId','pilotId','steamGuid','guid','driver.guid','player.guid','DriverGuid']);
            const key = slugify(guid || name);
            if (!key) return;
            const current = byDriver.get(key);
            const time = parseMs(firstValue(row, ['lapTimeFormatted','timeFormatted','formattedLapTime','bestLapTimeFormatted','lapTime','lapMs','lapTimeMs','time','bestLap','bestLapTime']));
            const currentTime = current ? parseMs(firstValue(current, ['lapTimeFormatted','timeFormatted','formattedLapTime','bestLapTimeFormatted','lapTime','lapMs','lapTimeMs','time','bestLap','bestLapTime'])) : Number.POSITIVE_INFINITY;
            if (!current || time < currentTime) byDriver.set(key, row);
          });

        const timeOf = (row) => parseMs(firstValue(row, ['lapTimeFormatted','timeFormatted','formattedLapTime','bestLapTimeFormatted','lapTime','lapMs','lapTimeMs','time','bestLap','bestLapTime']));

        const bestRows = [...byDriver.values()]
          .sort((a, b) => timeOf(a) - timeOf(b))
          .slice(0, 9);

        // No rellenamos con vueltas duplicadas: así Top Combo mantiene el comportamiento correcto.
        // Si existen 9 pilotos únicos del combo, aparece la novena fila. Si no, no inventa datos.
        if (!bestRows.length) return;

        host.innerHTML = bestRows.map((row, index) => {
          const badge = index === 0
            ? '<span class="gc-home2-rank-badge gc-home2-rank-badge--gold" aria-label="1º">🥇</span>'
            : index === 1
              ? '<span class="gc-home2-rank-badge gc-home2-rank-badge--silver" aria-label="2º">🥈</span>'
              : index === 2
                ? '<span class="gc-home2-rank-badge gc-home2-rank-badge--bronze" aria-label="3º">🥉</span>'
                : `<span class="gc-home2-rank-badge gc-home2-rank-badge--plain">${index + 1}</span>`;

          const rawTime = firstValue(row, ['lapTimeFormatted','timeFormatted','formattedLapTime','bestLapTimeFormatted','lapTime','lapMs','lapTimeMs','time','bestLap','bestLapTime']);
          const compactClass = index >= 3 ? ' gc-home2-combo-rank--compact' : '';

          return `<div class="gc-home2-combo-rank${compactClass}">` +
            badge +
            `<div><strong>${driverName(row)}</strong><small>${carName(row)}</small></div>` +
            `<img class="gc-home2-combo-rank__avatar" src="${avatarUrl(row)}" alt="" width="24" height="24" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/pilot-avatar-default.png';" />` +
            `<em>${formatLap(rawTime)}</em>` +
          '</div>';
        }).join('');
      };

      renderNine();
      window.setTimeout(renderNine, 1200);
      window.setTimeout(renderNine, 3200);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        init();
        initHomeEnhancements();
      }, { once:true });
    } else {
      init();
      initHomeEnhancements();
    }
  })();
</script>

