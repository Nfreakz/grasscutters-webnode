---
import PublicHeroText from './PublicHeroText.astro';
import '../../styles/public/gc-unified-hero.css';
import '../../styles/public/gc-video-hero-community-overlay.css';

const {
  id,
  kicker,
  title,
  lead,
  leadId,
  class: className = '',
} = Astro.props;
---

<div class:list={['gc-unified-hero-frame', className]}>
  <PublicHeroText
    id={id}
    kicker={kicker}
    title={title}
    lead={lead}
    leadId={leadId}
  />
</div>

<!--
  La home resuelve sus imágenes de campeonato desde index.astro.
  El antiguo autofix añadía un cache-buster nuevo cada 20 s y competía con
  el render principal, por lo que las tarjetas parecían recargarse.
-->
<script is:inline src="/js/gc-home-runtime-final.js?v=10-no-ranking-writes"></script>
