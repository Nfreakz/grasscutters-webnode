---
import PublicHeroText from './PublicHeroText.astro';
import '../../styles/public/gc-unified-hero.css';
import '../../styles/public/gc-video-hero-community-overlay.css';

const {
  id,
  kicker,
  title,
  lead,
  leadId,
  class: className = '',
} = Astro.props;
---

<div class:list={['gc-unified-hero-frame', className]}>
  <PublicHeroText
    id={id}
    kicker={kicker}
    title={title}
    lead={lead}
    leadId={leadId}
  />
</div>
