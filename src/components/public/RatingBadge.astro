---
import '../../styles/public/gc-rating-badges.css';

const {
  type = 'sr',
  value = '--',
  score,
  compact = false,
  class: className = '',
} = Astro.props;

const normalizedType = String(type).toLowerCase() === 'gsr' ? 'gsr' : 'sr';
const normalizedValue = String(value || '--');

const classKey = normalizedValue
  .trim()
  .toLowerCase()
  .replace('+', 'plus')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '') || 'unknown';

const SR_LABELS = {
  'A+': 'Legend',
  A: 'Elite',
  B: 'Pro',
  C: 'Advanced',
  D: 'Rookie',
  E: 'Pitlane',
  '--': '--',
};

const GSR_LABELS = {
  S: 'Diamond',
  A: 'Ruby',
  B: 'Sapphire',
  C: 'Emerald',
  D: 'Amber',
  Rookie: 'Onyx',
  ROOKIE: 'Onyx',
  '--': '--',
};

const displayValue = normalizedType === 'gsr'
  ? (GSR_LABELS[normalizedValue] || normalizedValue)
  : (SR_LABELS[normalizedValue] || normalizedValue);
---

<span class:list={[
  'gc-rating-badge',
  `gc-rating-badge--${normalizedType}`,
  `gc-rating-badge--${normalizedType}-${classKey}`,
  compact && 'gc-rating-badge--compact',
  className
]}>
  <span class="gc-rating-badge__type">{normalizedType.toUpperCase()}</span>
  <strong>{displayValue}</strong>
  {score !== undefined && score !== null && score !== '' && <small>{score}</small>}
</span>
