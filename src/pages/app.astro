---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/app-race-control.css';

const serverJoinUrl = 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153';
const carsDriveUrl = 'https://drive.google.com/drive/folders/1dAN3gxyAJKbyXV3pa93krmrkK95_PYBD';
const tracksDriveUrl = 'https://drive.google.com/drive/folders/1dAN3gxyAJKbyXV3pa93krmrkK95_PYBD';
---
<AppLayout
  title="Race Control | GrassCutters Racing"
  description="Panel operativo de GrassCutters Racing con servidor, combo, live timing, hotlaps y actividad reciente."
  canonicalPath="/app"
  ogImage="/og/platform-og-v1531.png"
  ogImageAlt="Race Control GrassCutters Racing"
>
  <main class="rc-console" aria-labelledby="rcPageTitle">
    <h1 id="rcPageTitle" class="rc-sr-only">GrassCutters Race Control</h1>

    <section class="rc-status-tape rc-status-tape--race-data" aria-label="Estado rápido Race Control">
      <div class="rc-tape-cell">
        <span class="rc-tape-label">VUELTAS TOTALES</span>
        <strong id="gcQuickRefs">--</strong>
      </div>
      <div class="rc-tape-cell">
        <span class="rc-tape-label">ONLINE DESDE</span>
        <strong id="gcServerUptimeDays">--</strong>
      </div>
      <div class="rc-tape-cell">
        <span class="rc-tape-label">ÚLTIMA VUELTA</span>
        <strong id="gcQuickLast">--</strong>
      </div>
      <div class="rc-tape-cell rc-tape-cell--track">
        <span class="rc-tape-label">TRACK</span>
        <strong id="gcTapeTrack">TRACK</strong>
      </div>
      <div class="rc-tape-cell">
        <span class="rc-tape-label">LIVE</span>
        <strong id="gcMetricDrivers">--</strong>
      </div>
      <div class="rc-tape-cell">
        <span class="rc-tape-label">UPDATED</span>
        <strong id="gcAppClock">--:--</strong>
      </div>
    </section>

    <div class="rc-data-sinks" aria-hidden="true">
      <span id="gcAppStatusChip"></span>
      <span id="gcApiState"></span>
      <span id="gcAppSessionState"></span>
      <span id="gcAppSessionUser"></span>
      <span id="gcAppSessionRole"></span>
      <span id="gcAppSessionPilot"></span>
      <span id="gcAppComboChip"></span>
      <span id="gcComboTrack"></span>
      <span id="gcComboHint"></span>
      <span id="gcComboBest"></span>
      <span id="gcComboBestMeta"></span>
      <span id="gcComboLaps"></span>
      <span id="gcComboDrivers"></span>
      <span id="gcComboFamily"></span>
      <span id="gcComboCars"></span>
      <a id="gcComboLink" href="/combos"></a>
      <span id="gcMetricLaps"></span>
      <span id="gcMetricCombos"></span>
      <span id="gcMetricLastActivity"></span>
      <span id="gcFeedDrivers"></span>
      <span id="gcFeedLastActivity"></span>
      <span id="gcQuickDb"></span>
      <span id="gcQuickDbMeta"></span>
      <span id="gcQuickLastMeta"></span>
      <span id="gcServerUptimeMeta"></span>
    </div>

    <section class="rc-table-module rc-table-module--acsm" aria-labelledby="rcLiveDriversTitle">
      <header class="rc-section-head">
        <div>
          <span>ACSM LIVE TIMING</span>
          <h2 id="rcLiveDriversTitle">Pilotos en pista</h2>
          <p id="gcAcsSessionMeta">Leyendo sesión ACSM...</p>
        </div>
        <span class="rc-mini-status" id="gcAcsLiveCount">0 LIVE</span>
      </header>
      <div class="rc-table-scroll">
        <table class="rc-data-table rc-data-table--live">
          <thead>
            <tr>
              <th>#</th>
              <th>Estado</th>
              <th>Piloto</th>
              <th>Coche</th>
              <th>Tyres</th>
              <th>Last Lap</th>
              <th>Best Lap</th>
              <th>Gap</th>
              <th>Laps</th>
              <th>Pits</th>
              <th>Ping</th>
            </tr>
          </thead>
          <tbody id="gcAcsLiveBody">
            <tr><td colspan="11">Leyendo pilotos conectados...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="rc-table-module rc-table-module--acsm" aria-labelledby="rcStoredTimesTitle">
      <header class="rc-section-head">
        <div>
          <span>ACSM SESSION REFERENCES</span>
          <h2 id="rcStoredTimesTitle">Stored times</h2>
          <p>Referencias guardadas por ACSM en la sesión actual.</p>
        </div>
        <span class="rc-mini-status" id="gcAcsStoredCount">0 STORED</span>
      </header>
      <div class="rc-table-scroll">
        <table class="rc-data-table rc-data-table--stored">
          <thead>
            <tr>
              <th>#</th>
              <th>Piloto</th>
              <th>Coche</th>
              <th>Tyres</th>
              <th>Best Lap</th>
              <th>S1</th>
              <th>S2</th>
              <th>S3</th>
              <th>Laps</th>
              <th>Top Speed</th>
            </tr>
          </thead>
          <tbody id="gcAcsStoredBody">
            <tr><td colspan="10">Leyendo referencias...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="rc-table-module rc-table-module--combo-laps" aria-labelledby="rcHotlapsTitle">
      <header class="rc-section-head rc-section-head--stacked">
        <div>
          <span>CURRENT COMBO HOTLAPS</span>
          <h2 id="rcHotlapsTitle">Vueltas del combo</h2>
          <p><strong id="gcRefsTrack">CIRCUITO CARGANDO...</strong></p>
          <p id="gcRefsMeta">Cargando vueltas del combo...</p>
        </div>
        <a class="rc-mini-action" href="/hotlaps">VER HOTLAPS</a>
      </header>

      <div class="rc-hotlap-toolbar" aria-label="Filtros de vueltas del combo">
        <label>
          <span>Buscar</span>
          <input id="gcHotlapSearch" type="search" placeholder="Piloto, coche o tiempo" autocomplete="off" />
        </label>
        <label>
          <span>Piloto</span>
          <select id="gcHotlapDriverFilter"><option value="">Todos</option></select>
        </label>
        <label>
          <span>Coche</span>
          <select id="gcHotlapCarFilter"><option value="">Todos</option></select>
        </label>
        <label>
          <span>Validez</span>
          <select id="gcHotlapValidFilter">
            <option value="all">Todas</option>
            <option value="valid">Válidas</option>
            <option value="invalid">No válidas</option>
          </select>
        </label>
        <label>
          <span>Orden</span>
          <select id="gcHotlapSort">
            <option value="recent">Fecha reciente</option>
            <option value="timeAsc">Tiempo mejor</option>
            <option value="timeDesc">Tiempo peor</option>
            <option value="driver">Piloto A-Z</option>
            <option value="car">Coche A-Z</option>
          </select>
        </label>
        <label>
          <span>Por página</span>
          <select id="gcHotlapPageSize">
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
          </select>
        </label>
      </div>

      <div class="rc-table-scroll">
        <table class="rc-data-table rc-data-table--activity">
          <thead>
            <tr>
              <th><button class="rc-sort-button" type="button" data-sort-key="index">#</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="driver">Piloto</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="car">Coche</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="s1">S1</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="s2">S2</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="s3">S3</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="time">Tiempo</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="speed">Top Speed</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="valid">Validez</button></th>
              <th><button class="rc-sort-button" type="button" data-sort-key="date">Fecha</button></th>
            </tr>
          </thead>
          <tbody id="gcRefsTable"><tr><td colspan="10">Leyendo vueltas del combo...</td></tr></tbody>
        </table>
      </div>

      <footer class="rc-hotlap-pager" aria-label="Paginación de vueltas del combo">
        <button id="gcHotlapPrev" type="button">Anterior</button>
        <span id="gcHotlapPageInfo">Página 1 / 1</span>
        <button id="gcHotlapNext" type="button">Siguiente</button>
      </footer>
    </section>
  </main>

<script is:inline src="/js/gc-track-images.js"></script>

  <script is:inline>
    /* GC_APP_INITIAL_NEUTRAL_STATE_V1_9 */
    (() => {
      const setText = (id, value) => {
        const node = document.getElementById(id);
        if (node) node.textContent = String(value);
      };

      const neutralize = () => {
        if (document.documentElement.dataset.gcAppSingleRenderer === 'v1.8') return;

        setText('gcMetricLaps', '—');
        setText('gcQuickRefs', '—');
        setText('gcMetricCombos', '—');
        setText('gcMetricLastActivity', '—');
        setText('gcFeedDrivers', '—');
        setText('gcFeedLastActivity', '—');
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', neutralize, { once: true });
      } else {
        neutralize();
      }
    })();
  </script>

  
  <script is:inline>
    /* GC_APP_LEGACY_RENDERER_REMOVED_V1_9 */
    (() => {
      document.documentElement.dataset.gcAppLegacyRenderer = 'removed-v1.9';
      console.info('[GC /app] Legacy renderer removed v1.9');
    })();
  </script>


  
  



  


  



  



  



  


  <script is:inline>
    /* GC_APP_SINGLE_RENDERER_V1_8_START */
    (() => {
      const CONFIG = { refreshMs: 30000, firstDelayMs: 350, secondDelayMs: 1500 };
      const state = {
        version: 'v1.8',
        mode: 'single-renderer',
        lastRunAt: null,
        lastOkAt: null,
        lastError: null,
        diagnostics: null,
        combo: null,
        recent: null,
        leaderboard: null
      };

      const byId = (id) => document.getElementById(id);
      const setText = (id, value) => {
        const node = byId(id);
        if (node) node.textContent = String(value ?? '--');
      };
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char]));
      const number = (value, fallback = 0) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      };
      const formatNumber = (value) => Math.max(0, Math.round(number(value, 0))).toLocaleString('es-ES');

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source, path)) return source[path];
        return String(path).split('.').reduce((acc, part) => acc == null ? undefined : acc[part], source);
      };

      const pick = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source, path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return undefined;
      };

      const text = (value, fallback = '') => {
        if (value == null || value === '') return fallback;
        if (Array.isArray(value)) return value.length ? text(value[0], fallback) : fallback;
        if (typeof value === 'object') {
          return text(
            value.displayName ?? value.visibleName ?? value.cleanName ?? value.display_name ??
            value.uiName ?? value.uiCarName ?? value.uiTrackName ??
            value.name ?? value.Name ?? value.driverName ?? value.playerName ?? value.code,
            fallback
          );
        }
        return String(value).replace(/_/g, ' ').replace(/\s+/g, ' ').trim() || fallback;
      };

      const items = (data) => {
        if (Array.isArray(data)) return data;
        if (!data || typeof data !== 'object') return [];
        return data.items || data.data?.items || data.data?.leaderboard || data.data?.laps ||
          data.leaderboard || data.laps || data.recentLaps || data.hotlaps ||
          data.combos || data.results || [];
      };

      const dateMs = (value) => {
        if (!value) return 0;
        if (typeof value === 'number') return value > 20000000000 ? value : value * 1000;
        const parsed = Date.parse(String(value));
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const dateText = (value) => {
        const ms = typeof value === 'object' ? lapDate(value) : dateMs(value);
        if (!ms) return '--';
        return new Date(ms).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' });
      };

      const timeText = (value) => {
        const raw = text(value, '');
        if (raw && /[:.]/.test(raw) && !/^\d+$/.test(raw)) return raw;
        const ms = number(value, 0);
        if (!ms) return '--';
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        const millis = Math.floor(ms % 1000);
        return minutes + ':' + String(seconds).padStart(2, '0') + '.' + String(millis).padStart(3, '0');
      };

      const lapDate = (row) => dateMs(pick(row, [
        'timestampIso',
        'dateIso',
        'createdAt',
        'updatedAt',
        'lastSeenAt',
        'latestLapAt',
        'timestamp',
        'Timestamp'
      ]));

      const lapTime = (row) => text(pick(row, [
        'lapTimeFormatted',
        'timeFormatted',
        'bestLapTime',
        'bestLap',
        'lapTime'
      ]), '') || timeText(pick(row, [
        'lapTimeMs',
        'bestLapMs',
        'timeMs',
        'LapTime'
      ]));

      const driverName = (row) => text(pick(row, [
        'driverName',
        'playerName',
        'pilotName',
        'name',
        'driver.displayName',
        'driver.visibleName',
        'driver.name',
        'player.displayName',
        'player.name'
      ]), 'Piloto');

      const carName = (row) => text(pick(row, [
        'carName',
        'uiCarName',
        'car.displayName',
        'car.visibleName',
        'car.name',
        'car'
      ]), 'Coche');

      const trackName = (row) => text(pick(row, [
        'trackName',
        'uiTrackName',
        'track.displayName',
        'track.visibleName',
        'track.name',
        'track'
      ]), 'Circuito');

      const splitMs = (row, index) => {
        const direct = pick(row, [
          `sector${index + 1}Ms`,
          `s${index + 1}Ms`,
          `split${index + 1}Ms`,
          `sectorTimesMs.${index}`,
          `sectorTimes.${index}`,
          `splitsMs.${index}`,
          `splits.${index}`,
          `sectors.${index}`,
          `BestSplits.${index}`
        ]);
        if (typeof direct === 'object') {
          const nested = pick(direct, ['timeMs','ms','time','value']);
          return number(nested, 0) || null;
        }
        const parsed = number(direct, 0);
        return parsed > 0 ? parsed : null;
      };

      const speed = (row) => {
        const raw = pick(row, ['maxSpeedKmh', 'maxSpeed', 'speedKmh', 'MaxSpeed_KMH']);
        const parsed = Number(raw);
        return Number.isFinite(parsed) && parsed > 0 ? Math.round(parsed) + ' km/h' : '';
      };

      const fetchJson = async (url) => {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 10000);
        try {
          const response = await fetch(url, { credentials: 'include', cache: 'no-store', signal: controller.signal });
          const data = await response.json().catch(() => null);
          if (!response.ok || !data) throw new Error(url + ' ' + response.status);
          return data;
        } finally {
          window.clearTimeout(timeout);
        }
      };

      function globalStatsFromDiagnostics(data) {
        const race = data?.raceData || data?.stracker?.raceData || data?.stats || data?.overview || {};
        return {
          totalLaps: number(
            pick(race, ['lapsCount', 'totalLaps', 'laps', 'lapCount']) ??
            pick(data, ['raceData.lapsCount', 'totalLaps', 'lapsCount']),
            0
          ),
          driversCount: number(
            pick(race, ['driversCount', 'totalDrivers', 'pilotsCount']) ??
            pick(data, ['raceData.driversCount', 'driversCount', 'totalDrivers']),
            0
          ),
          combosCount: number(
            pick(race, ['activeCombosCount', 'combosCount', 'totalCombos']) ??
            pick(data, ['raceData.activeCombosCount', 'activeCombosCount', 'combosCount', 'totalCombos']),
            0
          ),
          latestLapAt:
            pick(race, ['latestLapAt', 'lastSeenAt', 'latestActivityAt']) ||
            pick(data, ['raceData.latestLapAt', 'latestLapAt']),
          firstSeenAt:
            pick(race, ['oldestLapAt', 'firstSeenAt', 'startedAt']) ||
            pick(data, ['raceData.oldestLapAt', 'oldestLapAt', 'firstSeenAt']),
          generatedAt: data?.generatedAt
        };
      }

      function comboCars(combo) {
        const raw = pick(combo, [
          'publicComboCars',
          'carNames',
          'carList',
          'cars',
          'availableCars',
          'comboCars',
          'mainVariantAllCars'
        ]);
        const arr = Array.isArray(raw) ? raw : (typeof raw === 'string' ? raw.split(/[,|;]/g) : []);
        const seen = new Set();
        return arr.map((car) => text(car, '')).filter(Boolean).filter((name) => {
          const key = name.toLowerCase();
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
      }

      function comboId(combo) {
        return pick(combo, ['comboId', 'canonicalComboId', 'id']);
      }

      function comboUrl(combo) {
        const id = comboId(combo);
        return combo?.url || (id !== undefined && id !== null ? '/combos/' + encodeURIComponent(String(id)) : '/combos');
      }

      function comboBestLap(combo, leaderboard) {
        return (
          pick(combo, ['bestLap', 'summary.bestLap']) ||
          (Array.isArray(combo?.leaderboard) ? combo.leaderboard[0] : null) ||
          leaderboard[0] ||
          {}
        );
      }

      function comboState(combo) {
        const hiddenCars = number(pick(combo, ['hiddenLowLapCarsCount', 'summary.hiddenLowLapCarsCount']), 0);
        const variants = number(pick(combo, ['variantsCount', 'summary.variantsCount']), 0);
        if (hiddenCars > 0) return 'Filtrado';
        if (variants > 1) return 'Canónico';
        return 'Activo';
      }

      function ensureBadge(stateName, label) {
        let badge = byId('gcAppCoreBadge');
        if (!badge) {
          const host = document.querySelector('.gc-live-panel__title') || document.querySelector('.gc-hero') || document.body;
          badge = document.createElement('span');
          badge.id = 'gcAppCoreBadge';
          badge.style.cssText = 'display:inline-flex;align-items:center;min-height:24px;padding:4px 8px;border:1px solid rgba(122,255,144,.35);border-radius:999px;color:var(--accent,#7aff90);font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;background:rgba(122,255,144,.08);margin-left:8px';
          host.appendChild(badge);
        }
        badge.textContent = label;
        badge.dataset.state = stateName;
        badge.style.borderColor = stateName === 'error' ? 'rgba(255,94,94,.45)' : stateName === 'warn' ? 'rgba(255,207,90,.45)' : 'rgba(122,255,144,.35)';
        badge.style.color = stateName === 'error' ? '#ff6b6b' : stateName === 'warn' ? '#ffcf5a' : 'var(--accent,#7aff90)';
      }

      function gcAppSessionUserFromV1_10(identityData, adminData) {
        const candidates = [
          identityData?.user,
          identityData?.currentUser,
          identityData?.account,
          identityData?.profile?.user,
          identityData?.session?.user,
          identityData?.auth?.user,
          identityData?.data?.user,
          adminData?.user,
          adminData?.currentUser,
          adminData?.account,
          adminData?.profile?.user,
          adminData?.session?.user,
          adminData?.auth?.user,
          adminData?.data?.user
        ].filter(Boolean);

        return candidates[0] || {};
      }

      function gcAppSessionPilotFromV1_10(identityData, adminData, user) {
        const candidates = [
          identityData?.pilot,
          identityData?.linkedPilot,
          identityData?.pilotLink,
          identityData?.linked,
          identityData?.profile?.pilot,
          identityData?.profile?.pilotLink,
          identityData?.data?.pilot,
          identityData?.data?.pilotLink,
          adminData?.pilot,
          adminData?.linkedPilot,
          adminData?.pilotLink,
          adminData?.profile?.pilot,
          adminData?.profile?.pilotLink,
          user?.pilot,
          user?.pilotLink,
          user?.linkedPilot
        ].filter(Boolean);

        return candidates[0] || {};
      }

      function gcAppSessionIsLoggedV1_10(identityData, adminData, user) {
        return Boolean(
          identityData?.authenticated === true ||
          identityData?.loggedIn === true ||
          identityData?.isAuthenticated === true ||
          identityData?.ok === true ||
          adminData?.authenticated === true ||
          adminData?.loggedIn === true ||
          adminData?.isAuthenticated === true ||
          adminData?.ok === true ||
          user?.id ||
          user?.email ||
          user?.name ||
          user?.displayName ||
          user?.role
        );
      }

      function renderSession(identityData, adminData) {
        const user = gcAppSessionUserFromV1_10(identityData, adminData);
        const pilot = gcAppSessionPilotFromV1_10(identityData, adminData, user);
        const logged = gcAppSessionIsLoggedV1_10(identityData, adminData, user);

        const accountName = text(
          user.displayName ??
          user.display_name ??
          user.username ??
          user.name ??
          user.email ??
          identityData?.displayName ??
          identityData?.name ??
          adminData?.displayName ??
          adminData?.name,
          logged ? 'Admin Local' : 'Invitado'
        );

        const role = text(
          user.role ??
          user.userRole ??
          user.accountRole ??
          identityData?.role ??
          identityData?.user?.role ??
          adminData?.role ??
          adminData?.user?.role,
          logged ? 'pilot' : '-'
        );

        const pilotName = text(
          pilot.displayName ??
          pilot.display_name ??
          pilot.driverName ??
          pilot.strackerName ??
          pilot.name ??
          identityData?.pilotName ??
          identityData?.driverName ??
          user?.strackerName,
          pilot && Object.keys(pilot).length ? 'Vinculado' : accountName
        );

        setText('gcAppSessionState', logged ? 'Conectado' : 'Invitado');
        setText('gcAppSessionUser', accountName);
        setText('gcAppSessionRole', role);
        setText('gcAppSessionPilot', pilotName);

        document.documentElement.dataset.gcAppSessionRenderer = 'v1.10';
      }

      function renderGlobal(diagnostics) {
        const stats = globalStatsFromDiagnostics(diagnostics);
        if (stats.driversCount) {
          setText('gcMetricDrivers', formatNumber(stats.driversCount));
          setText('gcFeedDrivers', formatNumber(stats.driversCount));
        }
        if (stats.totalLaps) {
          setText('gcMetricLaps', formatNumber(stats.totalLaps));
          setText('gcQuickRefs', formatNumber(stats.totalLaps));
        }
        if (stats.combosCount) setText('gcMetricCombos', formatNumber(stats.combosCount));
        if (stats.latestLapAt) {
          const lastActivityText = dateText(stats.latestLapAt).split(',')[0];
          setText('gcMetricLastActivity', lastActivityText);
          setText('gcFeedLastActivity', lastActivityText);
        }

        if (stats.firstSeenAt) {
          const firstMs = dateMs(stats.firstSeenAt);
          if (firstMs) {
            const days = Math.max(1, Math.ceil((Date.now() - firstMs) / 86400000));
            setText('gcServerUptimeDays', days + ' días');
            setText('gcServerUptimeMeta', 'desde ' + dateText(stats.firstSeenAt).split(',')[0]);
          }
        }

        setText('gcQuickDb', 'Activo');
        setText('gcQuickDbMeta', stats.generatedAt ? 'Actualizado · ' + dateText(stats.generatedAt) : 'Actualizado');

        return stats;
      }

      function renderCombo(combo, leaderboard, recent) {
        if (!combo) return;

        const cars = comboCars(combo);
        const best = comboBestLap(combo, leaderboard);
        const latest = recent[0] || best || {};
        const track = text(pick(combo, [
          'canonicalTrackName',
          'displayTrackName',
          'track.displayName',
          'track.name',
          'trackName'
        ]), trackName(latest));

        setText('gcAppComboChip', track || 'Combo');
        setText('gcComboTrack', track || 'Sin combo');
        setText('gcTapeTrack', track || 'TRACK');
        setText('gcComboHint', pick(combo, ['lastSeenAt', 'summary.lastSeenAt'])
          ? 'Última actividad · ' + dateText(pick(combo, ['lastSeenAt', 'summary.lastSeenAt']))
          : 'Combo canónico cargado.');
        setText('gcComboBest', best ? lapTime(best) : '--');
        setText('gcComboBestMeta', best ? [driverName(best), carName(best)].filter(Boolean).join(' · ') : 'Mejor vuelta del combo');
        setText('gcComboLaps', formatNumber(pick(combo, ['totalLaps', 'summary.totalLaps', 'laps'])));
        setText('gcComboDrivers', formatNumber(pick(combo, ['driversCount', 'summary.driversCount', 'pilotsCount'])));
        setText('gcComboFamily', comboState(combo));

        const link = byId('gcComboLink');
        if (link) link.href = comboUrl(combo);

        const carsNode = byId('gcComboCars');
        if (carsNode) {
          carsNode.innerHTML = cars.length
            ? cars.map((name) => '<span class="gc-chip">' + escapeHtml(name) + '</span>').join('')
            : '<span class="gc-chip">Coches por confirmar</span>';
        }

        const comboCard = document.querySelector('.gc-app-combo-v3');
        if (comboCard && track) {
          comboCard.dataset.trackName = track;
          window.GCTrackImages?.applyAll?.(document);
        }

        if (best && Object.keys(best).length) {
          setText('gcTopDriverName', driverName(best));
          setText('gcTopDriverTime', lapTime(best));
          setText('gcTopDriverMeta', [carName(best), trackName(best), speed(best)].filter(Boolean).join(' · '));

          const avatar = byId('gcTopDriverAvatar');
          const playerId = pick(best, ['playerId', 'driverId', 'pilotId', 'id', 'driver.id', 'player.id', 'pilot.id']);
          if (avatar && playerId) {
            avatar.src = '/api/pilot-avatar/' + encodeURIComponent(String(playerId));
            avatar.alt = 'Avatar de ' + driverName(best);
            avatar.onerror = () => {
              avatar.onerror = null;
              avatar.src = '/images/pilot-avatar-default.png';
            };
          }
        }
      }

      function renderRecentTable(recent, leaderboard) {
        const rows = recent.length ? recent : leaderboard;
        // La tabla de vueltas del combo la controla GC_APP_COMBO_HOTLAPS_FILTERED_V2_5.
        // Este renderer principal solo mantiene los readouts rápidos para no pisar filtros/paginación.
        const latest = rows.slice().sort((a, b) => lapDate(b) - lapDate(a))[0] || null;
        setText('gcQuickLast', latest ? lapTime(latest) : '--');
        setText('gcQuickLastMeta', latest ? [driverName(latest), trackName(latest), dateText(latest)].filter(Boolean).join(' · ') : 'sin datos');
        // gcRefsMeta lo controla el módulo de vueltas completas del combo.
      }

      async function render() {
        state.lastRunAt = new Date().toISOString();

        try {
          ensureBadge('warn', 'Actualizando datos');

          const [diagnostics, combosData, recentData, leaderboardData, identityData, adminData] = await Promise.all([
            fetchJson('/api/gc/diagnostics'),
            fetchJson('/api/gc/combos?limit=1&sort=recent'),
            fetchJson('/api/gc/recent-laps?limit=12&sort=recent&valid=all').catch(() => null),
            fetchJson('/api/gc/leaderboard?scope=activeCombo&limit=20').catch(() => null),
            fetchJson('/api/gc/identity/me').catch(() => null),
            fetchJson('/api/admin/status').catch(() => null)
          ]);

          const combo = items(combosData)[0] || null;
          const recent = items(recentData);
          const leaderboard = items(leaderboardData);

          renderSession(identityData, adminData);

          const globalStats = renderGlobal(diagnostics);
          renderCombo(combo, leaderboard, recent);
          renderRecentTable(recent, leaderboard);

          document.documentElement.dataset.gcAppDataCore = 'primary';
          document.documentElement.dataset.gcAppDataCoreVersion = 'v1.8-single';
          document.documentElement.dataset.gcAppSingleRenderer = 'v1.8';

          ensureBadge('ok', 'Datos actualizados');

          state.lastOkAt = new Date().toISOString();
          state.lastError = null;
          state.diagnostics = diagnostics;
          state.combo = combo;
          state.recent = recentData;
          state.leaderboard = leaderboardData;

          window.GCAppDataCorePrimary = {
            status: 'ok',
            mode: 'single-renderer',
            diagnostics,
            combos: combosData,
            recent: recentData,
            leaderboard: leaderboardData,
            identity: identityData,
            admin: adminData,
            renderedAt: state.lastOkAt
          };

          window.GCAppSingleRendererStatus = () => ({ ...state });

          console.info('[GC /app Single Renderer v1.8]', {
            totalLaps: globalStats.totalLaps,
            drivers: globalStats.driversCount,
            combos: globalStats.combosCount,
            combo: combo?.trackName || combo?.canonicalTrackName,
            cars: comboCars(combo || {}).length
          });
        } catch (error) {
          state.lastError = error?.message || String(error);
          document.documentElement.dataset.gcAppDataCore = 'single-error';
          ensureBadge('error', 'Error al actualizar');
          window.GCAppSingleRendererStatus = () => ({ ...state });
          console.warn('[GC /app Single Renderer v1.8] failed:', error);
        }
      }

      const start = () => {
        window.setTimeout(render, CONFIG.firstDelayMs);
        window.setTimeout(render, CONFIG.secondDelayMs);
        window.clearInterval(window.GCAppSingleRendererTimer);
        window.GCAppSingleRendererTimer = window.setInterval(render, CONFIG.refreshMs);
      };

      window.GCAppSingleRendererReload = render;

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
      else start();
    })();
    /* GC_APP_SINGLE_RENDERER_V1_8_END */
  </script>


  <script is:inline>
    /* GC_APP_SINGLE_RENDERER_SESSION_FIX_V1_10_MARKER */
    (() => {
      document.documentElement.dataset.gcAppSessionFix = 'v1.10';
    })();
  </script>




  <script is:inline>
    /* GC_APP_ACSM_TIMING_INTEGRATED_V1_START */
    (() => {
      const ids = {
        liveBody: 'gcAcsLiveBody',
        storedBody: 'gcAcsStoredBody',
        liveCount: 'gcAcsLiveCount',
        storedCount: 'gcAcsStoredCount',
        sessionMeta: 'gcAcsSessionMeta',
        sessionState: 'gcAppSessionState',
        apiState: 'gcApiState',
        tapeTrack: 'gcTapeTrack',
        metricDrivers: 'gcMetricDrivers',
        clock: 'gcAppClock'
      };

      const byId = (id) => document.getElementById(id);
      const setText = (id, value) => {
        const node = byId(id);
        if (node) node.textContent = String(value ?? '--');
      };
      const esc = (value) => String(value ?? '-').replace(/[&<>'"]/g, (char) => ({
        '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;'
      }[char]));
      const clean = (value, fallback = '-') => {
        const text = String(value ?? '').replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
        return text || fallback;
      };
      const formatSpeed = (value) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) && parsed > 0 ? `${Math.round(parsed)} km/h` : '-';
      };
      const safeLap = (value) => {
        const raw = String(value ?? '').trim();
        if (!raw || raw === '-' || raw.includes('/') || raw.includes(',')) return '-';
        return raw;
      };
      const splitAt = (row, index) => {
        const split = Array.isArray(row?.bestSplits) ? row.bestSplits[index] : null;
        return split?.splitTimeFormatted || split?.formatted || split?.timeFormatted || '-';
      };
      const fmtUpdated = (value) => {
        const parsed = Date.parse(String(value ?? ''));
        if (!Number.isFinite(parsed)) return '--:--';
        return new Date(parsed).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      };
      const formatRemaining = (server) => {
        const time = Number(server?.time);
        const elapsed = Number(server?.elapsedMilliseconds);
        if (!Number.isFinite(time) || !Number.isFinite(elapsed) || time <= 0) return '-';
        const total = Math.max(0, time * 60000 - elapsed);
        const days = Math.floor(total / 86400000);
        const hours = Math.floor((total % 86400000) / 3600000);
        const minutes = Math.floor((total % 3600000) / 60000);
        return days > 0 ? `${days}d ${hours}h ${String(minutes).padStart(2, '0')}m` : `${hours}h ${String(minutes).padStart(2, '0')}m`;
      };

      const liveRows = (rows) => {
        if (!rows.length) return '<tr><td colspan="11">Sin pilotos conectados en ACSM.</td></tr>';
        return rows.map((row, index) => `
          <tr>
            <td>${esc(row.position ?? index + 1)}</td>
            <td>${row.isInPits ? '<span class="rc-state rc-state--pit">PIT</span>' : '<span class="rc-state rc-state--live">LIVE</span>'}</td>
            <td><strong>${esc(clean(row.driverName))}</strong><small>${esc(row.driverInitials || '')}</small></td>
            <td>${esc(clean(row.carName || row.carModel))}</td>
            <td>${esc(row.tyres || '-')}</td>
            <td><strong>${esc(safeLap(row.lastLapFormatted || row.currentLapFormatted))}</strong></td>
            <td><strong>${esc(safeLap(row.bestLapFormatted))}</strong></td>
            <td>${esc(row.split ?? row.gap ?? '-')}</td>
            <td>${esc(row.laps ?? '-')}</td>
            <td>${esc(row.numPits ?? '-')}</td>
            <td>${esc(row.ping ?? '-')}</td>
          </tr>
        `).join('');
      };

      const storedRows = (rows) => {
        if (!rows.length) return '<tr><td colspan="10">Sin referencias stored en ACSM.</td></tr>';
        return rows.map((row, index) => `
          <tr>
            <td>${esc(row.position ?? index + 1)}</td>
            <td><strong>${esc(clean(row.driverName))}</strong><small>${esc(row.driverInitials || '')}</small></td>
            <td>${esc(clean(row.carName || row.carModel))}</td>
            <td>${esc(row.tyres || '-')}</td>
            <td><strong>${esc(safeLap(row.bestLapFormatted))}</strong></td>
            <td>${esc(splitAt(row, 0))}</td>
            <td>${esc(splitAt(row, 1))}</td>
            <td>${esc(splitAt(row, 2))}</td>
            <td>${esc(row.laps ?? '-')}</td>
            <td>${esc(formatSpeed(row.topSpeedBestLap ?? row.topSpeedThisLap))}</td>
          </tr>
        `).join('');
      };

      const render = (payload) => {
        const server = payload?.server ?? {};
        const live = Array.isArray(payload?.connectedDrivers) ? payload.connectedDrivers : [];
        const stored = Array.isArray(payload?.storedTimes) ? payload.storedTimes : [];
        const track = clean([server.track, server.trackConfig].filter(Boolean).join(' '), 'TRACK');
        const session = clean(server.sessionName || server.name, 'ACSM');
        const temps = `${server.ambientTemp ?? '-'}°C AIR / ${server.roadTemp ?? '-'}°C TRACK`;
        const remaining = formatRemaining(server);

        const liveBody = byId(ids.liveBody);
        const storedBody = byId(ids.storedBody);
        if (liveBody) liveBody.innerHTML = liveRows(live);
        if (storedBody) storedBody.innerHTML = storedRows(stored);

        setText(ids.liveCount, `${live.length} LIVE`);
        setText(ids.storedCount, `${stored.length} STORED`);
        setText(ids.sessionMeta, `${session} · ${track} · ${temps} · ${remaining}`);
        setText(ids.sessionState, session.toUpperCase());
        setText(ids.apiState, 'EN PISTA');
        setText(ids.tapeTrack, track);
        setText(ids.metricDrivers, String(live.length));
        setText(ids.clock, fmtUpdated(payload.updatedAt));

        document.documentElement.dataset.gcAppAcsTiming = 'ok';
      };

      const setError = (message) => {
        const liveBody = byId(ids.liveBody);
        const storedBody = byId(ids.storedBody);
        if (liveBody) liveBody.innerHTML = '<tr><td colspan="11">ACSM sin datos.</td></tr>';
        if (storedBody) storedBody.innerHTML = '<tr><td colspan="10">ACSM sin datos.</td></tr>';
        setText(ids.liveCount, '0 LIVE');
        setText(ids.storedCount, '0 STORED');
        setText(ids.sessionMeta, message || 'ACSM sin datos');
        document.documentElement.dataset.gcAppAcsTiming = 'error';
      };

      async function loadAcsTiming() {
        try {
          const response = await fetch('/api/live-timing', { cache: 'no-store', credentials: 'include' });
          const payload = await response.json().catch(() => null);
          if (!response.ok || !payload || payload.ok !== true) throw new Error(payload?.error || 'ACSM unavailable');
          render(payload);
        } catch (error) {
          console.warn('[GC /app ACSM timing] error', error?.message || error);
          setError(error?.message || 'ACSM unavailable');
        }
      }

      const start = () => {
        loadAcsTiming();
        window.clearInterval(window.GCAppAcsTimingTimer);
        window.GCAppAcsTimingTimer = window.setInterval(loadAcsTiming, 5000);
      };

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
      else start();
    })();
    /* GC_APP_ACSM_TIMING_INTEGRATED_V1_END */
  </script>

  <script is:inline>
    /* GC_APP_COMBO_HOTLAPS_FILTERED_V2_5_START */
    (() => {
      const table = document.getElementById('gcRefsTable');
      if (!table) return;

      const controls = {
        search: document.getElementById('gcHotlapSearch'),
        driver: document.getElementById('gcHotlapDriverFilter'),
        car: document.getElementById('gcHotlapCarFilter'),
        valid: document.getElementById('gcHotlapValidFilter'),
        sort: document.getElementById('gcHotlapSort'),
        pageSize: document.getElementById('gcHotlapPageSize'),
        prev: document.getElementById('gcHotlapPrev'),
        next: document.getElementById('gcHotlapNext'),
        pageInfo: document.getElementById('gcHotlapPageInfo'),
        meta: document.getElementById('gcRefsMeta'),
        track: document.getElementById('gcRefsTrack'),
        sortButtons: Array.from(document.querySelectorAll('[data-sort-key]'))
      };

      const endpoints = [
        '/api/gc/recent-laps?scope=activeCombo&limit=50000&sort=recent&valid=all',
        '/api/laps?scope=activeCombo&limit=50000&sort=recent&valid=all',
        '/api/gc/leaderboard?scope=global&limit=all&group=all&valid=all'
      ];

      const state = {
        rows: [],
        page: 1,
        endpoint: '',
        updatedAt: null,
        sortKey: 'date',
        sortDir: 'desc'
      };

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source, path)) return source[path];
        return String(path).split('.').reduce((acc, part) => {
          if (acc == null) return undefined;
          if (/^\d+$/.test(part) && Array.isArray(acc)) return acc[Number(part)];
          return acc[part];
        }, source);
      };

      const pick = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source, path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return undefined;
      };

      const list = (payload) => {
        if (Array.isArray(payload)) return payload;
        if (!payload || typeof payload !== 'object') return [];
        return (
          payload.items ||
          payload.laps ||
          payload.hotlaps ||
          payload.leaderboard ||
          payload.data?.items ||
          payload.data?.laps ||
          payload.data?.leaderboard ||
          payload.data?.hotlaps ||
          []
        );
      };

      const text = (value, fallback = '-') => {
        if (value === undefined || value === null || value === '') return fallback;
        if (Array.isArray(value)) return value.length ? text(value[0], fallback) : fallback;
        if (typeof value === 'object') {
          return text(
            value.displayName ?? value.visibleName ?? value.cleanName ?? value.uiName ??
            value.uiCarName ?? value.uiTrackName ?? value.name ?? value.Name ??
            value.driverName ?? value.playerName ?? value.code,
            fallback
          );
        }
        return String(value).replace(/_/g, ' ').replace(/\s+/g, ' ').trim() || fallback;
      };

      const esc = (value) => String(value ?? '-').replace(/[&<>'"]/g, (char) => ({
        '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;'
      }[char]));

      const number = (value, fallback = 0) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      };

      const setText = (id, value) => {
        const node = document.getElementById(id);
        if (node) node.textContent = String(value ?? '--');
      };

      const driverName = (row) => text(pick(row, [
        'driver.displayName','driver.visibleName','driver.name','driverDisplayName','driverVisibleName',
        'driverName','playerName','pilotName','name','Name'
      ]), 'Piloto');

      const carName = (row) => text(pick(row, [
        'car.displayName','car.visibleName','car.name','carDisplayName','carVisibleName',
        'carName','uiCarName','Car','car'
      ]), 'Coche');

      const trackName = (row) => text(pick(row, [
        'track.displayName','track.visibleName','track.name','trackDisplayName','trackVisibleName',
        'trackName','uiTrackName','Track','track'
      ]), 'Circuito');

      const lapMs = (row) => {
        const parsed = Number(pick(row, ['lapTimeMs','bestLapMs','timeMs','LapTime','lapTimeMilliseconds']));
        return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
      };

      const fmtMs = (value) => {
        const ms = number(value, 0);
        if (!ms) return '--';
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        const millis = Math.floor(ms % 1000);
        return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
      };

      const lapDisplay = (row) => text(pick(row, ['lapTimeFormatted','lapTimeText','timeFormatted','lapTime','bestLapTime']), '') || fmtMs(lapMs(row));

      const splitValue = (row, index) => {
        const direct = pick(row, [
          `s${index + 1}`,
          `S${index + 1}`,
          `sector${index + 1}`,
          `sector${index + 1}Formatted`,
          `split${index + 1}`,
          `split${index + 1}Formatted`,
          `splits.${index}`,
          `sectors.${index}`,
          `bestSplits.${index}.splitTimeFormatted`,
          `bestSplits.${index}.timeFormatted`,
          `bestSplits.${index}.formatted`,
          `bestSplits.${index}.time`,
          `BestSplits.${index}`
        ]);
        if (typeof direct === 'object') return text(direct.formatted ?? direct.timeFormatted ?? direct.splitTimeFormatted ?? direct.time, '--');
        if (typeof direct === 'number') return fmtMs(direct);
        return text(direct, '--');
      };

      const splitMs = (row, index) => {
        const direct = pick(row, [
          `sector${index + 1}Ms`,
          `s${index + 1}Ms`,
          `split${index + 1}Ms`,
          `sectorTimesMs.${index}`,
          `sectorTimes.${index}`,
          `splitsMs.${index}`,
          `splits.${index}`,
          `sectors.${index}`,
          `BestSplits.${index}`
        ]);
        if (typeof direct === 'object') {
          const nested = pick(direct, ['timeMs','ms','time','value']);
          return number(nested, 0) || null;
        }
        const parsed = number(direct, 0);
        return parsed > 0 ? parsed : null;
      };

      const speed = (row) => {
        const raw = pick(row, ['maxSpeedKmh','topSpeedKmh','topSpeed','maxSpeed','speedKmh','MaxSpeed_KMH']);
        const parsed = Number(raw);
        return Number.isFinite(parsed) && parsed > 0 ? `${Math.round(parsed)} km/h` : '--';
      };

      const lapDateMs = (row) => {
        const iso = pick(row, ['timestampIso','dateIso','createdAt','updatedAt','lastSeenAt','latestLapAt','session.endTimeIso','session.startTimeIso']);
        if (iso) {
          const parsed = Date.parse(String(iso));
          if (Number.isFinite(parsed)) return parsed;
        }
        const raw = pick(row, ['timestamp','Timestamp','date']);
        if (typeof raw === 'number') return raw > 20000000000 ? raw : raw * 1000;
        const parsed = Date.parse(String(raw ?? ''));
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const fmtDate = (row) => {
        const ms = lapDateMs(row);
        if (!ms) return '--';
        return new Date(ms).toLocaleString('es-ES', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
      };

      const isInvalid = (row) => {
        const value = pick(row, ['valid','isValid','Valid']);
        return value === 0 || value === false || value === '0' || value === 'false' || value === 'no' || value === 'NO';
      };

      const validLabel = (row) => isInvalid(row) ? 'NO VÁLIDA' : 'VÁLIDA';

      const uniqueSorted = (rows, getter) => [...new Set(rows.map(getter).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));

      const fillSelect = (select, values, label) => {
        if (!select) return;
        const current = select.value;
        select.innerHTML = `<option value="">${label}</option>` + values.map((value) => `<option value="${esc(value)}">${esc(value)}</option>`).join('');
        if (values.includes(current)) select.value = current;
      };

      const activeComboTrack = () => {
        const comboTrack = document.getElementById('gcComboTrack')?.textContent?.trim();
        if (comboTrack && !/cargando|sin combo/i.test(comboTrack)) return comboTrack;
        const first = state.rows[0];
        return first ? trackName(first) : 'Circuito del combo';
      };

      const filteredRows = () => {
        const query = (controls.search?.value || '').trim().toLowerCase();
        const driver = controls.driver?.value || '';
        const car = controls.car?.value || '';
        const valid = controls.valid?.value || 'all';
        const sort = controls.sort?.value || 'recent';

        let rows = state.rows.filter((row) => {
          const rowDriver = driverName(row);
          const rowCar = carName(row);
          const haystack = [rowDriver, rowCar, trackName(row), lapDisplay(row), fmtDate(row), validLabel(row)].join(' ').toLowerCase();
          if (query && !haystack.includes(query)) return false;
          if (driver && rowDriver !== driver) return false;
          if (car && rowCar !== car) return false;
          if (valid === 'valid' && isInvalid(row)) return false;
          if (valid === 'invalid' && !isInvalid(row)) return false;
          return true;
        });

        const compareText = (a, b, getter) => getter(a).localeCompare(getter(b), 'es', { sensitivity: 'base' });
        const compareNumber = (a, b, getter, emptyLast = true) => {
          const av = getter(a);
          const bv = getter(b);
          const ae = av === null || av === undefined || !Number.isFinite(Number(av));
          const be = bv === null || bv === undefined || !Number.isFinite(Number(bv));
          if (ae && be) return 0;
          if (ae) return emptyLast ? 1 : -1;
          if (be) return emptyLast ? -1 : 1;
          return Number(av) - Number(bv);
        };

        const sortByDropdown = () => {
          if (sort === 'timeAsc') return { key: 'time', dir: 'asc' };
          if (sort === 'timeDesc') return { key: 'time', dir: 'desc' };
          if (sort === 'driver') return { key: 'driver', dir: 'asc' };
          if (sort === 'car') return { key: 'car', dir: 'asc' };
          return { key: 'date', dir: 'desc' };
        };

        const activeSort = state.sortKey ? { key: state.sortKey, dir: state.sortDir } : sortByDropdown();
        rows = rows.sort((a, b) => {
          let result = 0;
          if (activeSort.key === 'index') result = 0;
          else if (activeSort.key === 'driver') result = compareText(a, b, driverName) || compareNumber(a, b, lapMs);
          else if (activeSort.key === 'car') result = compareText(a, b, carName) || compareText(a, b, driverName) || compareNumber(a, b, lapMs);
          else if (activeSort.key === 's1') result = compareNumber(a, b, (row) => splitMs(row, 0));
          else if (activeSort.key === 's2') result = compareNumber(a, b, (row) => splitMs(row, 1));
          else if (activeSort.key === 's3') result = compareNumber(a, b, (row) => splitMs(row, 2));
          else if (activeSort.key === 'time') result = compareNumber(a, b, lapMs);
          else if (activeSort.key === 'speed') result = compareNumber(a, b, (row) => number(pick(row, ['maxSpeedKmh','topSpeedKmh','topSpeed','maxSpeed','speedKmh','MaxSpeed_KMH']), NaN));
          else if (activeSort.key === 'valid') result = Number(isInvalid(a)) - Number(isInvalid(b)) || compareNumber(a, b, lapMs);
          else result = lapDateMs(a) - lapDateMs(b);
          return activeSort.dir === 'desc' ? -result : result;
        });

        return rows;
      };

      const updateSortButtons = () => {
        controls.sortButtons?.forEach((button) => {
          const key = button.getAttribute('data-sort-key');
          const active = key === state.sortKey;
          button.classList.toggle('is-active', active);
          button.dataset.sortDir = active ? state.sortDir : '';
        });
      };

      const renderRows = () => {
        updateSortButtons();
        const rows = filteredRows();
        const pageSize = Math.max(1, Number(controls.pageSize?.value || 50));
        const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
        state.page = Math.min(Math.max(1, state.page), totalPages);
        const start = (state.page - 1) * pageSize;
        const visible = rows.slice(start, start + pageSize);

        table.innerHTML = visible.length ? visible.map((row, offset) => {
          const absolute = start + offset + 1;
          const invalid = isInvalid(row);
          return `
            <tr>
              <td>${absolute}</td>
              <td><strong>${esc(driverName(row))}</strong></td>
              <td>${esc(carName(row))}</td>
              <td>${esc(splitValue(row, 0))}</td>
              <td>${esc(splitValue(row, 1))}</td>
              <td>${esc(splitValue(row, 2))}</td>
              <td><strong>${esc(lapDisplay(row))}</strong></td>
              <td>${esc(speed(row))}</td>
              <td><span class="rc-valid ${invalid ? 'rc-valid--bad' : 'rc-valid--ok'}">${validLabel(row)}</span></td>
              <td>${esc(fmtDate(row))}</td>
            </tr>
          `;
        }).join('') : '<tr><td colspan="10">Sin vueltas con esos filtros.</td></tr>';

        if (controls.meta) {
          controls.meta.textContent = `${rows.length.toLocaleString('es-ES')} de ${state.rows.length.toLocaleString('es-ES')} vueltas del combo · página ${state.page}/${totalPages}`;
        }
        if (controls.track) controls.track.textContent = activeComboTrack();
        if (controls.pageInfo) controls.pageInfo.textContent = `Página ${state.page} / ${totalPages}`;
        if (controls.prev) controls.prev.disabled = state.page <= 1;
        if (controls.next) controls.next.disabled = state.page >= totalPages;
      };

      const updateMetrics = (rows, payload) => {
        const uniqueDrivers = new Set(rows.map(driverName).filter(Boolean));
        const latest = [...rows].sort((a, b) => lapDateMs(b) - lapDateMs(a))[0] || null;
        const totalFromPayload = Number(payload?.totalLaps) || Number(payload?.total) || Number(payload?.count) || rows.length;

        setText('gcMetricDrivers', String(uniqueDrivers.size));
        setText('gcFeedDrivers', String(uniqueDrivers.size));
        setText('gcMetricLaps', String(totalFromPayload));
        setText('gcQuickRefs', String(totalFromPayload));
        setText('gcMetricLastActivity', latest ? fmtDate(latest) : '--');
        setText('gcFeedLastActivity', latest ? fmtDate(latest) : '--');
        setText('gcQuickLast', latest ? lapDisplay(latest) : '--');
        setText('gcQuickDb', 'Activo');
        setText('gcQuickDbMeta', 'Combo sincronizado');
      };

      async function fetchFirst() {
        let lastError = null;
        for (const endpoint of endpoints) {
          try {
            const response = await fetch(endpoint, { cache: 'no-store', credentials: 'include' });
            const payload = await response.json().catch(() => null);
            if (!response.ok || !payload) throw new Error(`${endpoint} ${response.status}`);
            const rows = list(payload);
            if (rows.length) return { endpoint, payload, rows };
          } catch (error) {
            lastError = error;
            console.warn('[GC /app combo hotlaps] endpoint failed', endpoint, error?.message || error);
          }
        }
        throw lastError || new Error('No combo hotlaps endpoint available');
      }

      async function loadComboHotlaps() {
        try {
          const { endpoint, payload, rows } = await fetchFirst();
          state.rows = rows;
          state.endpoint = endpoint;
          state.updatedAt = new Date().toISOString();
          // Mantener página y orden al refrescar para que la tabla no salte sola.

          fillSelect(controls.driver, uniqueSorted(rows, driverName), 'Todos');
          fillSelect(controls.car, uniqueSorted(rows, carName), 'Todos');
          updateMetrics(rows, payload);
          renderRows();

          document.documentElement.dataset.gcAppHotlapsScope = 'active-combo';
          window.GCAppComboHotlaps = { status: 'ok', endpoint, rows: rows.length, updatedAt: state.updatedAt };
        } catch (error) {
          console.warn('[GC /app combo hotlaps] error', error);
          setText('gcApiState', 'Error');
          if (controls.meta) controls.meta.textContent = 'No se pudieron cargar las vueltas del combo';
          table.innerHTML = '<tr><td colspan="10">No se pudieron cargar las vueltas del combo.</td></tr>';
          window.GCAppComboHotlaps = { status: 'error', error: error?.message || String(error) };
        }
      }

      [controls.search, controls.driver, controls.car, controls.valid, controls.pageSize].forEach((control) => {
        control?.addEventListener('input', () => { state.page = 1; renderRows(); });
        control?.addEventListener('change', () => { state.page = 1; renderRows(); });
      });
      controls.sort?.addEventListener('change', () => {
        const value = controls.sort.value;
        if (value === 'timeAsc') { state.sortKey = 'time'; state.sortDir = 'asc'; }
        else if (value === 'timeDesc') { state.sortKey = 'time'; state.sortDir = 'desc'; }
        else if (value === 'driver') { state.sortKey = 'driver'; state.sortDir = 'asc'; }
        else if (value === 'car') { state.sortKey = 'car'; state.sortDir = 'asc'; }
        else { state.sortKey = 'date'; state.sortDir = 'desc'; }
        state.page = 1;
        renderRows();
      });
      controls.sortButtons?.forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.getAttribute('data-sort-key') || 'date';
          if (state.sortKey === key) {
            state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
          } else {
            state.sortKey = key;
            state.sortDir = ['date', 'speed'].includes(key) ? 'desc' : 'asc';
          }
          if (controls.sort) controls.sort.value = state.sortKey === 'date' && state.sortDir === 'desc' ? 'recent' : controls.sort.value;
          state.page = 1;
          renderRows();
        });
      });
      controls.prev?.addEventListener('click', () => { state.page -= 1; renderRows(); });
      controls.next?.addEventListener('click', () => { state.page += 1; renderRows(); });

      loadComboHotlaps();
      window.clearInterval(window.GCAppComboHotlapsTimer);
      window.GCAppComboHotlapsTimer = window.setInterval(loadComboHotlaps, 60000);
    })();
    /* GC_APP_COMBO_HOTLAPS_FILTERED_V2_5_END */
  </script>

  <script is:inline>
    /* GC_APP_HOTLAPS_ALL_TRACKS_V1_START */
    /*
      Build guard compatibility marker.
      The legacy all-tracks hotlaps module is intentionally replaced by the
      current-combo filtered Race Control table. Do not reintroduce the old UI.
    */
    (() => {
      document.documentElement.dataset.gcAppHotlapsIntegration = 'current-combo-filtered';
    })();
    /* GC_APP_HOTLAPS_ALL_TRACKS_V1_END */
    /* GC_APP_HOTLAPS_ALL_TRACKS_SAFE_V1 */
  </script>

</AppLayout>
