---
import AppLayout from '../layouts/AppLayout.astro';

const serverJoinUrl = 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153';
const carsDriveUrl = 'https://drive.google.com/drive/folders/1BXJJkPOo7ZuhIKf_VegI5g8serZsJw7W?usp=drive_link';
const tracksDriveUrl = 'https://drive.google.com/drive/folders/1xSrI8aPBLH15wrytkR-IUjMQPWEVyfQw?usp=drive_link';
---
<AppLayout
  title="Race Control | GrassCutters Racing"
  description="Race Control de GrassCutters Racing con combo activo, actividad reciente, hotlaps y accesos principales."
  canonicalPath="/app"
  ogImage="/og/platform-og-v1531.png"
  ogImageAlt="Panel GrassCutters Racing"
>
  <div class="gc-page gc-app-dashboard-v3 gc-app-visual-v183">
    <section class="gc-hero gc-hero--compact gc-app-hero-v3">
      <div>
        <span class="gc-kicker">GrassCutters Race Control</span>
        <h1 class="gc-title">Race Control</h1>
        <p class="gc-subtitle">Combo activo, actividad reciente y accesos rápidos para entrar a pista.</p>
        <div class="gc-hero__meta">
          <span class="gc-chip gc-chip--accent" id="gcAppStatusChip">Sistema listo</span>
          <span class="gc-chip" id="gcAppComboChip">Combo</span>
          <span class="gc-chip" id="gcAppClock">--:--</span>
        </div>
      </div>
      <aside class="gc-live-panel gc-app-session-v3" aria-label="Estado de sesión">
        <div class="gc-live-panel__title"><span>Sesión</span><strong id="gcAppSessionState">Listo</strong></div>
        <div class="gc-status-list">
          <div class="gc-status-row"><span>Cuenta</span><strong id="gcAppSessionUser">...</strong></div>
          <div class="gc-status-row"><span>Rol</span><strong id="gcAppSessionRole">...</strong></div>
          <div class="gc-status-row"><span>Piloto</span><strong id="gcAppSessionPilot">...</strong></div>
        </div>
      </aside>
    </section>

    <section class="gc-metrics gc-app-metrics-v3" aria-label="Métricas rápidas">
      <div class="gc-metric"><span>Pilotos</span><strong id="gcMetricDrivers">...</strong><small>detectados</small></div>
      <div class="gc-metric"><span>Vueltas</span><strong id="gcMetricLaps">...</strong><small>registradas</small></div>
      <div class="gc-metric"><span>Combos</span><strong id="gcMetricCombos">...</strong><small>activos</small></div>
      <div class="gc-metric"><span>Última actividad</span><strong id="gcMetricLastActivity">...</strong><small>vueltas recientes</small></div>
    </section>

    <section class="gc-app-top-grid-v3" aria-label="Resumen principal">
      <article class="gc-section gc-app-combo-v3 gc-track-image-card" data-track-image data-track-name="">
        <div class="gc-section-head gc-app-card-head-v3">
          <div>
            <h2>Combo activo</h2>
            <p id="gcComboHint">Actividad reciente</p>
          </div>
          <a class="gc-btn gc-btn--primary gc-app-combo-open-v5" href="/combos" id="gcComboLink">Ver combo</a>
        </div>
        <div class="gc-app-combo-body-v3">
          <div>
            <span class="gc-app-label-v3">Circuito</span>
            <h3 id="gcComboTrack">Cargando...</h3>
            <div class="gc-app-chip-list-v3" id="gcComboCars"><span class="gc-chip">Leyendo coches</span></div>
          </div>

        </div>
        <div class="gc-app-mini-stats-v3">
          <div><span>Vueltas</span><strong id="gcComboLaps">--</strong></div>
          <div><span>Pilotos</span><strong id="gcComboDrivers">--</strong></div>
          <div><span>Estado</span><strong id="gcComboFamily">--</strong></div>
        </div>

        <div class="gc-app-pit-actions-v6" aria-label="Acciones rápidas del combo">
          <a class="gc-btn gc-btn--primary" href={serverJoinUrl} target="_blank" rel="noreferrer">Entrar al server</a>
          <a class="gc-btn" href={carsDriveUrl} target="_blank" rel="noreferrer">Coches</a>
          <a class="gc-btn" href={tracksDriveUrl} target="_blank" rel="noreferrer">Circuito</a>
          <a class="gc-btn" href="/hotlaps">Hotlaps</a>
        </div>
      </article>

      <article class="gc-section gc-app-readout-card-v3">
        <div class="gc-section-head gc-app-card-head-v3">
          <div>
            <h2>Lectura de pista</h2>
            <p>Estado global del servidor y última actividad registrada.</p>
          </div>
          <span class="gc-chip" id="gcApiState">Estado</span>
        </div>
        <div class="gc-app-readout-grid-v3">
          <div class="gc-app-readout-v3"><span>Vueltas servidor</span><strong id="gcQuickRefs">--</strong><small>total registradas</small></div>
          <div class="gc-app-readout-v3 gc-app-server-uptime-v1535"><span>Servidor online</span><strong id="gcServerUptimeDays">--</strong><small id="gcServerUptimeMeta">desde primer registro</small></div>
          <div class="gc-app-readout-v3"><span>Última vuelta</span><strong id="gcQuickLast">--</strong><small id="gcQuickLastMeta">sin datos</small></div>
          <div class="gc-app-readout-v3"><span>Datos</span><strong id="gcQuickDb">--</strong><small id="gcQuickDbMeta">comprobando</small></div>
        </div>
      
        <div class="gc-app-top-driver-v1535" aria-label="Mejor piloto del combo">
          <div class="gc-app-top-driver-v1535__avatar">
            <img id="gcTopDriverAvatar" src="/images/pilot-avatar-default.png" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="gc-app-top-driver-v1535__body">
            <span>Mejor piloto combo</span>
            <strong id="gcTopDriverName">--</strong>
            <small id="gcTopDriverMeta">Sin referencia cargada</small>
          </div>
          <div class="gc-app-top-driver-v1535__time">
            <span>Tiempo</span>
            <strong id="gcTopDriverTime">--</strong>
          </div>
        </div>
</article>
    </section>

    <section class="gc-section gc-app-references-v3">
      <div class="gc-section-head gc-app-card-head-v3">
        <div>
          <h2>Actividad reciente</h2>
          <p id="gcRefsMeta">Cargando vueltas...</p>
        </div>
        <a class="gc-feature-link" href="/hotlaps">Ver hotlaps</a>
      </div>
      <div class="gc-table-wrap gc-app-table-wrap-v3">
        <table class="gc-table gc-app-table-v3">
          <thead><tr><th>Piloto</th><th>Coche</th><th>Circuito</th><th>Tiempo</th><th>Fecha</th></tr></thead>
          <tbody id="gcRefsTable"><tr><td colspan="5">Leyendo vueltas recientes...</td></tr></tbody>
        </table>
      </div>
    </section>

    <section class="gc-section gc-app-actions-v3">
      <div class="gc-section-head gc-app-card-head-v3">
        <div>
          <h2>Boxes</h2>
          <p>Accesos principales para salir a pista.</p>
        </div>
        <span class="gc-chip gc-chip--accent">Pit wall</span>
      </div>
      <div class="gc-app-action-grid-v3">
        <a class="gc-app-action-card-v3" href="/hotlaps"><span>01</span><div><strong>Hotlaps</strong><p>Tiempos y filtros.</p></div></a>
        <a class="gc-app-action-card-v3" href="/combos"><span>02</span><div><strong>Combos</strong><p>Combos y referencias.</p></div></a>
        <a class="gc-app-action-card-v3" href="/pilotos"><span>03</span><div><strong>Pilotos</strong><p>Perfiles y actividad.</p></div></a>
        <a class="gc-app-action-card-v3" href="/perfil"><span>04</span><div><strong>Mi perfil</strong><p>Cuenta y piloto.</p></div></a>
        <a class="gc-app-action-card-v3" href="/herramientas"><span>05</span><div><strong>Herramientas</strong><p>Calculadoras y ajustes.</p></div></a>
      </div>
    </section>

  </div>

  <style is:global>
    /*
      GC_APP_VISUAL_KEEP_SIDEBAR_V183
      Mantiene AppLayout y sidebar. Cambia solo la piel interna de /app:
      colores, fuentes, fondos, cards, hovers, botones, tabla y responsive para acercarlo a la home.
    */

    .gc-app-visual-v183{
      --app-green:#8cff18;
      --app-green-soft:#b7ff4b;
      --app-bg:#010301;
      --app-card:#061006;
      --app-card-2:#0a1809;
      --app-card-3:#10280d;
      --app-border:rgba(140,255,24,.22);
      --app-border-strong:rgba(140,255,24,.46);
      --app-text:#f5fff0;
      --app-muted:#9baa92;
      --app-dim:#68745f;
      --app-blue:#5b95ff;
      --app-red:#ff5e5e;
      --app-radius:14px;
      --app-shadow:0 22px 70px rgba(0,0,0,.48);
      position:relative;
      isolation:isolate;
      max-width:1280px;
      margin:0 auto;
      padding:clamp(18px,2.2vw,28px);
      display:grid;
      gap:clamp(16px,2vw,24px);
      color:var(--app-text);
      background:
        radial-gradient(circle at 18% 0%,rgba(140,255,24,.13),transparent 34rem),
        radial-gradient(circle at 82% 4%,rgba(58,116,255,.08),transparent 30rem),
        linear-gradient(180deg,#061006 0%,#020502 42%,#000 100%);
      border-left:1px solid rgba(140,255,24,.10);
    }

    .gc-app-visual-v183::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-1;
      pointer-events:none;
      opacity:.13;
      background:
        linear-gradient(rgba(140,255,24,.075) 1px,transparent 1px),
        linear-gradient(90deg,rgba(140,255,24,.055) 1px,transparent 1px);
      background-size:42px 42px;
      mask-image:linear-gradient(180deg,black,transparent 82%);
    }

    .gc-app-visual-v183 :where(h1,h2,h3,strong){
      color:var(--app-text);
      font-family:var(--font-display,var(--font-sans,Inter,system-ui,sans-serif));
      font-weight:1000;
      letter-spacing:-.065em;
    }

    .gc-app-visual-v183 :where(p,small){
      color:var(--app-muted);
    }

    .gc-app-visual-v183 :where(.gc-kicker,.gc-app-label-v3,.gc-metric span,.gc-app-mini-stats-v3 span,.gc-app-readout-v3 span,.gc-app-top-driver-v1535 span,.gc-live-panel__title span,.gc-app-action-card-v3 > span){
      color:var(--app-green);
      font-family:var(--font-mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace);
      font-size:.70rem;
      font-weight:1000;
      letter-spacing:.13em;
      text-transform:uppercase;
    }

    .gc-app-visual-v183 .gc-chip{
      display:inline-flex;
      min-height:28px;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:0 10px;
      border:1px solid rgba(140,255,24,.24);
      border-radius:4px;
      background:rgba(3,10,3,.82);
      color:var(--app-text);
      font-family:var(--font-mono,ui-monospace,monospace);
      font-size:.68rem;
      font-weight:950;
      letter-spacing:.08em;
      text-transform:uppercase;
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.025);
    }

    .gc-app-visual-v183 .gc-chip--accent{
      border-color:transparent;
      background:linear-gradient(180deg,#a4ff27,#72ee00);
      color:#061006;
      box-shadow:0 0 24px rgba(140,255,24,.23);
    }

    /* Hero: proporción de dashboard, piel de home */
    .gc-app-visual-v183 .gc-app-hero-v3{
      position:relative;
      min-height:clamp(340px,34vw,460px);
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(310px,380px);
      align-items:center;
      gap:clamp(20px,4vw,56px);
      margin:0;
      padding:clamp(34px,5vw,66px)!important;
      overflow:hidden;
      border:1px solid rgba(140,255,24,.22);
      border-radius:18px;
      background:
        linear-gradient(90deg,rgba(0,3,0,.94) 0%,rgba(2,8,3,.78) 48%,rgba(2,8,3,.56) 100%),
        radial-gradient(circle at 66% 34%,rgba(140,255,24,.17),transparent 20rem),
        linear-gradient(135deg,#17251e 0%,#08120a 56%,#020302 100%);
      box-shadow:var(--app-shadow),inset 0 -1px 0 rgba(140,255,24,.13);
    }

    .gc-app-visual-v183 .gc-app-hero-v3::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:0;
      opacity:.22;
      background:
        linear-gradient(rgba(140,255,24,.075) 1px,transparent 1px),
        linear-gradient(90deg,rgba(140,255,24,.055) 1px,transparent 1px);
      background-size:48px 48px;
      mask-image:linear-gradient(90deg,black,transparent 86%);
    }

    .gc-app-visual-v183 .gc-app-hero-v3::after{
      content:"RACE";
      position:absolute;
      right:-.02em;
      bottom:-.20em;
      z-index:0;
      color:rgba(140,255,24,.055);
      font-family:var(--font-display,var(--font-sans,Inter,system-ui,sans-serif));
      font-size:clamp(7rem,16vw,15rem);
      font-weight:1000;
      letter-spacing:-.11em;
      line-height:.78;
      pointer-events:none;
    }

    .gc-app-visual-v183 .gc-app-hero-v3 > *{
      position:relative;
      z-index:1;
    }

    .gc-app-visual-v183 .gc-app-hero-v3 .gc-title{
      max-width:720px;
      margin:.10em 0 .14em;
      color:#f6fff2;
      font-size:clamp(3.6rem,7vw,6.4rem);
      line-height:.78;
      letter-spacing:-.095em;
      text-transform:uppercase;
      text-wrap:balance;
      text-shadow:0 16px 48px rgba(0,0,0,.62);
    }

    .gc-app-visual-v183 .gc-app-hero-v3 .gc-subtitle{
      max-width:600px;
      margin:0;
      color:rgba(245,255,240,.74);
      font-size:clamp(1rem,1.4vw,1.2rem);
      line-height:1.45;
      font-weight:750;
    }

    .gc-app-visual-v183 .gc-hero__meta{
      display:flex;
      flex-wrap:wrap;
      gap:9px;
      margin-top:clamp(18px,2.2vw,28px);
    }

    .gc-app-visual-v183 .gc-app-session-v3{
      width:100%;
      padding:clamp(16px,2vw,22px);
      border:1px solid rgba(140,255,24,.28);
      border-radius:12px;
      background:
        radial-gradient(circle at 100% 0%,rgba(140,255,24,.16),transparent 11rem),
        linear-gradient(180deg,rgba(4,13,5,.95),rgba(0,4,1,.92));
      box-shadow:0 20px 58px rgba(0,0,0,.46),inset 0 0 0 1px rgba(255,255,255,.025);
    }

    .gc-app-visual-v183 .gc-live-panel__title{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding-bottom:13px;
      margin-bottom:12px;
      border-bottom:1px solid rgba(140,255,24,.16);
    }

    .gc-app-visual-v183 .gc-live-panel__title strong{
      display:inline-flex;
      min-height:29px;
      align-items:center;
      padding:0 11px;
      border:1px solid rgba(140,255,24,.32);
      border-radius:999px;
      background:rgba(140,255,24,.08);
      color:var(--app-green);
      font-family:var(--font-mono,ui-monospace,monospace);
      font-size:.70rem;
      letter-spacing:.08em;
      text-transform:uppercase;
    }

    .gc-app-visual-v183 .gc-status-list{
      display:grid;
      gap:0;
    }

    .gc-app-visual-v183 .gc-status-row{
      display:grid;
      grid-template-columns:88px minmax(0,1fr);
      gap:14px;
      align-items:center;
      min-height:42px;
      border-bottom:1px solid rgba(255,255,255,.07);
    }

    .gc-app-visual-v183 .gc-status-row:last-child{
      border-bottom:0;
    }

    .gc-app-visual-v183 .gc-status-row span{
      color:var(--app-muted);
      font-size:.84rem;
    }

    .gc-app-visual-v183 .gc-status-row strong{
      justify-self:end;
      overflow:hidden;
      max-width:100%;
      text-overflow:ellipsis;
      white-space:nowrap;
      font-size:.92rem;
      letter-spacing:-.035em;
    }

    /* Metrics */
    .gc-app-visual-v183 .gc-app-metrics-v3{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:0;
      margin:0;
      border:1px solid rgba(140,255,24,.26);
      background:rgba(1,8,2,.90);
      box-shadow:0 18px 52px rgba(0,0,0,.38);
    }

    .gc-app-visual-v183 .gc-metric{
      min-height:96px;
      display:grid;
      align-content:center;
      gap:6px;
      padding:17px 18px;
      border-right:1px solid rgba(140,255,24,.15);
      background:linear-gradient(180deg,rgba(9,24,8,.78),rgba(2,8,2,.90));
      transition:background .16s ease,transform .16s ease;
    }

    .gc-app-visual-v183 .gc-metric:last-child{
      border-right:0;
    }

    .gc-app-visual-v183 .gc-metric:hover{
      background:linear-gradient(180deg,rgba(20,58,13,.80),rgba(5,16,4,.92));
    }

    .gc-app-visual-v183 .gc-metric strong{
      display:block;
      color:#f7fff3;
      font-size:clamp(2.2rem,3.8vw,3.8rem);
      line-height:.86;
      letter-spacing:-.075em;
    }

    .gc-app-visual-v183 .gc-metric small{
      color:var(--app-dim);
      font-family:var(--font-mono,ui-monospace,monospace);
      font-size:.66rem;
      font-weight:850;
      letter-spacing:.08em;
      text-transform:uppercase;
    }

    /* Common cards */
    .gc-app-visual-v183 .gc-section{
      border:1px solid rgba(140,255,24,.18);
      border-radius:12px;
      background:
        radial-gradient(circle at 100% 0%,rgba(140,255,24,.09),transparent 14rem),
        linear-gradient(180deg,rgba(5,15,5,.95),rgba(1,6,2,.96));
      box-shadow:0 20px 58px rgba(0,0,0,.40);
    }

    .gc-app-visual-v183 .gc-app-top-grid-v3{
      display:grid;
      grid-template-columns:minmax(0,1.48fr) minmax(320px,.86fr);
      gap:14px;
      align-items:start;
    }

    .gc-app-visual-v183 .gc-app-combo-v3,
    .gc-app-visual-v183 .gc-app-readout-card-v3,
    .gc-app-visual-v183 .gc-app-references-v3,
    .gc-app-visual-v183 .gc-app-actions-v3{
      padding:clamp(18px,2vw,26px);
    }

    .gc-app-visual-v183 .gc-app-card-head-v3{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:18px;
      padding-bottom:16px;
      margin-bottom:18px;
      border-bottom:1px solid rgba(140,255,24,.15);
    }

    .gc-app-visual-v183 .gc-app-card-head-v3 h2{
      margin:0;
      color:#f7fff3;
      font-size:clamp(1.7rem,2.5vw,2.45rem);
      line-height:.84;
      letter-spacing:-.075em;
      text-transform:uppercase;
    }

    .gc-app-visual-v183 .gc-app-card-head-v3 p{
      margin:.36rem 0 0;
      color:var(--app-muted);
      font-size:.91rem;
    }

    /* Buttons */
    .gc-app-visual-v183 .gc-btn,
    .gc-app-visual-v183 .gc-feature-link{
      min-height:41px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:0 17px;
      border:1px solid rgba(140,255,24,.30);
      border-radius:4px;
      background:rgba(2,8,2,.88);
      color:#f7fff3;
      font-family:var(--font-mono,ui-monospace,monospace);
      font-size:.70rem;
      font-weight:1000;
      letter-spacing:.095em;
      text-transform:uppercase;
      text-decoration:none;
      transition:transform .16s ease,background .16s ease,border-color .16s ease,box-shadow .16s ease,color .16s ease;
    }

    .gc-app-visual-v183 .gc-btn:hover,
    .gc-app-visual-v183 .gc-feature-link:hover{
      transform:translateY(-2px);
      border-color:rgba(140,255,24,.60);
      background:rgba(140,255,24,.10);
      box-shadow:0 14px 32px rgba(0,0,0,.30);
    }

    .gc-app-visual-v183 .gc-btn--primary{
      border-color:transparent;
      background:linear-gradient(180deg,#a4ff27,#76ef05);
      color:#061006;
      box-shadow:0 0 0 1px rgba(140,255,24,.42),0 16px 38px rgba(140,255,24,.18);
    }

    .gc-app-visual-v183 .gc-btn--primary:hover{
      background:linear-gradient(180deg,#bdff5c,#8cff18);
      color:#061006;
      box-shadow:0 0 0 1px rgba(140,255,24,.62),0 20px 48px rgba(140,255,24,.26);
    }

    /* Combo */
    .gc-app-visual-v183 .gc-app-combo-v3{
      overflow:hidden;
    }

    .gc-app-visual-v183 .gc-app-combo-body-v3{
      display:block;
    }

    .gc-app-visual-v183 .gc-app-combo-body-v3 h3{
      max-width:860px;
      margin:9px 0 16px;
      color:#f7fff3;
      font-size:clamp(3.3rem,6.3vw,6rem);
      line-height:.78;
      letter-spacing:-.105em;
      text-transform:none;
      text-wrap:balance;
    }

    .gc-app-visual-v183 .gc-app-chip-list-v3{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      max-width:860px;
    }

    .gc-app-visual-v183 .gc-app-chip-list-v3 .gc-chip{
      border-color:rgba(140,255,24,.18);
      background:rgba(0,0,0,.25);
      color:rgba(244,255,240,.88);
    }

    .gc-app-visual-v183 .gc-app-mini-stats-v3{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:0;
      margin-top:22px;
      border:1px solid rgba(140,255,24,.15);
      background:rgba(0,0,0,.20);
    }

    .gc-app-visual-v183 .gc-app-mini-stats-v3 div{
      min-height:88px;
      display:grid;
      align-content:center;
      gap:7px;
      padding:15px;
