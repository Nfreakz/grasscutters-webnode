---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/app-race-control.css';

const serverJoinUrl = 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153';
const carsDriveUrl = 'https://drive.google.com/drive/folders/1BXJJkPOo7ZuhIKf_VegI5g8serZsJw7W?usp=drive_link';
const tracksDriveUrl = 'https://drive.google.com/drive/folders/1xSrI8aPBLH15wrytkR-IUjMQPWEVyfQw?usp=drive_link';
---
<AppLayout
  title="Race Control | GrassCutters Racing"
  description="Race Control de GrassCutters Racing con combo activo, actividad reciente, hotlaps y accesos principales."
  canonicalPath="/app"
  ogImage="/og/platform-og-v1531.png"
  ogImageAlt="Panel GrassCutters Racing"
>
  <main class="rc-shell" aria-labelledby="rcPageTitle">
    <section class="rc-command-bar" aria-label="Estado general">
      <div class="rc-command-brand">
        <span class="rc-command-dot" aria-hidden="true"></span>
        <div>
          <span class="rc-command-kicker">GrassCutters</span>
          <strong>Race Control</strong>
        </div>
      </div>
      <div class="rc-command-status" aria-label="Indicadores rápidos">
        <span class="rc-pill rc-pill--live" id="gcAppStatusChip">Sistema listo</span>
        <span class="rc-pill" id="gcAppComboChip">Combo</span>
        <span class="rc-pill" id="gcApiState">Estado</span>
        <span class="rc-pill rc-pill--ghost" id="gcAppClock">--:--</span>
      </div>
    </section>

    <section class="rc-hero" aria-label="Resumen Race Control">
      <div class="rc-hero-main">
        <span class="rc-kicker">Pit wall overview</span>
        <h1 id="rcPageTitle">Race Control</h1>
        <p>Panel operativo para ver el combo activo, la actividad reciente y salir a pista sin tener que pelearse con menús bonitos pero mudos.</p>
        <div class="rc-hero-actions" aria-label="Acciones principales">
          <a class="rc-button rc-button--primary" href={serverJoinUrl} target="_blank" rel="noreferrer">Entrar al server</a>
          <a class="rc-button" href="/app/live-timing">Live Timing</a>
          <a class="rc-button" href="/hotlaps">Hotlaps</a>
        </div>
      </div>

      <aside class="rc-session-card gc-live-panel" aria-label="Estado de sesión">
        <div class="rc-panel-title gc-live-panel__title">
          <span>Sesión</span>
          <strong id="gcAppSessionState">Listo</strong>
        </div>
        <dl class="rc-session-list">
          <div><dt>Cuenta</dt><dd id="gcAppSessionUser">...</dd></div>
          <div><dt>Rol</dt><dd id="gcAppSessionRole">...</dd></div>
          <div><dt>Piloto</dt><dd id="gcAppSessionPilot">...</dd></div>
        </dl>
      </aside>
    </section>

    <section class="rc-stat-strip" aria-label="Métricas rápidas">
      <article class="rc-stat">
        <span>Pilotos</span>
        <strong id="gcMetricDrivers">...</strong>
        <small>detectados</small>
      </article>
      <article class="rc-stat">
        <span>Vueltas</span>
        <strong id="gcMetricLaps">...</strong>
        <small>registradas</small>
      </article>
      <article class="rc-stat">
        <span>Combos</span>
        <strong id="gcMetricCombos">...</strong>
        <small>activos</small>
      </article>
      <article class="rc-stat">
        <span>Última actividad</span>
        <strong id="gcMetricLastActivity">...</strong>
        <small>vueltas recientes</small>
      </article>
    </section>

    <section class="rc-grid rc-grid--main" aria-label="Resumen principal">
      <article class="rc-panel rc-panel--combo gc-app-combo-v3 gc-track-image-card" data-track-image data-track-name="">
        <header class="rc-panel-head">
          <div>
            <span class="rc-kicker">Combo activo</span>
            <h2>Briefing de pista</h2>
            <p id="gcComboHint">Actividad reciente</p>
          </div>
          <a class="rc-button rc-button--small" href="/combos" id="gcComboLink">Ver combo</a>
        </header>

        <div class="rc-combo-readout">
          <span>Circuito</span>
          <strong id="gcComboTrack">Cargando...</strong>
        </div>

        <div class="rc-combo-cars" id="gcComboCars">
          <span class="rc-pill">Leyendo coches</span>
        </div>

        <div class="rc-mini-grid" aria-label="Datos combo activo">
          <div><span>Mejor vuelta</span><strong id="gcComboBest">--</strong><small id="gcComboBestMeta">Mejor referencia</small></div>
          <div><span>Vueltas</span><strong id="gcComboLaps">--</strong><small>combo</small></div>
          <div><span>Pilotos</span><strong id="gcComboDrivers">--</strong><small>participantes</small></div>
          <div><span>Estado</span><strong id="gcComboFamily">--</strong><small>datos</small></div>
        </div>

        <div class="rc-action-row" aria-label="Acciones rápidas del combo">
          <a class="rc-button rc-button--primary" href={serverJoinUrl} target="_blank" rel="noreferrer">Entrar</a>
          <a class="rc-button" href={carsDriveUrl} target="_blank" rel="noreferrer">Coches</a>
          <a class="rc-button" href={tracksDriveUrl} target="_blank" rel="noreferrer">Circuito</a>
          <a class="rc-button" href="/hotlaps">Ranking</a>
        </div>
      </article>

      <article class="rc-panel rc-panel--readout">
        <header class="rc-panel-head">
          <div>
            <span class="rc-kicker">Lectura de pista</span>
            <h2>Estado servidor</h2>
            <p>Estado global del servidor y última actividad registrada.</p>
          </div>
        </header>

        <div class="rc-readout-grid">
          <div class="rc-readout"><span>Vueltas servidor</span><strong id="gcQuickRefs">--</strong><small>total registradas</small></div>
          <div class="rc-readout"><span>Servidor online</span><strong id="gcServerUptimeDays">--</strong><small id="gcServerUptimeMeta">desde primer registro</small></div>
          <div class="rc-readout"><span>Última vuelta</span><strong id="gcQuickLast">--</strong><small id="gcQuickLastMeta">sin datos</small></div>
          <div class="rc-readout"><span>Data core</span><strong id="gcQuickDb">--</strong><small id="gcQuickDbMeta">comprobando</small></div>
        </div>

        <div class="rc-top-driver" aria-label="Mejor piloto del combo">
          <div class="rc-top-driver-avatar">
            <img id="gcTopDriverAvatar" src="/images/pilot-avatar-default.png" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="rc-top-driver-body">
            <span>Mejor piloto combo</span>
            <strong id="gcTopDriverName">--</strong>
            <small id="gcTopDriverMeta">Sin referencia cargada</small>
          </div>
          <div class="rc-top-driver-time">
            <span>Tiempo</span>
            <strong id="gcTopDriverTime">--</strong>
          </div>
        </div>
      </article>
    </section>

    <section class="rc-panel rc-panel--activity">
      <header class="rc-panel-head">
        <div>
          <span class="rc-kicker">Activity feed</span>
          <h2>Actividad reciente</h2>
          <p id="gcRefsMeta">Cargando vueltas...</p>
        </div>
        <a class="rc-link" href="/hotlaps">Ver hotlaps</a>
      </header>
      <div class="rc-table-wrap">
        <table class="rc-table">
          <thead>
            <tr><th>Piloto</th><th>Coche</th><th>Circuito</th><th>Tiempo</th><th>Fecha</th></tr>
          </thead>
          <tbody id="gcRefsTable"><tr><td colspan="5">Leyendo vueltas recientes...</td></tr></tbody>
        </table>
      </div>
    </section>

    <section class="rc-panel rc-panel--boxes">
      <header class="rc-panel-head">
        <div>
          <span class="rc-kicker">Pit lane</span>
          <h2>Boxes</h2>
          <p>Accesos principales para salir a pista y revisar datos.</p>
        </div>
        <span class="rc-pill rc-pill--live">Pit wall</span>
      </header>
      <div class="rc-box-grid">
        <a class="rc-box-card" href="/app/live-timing"><span>01</span><strong>Live Timing</strong><p>Sesión ACSM en directo.</p></a>
        <a class="rc-box-card" href="/hotlaps"><span>02</span><strong>Hotlaps</strong><p>Tiempos y filtros.</p></a>
        <a class="rc-box-card" href="/combos"><span>03</span><strong>Combos</strong><p>Combo actual e histórico.</p></a>
        <a class="rc-box-card" href="/pilotos"><span>04</span><strong>Pilotos</strong><p>Perfiles y actividad.</p></a>
        <a class="rc-box-card" href="/perfil"><span>05</span><strong>Perfil</strong><p>Cuenta y piloto.</p></a>
      </div>
    </section>
  </main>

<script is:inline src="/js/gc-track-images.js"></script>

  <script is:inline>
    /* GC_APP_INITIAL_NEUTRAL_STATE_V1_9 */
    (() => {
      const setText = (id, value) => {
        const node = document.getElementById(id);
        if (node) node.textContent = String(value);
      };

      const neutralize = () => {
        if (document.documentElement.dataset.gcAppSingleRenderer === 'v1.8') return;

        setText('gcMetricLaps', '—');
        setText('gcQuickRefs', '—');
        setText('gcMetricCombos', '—');
        setText('gcMetricLastActivity', '—');
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', neutralize, { once: true });
      } else {
        neutralize();
      }
    })();
  </script>

  
  <script is:inline>
    /* GC_APP_LEGACY_RENDERER_REMOVED_V1_9 */
    (() => {
      document.documentElement.dataset.gcAppLegacyRenderer = 'removed-v1.9';
      console.info('[GC /app] Legacy renderer removed v1.9');
    })();
  </script>


  
  



  


  



  



  



  


  <script is:inline>
    /* GC_APP_SINGLE_RENDERER_V1_8_START */
    (() => {
      const CONFIG = { refreshMs: 30000, firstDelayMs: 350, secondDelayMs: 1500 };
      const state = {
        version: 'v1.8',
        mode: 'single-renderer',
        lastRunAt: null,
        lastOkAt: null,
        lastError: null,
        diagnostics: null,
        combo: null,
        recent: null,
        leaderboard: null
      };

      const byId = (id) => document.getElementById(id);
      const setText = (id, value) => {
        const node = byId(id);
        if (node) node.textContent = String(value ?? '--');
      };
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char]));
      const number = (value, fallback = 0) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      };
      const formatNumber = (value) => Math.max(0, Math.round(number(value, 0))).toLocaleString('es-ES');

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source, path)) return source[path];
        return String(path).split('.').reduce((acc, part) => acc == null ? undefined : acc[part], source);
      };

      const pick = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source, path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return undefined;
      };

      const text = (value, fallback = '') => {
        if (value == null || value === '') return fallback;
        if (Array.isArray(value)) return value.length ? text(value[0], fallback) : fallback;
        if (typeof value === 'object') {
          return text(
            value.displayName ?? value.visibleName ?? value.cleanName ?? value.display_name ??
            value.uiName ?? value.uiCarName ?? value.uiTrackName ??
            value.name ?? value.Name ?? value.driverName ?? value.playerName ?? value.code,
            fallback
          );
        }
        return String(value).replace(/_/g, ' ').replace(/\s+/g, ' ').trim() || fallback;
      };

      const items = (data) => {
        if (Array.isArray(data)) return data;
        if (!data || typeof data !== 'object') return [];
        return data.items || data.data?.items || data.data?.leaderboard || data.data?.laps ||
          data.leaderboard || data.laps || data.recentLaps || data.hotlaps ||
          data.combos || data.results || [];
      };

      const dateMs = (value) => {
        if (!value) return 0;
        if (typeof value === 'number') return value > 20000000000 ? value : value * 1000;
        const parsed = Date.parse(String(value));
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const dateText = (value) => {
        const ms = typeof value === 'object' ? lapDate(value) : dateMs(value);
        if (!ms) return '--';
        return new Date(ms).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' });
      };

      const timeText = (value) => {
        const raw = text(value, '');
        if (raw && /[:.]/.test(raw) && !/^\d+$/.test(raw)) return raw;
        const ms = number(value, 0);
        if (!ms) return '--';
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        const millis = Math.floor(ms % 1000);
        return minutes + ':' + String(seconds).padStart(2, '0') + '.' + String(millis).padStart(3, '0');
      };

      const lapDate = (row) => dateMs(pick(row, [
        'timestampIso',
        'dateIso',
        'createdAt',
        'updatedAt',
        'lastSeenAt',
        'latestLapAt',
        'timestamp',
        'Timestamp'
      ]));

      const lapTime = (row) => text(pick(row, [
        'lapTimeFormatted',
        'timeFormatted',
        'bestLapTime',
        'bestLap',
        'lapTime'
      ]), '') || timeText(pick(row, [
        'lapTimeMs',
        'bestLapMs',
        'timeMs',
        'LapTime'
      ]));

      const driverName = (row) => text(pick(row, [
        'driverName',
        'playerName',
        'pilotName',
        'name',
        'driver.displayName',
        'driver.visibleName',
        'driver.name',
        'player.displayName',
        'player.name'
      ]), 'Piloto');

      const carName = (row) => text(pick(row, [
        'carName',
        'uiCarName',
        'car.displayName',
        'car.visibleName',
        'car.name',
        'car'
      ]), 'Coche');

      const trackName = (row) => text(pick(row, [
        'trackName',
        'uiTrackName',
        'track.displayName',
        'track.visibleName',
        'track.name',
        'track'
      ]), 'Circuito');

      const speed = (row) => {
        const raw = pick(row, ['maxSpeedKmh', 'maxSpeed', 'speedKmh', 'MaxSpeed_KMH']);
        const parsed = Number(raw);
        return Number.isFinite(parsed) && parsed > 0 ? Math.round(parsed) + ' km/h' : '';
      };

      const fetchJson = async (url) => {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 10000);
        try {
          const response = await fetch(url, { credentials: 'include', cache: 'no-store', signal: controller.signal });
          const data = await response.json().catch(() => null);
          if (!response.ok || !data) throw new Error(url + ' ' + response.status);
          return data;
        } finally {
          window.clearTimeout(timeout);
        }
      };

      function globalStatsFromDiagnostics(data) {
        const race = data?.raceData || data?.stracker?.raceData || data?.stats || data?.overview || {};
        return {
          totalLaps: number(
            pick(race, ['lapsCount', 'totalLaps', 'laps', 'lapCount']) ??
            pick(data, ['raceData.lapsCount', 'totalLaps', 'lapsCount']),
            0
          ),
          driversCount: number(
            pick(race, ['driversCount', 'totalDrivers', 'pilotsCount']) ??
            pick(data, ['raceData.driversCount', 'driversCount', 'totalDrivers']),
            0
          ),
          combosCount: number(
            pick(race, ['activeCombosCount', 'combosCount', 'totalCombos']) ??
            pick(data, ['raceData.activeCombosCount', 'activeCombosCount', 'combosCount', 'totalCombos']),
            0
          ),
          latestLapAt:
            pick(race, ['latestLapAt', 'lastSeenAt', 'latestActivityAt']) ||
            pick(data, ['raceData.latestLapAt', 'latestLapAt']),
          firstSeenAt:
            pick(race, ['oldestLapAt', 'firstSeenAt', 'startedAt']) ||
            pick(data, ['raceData.oldestLapAt', 'oldestLapAt', 'firstSeenAt']),
          generatedAt: data?.generatedAt
        };
      }

      function comboCars(combo) {
        const raw = pick(combo, [
          'publicComboCars',
          'carNames',
          'carList',
          'cars',
          'availableCars',
          'comboCars',
          'mainVariantAllCars'
        ]);
        const arr = Array.isArray(raw) ? raw : (typeof raw === 'string' ? raw.split(/[,|;]/g) : []);
        const seen = new Set();
        return arr.map((car) => text(car, '')).filter(Boolean).filter((name) => {
          const key = name.toLowerCase();
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
      }

      function comboId(combo) {
        return pick(combo, ['comboId', 'canonicalComboId', 'id']);
      }

      function comboUrl(combo) {
        const id = comboId(combo);
        return combo?.url || (id !== undefined && id !== null ? '/combos/' + encodeURIComponent(String(id)) : '/combos');
      }

      function comboBestLap(combo, leaderboard) {
        return (
          pick(combo, ['bestLap', 'summary.bestLap']) ||
          (Array.isArray(combo?.leaderboard) ? combo.leaderboard[0] : null) ||
          leaderboard[0] ||
          {}
        );
      }

      function comboState(combo) {
        const hiddenCars = number(pick(combo, ['hiddenLowLapCarsCount', 'summary.hiddenLowLapCarsCount']), 0);
        const variants = number(pick(combo, ['variantsCount', 'summary.variantsCount']), 0);
        if (hiddenCars > 0) return 'Filtrado';
        if (variants > 1) return 'Canónico';
        return 'Activo';
      }

      function ensureBadge(stateName, label) {
        let badge = byId('gcAppCoreBadge');
        if (!badge) {
          const host = document.querySelector('.gc-live-panel__title') || document.querySelector('.gc-hero') || document.body;
          badge = document.createElement('span');
          badge.id = 'gcAppCoreBadge';
          badge.style.cssText = 'display:inline-flex;align-items:center;min-height:24px;padding:4px 8px;border:1px solid rgba(122,255,144,.35);border-radius:999px;color:var(--accent,#7aff90);font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;background:rgba(122,255,144,.08);margin-left:8px';
          host.appendChild(badge);
        }
        badge.textContent = label;
        badge.dataset.state = stateName;
        badge.style.borderColor = stateName === 'error' ? 'rgba(255,94,94,.45)' : stateName === 'warn' ? 'rgba(255,207,90,.45)' : 'rgba(122,255,144,.35)';
        badge.style.color = stateName === 'error' ? '#ff6b6b' : stateName === 'warn' ? '#ffcf5a' : 'var(--accent,#7aff90)';
      }

      function gcAppSessionUserFromV1_10(identityData, adminData) {
        const candidates = [
          identityData?.user,
          identityData?.currentUser,
          identityData?.account,
          identityData?.profile?.user,
          identityData?.session?.user,
          identityData?.auth?.user,
          identityData?.data?.user,
          adminData?.user,
          adminData?.currentUser,
          adminData?.account,
          adminData?.profile?.user,
          adminData?.session?.user,
          adminData?.auth?.user,
          adminData?.data?.user
        ].filter(Boolean);

        return candidates[0] || {};
      }

      function gcAppSessionPilotFromV1_10(identityData, adminData, user) {
        const candidates = [
          identityData?.pilot,
          identityData?.linkedPilot,
          identityData?.pilotLink,
          identityData?.linked,
          identityData?.profile?.pilot,
          identityData?.profile?.pilotLink,
          identityData?.data?.pilot,
          identityData?.data?.pilotLink,
          adminData?.pilot,
          adminData?.linkedPilot,
          adminData?.pilotLink,
          adminData?.profile?.pilot,
          adminData?.profile?.pilotLink,
          user?.pilot,
          user?.pilotLink,
          user?.linkedPilot
        ].filter(Boolean);

        return candidates[0] || {};
      }

      function gcAppSessionIsLoggedV1_10(identityData, adminData, user) {
        return Boolean(
          identityData?.authenticated === true ||
          identityData?.loggedIn === true ||
          identityData?.isAuthenticated === true ||
          identityData?.ok === true ||
          adminData?.authenticated === true ||
          adminData?.loggedIn === true ||
          adminData?.isAuthenticated === true ||
          adminData?.ok === true ||
          user?.id ||
          user?.email ||
          user?.name ||
          user?.displayName ||
          user?.role
        );
      }

      function renderSession(identityData, adminData) {
        const user = gcAppSessionUserFromV1_10(identityData, adminData);
        const pilot = gcAppSessionPilotFromV1_10(identityData, adminData, user);
        const logged = gcAppSessionIsLoggedV1_10(identityData, adminData, user);

        const accountName = text(
          user.displayName ??
          user.display_name ??
          user.username ??
          user.name ??
          user.email ??
          identityData?.displayName ??
          identityData?.name ??
          adminData?.displayName ??
          adminData?.name,
          logged ? 'Admin Local' : 'Invitado'
        );

        const role = text(
          user.role ??
          user.userRole ??
          user.accountRole ??
          identityData?.role ??
          identityData?.user?.role ??
          adminData?.role ??
          adminData?.user?.role,
          logged ? 'pilot' : '-'
        );

        const pilotName = text(
          pilot.displayName ??
          pilot.display_name ??
          pilot.driverName ??
          pilot.strackerName ??
          pilot.name ??
          identityData?.pilotName ??
          identityData?.driverName ??
          user?.strackerName,
          pilot && Object.keys(pilot).length ? 'Vinculado' : accountName
        );

        setText('gcAppSessionState', logged ? 'Conectado' : 'Invitado');
        setText('gcAppSessionUser', accountName);
        setText('gcAppSessionRole', role);
        setText('gcAppSessionPilot', pilotName);

        document.documentElement.dataset.gcAppSessionRenderer = 'v1.10';
      }

      function renderGlobal(diagnostics) {
        const stats = globalStatsFromDiagnostics(diagnostics);
        if (stats.driversCount) setText('gcMetricDrivers', formatNumber(stats.driversCount));
        if (stats.totalLaps) {
          setText('gcMetricLaps', formatNumber(stats.totalLaps));
          setText('gcQuickRefs', formatNumber(stats.totalLaps));
        }
        if (stats.combosCount) setText('gcMetricCombos', formatNumber(stats.combosCount));
        if (stats.latestLapAt) setText('gcMetricLastActivity', dateText(stats.latestLapAt).split(',')[0]);

        if (stats.firstSeenAt) {
          const firstMs = dateMs(stats.firstSeenAt);
          if (firstMs) {
            const days = Math.max(1, Math.ceil((Date.now() - firstMs) / 86400000));
            setText('gcServerUptimeDays', days + ' días');
            setText('gcServerUptimeMeta', 'desde ' + dateText(stats.firstSeenAt).split(',')[0]);
          }
        }

        setText('gcQuickDb', 'Activo');
        setText('gcQuickDbMeta', stats.generatedAt ? 'Actualizado · ' + dateText(stats.generatedAt) : 'Actualizado');

        return stats;
      }

      function renderCombo(combo, leaderboard, recent) {
        if (!combo) return;

        const cars = comboCars(combo);
        const best = comboBestLap(combo, leaderboard);
        const latest = recent[0] || best || {};
        const track = text(pick(combo, [
          'canonicalTrackName',
          'displayTrackName',
          'track.displayName',
          'track.name',
          'trackName'
        ]), trackName(latest));

        setText('gcAppComboChip', track || 'Combo');
        setText('gcComboTrack', track || 'Sin combo');
        setText('gcComboHint', pick(combo, ['lastSeenAt', 'summary.lastSeenAt'])
          ? 'Última actividad · ' + dateText(pick(combo, ['lastSeenAt', 'summary.lastSeenAt']))
          : 'Combo canónico cargado.');
        setText('gcComboBest', best ? lapTime(best) : '--');
        setText('gcComboBestMeta', best ? [driverName(best), carName(best)].filter(Boolean).join(' · ') : 'Mejor vuelta del combo');
        setText('gcComboLaps', formatNumber(pick(combo, ['totalLaps', 'summary.totalLaps', 'laps'])));
        setText('gcComboDrivers', formatNumber(pick(combo, ['driversCount', 'summary.driversCount', 'pilotsCount'])));
        setText('gcComboFamily', comboState(combo));

        const link = byId('gcComboLink');
        if (link) link.href = comboUrl(combo);

        const carsNode = byId('gcComboCars');
        if (carsNode) {
          carsNode.innerHTML = cars.length
            ? cars.map((name) => '<span class="gc-chip">' + escapeHtml(name) + '</span>').join('')
            : '<span class="gc-chip">Coches por confirmar</span>';
        }

        const comboCard = document.querySelector('.gc-app-combo-v3');
        if (comboCard && track) {
          comboCard.dataset.trackName = track;
          window.GCTrackImages?.applyAll?.(document);
        }

        if (best && Object.keys(best).length) {
          setText('gcTopDriverName', driverName(best));
          setText('gcTopDriverTime', lapTime(best));
          setText('gcTopDriverMeta', [carName(best), trackName(best), speed(best)].filter(Boolean).join(' · '));

          const avatar = byId('gcTopDriverAvatar');
          const playerId = pick(best, ['playerId', 'driverId', 'pilotId', 'id', 'driver.id', 'player.id', 'pilot.id']);
          if (avatar && playerId) {
            avatar.src = '/api/pilot-avatar/' + encodeURIComponent(String(playerId));
            avatar.alt = 'Avatar de ' + driverName(best);
            avatar.onerror = () => {
              avatar.onerror = null;
              avatar.src = '/images/pilot-avatar-default.png';
            };
          }
        }
      }

      function renderRecentTable(recent, leaderboard) {
        const rows = recent.length ? recent : leaderboard;
        const table = byId('gcRefsTable');
        if (table) {
          table.innerHTML = rows.length
            ? rows.slice(0, 10).map((lap) => `
                <tr>
                  <td><strong>${escapeHtml(driverName(lap))}</strong></td>
                  <td>${escapeHtml(carName(lap))}</td>
                  <td>${escapeHtml(trackName(lap))}</td>
                  <td><strong>${escapeHtml(lapTime(lap))}</strong></td>
                  <td>${escapeHtml(dateText(lap))}</td>
                </tr>
              `).join('')
            : '<tr><td colspan="5">Sin vueltas recientes.</td></tr>';
        }

        const latest = rows.slice().sort((a, b) => lapDate(b) - lapDate(a))[0] || null;
        setText('gcQuickLast', latest ? lapTime(latest) : '--');
        setText('gcQuickLastMeta', latest ? [driverName(latest), trackName(latest), dateText(latest)].filter(Boolean).join(' · ') : 'sin datos');
        setText('gcRefsMeta', formatNumber(recent.length) + ' vueltas recientes');
      }

      async function render() {
        state.lastRunAt = new Date().toISOString();

        try {
          ensureBadge('warn', 'Actualizando datos');

          const [diagnostics, combosData, recentData, leaderboardData, identityData, adminData] = await Promise.all([
            fetchJson('/api/gc/diagnostics'),
            fetchJson('/api/gc/combos?limit=1&sort=recent'),
            fetchJson('/api/gc/recent-laps?limit=12&sort=recent&valid=all').catch(() => null),
            fetchJson('/api/gc/leaderboard?scope=activeCombo&limit=20').catch(() => null),
            fetchJson('/api/gc/identity/me').catch(() => null),
            fetchJson('/api/admin/status').catch(() => null)
          ]);

          const combo = items(combosData)[0] || null;
          const recent = items(recentData);
          const leaderboard = items(leaderboardData);

          renderSession(identityData, adminData);

          const globalStats = renderGlobal(diagnostics);
          renderCombo(combo, leaderboard, recent);
          renderRecentTable(recent, leaderboard);

          document.documentElement.dataset.gcAppDataCore = 'primary';
          document.documentElement.dataset.gcAppDataCoreVersion = 'v1.8-single';
          document.documentElement.dataset.gcAppSingleRenderer = 'v1.8';

          ensureBadge('ok', 'Datos actualizados');

          state.lastOkAt = new Date().toISOString();
          state.lastError = null;
          state.diagnostics = diagnostics;
          state.combo = combo;
          state.recent = recentData;
          state.leaderboard = leaderboardData;

          window.GCAppDataCorePrimary = {
            status: 'ok',
            mode: 'single-renderer',
            diagnostics,
            combos: combosData,
            recent: recentData,
            leaderboard: leaderboardData,
            identity: identityData,
            admin: adminData,
            renderedAt: state.lastOkAt
          };

          window.GCAppSingleRendererStatus = () => ({ ...state });

          console.info('[GC /app Single Renderer v1.8]', {
            totalLaps: globalStats.totalLaps,
            drivers: globalStats.driversCount,
            combos: globalStats.combosCount,
            combo: combo?.trackName || combo?.canonicalTrackName,
            cars: comboCars(combo || {}).length
          });
        } catch (error) {
          state.lastError = error?.message || String(error);
          document.documentElement.dataset.gcAppDataCore = 'single-error';
          ensureBadge('error', 'Error al actualizar');
          window.GCAppSingleRendererStatus = () => ({ ...state });
          console.warn('[GC /app Single Renderer v1.8] failed:', error);
        }
      }

      const start = () => {
        window.setTimeout(render, CONFIG.firstDelayMs);
        window.setTimeout(render, CONFIG.secondDelayMs);
        window.clearInterval(window.GCAppSingleRendererTimer);
        window.GCAppSingleRendererTimer = window.setInterval(render, CONFIG.refreshMs);
      };

      window.GCAppSingleRendererReload = render;

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
      else start();
    })();
    /* GC_APP_SINGLE_RENDERER_V1_8_END */
  </script>


  <script is:inline>
    /* GC_APP_SINGLE_RENDERER_SESSION_FIX_V1_10_MARKER */
    (() => {
      document.documentElement.dataset.gcAppSessionFix = 'v1.10';
    })();
  </script>


  <script is:inline>
    /* GC_APP_HOTLAPS_ALL_TRACKS_V1_START */
    (() => {
      const table = document.getElementById('gcRefsTable');
      if (!table) return;

      const endpoints = [
        '/api/gc/recent-laps?scope=all&limit=80&sort=recent&valid=all',
        '/api/laps?scope=all&limit=80&sort=recent&valid=all',
        '/api/gc/leaderboard?scope=all&limit=3000',
        '/api/hotlaps?scope=all&limit=3000&valid=all'
      ];

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source, path)) return source[path];
        return String(path).split('.').reduce((acc, part) => acc == null ? undefined : acc[part], source);
      };

      const pick = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source, path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return undefined;
      };

      const list = (payload) => {
        if (Array.isArray(payload)) return payload;
        if (!payload || typeof payload !== 'object') return [];
        return (
          payload.items ||
          payload.laps ||
          payload.hotlaps ||
          payload.leaderboard ||
          payload.data?.items ||
          payload.data?.laps ||
          payload.data?.leaderboard ||
          []
        );
      };

      const text = (value, fallback = '-') => {
        if (value === undefined || value === null || value === '') return fallback;
        if (Array.isArray(value)) return value.length ? text(value[0], fallback) : fallback;
        if (typeof value === 'object') {
          return text(
            value.displayName ??
            value.visibleName ??
            value.cleanName ??
            value.uiName ??
            value.uiCarName ??
            value.uiTrackName ??
            value.name ??
            value.Name ??
            value.driverName ??
            value.playerName ??
            value.code,
            fallback
          );
        }
        return String(value).replace(/_/g, ' ').replace(/\s+/g, ' ').trim() || fallback;
      };

      const esc = (value) => String(value ?? '-').replace(/[&<>'"]/g, (char) => ({
        '&':'&amp;',
        '<':'&lt;',
        '>':'&gt;',
        "'":'&#39;',
        '"':'&quot;'
      }[char]));

      const number = (value, fallback = 0) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      };

      const driverName = (row) => text(pick(row, [
        'driver.displayName','driver.visibleName','driver.name',
        'driverDisplayName','driverVisibleName','driverName',
        'playerName','pilotName','name','Name'
      ]), 'Piloto');

      const carName = (row) => text(pick(row, [
        'car.displayName','car.visibleName','car.name',
        'carDisplayName','carVisibleName','carName',
        'uiCarName','Car'
      ]), 'Coche');

      const trackName = (row) => text(pick(row, [
        'track.displayName','track.visibleName','track.name',
        'trackDisplayName','trackVisibleName','trackName',
        'uiTrackName','Track'
      ]), 'Circuito');

      const lapMs = (row) => {
        const parsed = Number(pick(row, ['lapTimeMs','bestLapMs','timeMs','LapTime']));
        return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
      };

      const fmtMs = (value) => {
        const ms = number(value, 0);
        if (!ms) return '--';
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        const millis = Math.floor(ms % 1000);
        return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
      };

      const lapDisplay = (row) => text(pick(row, ['lapTimeFormatted','lapTimeText','lapTime','bestLapTime']), '') || fmtMs(lapMs(row));

      const lapDateMs = (row) => {
        const iso = pick(row, ['timestampIso','dateIso','createdAt','updatedAt','lastSeenAt','session.endTimeIso','session.startTimeIso']);
        if (iso) {
          const parsed = Date.parse(String(iso));
          if (Number.isFinite(parsed)) return parsed;
        }
        const raw = pick(row, ['timestamp','Timestamp','date']);
        if (typeof raw === 'number') return raw > 20000000000 ? raw : raw * 1000;
        return 0;
      };

      const fmtDate = (row) => {
        const ms = lapDateMs(row);
        if (!ms) return '--';
        return new Date(ms).toLocaleString('es-ES', {
          day: '2-digit',
          month: '2-digit',
          hour: '2-digit',
          minute: '2-digit'
        });
      };

      const isInvalid = (row) => {
        const value = pick(row, ['valid','isValid','Valid']);
        return value === 0 || value === false || value === '0' || value === 'false' || value === 'no';
      };

      const setText = (id, value) => {
        const node = document.getElementById(id);
        if (node) node.textContent = value;
      };

      async function fetchFirst() {
        let lastError = null;
        for (const endpoint of endpoints) {
          try {
            const response = await fetch(endpoint, { cache: 'no-store', credentials: 'include' });
            const payload = await response.json().catch(() => null);
            if (!response.ok || !payload) throw new Error(`${endpoint} ${response.status}`);
            const rows = list(payload);
            if (rows.length) return { endpoint, payload, rows };
          } catch (error) {
            lastError = error;
            console.warn('[GC /app all tracks] endpoint failed', endpoint, error?.message || error);
          }
        }
        throw lastError || new Error('No hotlaps endpoint available');
      }

      function updateMetrics(rows, payload, endpoint) {
        const uniqueDrivers = new Set(rows.map(driverName).filter(Boolean));
        const uniqueTracks = new Set(rows.map(trackName).filter(Boolean));
        const latest = [...rows].sort((a, b) => lapDateMs(b) - lapDateMs(a))[0] || null;

        const totalFromPayload =
          Number(payload?.totalLaps) ||
          Number(payload?.total) ||
          Number(payload?.count) ||
          rows.length;

        setText('gcMetricDrivers', String(uniqueDrivers.size));
        setText('gcMetricLaps', String(totalFromPayload));
        setText('gcMetricCombos', String(uniqueTracks.size));
        setText('gcMetricLastActivity', latest ? fmtDate(latest) : '--');

        setText('gcQuickRefs', String(totalFromPayload));
        setText('gcQuickLast', latest ? fmtDate(latest) : '--');
        setText('gcQuickDb', 'Activo');
        setText('gcQuickDbMeta', 'Actividad sincronizada');

        const refsMeta = document.getElementById('gcRefsMeta');
        if (refsMeta) refsMeta.textContent = `${rows.length} vueltas recientes · todos los circuitos`;

        const apiState = document.getElementById('gcApiState');
        if (apiState) apiState.textContent = 'En pista';
      }

      function renderRows(rows) {
        const sorted = [...rows].sort((a, b) => lapDateMs(b) - lapDateMs(a)).slice(0, 12);

        table.innerHTML = sorted.map((row) => {
          const valid = isInvalid(row) ? 'No válida' : 'Válida';
          return `
            <tr>
              <td>${esc(driverName(row))}</td>
              <td>${esc(carName(row))}</td>
              <td>${esc(trackName(row))}</td>
              <td><strong>${esc(lapDisplay(row))}</strong><span class="gc-leaderboard-sub">${esc(valid)}</span></td>
              <td>${esc(fmtDate(row))}</td>
            </tr>
          `;
        }).join('') || '<tr><td colspan="5">Sin vueltas recientes.</td></tr>';
      }

      async function loadAllTracksActivity() {
        try {
          const { endpoint, payload, rows } = await fetchFirst();
          updateMetrics(rows, payload, endpoint);
          renderRows(rows);
          document.documentElement.dataset.gcAppHotlapsScope = 'all-tracks';
          window.GCAppHotlapsAllTracks = { status: 'ok', endpoint, rows: rows.length, updatedAt: new Date().toISOString() };
        } catch (error) {
          console.warn('[GC /app all tracks] error', error);
          setText('gcApiState', 'Error');
          const refsMeta = document.getElementById('gcRefsMeta');
          if (refsMeta) refsMeta.textContent = 'No se pudieron cargar todas las vueltas';
          window.GCAppHotlapsAllTracks = { status: 'error', error: error?.message || String(error) };
        }
      }

      loadAllTracksActivity();
      window.setInterval(loadAllTracksActivity, 45000);
    })();
    /* GC_APP_HOTLAPS_ALL_TRACKS_V1_END */
  </script>


  <script is:inline>
    /* GC_APP_HOTLAPS_ALL_TRACKS_SAFE_V1 */
    (() => {
      document.documentElement.dataset.gcAppHotlapsScope = 'all-tracks';
    })();
  </script>
</AppLayout>
