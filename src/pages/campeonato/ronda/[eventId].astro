---
export const prerender = false;
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import '../../../styles/public/gc-rating-badges.css';

const rawEventId = Astro.params.eventId ?? '';
let eventId = rawEventId;
try {
  eventId = decodeURIComponent(rawEventId);
} catch {}
---

<MarketingLayout
  title="Resultados de ronda | Campeonato ACSR"
  description="Resultados detallados de una ronda del campeonato semanal ACSR de GrassCutters Racing."
  ogImage="/og/campeonato-og-v1531.png"
  bodyClass="gc-page-acsr gc-page-acsr-round"
  canonicalPath={`/campeonato/ronda/${eventId}`}
>
  <section class="gc-public-shell gc-public-section gc-acsr-round-page" data-acsr-round>
    <a class="gc-acsr-back" href="/campeonato">← Volver al campeonato</a>

    <header class="gc-acsr-round-hero">
      <div>
        <span class="gc-public-kicker" id="acsrRoundStatus">Ronda</span>
        <h1 class="gc-public-title" id="acsrRoundTitle">Cargando resultados...</h1>
        <p class="gc-public-description" id="acsrRoundMeta">Consultando ACSM.</p>
      </div>
      <figure class="gc-acsr-round-map gc-acsr-round-photo" id="acsrRoundMapFigure" hidden>
        <img id="acsrRoundMap" src="" alt="" loading="lazy" />
      </figure>
    </header>

    <section class="gc-acsr-round-summary">
      <article class="gc-public-card">
        <span class="gc-public-kicker">Ganador</span>
        <h2 id="acsrRoundWinner">--</h2>
        <p id="acsrRoundWinnerMeta">Pendiente</p>
      </article>
      <article class="gc-public-card">
        <span class="gc-public-kicker">Vuelta rápida</span>
        <h2 id="acsrRoundFastestLap">--</h2>
        <p id="acsrRoundFastestLapMeta">Pendiente</p>
      </article>
      <article class="gc-public-card">
        <span class="gc-public-kicker">Participantes</span>
        <h2 id="acsrRoundEntrants">--</h2>
        <p id="acsrRoundEntrantsMeta">Resultados de carrera</p>
      </article>
    </section>

    <section class="gc-acsr-round-block">
      <div class="gc-public-section-head">
        <span class="gc-public-kicker">Carrera</span>
        <h2 class="gc-public-section-title">Resultados de carrera.</h2>
      </div>
      <div class="gc-acsr-table-wrap">
        <table class="gc-acsr-round-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Piloto</th>
              <th>Coche</th>
              <th>Vueltas</th>
              <th>Mejor vuelta</th>
              <th>Tiempo total</th>
              <th>Puntos</th>
              <th>SR</th>
              <th>ΔSR</th>
              <th>GSR</th>
              <th>ΔGSR</th>
              <th>Incidentes</th>
            </tr>
          </thead>
          <tbody id="acsrRaceBody">
            <tr><td colspan="12">Cargando carrera...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="gc-acsr-round-block">
      <div class="gc-public-section-head">
        <span class="gc-public-kicker">Qualy</span>
        <h2 class="gc-public-section-title">Clasificación.</h2>
      </div>
      <div class="gc-acsr-table-wrap">
        <table class="gc-acsr-round-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Piloto</th>
              <th>Coche</th>
              <th>Vueltas</th>
              <th>Mejor vuelta</th>
              <th>Grid</th>
            </tr>
          </thead>
          <tbody id="acsrQualyBody">
            <tr><td colspan="6">Cargando qualy...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="gc-acsr-round-block">
      <div class="gc-public-section-head">
        <span class="gc-public-kicker">Sesiones</span>
        <h2 class="gc-public-section-title">Resumen de sesiones.</h2>
      </div>
      <div class="gc-acsr-session-grid" id="acsrSessionGrid">
        <article class="gc-public-card"><strong>Cargando sesiones...</strong></article>
      </div>
    </section>
  </section>

  <style is:global>
    .gc-page-acsr-round{
      background:var(--gc-mk-bg,#070a08);
    }

    .gc-acsr-round-page{
      display:grid;
      gap:clamp(24px,3vw,42px);
      padding-top:clamp(110px,12vw,170px);
    }

    .gc-acsr-back{
      display:inline-flex;
      width:max-content;
      color:var(--gc-mk-accent,#80ff1f);
      text-decoration:none;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.06em;
      font-family:var(--font-mono,monospace);
    }

    .gc-acsr-round-hero{
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(320px,.8fr);
      gap:clamp(18px,3vw,34px);
      align-items:stretch;
      padding:clamp(20px,3vw,36px);
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      border-radius:24px;
      background:
        radial-gradient(circle at 80% 20%, rgba(126,255,39,.12), transparent 26rem),
        rgba(255,255,255,.024);
      box-shadow:0 22px 80px rgba(0,0,0,.35);
    }

    .gc-acsr-round-map{
      margin:0;
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      border-radius:20px;
      overflow:hidden;
      background:rgba(0,0,0,.28);
      min-height:260px;
    }

    .gc-acsr-round-map[hidden]{ display:none!important; }

    .gc-acsr-round-map img{
      display:block;
      width:100%;
      height:100%;
      min-height:260px;
      object-fit:cover;
    }

    .gc-acsr-round-summary{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:16px;
    }

    .gc-acsr-round-summary .gc-public-card{
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      background:rgba(255,255,255,.025);
      border-radius:18px;
      padding:clamp(18px,2.2vw,28px);
    }

    .gc-acsr-round-summary h2{
      margin:.35rem 0;
      color:var(--gc-mk-text,#f2f6ef);
      font-size:clamp(1.5rem,3vw,2.5rem);
      line-height:.95;
    }

    .gc-acsr-round-summary p{
      margin:0;
      color:var(--gc-mk-muted,#9ca59a);
    }

    .gc-acsr-round-block{
      display:grid;
      gap:16px;
    }

    .gc-acsr-table-wrap{
      overflow:auto;
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      border-radius:18px;
      background:rgba(255,255,255,.018);
    }

    .gc-acsr-round-table{
      width:100%;
      border-collapse:collapse;
      min-width:860px;
    }

    .gc-acsr-round-table th,
    .gc-acsr-round-table td{
      padding:14px 16px;
      border-bottom:1px solid rgba(126,255,39,.12);
      text-align:left;
      vertical-align:middle;
    }

    .gc-acsr-round-table th{
      color:var(--gc-mk-muted,#9ca59a);
      font-family:var(--font-mono,monospace);
      font-size:.78rem;
      text-transform:uppercase;
      letter-spacing:.08em;
      background:rgba(126,255,39,.055);
    }

    .gc-acsr-round-table tr:last-child td{ border-bottom:0; }

    .gc-acsr-round-table strong{
      font-weight:900;
    }

    .gc-acsr-points{
      color:var(--gc-mk-accent,#80ff1f);
      font-weight:950;
      font-family:var(--font-mono,monospace);
    }

    /* GC_SAFETY_RATING_ROUND_UI_V1 */
    .gc-acsr-sr{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:52px;
      padding:5px 9px;
      border:1px solid rgba(126,255,39,.28);
      border-radius:999px;
      color:var(--gc-mk-accent,#80ff1f);
      background:rgba(126,255,39,.07);
      font-family:var(--font-mono,monospace);
      font-size:.78rem;
      font-weight:950;
      letter-spacing:.04em;
      white-space:nowrap;
    }

    .gc-acsr-sr small{
      margin-left:4px;
      color:var(--gc-mk-muted,#9ca59a);
      font-size:.72em;
      font-weight:800;
    }

    /* GC_STRACKER_SAFETY_DETAILS_UI_V1 */
    .gc-acsr-driver-toggle{
      appearance:none;
      border:0;
      background:transparent;
      color:inherit;
      font:inherit;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:0;
    }

    .gc-acsr-driver-toggle::before{
      content:'▸';
      color:var(--gc-mk-accent,#80ff1f);
      font-size:.8rem;
      transition:transform .18s ease;
    }

    .gc-acsr-driver-toggle[aria-expanded="true"]::before{
      transform:rotate(90deg);
    }

    .gc-acsr-safety-detail-row td{
      padding:0 !important;
      background:rgba(126,255,39,.035);
    }

    .gc-acsr-safety-detail{
      padding:18px 22px 22px;
      border-top:1px solid rgba(126,255,39,.16);
    }

    .gc-acsr-safety-summary{
      display:grid;
      grid-template-columns:repeat(5,minmax(120px,1fr));
      gap:10px;
      margin-bottom:16px;
    }

    .gc-acsr-safety-card{
      border:1px solid rgba(126,255,39,.14);
      border-radius:14px;
      padding:10px 12px;
      background:rgba(0,0,0,.22);
    }

    .gc-acsr-safety-card span{
      display:block;
      color:var(--gc-mk-muted,#9ca59a);
      font-size:.68rem;
      text-transform:uppercase;
      letter-spacing:.08em;
    }

    .gc-acsr-safety-card strong{
      display:block;
      margin-top:4px;
      color:var(--gc-mk-text,#f5fff0);
      font-family:var(--font-mono,monospace);
      font-size:.95rem;
    }

    .gc-acsr-laps-table{
      width:100%;
      border-collapse:collapse;
      font-size:.82rem;
    }

    .gc-acsr-laps-table th,
    .gc-acsr-laps-table td{
      padding:8px 10px;
      border-bottom:1px solid rgba(126,255,39,.09);
      text-align:left;
    }

    .gc-acsr-laps-table tr.gc-acsr-lap-alert td{
      color:#ffcf7a;
    }

    .gc-acsr-penalty-list{
      margin:0 0 14px;
      padding-left:18px;
      color:var(--gc-mk-muted,#9ca59a);
    }

    @media (max-width: 780px){
      .gc-acsr-safety-summary{grid-template-columns:repeat(2,minmax(0,1fr));}
      .gc-acsr-safety-detail{overflow-x:auto;}
    }

    .gc-acsr-session-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:16px;
    }

    .gc-acsr-session-grid .gc-public-card{
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      background:rgba(255,255,255,.025);
      border-radius:18px;
      padding:18px;
    }

    .gc-acsr-session-grid span{
      display:block;
      color:var(--gc-mk-accent,#80ff1f);
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.08em;
      font-family:var(--font-mono,monospace);
      font-size:.78rem;
      margin-bottom:8px;
    }

    .gc-acsr-session-grid p{
      margin:.35rem 0 0;
      color:var(--gc-mk-muted,#9ca59a);
    }

    @media (max-width:920px){
      .gc-acsr-round-hero,
      .gc-acsr-round-summary,
      .gc-acsr-session-grid{
        grid-template-columns:1fr;
      }
    }

    @media (max-width:560px){
      .gc-acsr-round-page{
        padding-top:96px;
      }

      .gc-acsr-round-table{
        min-width:760px;
      }
    }
  </style>

  <script is:inline define:vars={{ eventId }}>
    // @ts-nocheck
    // GC_SAFETY_RATING_TS_NOCHECK_V1
    (() => {
      const $ = (id) => document.getElementById(id);
      const els = {
        status: $('acsrRoundStatus'),
        title: $('acsrRoundTitle'),
        meta: $('acsrRoundMeta'),
        mapFigure: $('acsrRoundMapFigure'),
        map: $('acsrRoundMap'),
        winner: $('acsrRoundWinner'),
        winnerMeta: $('acsrRoundWinnerMeta'),
        fastestLap: $('acsrRoundFastestLap'),
        fastestLapMeta: $('acsrRoundFastestLapMeta'),
        entrants: $('acsrRoundEntrants'),
        entrantsMeta: $('acsrRoundEntrantsMeta'),
        raceBody: $('acsrRaceBody'),
        qualyBody: $('acsrQualyBody'),
        sessionGrid: $('acsrSessionGrid')
      };

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));
      const ratingClassKey = (value) => String(value || 'unknown')
        .trim()
        .toLowerCase()
        .replace('+', 'plus')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'unknown';

      const ratingBadge = (type, value, score = null, options = {}) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const safeValue = String(value || '--');
        const classKey = ratingClassKey(safeValue);
        const compactClass = options.compact ? ' gc-rating-badge--compact' : '';
        const scoreMarkup = score !== null && score !== undefined && score !== ''
          ? `<small>${escapeHtml(score)}</small>`
          : '';

        return `
          <span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${classKey}${compactClass}">
            <span class="gc-rating-badge__type">${safeType.toUpperCase()}</span>
            <strong>${escapeHtml(safeValue)}</strong>
            ${scoreMarkup}
          </span>
        `;
      };

      const srInfo = (driver) => {
        const sr = driver?.safetyRating || {};
        const score = Number(sr.score ?? driver?.srScore ?? 80);
        const label = sr.class || driver?.srClass || 'B';
        const delta = Number(sr.delta ?? driver?.srDelta ?? 0);
        return {
          score: Number.isFinite(score) ? Math.round(score * 10) / 10 : 80,
          label,
          delta: Number.isFinite(delta) ? Math.round(delta * 10) / 10 : 0
        };
      };
      const srBadge = (driver) => {
        const sr = srInfo(driver);
        return ratingBadge('sr', sr.label || '--', sr.score);
      };
      const gsrInfo = (driver) => {
        const score = Number(driver?.gsrRating ?? driver?.newGsr ?? 1500);
        const label = driver?.gsrClass || 'Rookie';
        const delta = Number(driver?.gsrDelta ?? driver?.deltaGsr ?? 0);
        return {
          score: Number.isFinite(score) ? Math.round(score) : 1500,
          label,
          delta: Number.isFinite(delta) ? Math.round(delta) : 0
        };
      };
      const gsrBadge = (driver) => {
        const gsr = gsrInfo(driver);
        return ratingBadge('gsr', gsr.label || '--', gsr.score);
      };
      const safetyNumber = (value, fallback = 0) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      };

      const renderSafetyDetails = (row) => {
        const sr = row?.safetyRating || {};
        const isStrackerSource = sr.source === 'stracker.db3' || String(sr.model || '').includes('stracker');
        const penalties = sr.penalties || {};
        const laps = Array.isArray(sr.laps) ? sr.laps : [];
        const summary = !isStrackerSource
          ? '<li>Este SR no viene de STRacker. Revisa STRACKER_DB_PATH y que el middleware antiguo no esté registrado.</li>'
          : (Array.isArray(penalties.summary) && penalties.summary.length
            ? penalties.summary.map((item) => `<li>${escapeHtml(item)}</li>`).join('')
            : '<li>Sin sanciones ni incidentes registrados en STRacker.</li>');

        const lapRows = laps.length ? laps.map((lap) => {
          const alert = safetyNumber(lap.offTracks) || safetyNumber(lap.collisionsCar) || safetyNumber(lap.collisionsEnv) || !lap.valid;
          const notes = Array.isArray(lap.notes) && lap.notes.length ? lap.notes.join(', ') : '-';
          return `
            <tr class="${alert ? 'gc-acsr-lap-alert' : ''}">
              <td>${escapeHtml(lap.lap ?? '')}</td>
              <td>${escapeHtml(lap.lapTime || '--')}</td>
              <td>${lap.valid ? 'Sí' : 'No'}</td>
              <td>${escapeHtml(lap.offTracks ?? lap.cuts ?? 0)}</td>
              <td>${escapeHtml(lap.collisionsCar ?? 0)}</td>
              <td>${escapeHtml(lap.collisionsEnv ?? 0)}</td>
              <td>${escapeHtml(notes)}</td>
            </tr>`;
        }).join('') : `<tr><td colspan="7">${isStrackerSource ? 'No hay vueltas detalladas desde STRacker para este piloto.' : 'El endpoint no está entregando safetyRating.laps. El SR mostrado no procede de STRacker.'}</td></tr>`;

        return `
          <tr class="gc-acsr-safety-detail-row" data-safety-detail="${escapeHtml(row.guid || row.name || '')}" style="display:none">
            <td colspan="12">
              <div class="gc-acsr-safety-detail">
                <div class="gc-acsr-safety-summary">
                  <div class="gc-acsr-safety-card"><span>SR evento</span><strong>${escapeHtml(sr.eventScore ?? sr.score ?? '--')}</strong></div>
                  <div class="gc-acsr-safety-card"><span>Severidad</span><strong>${escapeHtml(sr.severity ?? 0)}</strong></div>
                  <div class="gc-acsr-safety-card"><span>Salidas</span><strong>${escapeHtml(sr.offTracks ?? sr.cuts ?? 0)}</strong></div>
                  <div class="gc-acsr-safety-card"><span>Golpes coche</span><strong>${escapeHtml(sr.collisionsCar ?? 0)}</strong></div>
                  <div class="gc-acsr-safety-card"><span>Golpes entorno</span><strong>${escapeHtml(sr.collisionsEnv ?? 0)}</strong></div>
                </div>
                <ul class="gc-acsr-penalty-list">${summary}</ul>
                <table class="gc-acsr-laps-table">
                  <thead><tr><th>Vuelta</th><th>Tiempo</th><th>Válida</th><th>Salidas</th><th>Golpes coche</th><th>Golpes entorno</th><th>Notas</th></tr></thead>
                  <tbody>${lapRows}</tbody>
                </table>
              </div>
            </td>
          </tr>`;
      };

      const driverCell = (row) => {
        const id = escapeHtml(row.guid || row.name || '');
        const name = escapeHtml(row.name || 'Piloto');
        return `<button type="button" class="gc-acsr-driver-toggle" data-driver-toggle="${id}" aria-expanded="false">${name}</button>`;
      };


      // GC_STRACKER_SAFETY_DETAILS_TOGGLE_V2
      document.addEventListener('click', (event) => {
        const button = event.target?.closest?.('[data-driver-toggle]');
        if (!button) return;

        const row = button.closest('tr');
        const detail = row?.nextElementSibling;
        if (!detail?.classList?.contains('gc-acsr-safety-detail-row')) return;

        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        detail.style.display = expanded ? 'none' : 'table-row';
      });

      const fmtDate = (value) => {
        if (!value) return 'Fecha por confirmar';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return 'Fecha por confirmar';
        return date.toLocaleString('es-ES', { weekday:'long', day:'2-digit', month:'long', hour:'2-digit', minute:'2-digit' });
      };

      const statusLabel = {
        pending: 'Pendiente',
        scheduled: 'Programada',
        in_progress: 'En curso',
        completed: 'Completada',
        cancelled: 'Cancelada'
      };

      const sessionLabel = {
        PRACTICE: 'Práctica',
        QUALIFY: 'Qualy',
        QUALIFICATION: 'Qualy',
        RACE: 'Carrera'
      };

      const setImageWithFallback = (img, figure, candidates) => {
        const cleanCandidates = (Array.isArray(candidates) ? candidates : []).filter(Boolean);
        if (!img || !figure || !cleanCandidates.length) {
          if (figure) figure.hidden = true;
          return;
        }

        figure.hidden = false;
        img.style.display = '';
        img.dataset.fallbackIndex = '0';
        img.dataset.fallbacks = cleanCandidates.slice(1).join('|');
        img.onerror = function () {
          const list = (this.dataset.fallbacks || '').split('|').filter(Boolean);
          const index = Number(this.dataset.fallbackIndex || 0);
          if (list[index]) {
            this.dataset.fallbackIndex = String(index + 1);
            this.src = list[index];
            return;
          }
          this.closest('figure')?.setAttribute('hidden', '');
          this.style.display = 'none';
        };
        img.src = cleanCandidates[0];
      };

      const renderResults = (tbody, rows, type) => {
        const list = Array.isArray(rows) ? rows : [];
        const colspan = type === 'race' ? 12 : 6;

        if (!list.length) {
          tbody.innerHTML = `<tr><td colspan="${colspan}">No hay resultados disponibles para esta sesión.</td></tr>`;
          return;
        }

        tbody.innerHTML = list.map((row) => {
          if (type === 'race') {
            return `
              <tr>
                <td><strong>${escapeHtml(row.position)}</strong></td>
                <td>${driverCell(row)}</td>
                <td>${escapeHtml(row.model || '')}</td>
                <td>${escapeHtml(row.numLaps ?? 0)}</td>
                <td>${escapeHtml(row.bestLap || '--')}</td>
                <td>${escapeHtml(row.totalTime || '--')}</td>
                <td><span class="gc-acsr-points">${escapeHtml(row.points ?? 0)}</span></td>
                <td>${srBadge(row)}</td>
                <td>${escapeHtml((row.srDelta ?? row.deltaSr ?? 0) > 0 ? '+' : '')}${escapeHtml(row.srDelta ?? row.deltaSr ?? 0)}</td>
                <td>${gsrBadge(row)}</td>
                <td>${escapeHtml((row.gsrDelta ?? row.deltaGsr ?? 0) > 0 ? '+' : '')}${escapeHtml(row.gsrDelta ?? row.deltaGsr ?? 0)}</td>
                <td>${escapeHtml((row.incidents || []).length || row.incidentPoints || 0)}</td>
              </tr>${renderSafetyDetails(row)}
            `;
          }

          return `
            <tr>
              <td><strong>${escapeHtml(row.position)}</strong></td>
              <td><strong>${escapeHtml(row.name)}</strong></td>
              <td>${escapeHtml(row.model || '')}</td>
              <td>${escapeHtml(row.numLaps ?? 0)}</td>
              <td>${escapeHtml(row.bestLap || '--')}</td>
              <td>${escapeHtml(row.gridPosition || row.position || '--')}</td>
            </tr>
          `;
        }).join('');
      };

      const renderError = (message) => {
        els.title.textContent = 'No se pudo cargar la ronda';
        els.meta.textContent = message || 'Error desconocido.';
        els.raceBody.innerHTML = `<tr><td colspan="12">${escapeHtml(message || 'Error desconocido')}</td></tr>`;
        els.qualyBody.innerHTML = `<tr><td colspan="6">${escapeHtml(message || 'Error desconocido')}</td></tr>`;
        els.sessionGrid.innerHTML = '<article class="gc-public-card"><strong>Sin datos</strong></article>';
      };

      const render = (data) => {
        if (!data?.ok || !data?.event) {
          renderError(data?.message || 'No se pudo cargar el evento.');
          return;
        }
        const event = data.event;

        const raceResults = Array.isArray(event.raceResults) ? event.raceResults : [];
        const qualyResults = Array.isArray(event.qualifyingResults) ? event.qualifyingResults : [];
        const winner = event.winner || raceResults[0] || null;
        const fastest = event.fastestLap || null;

        els.status.textContent = statusLabel[event.status] || event.status || 'Ronda';
        els.title.textContent = event.name || `Ronda ${event.index}`;
        els.meta.textContent = `${fmtDate(event.scheduledAt)} · ${event.track || 'Circuito por confirmar'}${event.carSummary ? ` · ${event.carSummary}` : ''}`;

        if (els.map) els.map.alt = event.track || event.name || '';
        const heroCandidates = event.trackPhotoCandidates?.length ? event.trackPhotoCandidates : (event.trackMapCandidates || []);
        setImageWithFallback(els.map, els.mapFigure, heroCandidates);

        els.winner.textContent = winner ? winner.name : '--';
        els.winnerMeta.textContent = winner ? `P${winner.position} · ${winner.points || 0} puntos · SR ${srInfo(winner).label} ${srInfo(winner).score} · ${winner.model || ''}` : 'Sin resultado de carrera';

        els.fastestLap.textContent = fastest ? fastest.lapTime : '--';
        els.fastestLapMeta.textContent = fastest ? `${fastest.driverName || 'Piloto'} · ${fastest.carModel || ''}` : 'Sin vuelta rápida';

        els.entrants.textContent = String(raceResults.length || qualyResults.length || 0);
        els.entrantsMeta.textContent = raceResults.length ? 'Pilotos con resultado de carrera' : 'Sin carrera completada';

        renderResults(els.raceBody, raceResults, 'race');
        renderResults(els.qualyBody, qualyResults, 'qualy');

        const sessions = Array.isArray(event.sessions) ? event.sessions : [];
        els.sessionGrid.innerHTML = sessions.length ? sessions.map((session) => `
          <article class="gc-public-card">
            <span>${escapeHtml(sessionLabel[session.type] || session.type || session.key)}</span>
            <strong>${escapeHtml(session.resultCount || 0)} resultados</strong>
            <p>${escapeHtml(session.lapCount || 0)} vueltas registradas</p>
            <p>${escapeHtml(session.fastestLap ? `Vuelta rápida: ${session.fastestLap.lapTime} · ${session.fastestLap.driverName}` : 'Sin vuelta rápida')}</p>
          </article>
        `).join('') : '<article class="gc-public-card"><strong>Sin sesiones registradas</strong></article>';
      };

      async function load() {
        try {
          const response = await fetch(`/api/gc/ratings/event/${encodeURIComponent(eventId)}?refresh=1`, { cache: 'no-store' });
          const data = await response.json();
          render(data);
        } catch (error) {
          renderError(error?.message || String(error));
        }
      }

      load();
    })();
  </script>
</MarketingLayout>
