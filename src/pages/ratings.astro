---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PublicHeroFrame from '../components/public/PublicHeroFrame.astro';
import '../styles/public/gc-rating-badges.css';
---

<MarketingLayout
  title="Ratings | GrassCutters Racing"
  description="SR mide limpieza en pista. GSR mide rendimiento competitivo."
  bodyClass="gc-page-ratings"
  canonicalPath="/ratings"
>
  <section class="gc-public-shell gc-public-section gc-ratings-page" data-gc-ratings-page>
    <div class="gc-ratings-atmosphere" aria-hidden="true">
      <video
        class="gc-ratings-atmosphere-video"
        src="/videos/04061.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    </div>
    <header class="gc-public-section-head gc-ratings-head">
      <div class="gc-ratings-head-copy">
        <PublicHeroFrame
            id="ratingsTitle"
            kicker="Ratings"
            title={['Dos sistemas', 'separados.']}
            lead="SR mide limpieza en pista. GSR mide rendimiento competitivo."
            leadId="ratingsLead"
          />
      
        <div class="gc-ratings-head-actions gc-hero-actions-inline">
          <a class="gc-public-btn gc-public-btn-secondary" href="#ratingsSr">Ver SR</a>
          <a class="gc-public-btn gc-public-btn-secondary" href="#ratingsGsr">Ver GSR</a>
          <button class="gc-public-btn gc-public-btn-primary" type="button" id="ratingsRefresh">Actualizar datos</button>
        </div>
</div>
    </header>


    <section class="gc-ratings-map">
      <div class="gc-ratings-map-grid">
        <article class="gc-public-card gc-ratings-map-card">
          <div class="gc-ratings-card-head gc-ratings-card-head--flat">
            <span class="gc-public-kicker">SR · Safety Racecraft</span>
            <h2 class="gc-ratings-card-title">Conducción limpia y segura.</h2>
            <p>Mide limpieza real, control del coche y cómo completas una carrera.</p>
          </div>

          <div class="gc-ratings-scale gc-ratings-scale--badges" aria-label="Escala SR">
            <div><span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-aplus"><span class="gc-rating-badge__type">SR</span><strong>Legend</strong></span><span>95–100</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-a"><span class="gc-rating-badge__type">SR</span><strong>Elite</strong></span><span>90–94</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-b"><span class="gc-rating-badge__type">SR</span><strong>Pro</strong></span><span>80–89</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-c"><span class="gc-rating-badge__type">SR</span><strong>Advanced</strong></span><span>70–79</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-d"><span class="gc-rating-badge__type">SR</span><strong>Rookie</strong></span><span>60–69</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-e"><span class="gc-rating-badge__type">SR</span><strong>Pitlane</strong></span><span>0–59</span></div>
          </div>
        </article>

        <article class="gc-public-card gc-ratings-map-card">
          <div class="gc-ratings-card-head gc-ratings-card-head--flat">
            <span class="gc-public-kicker">GSR · Grid Rank</span>
            <h2 class="gc-ratings-card-title">Rendimiento competitivo.</h2>
            <p>Mide resultado final y nivel de rivales.</p>
          </div>

          <div class="gc-ratings-scale gc-ratings-scale--badges" aria-label="Rangos GSR">
            <div><span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-s"><span class="gc-rating-badge__type">GSR</span><strong>Diamond</strong></span><span> · cabeza de parrilla</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-a"><span class="gc-rating-badge__type">GSR</span><strong>Ruby</strong></span><span> · muy competitivo</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-b"><span class="gc-rating-badge__type">GSR</span><strong>Sapphire</strong></span><span> · ritmo sólido</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-c"><span class="gc-rating-badge__type">GSR</span><strong>Emerald</strong></span><span> · en progresión</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-d"><span class="gc-rating-badge__type">GSR</span><strong>Amber</strong></span><span> · base competitiva</span></div>
            <div><span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-rookie"><span class="gc-rating-badge__type">GSR</span><strong>Onyx</strong></span><span>Rookie · sin base suficiente</span></div>
          </div>
        </article>
      </div>
    </section>

    <section class="gc-ratings-faq" aria-label="Preguntas frecuentes sobre SR y GSR">
      <details class="gc-ratings-faq-item" open>
        <summary>¿Qué mide el SR?</summary>
        <div>
          <p>El SR mide tu racecraft limpio: tiempo sin incidentes, vueltas limpias, rachas de conducción segura y si completas la carrera.</p>
          <p>No es una simple resta por carrera. Una carrera larga y limpia puede compensar pequeños errores, pero los contactos repetidos siguen pesando.</p>
        </div>
      </details>

      <details class="gc-ratings-faq-item">
        <summary>¿Cuánto SR puedo ganar?</summary>
        <div>
          <p>En una carrera normal, una actuación limpia puede acercarse a <strong>+1.20 SR</strong>. Si la carrera es larga y muy limpia, el máximo positivo flexible puede llegar a <strong>+1.50 SR</strong>.</p>
          <p>Si hay incidentes, el techo de ganancia baja: con un contacto de coche el máximo positivo se reduce, con varios contactos puede quedar casi neutro.</p>
        </div>
      </details>

      <details class="gc-ratings-faq-item">
        <summary>¿Cuánto SR puedo perder?</summary>
        <div>
          <p>Una carrera con problemas normales puede quedar limitada alrededor de <strong>-5 SR</strong>. Una carrera muy sucia, con muchos contactos o abandono, puede llegar aproximadamente a <strong>-8 SR</strong>.</p>
          <p>Casos extremos como descalificación o una carrera caótica pueden llegar hasta <strong>-12 SR</strong>. El objetivo es castigar carreras realmente peligrosas sin destruir a un piloto por un roce aislado.</p>
        </div>
      </details>

      <details class="gc-ratings-faq-item">
        <summary>¿Qué cuenta más para bajar SR?</summary>
        <div>
          <p>Los contactos con otros coches pesan más que una salida de pista aislada. Los golpes con entorno, cuts, abandonos y sanciones también cuentan, pero el sistema mira el conjunto de la carrera.</p>
        </div>
      </details>

      <details class="gc-ratings-faq-item">
        <summary>¿Qué mide el GSR?</summary>
        <div>
          <p>El GSR mide rendimiento competitivo: posición final, resultado frente a otros pilotos y fortaleza del grupo. No mide limpieza; para eso está el SR.</p>
        </div>
      </details>

      <details class="gc-ratings-faq-item">
        <summary>¿Puedo subir GSR y bajar SR en la misma carrera?</summary>
        <div>
          <p>Sí. Puedes hacer un gran resultado y ganar GSR, pero perder SR si has tenido contactos, salidas o una carrera sucia. Son sistemas separados.</p>
        </div>
      </details>

      <details class="gc-ratings-faq-item">
        <summary>¿Qué carreras cuentan?</summary>
        <div>
          <p>Ahora mismo el rating activo cuenta solo carreras oficiales ACSM completadas y vinculadas a sTracker. Las carreras no oficiales se mantienen separadas.</p>
        </div>
      </details>
    </section>

    <section class="gc-ratings-summary-grid" id="ratingsSummary">
      <article class="gc-public-card gc-ratings-stat-card">
        <span class="gc-public-kicker">Pilotos con rating</span>
        <h2 id="summaryDrivers">--</h2>
        <p>perfiles activos en leaderboard</p>
      </article>
      <article class="gc-public-card gc-ratings-stat-card">
        <span class="gc-public-kicker">Media SR</span>
        <h2 id="summaryAverageSr">--</h2>
        <p>seguridad media del campeonato</p>
      </article>
      <article class="gc-public-card gc-ratings-stat-card">
        <span class="gc-public-kicker">Líder GSR</span>
        <h2 id="summaryTopGsr">--</h2>
        <p id="summaryTopGsrMeta">sin datos</p>
      </article>
      <article class="gc-public-card gc-ratings-stat-card">
        <span class="gc-public-kicker">Carreras procesadas</span>
        <h2 id="summaryRaces">--</h2>
        <p>eventos cerrados con rating</p>
      </article>
      <article class="gc-public-card gc-ratings-stat-card">
        <span class="gc-public-kicker">Mejor SR</span>
        <h2 id="summaryBestSr">--</h2>
        <p id="summaryBestSrMeta">sin datos</p>
      </article>
      <article class="gc-public-card gc-ratings-stat-card">
        <span class="gc-public-kicker">Mayor subida reciente</span>
        <h2 id="summaryBestDelta">--</h2>
        <p id="summaryBestDeltaMeta">sin datos</p>
      </article>
    </section>

    <article class="gc-public-card gc-ratings-empty-card" id="ratingsEmpty" hidden>
      <span class="gc-public-kicker">Sin ratings</span>
      <h2 class="gc-ratings-card-title">No hay ratings todavía.</h2>
      <p>Procesa una carrera para generar SR y GSR.</p>
    </article>

    <section class="gc-ratings-table-shell" id="ratingsSr">
      <div class="gc-public-section-head">
        <div>
          <span class="gc-public-kicker">Safety Rating</span>
          <h2 class="gc-public-section-title">Leaderboard SR.</h2>
        </div>
      </div>

      <div class="gc-acsr-standings-table-wrap gc-ratings-table-wrap">
        <table class="gc-acsr-standings-table gc-ratings-table">
          <thead>
            <tr>
              <th>Pos</th>
              <th>Piloto</th>
              <th>SR</th>
              <th>Clase</th>
              <th>Carreras</th>
              <th>Limpias</th>
              <th>Incid./carrera</th>
              <th>Última variación</th>
            </tr>
          </thead>
          <tbody id="ratingsSrBody">
            <tr><td colspan="8">Cargando SR...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="gc-ratings-table-shell" id="ratingsGsr">
      <div class="gc-public-section-head">
        <div>
          <span class="gc-public-kicker">Grasscutters Skill Rating</span>
          <h2 class="gc-public-section-title">Leaderboard GSR.</h2>
        </div>
      </div>

      <div class="gc-acsr-standings-table-wrap gc-ratings-table-wrap">
        <table class="gc-acsr-standings-table gc-ratings-table">
          <thead>
            <tr>
              <th>Pos</th>
              <th>Piloto</th>
              <th>GSR</th>
              <th>Clase</th>
              <th>Carreras</th>
              <th>Victorias</th>
              <th>Podios</th>
              <th>Última variación</th>
            </tr>
          </thead>
          <tbody id="ratingsGsrBody">
            <tr><td colspan="8">Cargando GSR...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </section>

  <style is:global>
    .gc-ratings-page{
      display:grid;
      gap:clamp(22px,3vw,34px);
      padding-top:clamp(110px,12vw,170px);
    }

    .gc-ratings-head{
      align-items:end;
      gap:18px;
    }

    .gc-ratings-head-copy{
      max-width:760px;
    }

    .gc-ratings-head-actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      justify-content:flex-end;
    }

    .gc-ratings-map-grid,
    .gc-ratings-summary-grid{
      display:grid;
      gap:16px;
    }

    .gc-ratings-map-grid{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .gc-ratings-summary-grid{
      grid-template-columns:repeat(3,minmax(0,1fr));
    }

    .gc-ratings-map-card,
    .gc-ratings-stat-card,
    .gc-ratings-empty-card,
    .gc-ratings-table-shell{
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      border-radius:18px;
      background:rgba(255,255,255,.025);
      box-shadow:0 20px 60px rgba(0,0,0,.22);
    }

    .gc-ratings-map-card{
      display:grid;
      gap:18px;
      padding:22px;
    }

    .gc-ratings-card-head{
      display:grid;
      gap:8px;
      padding:0;
      border:0;
      background:transparent;
      box-shadow:none;
    }

    .gc-ratings-card-title{
      margin:0;
      font-size:clamp(1.3rem,2vw,1.9rem);
    }

    .gc-ratings-card-head p,
    .gc-ratings-empty-card p{
      margin:0;
      color:var(--gc-mk-muted,#9ca59a);
    }

    .gc-ratings-scale{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .gc-ratings-scale div,
    .gc-ratings-impact span,
    .gc-ratings-note{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:11px 12px;
      border:1px solid rgba(126,255,39,.16);
      border-radius:12px;
      background:rgba(0,0,0,.16);
    }

    .gc-ratings-scale strong,
    .gc-ratings-impact small,
    .gc-ratings-note-badge{
      color:var(--gc-mk-accent,#80ff1f);
      font-family:var(--font-mono,monospace);
      font-weight:900;
      letter-spacing:.04em;
    }

    .gc-ratings-scale span{
      color:var(--gc-mk-muted,#9ca59a);
      text-align:right;
      font-size:.9rem;
    }

    .gc-ratings-impact{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .gc-ratings-impact span b{
      font-size:.84rem;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .gc-ratings-impact span small{
      font-size:.84rem;
    }

    .gc-ratings-note{
      align-items:flex-start;
      justify-content:flex-start;
    }

    .gc-ratings-note-badge{
      display:inline-flex;
      align-items:center;
      min-width:max-content;
      padding:4px 8px;
      border:1px solid rgba(126,255,39,.22);
      border-radius:999px;
      background:rgba(126,255,39,.08);
      font-size:.72rem;
      text-transform:uppercase;
    }

    .gc-ratings-note p{
      margin:0;
      color:var(--gc-mk-text,#f5f7f2);
    }

    .gc-ratings-stat-card{
      display:grid;
      gap:8px;
      padding:18px;
    }

    .gc-ratings-stat-card h2{
      margin:0;
      font-size:clamp(1.7rem,3vw,2.5rem);
      line-height:1;
    }

    .gc-ratings-stat-card p{
      margin:0;
      color:var(--gc-mk-muted,#9ca59a);
    }

    .gc-ratings-empty-card{
      display:grid;
      gap:8px;
      padding:22px;
    }

    .gc-ratings-table-shell{
      display:grid;
      gap:16px;
      padding:18px;
    }

    .gc-ratings-table-wrap{
      overflow:auto;
    }

    .gc-ratings-table tbody tr{
      transition:background .16s ease, transform .16s ease;
    }

    .gc-ratings-table tbody tr:hover{
      background:rgba(126,255,39,.05);
    }

    .gc-ratings-row--top td{
      background:linear-gradient(180deg,rgba(126,255,39,.07),rgba(126,255,39,.02));
    }

    .gc-ratings-pos{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:34px;
      min-height:34px;
      border:1px solid rgba(126,255,39,.18);
      border-radius:999px;
      font-family:var(--font-mono,monospace);
      font-weight:900;
    }

    .gc-ratings-driver{
      display:grid;
      gap:4px;
      min-width:190px;
    }

    .gc-ratings-driver a,
    .gc-ratings-driver strong{
      color:inherit;
      text-decoration:none;
      font-weight:900;
    }

    .gc-ratings-driver a:hover{
      color:var(--gc-mk-accent,#80ff1f);
    }

    .gc-ratings-driver small{
      color:var(--gc-mk-muted,#9ca59a);
    }

    .gc-ratings-pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:5px 9px;
      border:1px solid rgba(126,255,39,.18);
      border-radius:999px;
      background:rgba(126,255,39,.05);
      color:var(--gc-mk-muted,#c5ccc1);
      font-family:var(--font-mono,monospace);
      font-size:.74rem;
      font-weight:900;
      letter-spacing:.05em;
      text-transform:uppercase;
      white-space:nowrap;
    }

    .gc-ratings-delta{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:58px;
      padding:5px 8px;
      border-radius:999px;
      font-family:var(--font-mono,monospace);
      font-size:.78rem;
      font-weight:900;
    }

    .gc-ratings-delta--positive{
      border:1px solid rgba(126,255,39,.24);
      color:var(--gc-mk-accent,#80ff1f);
      background:rgba(126,255,39,.08);
    }

    .gc-ratings-delta--negative{
      border:1px solid rgba(255,120,120,.2);
      color:#ffb0b0;
      background:rgba(255,100,100,.08);
    }

    .gc-ratings-delta--neutral{
      border:1px solid rgba(255,255,255,.08);
      color:var(--gc-mk-muted,#9ca59a);
      background:rgba(255,255,255,.04);
    }

    .gc-ratings-stat{
      font-family:var(--font-mono,monospace);
      font-weight:900;
    }


    .gc-ratings-card-head--flat{
      padding:0;
      border:0;
      background:transparent;
      box-shadow:none;
    }

    .gc-ratings-card-head--flat::before,
    .gc-ratings-card-head--flat::after{
      display:none!important;
    }

    .gc-ratings-faq{
      display:grid;
      gap:10px;
      margin-top:18px;
    }

    .gc-ratings-faq-item{
      border:1px solid rgba(126,255,39,.16);
      border-radius:18px;
      background:rgba(255,255,255,.025);
      overflow:hidden;
    }

    .gc-ratings-faq-item summary{
      cursor:pointer;
      list-style:none;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
      padding:16px 18px;
      color:var(--gc-mk-text,#f2f6ef);
      font-weight:950;
      letter-spacing:-.02em;
    }

    .gc-ratings-faq-item summary::-webkit-details-marker{
      display:none;
    }

    .gc-ratings-faq-item summary::after{
      content:"+";
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:28px;
      height:28px;
      border:1px solid rgba(126,255,39,.22);
      border-radius:999px;
      color:var(--gc-mk-accent,#80ff1f);
      font-family:var(--font-mono,monospace);
      font-weight:900;
    }

    .gc-ratings-faq-item[open] summary::after{
      content:"−";
    }

    .gc-ratings-faq-item div{
      display:grid;
      gap:8px;
      padding:0 18px 16px;
      color:var(--gc-mk-muted,#aeb8aa);
      line-height:1.55;
    }

    .gc-ratings-faq-item p{
      margin:0;
    }


    .gc-ratings-faq-item strong{
      color:var(--gc-mk-accent,#80ff1f);
      font-weight:950;
    }

    @media (max-width:1180px){
      .gc-ratings-summary-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
    }

    @media (max-width:980px){
      .gc-ratings-head{
        align-items:start;
      }

      .gc-ratings-head-actions{
        justify-content:flex-start;
      }

      .gc-ratings-map-grid,
      .gc-ratings-summary-grid,
      .gc-ratings-scale,
      .gc-ratings-impact{
        grid-template-columns:1fr;
      }
    }

    @media (max-width:720px){
      .gc-ratings-table{
        min-width:760px;
      }
    }
  </style>

  <script>
    (() => {
      const srBody = document.getElementById('ratingsSrBody');
      const gsrBody = document.getElementById('ratingsGsrBody');
      const lead = document.getElementById('ratingsLead');
      const refreshButton = document.getElementById('ratingsRefresh');
      const emptyCard = document.getElementById('ratingsEmpty');

      const summaryDrivers = document.getElementById('summaryDrivers');
      const summaryAverageSr = document.getElementById('summaryAverageSr');
      const summaryTopGsr = document.getElementById('summaryTopGsr');
      const summaryTopGsrMeta = document.getElementById('summaryTopGsrMeta');
      const summaryRaces = document.getElementById('summaryRaces');
      const summaryBestSr = document.getElementById('summaryBestSr');
      const summaryBestSrMeta = document.getElementById('summaryBestSrMeta');
      const summaryBestDelta = document.getElementById('summaryBestDelta');
      const summaryBestDeltaMeta = document.getElementById('summaryBestDeltaMeta');

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char]));

      const toNumber = (value) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : null;
      };

      const validSr = (value) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
      };

      const formatDelta = (value, digits = 1) => {
        const numeric = toNumber(value);
        if (numeric === null) return '--';
        const formatted = digits === 0 ? String(Math.round(numeric)) : numeric.toFixed(digits);
        return `${numeric > 0 ? '+' : ''}${formatted}`;
      };

      const deltaClass = (value) => {
        const numeric = toNumber(value);
        if (numeric === null || numeric === 0) return 'gc-ratings-delta gc-ratings-delta--neutral';
        return numeric > 0
          ? 'gc-ratings-delta gc-ratings-delta--positive'
          : 'gc-ratings-delta gc-ratings-delta--negative';
      };

      const driverLink = (row, label) => {
        const directPlayerId = row?.profilePlayerId || row?.strackerPlayerId || '';
        const driverKey = String(row?.driverKey || '');
        const playerId = directPlayerId || (driverKey.startsWith('player:') ? driverKey.replace('player:', '') : '');
        if (playerId) {
          return `<a href="/pilotos/${encodeURIComponent(String(playerId))}">${escapeHtml(label)}</a>`;
        }
        return `<strong>${escapeHtml(label)}</strong>`;
      };

      const ratingClassKey = (value) => String(value || 'unknown')
        .trim()
        .toLowerCase()
        .replace('+', 'plus')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'unknown';

      const ratingBadge = (type, value, score = null, options = {}) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const safeValue = String(value || '--');
        const classKey = ratingClassKey(safeValue);
        const compactClass = options.compact ? ' gc-rating-badge--compact' : '';
        const scoreMarkup = score !== null && score !== undefined && score !== ''
          ? `<small>${escapeHtml(score)}</small>`
          : '';

        return `
          <span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${classKey}${compactClass}">
            <span class="gc-rating-badge__type">${safeType.toUpperCase()}</span>
            <strong>${escapeHtml(safeValue)}</strong>
            ${scoreMarkup}
          </span>
        `;
      };

      const pill = (value, type = 'sr') => ratingBadge(type, value || '--', null, { compact: true });
      const delta = (value, digits = 1) => `<span class="${deltaClass(value)}">${escapeHtml(formatDelta(value, digits))}</span>`;
      const driverCell = (row) => `
        <div class="gc-ratings-driver">
          ${driverLink(row, row.driver || 'Piloto')}
          ${row.profilePlayerId || String(row.driverKey || '').startsWith('player:') ? '<small>Perfil público</small>' : ''}
        </div>
      `;

      function renderSr(rows) {
        if (!rows.length) {
          srBody.innerHTML = '<tr><td colspan="8">Sin datos de SR.</td></tr>';
          return;
        }

        srBody.innerHTML = rows.map((row, index) => `
          <tr class="${index < 3 ? 'gc-ratings-row--top' : ''}">
            <td><span class="gc-ratings-pos">${escapeHtml(row.position ?? index + 1)}</span></td>
            <td>${driverCell(row)}</td>
            <td>${ratingBadge('sr', row.srClass || '--', validSr(row.sr)?.toFixed(1) ?? '--')}</td>
            <td>${pill(row.srClass, 'sr')}</td>
            <td><span class="gc-ratings-stat">${escapeHtml(row.races ?? '--')}</span></td>
            <td><span class="gc-ratings-stat">${escapeHtml(row.cleanRaces ?? '--')}</span></td>
            <td><span class="gc-ratings-stat">${escapeHtml(row.incidentsPerRace ?? '--')}</span></td>
            <td>${delta(row.lastDelta, 1)}</td>
          </tr>
        `).join('');
      }

      function renderGsr(rows) {
        if (!rows.length) {
          gsrBody.innerHTML = '<tr><td colspan="8">Sin datos de GSR.</td></tr>';
          return;
        }

        gsrBody.innerHTML = rows.map((row, index) => `
          <tr class="${index < 3 ? 'gc-ratings-row--top' : ''}">
            <td><span class="gc-ratings-pos">${escapeHtml(row.position ?? index + 1)}</span></td>
            <td>${driverCell(row)}</td>
            <td>${ratingBadge('gsr', row.gsrClass || '--', row.gsr ?? '--')}</td>
            <td>${pill(row.gsrClass, 'gsr')}</td>
            <td><span class="gc-ratings-stat">${escapeHtml(row.races ?? '--')}</span></td>
            <td><span class="gc-ratings-stat">${escapeHtml(row.wins ?? '--')}</span></td>
            <td><span class="gc-ratings-stat">${escapeHtml(row.podiums ?? '--')}</span></td>
            <td>${delta(row.lastDelta, 0)}</td>
          </tr>
        `).join('');
      }

      function updateSummary(srRows, gsrRows, diagnostics) {
        const validSrRows = srRows.filter((row) => validSr(row.sr) !== null);
        const averageSr = validSrRows.length
          ? (validSrRows.reduce((sum, row) => sum + Number(validSr(row.sr) || 0), 0) / validSrRows.length).toFixed(1)
          : '--';
        const topGsr = gsrRows[0] || null;
        const bestSr = validSrRows[0] || null;
        const biggestGain = [...srRows.map((row) => ({ ...row, type: 'SR' })), ...gsrRows.map((row) => ({ ...row, type: 'GSR' }))]
          .filter((row) => toNumber(row.lastDelta) !== null)
          .sort((a, b) => Number(b.lastDelta) - Number(a.lastDelta))[0] || null;

        summaryDrivers.textContent = String(Math.max(srRows.length, gsrRows.length, 0) || '--');
        summaryAverageSr.textContent = String(averageSr);
        summaryTopGsr.textContent = topGsr ? String(topGsr.gsr ?? '--') : '--';
        summaryTopGsrMeta.textContent = topGsr ? `${topGsr.driver} · ${topGsr.gsrClass}` : 'sin datos';
        summaryRaces.textContent = String(diagnostics?.eventsProcessed ?? '--');
        summaryBestSr.textContent = bestSr ? validSr(bestSr.sr)?.toFixed(1) ?? '--' : '--';
        summaryBestSrMeta.textContent = bestSr ? `${bestSr.driver} · ${bestSr.srClass}` : 'sin datos';

        if (biggestGain && Number(biggestGain.lastDelta) > 0) {
          summaryBestDelta.textContent = formatDelta(biggestGain.lastDelta, biggestGain.type === 'SR' ? 1 : 0);
          summaryBestDeltaMeta.textContent = `${biggestGain.driver} · ${biggestGain.type}`;
        } else {
          summaryBestDelta.textContent = '--';
          summaryBestDeltaMeta.textContent = 'sin datos';
        }
      }

      function setEmptyState(isEmpty) {
        emptyCard.hidden = !isEmpty;
      }

      async function loadRatings() {
        if (refreshButton) refreshButton.disabled = true;
        lead.textContent = 'SR mide limpieza en pista. GSR mide rendimiento competitivo.';

        try {
          const response = await fetch('/api/gc/ratings/championship', { cache: 'no-store' });
          const data = await response.json();

          if (!data?.ok) {
            throw new Error(data?.message || 'No se pudieron cargar los ratings.');
          }

          const srRows = Array.isArray(data.leaderboard?.sr) ? data.leaderboard.sr : [];
          const gsrRows = Array.isArray(data.leaderboard?.gsr) ? data.leaderboard.gsr : [];
          const isEmpty = !srRows.length && !gsrRows.length;

          lead.textContent = 'SR mide limpieza en pista. GSR mide rendimiento competitivo.';
          renderSr(srRows);
          renderGsr(gsrRows);
          updateSummary(srRows, gsrRows, data.diagnostics || {});
          setEmptyState(isEmpty);
        } catch (error) {
          const message = error instanceof Error ? error.message : 'No se pudieron cargar los ratings.';
          lead.textContent = message || 'No se pudieron cargar los ratings.';
          srBody.innerHTML = '<tr><td colspan="8">No se pudieron cargar los ratings.</td></tr>';
          gsrBody.innerHTML = '<tr><td colspan="8">No se pudieron cargar los ratings.</td></tr>';
          setEmptyState(false);
        } finally {
          if (refreshButton) refreshButton.disabled = false;
        }
      }

      refreshButton?.addEventListener('click', () => {
        loadRatings();
      });

      loadRatings();
    })();
  </script>
</MarketingLayout>
