---
import MarketingLayout from '../layouts/MarketingLayout.astro';

const apkUrl = '/downloads/grasscutters-android.apk';

const ranking = [
  { position: '01', name: 'PDÍAZ', time: '1:31.507', tone: 'green' },
  { position: '02', name: 'ROMERO', time: '1:31.842', tone: 'orange' },
  { position: '03', name: 'NEO', time: '1:32.106', tone: 'blue' },
  { position: '04', name: 'NANDY', time: '1:32.441', tone: 'red' },
];
---

<MarketingLayout
  title="App Android | GrassCutters Racing"
  description="Descarga la app Android de GrassCutters Racing y consulta rankings, perfil y actividad de la comunidad desde el móvil."
  bodyClass="gc-page-android"
>
  <section class="gc-android-hero" aria-labelledby="gc-android-title">
    <div class="gc-android-grid" aria-hidden="true"></div>
    <div class="gc-android-glow gc-android-glow--left" aria-hidden="true"></div>
    <div class="gc-android-glow gc-android-glow--right" aria-hidden="true"></div>

    <div class="gc-android-shell gc-android-hero__inner">
      <div class="gc-android-copy">
        <div class="gc-android-eyebrow">
          <span class="gc-android-eyebrow__dot"></span>
          App oficial · Android
        </div>

        <h1 id="gc-android-title">
          GrassCutters
          <span>siempre contigo.</span>
        </h1>

        <p class="gc-android-lead">
          Consulta hotlaps, sigue tu progresión y accede a la comunidad desde una experiencia creada para el móvil.
        </p>

        <div class="gc-android-actions">
          <a class="gc-android-download" href={apkUrl} download>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" />
            </svg>
            <span>
              <small>Descarga directa</small>
              Descargar APK
            </span>
          </a>

          <a class="gc-android-open" href="/app">
            Abrir plataforma
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </a>
        </div>

        <div class="gc-android-meta" aria-label="Información de la descarga">
          <span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9-2-3m12 3 2-3M6 10h12v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-8Zm3 4v2m6-2v2M9 6l3-2 3 2" /></svg>
            Android
          </span>
          <span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 2.9 8.5 7 10 4.1-1.5 7-5.6 7-10V6l-7-3Zm-3 9 2 2 4-4" /></svg>
            Descarga directa
          </span>
          <span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v4l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            Instalación rápida
          </span>
        </div>
      </div>

      <div class="gc-device-stage" aria-label="Vista previa de la aplicación Android">
        <div class="gc-stage-line gc-stage-line--one" aria-hidden="true"></div>
        <div class="gc-stage-line gc-stage-line--two" aria-hidden="true"></div>

        <div class="gc-phone gc-phone--ranking">
          <div class="gc-phone__speaker"></div>
          <div class="gc-phone__screen">
            <div class="gc-mobile-topbar">
              <div class="gc-mobile-brand">
                <span class="gc-mobile-brand__mark">GC</span>
                <span><strong>GRASSCUTTERS</strong><small>RACING APP</small></span>
              </div>
              <span class="gc-mobile-menu">•••</span>
            </div>

            <div class="gc-mobile-content">
              <span class="gc-mobile-kicker">HOTLAPS</span>
              <h2>MEJORES TIEMPOS</h2>
              <div class="gc-mobile-combo">
                <span>AUTODROM MOST</span>
                <strong>SUPRA GT4</strong>
              </div>

              <div class="gc-mobile-ranking">
                {ranking.map((driver) => (
                  <div class="gc-mobile-row">
                    <strong>{driver.position}</strong>
                    <span class:list={['gc-mobile-avatar', `is-${driver.tone}`]}>{driver.name.charAt(0)}</span>
                    <span class="gc-mobile-driver">{driver.name}</span>
                    <time>{driver.time}</time>
                  </div>
                ))}
              </div>
            </div>

            <div class="gc-mobile-tabs">
              <span class="is-active">Ranking</span>
              <span>Live</span>
              <span>Perfil</span>
            </div>
          </div>
        </div>

        <div class="gc-phone gc-phone--profile">
          <div class="gc-phone__speaker"></div>
          <div class="gc-phone__screen">
            <div class="gc-mobile-topbar">
              <div class="gc-mobile-brand">
                <span class="gc-mobile-brand__mark">GC</span>
                <span><strong>GRASSCUTTERS</strong><small>RACING APP</small></span>
              </div>
              <span class="gc-mobile-menu">•••</span>
            </div>

            <div class="gc-profile-head">
              <div class="gc-profile-avatar">D</div>
              <div>
                <span>PILOTO</span>
                <h2>DANI</h2>
                <small>ESPAÑA · GRASSCUTTERS</small>
              </div>
            </div>

            <div class="gc-profile-ratings">
              <div><small>SR</small><strong>86</strong><span>SAFETY</span></div>
              <div><small>GSR</small><strong>1.482</strong><span>RATING</span></div>
            </div>

            <div class="gc-profile-stats">
              <div><span>Vueltas</span><strong>842</strong></div>
              <div><span>Mejor posición</span><strong>01</strong></div>
              <div><span>Combos</span><strong>34</strong></div>
            </div>

            <div class="gc-profile-chart" aria-hidden="true">
              <span>PROGRESIÓN</span>
              <svg viewBox="0 0 240 72" preserveAspectRatio="none">
                <path class="chart-fill" d="M0 61 22 54 45 58 68 43 92 47 116 34 140 39 164 24 188 28 212 12 240 17V72H0Z" />
                <path class="chart-line" d="M0 61 22 54 45 58 68 43 92 47 116 34 140 39 164 24 188 28 212 12 240 17" />
              </svg>
            </div>

            <div class="gc-mobile-tabs">
              <span>Ranking</span>
              <span>Live</span>
              <span class="is-active">Perfil</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="gc-android-strip" aria-label="Funciones principales">
    <div class="gc-android-shell gc-android-strip__inner">
      <article>
        <span class="gc-feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0V4Zm0 2H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4m-4 2v4m-4 2h8" /></svg>
        </span>
        <div><h2>Rankings en directo</h2><p>Hotlaps y tiempos de la comunidad siempre a mano.</p></div>
      </article>

      <article>
        <span class="gc-feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V9m5 10V5m5 14v-7m5 7V3" /></svg>
        </span>
        <div><h2>Tu progresión</h2><p>Perfil, ratings y estadísticas en una vista compacta.</p></div>
      </article>

      <article>
        <span class="gc-feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 18a4 4 0 0 0-8 0m4-7a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM5 13a3 3 0 0 0-3 3m17-3a3 3 0 0 1 3 3" /></svg>
        </span>
        <div><h2>Comunidad conectada</h2><p>Acceso rápido a la actividad y a tus compañeros.</p></div>
      </article>
    </div>
  </section>

  <section class="gc-android-install">
    <div class="gc-android-shell gc-install-panel">
      <div>
        <span class="gc-android-eyebrow">Instalación</span>
        <h2>Tres pasos y estás dentro.</h2>
      </div>
      <ol>
        <li><strong>01</strong><span>Descarga el archivo APK.</span></li>
        <li><strong>02</strong><span>Autoriza la instalación desde el navegador si Android te lo solicita.</span></li>
        <li><strong>03</strong><span>Instala y abre GrassCutters Racing.</span></li>
      </ol>
      <a class="gc-android-download gc-android-download--compact" href={apkUrl} download>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
        Descargar APK
      </a>
    </div>
  </section>
</MarketingLayout>

<style>
  :global(body.gc-page-android) {
    background:
      radial-gradient(circle at 75% 22%, rgba(116, 255, 36, .07), transparent 30rem),
      #030604;
  }

  .gc-android-shell {
    width: min(1400px, calc(100% - 64px));
    margin-inline: auto;
  }

  .gc-android-hero {
    position: relative;
    isolation: isolate;
    min-height: 720px;
    overflow: hidden;
    border-bottom: 1px solid rgba(132, 255, 53, .14);
    background:
      linear-gradient(90deg, rgba(3, 7, 4, .98) 0%, rgba(3, 7, 4, .92) 38%, rgba(3, 7, 4, .58) 67%, rgba(3, 7, 4, .88) 100%);
  }

  .gc-android-grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: .24;
    background-image:
      linear-gradient(rgba(126, 255, 43, .08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(126, 255, 43, .08) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(90deg, #000, transparent 42%, #000);
  }

  .gc-android-glow {
    position: absolute;
    z-index: -2;
    border-radius: 999px;
    filter: blur(90px);
    pointer-events: none;
  }

  .gc-android-glow--left {
    width: 460px;
    height: 460px;
    left: -280px;
    top: 180px;
    background: rgba(94, 255, 0, .12);
  }

  .gc-android-glow--right {
    width: 620px;
    height: 620px;
    right: -80px;
    top: 60px;
    background: rgba(77, 255, 0, .14);
  }

  .gc-android-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(520px, 1.08fr);
    align-items: center;
    gap: clamp(40px, 5vw, 90px);
    min-height: 720px;
    padding-block: 72px 60px;
  }

  .gc-android-copy {
    position: relative;
    z-index: 5;
    max-width: 660px;
  }

  .gc-android-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #90ff3e;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .gc-android-eyebrow__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8fff3a;
    box-shadow: 0 0 16px rgba(143, 255, 58, .8);
  }

  .gc-android-copy h1 {
    margin: 18px 0 0;
    color: #f4f8f2;
    font-family: var(--sans);
    font-size: clamp(60px, 6.4vw, 102px);
    font-weight: 900;
    letter-spacing: -.075em;
    line-height: .82;
    text-transform: uppercase;
  }

  .gc-android-copy h1 span {
    display: block;
    color: #8fff3a;
    font-style: italic;
    text-shadow: 0 0 32px rgba(107, 255, 25, .14);
  }

  .gc-android-lead {
    max-width: 570px;
    margin: 28px 0 0;
    color: #b7c2ba;
    font-size: clamp(17px, 1.4vw, 21px);
    line-height: 1.55;
  }

  .gc-android-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
    margin-top: 34px;
  }

  .gc-android-download,
  .gc-android-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    font-family: var(--sans);
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease;
  }

  .gc-android-download {
    gap: 13px;
    min-height: 62px;
    padding: 0 25px;
    border: 1px solid rgba(173, 255, 116, .56);
    background: linear-gradient(180deg, #9cff4e, #6fe51a);
    color: #071005;
    box-shadow: 0 10px 30px rgba(103, 240, 22, .13);
  }

  .gc-android-download svg {
    width: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .gc-android-download span {
    display: grid;
    gap: 5px;
  }

  .gc-android-download small {
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .14em;
    opacity: .68;
  }

  .gc-android-open {
    gap: 9px;
    min-height: 62px;
    padding: 0 23px;
    border: 1px solid rgba(255, 255, 255, .14);
    background: rgba(11, 17, 12, .82);
    color: #edf3eb;
    font-size: 12px;
    letter-spacing: .06em;
  }

  .gc-android-open svg {
    width: 18px;
    fill: none;
    stroke: #8fff3a;
    stroke-width: 2;
  }

  .gc-android-download:hover,
  .gc-android-open:hover {
    transform: translateY(-2px);
  }

  .gc-android-download:hover {
    box-shadow: 0 13px 34px rgba(103, 240, 22, .22);
  }

  .gc-android-open:hover {
    border-color: rgba(143, 255, 58, .44);
    background: rgba(15, 24, 16, .95);
  }

  .gc-android-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
    color: #718078;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .gc-android-meta span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .gc-android-meta svg {
    width: 14px;
    fill: none;
    stroke: #7fff2f;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .gc-device-stage {
    position: relative;
    height: 610px;
    perspective: 1500px;
  }

  .gc-device-stage::before {
    position: absolute;
    inset: 11% 2% 3% 8%;
    content: "";
    border: 1px solid rgba(137, 255, 60, .11);
    background:
      linear-gradient(145deg, rgba(144, 255, 71, .08), transparent 46%),
      rgba(6, 12, 8, .54);
    clip-path: polygon(13% 0, 100% 0, 87% 100%, 0 100%);
  }

  .gc-stage-line {
    position: absolute;
    z-index: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(134, 255, 51, .65), transparent);
    transform: rotate(-15deg);
  }

  .gc-stage-line--one {
    width: 480px;
    right: -80px;
    top: 130px;
  }

  .gc-stage-line--two {
    width: 560px;
    right: -50px;
    bottom: 130px;
  }

  .gc-phone {
    position: absolute;
    z-index: 3;
    width: 272px;
    height: 555px;
    padding: 9px;
    border: 1px solid rgba(255, 255, 255, .22);
    border-radius: 35px;
    background: linear-gradient(145deg, #283029 0%, #090c0a 28%, #1b201b 100%);
    box-shadow:
      0 32px 70px rgba(0, 0, 0, .65),
      inset 0 0 0 1px rgba(255, 255, 255, .06);
  }

  .gc-phone::after {
    position: absolute;
    inset: 4px;
    z-index: -1;
    content: "";
    border-radius: 31px;
    box-shadow: inset 0 0 24px rgba(151, 255, 74, .08);
  }

  .gc-phone--ranking {
    left: 2%;
    top: 38px;
    transform: rotateY(9deg) rotateZ(-5deg);
  }

  .gc-phone--profile {
    right: 2%;
    top: 2px;
    z-index: 4;
    transform: rotateY(-9deg) rotateZ(3.5deg);
  }

  .gc-phone__speaker {
    position: absolute;
    z-index: 5;
    top: 14px;
    left: 50%;
    width: 72px;
    height: 17px;
    border-radius: 0 0 13px 13px;
    background: #030504;
    transform: translateX(-50%);
  }

  .gc-phone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 27px;
    background:
      linear-gradient(rgba(128, 255, 52, .025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(128, 255, 52, .025) 1px, transparent 1px),
      #050806;
    background-size: 24px 24px;
    color: #f1f5ef;
  }

  .gc-mobile-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    padding: 12px 14px 8px;
    border-bottom: 1px solid rgba(138, 255, 63, .14);
    background: rgba(3, 7, 4, .88);
  }

  .gc-mobile-brand {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .gc-mobile-brand__mark {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid #84ff35;
    border-radius: 50%;
    color: #84ff35;
    font-size: 8px;
    font-weight: 900;
  }

  .gc-mobile-brand > span:last-child {
    display: grid;
    gap: 2px;
  }

  .gc-mobile-brand strong {
    font-size: 8px;
    letter-spacing: .08em;
  }

  .gc-mobile-brand small {
    color: #768079;
    font-family: var(--mono);
    font-size: 5px;
    letter-spacing: .16em;
  }

  .gc-mobile-menu {
    color: #8fff3a;
    font-size: 12px;
    letter-spacing: 2px;
  }

  .gc-mobile-content {
    padding: 24px 15px 62px;
  }

  .gc-mobile-kicker,
  .gc-profile-head > div:last-child > span {
    color: #84ff35;
    font-family: var(--mono);
    font-size: 7px;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .gc-mobile-content h2,
  .gc-profile-head h2 {
    margin: 5px 0 0;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -.055em;
    line-height: .9;
  }

  .gc-mobile-combo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding: 8px 9px;
    border-left: 2px solid #84ff35;
    background: rgba(135, 255, 61, .06);
    color: #89928c;
    font-family: var(--mono);
    font-size: 6px;
  }

  .gc-mobile-combo strong {
    color: #dce3da;
    font-size: 6px;
  }

  .gc-mobile-ranking {
    display: grid;
    gap: 5px;
    margin-top: 10px;
  }

  .gc-mobile-row {
    display: grid;
    grid-template-columns: 21px 27px minmax(0, 1fr) auto;
    align-items: center;
    min-height: 43px;
    padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, .055);
    background: rgba(255, 255, 255, .022);
  }

  .gc-mobile-row > strong {
    color: #84ff35;
    font-family: var(--mono);
    font-size: 9px;
  }

  .gc-mobile-avatar {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: rgba(255, 255, 255, .05);
    font-size: 7px;
    font-weight: 900;
  }

  .gc-mobile-avatar.is-green { color: #84ff35; }
  .gc-mobile-avatar.is-orange { color: #ff9d38; }
  .gc-mobile-avatar.is-blue { color: #4bb8ff; }
  .gc-mobile-avatar.is-red { color: #ff5757; }

  .gc-mobile-driver {
    overflow: hidden;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: .05em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gc-mobile-row time {
    color: #f0f5ed;
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 800;
  }

  .gc-mobile-tabs {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 51px;
    border-top: 1px solid rgba(255, 255, 255, .08);
    background: rgba(3, 7, 4, .96);
  }

  .gc-mobile-tabs span {
    display: grid;
    place-items: center;
    color: #67716a;
    font-family: var(--mono);
    font-size: 6px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .gc-mobile-tabs .is-active {
    color: #84ff35;
    box-shadow: inset 0 -2px #84ff35;
  }

  .gc-profile-head {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    align-items: center;
    padding: 29px 16px 17px;
  }

  .gc-profile-avatar {
    display: grid;
    width: 62px;
    height: 62px;
    place-items: center;
    border: 2px solid #84ff35;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 25%, rgba(143, 255, 58, .3), transparent 38%),
      #142016;
    color: #a5ff66;
    font-size: 25px;
    font-weight: 900;
    box-shadow: 0 0 24px rgba(132, 255, 53, .13);
  }

  .gc-profile-head small {
    display: block;
    margin-top: 6px;
    color: #6f7972;
    font-family: var(--mono);
    font-size: 6px;
    letter-spacing: .08em;
  }

  .gc-profile-ratings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
    padding: 0 15px;
  }

  .gc-profile-ratings > div {
    position: relative;
    padding: 11px;
    border: 1px solid rgba(132, 255, 53, .16);
    background: rgba(132, 255, 53, .045);
  }

  .gc-profile-ratings small,
  .gc-profile-ratings span {
    display: block;
    color: #7e8981;
    font-family: var(--mono);
    font-size: 6px;
    letter-spacing: .12em;
  }

  .gc-profile-ratings strong {
    display: block;
    margin: 4px 0;
    color: #91ff47;
    font-family: var(--mono);
