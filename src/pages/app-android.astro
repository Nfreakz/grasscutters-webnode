---
import MarketingLayout from '../layouts/MarketingLayout.astro';

const apkUrl = '/downloads/grasscutters-android.apk';

const ranking = [
  { position: '1', name: 'Neo', time: '1:38.452', tone: 'lime' },
  { position: '2', name: 'Ferchu', time: '1:38.713', tone: 'silver' },
  { position: '3', name: 'MatiS', time: '1:39.104', tone: 'bronze' },
  { position: '4', name: 'SebaRS', time: '1:39.287', tone: 'dark' },
  { position: '5', name: 'Tomi_94', time: '1:39.552', tone: 'dark' },
  { position: '6', name: 'NachoCR', time: '1:39.871', tone: 'dark' },
  { position: '7', name: 'JaviP', time: '1:40.029', tone: 'dark' },
  { position: '8', name: 'Lucho23', time: '1:40.315', tone: 'dark' },
];
---

<MarketingLayout
  title="App Android | GrassCutters Racing"
  description="Descarga la app Android de GrassCutters Racing y consulta rankings, hotlaps, perfil y comunidad desde el móvil."
  bodyClass="gc-page-android"
>
  <main class="android-landing">
    <section class="android-hero" aria-labelledby="android-title">
      <div class="android-hero__bg" aria-hidden="true"></div>
      <div class="android-hero__grid" aria-hidden="true"></div>
      <div class="android-shell android-hero__inner">
        <div class="android-copy">
          <p class="android-kicker">App Android</p>
          <h1 id="android-title"><span>Tu paddock.</span><span>En el bolsillo.</span></h1>
          <p class="android-lead">
            Rankings, hotlaps, perfil y comunidad.<br />
            Todo GrassCutters desde el móvil.
          </p>

          <div class="android-actions">
            <a class="android-btn android-btn--primary" href={apkUrl} download>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
              Descargar APK
            </a>
            <a class="android-btn android-btn--secondary" href="#funciones">Ver funciones</a>
          </div>

          <div class="android-meta" aria-label="Información de la aplicación">
            <span>Android</span><i aria-hidden="true"></i>
            <span>Descarga directa</span><i aria-hidden="true"></i>
            <span>App oficial</span>
          </div>
        </div>

        <div class="phone-stage" aria-label="Vista previa de la aplicación GrassCutters para Android">
          <div class="phone phone--ranking">
            <div class="phone__side phone__side--left" aria-hidden="true"></div>
            <div class="phone__screen">
              <div class="phone-status"><span>12:30</span><span class="status-icons">● ◒ ▰</span></div>
              <header class="mobile-header">
                <span class="mobile-menu" aria-hidden="true">☰</span>
                <strong>RANKINGS</strong>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16l-6 7v6l-4 2v-8L4 5Z" /></svg>
              </header>
              <nav class="mobile-tabs-top" aria-label="Categorías de ranking">
                <span class="is-active">General</span><span>GT4</span><span>Supra GT4</span>
              </nav>
              <div class="mobile-table-head"><span>Pos</span><span>Piloto</span><span>Mejor vuelta</span></div>
              <div class="mobile-ranking">
                {ranking.map((driver) => (
                  <div class="mobile-rank-row">
                    <span class:list={['rank-pos', `rank-pos--${driver.tone}`]}>{driver.position}</span>
                    <strong>{driver.name}</strong>
                    <time>{driver.time}</time>
                  </div>
                ))}
              </div>
              <nav class="mobile-nav" aria-label="Navegación de la app">
                <span class="is-active">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0V4Zm0 2H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4m-4 2v4m-4 2h8" /></svg>
                  Rankings
                </span>
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7" /><path d="M12 13V8m-3-6h6" /></svg>
                  Hotlaps
                </span>
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="9" r="3" /><circle cx="16" cy="9" r="3" /><path d="M2 20v-2a5 5 0 0 1 10 0v2m0 0v-2a5 5 0 0 1 10 0v2" /></svg>
                  Comunidad
                </span>
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                  Perfil
                </span>
              </nav>
            </div>
          </div>

          <div class="phone phone--profile">
            <div class="phone__side phone__side--right" aria-hidden="true"></div>
            <div class="phone__screen">
              <div class="phone-status"><span>12:30</span><span class="status-icons">● ◒ ▰</span></div>
              <header class="mobile-header mobile-header--profile">
                <span aria-hidden="true">‹</span><strong>PERFIL</strong><span></span>
              </header>
              <div class="profile-card">
                <div class="profile-avatar">
                  <span class="helmet-glass"></span>
                  <span class="helmet-chin"></span>
                </div>
                <h2>Neo</h2>
                <p>#27</p>
                <span class="profile-role">Piloto</span>
              </div>
              <div class="profile-metrics">
                <div><small>Posición</small><strong>1º</strong></div>
                <div><small>Rating</small><strong>2548</strong></div>
                <div><small>Victorias</small><strong>12</strong></div>
              </div>
              <div class="profile-best">
                <h3>Mejores vueltas</h3>
                <div><span>Suzuka</span><time>1:38.452</time></div>
                <div><span>Monza</span><time>1:39.104</time></div>
                <div><span>Spa-Francorchamps</span><time>1:39.287</time></div>
                <a href="/hotlaps">Ver todas</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <nav class="android-feature-bar" aria-label="Funciones principales">
      <div class="android-shell android-feature-bar__inner">
        <a href="/hotlaps">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 12 16 8m-4-5v2" /></svg>
          Hotlaps en directo
        </a>
        <a href="/perfil">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
          Perfil de piloto
        </a>
        <a href="/ratings">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0V4Zm0 2H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4m-4 2v4m-4 2h8" /></svg>
          Rankings
        </a>
        <a href="/comunidad">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="9" r="3" /><circle cx="16" cy="9" r="3" /><path d="M2 20v-2a5 5 0 0 1 10 0v2m0 0v-2a5 5 0 0 1 10 0v2" /></svg>
          Comunidad
        </a>
      </div>
    </nav>

    <section class="android-utility" id="funciones" aria-labelledby="functions-title">
      <div class="android-shell utility-panel">
        <div class="utility-title">
          <p class="android-kicker">Tu comunidad en carrera</p>
          <h2 id="functions-title">Todo lo que necesitas entre tandas</h2>
        </div>
        <ol class="utility-list">
          <li>
            <strong>01</strong>
            <span class="utility-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7" /><path d="M12 13V8m-3-6h6" /></svg>
            </span>
            <div><h3>Consulta tiempos</h3><p>Hotlaps en directo y tiempos por pista.</p></div>
          </li>
          <li>
            <strong>02</strong>
            <span class="utility-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V11h4v9m4 0V5h4v15m4 0V8h2v12" /></svg>
            </span>
            <div><h3>Sigue el campeonato</h3><p>Rankings actualizados y rendimiento real.</p></div>
          </li>
          <li>
            <strong>03</strong>
            <span class="utility-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="9" r="3" /><circle cx="16" cy="9" r="3" /><path d="M2 20v-2a5 5 0 0 1 10 0v2m0 0v-2a5 5 0 0 1 10 0v2" /></svg>
            </span>
            <div><h3>Entra al paddock</h3><p>Comunidad, avisos y actividad siempre cerca.</p></div>
          </li>
        </ol>
        <aside class="utility-download" aria-label="Descarga oficial para Android">
          <svg class="android-robot" viewBox="0 0 100 112" aria-hidden="true">
            <path d="m31 22-8-13m46 13 8-13M22 31h56v46a9 9 0 0 1-9 9H31a9 9 0 0 1-9-9V31Zm0 9H12v31m66-31h10v31M34 86v17m32-17v17" />
            <circle cx="39" cy="46" r="2" /><circle cx="61" cy="46" r="2" />
          </svg>
          <div>
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 2.9 8.5 7 10 4.1-1.5 7-5.6 7-10V6l-7-3Zm-3 9 2 2 4-4" /></svg> App oficial</p>
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 2.9 8.5 7 10 4.1-1.5 7-5.6 7-10V6l-7-3Zm-3 9 2 2 4-4" /></svg> Descarga directa</p>
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 2.9 8.5 7 10 4.1-1.5 7-5.6 7-10V6l-7-3Zm-3 9 2 2 4-4" /></svg> Acceso GrassCutters</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="android-install" aria-labelledby="install-title">
      <div class="android-shell install-inner">
        <div>
          <p class="android-kicker">Instalación directa</p>
          <h2 id="install-title">Tres pasos. Ya estás dentro.</h2>
        </div>
        <ol>
          <li><strong>01</strong><span>Descarga el archivo APK.</span></li>
          <li><strong>02</strong><span>Autoriza la instalación si Android lo solicita.</span></li>
          <li><strong>03</strong><span>Instala y abre GrassCutters Racing.</span></li>
        </ol>
        <a class="android-btn android-btn--primary android-btn--small" href={apkUrl} download>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
          Descargar APK
        </a>
      </div>
    </section>
  </main>
</MarketingLayout>

<style>
  :global(body.gc-page-android) {
    --android-green: #8cff00;
    --android-line: rgba(140, 255, 0, .22);
    background: #020403;
  }

  :global(body.gc-page-android .gc-public-header) {
    border-bottom-color: rgba(140, 255, 0, .12);
    background: rgba(2, 5, 3, .96);
  }

  :global(body.gc-page-android .gc-public-brand-mark),
  :global(body.gc-page-android .gc-public-brand-mark img) {
    width: 158px !important;
    height: 58px !important;
    max-width: 158px !important;
    max-height: 58px !important;
    object-fit: contain !important;
    object-position: left center !important;
  }

  :global(body.gc-page-android .gc-public-brand) {
    min-width: 190px;
  }

  :global(body.gc-page-android .gc-public-brand-copy) {
    display: none !important;
  }

  .android-landing {
    overflow: hidden;
    color: #f3f6f1;
    background: #020403;
  }

  .android-shell {
    width: min(1400px, calc(100% - 72px));
    margin-inline: auto;
  }

  .android-hero {
    position: relative;
    isolation: isolate;
    height: 624px;
    overflow: hidden;
    border-bottom: 1px solid rgba(140, 255, 0, .25);
    background: #020403;
  }

  .android-hero__bg,
  .android-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .android-hero__bg {
    background:
      linear-gradient(90deg, rgba(2, 4, 3, .98) 0%, rgba(2, 4, 3, .88) 34%, rgba(2, 4, 3, .24) 68%, rgba(2, 4, 3, .14) 100%),
      linear-gradient(0deg, rgba(2, 4, 3, .14), rgba(2, 4, 3, .04)),
      url('/images/android/gc-android-track-hero-v2.webp') center / cover no-repeat;
  }

  .android-hero__grid {
    z-index: -1;
    opacity: .18;
    background-image:
      linear-gradient(rgba(140, 255, 0, .08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(140, 255, 0, .08) 1px, transparent 1px);
    background-size: 78px 78px;
    mask-image: linear-gradient(90deg, #000 0%, transparent 52%, #000 100%);
  }

  .android-hero__inner {
    display: grid;
    grid-template-columns: 48% 52%;
    align-items: stretch;
    height: 100%;
  }

  .android-copy {
    position: relative;
    z-index: 5;
    align-self: center;
    padding-bottom: 3px;
  }

  .android-kicker {
    margin: 0;
    color: var(--android-green);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .android-copy h1 {
    display: grid;
    gap: 0;
    margin: 16px 0 0;
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", "Arial Narrow", sans-serif;
    font-size: clamp(73px, 6.65vw, 108px);
    font-weight: 900;
    letter-spacing: -.025em;
    line-height: .88;
    text-transform: uppercase;
  }

  .android-copy h1 span {
    display: block;
    width: max-content;
    max-width: 100%;
    color: #eef1eb;
    text-shadow: 0 3px 0 rgba(255, 255, 255, .1), 0 15px 35px rgba(0, 0, 0, .5);
  }

  .android-lead {
    margin: 18px 0 0;
    color: #aeb5b0;
    font-size: 17px;
    line-height: 1.5;
  }

  .android-actions {
    display: flex;
    gap: 14px;
    margin-top: 23px;
  }

  .android-btn {
    display: inline-flex;
    min-height: 53px;
    align-items: center;
    justify-content: center;
    padding: 0 30px;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #f4f7f2;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .android-btn svg {
    width: 19px;
    margin-right: 11px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .android-btn:hover { transform: translateY(-2px); }

  .android-btn--primary {
    border-color: #a7ff4f;
    background: linear-gradient(180deg, #a1ff35, #75e900);
    color: #071004;
    box-shadow: 0 0 27px rgba(140, 255, 0, .22);
  }

  .android-btn--primary:hover { box-shadow: 0 0 36px rgba(140, 255, 0, .38); }

  .android-btn--secondary {
    border-color: rgba(140, 255, 0, .48);
    background: rgba(2, 6, 3, .62);
  }

  .android-btn--secondary:hover { border-color: var(--android-green); }

  .android-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    color: #858c87;
    font-size: 12px;
  }

  .android-meta i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--android-green);
    box-shadow: 0 0 8px rgba(140, 255, 0, .7);
  }

  .phone-stage {
    position: relative;
    height: 100%;
    min-width: 650px;
  }

  .phone-stage::after {
    position: absolute;
    right: -12%;
    bottom: -90px;
    left: -12%;
    z-index: 0;
    height: 170px;
    content: "";
    background: radial-gradient(ellipse, rgba(140, 255, 0, .2), rgba(140, 255, 0, .03) 45%, transparent 72%);
    filter: blur(15px);
  }

  .phone {
    position: absolute;
    z-index: 2;
    width: 278px;
    height: 565px;
    padding: 7px;
    border: 1px solid rgba(206, 255, 176, .5);
    border-radius: 39px;
    background: linear-gradient(115deg, #3a413c 0%, #080b09 14%, #1b201c 46%, #050806 73%, #394039 100%);
    box-shadow:
      0 34px 55px rgba(0, 0, 0, .72),
      0 0 0 2px rgba(5, 8, 6, .8),
      inset -2px 0 0 rgba(147, 255, 68, .2);
    transform-origin: 50% 100%;
  }

  .phone::before {
    position: absolute;
    top: 12px;
    left: 50%;
    z-index: 5;
    width: 64px;
    height: 15px;
    content: "";
    border-radius: 0 0 12px 12px;
    background: #020403;
    transform: translateX(-50%);
  }

  .phone--ranking {
    top: 20px;
    left: 26px;
    transform: rotate(5.8deg);
  }

  .phone--profile {
    top: 57px;
    right: 8px;
    z-index: 1;
    transform: rotate(7.8deg) scale(.92);
  }

  .phone__side {
    position: absolute;
    top: 92px;
    width: 3px;
    height: 78px;
    border-radius: 3px;
    background: #586059;
  }

  .phone__side--left { left: -4px; }
  .phone__side--right { right: -4px; }

  .phone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 32px;
    background:
      linear-gradient(rgba(140, 255, 0, .02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(140, 255, 0, .02) 1px, transparent 1px),
      #040705;
    background-size: 26px 26px;
    color: #f2f4f0;
  }

  .phone-status {
    display: flex;
    height: 31px;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 18px 6px;
    color: #dfe4df;
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 700;
  }

  .status-icons {
    color: #939b95;
    font-size: 7px;
    letter-spacing: 2px;
  }

  .mobile-header {
    display: grid;
    grid-template-columns: 35px 1fr 35px;
    height: 55px;
    align-items: center;
    border-bottom: 1px solid rgba(140, 255, 0, .18);
    text-align: center;
  }

  .mobile-header strong {
    font-family: Impact, Haettenschweiler, "Arial Narrow", sans-serif;
    font-size: 20px;
    font-style: italic;
    letter-spacing: .06em;
  }

  .mobile-header svg {
    width: 18px;
    margin-inline: auto;
    fill: none;
    stroke: #c5cbc6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .mobile-menu {
    color: #959e97;
    font-size: 15px;
    transform: scaleX(1.25);
  }

  .mobile-tabs-top {
    display: grid;
    grid-template-columns: 1fr .72fr 1.05fr;
    height: 48px;
    align-items: center;
    padding: 0 10px;
    border-bottom: 1px solid rgba(140, 255, 0, .18);
    color: #767f78;
    font-family: var(--mono);
    font-size: 7px;
    font-style: italic;
    text-align: center;
    text-transform: uppercase;
  }

  .mobile-tabs-top span {
    display: grid;
    height: 30px;
    place-items: center;
  }

  .mobile-tabs-top .is-active {
    background: var(--android-green);
    color: #071004;
    font-weight: 900;
    transform: skewX(-7deg);
  }

  .mobile-table-head {
    display: grid;
    grid-template-columns: 42px 1fr 80px;
    padding: 14px 12px 7px;
    color: #757d77;
    font-family: var(--mono);
    font-size: 6px;
    text-transform: uppercase;
  }

  .mobile-table-head span:last-child { text-align: right; }

  .mobile-ranking {
    display: grid;
    padding: 0 10px 58px;
  }

  .mobile-rank-row {
    display: grid;
    grid-template-columns: 42px 1fr auto;
    min-height: 39px;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, .08);
    font-size: 10px;
  }

  .mobile-rank-row strong {
    overflow: hidden;
    font-size: 10px;
    font-style: italic;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-rank-row:first-child strong { color: var(--android-green); }

  .mobile-rank-row time {
    font-family: var(--mono);
    font-size: 8px;
  }

  .rank-pos {
    display: grid;
    width: 26px;
    height: 27px;
    place-items: center;
    border-radius: 2px;
    background: #131814;
    color: #edf1eb;
    font-size: 11px;
    font-weight: 800;
  }

  .rank-pos--lime { background: var(--android-green); color: #071004; }
  .rank-pos--silver { background: linear-gradient(135deg, #606760, #1a1f1b); }
  .rank-pos--bronze { background: linear-gradient(135deg, #815b20, #21170a); }

  .mobile-nav {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    min-height: 58px;
    border-top: 1px solid rgba(255, 255, 255, .08);
    background: rgba(3, 6, 4, .97);
  }

  .mobile-nav span {
    display: grid;
    gap: 3px;
    place-content: center;
    color: #6f7771;
    font-family: var(--mono);
    font-size: 5px;
    text-align: center;
    text-transform: uppercase;
  }

  .mobile-nav svg {
    width: 16px;
    margin-inline: auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .mobile-nav .is-active { color: var(--android-green); }

  .mobile-header--profile { border-bottom: 0; }

  .mobile-header--profile > span {
    color: #aeb4af;
    font-size: 23px;
  }

  .profile-card {
    padding: 20px 10px 15px;
    text-align: center;
  }

  .profile-avatar {
    position: relative;
    width: 72px;
    height: 72px;
    margin-inline: auto;
