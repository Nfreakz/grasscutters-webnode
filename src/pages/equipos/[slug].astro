---
export const prerender = false;
import MarketingLayout from '../../layouts/MarketingLayout.astro';
const slug = Astro.params.slug ?? '';
---
<MarketingLayout
  title="Equipo | GrassCutters Racing"
  description="Ficha pública de escudería GrassCutters Racing: palmarés, pilotos y puntos de campeonato."
  canonicalPath={`/equipos/${slug}`}
  bodyClass="gc-page-platform-data"
>
  <main class="gc-team-page gc-public-shell" data-gc-team-page data-team-slug={slug}>
    <section class="gc-team-hero" id="gcTeamHero">
      <div class="gc-team-hero__logo"><img id="gcTeamLogo" src="/images/team-default-gc.svg" alt="Logo de equipo" loading="lazy" /></div>
      <div class="gc-team-hero__copy">
        <p>GRASSCUTTERS / ESCUDERÍA</p>
        <h1 id="gcTeamName">Cargando equipo...</h1>
        <span id="gcTeamDescription">Ficha pública de equipo, palmarés y pilotos activos.</span>
      </div>
      <div class="gc-team-hero__actions">
        <a id="gcTeamAdminLink" href={`/equipos/${slug}/admin`}>Gestionar</a>
        <a href="/equipos">Todos los equipos</a>
      </div>
    </section>

    <section class="gc-team-stats" id="gcTeamStats">
      <article><span>Pilotos</span><strong>--</strong></article>
      <article><span>Puntos campeonato</span><strong>--</strong></article>
      <article><span>Victorias</span><strong>--</strong></article>
      <article><span>Podios</span><strong>--</strong></article>
      <article><span>Títulos</span><strong>--</strong></article>
      <article><span>Estado</span><strong>Activo</strong></article>
    </section>

    <section class="gc-team-board">
      <header><p>Roster activo</p><span>Owner, capitanes, pilotos y reservas vinculados al equipo.</span></header>
      <div class="gc-team-members" id="gcTeamMembers"><article>Cargando pilotos...</article></div>
    </section>
  </main>

  <style is:global>
    .gc-team-page{max-width:1440px;margin:0 auto;padding:22px 18px 56px;display:grid;gap:16px;color:var(--text,#f4fff1)}
    .gc-team-hero{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:18px;align-items:center;border:1px solid rgba(150,255,47,.22);background:linear-gradient(135deg,rgba(150,255,47,.10),rgba(1,7,4,.98));padding:22px;box-shadow:0 0 38px rgba(150,255,47,.07)}
    .gc-team-hero__logo img{width:96px;height:96px;border-radius:50%;object-fit:cover;border:1px solid rgba(150,255,47,.55);background:#050905}
    .gc-team-hero__copy p{margin:0 0 8px;color:#96ff2f;font:900 12px/1 var(--gc-mono,monospace);letter-spacing:.16em}
    .gc-team-hero__copy h1{margin:0;font-size:clamp(34px,6vw,78px);line-height:.88;text-transform:uppercase}
    .gc-team-hero__copy span{display:block;margin-top:10px;color:rgba(244,255,241,.70);max-width:760px}
    .gc-team-hero__actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
    .gc-team-hero__actions a{border:1px solid rgba(150,255,47,.44);background:rgba(150,255,47,.10);color:#96ff2f;text-decoration:none;padding:11px 12px;font:900 11px/1 var(--gc-mono,monospace);text-transform:uppercase;letter-spacing:.08em}
    .gc-team-stats{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
    .gc-team-stats article{border:1px solid rgba(150,255,47,.16);background:rgba(3,9,5,.92);padding:14px}
    .gc-team-stats span{display:block;color:rgba(244,255,241,.55);font:800 10px/1 var(--gc-mono,monospace);text-transform:uppercase;letter-spacing:.12em}
    .gc-team-stats strong{display:block;margin-top:7px;color:#96ff2f;font:950 28px/1 var(--gc-mono,monospace)}
    .gc-team-board{border:1px solid rgba(150,255,47,.16);background:rgba(3,9,5,.92)}
    .gc-team-board header{display:flex;justify-content:space-between;gap:12px;padding:14px;border-bottom:1px solid rgba(150,255,47,.14)}
    .gc-team-board header p{margin:0;color:#96ff2f;font:900 12px/1 var(--gc-mono,monospace);text-transform:uppercase;letter-spacing:.14em}
    .gc-team-board header span{color:rgba(244,255,241,.56);font-size:12px}
    .gc-team-members{display:grid;gap:1px;background:rgba(150,255,47,.10)}
    .gc-team-member{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;background:rgba(3,9,5,.98);padding:12px 14px}
    .gc-team-member b{font-size:15px;text-transform:uppercase}.gc-team-member small{display:block;color:rgba(244,255,241,.55);font:800 11px/1.2 var(--gc-mono,monospace);margin-top:4px}.gc-team-member strong{color:#96ff2f;font:900 12px/1 var(--gc-mono,monospace);text-transform:uppercase}
    @media(max-width:960px){.gc-team-hero{grid-template-columns:1fr}.gc-team-hero__actions{justify-content:flex-start}.gc-team-stats{grid-template-columns:1fr 1fr}.gc-team-member{grid-template-columns:1fr}}
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-gc-team-page]');
      const slug = root?.dataset.teamSlug || '';
      const esc = (v) => String(v ?? '').replace(/[&<>'"]/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
      const setText = (id, text) => { const el = document.getElementById(id); if (el) el.textContent = text; };
      async function load() {
        try {
          const res = await fetch(`/api/gc/teams/${encodeURIComponent(slug)}`, { cache:'no-store', credentials:'include' });
          const data = await res.json();
          if (!data.ok || !data.team) throw new Error(data.message || 'Equipo no encontrado');
          const team = data.team;
          const members = data.members || team.members || [];
          setText('gcTeamName', team.name || 'Equipo');
          setText('gcTeamDescription', team.description || 'Escudería GrassCutters Racing.');
          const img = document.getElementById('gcTeamLogo'); if (img) img.src = team.logoUrl || '/images/team-default-gc.svg';
          const stats = document.getElementById('gcTeamStats');
          if (stats) stats.innerHTML = `
            <article><span>Pilotos</span><strong>${members.length}</strong></article>
            <article><span>Puntos piloto</span><strong>${Number(data.stats?.championshipPoints || data.stats?.points || 0)}</strong></article>
            <article><span>Victorias</span><strong>${Number(data.stats?.wins || 0)}</strong></article>
            <article><span>Podios</span><strong>${Number(data.stats?.podiums || 0)}</strong></article>
            <article><span>Títulos</span><strong>${Number(data.stats?.titles || 0)}</strong></article>
            <article><span>Estado</span><strong>Activo</strong></article>`;
          const box = document.getElementById('gcTeamMembers');
          if (box) box.innerHTML = members.length ? members.map((m) => `
            <article class="gc-team-member">
              <span><b>${esc(m.displayName || m.driverName || 'Piloto')}</b><small>${esc(m.playerId || m.steamGuid || 'sin cuenta vinculada')}</small></span>
              <strong>${esc(m.role || 'driver')}</strong>
              <strong>${esc(m.status || 'activo')}</strong>
            </article>`).join('') : '<article class="gc-team-member"><span><b>Sin pilotos</b><small>Añade pilotos desde la gestión del equipo.</small></span></article>';
        } catch (error) {
          setText('gcTeamName', 'Equipo no encontrado');
          setText('gcTeamDescription', error?.message || 'No se pudo cargar la escudería.');
          const box = document.getElementById('gcTeamMembers'); if (box) box.innerHTML = '<article class="gc-team-member"><span><b>No disponible</b></span></article>';
        }
      }
      load();
    })();
  </script>
</MarketingLayout>
