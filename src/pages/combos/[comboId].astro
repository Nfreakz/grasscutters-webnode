---
export const prerender = false;
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="Combo | GrassCutters">
  <div class="gc-page gc-combo-detail-page gc-combo-detail-v28" data-combo-detail>
    <section class="gc-combo-hero-v28">
      <div class="gc-combo-hero-v28__main">
        <span class="gc-kicker">Ficha de combo</span>
        <h1 class="gc-title" id="comboTitle">Cargando combo...</h1>
        <p class="gc-subtitle" id="comboSubtitle">Ficha del circuito, paquete de coches permitido, mejores vueltas y actividad reciente.</p>

        <figure class="gc-combo-track-figure-v27" id="comboTrackFigure" hidden>
          <img id="comboTrackImage" src="" alt="" loading="lazy" decoding="async" />
        </figure>

        <div class="gc-combo-actions-v28" aria-label="Acciones del combo">
          <a class="gc-btn" href="/combos">Volver a combos</a>
          <a class="gc-btn" href="/hotlaps">Ver hotlaps</a>
          <a class="gc-btn gc-btn--primary" id="comboJoinServer" href="https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153" target="_blank" rel="noreferrer">Unirse al servidor</a>
          <a class="gc-btn" href="https://drive.google.com/drive/folders/1BXJJkPOo7ZuhIKf_VegI5g8serZsJw7W?usp=drive_link" target="_blank" rel="noreferrer">Coches</a>
          <a class="gc-btn" href="https://drive.google.com/drive/folders/1xSrI8aPBLH15wrytkR-IUjMQPWEVyfQw?usp=drive_link" target="_blank" rel="noreferrer">Circuito</a>
          <span class="gc-chip gc-chip--accent" id="comboKey">Combo lógico</span>
        </div>
      </div>

      <aside class="gc-combo-summary-v28" aria-label="Resumen del combo">
        <div class="gc-combo-summary-v28__title">
          <span>Resumen</span>
          <strong id="comboStatus">...</strong>
        </div>
        <div class="gc-combo-reference-v28">
          <span>Mejor referencia</span>
          <strong id="comboQuickBest">...</strong>
          <small id="comboQuickBestMeta">...</small>
        </div>
        <div class="gc-combo-summary-v28__grid">
          <div><span>Vueltas</span><strong id="comboLaps">...</strong></div>
          <div><span>Pilotos</span><strong id="comboDrivers">...</strong></div>
          <div><span>Coches</span><strong id="comboCars">...</strong></div>
        </div>
      </aside>
    </section>

    <section class="gc-combo-garage-panel-v28" aria-label="Garaje y referencia del combo">
      <div class="gc-combo-garage-head-v28">
        <div>
          <span class="gc-kicker">Paquete de coches</span>
          <h2 id="comboCarsTitle">...</h2>
          <p id="comboCarsSub">Referencia principal del combo.</p>
        </div>
        <div class="gc-combo-car-tags-v28" id="comboCarTags"></div>
      </div>

      <div class="gc-combo-garage-stats-v28">
        <article><span>Mejor vuelta</span><strong id="metricBest">...</strong><small id="metricBestDriver">Piloto</small></article>
        <article><span>Velocidad máxima</span><strong id="metricSpeed">...</strong><small>Máxima registrada</small></article>
        <article><span>Media Top 10</span><strong id="metricTop10">...</strong><small>Vueltas válidas</small></article>
        <article><span>Última actividad</span><strong id="metricRecent">...</strong><small>Última vuelta registrada</small></article>
      </div>
    </section>

    <section class="gc-section-block gc-combo-table-section-v28 gc-combo-bycar-section-v27">
      <div class="gc-section-head">
        <div><span class="gc-kicker">Comparativa por coche</span><h2>Top 5 por coche</h2></div>
        <span class="gc-chip" id="comboByCarCount">Cargando</span>
      </div>
      <div class="gc-combo-bycar-grid-v28" id="comboByCarTop5">
        <article class="gc-combo-bycar-card-v28"><h3>...</h3><p>Cargando tiempos por coche...</p></article>
      </div>
    </section>

    <section class="gc-section-block gc-combo-table-section-v28">
      <div class="gc-section-head">
        <div><span class="gc-kicker">Leaderboard</span><h2>Mejores pilotos del combo</h2></div>
        <span class="gc-chip" id="comboLeaderboardCount">Cargando</span>
      </div>
      <div class="gc-table-wrap gc-combo-table-wrap-v28">
        <table class="gc-table">
          <thead><tr><th>#</th><th>Piloto</th><th>Coche</th><th>Tiempo</th><th>Delta</th><th>Vmax</th><th>Cortes</th><th>Fecha</th></tr></thead>
          <tbody id="leaderboardRows"><tr><td colspan="8">Cargando...</td></tr></tbody>
        </table>
      </div>
    </section>

    <section class="gc-section-block gc-combo-table-section-v28">
      <div class="gc-section-head">
        <div><span class="gc-kicker">Actividad</span><h2>Últimas vueltas</h2></div>
        <span class="gc-chip" id="comboRecentCount">Cargando</span>
      </div>
      <div class="gc-table-wrap gc-combo-table-wrap-v28">
        <table class="gc-table">
          <thead><tr><th>Piloto</th><th>Coche</th><th>Tiempo</th><th>Estado</th><th>Vmax</th><th>Cortes</th><th>Fecha</th></tr></thead>
          <tbody id="recentRows"><tr><td colspan="7">Cargando...</td></tr></tbody>
        </table>
      </div>
    </section>
  </div>

  <style is:global>
    .gc-combo-detail-v28{width:100%;max-width:1480px;margin-inline:auto;padding-inline:clamp(8px,1.2vw,18px);display:grid;gap:clamp(18px,2.3vw,28px);box-sizing:border-box;}
    .gc-combo-hero-v28{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,360px);gap:clamp(16px,2vw,26px);align-items:center;margin:0;padding:clamp(26px,3.4vw,40px);border:1px solid color-mix(in srgb,var(--accent,#9dff00) 30%,var(--line));border-radius:28px;background:linear-gradient(120deg,rgba(255,255,255,.07),rgba(255,255,255,.018)),radial-gradient(circle at 82% 12%, color-mix(in srgb,var(--accent2,#35d3ff) 10%,transparent), transparent 22rem),radial-gradient(circle at 8% 18%, color-mix(in srgb,var(--accent,#9dff00) 12%,transparent), transparent 20rem);box-shadow:0 18px 70px rgba(0,0,0,.20), inset 0 0 0 1px rgba(255,255,255,.035);}
    .gc-combo-hero-v28::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(0deg,rgba(255,255,255,.026) 1px,transparent 1px);background-size:42px 42px;opacity:.28;mask-image:linear-gradient(90deg,rgba(0,0,0,.48),transparent 72%);}
    .gc-combo-hero-v28>*{position:relative;z-index:1;}
    .gc-combo-hero-v28 .gc-title{text-transform:uppercase;font-size:clamp(3.2rem,7vw,6.4rem);line-height:.86;letter-spacing:-.08em;margin:8px 0 12px;}
    .gc-combo-actions-v28{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;align-items:center;}
    .gc-combo-actions-v28 .gc-btn,.gc-combo-actions-v28 .gc-chip{min-height:36px;}
    .gc-combo-track-figure-v27{margin:16px 0 0;border-radius:22px;border:1px solid rgba(255,255,255,.1);overflow:hidden;background:rgba(0,0,0,.2);box-shadow:0 20px 70px rgba(0,0,0,.24);}
    .gc-combo-track-figure-v27[hidden]{display:none;}
    .gc-combo-track-figure-v27 img{display:block;width:100%;aspect-ratio:16/6;object-fit:cover;opacity:.98;filter:saturate(1.02) contrast(1.04);}
    .gc-combo-summary-v28{align-self:start;display:grid;align-content:start;gap:0;padding:0;overflow:hidden;border:1px solid color-mix(in srgb,var(--accent,#9dff00) 18%,var(--line));border-top:2px solid var(--accent);background:radial-gradient(circle at 100% 0%, color-mix(in srgb,var(--accent,#9dff00) 16%,transparent), transparent 10rem),rgba(0,0,0,.18);box-shadow:inset 0 0 0 1px rgba(255,255,255,.035);}
    .gc-combo-summary-v28__title{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.14);}
    .gc-combo-summary-v28__title span,.gc-combo-summary-v28__grid span,.gc-combo-garage-stats-v28 span,.gc-combo-reference-v28 span{color:var(--dim);text-transform:uppercase;letter-spacing:.105em;font-size:.7rem;font-weight:950;}
    .gc-combo-summary-v28__title strong,.gc-combo-reference-v28 span{color:var(--accent);}
    .gc-combo-reference-v28{display:grid;gap:5px;padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.08);}
    .gc-combo-reference-v28 strong{color:var(--text);font-size:1.08rem;line-height:1.16;}
    .gc-combo-reference-v28 small{color:var(--muted);line-height:1.35;}
    .gc-combo-summary-v28__grid{display:grid;gap:0;}
    .gc-combo-summary-v28__grid div{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 16px;border-bottom:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.08);}
    .gc-combo-summary-v28__grid div:last-child{border-bottom:0;}
    .gc-combo-summary-v28__grid strong{color:var(--text);font-size:1.15rem;line-height:1;}
    .gc-combo-garage-panel-v28,.gc-combo-table-section-v28{overflow:hidden;border:1px solid rgba(255,255,255,.08);border-top:2px solid var(--accent);border-radius:28px;background:radial-gradient(circle at 100% 0%, color-mix(in srgb,var(--accent,#9dff00) 7%,transparent), transparent 16rem),linear-gradient(135deg,rgba(255,255,255,.045),rgba(255,255,255,.014));box-shadow:0 18px 70px rgba(0,0,0,.16);}
    .gc-combo-garage-panel-v28{display:grid;gap:18px;padding:clamp(18px,2.2vw,26px);}
    .gc-combo-garage-head-v28{display:grid;grid-template-columns:minmax(250px,.58fr) minmax(0,1.42fr);gap:clamp(16px,2.2vw,28px);align-items:start;}
    .gc-combo-garage-head-v28 h2{margin:.28rem 0 .5rem;color:var(--text);font-size:clamp(2.1rem,4.4vw,4.7rem);line-height:.9;letter-spacing:-.065em;max-width:520px;}
    .gc-combo-garage-head-v28 p{margin:0;max-width:560px;color:var(--muted);line-height:1.48;}
    .gc-combo-car-tags-v28{display:flex;gap:.45rem;flex-wrap:wrap;justify-content:flex-end;align-content:flex-start;}
    .gc-combo-car-tag{border:1px solid var(--line);padding:.42rem .62rem;color:var(--text);background:color-mix(in srgb,var(--surface),transparent 22%);font-size:.82rem;font-weight:850;line-height:1.1;}
    .gc-combo-garage-stats-v28{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border:1px solid color-mix(in srgb,var(--accent,#9dff00) 18%,var(--line));background:rgba(255,255,255,.018);}
    .gc-combo-garage-stats-v28 article{min-height:112px;display:grid;align-content:start;gap:9px;padding:15px;border-right:1px solid var(--line);background:radial-gradient(circle at 100% 0%, color-mix(in srgb,var(--accent,#9dff00) 9%,transparent), transparent 8rem),linear-gradient(135deg,rgba(255,255,255,.052),rgba(255,255,255,.018));}
    .gc-combo-garage-stats-v28 article:last-child{border-right:0;}
    .gc-combo-garage-stats-v28 strong{display:block;color:var(--text);font-size:clamp(1.65rem,2.85vw,2.55rem);line-height:.92;letter-spacing:-.055em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums;}
    .gc-combo-garage-stats-v28 small{color:var(--muted);line-height:1.35;}
    .gc-combo-table-section-v28 .gc-section-head{margin:0;padding:clamp(22px,2.4vw,32px) clamp(22px,2.6vw,34px) 16px;border-bottom:1px solid rgba(255,255,255,.08);}
    .gc-combo-table-wrap-v28{max-height:520px;margin:clamp(16px,2vw,22px) clamp(22px,2.6vw,34px) clamp(22px,2.6vw,34px);overflow:auto;border:1px solid rgba(255,255,255,.08);border-radius:22px;background:rgba(0,0,0,.12);}

    .gc-combo-bycar-grid-v28{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;padding:clamp(16px,2vw,22px) clamp(22px,2.6vw,34px) clamp(22px,2.6vw,34px);}
    .gc-combo-bycar-card-v28{min-width:0;display:grid;gap:10px;padding:14px;border:1px solid rgba(255,255,255,.08);border-radius:18px;background:radial-gradient(circle at 100% 0%, color-mix(in srgb,var(--accent,#9dff00) 8%,transparent), transparent 9rem),rgba(0,0,0,.12);}
    .gc-combo-bycar-card-v28 h3{margin:0;color:var(--text);font-size:1rem;line-height:1.1;text-transform:uppercase;letter-spacing:-.02em;}
    .gc-combo-bycar-card-v28 p{margin:0;color:var(--muted);font-size:.84rem;line-height:1.35;}
    .gc-combo-bycar-list-v27{display:grid;gap:6px;margin:0;padding:0;list-style:none;}
    .gc-combo-bycar-list-v27 li{display:grid;grid-template-columns:24px minmax(0,1fr) max-content;gap:8px;align-items:center;min-height:34px;padding:7px 8px;border:1px solid rgba(255,255,255,.065);border-radius:12px;background:rgba(255,255,255,.025);}
    .gc-combo-bycar-list-v27 span{color:var(--accent);font-weight:950;font-size:.78rem;font-variant-numeric:tabular-nums;}
    .gc-combo-bycar-list-v27 strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);font-size:.86rem;line-height:1;}
    .gc-combo-bycar-list-v27 em{color:var(--accent);font-style:normal;font-size:.84rem;font-weight:950;font-variant-numeric:tabular-nums;}
    .gc-combo-table-wrap-v28 td,.gc-combo-table-wrap-v28 th{white-space:nowrap;}
    .gc-combo-table-wrap-v28 td:nth-child(2),.gc-combo-table-wrap-v28 td:nth-child(3){white-space:normal;min-width:180px;}
    .gc-driver-link{font-weight:950;color:var(--text);}.gc-driver-link:hover{color:var(--accent);}
    @media(min-width:981px){.gc-combo-summary-v28{margin-top:clamp(112px,10vw,168px);}}
    @media(max-width:980px){.gc-combo-hero-v28,.gc-combo-garage-head-v28{grid-template-columns:1fr;}.gc-combo-summary-v28{margin-top:0;}.gc-combo-car-tags-v28{justify-content:flex-start;}.gc-combo-garage-stats-v28{grid-template-columns:repeat(2,minmax(0,1fr));}.gc-combo-garage-stats-v28 article:nth-child(2){border-right:0;}.gc-combo-garage-stats-v28 article:nth-child(1),.gc-combo-garage-stats-v28 article:nth-child(2){border-bottom:1px solid var(--line);}}
    @media(max-width:640px){.gc-combo-detail-v28{padding-inline:0;}.gc-combo-actions-v28 .gc-btn,.gc-combo-actions-v28 .gc-chip{width:100%;justify-content:center;}.gc-combo-garage-stats-v28{grid-template-columns:1fr;}.gc-combo-garage-stats-v28 article{border-right:0;border-bottom:1px solid var(--line);}.gc-combo-garage-stats-v28 article:last-child{border-bottom:0;}.gc-combo-table-section-v28 .gc-section-head,.gc-combo-table-wrap-v28{margin-inline:16px;}.gc-combo-table-section-v28 .gc-section-head{padding-inline:16px;}.gc-combo-table-wrap-v28{max-height:none;}}
  </style>

  <script is:inline src="/js/gc-track-image.js"></script>
  <script is:inline>
    (() => {
      const SERVER_JOIN_URLS = {
        main: 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153',
        weekly: 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153',
        gt4: 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=5.39.68.161'
      };

      const escapeHtml = (value) => String(value ?? '-').replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
      const fmtSpeed = (value) => Number.isFinite(Number(value)) && Number(value) > 0 ? `${Math.round(Number(value))} km/h` : '--';
      const fmtNumber = (value) => Math.max(0, Math.round(Number(value) || 0)).toLocaleString('es-ES');
      const toMs = (value) => {
        if (typeof value === 'number' && Number.isFinite(value)) return value;
        if (!value) return 0;
        const raw = String(value).trim();
        const n = Number(raw);
        if (Number.isFinite(n)) return n;
        const m = raw.match(/^(\d+):([0-5]?\d)(?:[\.,](\d{1,3}))?$/);
        if (!m) return 0;
        return Number(m[1]) * 60000 + Number(m[2]) * 1000 + Number(String(m[3] || '0').padEnd(3, '0'));
      };
      const lapText = (ms) => {
        const value = Number(ms);
        if (!Number.isFinite(value) || value <= 0) return '--';
        const minutes = Math.floor(value / 60000);
        const seconds = Math.floor((value % 60000) / 1000);
        const millis = Math.floor(value % 1000);
        return `${minutes}:${String(seconds).padStart(2,'0')}.${String(millis).padStart(3,'0')}`;
      };
      const fmtDate = (value) => {
        if (value === undefined || value === null || value === '') return '--';
        let ms = 0;
        if (typeof value === 'number') ms = value > 20000000000 ? value : value * 1000;
        else {
          const raw = String(value).trim();
          if (/^\d+$/.test(raw)) {
            const n = Number(raw);
            ms = n > 20000000000 ? n : n * 1000;
          } else {
            ms = Date.parse(raw) || Date.parse(raw.replace(' ', 'T')) || 0;
          }
        }
        if (!Number.isFinite(ms) || ms <= 0) return '--';
        return new Date(ms).toLocaleString('es-ES', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
      };
      const norm = (value) => String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
      const compact = (value) => norm(value).replace(/_/g, '');
      const first = (obj, paths, fallback = '') => {
        for (const path of paths) {
          const parts = String(path).split('.').filter(Boolean);
          let cur = obj;
          for (const part of parts) cur = cur == null ? undefined : cur[part];
          if (cur !== undefined && cur !== null && cur !== '') return cur;
        }
        return fallback;
      };
      const arr = (value) => Array.isArray(value) ? value : [];
      const cleanEntity = (value, fallback = '') => {
        if (value === undefined || value === null) return fallback;
        if (typeof value === 'string' || typeof value === 'number') return String(value).trim() || fallback;
        return cleanEntity(value.displayName ?? value.visibleName ?? value.cleanName ?? value.uiName ?? value.name ?? value.Name ?? value.code, fallback);
      };
      const carName = (row) => cleanEntity(row?.carName ?? row?.car?.displayName ?? row?.car?.name ?? row?.car ?? row?.model, '-');
      const driverName = (row) => cleanEntity(row?.driverName ?? row?.playerName ?? row?.driver?.displayName ?? row?.driver?.name ?? row?.name, '-');
      const lapTime = (row) => cleanEntity(row?.lapTime ?? row?.lapTimeFormatted ?? row?.bestLapTime ?? row?.time, lapText(row?.lapTimeMs ?? row?.bestLapMs));
      const rowTimeMs = (row) => toMs(row?.lapTimeMs ?? row?.bestLapMs ?? row?.timeMs ?? row?.lapTime);
      const dateValue = (row) => row?.timestampIso ?? row?.lastSeenAt ?? row?.lastActivityAt ?? row?.updatedAt ?? row?.timestamp ?? row?.date;
      const els = {
        title: document.getElementById('comboTitle'), subtitle: document.getElementById('comboSubtitle'), key: document.getElementById('comboKey'), status: document.getElementById('comboStatus'), laps: document.getElementById('comboLaps'), drivers: document.getElementById('comboDrivers'), cars: document.getElementById('comboCars'), quickBest: document.getElementById('comboQuickBest'), quickBestMeta: document.getElementById('comboQuickBestMeta'), carsTitle: document.getElementById('comboCarsTitle'), carsSub: document.getElementById('comboCarsSub'), carTags: document.getElementById('comboCarTags'), best: document.getElementById('metricBest'), bestDriver: document.getElementById('metricBestDriver'), speed: document.getElementById('metricSpeed'), top10: document.getElementById('metricTop10'), recent: document.getElementById('metricRecent'), leaderboard: document.getElementById('leaderboardRows'), recentRows: document.getElementById('recentRows'), leaderboardCount: document.getElementById('comboLeaderboardCount'), recentCount: document.getElementById('comboRecentCount'), trackFigure: document.getElementById('comboTrackFigure'), trackImage: document.getElementById('comboTrackImage'), join: document.getElementById('comboJoinServer'), byCarTop5: document.getElementById('comboByCarTop5'), byCarCount: document.getElementById('comboByCarCount')
      };

      function pathComboId() {
        const raw = window.location.pathname.split('/').filter(Boolean)[1] || '';
        try { return decodeURIComponent(raw); } catch { return raw; }
      }
      function sourceFromComboId(comboId) {
        const prefix = String(comboId || '').split(':')[0]?.toLowerCase();
        if (prefix === 'gt4') return 'gt4';
        if (prefix === 'main' || prefix === 'weekly') return 'main';
        return '';
      }
      function sourceParam(comboId = '') {
        const raw = new URLSearchParams(window.location.search).get('source') || sourceFromComboId(comboId);
        const source = String(raw).trim().toLowerCase();
        return ['main','weekly','gt4'].includes(source) ? source : '';
      }
      function comboDetailApiUrl(comboId) {
        const url = new URL(`/api/gc/combos/${encodeURIComponent(comboId)}`, window.location.origin);
        const source = sourceParam(comboId);
        if (source) url.searchParams.set('source', source === 'weekly' ? 'main' : source);
        url.searchParams.set('_', String(Date.now()));
        return url.pathname + url.search;
      }
      function listApiUrl(comboId) {
        const url = new URL('/api/gc/combos', window.location.origin);
        url.searchParams.set('source', sourceParam(comboId) || 'all');
        url.searchParams.set('limit', '1000');
        url.searchParams.set('sort', 'recent');
        url.searchParams.set('_', String(Date.now()));
        return url.pathname + url.search;
      }
      async function fetchJson(url) {
        const response = await fetch(url, { credentials:'same-origin', cache:'no-store', headers:{ Accept:'application/json' } });
        const data = await response.json().catch(() => null);
        if (!response.ok || !data) throw new Error(data?.message || `HTTP ${response.status}`);
        return data;
      }
      function comboAliases(item) {
        return [item?.comboId, item?.id, item?.canonicalComboId, item?.canonicalKey, item?.key, item?.url ? String(item.url).split('/').pop() : '', item?.mainVariant?.comboId, item?.mainVariant?.variantKey, ...arr(item?.memberComboIds), ...arr(item?.comboIds), ...arr(item?.variants).flatMap((v) => [v.comboId, v.variantKey, ...arr(v.comboIds)])].filter(Boolean).map(String);
      }
      function logicalMatch(item, requestedId) {
        const wanted = String(requestedId || '').trim();
        const wantedDecoded = (() => { try { return decodeURIComponent(wanted); } catch { return wanted; } })();
        const wantedNorm = norm(wantedDecoded);
        const wantedCompact = compact(wantedDecoded);
        const aliases = comboAliases(item);
        return aliases.some((id) => id === wantedDecoded || decodeURIComponentSafe(id) === wantedDecoded || norm(id) === wantedNorm || compact(id) === wantedCompact);
      }
      function decodeURIComponentSafe(value) { try { return decodeURIComponent(String(value)); } catch { return String(value); } }
      async function fetchCombo(comboId) {
        try {
          const data = await fetchJson(comboDetailApiUrl(comboId));
          if (data?.ok && data?.item) return { item: data.item, source: data.source || 'detail' };
        } catch (error) {
          console.warn('[GC combo detail v26] primary failed, trying list fallback', error);
        }
        const list = await fetchJson(listApiUrl(comboId));
        const items = arr(list?.items || list?.data?.items);
        const item = items.find((entry) => logicalMatch(entry, comboId));
        if (!item) throw new Error('Combo no encontrado en listado lógico.');
        console.info('[GC combo detail runtime v29] matched logical combo', { requested: comboId, matched: item.comboId || item.id, source: item.sourceKey || item.source });
        return { item, source: 'list-fallback-v26' };
      }
      function applyJoinUrl(source) {
        const key = String(source || '').toLowerCase() === 'gt4' ? 'gt4' : 'main';
        if (els.join) els.join.href = SERVER_JOIN_URLS[key];
      }
      async function renderTrackImage(trackName) {
        if (!els.trackImage || !els.trackFigure) return;
        const clean = cleanEntity(trackName, 'Circuito');
        els.trackFigure.hidden = false;
        els.trackImage.alt = clean;
        els.trackImage.dataset.trackName = clean;
        els.trackImage.dataset.gcTrackName = clean;
        try {
          await window.GCTrackImages?.load?.();
          const match = window.GCTrackImages?.bestAsset?.(clean);
          const src = match?.url || window.GCTrackImages?.placeholderUrl?.(clean) || '';
          if (src) els.trackImage.src = src;
          els.trackImage.dataset.gcTrackImageSource = match ? 'fuzzy' : 'placeholder';
          if (match) els.trackImage.dataset.gcTrackImageFile = match.file || '';
        } catch {
          els.trackImage.src = window.GCTrackImages?.placeholderUrl?.(clean) || '';
        }
      }
      function normalizeItem(raw) {
        const item = raw || {};
        const summary = item.summary || {};
        let leaderboard = arr(item.leaderboard).length ? arr(item.leaderboard) : arr(summary.leaderboard).length ? arr(summary.leaderboard) : arr(item.leaderboardTop);
        let recentLaps = arr(item.recentLaps).length ? arr(item.recentLaps) : arr(summary.recentLaps);
        const best = summary.bestLap || item.bestLap || leaderboard[0] || item.latestLap || {};
        if (!leaderboard.length && best && (best.lapTime || best.lapTimeMs || best.bestLapMs)) leaderboard = [{ ...best, position: 1 }];
        if (!recentLaps.length && item.latestLap) recentLaps = [item.latestLap];
        if (!recentLaps.length && summary.latestLap) recentLaps = [summary.latestLap];
        const cars = arr(item.cars).length ? arr(item.cars) : arr(item.publicComboCars).length ? arr(item.publicComboCars) : arr(summary.cars);
        const track = cleanEntity(first(item, ['track.displayName','track.name','trackName','displayTrackName','canonicalTrackName'], ''), cleanEntity(first(summary, ['track.displayName','track.name','trackName'], ''), 'Circuito'));
        const totalLaps = Number(summary.totalLaps ?? item.totalLaps ?? item.laps ?? recentLaps.length ?? 0) || 0;
        const driversCount = Number(summary.driversCount ?? item.driversCount ?? leaderboard.length ?? 0) || 0;
        const maxSpeed = Number(summary.maxSpeedKmh ?? item.maxSpeedKmh ?? Math.max(0, ...[...leaderboard, ...recentLaps].map((row) => Number(row?.maxSpeedKmh || 0)))) || 0;
        const byCarTop5 = arr(item.byCarTop5).length ? arr(item.byCarTop5) : buildByCarTop5FromRows([...leaderboard, ...recentLaps]);
        return { item, summary, leaderboard, recentLaps, byCarTop5, best, cars, track, totalLaps, driversCount, maxSpeed };
      }
      function renderDriver(row) {
        const id = row?.playerId || row?.driverId || row?.profilePlayerId;
        const name = escapeHtml(driverName(row));
        return id ? `<a class="gc-driver-link" href="/pilotos/${encodeURIComponent(String(id))}">${name}</a>` : name;
      }
      function lapStatus(row) {
        return row?.valid === false || row?.isValid === false ? '<span class="gc-chip gc-chip--danger">No válida</span>' : '<span class="gc-chip gc-chip--accent">Válida</span>';
      }

      function safeDelta(row, index = 0) {
        const raw = row?.delta;
        if (raw === undefined || raw === null || raw === '' || String(raw).toLowerCase().includes('null') || String(raw).toLowerCase().includes('nan')) {
          return index === 0 ? '+0.000' : '--';
        }
        return String(raw);
      }
      function renderCarTags(cars) {
        if (!cars.length) return '<span class="gc-combo-car-tag">Sin coches</span>';
        return cars.map((car) => `<span class="gc-combo-car-tag">${escapeHtml(cleanEntity(car, '-'))}</span>`).join('');
      }
      function top10Average(rows) {
        const times = rows.map(rowTimeMs).filter((value) => value > 0).sort((a,b) => a-b).slice(0,10);
        if (!times.length) return '--';
        return lapText(Math.round(times.reduce((s,v) => s + v, 0) / times.length));
      }

      function buildByCarTop5FromRows(rows) {
        // GC_COMBO_DETAIL_BY_CAR_V29_CLIENT
        // Usa piloto+coche. No parte del leaderboard global, porque ahí Neo solo saldría
        // con su mejor coche y desaparecería de BMW/Vectra aunque tenga tiempos.
        const groups = new Map();
        for (const row of arr(rows)) {
          const time = rowTimeMs(row);
          if (!Number.isFinite(time) || time <= 0) continue;
          const car = carName(row) || 'Coche';
          const key = norm(car) || 'unknown_car';
          const driver = driverName(row) || 'Piloto';
          const driverKey = String(row?.playerId || row?.driverId || row?.steamGuid || norm(driver));
          if (!groups.has(key)) groups.set(key, { key, carName: car, bestByDriver: new Map(), totalLaps: 0, totalValidLaps: 0 });
          const group = groups.get(key);
          group.totalLaps += 1;
          if (!(row?.valid === false || row?.isValid === false)) group.totalValidLaps += 1;
          const current = group.bestByDriver.get(driverKey);
          if (!current || time < rowTimeMs(current)) group.bestByDriver.set(driverKey, row);
        }
        return [...groups.values()].map((group) => {
          const rows = [...group.bestByDriver.values()].sort((a, b) => rowTimeMs(a) - rowTimeMs(b));
          return { key: group.key, carName: group.carName, totalDrivers: rows.length, totalLaps: group.totalLaps, totalValidLaps: group.totalValidLaps, rows: rows.slice(0, 5).map((row, index) => ({ ...row, position: index + 1 })) };
        }).filter((group) => group.rows.length).sort((a, b) => rowTimeMs(a.rows[0]) - rowTimeMs(b.rows[0]) || a.carName.localeCompare(b.carName));
      }
      function renderByCarTop5(groups) {
        if (!els.byCarTop5) return;
        const list = arr(groups).filter((group) => arr(group.rows).length);
        if (els.byCarCount) els.byCarCount.textContent = `${list.length} coches`;
        if (!list.length) {
          els.byCarTop5.innerHTML = '<article class="gc-combo-bycar-card-v28"><h3>Sin datos por coche</h3><p>No hay vueltas válidas suficientes para crear el top por coche.</p></article>';
          return;
        }
        els.byCarTop5.innerHTML = list.map((group) => `
          <article class="gc-combo-bycar-card-v28">
            <h3>${escapeHtml(group.carName || 'Coche')}</h3>
            <p>${escapeHtml(group.totalDrivers || arr(group.rows).length)} pilotos · ${escapeHtml(group.totalLaps || group.totalValidLaps || arr(group.rows).length)} vueltas con tiempo</p>
            <ol class="gc-combo-bycar-list-v27">
              ${arr(group.rows).slice(0, 5).map((row, index) => `<li><span>${index + 1}</span><strong>${renderDriver(row)}</strong><em>${escapeHtml(lapTime(row))}</em></li>`).join('')}
            </ol>
          </article>`).join('');
      }
      async function load() {
        const comboId = pathComboId();
        try {
          const { item, source } = await fetchCombo(comboId);
          const n = normalizeItem(item);
          const effectiveSource = String(item.sourceKey || item.source || sourceParam(comboId) || '').toLowerCase();
          applyJoinUrl(effectiveSource);
          const fastestDriver = driverName(n.best);
          const fastestCar = carName(n.best);
          const fastestTime = lapTime(n.best);
          els.title.textContent = n.track;
          els.subtitle.textContent = `${n.cars.length || Number(n.summary.usedCarsCount || n.summary.carsCount || 0)} coches - ${n.totalLaps} vueltas - mejor referencia: ${fastestDriver || 'sin piloto'}${fastestCar ? ` - ${fastestCar}` : ''} - ${fastestTime}`;
          els.key.textContent = item.comboId ? `Combo ${item.comboId}` : comboId;
          els.status.textContent = source === 'list-fallback-v26' ? 'Activo' : 'Activo';
          els.quickBest.textContent = `${fastestDriver || 'Sin piloto'} - ${fastestTime}`;
          els.quickBestMeta.textContent = fastestCar || 'Coche sin identificar';
          els.laps.textContent = fmtNumber(n.totalLaps);
          els.drivers.textContent = fmtNumber(n.driversCount);
          els.cars.textContent = fmtNumber(n.cars.length || Number(n.summary.usedCarsCount || n.summary.carsCount || 0));
          els.carsTitle.textContent = `${n.cars.length || Number(n.summary.usedCarsCount || 0)} ${(n.cars.length || Number(n.summary.usedCarsCount || 0)) === 1 ? 'coche permitido' : 'coches permitidos'}`;
          els.carsSub.innerHTML = `<span class="gc-combo-package-note-v28"><span>Mejor referencia</span><strong>${escapeHtml(fastestDriver || 'Sin piloto')}${fastestCar ? ` · ${escapeHtml(fastestCar)}` : ''} · ${escapeHtml(fastestTime)}</strong></span>`;
          els.carTags.innerHTML = renderCarTags(n.cars);
          renderByCarTop5(n.byCarTop5);
          els.best.textContent = fastestTime;
          els.bestDriver.textContent = fastestDriver || 'Sin piloto';
          els.speed.textContent = fmtSpeed(n.maxSpeed);
          els.top10.textContent = n.summary.best10Average || top10Average(n.leaderboard);
          els.recent.textContent = fmtDate(n.summary.lastSeenAt || n.summary.lastActivityAt || n.summary.latestLapAt || item.lastSeenAt || item.lastActivityAt || n.recentLaps[0]?.timestampIso);
          await renderTrackImage(n.track);
          els.leaderboardCount.textContent = `${n.leaderboard.length} pilotos`;
          els.recentCount.textContent = `${n.recentLaps.length} vueltas`;
          els.leaderboard.innerHTML = n.leaderboard.map((row, index) => `<tr><td>${escapeHtml(row.position ?? index + 1)}</td><td>${renderDriver(row)}</td><td>${escapeHtml(carName(row))}</td><td><strong>${escapeHtml(lapTime(row))}</strong></td><td>${escapeHtml(safeDelta(row, index))}</td><td>${escapeHtml(fmtSpeed(row.maxSpeedKmh))}</td><td>${escapeHtml(row.cuts || 0)}</td><td>${escapeHtml(fmtDate(dateValue(row)))}</td></tr>`).join('') || '<tr><td colspan="8">Sin leaderboard para este combo.</td></tr>';
          els.recentRows.innerHTML = n.recentLaps.map((row) => `<tr><td>${renderDriver(row)}</td><td>${escapeHtml(carName(row))}</td><td><strong>${escapeHtml(lapTime(row))}</strong></td><td>${lapStatus(row)}</td><td>${escapeHtml(fmtSpeed(row.maxSpeedKmh))}</td><td>${escapeHtml(row.cuts || 0)}</td><td>${escapeHtml(fmtDate(dateValue(row)))}</td></tr>`).join('') || '<tr><td colspan="7">Sin vueltas recientes.</td></tr>';
          document.documentElement.dataset.gcComboDetailRuntime = 'v29-bycar-pilot-car';
          console.info('[GC combo detail runtime v29] loaded', { comboId, source, effectiveSource, item: item.comboId || item.id });
        } catch (error) {
          els.title.textContent = 'Combo no disponible';
          els.subtitle.textContent = 'No se pudo cargar la ficha del combo. Vuelve a intentarlo en unos segundos.';
          els.status.textContent = 'Error';
          els.leaderboardCount.textContent = 'Error';
          els.recentCount.textContent = 'Error';
          els.leaderboard.innerHTML = '<tr><td colspan="8">No se pudo cargar el combo.</td></tr>';
          els.recentRows.innerHTML = '<tr><td colspan="7">No se pudo cargar actividad reciente.</td></tr>';
          console.warn('[GC combo detail runtime v29] Error', error);
        }
      }
      load();
    })();
  </script>
</AppLayout>
