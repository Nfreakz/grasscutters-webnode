            'first_lap_at',
            'oldestLapDate',
            'oldestLapAt',
            'serverFirstLapDate',
            'serverFirstLapAt'
          ]) ||
          findDeepDateServerV5(summaryPayload, [
            'firstLapDate',
            'firstLapAt',
            'first_lap_date',
            'first_lap_at',
            'oldestLapDate',
            'oldestLapAt',
            'serverFirstLapDate',
            'serverFirstLapAt'
          ]) ||
          findDeepDateServerV5(raceInfo, [
            'firstLapDate',
            'firstLapAt',
            'first_lap_date',
            'first_lap_at',
            'oldestLapDate',
            'oldestLapAt',
            'serverFirstLapDate',
            'serverFirstLapAt'
          ]);

        setText('[data-home2-server-state]', 'Online');
        setServerMetric('[data-home2-server-total-drivers]', totalServerDrivers);
        setServerMetric('[data-home2-server-total-laps]', totalServerLaps);
        setServerMetric('[data-home2-server-hotlaps]', totalHotlaps);
        setText('[data-home2-last-lap-card]', lastLap ? formatAgo(lastLap) : '--');

        if (firstLapDate) {
