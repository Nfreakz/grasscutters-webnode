        setText('[data-home2-live-connections]', value);
        return active;
      };


      const findDeepNumericServerV5 = (obj, keys, depth = 0) => {
        if (!obj || typeof obj !== 'object' || depth > 4) return null;
        for (const key of keys) {
          const value = obj[key];
          const numeric = numericValue(value);
          if (numeric !== null) return numeric;
        }
        for (const value of Object.values(obj)) {
          if (value && typeof value === 'object' && !Array.isArray(value)) {
            const found = findDeepNumericServerV5(value, keys, depth + 1);
            if (found !== null) return found;
          }
        }
        return null;
      };

      const findDeepDateServerV5 = (obj, keys, depth = 0) => {
        if (!obj || typeof obj !== 'object' || depth > 4) return null;
        for (const key of keys) {
          const date = parseDateValue(obj[key]);
          if (date) return date;
        }
        for (const value of Object.values(obj)) {
          if (value && typeof value === 'object' && !Array.isArray(value)) {
            const found = findDeepDateServerV5(value, keys, depth + 1);
            if (found) return found;
          }
        }
        return null;
      };

      const totalServerLapsFromPayloadServerV5 = (payload) => {
        if (!payload) return null;

        const direct = findDeepNumeric(payload, [
          'totalServerLaps',
          'serverTotalLaps',
          'serverLaps',
          'totalRegisteredLaps',
          'registeredLaps',
          'totalLapsAll',
          'allLaps',
          'lapsTotal',
          'totalLapCount',
          'lapCount',
          'totalRows',
          'rowsTotal'
        ]);

        if (direct !== null) return Math.max(0, Math.round(direct));

        const valid = findDeepNumeric(payload, ['validLaps', 'valid_laps', 'totalValidLaps']);
        const invalid = findDeepNumeric(payload, ['invalidLaps', 'invalid_laps', 'totalInvalidLaps']);
        if (valid !== null && invalid !== null) return Math.max(0, Math.round(valid + invalid));

        return null;
      };

      const findDeepNumeric = (obj, keys, depth = 0) => {
        if (!obj || typeof obj !== 'object' || depth > 5) return null;

        for (const key of keys) {
          const value = obj[key];
          const numeric = numericValue(value);
          if (numeric !== null) return numeric;
          if (Array.isArray(value)) return value.length;
        }

        for (const value of Object.values(obj)) {
          if (value && typeof value === 'object') {
            const found = findDeepNumericServerV5(value, keys, depth + 1);
            if (found !== null) return found;
          }
        }

        return null;
      };

      const findDeepDate = (obj, keys, depth = 0) => {
        if (!obj || typeof obj !== 'object' || depth > 5) return null;

        for (const key of keys) {
          const date = parseDateValue(obj[key]);
          if (date) return date;
        }

        for (const value of Object.values(obj)) {
          if (value && typeof value === 'object' && !Array.isArray(value)) {
            const found = findDeepDateServerV5(value, keys, depth + 1);
            if (found) return found;
          }
        }

        return null;
      };

      const serverNumber = (payload, keys) => findDeepNumericServerV5(payload, keys);

      const totalServerLapsFromPayload = (payload) => {
        if (!payload) return null;

        const direct = serverNumber(payload, [
          'totalServerLaps',
          'serverTotalLaps',
          'serverLaps',
          'totalRegisteredLaps',
          'registeredLaps',
          'totalLapsAll',
          'allLaps',
          'lapsTotal',
          'totalLapCount',
          'totalLaps',
          'lapCount',
          'totalRows',
          'rowsTotal',
          'count'
        ]);

        if (direct !== null) return Math.max(0, Math.round(direct));

        const valid = serverNumber(payload, ['validLaps', 'valid_laps', 'totalValidLaps', 'serverValidLaps', 'validLapCount']);
        const invalid = serverNumber(payload, ['invalidLaps', 'invalid_laps', 'totalInvalidLaps', 'serverInvalidLaps', 'invalidLapCount']);
        if (valid !== null && invalid !== null) return Math.max(0, Math.round(valid + invalid));

        return null;
      };

      const validServerLapsFromPayload = (payload) => {
        if (!payload) return null;
        const value = serverNumber(payload, [
          'validLaps',
          'valid_laps',
          'totalValidLaps',
          'serverValidLaps',
          'validLapCount',
          'validRows',
          'valid'
        ]);
        return value !== null ? Math.max(0, Math.round(value)) : null;
      };

      const totalServerDriversFromPayload = (payload) => {
        if (!payload) return null;
        const value = serverNumber(payload, [
          'totalServerDrivers',
          'serverTotalDrivers',
