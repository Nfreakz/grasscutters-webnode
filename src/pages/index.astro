        ]);

        if (total !== null) return total;

        const valid = serverMetricFromPayload(payload, ['validLaps', 'valid_laps', 'totalValidLaps', 'validLapsCount', 'validLapCount']);
        const invalid = serverMetricFromPayload(payload, ['invalidLaps', 'invalid_laps', 'totalInvalidLaps', 'invalidLapsCount', 'invalidLapCount']);
        if (valid !== null && invalid !== null) return valid + invalid;

