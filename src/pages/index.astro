          doc.querySelector('[data-championship-title]');

        const title = titleNode ? titleNode.textContent.trim() : 'Campeonato ACSM';
        const events = textNumberNear(bodyText, ['Eventos', 'Rondas', 'Carreras']);
        const entrants = textNumberNear(bodyText, ['Pilotos inscritos', 'Inscritos', 'Participantes', 'Drivers']);
        const classes = textNumberNear(bodyText, ['Clases', 'Categorías', 'Categories']);
        const nextNode =
          doc.querySelector('[data-next-event]') ||
          doc.querySelector('.next-event') ||
          doc.querySelector('.gc-champ-next') ||
          Array.from(doc.querySelectorAll('h2,h3,strong')).find((node) => /próximo|proximo|next|evento/i.test(node.textContent || ''));

        setText('[data-home2-champ-name]', title || 'Campeonato ACSM');
        setText('[data-home2-champ-events]', events || '--');
        setText('[data-home2-champ-upcoming]', bodyText.match(/próxim/i) ? 'Sí' : '--');
        setText('[data-home2-champ-entrants]', entrants || '--');
        setText('[data-home2-champ-classes]', classes || '--');
        setText('[data-home2-champ-next]', nextNode ? nextNode.textContent.trim().slice(0, 80) : 'Ver campeonato activo');
        setText('[data-home2-champ-next-meta]', 'Datos desde /campeonato');

        return true;
      };

      const escapeChampionshipText = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char]));

      const championshipRankTone = (position) => {
        const numeric = Number(position);
        if (numeric === 1) return 'gold';
        if (numeric === 2) return 'silver';
        if (numeric === 3) return 'bronze';
        return '';
      };

      const renderChampionshipRankBadge = (position) => {
        const numeric = Number(position);
        const safePosition = Number.isFinite(numeric) ? numeric : 0;
        if (safePosition === 1) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--gold gc-home2-ranking-medal" aria-label="1º">🥇</span>';
        if (safePosition === 2) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--silver gc-home2-ranking-medal" aria-label="2º">🥈</span>';
        if (safePosition === 3) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--bronze gc-home2-ranking-medal" aria-label="3º">🥉</span>';
        return `<span class="gc-home2-rank-badge gc-home2-rank-badge--plain gc-home2-ranking-medal">${escapeChampionshipText(position)}</span>`;
      };

      const renderChampionshipStandings = (standings = []) => {
        const host = $('[data-home2-champ-drivers]');
        if (!host) return;

        const list = Array.isArray(standings) ? standings : [];
        if (!list.length) {
          host.innerHTML = '<div><strong>Sin clasificación visible</strong><small>ACSM</small></div>';
          return;
        }

        host.innerHTML = list.slice(0, 8).map((driver, index) => {
          const position = firstValue(driver, ['position', 'pos', 'rank']) || index + 1;
          const name = firstValue(driver, ['name', 'driverName', 'displayName', 'steamName', 'Name']) || `Piloto ${index + 1}`;
          const points = firstValue(driver, ['points', 'totalPoints', 'score']);
          const meta = points !== '' ? `${points} pts` : '0 pts';

          const tone = championshipRankTone(position);
          const rowClass = tone ? ` gc-home2-champ-standing-row--podium gc-home2-champ-standing-row--${tone}` : ' gc-home2-champ-standing-row--plain';
          const avatar = escapeChampionshipText(pilotAvatarUrl(driver));
