          return `<div class="gc-home2-champ-standing-row${rowClass}"><span class="gc-home2-champ-standing-pos">${renderChampionshipRankBadge(position)}</span><div class="gc-home2-champ-standing-meta"><strong>${escapeChampionshipText(displayName)}</strong><small>${escapeChampionshipText(meta || 'Clasificación')}</small></div><img class="gc-home2-champ-standing-avatar" src="${avatar}" alt="" width="30" height="30" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/pilot-avatar-default.png';" /></div>`;
        }).join('');
      };

      const renderChampionship = async () => {
        const payload =
          await fetchJson('/api/community/acsr-championship') ||
          await fetchJson('/api/community/acsr-championship?refresh=1') ||
          await fetchJson('/api/acsm/championship') ||
          await fetchJson('/api/campeonato');

        const box = $('[data-home2-championship]');
        if (!box || !payload || payload.ok === false || !payload.championship) {
          renderChampionshipStandings([]);
          return;
        }

        const championship = payload.championship;
        const next = championship.nextEvent || null;
        const events = Array.isArray(championship.events) ? championship.events : [];
        const standings = Array.isArray(championship.standings) ? championship.standings : [];
        const drivers = Array.isArray(championship.registeredDrivers) ? championship.registeredDrivers : [];
        const stats = championship.stats || {};

        setText('[data-home2-champ-name]', championship.name || 'Campeonato ACSM');
        setText('[data-home2-champ-events]', stats.events ?? events.length ?? '--');
        setText('[data-home2-champ-completed]', stats.completedEvents ?? '--');
        setText('[data-home2-champ-classes]', stats.classes ?? '--');
        setText('[data-home2-champ-entrants]', stats.entrants ?? drivers.length ?? standings.length ?? '--');

        if (next) {
          const track = firstValue(next, ['track', 'trackName']);
          const carSummary = firstValue(next, ['carSummary']);
          const scheduledAt = firstValue(next, ['scheduledAt', 'date', 'Date', 'start', 'startTime']);
          setText('[data-home2-champ-next]', next.name || `Ronda ${next.index || ''}`.trim() || 'Próxima ronda');
          setText('[data-home2-champ-date]', formatChampDate(scheduledAt));
          setText('[data-home2-champ-next-meta]', [track, carSummary].filter(Boolean).join(' · ') || 'Próxima sesión');

          const champTrackImage = $('[data-home2-champ-track-image]');
          if (champTrackImage && track) {
            // GC_TRACK_ASSETS_SINGLE_SOURCE_V19_CHAMP_IMAGE
            const candidates = trackImageCandidates('photo', track);
            if (candidates.length) {
              champTrackImage.dataset.fallbacks = candidates.slice(1).join('|');
              champTrackImage.dataset.fallbackIndex = '0';
              champTrackImage.onerror = function () {
                const list = (this.dataset.fallbacks || '').split('|').filter(Boolean);
                const i = Number(this.dataset.fallbackIndex || 0);
                if (list[i]) {
                  this.dataset.fallbackIndex = String(i + 1);
                  this.src = list[i];
                }
              };
              champTrackImage.src = candidates[0];
            }
          }
        } else {
          setText('[data-home2-champ-next]', 'Calendario activo');
          setText('[data-home2-champ-date]', 'Fecha por confirmar');
          setText('[data-home2-champ-next-meta]', 'Ver próximas sesiones');
        }

        renderChampionshipStandings(standings);
      };

      const init = async () => {
        const now = new Date();
        setText('[data-home2-updated]', `ACTUALIZADO ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`);

        const diagnostics = await fetchJson('/api/gc/diagnostics') || await fetchJson('/api/status') || await fetchJson('/api/stats/overview');
        const combosPayload = await fetchJson('/api/gc/combos?limit=1&sort=recent') || await fetchJson('/api/combos/stats?limit=1&sort=recent') || await fetchJson('/api/combos?limit=1&sort=recent');
        const recentPayload = await fetchJson('/api/gc/recent-laps?limit=20&sort=recent&valid=all') || await fetchJson('/api/laps?limit=20&sort=recent&valid=all') || await fetchJson('/api/hotlaps?limit=20');
        const leaderboardPayload =
          await fetchJson('/api/gc/leaderboard?scope=activeCombo&limit=25') ||
          await fetchJson('/api/gc/leaderboard?scope=currentCombo&limit=25') ||
          await fetchJson('/api/gc/leaderboard?scope=global&valid=all&group=all&limit=200') ||
          await fetchJson('/api/gc/recent-laps?limit=200&sort=recent&valid=all') ||
          await fetchJson('/api/hotlaps?limit=200');

        const comboStandoutsPayload =
          await fetchJson('/api/gc/recent-laps?limit=3000&sort=recent&valid=all') ||
          await fetchJson('/api/gc/leaderboard?scope=activeCombo&valid=all&group=all&limit=3000') ||
          await fetchJson('/api/gc/leaderboard?scope=currentCombo&valid=all&group=all&limit=3000') ||
          await fetchJson('/api/gc/leaderboard?scope=global&valid=all&group=all&limit=3000') ||
          await fetchJson('/api/laps?limit=3000&sort=recent&valid=all') ||
          await fetchJson('/api/hotlaps?limit=3000&sort=recent&valid=all');

        const raceData = diagnostics && (diagnostics.raceData || diagnostics.stats || diagnostics);
        if (raceData) {
          const totalLaps = firstValue(raceData, ['lapsCount', 'validLapsCount', 'totalLaps', 'hotlaps']);
          const drivers = firstValue(raceData, ['driversCount', 'pilotsCount', 'totalDrivers', 'pilots']);
          const active = diagnostics && (diagnostics.health === 'ok' || diagnostics.ok);
          setText('[data-home2-live]', active ? 'LIVE' : 'STATUS');
          setText('[data-home2-server-state]', active ? 'Online' : 'Revisar');
          if (drivers) setText('[data-home2-drivers]', drivers);
          if (totalLaps) setText('[data-home2-laps]', totalLaps);
        }

        const combo = getArray(combosPayload)[0] || combosPayload?.activeCombo || combosPayload?.combo || {};
        const rawTrackName = firstValue(combo, ['canonicalTrackName', 'trackName', 'track', 'circuitName', 'name']) || 'Actualizando';
        const trackHelper = window.GCHomeTrackResolver || null;
        const track = trackHelper?.displayName ? trackHelper.displayName(rawTrackName) : rawTrackName;
        const trackAssetName = trackHelper?.assetName ? trackHelper.assetName(rawTrackName) : rawTrackName;
        const cars = firstValue(combo, ['publicComboCars', 'carNames', 'cars', 'mainVariantAllCars']);
        const carList = Array.isArray(cars) ? cars.map((car) => typeof car === 'string' ? car : firstValue(car, ['name', 'carName', 'displayName'])).filter(Boolean) : String(cars || '').split(',').map((s) => s.trim()).filter(Boolean);
        const totalComboLaps = firstValue(combo, ['totalLaps', 'validLaps', 'lapsCount', 'summary.totalLaps']);
        const comboDrivers = firstValue(combo, ['driversCount', 'pilotsCount', 'summary.driversCount']);
        const bestDriver = firstValue(combo, ['bestDriverName', 'bestPilotName', 'leaderboard.0.driverName', 'best.driverName']) || '--';
        const bestCar = firstValue(combo, ['bestCarName', 'best.carName', 'leaderboard.0.carName']) || carList[0] || '--';
        const bestTime = formatLap(firstValue(combo, ['bestLapTimeFormatted', 'bestLapFormatted', 'bestLapTime', 'bestLap', 'best.time', 'leaderboard.0.lapTime'])) || '--';

        setText('[data-home2-track]', track);
        setText('[data-home2-now-title]', track);
        const inferredCountry = inferTrackCountry(track, combo) || '--';
        const inferredCountryCode =
          countryCodeFromValue(inferredCountry) ||
          countryCodeFromValue(track) ||
          countryCodeFromValue(rawTrackName) ||
          '';
        setCountryBadge(inferredCountryCode || inferredCountry, inferredCountry);
        setText('[data-home2-now-country]', inferredCountryCode || inferredCountry);
        // GC_HOME_TRACK_RESOLVER_V2_DISTANCE
        const rawTrackDistance = firstValue(combo, [
          'trackDistanceKm',
          'distanceKm',
          'track.distanceKm',
          'track.lengthKm',
          'lengthKm',
          'trackLengthKm',
          'trackLength',
          'track.distance',
          'distance'
        ]);
        const matchedTrackAsset = findRegisteredTrackAsset(rawTrackName, trackAssetName, track);
        const directDistance = formatTrackDistanceLocal(trackHelper?.formatDistance ? trackHelper.formatDistance(rawTrackDistance) : rawTrackDistance);
        const registryDistance = formatTrackDistanceLocal(matchedTrackAsset?.distance || matchedTrackAsset?.distanceKm || '');
        const fallbackDistance = formatTrackDistanceLocal(trackHelper?.distance ? (trackHelper.distance(rawTrackName) || trackHelper.distance(trackAssetName) || trackHelper.distance(track)) : '');
        setText('[data-home2-now-distance]', directDistance || registryDistance || fallbackDistance || '--');
        setText('[data-home2-cars]', carList.slice(0, 3).join(' / ') || 'Sin coches publicados');
        setText('[data-home2-now-cars]', String(carList.length || '--'));
        setText('[data-home2-best-driver]', bestDriver);
        setText('[data-home2-reference-driver]', bestDriver);
        setText('[data-home2-best-car]', bestCar);
        setText('[data-home2-reference-car]', bestCar);
        setText('[data-home2-best-time]', bestTime);
        setText('[data-home2-reference-time]', bestTime);
        if (totalComboLaps) setText('[data-home2-laps]', totalComboLaps);
        if (comboDrivers) setText('[data-home2-drivers]', comboDrivers);

        setText('[data-home2-server-active-cars]', String(carList.length || '--'));
        setText('[data-home2-server-best-time]', bestTime || '--');

        const bestAvatar = pilotAvatarUrl(combo.best || combo.leaderboard?.[0] || combo);
        $$('[data-home2-best-avatar], [data-home2-reference-avatar]').forEach((img) => img.src = bestAvatar);

        await setTrackImage(trackAssetName || track);
        await setTrackMap(
          rawTrackName,
          trackAssetName,
          track,
          firstValue(combo, ['canonicalTrackName', 'trackName', 'track', 'circuitName', 'track.slug', 'track.name'])
        );

        const champTrackImageFallback = $('[data-home2-champ-track-image]');
        const heroTrackImage = $('[data-home2-track-image]');
        if (champTrackImageFallback && heroTrackImage && champTrackImageFallback.src.includes('gc-home2-track-fallback')) {
          champTrackImageFallback.src = heroTrackImage.currentSrc || heroTrackImage.src;
        }
        renderRows('[data-home2-recent-laps]', getArray(recentPayload));
        await updateReliableServerPanel(getArray(recentPayload), combo, raceData || {});

        const comboDetailLeaderboardRows = await fetchComboDetailLeaderboard(combo);
        const activeComboRankingRows = comboDetailLeaderboardRows.length
          ? comboDetailLeaderboardRows
          : comboRankingRowsFromCombo(combo, trackAssetName || rawTrackName || track, carList);
        const renderedComboRankingRows = renderComboRanking(activeComboRankingRows, trackAssetName || rawTrackName || track, carList, { preserveOnEmpty: true });
        if (!renderedComboRankingRows.length) {
          console.warn('[GC Home] Top Combo no se ha sobrescrito: faltan filas del combo activo', {
            track: trackAssetName || rawTrackName || track,
            cars: carList,
            comboRows: activeComboRankingRows.length
          });
        }


        renderRaceStandoutsV1([
          ...getArray(comboStandoutsPayload),
          ...getArray(leaderboardPayload),
          ...getArray(combo.laps),
          ...getArray(combo.bestLaps),
          ...getArray(combo.leaderboard),
          ...getArray(recentPayload)
        ], trackAssetName || rawTrackName || track, carList);

        await Promise.all([
          renderChampionship(),
          renderArchive(track, carList)
        ]);
      };

      init();
    })();
  </script>
</MarketingLayout>
