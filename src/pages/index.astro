  <script>
    (() => {
      const srBody = document.querySelector<HTMLElement>('[data-home2-sr-ratings]');
      const gsrBody = document.querySelector<HTMLElement>('[data-home2-gsr-ratings]');
      if (!srBody && !gsrBody) return;

      const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      } as Record<string, string>)[char] ?? char);

      const toNumber = (value: unknown): number | null => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : null;
      };

      const classKey = (value: unknown) => String(value || 'unknown')
        .trim()
        .toLowerCase()
        .replace('+', 'plus')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'unknown';

      const readRatingValue = (obj: any, keys: string[] = []): any => {
        for (const key of keys) {
          const parts = String(key).split('.').filter(Boolean);
          let current = obj;
          for (const part of parts) current = current?.[part];
          if (current !== undefined && current !== null && current !== '') return current;
        }
        return '';
      };

      /* GC_HOME_RATINGS_CUSTOM_AVATARS_V1 */
      const ratingPilotId = (row: any): string => {
        const direct = readRatingValue(row, [
          'profilePlayerId', 'profile.playerId', 'strackerPlayerId', 'pilotId',
          'playerId', 'driverId', 'rawPlayerId', 'steamGuid', 'steamGUID',
          'steamId', 'steamID', 'steamId64', 'guid', 'GUID',
          'player.id', 'player.guid', 'driver.id', 'driver.guid', 'pilot.id'
        ]);
        if (direct !== undefined && direct !== null && direct !== '') return String(direct);

        const driverKey = String(readRatingValue(row, ['driverKey', 'driver_key', 'identityKey']) || '');
        const keyed = driverKey.match(/^(?:player|pilot|driver|steam|guid):(.+)$/i);
        return keyed?.[1] ? keyed[1] : '';
      };

      const ratingPilotAvatarUrl = (row: any): string => {
        const direct = readRatingValue(row, [
          'customAvatarUrl', 'custom_avatar_url', 'profileAvatarUrl', 'profile_avatar_url',
          'avatarUrl', 'avatar_url', 'avatarPath', 'avatar_path', 'pilotAvatarUrl',
          'pilot_avatar_url', 'imageUrl', 'image',
          'profile.avatarUrl', 'profile.avatar_url', 'profile.avatar',
          'driver.avatarUrl', 'driver.avatar_url', 'driver.imageUrl', 'driver.avatar',
          'player.avatarUrl', 'player.avatar_url', 'player.imageUrl', 'player.avatar',
          'pilot.avatarUrl', 'pilot.avatar_url', 'pilot.imageUrl', 'pilot.avatar'
        ]);
        if (direct && String(direct) !== '/images/pilot-avatar-default.png') return String(direct);

        const id = ratingPilotId(row);
        if (id) return `/api/pilot-avatar/${encodeURIComponent(id)}`;
        return '/images/pilot-avatar-default.png';
      };

      const formatDriverName = (value: unknown) => String(value || 'Piloto').toUpperCase();

      const formatDelta = (value: unknown, digits = 1): string => {
        const numeric = toNumber(value);
        if (numeric === null) return '--';
        const formatted = digits === 0 ? String(Math.round(numeric)) : numeric.toFixed(digits);
        return `${numeric > 0 ? '+' : ''}${formatted}`;
      };

      const deltaClass = (value: unknown): string => {
        const numeric = toNumber(value);
        if (numeric === null || numeric === 0) return 'gc-home2-rating-delta is-neutral';
        return numeric > 0 ? 'gc-home2-rating-delta is-positive' : 'gc-home2-rating-delta is-negative';
      };

      const rankTone = (position: unknown): string => {
        const numeric = Number(position);
        if (numeric === 1) return 'gold';
        if (numeric === 2) return 'silver';
        if (numeric === 3) return 'bronze';
        return '';
      };

      const renderRankBadge = (position: unknown): string => {
        const numeric = Number(position);
        const safePosition = Number.isFinite(numeric) ? numeric : 0;
        if (safePosition === 1) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--gold gc-home2-ranking-medal" aria-label="1º">🥇</span>';
        if (safePosition === 2) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--silver gc-home2-ranking-medal" aria-label="2º">🥈</span>';
        if (safePosition === 3) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--bronze gc-home2-ranking-medal" aria-label="3º">🥉</span>';
        return `<span class="gc-home2-rank-badge gc-home2-rank-badge--plain gc-home2-ranking-medal">${escapeHtml(position)}</span>`;
      };

      const ratingBadge = (type: unknown, label: unknown, score: unknown): string => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const safeLabel = String(label || '--');
        const scoreText = score === undefined || score === null || score === '' ? '' : `<small>${escapeHtml(score)}</small>`;
        return `
          <span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${classKey(safeLabel)} gc-rating-badge--compact" aria-label="${safeType.toUpperCase()} ${escapeHtml(safeLabel)} ${escapeHtml(score || '')}">
            <strong>${escapeHtml(safeLabel)}</strong>
            ${scoreText}
          </span>`;
      };

      const driverLink = (row: any): string => {
        const name = formatDriverName(row?.driver || row?.name || 'Piloto');
        const playerId = ratingPilotId(row);
        const avatar = escapeHtml(ratingPilotAvatarUrl(row));
        const main = playerId
          ? `<a href="/pilotos/${encodeURIComponent(String(playerId))}">${escapeHtml(name)}</a>`
          : `<strong>${escapeHtml(name)}</strong>`;
        return `<div class="gc-home2-rating-driver-cell"><div class="gc-home2-rating-driver">${main}<small>${playerId ? 'Perfil público' : 'Piloto GC'}</small></div><img class="gc-home2-rating-driver-avatar" src="${avatar}" alt="" width="30" height="30" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/pilot-avatar-default.png';" /></div>`;
      };

      const renderRows = (target: HTMLElement | null, rows: any[], type: string) => {
        if (!target) return;
        const list = Array.isArray(rows) ? rows.slice(0, 6) : [];
        if (!list.length) {
          target.innerHTML = `<tr><td colspan="4">Sin datos de ${type.toUpperCase()}.</td></tr>`;
          return;
        }

        target.innerHTML = list.map((row: any, index: number) => {
          const isSr = type === 'sr';
          const score = isSr ? toNumber(row.sr) : toNumber(row.gsr);
          const scoreText = score === null ? '--' : (isSr ? score.toFixed(1) : String(Math.round(score)));
          const label = isSr ? row.srClass : row.gsrClass;
          const deltaDigits = isSr ? 1 : 0;

          const position = row.position ?? index + 1;
          const tone = rankTone(position);
          const rowClass = ` class="gc-home2-rating-row${tone ? ` gc-home2-rating-row--podium gc-home2-rating-row--${tone}` : ' gc-home2-rating-row--plain'}"`;

          return `
            <tr${rowClass}>
              <td>${renderRankBadge(position)}</td>
              <td>${driverLink(row)}</td>
              <td>${ratingBadge(type, label || '--', scoreText)}</td>
              <td><span class="${deltaClass(row.lastDelta)}">${escapeHtml(formatDelta(row.lastDelta, deltaDigits))}</span></td>
            </tr>`;
        }).join('');
      };

      async function loadHomeRatings() {
        try {
          const response = await fetch('/api/gc/ratings/championship', { headers: { Accept: 'application/json' } });
          const data = await response.json();
          if (!data?.ok) throw new Error(data?.message || 'Ratings no disponibles.');
          renderRows(srBody, data.leaderboard?.sr || [], 'sr');
          renderRows(gsrBody, data.leaderboard?.gsr || [], 'gsr');
        } catch (error) {
          if (srBody) srBody.innerHTML = '<tr><td colspan="4">No se pudo cargar SR.</td></tr>';
          if (gsrBody) gsrBody.innerHTML = '<tr><td colspan="4">No se pudo cargar GSR.</td></tr>';
          console.warn('[GC Home] No se pudieron cargar ratings', error);
        }
      }

      window.setTimeout(loadHomeRatings, 1500);
    })();
  </script>
  <script>
    /* GC_HOME_BOOTSTRAP_PACK_2_FRONTEND_SINGLE_FETCH_START */
    (() => {
      const PACK = 'bootstrap-2.5-acsm-session-end-fallback';
      const root = document.querySelector('[data-gc-home2]');
      if (!root) return;

      if ((window as any).__GC_HOME_BOOTSTRAP_FRONTEND_V2__) {
        console.warn(`[GC Home ${PACK}] loader duplicado ignorado`);
        return;
      }
      (window as any).__GC_HOME_BOOTSTRAP_FRONTEND_V2__ = true;

      const REFRESH_MS = 60000;
      const HERO_ROTATE_MS = 5000;
      const DEFAULT_AVATAR = '/images/pilot-avatar-default.png';
      const FALLBACK_TRACK = '/ui/home2/gc-home2-track-fallback.svg';
      let running = false;
      let runSeq = 0;
      let refreshTimer = 0;
      let heroRotateTimer = 0;
      const heroState: { payload: any; index: number } = { payload: null, index: 0 };
      const lastGood: { bootstrap: any; championships: Record<string, any>; live: Record<string, any> } = { bootstrap: null, championships: {}, live: {} };

      const q = (selector: string, scope: any = root): any => scope?.querySelector?.(selector) || null;
      const qa = (selector: string, scope: any = root): any[] => Array.from(scope?.querySelectorAll?.(selector) || []);
      const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[char] ?? char);
      const setText = (selector: string, value: unknown, scope: any = root) => { const el = q(selector, scope); if (el) el.textContent = value ?? '--'; };
      const normalize = (value: unknown) => String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
      const first = (obj: any, paths: string[] = [], fallback: any = ''): any => {
        for (const path of paths) {
          const parts = String(path).split('.').filter(Boolean);
          let current = obj;
          for (const part of parts) {
            if (current === undefined || current === null) break;
            current = current?.[part];
          }
          if (current !== undefined && current !== null && current !== '') return current;
        }
        return fallback;
      };
      const getArray = (payload: any): any[] => {
        if (Array.isArray(payload)) return payload;
        if (Array.isArray(payload?.items)) return payload.items;
        if (Array.isArray(payload?.rows)) return payload.rows;
        if (Array.isArray(payload?.laps)) return payload.laps;
        if (Array.isArray(payload?.data)) return payload.data;
        if (Array.isArray(payload?.leaderboard)) return payload.leaderboard;
        if (Array.isArray(payload?.activeCombo?.leaderboard)) return payload.activeCombo.leaderboard;
        return [];
      };
      const parseTimeMs = (value: any): number | null => {
        if (value === undefined || value === null || value === '') return null;
        if (typeof value === 'number' && Number.isFinite(value)) return value;
        const raw = String(value).trim();
        const direct = Number(raw);
        if (Number.isFinite(direct)) return direct;
        const parts = raw.split(':').map((part) => part.trim());
        if (parts.length >= 2) {
          const minutes = Number(parts[0]);
          const seconds = Number(parts[1].replace(',', '.'));
          if (Number.isFinite(minutes) && Number.isFinite(seconds)) return Math.round((minutes * 60 + seconds) * 1000);
        }
        return null;
      };
      const rowTimeMs = (row: any): number | null => parseTimeMs(first(row, ['lapTimeMs', 'lap_time_ms', 'LapTime', 'lapTime', 'timeMs', 'bestLapMs', 'best_lap_ms', 'time', 'lapTimeFormatted', 'lapTimeText']));
      const formatTime = (input: any): string => {
        const ms = typeof input === 'object' && input ? rowTimeMs(input) : parseTimeMs(input);
        if (ms === null || !Number.isFinite(ms)) return typeof input === 'string' && input.trim() ? input : '--';
        const total = Math.max(0, Math.round(ms));
        const minutes = Math.floor(total / 60000);
        const seconds = Math.floor((total % 60000) / 1000);
        const millis = total % 1000;
        return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
      };
      const timestampMs = (row: any): number => {
        const raw = first(row, ['timestampMs', 'timestamp_ms', 'timestamp', 'Timestamp', 'date', 'dateIso', 'timestampIso', 'Date', 'lastSeenTimestamp', 'last_lap_unix']);
        if (typeof raw === 'number' && Number.isFinite(raw)) return raw > 20000000000 ? raw : raw * 1000;
        if (raw) {
          const n = Number(raw);
          if (Number.isFinite(n)) return n > 20000000000 ? n : n * 1000;
          const parsed = Date.parse(String(raw));
          if (Number.isFinite(parsed)) return parsed;
        }
        return 0;
      };
      const ago = (row: any): string => {
        const ms = timestampMs(row);
        if (!ms) return '--';
        const diff = Math.max(0, Date.now() - ms);
        const minutes = Math.floor(diff / 60000);
        if (minutes < 1) return 'ahora';
        if (minutes < 60) return `${minutes} min`;
        const hours = Math.floor(minutes / 60);
        if (hours < 48) return `${hours} h`;
        return `${Math.floor(hours / 24)} d`;
      };
      const driverName = (row: any) => first(row, ['driver.displayName', 'driver.publicName', 'driver.visibleName', 'driverName', 'driver_name', 'playerName', 'player_name', 'DriverName', 'Name', 'name', 'pilotName', 'driver.name'], '--');
      const cleanPublicName = (value: unknown, source: unknown = ''): string => {
        let out = String(value ?? '').trim();
        if (!out || out === '--') return out || '--';
        if (String(source).toLowerCase() === 'gt4') out = out.replace(/^00[\s_-]+/i, '').trim();
        return out.replace(/\s+/g, ' ');
      };
      const carName = (row: any) => cleanPublicName(first(row, ['car.publicName', 'car.visibleName', 'car.alias', 'car.displayName', 'car.uiName', 'carName', 'car_name', 'carDisplay', 'car_display', 'carCode', 'car_code', 'Car', 'car.name', 'vehicleName'], '--'), sourceKey(row));
      const trackName = (row: any) => cleanPublicName(first(row, ['track.publicName', 'track.visibleName', 'track.alias', 'track.displayName', 'track.uiName', 'trackName', 'track_name', 'trackDisplay', 'track_display', 'trackCode', 'track_code', 'Track', 'track.name'], '--'), sourceKey(row));
      const sourceKey = (row: any, fallback: unknown = '') => String(first(row, ['sourceKey', 'source_key', 'source', 'serverKey'], fallback) || fallback || '').toLowerCase();
      const avatarNameCache = new Map<string, string>();
      const rememberAvatar = (row: any, src: any): string => {
        const key = normalize(driverName(row));
        if (!key || !src || src === DEFAULT_AVATAR) return src || DEFAULT_AVATAR;
        avatarNameCache.set(key, src);
        return src;
      };
      const avatar = (row: any): string => {
        const direct = first(row, [
          'avatarUrl', 'avatar_url', 'pilotAvatarUrl', 'imageUrl', 'image',
          'driver.avatarUrl', 'driver.avatar_url', 'driver.imageUrl',
          'player.avatarUrl', 'player.avatar_url', 'pilot.avatarUrl', 'avatar'
        ], '');
        if (direct && String(direct) !== DEFAULT_AVATAR) return rememberAvatar(row, direct);

        // Important: rows from server 2 / GT4 can carry a technical id that does not
        // match the public profile avatar. Prefer a previously resolved avatar for
        // the same public driver name before generating a new /api/pilot-avatar/:id URL.
        const cached = avatarNameCache.get(normalize(driverName(row)));
        if (cached && cached !== DEFAULT_AVATAR) return cached;

        const id = first(row, [
          'profilePlayerId', 'strackerPlayerId', 'playerId', 'driverId', 'rawPlayerId',
          'steamGuid', 'steamGUID', 'steamId', 'steamID', 'steamId64', 'guid', 'GUID', 'DriverGuid',
          'driver.playerId', 'driver.id', 'driver.guid', 'driver.steamGuid',
          'player.id', 'player.guid', 'player.steamGuid', 'pilotId', 'id'
        ], '');
        if (id !== undefined && id !== null && id !== '') return rememberAvatar(row, `/api/pilot-avatar/${encodeURIComponent(String(id))}`);
        return DEFAULT_AVATAR;
      };
      const isValid = (row: any): boolean => {
        const value = first(row, ['valid', 'Valid', 'isValid', 'is_valid'], true);
        return !(value === false || value === 0 || value === '0' || String(value).toLowerCase() === 'false');
      };
      const bestPerDriver = (rows: any[]): any[] => {
        const pool = Array.isArray(rows) ? rows.filter((row: any) => Number.isFinite(rowTimeMs(row))) : [];
        const valid = pool.filter(isValid);
        const source = valid.length ? valid : pool;
        const map = new Map<string, any>();
        for (const row of source) {
          const key = normalize(driverName(row)) || String(first(row, ['playerId', 'driverId', 'rawPlayerId'], Math.random()));
          const current = map.get(key);
          if (!current || (rowTimeMs(row) ?? Number.POSITIVE_INFINITY) < (rowTimeMs(current) ?? Number.POSITIVE_INFINITY)) map.set(key, row);
        }
        return [...map.values()].sort((a: any, b: any) => (rowTimeMs(a) ?? Number.POSITIVE_INFINITY) - (rowTimeMs(b) ?? Number.POSITIVE_INFINITY));
      };
      const activeCombo = (sourcePayload: any) => sourcePayload?.activeCombo || null;
      const sourceLeaderboard = (sourcePayload: any): any[] => getArray(sourcePayload?.leaderboard || sourcePayload?.activeCombo?.leaderboard || []);
      const rankBadge = (index: number) => index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : String(index + 1);
      const pulseCell = (selector: string, label: unknown, value: unknown, meta: unknown) => {
        const dd = q(selector);
        if (!dd) return;
        const wrap = dd.closest('div');
        const dt = wrap?.querySelector?.('dt');
        const small = wrap?.querySelector?.('small');
        if (dt && label) dt.textContent = label;
        dd.textContent = value ?? '--';
        if (small) small.textContent = meta ?? '';
      };
      const compactTrackLabel = (value: unknown) => String(value || '--').replace(/\s+/g, ' ').trim().toUpperCase();
      const splitCarSummary = (value: unknown): string[] => String(value || '').split(/[,+/]/).map((item) => cleanPublicName(item.trim())).filter(Boolean);
      const comboRankBadgeClass = (index: number) => index >= 3 ? 'gc-home2-rank-badge gc-home2-rank-badge--plain' : 'gc-home2-rank-badge';

      async function fetchJson(url: string, timeoutMs = 15000): Promise<any> {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), timeoutMs);
        try {
          const response = await fetch(url, { headers: { Accept: 'application/json' }, signal: controller.signal });
          const data = await response.json().catch(() => null);
          if (!response.ok || !data) throw new Error(data?.message || `HTTP ${response.status}`);
          return data;
        } finally {
          window.clearTimeout(timer);
        }
      }

      /* GC_PHASE4C_ACSM_LIVE_ACTIVE_COMBO_V1 */
      const acsmLiveSourcePayload = (source: 'main' | 'gt4', snapshot: any): any | null => {
        const normalized = snapshot?.normalized;
        const session = normalized?.session || {};
        const trackInfo = normalized?.track || {};
        const trackCode = String(session.track || '').trim();
        const trackConfig = String(session.trackConfig || '').trim();
        const connected = snapshot?.connected === true;

        if (!connected || !trackCode) return null;

        const trackDisplay = cleanPublicName(trackInfo.name || trackCode, source);
        const receivedAt = snapshot.lastEventAt || normalized.receivedAt || new Date().toISOString();
        const rawTimes = Array.isArray(normalized.storedTimes) ? normalized.storedTimes : [];
        const rawSlots = Array.isArray(normalized.carSlots) ? normalized.carSlots : [];

        const rows = rawTimes
          .map((row: any) => ({
            ...row,
            sourceKey: source,
            source: source,
            driverName: row.driverName || row.name || '--',
            carName: row.carName || row.carModel || '--',
            carCode: row.carModel || row.carName || '',
            trackName: trackDisplay,
            trackCode,
            trackConfig,
            lapTimeMs: row.bestLapMs,
            bestLapMs: row.bestLapMs,
            valid: true,
            timestamp: receivedAt,
            sessionType: session.typeLabel || 'ACSM live'
          }))
          .filter((row: any) => Number.isFinite(Number(row.bestLapMs)))
          .sort((left: any, right: any) => Number(left.bestLapMs) - Number(right.bestLapMs));

        const carsByKey = new Map<string, any>();
        const rememberCar = (codeValue: unknown, nameValue: unknown) => {
          const code = String(codeValue || nameValue || '').trim();
          const name = cleanPublicName(nameValue || code, source);
          const key = normalize(code || name);
          if (!key || carsByKey.has(key)) return;
          carsByKey.set(key, {
            code,
            rawCode: code,
            name,
            displayName: name,
            publicName: name
          });
        };

        rawTimes.forEach((row: any) => rememberCar(row.carModel, row.carName || row.carModel));
        rawSlots.forEach((row: any) => rememberCar(row.carModel || row.carName, row.carName || row.carModel));
        const cars = [...carsByKey.values()];
        const driverCount = new Set(rows.map((row: any) => normalize(row.driverName)).filter(Boolean)).size;
        const totalLaps = rows.reduce((total: number, row: any) => total + (Number(row.laps) || 0), 0);
        const imageAliases = [
          trackConfig ? `${trackCode}_${trackConfig}` : '',
          trackCode,
          trackDisplay
        ].filter(Boolean);

        const activeCombo = {
          __gcAcsmLive: true,
          __gcComboAuthority: 'acsm-live',
          sourceKey: source,
          source,
          receivedAt,
          track: {
            code: trackCode,
            rawCode: trackCode,
            trackCode,
            trackConfig,
            layout: trackConfig,
            familyKey: trackConfig ? `${trackCode}_${trackConfig}` : trackCode,
            rawName: trackCode,
            name: trackDisplay,
            displayName: trackDisplay,
            publicName: trackDisplay,
            city: trackInfo.city || '',
            country: trackInfo.country || ''
          },
          trackCode,
          trackRaw: trackCode,
          trackName: trackDisplay,
          trackImage: { aliases: imageAliases },
          cars,
          carSummary: cars.map((car: any) => car.displayName).join(' / '),
          carsCount: cars.length,
          driversCount: driverCount,
          totalLaps,
          validLaps: rows.length,
          bestLap: rows[0] || null,
          latestLap: rows[0] || null,
          leaderboard: rows
        };

        return {
          ok: true,
          source: `acsm-live:${source}`,
          sourceKey: source,
          activeCombo,
          leaderboard: rows,
          diagnostics: {
            activeComboAuthority: 'acsm-live',
            liveAvailable: true,
            connected,
            trackCode,
            trackConfig,
            receivedAt,
            storedTimes: rows.length,
            cars: cars.length
          }
        };
      };

      /* GC_HOME_ACSM_SESSION_END_LEADERBOARD_FALLBACK_V1
       * ACSM puede limpiar Track/StoredTimes justo al cerrar una carrera. Ese
       * cambio de estado no invalida las vueltas que sTracker acaba de guardar.
       * Conservamos el último combo histórico cuando no existe un combo live y,
       * si ACSM todavía anuncia el mismo circuito pero ya no trae tiempos,
       * completamos el leaderboard con ese mismo combo. Un circuito live nuevo
       * nunca hereda las vueltas del anterior.
       */
      const comboTrackIdentity = (combo: any): { code: string; config: string; key: string } => {
        const trackCode = normalize(first(combo, [
          'track.trackCode', 'track.technicalCode', 'track.rawCode', 'track.code',
          'trackCode', 'trackRaw'
        ], ''));
        const trackConfig = normalize(first(combo, [
          'track.trackConfig', 'track.layout', 'track.variant', 'trackConfig', 'layout'
        ], ''));
        return {
          code: trackCode,
          config: trackConfig,
          key: trackCode ? `${trackCode}:${trackConfig}` : ''
        };
      };

      const mergeBootstrapWithAcsmLive = (bootstrap: any, live: Record<string, any>) => {
        const mergeSource = (source: 'main' | 'gt4') => {
          const historical = bootstrap?.[source] || {};
          const livePayload = live[source] || null;
          if (livePayload) {
            const liveRows = sourceLeaderboard(livePayload);
            const historicalRows = sourceLeaderboard(historical);
            const liveTrack = comboTrackIdentity(livePayload.activeCombo);
            const historicalTrack = comboTrackIdentity(historical.activeCombo);
            const sameTrack = Boolean(
              liveTrack.code &&
              historicalTrack.code &&
              liveTrack.code === historicalTrack.code &&
              (!liveTrack.config || !historicalTrack.config || liveTrack.config === historicalTrack.config)
            );

            if (!liveRows.length && historicalRows.length && sameTrack) {
              return {
                ...historical,
                ...livePayload,
                activeCombo: {
                  ...(historical.activeCombo || {}),
                  ...(livePayload.activeCombo || {}),
                  bestLap: historical.activeCombo?.bestLap || historicalRows[0] || null,
                  latestLap: historical.activeCombo?.latestLap || historicalRows[0] || null,
                  leaderboard: historicalRows
                },
                leaderboard: historicalRows,
                diagnostics: {
                  ...(historical.diagnostics || {}),
                  ...(livePayload.diagnostics || {}),
                  activeComboAuthority: 'acsm-live+completed-session',
                  sessionEndLeaderboardFallback: true,
                  fallbackTrackIdentity: liveTrack.key || liveTrack.code
                }
              };
            }

            return {
              ...historical,
              ...livePayload,
              diagnostics: {
                ...(historical.diagnostics || {}),
                ...(livePayload.diagnostics || {})
              }
            };
          }

          const historicalRows = sourceLeaderboard(historical);
          if (historical?.activeCombo && historicalRows.length) {
            return {
              ...historical,
              diagnostics: {
                ...(historical.diagnostics || {}),
                activeComboAuthority: 'completed-session',
                liveAvailable: false,
                sessionEndLeaderboardFallback: true
              }
            };
          }

          // No hay todavía ni estado live ni una sesión terminada con vueltas.
          return {
            ...historical,
            activeCombo: null,
            leaderboard: [],
            diagnostics: {
              ...(historical.diagnostics || {}),
              activeComboAuthority: 'acsm-live',
              liveAvailable: false,
              staleHistoricalComboSuppressed: true,
              sessionEndLeaderboardFallback: false
            }
          };
        };

        return {
          ...bootstrap,
          source: `${bootstrap?.source || 'home-bootstrap'}+acsm-live-authoritative`,
          main: mergeSource('main'),
          gt4: mergeSource('gt4'),
          comboAuthority: 'acsm-live'
        };
      };

      const fetchAcsmLiveSource = async (source: 'main' | 'gt4') => {
        try {
          const payload = await fetchJson(
            `/api/gc/live-test/snapshot?source=${encodeURIComponent(source)}&waitMs=2200&t=${Date.now()}`,
            6000
          );
          const normalized = acsmLiveSourcePayload(source, payload);
          if (normalized) lastGood.live[source] = normalized;
          return normalized;
        } catch (error) {
          console.warn(`[GC Home ${PACK}] ACSM live no disponible`, source, error);
          return null;
        }
      };

      const sourceUsesAcsmLive = (payload: any): boolean =>
        String(payload?.diagnostics?.activeComboAuthority || '') === 'acsm-live';

      const setImageWithFallbacks = (img: HTMLImageElement | null, candidates: string[], fallback = FALLBACK_TRACK): void => {
        if (!img) return;
        const list = [...new Set((candidates || []).filter(Boolean))];
        let index = 0;
        const apply = () => {
          const next = list[index++] || fallback;
          img.onerror = () => {
            if (index <= list.length) apply();
            else {
              img.onerror = null;
              img.src = fallback;
            }
          };
          if (img.getAttribute('src') !== next) img.src = next;
        };
        apply();
      };

      const trackImageAliasVariants = (values: unknown[]): string[] => {
        const aliases = new Set<string>();
        const addRaw = (value: unknown): void => {
          const base = normalize(String(value || '').trim());
          if (!base) return;
          aliases.add(base);
          aliases.add(base.replace(/-/g, '_'));
          aliases.add(base.replace(/_/g, '-'));
          const compact = base.replace(/[^a-z0-9]/g, '');
          if (compact) aliases.add(compact);
          const decade = base.match(/^(.*?)(?:_|-)?(\d{2})s$/);
          if (decade) {
            const prefix = decade[1].replace(/[_-]+$/g, '');
            const digits = decade[2];
            aliases.add(`${prefix}_${digits}`);
            aliases.add(`${prefix}-${digits}`);
            aliases.add(`${prefix}${digits}`.replace(/[^a-z0-9]/g, ''));
          }
          const stripped = base
            .replace(/^(ks|rt|acu|fn|mx|nrms|track|circuit|circuito|autodromo|autodrome)_+/g, '')
            .replace(/_+(circuit|circuito|track|layout|gp|spain|italy|italia)$/g, '');
          if (stripped && stripped !== base) addRaw(stripped);
        };
        values.forEach(addRaw);
        return [...aliases].filter(Boolean);
      };

      // GC_PHASE4G_EXACT_TRACK_ASSET_RESOLVER_V1
      const trackImageCandidatesFromCombo = (combo: any): string[] => {
        const sourceRaw = normalize(first(combo, ['sourceKey', 'source'], 'main'));
        const source = sourceRaw === 'gt4' ? 'gt4' : 'weekly';
        const trackCode = String(first(combo, ['track.trackCode', 'track.rawCode', 'track.code', 'trackCode', 'trackRaw'], '') || '').trim();
        const trackConfig = String(first(combo, ['track.trackConfig', 'track.layout', 'trackConfig', 'layout'], '') || '').trim();
        const trackNameValue = String(first(combo, ['track.publicName', 'track.displayName', 'track.name', 'trackName'], '') || '').trim();
        if (!trackCode && !trackNameValue) return [];
        const params = new URLSearchParams();
        params.set('kind', 'photo');
        params.set('strict', '1');
        params.set('source', source);
        if (trackCode) params.set('trackCode', trackCode);
        if (trackConfig) params.set('trackConfig', trackConfig);
        if (trackNameValue) params.set('name', trackNameValue);
        return [`/api/gc/track-assets/file?${params.toString()}`];
      };

      const setHeroBackgroundFromMain = (payload: any) => {
        const img = q('.gc-home2-hero__bg[data-home2-track-image]') as HTMLImageElement | null;
        if (!img) return;
        img.dataset.gcHomeStaticManaged = '1';
        const combo = activeCombo(payload?.main) || activeCombo(payload?.gt4) || null;
        if (!combo) {
          setImageWithFallbacks(img, [], FALLBACK_TRACK);
          return;
        }
        setImageWithFallbacks(img, trackImageCandidatesFromCombo(combo), FALLBACK_TRACK);
      };

      const renderRanking = (selector: string, rows: any[] = [], preserve = true): any[] => {
        const host = q(selector);
        if (!host) return [];
        const list = bestPerDriver(rows).slice(0, 8);
        if (!list.length) {
          if (!preserve || !host.dataset.gcHydrated) {
            host.innerHTML = `<div class="gc-home2-combo-rank gc-home2-combo-rank--loading"><span class="gc-home2-rank-badge">--</span><div><strong>--</strong><small>Sin vueltas para el combo activo</small></div><img class="gc-home2-combo-rank__avatar" src="${DEFAULT_AVATAR}" alt="" width="24" height="24" loading="lazy" decoding="async" /><em>--</em></div>`;
          }
          return [];
        }
        host.dataset.gcHydrated = '1';
        host.innerHTML = list.map((row: any, index: number) => `
          <div class="gc-home2-combo-rank">
            <span class="${comboRankBadgeClass(index)}">${rankBadge(index)}</span>
            <div><strong>${esc(driverName(row))}</strong><small>${esc(carName(row))}</small></div>
            <img class="gc-home2-combo-rank__avatar" src="${esc(avatar(row))}" alt="" width="24" height="24" loading="lazy" decoding="async" data-gc-avatar-driver="${esc(driverName(row))}" onerror="this.onerror=null;this.src='${DEFAULT_AVATAR}';" />
            <em>${esc(formatTime(row))}</em>
          </div>`).join('');
        return list;
      };
      document.documentElement.dataset.gcHomeTopTimesRuntime = 'v37-avatar-name-cache-first';
      document.documentElement.dataset.gcHomeActiveComboPriority = 'v1';
      document.documentElement.dataset.gcHomeChampionshipLiveCombo = 'v2-acsm-live';
      document.documentElement.dataset.gcHomeComboAuthority = 'acsm-live-session-end-fallback-v1';
      document.documentElement.dataset.gcTrackAssetResolver = 'exact-v1';

      const renderRecent = (rows: any[] = []): any[] => {
        const host = q('[data-home2-recent-laps]');
        if (!host) return [];
        const seen = new Set();
        const list = (Array.isArray(rows) ? rows : [])
          .filter((row: any) => timestampMs(row) > 0)
          .filter((row: any) => {
            const key = first(row, ['lapUid', 'uid', 'id', 'lapId'], '') || `${sourceKey(row)}:${driverName(row)}:${carName(row)}:${formatTime(row)}:${timestampMs(row)}`;
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          })
          .sort((a: any, b: any) => timestampMs(b) - timestampMs(a))
          .slice(0, 8);
        if (!list.length) return [];
        host.dataset.gcHydrated = '1';
        host.innerHTML = list.map((row) => `<div class="gc-home2-table__row" role="row" data-source="${esc(sourceKey(row, 'main'))}"><span>${esc(driverName(row))}</span><span>${esc(carName(row))}</span><strong>${esc(formatTime(row))}</strong><small>${esc(ago(row))}</small></div>`).join('');
        return list;
      };

      const comboTrack = (combo: any, rows: any[] = [], source = '') => cleanPublicName(first(combo, ['track.publicName', 'track.visibleName', 'track.alias', 'track.displayName', 'track.uiName', 'track.name', 'track.code', 'trackName', 'trackCode'], trackName(rows[0] || {})), source);
      const comboCars = (combo: any, rows: any[] = [], source = '') => {
        const cars = first(combo, ['cars'], null);
        if (Array.isArray(cars)) {
          const out = cars.map((car) => typeof car === 'string' ? cleanPublicName(car, source) : cleanPublicName(first(car, ['publicName', 'visibleName', 'alias', 'displayName', 'uiName', 'name', 'carName', 'code']), source)).filter(Boolean);
          if (out.length) return out;
        }
        const summary = first(combo, ['carSummary', 'carsSummary', 'carName'], '');
        if (summary) return String(summary).split(/[,+/]/).map((item) => cleanPublicName(item.trim(), source)).filter(Boolean);
        return [...new Set(rows.map(carName).filter((v) => v && v !== '--'))];
      };
      const setHero = (sourcePayload: any, rankingRows: any[], source = 'main') => {
        const combo = activeCombo(sourcePayload) || {};
        const rows = rankingRows.length ? rankingRows : sourceLeaderboard(sourcePayload);
        const best = rows[0] || first(combo, ['bestLap'], null) || {};
        // GC_HOME_ACTIVE_COMBO_PRIORITY_V1:
        // El héroe representa el combo que está rodando ahora. El calendario del
        // campeonato solo se usa como último fallback cuando la API del combo no
        // aporta circuito o coches.
        const comboTrackName = comboTrack(combo, rows, source);
        const comboCarNames = comboCars(combo, rows, source);
        const fallbackTrack = championshipTrackForSource(source === 'gt4' ? 'gt4' : 'weekly');
        const fallbackCars = championshipCarsForSource(source === 'gt4' ? 'gt4' : 'weekly');
        const track = cleanPublicName(comboTrackName || fallbackTrack, source);
        const cars = comboCarNames.length ? comboCarNames : fallbackCars;
        const label = source === 'gt4' ? 'Servidor 2 · GT4' : 'Servidor 1 · Liga';
        const joinUrl = source === 'gt4' ? GT4_JOIN_URL : WEEKLY_JOIN_URL;
        setText('[data-home2-hero-source]', label);
        setText('[data-home2-track]', track || 'Combo activo');
        setText('[data-home2-cars]', cars.slice(0, 3).join(' / ') || carName(best));
        setText('[data-home2-best-driver]', driverName(best));
        setText('[data-home2-best-car]', carName(best));
        setText('[data-home2-best-time]', formatTime(best));
        qa('[data-home2-best-avatar]').forEach((img) => {
          img.onerror = function(){ this.onerror=null; this.src=DEFAULT_AVATAR; };
          img.src = avatar(best);
        });
        qa('.gc-home2-combo-card__cta').forEach((link) => { link.href = joinUrl; });
      };

      const heroCandidates = (payload: any) => ([
        {
          source: 'main',
          payload: payload?.main,
          rows: sourceLeaderboard(payload?.main),
          scheduled: Boolean(championshipEventForSource('weekly'))
        },
        {
          source: 'gt4',
          payload: payload?.gt4,
          rows: sourceLeaderboard(payload?.gt4),
          scheduled: Boolean(championshipEventForSource('gt4'))
        }
      ].filter((item) => item?.payload?.activeCombo || item.rows.length || item.scheduled));

      const renderHeroFromState = () => {
        const payload = heroState.payload || lastGood.bootstrap;
        const candidates = heroCandidates(payload);
        if (!candidates.length) {
          setText('[data-home2-hero-source]', 'ACSM LIVE');
          setText('[data-home2-track]', 'Servidor sin información');
          setText('[data-home2-cars]', 'Esperando el combo actual');
          setText('[data-home2-best-driver]', '--');
          setText('[data-home2-best-car]', '--');
          setText('[data-home2-best-time]', '--');
          qa('[data-home2-best-avatar]').forEach((img) => { img.src = DEFAULT_AVATAR; });
          return;
        }
        heroState.index = ((heroState.index % candidates.length) + candidates.length) % candidates.length;
        const item = candidates[heroState.index];
        setHero(item.payload, item.rows, item.source);
      };

      const startHeroRotation = () => {
        if (heroRotateTimer) window.clearInterval(heroRotateTimer);
        const candidates = heroCandidates(heroState.payload || lastGood.bootstrap);
        if (candidates.length < 2) {
          heroRotateTimer = 0;
          renderHeroFromState();
          return;
        }
        heroRotateTimer = window.setInterval(() => {
          heroState.index += 1;
          renderHeroFromState();
        }, HERO_ROTATE_MS);
      };
      const championshipEventForSource = (source: string) => {
        const key = source === 'gt4' ? 'gt4' : 'weekly';
        const payload = lastGood.championships[key];
        if (!payload) return null;
        const c = champRoot(payload);
        const events = champEvents(payload);
        return c.currentEvent || c.activeEvent || c.nextEvent || payload.currentEvent || payload.activeEvent || payload.nextEvent || events.find((event: any) => String(first(event, ['status', 'Status'], '')).toLowerCase() !== 'completed') || events[0] || null;
      };

      const championshipTrackForSource = (source: string): string => {
        const event = championshipEventForSource(source);
        return event ? first(event, ['trackName', 'track', 'trackRaw', 'name', 'Name', 'title'], '') : '';
      };

      const championshipCarsForSource = (source: string): string[] => {
        const event = championshipEventForSource(source);
        const raw = event ? first(event, ['carSummary', 'carsSummary', 'carName', 'car', 'cars'], '') : '';
        if (Array.isArray(raw)) return raw.map((car) => typeof car === 'string' ? cleanPublicName(car, source) : cleanPublicName(first(car, ['displayName', 'name', 'carName', 'code'], ''), source)).filter(Boolean);
        return splitCarSummary(raw);
      };

      const driverStatName = (item: any) => first(item, ['driverName', 'playerName', 'name', 'displayName', 'driver.displayName', 'driver.name'], '');
      const driverStatLaps = (item: any) => Number(first(item, ['laps', 'totalLaps', 'lapCount', 'count'], 0)) || 0;
      const sourceDriverStats = (combo: any): any[] => getArray(first(combo, ['driverStats', 'standouts.driverStats', 'summary.driverStats', 'drivers'], []));

      const describeSourceCombo = (payload: any, source = 'main') => {
        const combo = activeCombo(payload) || {};
        const rows = sourceLeaderboard(payload);
        const bestRows = bestPerDriver(rows);
        const best = bestRows[0] || first(combo, ['bestLap'], null) || rows[0] || {};
        const latest = first(combo, ['latestLap'], null) || [...rows].sort((a: any, b: any) => timestampMs(b) - timestampMs(a))[0] || {};
        const total = Number(first(combo, ['totalLaps', 'laps', 'lapCount', 'summary.totalLaps'], rows.length)) || rows.length || 0;
        const validFromRows = rows.filter(isValid).length;
        const valid = Math.min(total || validFromRows, Number(first(combo, ['validLaps', 'validLapCount', 'summary.validLaps'], validFromRows)) || validFromRows || 0);
        const comboTrackName = comboTrack(combo, rows, source);
        const fallbackTrack = championshipTrackForSource(source === 'gt4' ? 'gt4' : 'weekly');
        const track = compactTrackLabel(comboTrackName || fallbackTrack);
        const bestTime = formatTime(best);
        const bestDriver = driverName(best);
        const bestCar = carName(best);
        const vmax = Number(first(combo, ['maxSpeedKmh', 'summary.maxSpeedKmh'], 0)) || Math.max(0, ...rows.map((row) => Number(first(row, ['maxSpeedKmh', 'vmax', 'maxSpeed', 'speedKmh'], 0)) || 0));
        const mostActive = sourceDriverStats(combo)
          .map((item) => ({ name: driverStatName(item), laps: driverStatLaps(item) }))
          .filter((item) => item.name && item.laps > 0)
          .sort((a: any, b: any) => b.laps - a.laps)[0] || null;
        const drivers = Number(first(combo, ['driversCount', 'driverCount', 'summary.driversCount'], bestRows.length)) || bestRows.length || 0;
        const comboCarNames = comboCars(combo, rows, source);
        const fallbackCars = championshipCarsForSource(source === 'gt4' ? 'gt4' : 'weekly');
        const cars = comboCarNames.length || Number(first(combo, ['carsCount', 'usedCarsCount', 'summary.usedCarsCount'], 0)) || fallbackCars.length || 0;
        const cleanPct = total ? Math.round((valid / total) * 100) : 0;
        return { combo, rows, bestRows, best, latest, total, valid, track, bestTime, bestDriver, bestCar, vmax, mostActive, drivers, cars, cleanPct };
      };

      const pulseServerMeta = (item: any): string => {
        const best = item.bestDriver && item.bestTime !== '--' ? `P1 ${item.bestDriver} · ${item.bestTime}` : 'sin mejor vuelta';
        const active = item.mostActive ? ` · activo ${item.mostActive.name} (${item.mostActive.laps})` : '';
        const drivers = item.drivers ? ` · ${item.drivers} pilotos` : '';
        const cars = item.cars ? ` · ${item.cars} coches` : '';
        return `${item.total || 0} vueltas · ${item.valid || 0} válidas${drivers}${cars} · ${best}${active}`;
      };

      const renderPulse = (payload: any) => {
        const main = describeSourceCombo(payload?.main, 'main');
        const gt4 = describeSourceCombo(payload?.gt4, 'gt4');
        const latestRows = Array.isArray(payload?.timingSheet) ? payload.timingSheet : [];
        const latest = [...latestRows].sort((a: any, b: any) => timestampMs(b) - timestampMs(a))[0] || main.latest || gt4.latest || {};
        const latestSource = sourceKey(latest, sourceKey(main.latest, 'main')) === 'gt4' ? 'GT4' : 'Liga';
        const latestTime = formatTime(latest);
        const latestMeta = `${latestSource} · ${carName(latest)} · ${latestTime} · ${ago(latest)}`;
        const maxV = Math.max(main.vmax || 0, gt4.vmax || 0);
        const duelRows = main.bestRows.length >= 2 ? main.bestRows : gt4.bestRows;
        const duelP1 = duelRows.length >= 2 ? rowTimeMs(duelRows[0]) : null;
        const duelP2 = duelRows.length >= 2 ? rowTimeMs(duelRows[1]) : null;
        const duel = duelP1 !== null && duelP2 !== null
          ? `+${((duelP2 - duelP1) / 1000).toFixed(3)}s`
          : '--';
        const duelSource = main.bestRows.length >= 2 ? 'Liga' : 'GT4';
        const totalAll = (main.total || 0) + (gt4.total || 0);
        const validAll = (main.valid || 0) + (gt4.valid || 0);
        const cleanPct = totalAll ? Math.round((validAll / totalAll) * 100) : 0;

        pulseCell('[data-home2-standout-most-laps]', 'Liga', main.track || '--', pulseServerMeta(main));
        pulseCell('[data-home2-standout-best-average]', 'GT4', gt4.track || '--', pulseServerMeta(gt4));
        pulseCell('[data-home2-standout-cleanest]', 'Actividad', `${totalAll || 0} vueltas`, `${validAll || 0} válidas · Liga ${main.total || 0} · GT4 ${gt4.total || 0}`);
        pulseCell('[data-home2-standout-vmax]', 'Limpias', totalAll ? `${cleanPct}%` : '--', `Liga ${main.cleanPct || 0}% · GT4 ${gt4.cleanPct || 0}% · válidas ${validAll}/${totalAll || 0}`);
        pulseCell('[data-home2-standout-last-driver]', 'Última', driverName(latest), latestMeta);
        pulseCell('[data-home2-standout-duel]', 'Duelo', duel, `${duelSource} P1/P2 · Vmax ${maxV ? Math.round(maxV) + ' km/h' : '--'}`);
      };

      const champRoot = (payload: any): any => payload?.championship || payload?.data?.championship || payload?.data || payload || {};
      const arr = (...items: any[]): any[] => items.find((item) => Array.isArray(item)) || [];
      const champEvents = (payload: any): any[] => {
        const c = champRoot(payload);
        return arr(c.events, c.calendar, payload?.events, payload?.data?.events);
      };
      const champRows = (payload: any): any[] => {
        const c = champRoot(payload);
        return arr(c.standings, payload?.standings, payload?.data?.standings, c.registeredDrivers, payload?.registeredDrivers, payload?.data?.registeredDrivers);
      };
      const champName = (row: any, index: number) => first(row, ['driverName', 'name', 'displayName', 'pilotName', 'DriverName', 'user.name'], `Piloto ${index + 1}`);
      const champPts = (row: any) => first(row, ['points', 'pts', 'totalPoints', 'score'], '0');
      const champDate = (raw: unknown): string => {
        if (!raw) return 'Fecha por confirmar';
        const d = new Date(String(raw));
        if (Number.isNaN(d.getTime())) return String(raw);
        return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'numeric' }) + ', ' + d.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
      };
      const GT4_DOWNLOAD_URL = 'https://drive.google.com/drive/folders/1dAN3gxyAJKbyXV3pa93krmrkK95_PYBD';
      const GT4_SIGNUP_URL = 'http://5.39.68.161:8840/championship/bef21906-b596-4514-aebb-7235ec02bd50/sign-up/steam';
      const GT4_JOIN_URL = 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=5.39.68.161';
      const WEEKLY_SIGNUP_URL = 'http://145.239.131.153:8840/championship/ad89ce26-0206-40f2-adec-451cf221d4e6/sign-up/steam';
      const WEEKLY_JOIN_URL = 'https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153';
      const driveIconSvg = '<span class="gc-home2-drive-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M9.4 2.5h5.2l2.7 4.7-2.6 4.5H9.3L6.6 7.2l2.8-4.7Zm-2 5.9 2.6 4.5-2.6 4.6H2.2L4.8 13l2.6-4.6Zm8.2 4.5 2.6-4.5h5.2L20.8 13l2.6 4.5h-5.2l-2.6-4.6Z" fill="currentColor"></path></svg></span>';
      const championshipButton = (href: string, label: string, extraClass = '', attr = '') => `<a href="${esc(href)}" target="_blank" rel="noopener" class="gc-home2-btn gc-home2-btn--small gc-home2-championship-btn ${extraClass}" ${attr}>${label}</a>`;
      const enforceChampionshipButtons = (source: string) => {
        const block = q(`[data-home2-championship][data-home2-championship-source="${source}"]`);
        const actions = q('.gc-home2-championship-actions', block);
        if (!actions) return;
        if (source === 'gt4') {
          actions.classList.add('gc-home2-championship-actions--gt4');
          actions.innerHTML = [
            championshipButton(GT4_DOWNLOAD_URL, `${driveIconSvg}<span>Descargar</span>`, 'gc-home2-championship-btn--download', 'data-home2-champ-download'),
            championshipButton(GT4_SIGNUP_URL, 'Inscribirse al campeonato', '', 'data-home2-champ-signup'),
            championshipButton(GT4_JOIN_URL, 'Unirse al servidor', 'gc-home2-championship-btn--server', 'data-home2-champ-join')
          ].join('');
        } else if (source === 'weekly') {
          actions.classList.remove('gc-home2-championship-actions--gt4');
          actions.innerHTML = [
            championshipButton(WEEKLY_SIGNUP_URL, 'Inscribirse al campeonato', '', 'data-home2-champ-signup'),
            championshipButton(WEEKLY_JOIN_URL, 'Unirse al servidor', 'gc-home2-championship-btn--server', 'data-home2-champ-join')
          ].join('');
        }
      };

      /* GC_HOME_GT4_ACSM_TRACK_IMAGE_FIX_V1 */
      const exactTrackAssetSlug = (value: unknown): string => String(value ?? '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\.(kn5|ini|json|txt|png|jpe?g|webp|avif|svg)$/g, '')
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '');

      const championshipExactTrackCandidates = (title: unknown, event: any) => {
        const technicalValues = [
          first(event, ['trackRaw', 'trackCode', 'TrackCode', 'Track', 'trackData.rawCode', 'trackData.code', 'trackData.familyKey', 'trackData.rawName'], ''),
          first(event, ['trackName', 'TrackName'], '')
        ].filter(Boolean);

        const seeds = technicalValues.length ? technicalValues : [title].filter(Boolean);
        const aliases = [...new Set(seeds.map(exactTrackAssetSlug).filter(Boolean))];
        const extensions = ['webp', 'jpg', 'png', 'jpeg', 'avif'];
        const generated: string[] = [];

        aliases.forEach((alias) => {
          extensions.forEach((ext) => {
            generated.push(`/images/tracks/${encodeURIComponent(alias)}.${ext}`);
            generated.push(`/imagenes/tracks/${encodeURIComponent(alias)}.${ext}`);
          });
        });

        const image = event?.trackImage || event?.trackData?.image || {};
        const explicit = [
          image?.primary,
          ...(Array.isArray(image?.candidates) ? image.candidates : []),
          event?.trackAssets?.photo,
          ...(Array.isArray(event?.trackPhotoCandidates) ? event.trackPhotoCandidates : [])
        ].filter(Boolean).map(String);

        const exactExplicit = explicit.filter((url) => {
          let decoded = String(url || '');
          try { decoded = decodeURIComponent(decoded); } catch (_) {}
          const cleanUrl = decoded.split('?')[0].split('#')[0];
          const basename = cleanUrl.split('/').pop() || cleanUrl;
          const candidateSlug = exactTrackAssetSlug(basename);
          return aliases.some((alias) =>
            candidateSlug === alias ||
            candidateSlug.startsWith(`${alias}_`) ||
            candidateSlug.endsWith(`_${alias}`)
          );
        });

        return {
          aliases,
          technicalValues: technicalValues.map(String),
          candidates: [...new Set([...generated, ...exactExplicit].filter(Boolean))]
        };
      };

      const setChampionshipTrackImage = async (block: any, title: unknown, event: any, source: string) => {
        const img = q('[data-home2-champ-track-image]', block) as HTMLImageElement | null;
        if (!img) return;

        // GT4 usa primero el código técnico procedente del combo/ACSM. No se permite
        // buscar solo por "Valencia", "GP", etc., porque puede elegir otro trazado.
        if (source === 'gt4') {
          const exact = championshipExactTrackCandidates(title, event);
          if (exact.aliases.length) {
            setImageWithFallbacks(img, exact.candidates, FALLBACK_TRACK);
            img.dataset.gcHomeChampImageRuntime = 'v34-gt4-acsm-exact';
            img.dataset.gcHomeChampTrackRaw = exact.technicalValues[0] || String(title || '');
            img.dataset.gcHomeChampTrackAliases = exact.aliases.join(',');
            return;
          }
        }

        // Liga semanal conserva el resolver ya existente.
        const values = [
          title,
          first(event, ['trackName', 'trackRaw', 'trackCode', 'track', 'name', 'Name', 'title'], ''),
          first(event, ['Track', 'TrackName', 'TrackCode'], '')
        ].filter(Boolean);
        for (const value of values) {
          if ((window as any).GCHomeTrackResolver?.setTrackImage) {
            try {
              const ok = await (window as any).GCHomeTrackResolver.setTrackImage(img, value, 'photo');
              if (ok) {
                img.dataset.gcHomeChampImageRuntime = 'v34-resolver';
                return;
              }
            } catch (_) {}
          }
        }
        const candidates: string[] = [];
        values.forEach((value) => {
          candidates.push(...trackImageCandidatesFromCombo({ track: { name: value, code: value, displayName: value } }));
        });
        setImageWithFallbacks(img, candidates, FALLBACK_TRACK);
        img.dataset.gcHomeChampImageRuntime = 'v34-candidates';
      };

      const renderChampionshipFromPayload = (source: string, payload: any) => {
        enforceChampionshipButtons(source);
        const block = q(`[data-home2-championship][data-home2-championship-source="${source}"]`);
        if (!block || !payload) return { source, ok: false, reason: 'missing-block-or-payload' };
        const c = champRoot(payload);
        const events = champEvents(payload);
        const rows = champRows(payload);
        const stats = c.stats || payload.stats || payload.data?.stats || {};
        const scheduledNext = c.nextEvent || payload.nextEvent || payload.data?.nextEvent || events.find((event: any) => String(first(event, ['status', 'Status'], '')).toLowerCase() !== 'completed') || events[0] || null;

        // GC_HOME_CHAMPIONSHIP_LIVE_COMBO_V1
        const liveSourcePayload = source === 'gt4'
          ? (heroState.payload?.gt4 || lastGood.bootstrap?.gt4)
          : (heroState.payload?.main || lastGood.bootstrap?.main);
        const liveCombo = activeCombo(liveSourcePayload);
        const liveRows = sourceLeaderboard(liveSourcePayload);
        const liveSourceKey = source === 'gt4' ? 'gt4' : 'main';
        const liveTrack = liveCombo ? comboTrack(liveCombo, liveRows, liveSourceKey) : '';
        const liveCars = liveCombo ? comboCars(liveCombo, liveRows, liveSourceKey) : [];
        const liveTrackRaw = liveCombo ? first(liveCombo, [
          'track.rawCode',
          'track.code',
          'track.familyKey',
          'track.rawName',
          'track.trackCode',
          'trackRaw',
          'trackCode'
        ], liveTrack) : liveTrack;
        const liveTrackImage = liveCombo ? first(liveCombo, ['trackImage', 'track.image'], null) : null;
        const liveTrackAssets = liveCombo ? first(liveCombo, ['trackAssets', 'track.assets'], null) : null;
        const liveTrackPhotoCandidates = liveCombo ? first(liveCombo, ['trackPhotoCandidates', 'track.photoCandidates'], []) : [];
        const liveEvent = liveTrack ? {
          __gcLiveCombo: true,
          trackName: liveTrack,
          track: liveTrack,
          trackRaw: liveTrackRaw,
          trackCode: liveTrackRaw,
          trackData: liveCombo ? first(liveCombo, ['track'], null) : null,
          trackImage: liveTrackImage,
          trackAssets: liveTrackAssets,
          trackPhotoCandidates: Array.isArray(liveTrackPhotoCandidates) ? liveTrackPhotoCandidates : [],
          carSummary: liveCars.join(' / ')
        } : null;
        const next = liveEvent || scheduledNext;
        setText('[data-home2-champ-name]', first(c, ['name', 'title'], source === 'gt4' ? 'GC Toyota Supra GT4' : 'Liga GrassCutters'), block);
        setText('[data-home2-champ-events]', first(stats, ['events'], events.length || '--'), block);
        setText('[data-home2-champ-completed]', first(stats, ['completedEvents', 'completed'], events.filter((event: any) => String(first(event, ['status', 'Status'], '')).toLowerCase() === 'completed').length || '--'), block);
        setText('[data-home2-champ-entrants]', first(stats, ['entrants'], rows.length || '--'), block);
        setText('[data-home2-champ-classes]', first(stats, ['classes'], Array.isArray(c.classes) ? c.classes.length : '--'), block);
        if (next) {
          const title = first(next, ['trackName', 'track', 'trackRaw', 'trackCode', 'name', 'Name', 'title'], 'Próximo evento');
          const date = first(next, ['scheduledAt', 'date', 'Date', 'start', 'startTime'], '');
          const car = first(next, ['carSummary', 'cars', 'carName', 'car'], '');
          const isLiveCombo = Boolean(next.__gcLiveCombo);
          setText('[data-home2-champ-next]', title, block);
          setText('[data-home2-champ-date]', isLiveCombo ? 'AHORA' : champDate(date), block);
          setText('[data-home2-champ-next-meta]', [title, car].filter(Boolean).join(' · ') || (isLiveCombo ? 'Combo activo del servidor' : 'Próxima sesión'), block);
          block.dataset.gcHomeChampionshipComboSource = isLiveCombo ? 'live' : 'schedule';
          setChampionshipTrackImage(block, title, next, source);
        }
        const host = q('[data-home2-champ-drivers]', block);
        if (host && rows.length) {
          host.dataset.gcHydrated = '1';
          host.innerHTML = rows.slice(0, 8).map((row: any, index: number) => `<div class="gc-home2-champ-standing-row${index < 3 ? ` gc-home2-champ-standing-row--podium gc-home2-champ-standing-row--${['gold','silver','bronze'][index]}` : ' gc-home2-champ-standing-row--plain'}"><span class="gc-home2-champ-standing-pos">${rankBadge(index)}</span><div class="gc-home2-champ-standing-meta"><strong>${esc(champName(row, index))}</strong><small>General</small></div><span class="gc-home2-champ-standing-points"><strong>${esc(champPts(row))}</strong><small>pts</small></span><img class="gc-home2-champ-standing-avatar" src="${esc(avatar(row))}" alt="" width="30" height="30" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='${DEFAULT_AVATAR}';" /></div>`).join('');
        }
        enforceChampionshipButtons(source);
        return { source, ok: true, events: events.length, rows: rows.length };
      };
      const loadChampionship = async (source: string) => {
        try {
          const payload = await fetchJson(`/api/community/acsr-championship?source=${encodeURIComponent(source)}&home=1&t=${Date.now()}`, 12000);
          lastGood.championships[source] = payload;
          return renderChampionshipFromPayload(source, payload);
        } catch (error) {
          if (lastGood.championships[source]) return renderChampionshipFromPayload(source, lastGood.championships[source]);
          console.warn(`[GC Home ${PACK}] campeonato no disponible`, source, error);
          return { source, ok: false, reason: error instanceof Error ? error.message : String(error) };
        }
      };

      const applyBootstrap = (payload: any) => {
        const mainRows = sourceLeaderboard(payload?.main);
        const gt4Rows = sourceLeaderboard(payload?.gt4);
        const renderedMain = renderRanking('[data-home2-combo-ranking]', mainRows, !sourceUsesAcsmLive(payload?.main));
        const renderedGt4 = renderRanking('[data-home2-combo-ranking-gt4]', gt4Rows, !sourceUsesAcsmLive(payload?.gt4));
        const recentRows = renderRecent(payload?.timingSheet || []);
        setHeroBackgroundFromMain(payload);
        heroState.payload = payload;
        renderHeroFromState();
        startHeroRotation();
        renderPulse(payload);
        setText('[data-home2-updated]', `ACTUALIZADO ${new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}`);
        return { mainRows: renderedMain.length, gt4Rows: renderedGt4.length, timingRows: recentRows.length };
      };

      const refresh = async () => {
        if (running) return;
        running = true;
        const seq = ++runSeq;
        try {
          const stamp = Date.now();
          const [historicalBootstrap, liveMain, liveGt4] = await Promise.all([
            fetchJson(`/api/gc/home-bootstrap?mainLimit=8&gt4Limit=8&timingLimit=8&home=1&t=${stamp}`, 15000),
            fetchAcsmLiveSource('main'),
            fetchAcsmLiveSource('gt4')
          ]);
          if (seq !== runSeq) return;
          if (!historicalBootstrap?.ok) throw new Error(historicalBootstrap?.message || 'Home bootstrap no disponible');

          const bootstrap = mergeBootstrapWithAcsmLive(historicalBootstrap, {
            main: liveMain,
            gt4: liveGt4
          });

          lastGood.bootstrap = bootstrap;
          const rendered = applyBootstrap(bootstrap);
          const championships = await Promise.all([loadChampionship('weekly'), loadChampionship('gt4')]);
          renderHeroFromState();
          renderPulse(bootstrap);
          renderRanking(
            '[data-home2-combo-ranking]',
            sourceLeaderboard(bootstrap?.main),
            !sourceUsesAcsmLive(bootstrap?.main)
          );
          renderRanking(
            '[data-home2-combo-ranking-gt4]',
            sourceLeaderboard(bootstrap?.gt4),
            !sourceUsesAcsmLive(bootstrap?.gt4)
          );

          document.documentElement.dataset.gcHomeComboAuthority = 'acsm-live-session-end-fallback-v1';
          console.info(`[GC Home ${PACK}]`, {
            bootstrap: bootstrap.source,
            latencyMs: historicalBootstrap.latencyMs,
            comboAuthority: bootstrap.comboAuthority,
            mainLiveTrack: liveMain?.diagnostics?.trackCode || null,
            mainLiveLayout: liveMain?.diagnostics?.trackConfig || null,
            gt4LiveTrack: liveGt4?.diagnostics?.trackCode || null,
            gt4LiveLayout: liveGt4?.diagnostics?.trackConfig || null,
            ...rendered,
            championships
          });
        } catch (error) {
          console.error(`[GC Home ${PACK}] error`, error);
          if (lastGood.bootstrap) applyBootstrap(lastGood.bootstrap);
        } finally {
          running = false;
        }
      };

      (window as any).GCHomeBootstrapV2 = { refresh, enforceChampionshipButtons, renderHeroFromState };
      enforceChampionshipButtons('gt4');
      enforceChampionshipButtons('weekly');
      refresh();
      refreshTimer = window.setInterval(refresh, REFRESH_MS);
      (window as any).__GC_HOME_BOOTSTRAP_INTERVAL__ = refreshTimer;
    })();
    /* GC_HOME_BOOTSTRAP_PACK_2_FRONTEND_SINGLE_FETCH_END */

  </script>
