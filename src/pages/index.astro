          setServerMetric('[data-home2-first-lap-days]', days, ' d');
        } else {
          setText('[data-home2-first-lap-days]', '--');
        }
      };


      /* GC_HOME2_SERVER_STRIP_STANDOUTS_V1_JS */
      const driverNameFromLapV1 = (lap) =>
        firstValue(lap, ['driverName', 'pilotName', 'playerName', 'name', 'driver.displayName', 'driver.name', 'player.name', 'DriverName', 'steamName']) || 'Piloto';

      const carNameFromLapV1 = (lap) =>
        firstValue(lap, ['carName', 'carDisplayName', 'carVisibleName', 'car.name', 'car.displayName', 'vehicle', 'Car']) || '';

      const isLapInvalidV1 = (lap) => {
        const value = firstValue(lap, ['valid', 'isValid', 'Valid']);
        return value === 0 || value === false || value === '0' || value === 'false' || value === 'no';
      };

      const speedFromLapV1 = (lap) => {
        const raw = firstValue(lap, ['maxSpeedKmh', 'MaxSpeed_KMH', 'maxSpeed', 'speedKmh']);
        const value = Number(raw);
        return Number.isFinite(value) && value > 0 ? value : 0;
      };

      const uniqueLapKeyV1 = (lap, index) => [
        firstValue(lap, ['lapId', 'LapId', 'id']),
        firstValue(lap, ['playerId', 'driverId', 'driver.id', 'PlayerId']),
        driverNameFromLapV1(lap),
        carNameFromLapV1(lap),
        firstValue(lap, ['trackName', 'track.displayName', 'track.name', 'Track']),
        firstValue(lap, ['lapTimeMs', 'LapTime', 'lapMs', 'lapTime', 'bestLapTime']),
        firstValue(lap, ['timestamp', 'timestampIso', 'createdAt'])
      ].filter(Boolean).join('|') || `lap-${index}`;

      const averageV1 = (values) => values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;

      const renderRaceStandoutsV1 = (rowsInput = [], activeTrack = '', activeCars = []) => {
        const activeCarList = Array.isArray(activeCars) ? activeCars.filter(Boolean) : [];
        const comboScopedRows = getArray(rowsInput)
          .filter(Boolean)
          .filter((row) => rowTrackMatches(row, activeTrack))
          .filter((row) => rowCarMatches(row, activeCarList));

        const cleanRows = comboScopedRows
          .filter((row, index, array) => array.findIndex((candidate, candidateIndex) => uniqueLapKeyV1(candidate, candidateIndex) === uniqueLapKeyV1(row, index)) === index);

        const set = (selector, value) => setText(selector, value || '--');

        if (!cleanRows.length) {
          set('[data-home2-standout-most-laps]', '--');
          set('[data-home2-standout-best-average]', '--');
          set('[data-home2-standout-cleanest]', '--');
          set('[data-home2-standout-vmax]', '--');
          set('[data-home2-standout-last-driver]', '--');
          set('[data-home2-standout-duel]', '--');
          return;
        }

        const byDriver = new Map();

        cleanRows.forEach((lap) => {
          const name = driverNameFromLapV1(lap);
          const key = slugify(name);
          if (!key) return;

          const lapMs = rankTimeValue(lap);
          const valid = !isLapInvalidV1(lap);
          const speed = speedFromLapV1(lap);
          const date = lapDateFromRow(lap);

          if (!byDriver.has(key)) {
            byDriver.set(key, {
              name,
              laps: 0,
              valid: 0,
              invalid: 0,
              times: [],
              bestMs: Number.POSITIVE_INFINITY,
              bestLap: null,
              maxSpeed: 0,
              maxSpeedCar: '',
              lastDate: null,
              lastLap: null
            });
          }

          const item = byDriver.get(key);
          item.laps += 1;
          if (valid) item.valid += 1;
          else item.invalid += 1;

          if (valid && Number.isFinite(lapMs) && lapMs !== Number.POSITIVE_INFINITY) {
            item.times.push(lapMs);
            if (lapMs < item.bestMs) {
              item.bestMs = lapMs;
              item.bestLap = lap;
            }
          }

          if (speed > item.maxSpeed) {
            item.maxSpeed = speed;
            item.maxSpeedCar = carNameFromLapV1(lap);
          }

          if (date && (!item.lastDate || date.getTime() > item.lastDate.getTime())) {
            item.lastDate = date;
            item.lastLap = lap;
          }
        });

        const drivers = [...byDriver.values()].filter((item) => item.laps > 0);

        const mostLaps = drivers.slice().sort((a, b) => b.laps - a.laps || b.valid - a.valid)[0];

        const averageCandidates = drivers
          .map((item) => {
            const top = item.times.slice().sort((a, b) => a - b).slice(0, Math.min(5, Math.max(3, item.times.length)));
            return { ...item, avg: averageV1(top), samples: top.length };
          })
          .filter((item) => item.samples >= 3 && item.avg > 0)
          .sort((a, b) => a.avg - b.avg);

        const bestAverage = averageCandidates[0];

        const cleanest = drivers
          .filter((item) => item.laps >= 3)
          .map((item) => ({ ...item, cleanRate: item.laps ? item.valid / item.laps : 0 }))
          .sort((a, b) => b.cleanRate - a.cleanRate || b.valid - a.valid || b.laps - a.laps)[0];

        const speedKing = drivers
          .filter((item) => item.maxSpeed > 0)
          .sort((a, b) => b.maxSpeed - a.maxSpeed)[0];

        const latest = drivers
          .filter((item) => item.lastDate)
          .sort((a, b) => b.lastDate.getTime() - a.lastDate.getTime())[0];

        const bestByDriver = drivers
          .filter((item) => Number.isFinite(item.bestMs) && item.bestMs !== Number.POSITIVE_INFINITY)
          .sort((a, b) => a.bestMs - b.bestMs);

        let closest = null;
        for (let i = 0; i < bestByDriver.length - 1; i += 1) {
          const a = bestByDriver[i];
          const b = bestByDriver[i + 1];
          const gap = Math.abs(b.bestMs - a.bestMs);
          if (!closest || gap < closest.gap) closest = { a, b, gap };
        }

        if (mostLaps) {
          set('[data-home2-standout-most-laps]', mostLaps.name);
          set('[data-home2-standout-most-laps-meta]', `${mostLaps.laps} vueltas en combo · ${mostLaps.valid} válidas`);
        }

        if (bestAverage) {
          set('[data-home2-standout-best-average]', bestAverage.name);
          set('[data-home2-standout-best-average-meta]', `${formatLap(Math.round(bestAverage.avg))} media top ${bestAverage.samples}`);
        } else {
          set('[data-home2-standout-best-average]', bestByDriver[0]?.name || '--');
          set('[data-home2-standout-best-average-meta]', bestByDriver[0] ? `${formatLap(bestByDriver[0].bestMs)} mejor vuelta` : 'top 5 vueltas');
        }

        if (cleanest) {
          set('[data-home2-standout-cleanest]', cleanest.name);
          set('[data-home2-standout-cleanest-meta]', `${Math.round(cleanest.cleanRate * 100)}% válidas · ${cleanest.laps} vueltas en combo`);
        }

        if (speedKing) {
          set('[data-home2-standout-vmax]', speedKing.name);
          set('[data-home2-standout-vmax-meta]', `${Math.round(speedKing.maxSpeed)} km/h${speedKing.maxSpeedCar ? ' · ' + speedKing.maxSpeedCar : ''}`);
        }

        if (latest) {
          set('[data-home2-standout-last-driver]', latest.name);
          set('[data-home2-standout-last-driver-meta]', latest.lastDate ? `última hace ${formatAgo(latest.lastDate)}` : 'actividad reciente');
        }

        if (closest) {
          const a = closest.a.name.split(' ')[0] || closest.a.name;
          const b = closest.b.name.split(' ')[0] || closest.b.name;
          set('[data-home2-standout-duel]', `${a} / ${b}`);
          set('[data-home2-standout-duel-meta]', `gap combo ${(closest.gap / 1000).toFixed(3)} s`);
        }
      };

      const updateServerAgeFromFirstLap = async (fallbackRows = []) => {
        const { payload } = await fetchJsonFirstWithSource([
          '/api/gc/first-lap',
          '/api/gc/server-first-lap',
          '/api/gc/stats/first-lap',
          '/api/gc/recent-laps?limit=1&sort=oldest&valid=all',
          '/api/gc/recent-laps?limit=1&order=asc&valid=all',
          '/api/laps?limit=1&sort=oldest&valid=all',
          '/api/laps?limit=1&order=asc&valid=all',
          '/api/hotlaps?limit=1&sort=oldest',
          '/api/hotlaps?limit=1&order=asc',
          '/api/gc/recent-laps?limit=2000&sort=oldest&valid=all',
          '/api/gc/recent-laps?limit=2000&sort=recent&valid=all',
          '/api/laps?limit=2000&sort=recent&valid=all',
          '/api/hotlaps?limit=2000&sort=recent&valid=all'
        ]);

        const payloadRows = getArray(payload);
        const rows = payloadRows.length ? payloadRows : getArray(fallbackRows);

        const directDate =
          parseDateValue(firstValue(payload || {}, ['firstLapDate', 'firstLapAt', 'first_lap_date', 'first_lap_at', 'oldestLapDate', 'oldestLapAt', 'date', 'createdAt', 'created_at'])) ||
          parseDateValue(firstValue(payload?.stats || {}, ['firstLapDate', 'firstLapAt', 'first_lap_date', 'first_lap_at', 'oldestLapDate', 'oldestLapAt'])) ||
          parseDateValue(firstValue(payload?.summary || {}, ['firstLapDate', 'firstLapAt', 'first_lap_date', 'first_lap_at', 'oldestLapDate', 'oldestLapAt']));

        const validDates = rows
          .map((row) => lapDateFromRow(row))
          .filter(Boolean)
          .sort((a, b) => a.getTime() - b.getTime());

        const startDate = directDate || validDates[0];

        if (!startDate) {
          setText('[data-home2-first-lap]', '--');
          return;
        }

        setText('[data-home2-first-lap]', startDate.toLocaleDateString('es-ES'));
      };

      const mergeNewsItems = (...groups) => {
        const seen = new Set();
        const merged = [];

        for (const group of groups) {
          for (const item of group || []) {
            const key = String(item?.id || item?.slug || item?.href || item?.title || '').trim().toLowerCase();
            if (!key || seen.has(key)) continue;
            seen.add(key);
            merged.push(item);
          }
        }

        return merged;
      };

      const renderArchive = async (activeTrack = '', activeCars = []) => {
        const serverSeed = Array.isArray(window.__GC_HOME2_ARCHIVE__) ? window.__GC_HOME2_ARCHIVE__ : [];

        const endpoints = [
          '/api/archive/items.json?limit=100',
          '/api/archive/items.json?limit=100&status=published',
          '/api/archive/items.json?featured=1&limit=100',
          '/api/archive/items?limit=100',
          '/api/archive/items?featured=1&limit=100',
          '/api/archive',
          '/api/archivo',
          '/data/archive/items.json',
          '/data/app/motorsport-archive.json'
        ];

        let items = getArray(serverSeed);

        // En producción el Archivo público no depende de esos endpoints: /archivo usa archiveRuntime server-side.
        // Por eso home2 debe usar primero el seed SSR y solo probar endpoints si no existe seed.
        if (!items.length) {
          let payload = null;
          for (const endpoint of endpoints) {
            payload = await fetchJson(endpoint);
            items = getArray(payload);
            if (items.length) break;
          }
        }

        const wanted = [activeTrack, ...activeCars].filter(Boolean).map((value) => slugify(value));
        const activeTrackSlug = slugify(activeTrack).replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '');

        const visiblePool = items
          .filter((item) => {
            const status = String(firstValue(item, ['status', 'estado']) || 'published').toLowerCase();
            return !['draft', 'borrador', 'trash', 'deleted'].includes(status);
          })
          .map((item, index) => {
            const title = firstValue(item, ['title', 'nombre', 'name']) || '';
            const slug = firstValue(item, ['slug', 'seoSlug', 'seo_slug']) || '';
            const type = firstValue(item, ['tipo', 'type', 'category', 'categoria', 'kind']) || '';
            const normalizedType = normalizeArchiveType(type);
            const searchText = [
              title,
              slug,
              type,
              firstValue(item, ['tipoLabel', 'label', 'categoryLabel']),
              firstValue(item, ['search', 'descripcion_corta', 'summary', 'description', 'descripcion', 'subtitle', 'subtitulo']),
              firstValue(item, ['pais', 'país', 'country', 'nacionalidad', 'ubicacion', 'ubicación']),
              firstValue(item, ['periodo', 'epoca', 'año', 'year']),
              firstValue(item, ['tags', 'fabricante', 'modelo', 'modelo_base', 'motor', 'disciplina']),
              firstValue(item, ['circuitos_asociados', 'coches_asociados', 'pilotos_asociados'])
            ].filter(Boolean).join(' ');

            const compact = slugify(searchText);

            let score = 0;

            wanted.forEach((needle) => {
              if (!needle) return;
              const shortNeedle = needle.replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '');
              if (compact.includes(needle) || needle.includes(compact)) score += 120;
              if (shortNeedle && compact.includes(shortNeedle)) score += 90;
              if (slugify(title).includes(shortNeedle) || slugify(slug).includes(shortNeedle)) score += 80;
            });

            // Preferir un circuito activo, luego coches del combo, luego pilotos/glosario destacados.
            if (activeTrackSlug && normalizedType === 'circuitos' && compact.includes(activeTrackSlug)) score += 140;
            if (activeTrackSlug && normalizedType !== 'circuitos' && compact.includes(activeTrackSlug)) score += 25;

            if (String(firstValue(item, ['featured', 'destacado', 'isFeatured', 'is_featured'])).toLowerCase() === 'true') score += 20;
            if (normalizedType === 'circuitos') score += 8;
            if (normalizedType === 'coches') score += 6;
            if (normalizedType === 'pilotos') score += 4;
            score += Math.max(0, 10 - index);

            return { item, score, index, type: normalizedType };
          })
          .sort((a, b) => b.score - a.score || a.index - b.index);

        const picked = [];
        const usedKeys = new Set();

        const pushUnique = (entry) => {
          if (!entry || !entry.item) return;
          const key = `${normalizeArchiveType(firstValue(entry.item, ['tipo', 'type', 'category']) || '')}:${firstValue(entry.item, ['slug', 'title', 'nombre'])}`;
          if (usedKeys.has(key)) return;
          usedKeys.add(key);
          picked.push(entry.item);
        };

        // Primero circuito activo si existe.
        pushUnique(visiblePool.find((entry) => entry.type === 'circuitos' && activeTrackSlug && slugify([firstValue(entry.item, ['title', 'nombre']), firstValue(entry.item, ['slug']), firstValue(entry.item, ['search'])].join(' ')).includes(activeTrackSlug)));

        // Luego mejores coches/pilotos relacionados.
        visiblePool.forEach((entry) => {
          if (picked.length < 6) pushUnique(entry);
        });

        const visible = picked.slice(0, 6);

        const host = $('[data-home2-archive]');
        if (!host || !visible.length) return;

        host.innerHTML = visible.map((item, index) => {
          const title = firstValue(item, ['title', 'nombre', 'name']) || 'Ficha';
          const type = firstValue(item, ['tipoLabel', 'label']) || firstValue(item, ['tipo', 'type', 'category', 'categoria', 'kind']) || 'Archivo';
          const summary = firstValue(item, ['descripcion_corta', 'summary', 'description', 'descripcion', 'subtitle', 'subtitulo']) || 'Ficha técnica e histórica.';
          const imageAttrs = archiveImageAttrs(item, index);
          const finalHref = archiveHref(item);
          return `
            <a class="gc-home2-archive-card" href="${finalHref}">
              <img ${imageAttrs} alt="" width="340" height="190" loading="lazy" decoding="async" />
              <span class="gc-home2-archive-card__tag">${type}</span>
              <strong>${title}</strong>
              <small>${summary}</small>
              <em>Ver ficha →</em>
            </a>
          `;
        }).join('');
      };

      const fetchText = async (url) => {
        try {
          const res = await fetch(url, { headers: { Accept: 'text/html,application/xhtml+xml' } });
          if (!res.ok) return '';
          return await res.text();
        } catch (_) {
          return '';
        }
      };

      const textNumberNear = (text, labels) => {
        const clean = String(text || '').replace(/\s+/g, ' ');
        for (const label of labels) {
          const re1 = new RegExp(`${label}[^0-9]{0,40}(\\d+)`, 'i');
          const re2 = new RegExp(`(\\d+)[^A-Za-zÁÉÍÓÚáéíóúÑñ]{0,20}${label}`, 'i');
          const m = clean.match(re1) || clean.match(re2);
          if (m && m[1]) return m[1];
        }
        return '';
      };

      const renderChampionshipFromPage = async () => {
        const html = await fetchText('/campeonato');
