              `/images/pilots/${cleanSlug}.png`,
              `/imagenes/pilots/${cleanSlug}.webp`,
              `/imagenes/pilots/${cleanSlug}.jpg`,
              `/imagenes/pilots/${cleanSlug}.png`
            );
          }
        }

        const normalized = rawCandidates
          .filter(Boolean)
          .map((url) => String(url).trim())
          .map((url) => {
            if (!url) return '';
            if (url.startsWith('http') || url.startsWith('/') || url.startsWith('data:')) return url;
            if (url.startsWith('public/')) return `/${url.replace(/^public\//, '')}`;
            if (url.startsWith('uploads/') || url.startsWith('media/') || url.startsWith('images/') || url.startsWith('imagenes/')) return `/${url}`;
            return url;
          })
          .filter((url) => url && !url.includes('[object Object]'));

        return [...new Set(normalized)];
      };

      const archiveImageAttrs = (item, index = 0) => {
        const fallbacks = [
          '/ui/home2/gc-home2-archive-circuit.svg',
          '/ui/home2/gc-home2-archive-car.svg',
          '/ui/home2/gc-home2-archive-driver.svg'
