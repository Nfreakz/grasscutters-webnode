        const primary = candidates[0];
        const rest = candidates.slice(1).map(escapeAttr).join('|');

        return `src="${escapeAttr(primary)}" data-fallbacks="${rest}" data-fallback-index="0" onerror="const list=(this.dataset.fallbacks||'').split('|').filter(Boolean); const i=Number(this.dataset.fallbackIndex||0); if(list[i]){this.dataset.fallbackIndex=String(i+1); this.src=list[i];} else {this.style.display='none';}"`;
