  <script>
    (() => {
      const srBody = document.querySelector('[data-home2-sr-ratings]');
      const gsrBody = document.querySelector('[data-home2-gsr-ratings]');
      if (!srBody && !gsrBody) return;

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char]));

      const toNumber = (value) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : null;
      };

      const classKey = (value) => String(value || 'unknown')
        .trim()
        .toLowerCase()
        .replace('+', 'plus')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'unknown';

      const readRatingValue = (obj, keys = []) => {
        for (const key of keys) {
          const parts = String(key).split('.').filter(Boolean);
          let current = obj;
          for (const part of parts) current = current?.[part];
          if (current !== undefined && current !== null && current !== '') return current;
        }
        return '';
      };

      const ratingPilotAvatarUrl = (row) => {
        const direct = readRatingValue(row, ['avatarUrl', 'avatar_url', 'imageUrl', 'image', 'driver.avatarUrl', 'player.avatarUrl', 'pilot.avatarUrl']);
        if (direct) return String(direct);
        const id = readRatingValue(row, ['profilePlayerId', 'strackerPlayerId', 'pilotId', 'playerId', 'driverId', 'id', 'player.id', 'driver.id']);
        if (id !== undefined && id !== null && id !== '') return `/api/pilot-avatar/${encodeURIComponent(String(id))}`;
        return '/images/pilot-avatar-default.png';
      };

      const formatDriverName = (value) => String(value || 'Piloto').toUpperCase();

      const formatDelta = (value, digits = 1) => {
        const numeric = toNumber(value);
        if (numeric === null) return '--';
        const formatted = digits === 0 ? String(Math.round(numeric)) : numeric.toFixed(digits);
        return `${numeric > 0 ? '+' : ''}${formatted}`;
      };

      const deltaClass = (value) => {
        const numeric = toNumber(value);
        if (numeric === null || numeric === 0) return 'gc-home2-rating-delta is-neutral';
        return numeric > 0 ? 'gc-home2-rating-delta is-positive' : 'gc-home2-rating-delta is-negative';
      };

      const rankTone = (position) => {
        const numeric = Number(position);
        if (numeric === 1) return 'gold';
        if (numeric === 2) return 'silver';
        if (numeric === 3) return 'bronze';
        return '';
      };

      const renderRankBadge = (position) => {
        const numeric = Number(position);
        const safePosition = Number.isFinite(numeric) ? numeric : 0;
        if (safePosition === 1) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--gold gc-home2-ranking-medal" aria-label="1º">🥇</span>';
        if (safePosition === 2) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--silver gc-home2-ranking-medal" aria-label="2º">🥈</span>';
        if (safePosition === 3) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--bronze gc-home2-ranking-medal" aria-label="3º">🥉</span>';
        return `<span class="gc-home2-rank-badge gc-home2-rank-badge--plain gc-home2-ranking-medal">${escapeHtml(position)}</span>`;
      };

      const ratingBadge = (type, label, score) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const safeLabel = String(label || '--');
        const scoreText = score === undefined || score === null || score === '' ? '' : `<small>${escapeHtml(score)}</small>`;
        return `
          <span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${classKey(safeLabel)} gc-rating-badge--compact" aria-label="${safeType.toUpperCase()} ${escapeHtml(safeLabel)} ${escapeHtml(score || '')}">
            <strong>${escapeHtml(safeLabel)}</strong>
            ${scoreText}
          </span>`;
      };

      const driverLink = (row) => {
        const name = formatDriverName(row?.driver || row?.name || 'Piloto');
        const directPlayerId = row?.profilePlayerId || row?.strackerPlayerId || '';
        const driverKey = String(row?.driverKey || '');
        const playerId = directPlayerId || (driverKey.startsWith('player:') ? driverKey.replace('player:', '') : '');
        const avatar = escapeHtml(ratingPilotAvatarUrl(row));
        const main = playerId
          ? `<a href="/pilotos/${encodeURIComponent(String(playerId))}">${escapeHtml(name)}</a>`
          : `<strong>${escapeHtml(name)}</strong>`;
        return `<div class="gc-home2-rating-driver-cell"><div class="gc-home2-rating-driver">${main}<small>${playerId ? 'Perfil público' : 'Piloto GC'}</small></div><img class="gc-home2-rating-driver-avatar" src="${avatar}" alt="" width="30" height="30" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/pilot-avatar-default.png';" /></div>`;
      };

      const renderRows = (target, rows, type) => {
        if (!target) return;
        const list = Array.isArray(rows) ? rows.slice(0, 5) : [];
        if (!list.length) {
          target.innerHTML = `<tr><td colspan="4">Sin datos de ${type.toUpperCase()}.</td></tr>`;
          return;
        }

        target.innerHTML = list.map((row, index) => {
          const isSr = type === 'sr';
          const score = isSr ? toNumber(row.sr) : toNumber(row.gsr);
          const scoreText = score === null ? '--' : (isSr ? score.toFixed(1) : String(Math.round(score)));
          const label = isSr ? row.srClass : row.gsrClass;
          const deltaDigits = isSr ? 1 : 0;

          const position = row.position ?? index + 1;
          const tone = rankTone(position);
          const rowClass = ` class="gc-home2-rating-row${tone ? ` gc-home2-rating-row--podium gc-home2-rating-row--${tone}` : ' gc-home2-rating-row--plain'}"`;

          return `
            <tr${rowClass}>
              <td>${renderRankBadge(position)}</td>
              <td>${driverLink(row)}</td>
              <td>${ratingBadge(type, label || '--', scoreText)}</td>
              <td><span class="${deltaClass(row.lastDelta)}">${escapeHtml(formatDelta(row.lastDelta, deltaDigits))}</span></td>
            </tr>`;
        }).join('');
      };

      async function loadHomeRatings() {
        try {
          const response = await fetch('/api/gc/ratings/championship', { cache: 'no-store' });
          const data = await response.json();
          if (!data?.ok) throw new Error(data?.message || 'Ratings no disponibles.');
          renderRows(srBody, data.leaderboard?.sr || [], 'sr');
          renderRows(gsrBody, data.leaderboard?.gsr || [], 'gsr');
        } catch (error) {
          if (srBody) srBody.innerHTML = '<tr><td colspan="4">No se pudo cargar SR.</td></tr>';
          if (gsrBody) gsrBody.innerHTML = '<tr><td colspan="4">No se pudo cargar GSR.</td></tr>';
          console.warn('[GC Home] No se pudieron cargar ratings', error);
        }
      }

      loadHomeRatings();
    })();
  </script>
  <script>
    (() => {
      const root = document.querySelector('[data-gc-home2]');
      if (!root) return;

      const $ = (selector) => root.querySelector(selector);
      const $$ = (selector) => Array.from(root.querySelectorAll(selector));

      const setText = (selector, value) => {
        const el = $(selector);
        if (!el) return;
        el.textContent = value === undefined || value === null || value === '' ? '--' : String(value);
      };

      const getArray = (payload) => {
        if (!payload) return [];
        if (Array.isArray(payload)) return payload;
        if (Array.isArray(payload.items)) return payload.items;
        if (Array.isArray(payload.posts)) return payload.posts;
        if (Array.isArray(payload.data)) return payload.data;
        if (payload.data && Array.isArray(payload.data.items)) return payload.data.items;
        if (payload.data && Array.isArray(payload.data.entries)) return payload.data.entries;
        if (payload.data && Array.isArray(payload.data.results)) return payload.data.results;
        if (Array.isArray(payload.entries)) return payload.entries;
        if (Array.isArray(payload.archiveItems)) return payload.archiveItems;
        if (Array.isArray(payload.records)) return payload.records;
        if (Array.isArray(payload.laps)) return payload.laps;
        if (Array.isArray(payload.results)) return payload.results;
        if (Array.isArray(payload.combos)) return payload.combos;
        if (Array.isArray(payload.leaderboard)) return payload.leaderboard;
        if (Array.isArray(payload.items?.items)) return payload.items.items;
        if (Array.isArray(payload.archive?.items)) return payload.archive.items;
        if (Array.isArray(payload.stats?.items)) return payload.stats.items;
        return [];
      };

      const firstValue = (obj, keys) => {
        if (!obj) return '';
        for (const key of keys) {
          if (key.includes('.')) {
            const parts = key.split('.');
            let current = obj;
            for (const part of parts) current = current && current[part];
            if (current !== undefined && current !== null && current !== '') return current;
          } else if (obj[key] !== undefined && obj[key] !== null && obj[key] !== '') {
            return obj[key];
          }
        }
        return '';
      };

      const fetchJson = async (url) => {
        try {
          const res = await fetch(url, { headers: { Accept: 'application/json' } });
          if (!res.ok) return null;
          return await res.json();
        } catch (_) {
          return null;
        }
      };

      const slugify = (value) => String(value || '')
        .toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '');

      const countryFlag = (code) => {
        const normalized = String(code || '').trim().toUpperCase();
        if (!/^[A-Z]{2}$/.test(normalized)) return '';
        return normalized;
      };

      const countryFlagEmoji = (code) => {
        const normalized = String(code || '').trim().toUpperCase();
        if (!/^[A-Z]{2}$/.test(normalized)) return '';
        return normalized
          .split('')
          .map((char) => String.fromCodePoint(127397 + char.charCodeAt(0)))
          .join('');
      };

      const flagSvgMarkup = (code) => {
        const c = String(code || '').trim().toUpperCase();
        const svg = (body) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 20">${body}</svg>`;
        const rect = (fill, y = 0, h = 20, x = 0, w = 30) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${fill}"/>`;
        switch (c) {
          case 'ES': return svg(`${rect('#c60b1e',0,5)}${rect('#ffc400',5,10)}${rect('#c60b1e',15,5)}`);
          case 'IT': return svg(`${rect('#008c45',0,20,0,10)}${rect('#f4f5f0',0,20,10,10)}${rect('#cd212a',0,20,20,10)}`);
          case 'BE': return svg(`${rect('#111',0,20,0,10)}${rect('#ffd90c',0,20,10,10)}${rect('#ef3340',0,20,20,10)}`);
          case 'FR': return svg(`${rect('#0055a4',0,20,0,10)}${rect('#fff',0,20,10,10)}${rect('#ef4135',0,20,20,10)}`);
          case 'DE': return svg(`${rect('#000',0,6.67)}${rect('#dd0000',6.67,6.66)}${rect('#ffce00',13.33,6.67)}`);
          case 'NL': return svg(`${rect('#ae1c28',0,6.67)}${rect('#fff',6.67,6.66)}${rect('#21468b',13.33,6.67)}`);
          case 'AT': return svg(`${rect('#ed2939',0,6.67)}${rect('#fff',6.67,6.66)}${rect('#ed2939',13.33,6.67)}`);
          case 'GB': return svg(`${rect('#012169')}<path d="M0 0l30 20M30 0L0 20" stroke="#fff" stroke-width="5"/><path d="M0 0l30 20M30 0L0 20" stroke="#c8102e" stroke-width="2.4"/><path d="M15 0v20M0 10h30" stroke="#fff" stroke-width="7"/><path d="M15 0v20M0 10h30" stroke="#c8102e" stroke-width="4"/>`);
          case 'US': return svg(`${rect('#b22234')}<g fill="#fff">${Array.from({length:6},(_,i)=>`<rect y="${(i*2+1)*20/13}" width="30" height="${20/13}"/>`).join('')}</g>${rect('#3c3b6e',0,10.77,0,12)}`);
          case 'JP': return svg(`${rect('#fff')}<circle cx="15" cy="10" r="5.2" fill="#bc002d"/>`);
          case 'AU': return svg(`${rect('#012169')}<path d="M21 5l1 2 2 .2-1.5 1.4.5 2-2-1.1-2 1.1.5-2L18 7.2l2-.2 1-2zM24 14l.7 1.4 1.5.1-1.1 1 .3 1.5-1.4-.8-1.4.8.3-1.5-1.1-1 1.5-.1.7-1.4z" fill="#fff"/>`);
          case 'BR': return svg(`${rect('#009b3a')}<path d="M15 3l12 7-12 7L3 10z" fill="#ffdf00"/><circle cx="15" cy="10" r="4.2" fill="#002776"/>`);
          default: return '';
        }
      };

      const flagSvgDataUrl = (code) => {
        const svg = flagSvgMarkup(code);
        return svg ? `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}` : '';
      };

      const setCountryBadge = (code, label = '') => {
        const badge = document.querySelector('[data-home2-track-country]');
        if (!badge) return;
        const normalized = countryCodeFromValue(code) || countryCodeFromValue(label) || String(code || '').trim().toUpperCase();
        const finalCode = /^[A-Z]{2}$/.test(normalized) ? normalized : '';

        [...badge.classList].forEach((className) => {
          if (/^gc-home2-country--[a-z]{2}$/i.test(className)) badge.classList.remove(className);
        });

        badge.classList.add('gc-home2-country--flag');
        if (finalCode) badge.classList.add(`gc-home2-country--${finalCode.toLowerCase()}`);
        badge.dataset.countryCode = finalCode || '';
        badge.title = [label, finalCode].filter(Boolean).join(' · ') || 'País';
        badge.setAttribute('aria-label', finalCode ? `País: ${finalCode}` : 'País no detectado');
        badge.innerHTML = finalCode ? `<span>${finalCode}</span>` : '<span>--</span>';
      };

      const countryCodeFromValue = (value) => {
        const raw = String(value || '').trim();
        if (!raw) return '';

        if (/^[A-Za-z]{2}$/.test(raw)) return raw.toUpperCase();

        const slug = slugify(raw);
        const map = {
          espana: 'ES',
          spain: 'ES',
          españa: 'ES',
          italia: 'IT',
          italy: 'IT',
          francia: 'FR',
          france: 'FR',
          belgium: 'BE',
          belgica: 'BE',
          bélgica: 'BE',
          germany: 'DE',
          alemania: 'DE',
          united_kingdom: 'GB',
          reino_unido: 'GB',
          great_britain: 'GB',
          japan: 'JP',
          japon: 'JP',
          japón: 'JP',
          australia: 'AU',
          austria: 'AT',
          netherlands: 'NL',
          paises_bajos: 'NL',
          países_bajos: 'NL',
          usa: 'US',
          united_states: 'US',
          estados_unidos: 'US',
          brazil: 'BR',
          brasil: 'BR',
          portugal: 'PT',
          portimao: 'PT',
          estoril: 'PT',
          canada: 'CA',
          canadá: 'CA',
          mexico: 'MX',
          méxico: 'MX',
          argentina: 'AR',
          chile: 'CL',
          poland: 'PL',
          polonia: 'PL',
          czech: 'CZ',
          republica_checa: 'CZ',
          hungary: 'HU',
          hungria: 'HU',
          suecia: 'SE',
          sweden: 'SE',
          noruega: 'NO',
          norway: 'NO',
          finlandia: 'FI',
          finland: 'FI',
          dinamarca: 'DK',
          denmark: 'DK'
        };

        if (map[slug]) return map[slug];

        const tokens = slug.split('_').filter(Boolean);
        for (const token of tokens) {
          if (map[token]) return map[token];
        }

        // Soporta nombres de mod con sufijo o prefijo de país:
        // fn_jerez_spain, mugello_italy, spa_belgium, track_es, etc.
        const suffix = tokens[tokens.length - 1] || '';
        const prefix = tokens[0] || '';
        if (map[suffix]) return map[suffix];
        if (map[prefix]) return map[prefix];

        return '';
      };

      const countryDisplayFromValue = (value) => {
        const code = countryCodeFromValue(value);
        return code ? (countryFlag(code) || code) : '';
      };

      const cleanTrackKey = (value) => slugify(value)
        .replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '')
        .replace(/_?(layout|gp|club|international|national)$/, '');

      const archiveCountryForTrack = (trackName) => {
        const wanted = cleanTrackKey(trackName);
        if (!wanted) return '';

        const archive = Array.isArray(window.__GC_HOME2_ARCHIVE__) ? window.__GC_HOME2_ARCHIVE__ : [];
        const circuits = archive.filter((item) => {
          const type = normalizeArchiveType(firstValue(item, ['tipo', 'type', 'category', 'categoria', 'kind']) || '');
          return type === 'circuitos';
        });

        const hit = circuits.find((item) => {
          const raw = [
            item.slug,
            item.nombre,
            item.title,
            item.name,
            item.search,
            item.circuitName,
            item.trackName
          ].filter(Boolean).join(' ');
          const key = cleanTrackKey(raw);
          return key.includes(wanted) || wanted.includes(key);
        });

        if (!hit) return '';

        return countryDisplayFromValue(firstValue(hit, [
          'countryCode',
          'country_code',
          'pais',
          'país',
          'country',
          'nacionalidad',
          'ubicacion',
          'location'
        ]));
      };

      /* GC_HOME2_RACECONTROL_REVIEW_V5_JS */
      const inferTrackCountry = (trackName, combo = {}) => {
        const normalizeCountryCode = (value) => {
          const raw = String(value || '').trim();
          if (!raw) return '';
          const slug = slugify(raw);
          const nameMap = {
            spain: 'ES', espana: 'ES', espanya: 'ES', es: 'ES', esp: 'ES',
            italy: 'IT', italia: 'IT', it: 'IT',
            belgium: 'BE', belgica: 'BE', belgique: 'BE', be: 'BE',
            united_kingdom: 'GB', uk: 'GB', great_britain: 'GB', england: 'GB', gb: 'GB',
            united_states: 'US', usa: 'US', eeuu: 'US', us: 'US',
            germany: 'DE', alemania: 'DE', deutschland: 'DE', de: 'DE',
            netherlands: 'NL', holanda: 'NL', paises_bajos: 'NL', nl: 'NL',
            japan: 'JP', japon: 'JP', jp: 'JP',
            australia: 'AU', au: 'AU',
            austria: 'AT', at: 'AT',
            france: 'FR', francia: 'FR', fr: 'FR',
            brazil: 'BR', brasil: 'BR', br: 'BR'
          };
          if (nameMap[slug]) return nameMap[slug];
          const upper = raw.toUpperCase();
          return /^[A-Z]{2}$/.test(upper) ? upper : '';
        };

        const direct = firstValue(combo, [
          'track.countryCode',
          'track.country_code',
          'track.country',
          'track.location.country',
          'countryCode',
          'country_code',
          'country',
          'pais',
          'país',
          'trackCountry',
          'trackCountryCode'
        ]);

        const candidatesText = [
          trackName,
          firstValue(combo, ['canonicalTrackName', 'trackName', 'track', 'circuitName', 'name']),
          firstValue(combo, ['track.displayName', 'track.name', 'track.slug', 'track.id']),
          firstValue(combo, ['slug', 'trackSlug']),
          direct
        ].filter(Boolean).map((value) => slugify(value)).join(' ');

        // Primero manda el nombre del circuito. Algunos endpoints devuelven país erróneo
        // o un código heredado del piloto/servidor; Jerez debe resolver ES, no BE.
        // Para mods nuevos, intentamos: nombre del circuito -> archivo CMS -> campos explícitos del combo.
        const countryMap = [
          [['jerez', 'circuito_de_jerez', 'angel_nieto'], 'ES'],
          [['jarama', 'barcelona', 'catalunya', 'montmelo', 'valencia', 'motorland', 'aragon', 'navarra', 'ricardo_tormo'], 'ES'],
          [['mugello', 'monza', 'imola', 'vallelunga', 'misano'], 'IT'],
          [['spa', 'francorchamps', 'zolder'], 'BE'],
          [['silverstone', 'brands_hatch', 'donington', 'oulton', 'snetterton'], 'GB'],
          [['sebring', 'laguna_seca', 'road_america', 'road_atlanta', 'watkins', 'daytona', 'vir'], 'US'],
          [['nurburgring', 'nordschleife', 'hockenheim', 'lausitz', 'sachsenring', 'oschersleben'], 'DE'],
          [['zandvoort', 'assen'], 'NL'],
          [['suzuka', 'fuji', 'okayama', 'motegi'], 'JP'],
          [['phillip_island', 'mount_panorama', 'bathurst', 'adelaide'], 'AU'],
          [['red_bull', 'spielberg', 'salzburgring'], 'AT'],
          [['paul_ricard', 'magny', 'lemans', 'le_mans', 'dijon'], 'FR'],
          [['interlagos', 'goiania', 'curitiba'], 'BR'],
          [['estoril', 'portimao', 'algarve'], 'PT'],
          [['mosport', 'mont_tremblant', 'gilles_villeneuve', 'canadian_tire'], 'CA'],
          [['mexico_city', 'hermanos_rodriguez'], 'MX'],
          [['buenos_aires', 'potrero_de_los_funes'], 'AR'],
          [['hungaroring'], 'HU'],
          [['brno', 'most'], 'CZ'],
          [['poznan', 'silesia'], 'PL'],
          [['mantorp', 'anderstorp'], 'SE'],
          [['rudskogen'], 'NO'],
          [['kymi', 'alastaro'], 'FI']
        ];

        const hit = countryMap.find(([names]) => names.some((name) => candidatesText.includes(name)));
        if (hit) return countryFlag(hit[1]) || hit[1];

        const archiveCode =
          countryCodeFromValue(archiveCountryForTrack(trackName)) ||
          countryCodeFromValue(archiveCountryForTrack(firstValue(combo, ['canonicalTrackName', 'trackName', 'track', 'circuitName', 'name']))) ||
          '';
        if (archiveCode) return countryFlag(archiveCode) || archiveCode;

        const directCode = normalizeCountryCode(direct) || countryCodeFromValue(candidatesText);
        return directCode ? (countryFlag(directCode) || directCode) : '';
      };


      const normalizeArchiveType = (value) => {
        const raw = slugify(value || 'archivo');
        if (['circuito', 'circuit', 'track', 'tracks'].includes(raw)) return 'circuitos';
        if (['coche', 'coches', 'car', 'cars', 'vehiculo', 'vehiculos', 'vehicle'].includes(raw)) return 'coches';
        if (['piloto', 'pilotos', 'driver', 'drivers'].includes(raw)) return 'pilotos';
        if (raw.endsWith('s')) return raw;
        return raw + 's';
      };

      const archiveImage = (item, index = 0) => {
        const mediaArray = Array.isArray(item?.media) ? item.media : [];
        const firstMedia = mediaArray.find((media) => media && (
          media.isCover ||
          media.is_cover ||
          media.portada ||
          media.role === 'cover' ||
          media.kind === 'cover' ||
          media.url ||
          media.publicUrl
        )) || mediaArray[0];

        const direct = firstValue(item, [
          'image',
          'imageUrl',
          'image_url',
          'imagen_url',
          'imagen',
          'cover',
          'coverUrl',
          'cover_url',
          'mediaUrl',
          'media_url',
          'featuredImage',
          'featured_image',
          'heroImage',
          'hero_image',
          'thumbnail',
          'thumb',
          'mainImage',
          'main_image'
        ]);

        const mediaUrl = firstValue(firstMedia, [
          'url',
          'publicUrl',
          'public_url',
          'src',
          'imageUrl',
          'image_url',
          'path'
        ]);

        const chosen = direct || mediaUrl;
        if (chosen) return String(chosen);

        const fallbacks = [
          '/ui/home2/gc-home2-archive-circuit.svg',
          '/ui/home2/gc-home2-archive-car.svg',
          '/ui/home2/gc-home2-archive-driver.svg'
        ];
        return fallbacks[index % fallbacks.length];
      };

      const archiveHref = (item) => {
        const direct = firstValue(item, ['href', 'url', 'publicUrl', 'public_url', 'path']);
        if (direct) return String(direct);
        const slug = firstValue(item, ['slug', 'seoSlug', 'seo_slug']);
        const type = normalizeArchiveType(firstValue(item, ['tipo', 'type', 'category', 'categoria', 'kind']));
        return slug ? `/archivo/${type}/${slug}/` : '/archivo';
      };

      const formatLap = (value) => {
        if (value === undefined || value === null || value === '') return '--';
        if (typeof value === 'string') {
          const trimmed = value.trim();
          if (trimmed.includes(':')) return trimmed;
          const numeric = Number(trimmed);
          if (!Number.isFinite(numeric)) return trimmed;
          value = numeric;
        }
        const num = Number(value);
        if (!Number.isFinite(num) || num <= 0) return '--';
        const ms = num > 1000 ? Math.round(num) : Math.round(num * 1000);
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        const millis = ms % 1000;
        return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
      };

      const parseDateValue = (value) => {
        if (value === undefined || value === null || value === '') return null;

        if (value instanceof Date && Number.isFinite(value.getTime())) {
          return value.getFullYear() >= 2020 ? value : null;
        }

        if (typeof value === 'number' || (typeof value === 'string' && /^-?\d+(\.\d+)?$/.test(value.trim()))) {
          const numeric = Number(value);
          if (!Number.isFinite(numeric) || numeric <= 0) return null;

          let ms = numeric;

          // Unix seconds are around 1.7e9. Unix ms are around 1.7e12.
          if (numeric > 1e9 && numeric < 1e10) ms = numeric * 1000;
          else if (numeric > 1e12 && numeric < 1e13) ms = numeric;
          else return null;

          const date = new Date(ms);
          return Number.isFinite(date.getTime()) && date.getFullYear() >= 2020 ? date : null;
        }

        const text = String(value).trim();
        if (!text || text === '0') return null;

        const parsed = new Date(text);
        if (!Number.isFinite(parsed.getTime()) || parsed.getFullYear() < 2020) return null;
        return parsed;
      };

      const firstValidDate = (obj, keys) => {
        if (!obj) return null;
        for (const key of keys) {
          const raw = firstValue(obj, [key]);
          const date = parseDateValue(raw);
          if (date) return date;
        }
        return null;
      };

      const formatAgo = (value) => {
        const date = parseDateValue(value);
        if (!date) return '--';

        const diff = Date.now() - date.getTime();
        if (diff < 0) return '--';

        const mins = Math.floor(diff / 60000);
        if (mins < 1) return 'ahora';
        if (mins < 60) return `${mins} min`;

        const hours = Math.floor(mins / 60);
        if (hours < 24) return `${hours} h`;

        const days = Math.floor(hours / 24);
        if (days < 31) return `${days} d`;

        const months = Math.floor(days / 30);
        if (months < 24) return `${months} m`;

        const years = Math.floor(days / 365);
        return `${years} a`;
      };

      const pilotAvatarUrl = (pilot) => {
        const direct = firstValue(pilot, ['avatarUrl', 'avatar_url', 'imageUrl', 'image', 'driver.avatarUrl', 'player.avatarUrl', 'pilot.avatarUrl']);
        if (direct) return String(direct);
        const id = firstValue(pilot, ['pilotId', 'playerId', 'driverId', 'id', 'player.id', 'driver.id']);
        if (id !== undefined && id !== null && id !== '') return `/api/pilot-avatar/${encodeURIComponent(String(id))}`;
        return '/images/pilot-avatar-default.png';
      };

      const probeImage = (src) => new Promise((resolve) => {
        const test = new Image();
        test.onload = () => resolve(src);
        test.onerror = () => resolve('');
        test.src = src;
      });

      const uniqueValues = (values) => [...new Set(values.filter(Boolean).map((value) => String(value).trim()).filter(Boolean))];

      // GC_TRACK_ASSETS_SINGLE_SOURCE_V19
      // Las imágenes reales están en public/images/tracks.
      // Foto y mapa se resuelven aquí antes de tocar resolvers difusos o manifests viejos.
      const TRACK_ASSET_REGISTRY = {
        jerez: {
          keys: ['jerez', 'fn_jerez', 'circuito_de_jerez', 'circuito_de_jerez_spain', 'circuito_de_jerez_angel_nieto', 'jerez_angel_nieto', 'angel_nieto_jerez'],
          photo: '/images/tracks/jerez.png',
          map: '/images/tracks/jerez_mapa.png'
        },
        mugello: {
          keys: ['mugello', 'ks_mugello', 'autodromo_internazionale_del_mugello'],
          photo: '/images/tracks/mugello.webp',
          map: '/images/tracks/mugello_mapa.png'
        },
        fuji: {
          keys: ['fuji', 'rt_fuji_speedway', 'rt_fuji_speedway_layout_gp', 'fuji_speedway', 'fuji_speedway_gp', 'fuji_speedway_layout_gp', 'fuji_international_speedway', 'fujispeedway'],
          photo: '/images/tracks/fuji.jpg',
          map: '/images/tracks/fuji_mapa.png',
          distance: '4.563 km'
        },
        bathurst: { keys: ['bathurst', 'mount_panorama'], photo: '/images/tracks/bathurst.png' },
        brands_hatch: { keys: ['brands_hatch', 'ks_brands_hatch'], photo: '/images/tracks/brands_hatch.webp' },
        estoril: { keys: ['estoril'], photo: '/images/tracks/estoril.webp' },
        hockenheim: { keys: ['hockenheim', 'ks_hockenheim', 've_hockenheim_gp', 'hockenheimring'], photo: '/images/tracks/hockenheim.png' },
        imola: { keys: ['imola', 'autodromo_internazionale_enzo_e_dino_ferrari'], photo: '/images/tracks/imola.webp' },
        nordschleife: { keys: ['nordschleife', 'nurburgring_nordschleife'], photo: '/images/tracks/nordschleife.webp' },
        nurburgring: { keys: ['nurburgring', 'ks_nurburgring'], photo: '/images/tracks/nurburgring.jpg' },
        okayama: { keys: ['okayama', 'okayama_international', 'okayama_circuit'], photo: '/images/tracks/okayama.jpg' },
        phillip_island: { keys: ['phillip_island', 'phillipisland', 'phillip_island_2013', 'phillip_island_circuit'], photo: '/images/tracks/phillip_island.png' },
        road_atlanta: { keys: ['road_atlanta'], photo: '/images/tracks/road_atlanta.webp' },
        salzburgring: { keys: ['salzburgring', 'salzburg_ring', 'salzburg'], photo: '/images/tracks/salzburgring.png' },
        sebring: { keys: ['sebring', 'mx_sb_day_standing', 'sebring_international'], photo: '/images/tracks/sebring.png' },
        spa: { keys: ['spa', 'ks_spa', 'rt_spa', 'spa_francorchamps', 'circuit_de_spa_francorchamps'], photo: '/images/tracks/spa.png' },
        suzuka: { keys: ['suzuka', 'ks_suzuka', 'suzuka_circuit'], photo: '/images/tracks/suzuka.png' },
        vallelunga: { keys: ['vallelunga', 'ks_vallelunga'], photo: '/images/tracks/vallelunga.webp' },
        zolder: { keys: ['zolder', 'rt_zolder', 'circuit_zolder', 'nrs_z_der2017online'], photo: '/images/tracks/zolder.webp' }
      };

      const normalizeTrackMapBase = (value) => {
        let slug = slugify(value)
          .replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '')
          .replace(/_online$/, '')
          .replace(/_?(layout|gp|club|international|national)$/, '')
          .replace(/_(spain|espana|espanya|italy|italia|belgium|belgica|france|francia|germany|alemania|uk|gb|usa|united_states|australia|japan|japon)$/g, '')
          .replace(/_?(mapa|map|outline)$/g, '')
          .replace(/^_+|_+$/g, '');
        return slug;
      };

      const trackSlugVariants = (...trackNames) => {
        const sourceValues = trackNames.flat(Infinity).filter(Boolean);
        const variants = [];

        for (const value of sourceValues) {
          const slug = slugify(value);
          const compact = normalizeTrackMapBase(value);
          variants.push(slug, compact);

          Object.values(TRACK_ASSET_REGISTRY).forEach((track) => {
            const keys = track.keys || [];
            if (keys.some((key) => slug === key || compact === key || slug.includes(key) || compact.includes(key) || key.includes(slug) || key.includes(compact))) {
              variants.push(track.keys[0], ...keys);
            }
          });
        }

        return uniqueValues(variants);
      };

      const findRegisteredTrackAsset = (...trackNames) => {
        const variants = trackSlugVariants(trackNames);
        return Object.values(TRACK_ASSET_REGISTRY).find((track) => {
          const keys = track.keys || [];
          return keys.some((key) => variants.some((variant) => variant === key || variant.includes(key) || key.includes(variant)));
        }) || null;
      };

      const formatTrackDistanceLocal = (value) => {
        if (value === undefined || value === null || value === '') return '';
        const text = String(value).trim();
        if (!text || text === '--') return '';
        if (/km/i.test(text)) return text;
        const numeric = Number(text.replace(',', '.').replace(/[^0-9.]+/g, ''));
        if (!Number.isFinite(numeric) || numeric <= 0) return text;
        const km = numeric > 1000 ? numeric / 1000 : numeric;
        return `${km.toFixed(km < 10 ? 3 : 1).replace(/\.?0+$/, '')} km`;
      };

      const trackImageCandidates = (kind, ...trackNames) => {
        const variants = trackSlugVariants(trackNames);
        const match = findRegisteredTrackAsset(trackNames);
        const exact = match?.[kind] ? [match[kind]] : [];
        const roots = ['/images/tracks', '/imagenes/tracks'];
        const photoExts = ['webp', 'jpg', 'jpeg', 'png', 'avif'];
        const mapExts = ['png', 'webp', 'jpg', 'jpeg', 'svg'];
        const generated = [];

        if (kind === 'map') {
          variants.forEach((variant) => {
            ['_mapa', '_map'].forEach((suffix) => {
              roots.forEach((root) => {
                mapExts.forEach((ext) => generated.push(`${root}/${variant}${suffix}.${ext}`));
              });
            });
          });
          return uniqueValues([...exact, ...generated, '/ui/home2/gc-home2-track-outline.svg']);
        }

        variants.forEach((variant) => {
          ['', '_photo', '_foto', '_hero'].forEach((suffix) => {
            roots.forEach((root) => {
              photoExts.forEach((ext) => generated.push(`${root}/${variant}${suffix}.${ext}`));
            });
          });
        });

        return uniqueValues([...exact, ...generated, '/ui/home2/gc-home2-track-fallback.svg']);
      };

      const setTrackImage = async (trackName) => {
        const img = $('[data-home2-track-image]');
        if (!img || !trackName) return;

        // GC_TRACK_ASSETS_SINGLE_SOURCE_V19_PHOTO
        // Primero rutas reales conocidas. No usamos GCTrackImages aquí porque su manifest puede ir por detrás.
        for (const candidate of trackImageCandidates('photo', trackName)) {
          const ok = await probeImage(candidate);
          if (ok) {
            img.src = ok;
            img.dataset.resolvedPhoto = ok;
            return;
          }
        }

        img.src = '/ui/home2/gc-home2-track-fallback.svg';
        img.dataset.resolvedPhoto = 'fallback-photo';
      };

      const setTrackMap = async (...trackNames) => {
        const img = $('[data-home2-track-map]');
        if (!img) return;

        // GC_TRACK_ASSETS_SINGLE_SOURCE_V19_MAP
        // Mapas: rutas reales conocidas primero. Nada de GCTrackImages ni manifests aquí.
        for (const candidate of trackImageCandidates('map', trackNames)) {
          const ok = await probeImage(candidate);
          if (ok) {
            img.src = ok;
            img.dataset.resolvedMap = ok;
            return;
          }
        }

        img.src = '/ui/home2/gc-home2-track-outline.svg';
        img.dataset.resolvedMap = 'fallback-outline';
      };

      const renderRows = (selector, rows) => {
        const host = $(selector);
        if (!host) return;
        const cleanRows = rows.slice(0, 10);
        if (!cleanRows.length) return;
        host.innerHTML = cleanRows.map((lap) => {
          const driver = firstValue(lap, ['driverName', 'pilotName', 'playerName', 'name', 'driver.displayName', 'player.name']) || 'Piloto';
          const car = firstValue(lap, ['carName', 'car', 'carDisplayName', 'vehicle', 'car.displayName']) || 'Coche';
          const rawTime = firstValue(lap, ['lapTimeFormatted', 'bestLapTimeFormatted', 'timeFormatted', 'lapTime', 'lapMs', 'time', 'bestLap']);
          const agoText = firstValue(lap, ['ago', 'timeAgo', 'relativeTime', 'ageText']);
          const date = firstValidDate(lap, ['createdAt', 'created_at', 'date', 'timestamp', 'lapDate', 'lap_date', 'finishedAt', 'finished_at', 'updatedAt', 'updated_at']);
          const ago = agoText || (date ? formatAgo(date) : '--');
          return `<div class="gc-home2-table__row" role="row"><span>${driver}</span><span>${car}</span><strong>${formatLap(rawTime)}</strong><small>${ago}</small></div>`;
        }).join('');
      };

      const rankTimeValue = (row) => {
        const raw = firstValue(row, ['lapTimeMs', 'LapTime', 'lapMs', 'lapTime', 'time', 'bestLap', 'bestLapTime']);
        if (raw === undefined || raw === null || raw === '') return Number.POSITIVE_INFINITY;
        if (typeof raw === 'string' && raw.includes(':')) {
          const parts = raw.split(':');
          const minutes = Number(parts[0]) || 0;
          const seconds = Number(parts[1]) || 0;
          return (minutes * 60 + seconds) * 1000;
        }
        const num = Number(raw);
        if (!Number.isFinite(num) || num <= 0) return Number.POSITIVE_INFINITY;
        return num > 1000 ? num : num * 1000;
      };

      const rowTrackMatches = (row, trackName) => {
        if (!trackName) return true;
        const rowTrack = firstValue(row, ['trackName', 'trackDisplayName', 'trackVisibleName', 'track.name', 'track.displayName', 'Track', 'track']);
        if (!rowTrack) return true;
        // GC_HOME_TRACK_RESOLVER_V3_MATCHES
        if (window.GCHomeTrackResolver?.matchesTrack) {
          try {
            if (window.GCHomeTrackResolver.matchesTrack(rowTrack, trackName)) return true;
          } catch (_) {}
        }
        const a = slugify(rowTrack).replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '');
        const b = slugify(trackName).replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '');
        return a.includes(b) || b.includes(a);
      };

      const rowCarMatches = (row, activeCars = []) => {
        if (!activeCars.length) return true;
        const rowCar = firstValue(row, ['carName', 'carDisplayName', 'carVisibleName', 'car.name', 'car.displayName', 'Car', 'car']);
        if (!rowCar) return true;
        const carSlug = slugify(rowCar);
        return activeCars.some((car) => {
          const wanted = slugify(car);
          return carSlug.includes(wanted) || wanted.includes(carSlug);
        });
      };

      const bestRowsForCombo = (rows, trackName = '', activeCars = []) => {
        const allRows = getArray(rows)
          .filter((row) => rankTimeValue(row) !== Number.POSITIVE_INFINITY)
          .filter((row) => rowTrackMatches(row, trackName))
          .filter((row) => rowCarMatches(row, activeCars));

        const byDriver = new Map();

        allRows.forEach((row) => {
          const driver = firstValue(row, [
            'driverName',
            'pilotName',
            'playerName',
            'name',
            'driver.displayName',
            'driver.name',
            'player.name',
            'DriverName',
            'steamName'
          ]) || 'Piloto';

          const guid = firstValue(row, [
            'playerId',
            'driverId',
            'pilotId',
            'steamGuid',
            'guid',
            'driver.guid',
            'player.guid',
            'DriverGuid'
          ]);

          // Un piloto debe salir una sola vez en Mejores tiempos.
          // Si no hay GUID fiable, usamos nombre normalizado. Así evitamos Don Bixi / Don Bixi duplicado.
          const key = slugify(guid || driver);
          if (!key) return;

          const current = byDriver.get(key);
          if (!current || rankTimeValue(row) < rankTimeValue(current)) {
            byDriver.set(key, row);
          }
        });

        return [...byDriver.values()].sort((a, b) => rankTimeValue(a) - rankTimeValue(b));
      };


      const syncBestFromRow = (row) => {
        if (!row) return;
        const driver = firstValue(row, ['driverName', 'pilotName', 'playerName', 'name', 'driver.displayName', 'player.name']) || 'Piloto';
        const car = firstValue(row, ['carName', 'car', 'carDisplayName', 'vehicle', 'car.displayName']) || 'Coche';
        const rawTime = firstValue(row, ['lapTimeFormatted', 'bestLapTimeFormatted', 'timeFormatted', 'lapTime', 'lapMs', 'time', 'bestLap', 'bestLapTime']);
        const bestTime = formatLap(rawTime);

        setText('[data-home2-best-driver]', driver);
        setText('[data-home2-best-car]', car);
        setText('[data-home2-best-time]', bestTime);
      };



      const comboDetailId = (combo) => firstValue(combo, [
        'comboId',
        'id',
        'combo.id',
        'comboID',
        'combo_id',
        'logicalComboId',
        'currentComboId',
        'activeComboId',
        'key'
      ]);

      const fetchComboDetailLeaderboard = async (combo) => {
        const comboId = comboDetailId(combo);
        if (!comboId) return [];

        const detailPayload = await fetchJson(`/api/gc/combos/${encodeURIComponent(comboId)}`);
        const item =
          detailPayload?.item ||
          detailPayload?.data?.item ||
          detailPayload?.combo ||
          detailPayload?.data?.combo ||
          null;

        const leaderboard = Array.isArray(item?.leaderboard) ? item.leaderboard : [];

        console.info('[GC Home] Top Combo usando leaderboard de /combos/:id', {
          comboId,
          rows: leaderboard.length
        });

        return leaderboard;
      };


      const comboBestRankingRow = (combo, trackName = '', fallbackCar = '') => {
        if (!combo) return null;

        const best = combo.best || {};
        const rawTime = firstValue(combo, [
          'bestLapTimeFormatted',
          'bestLapFormatted',
          'bestLapTime',
          'bestLap',
          'best.time',
          'best.lapTime',
          'best.lapTimeFormatted',
          'leaderboard.0.lapTimeFormatted',
          'leaderboard.0.bestLapTimeFormatted',
          'leaderboard.0.lapTime',
          'leaderboard.0.bestLapTime'
        ]);

        const bestTime = formatLap(rawTime);
        if (!rawTime || !bestTime || bestTime === '--') return null;

        const driverName = firstValue(combo, [
          'bestDriverName',
          'bestPilotName',
          'best.driverName',
          'best.pilotName',
          'best.playerName',
          'leaderboard.0.driverName',
          'leaderboard.0.pilotName',
          'leaderboard.0.playerName'
        ]) || firstValue(best, ['driverName', 'pilotName', 'playerName', 'name']) || 'Piloto';

        const carName = firstValue(combo, [
          'bestCarName',
          'best.carName',
          'best.car',
          'leaderboard.0.carName',
          'leaderboard.0.car'
        ]) || firstValue(best, ['carName', 'car', 'carDisplayName']) || fallbackCar || 'Coche';

        return {
          ...best,
          driverName,
          pilotName: driverName,
          playerName: driverName,
          carName,
          car: carName,
          lapTimeFormatted: bestTime,
          timeFormatted: bestTime,
          lapTime: rawTime,
          bestLapTime: rawTime,
          trackName: trackName || firstValue(combo, ['canonicalTrackName', 'trackName', 'track', 'circuitName', 'name']),
          _gcSource: 'activeCombo.best'
        };
      };


      const comboPilotIdentity = (row) => {
        const rawId = firstValue(row, [
          'driverId',
          'driverID',
          'pilotId',
          'pilotID',
          'playerId',
          'playerID',
          'userId',
          'userID',
          'steamId',
          'steamID',
          'steamGuid',
          'steamGUID',
          'guid',
          'GUID',
          'driverGuid',
          'driverGUID',
          'playerGuid',
          'playerGUID',
          'acGuid',
          'strackerGuid',
          'hash',
          'driver.id',
          'driver.guid',
          'pilot.id',
          'pilot.guid',
          'player.id',
          'player.guid'
        ]);

        if (rawId !== null && rawId !== undefined && String(rawId).trim() !== '') {
          return `id:${normalizeName(rawId)}`;
        }

        const driver = normalizeName(firstValue(row, ['driverName', 'pilotName', 'playerName', 'name', 'driver.name', 'pilot.name']));
        const car = normalizeName(firstValue(row, ['carName', 'car', 'carDisplayName', 'vehicleName', 'model', 'car.name']));

        /* Fallback: si el backend no trae ID real, no hay forma fiable de distinguir
           dos pilotos con el mismo nombre y mismo coche. */
        return driver ? `name:${driver}||car:${car || 'car'}` : '';
      };

      const comboHasPilotIdentity = (row) => comboPilotIdentity(row).startsWith('id:');

      const dedupeComboRankingRows = (rows) => {
        const exactLapMap = new Map();

        rows.forEach((row) => {
          if (!row) return;

          const driver = normalizeName(firstValue(row, ['driverName', 'pilotName', 'playerName', 'name', 'driver.name', 'pilot.name']));
          const car = normalizeName(firstValue(row, ['carName', 'car', 'carDisplayName', 'vehicleName', 'model', 'car.name']));
          const timeValue = lapMs(row);

          if (!driver || !timeValue) return;

          /* Primero quitamos SOLO duplicados exactos, normalmente el combo.best sintético
             repetido en combo.leaderboard: mismo nombre visible + mismo coche + mismo tiempo. */
          const exactKey = `${driver}||${car || 'car'}||${Math.round(timeValue)}`;
          const existingExact = exactLapMap.get(exactKey);

          if (!existingExact || (!comboHasPilotIdentity(existingExact) && comboHasPilotIdentity(row))) {
            exactLapMap.set(exactKey, {
              ...row,
              _gcTimeMs: timeValue
            });
          }
        });

        const bestByPilot = new Map();

        Array.from(exactLapMap.values()).forEach((row) => {
          const identity = comboPilotIdentity(row);
          const timeValue = row._gcTimeMs || lapMs(row);

          if (!identity || !timeValue) return;

          const current = bestByPilot.get(identity);

          /* Resultado final: mejor vuelta por piloto REAL.
             Si hay dos pilotos llamados Neo con distinto ID, salen dos Neo.
             Si es el mismo piloto, solo sale su mejor vuelta. */
          if (!current || timeValue < current._gcTimeMs) {
            bestByPilot.set(identity, {
              ...row,
              _gcTimeMs: timeValue
            });
          }
        });

        return Array.from(bestByPilot.values());
      };


      const comboRankingRowsFromCombo = (combo, trackName = '', activeCars = []) => {
        const fallbackCar = activeCars[0] || firstValue(combo, ['bestCarName', 'best.carName', 'leaderboard.0.carName']);
        return dedupeComboRankingRows([
          comboBestRankingRow(combo, trackName, fallbackCar),
          ...getArray(combo?.leaderboard),
          ...getArray(combo?.bestLaps),
          ...getArray(combo?.laps)
        ].filter(Boolean));
