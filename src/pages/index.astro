          })
          .map((item, index) => {
            const title = firstValue(item, ['title', 'nombre', 'name']) || '';
            const slug = firstValue(item, ['slug', 'seoSlug', 'seo_slug']) || '';
            const type = firstValue(item, ['tipo', 'type', 'category', 'categoria', 'kind']) || '';
            const normalizedType = normalizeArchiveType(type);
            const searchText = [
              title,
              slug,
              type,
              firstValue(item, ['tipoLabel', 'label', 'categoryLabel']),
              firstValue(item, ['search', 'descripcion_corta', 'summary', 'description', 'descripcion', 'subtitle', 'subtitulo']),
              firstValue(item, ['pais', 'país', 'country', 'nacionalidad', 'ubicacion', 'ubicación']),
              firstValue(item, ['periodo', 'epoca', 'año', 'year']),
              firstValue(item, ['tags', 'fabricante', 'modelo', 'modelo_base', 'motor', 'disciplina']),
              firstValue(item, ['circuitos_asociados', 'coches_asociados', 'pilotos_asociados'])
            ].filter(Boolean).join(' ');

            const compact = slugify(searchText);

            let score = 0;

            wanted.forEach((needle) => {
              if (!needle) return;
              const shortNeedle = needle.replace(/^(ks_|rt_|mx_|nrms_|fn_)/, '');
              if (compact.includes(needle) || needle.includes(compact)) score += 120;
              if (shortNeedle && compact.includes(shortNeedle)) score += 90;
              if (slugify(title).includes(shortNeedle) || slugify(slug).includes(shortNeedle)) score += 80;
            });

            // Preferir un circuito activo, luego coches del combo, luego pilotos/glosario destacados.
            if (activeTrackSlug && normalizedType === 'circuitos' && compact.includes(activeTrackSlug)) score += 140;
            if (activeTrackSlug && normalizedType !== 'circuitos' && compact.includes(activeTrackSlug)) score += 25;

            if (String(firstValue(item, ['featured', 'destacado', 'isFeatured', 'is_featured'])).toLowerCase() === 'true') score += 20;
            if (normalizedType === 'circuitos') score += 8;
            if (normalizedType === 'coches') score += 6;
            if (normalizedType === 'pilotos') score += 4;
            score += Math.max(0, 10 - index);

            return { item, score, index, type: normalizedType };
          })
          .sort((a, b) => b.score - a.score || a.index - b.index);

        const picked = [];
        const usedKeys = new Set();

        const pushUnique = (entry) => {
          if (!entry || !entry.item) return;
          const key = `${normalizeArchiveType(firstValue(entry.item, ['tipo', 'type', 'category']) || '')}:${firstValue(entry.item, ['slug', 'title', 'nombre'])}`;
          if (usedKeys.has(key)) return;
          usedKeys.add(key);
          picked.push(entry.item);
        };

        // Primero circuito activo si existe.
        pushUnique(visiblePool.find((entry) => entry.type === 'circuitos' && activeTrackSlug && slugify([firstValue(entry.item, ['title', 'nombre']), firstValue(entry.item, ['slug']), firstValue(entry.item, ['search'])].join(' ')).includes(activeTrackSlug)));

        // Luego mejores coches/pilotos relacionados.
        visiblePool.forEach((entry) => {
          if (picked.length < 6) pushUnique(entry);
        });

        const visible = picked.slice(0, 6);

        const host = $('[data-home2-archive]');
        if (!host || !visible.length) return;

        host.innerHTML = visible.map((item, index) => {
          const title = firstValue(item, ['title', 'nombre', 'name']) || 'Ficha';
          const type = firstValue(item, ['tipoLabel', 'label']) || firstValue(item, ['tipo', 'type', 'category', 'categoria', 'kind']) || 'Archivo';
          const summary = firstValue(item, ['descripcion_corta', 'summary', 'description', 'descripcion', 'subtitle', 'subtitulo']) || 'Ficha técnica e histórica.';
          const imageAttrs = archiveImageAttrs(item, index);
          const finalHref = archiveHref(item);
          return `
            <a class="gc-home2-archive-card" href="${finalHref}">
              <img ${imageAttrs} alt="" width="340" height="190" loading="lazy" decoding="async" />
              <span class="gc-home2-archive-card__tag">${type}</span>
              <strong>${title}</strong>
              <small>${summary}</small>
              <em>Ver ficha →</em>
            </a>
          `;
        }).join('');
      };

      const fetchText = async (url) => {
        try {
          const res = await fetch(url, { headers: { Accept: 'text/html,application/xhtml+xml' } });
          if (!res.ok) return '';
          return await res.text();
        } catch (_) {
          return '';
        }
      };

      const textNumberNear = (text, labels) => {
        const clean = String(text || '').replace(/\s+/g, ' ');
        for (const label of labels) {
          const re1 = new RegExp(`${label}[^0-9]{0,40}(\\d+)`, 'i');
          const re2 = new RegExp(`(\\d+)[^A-Za-zÁÉÍÓÚáéíóúÑñ]{0,20}${label}`, 'i');
          const m = clean.match(re1) || clean.match(re2);
          if (m && m[1]) return m[1];
        }
        return '';
      };

      const renderChampionshipFromPage = async () => {
        const html = await fetchText('/campeonato');
        if (!html) return false;

        const doc = new DOMParser().parseFromString(html, 'text/html');
        const bodyText = doc.body ? doc.body.innerText : html.replace(/<[^>]+>/g, ' ');
        const titleNode =
          doc.querySelector('h1') ||
          doc.querySelector('[data-acsm-title]') ||
          doc.querySelector('[data-championship-title]');

        const title = titleNode ? titleNode.textContent.trim() : 'Campeonato ACSM';
        const events = textNumberNear(bodyText, ['Eventos', 'Rondas', 'Carreras']);
        const entrants = textNumberNear(bodyText, ['Pilotos inscritos', 'Inscritos', 'Participantes', 'Drivers']);
        const classes = textNumberNear(bodyText, ['Clases', 'Categorías', 'Categories']);
        const nextNode =
          doc.querySelector('[data-next-event]') ||
          doc.querySelector('.next-event') ||
          doc.querySelector('.gc-champ-next') ||
          Array.from(doc.querySelectorAll('h2,h3,strong')).find((node) => /próximo|proximo|next|evento/i.test(node.textContent || ''));

        setText('[data-home2-champ-name]', title || 'Campeonato ACSM');
        setText('[data-home2-champ-events]', events || '--');
        setText('[data-home2-champ-upcoming]', bodyText.match(/próxim/i) ? 'Sí' : '--');
        setText('[data-home2-champ-entrants]', entrants || '--');
        setText('[data-home2-champ-classes]', classes || '--');
        setText('[data-home2-champ-next]', nextNode ? nextNode.textContent.trim().slice(0, 80) : 'Ver campeonato activo');
        setText('[data-home2-champ-next-meta]', 'Datos desde /campeonato');

        return true;
      };

      const escapeChampionshipText = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char]));

      const championshipRankTone = (position) => {
        const numeric = Number(position);
        if (numeric === 1) return 'gold';
        if (numeric === 2) return 'silver';
        if (numeric === 3) return 'bronze';
        return '';
      };

      const renderChampionshipRankBadge = (position) => {
        const numeric = Number(position);
        const safePosition = Number.isFinite(numeric) ? numeric : 0;
        if (safePosition === 1) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--gold gc-home2-ranking-medal" aria-label="1º">🥇</span>';
        if (safePosition === 2) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--silver gc-home2-ranking-medal" aria-label="2º">🥈</span>';
        if (safePosition === 3) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--bronze gc-home2-ranking-medal" aria-label="3º">🥉</span>';
        return `<span class="gc-home2-rank-badge gc-home2-rank-badge--plain gc-home2-ranking-medal">${escapeChampionshipText(position)}</span>`;
      };

      const renderChampionshipStandings = (standings = []) => {
        const host = $('[data-home2-champ-drivers]');
        if (!host) return;

        const list = Array.isArray(standings) ? standings : [];
        if (!list.length) {
          host.innerHTML = '<div><strong>Sin clasificación visible</strong><small>ACSM</small></div>';
          return;
        }

        host.innerHTML = list.slice(0, 8).map((driver, index) => {
          const position = firstValue(driver, ['position', 'pos', 'rank']) || index + 1;
          const name = firstValue(driver, ['name', 'driverName', 'displayName', 'steamName', 'Name']) || `Piloto ${index + 1}`;
          const points = firstValue(driver, ['points', 'totalPoints', 'score']);
          const pointsText = points !== '' ? `${points}` : '0';

          const tone = championshipRankTone(position);
          const rowClass = tone ? ` gc-home2-champ-standing-row--podium gc-home2-champ-standing-row--${tone}` : ' gc-home2-champ-standing-row--plain';
          const avatar = escapeChampionshipText(pilotAvatarUrl(driver));
          const displayName = String(name || `Piloto ${index + 1}`).toUpperCase();

          return `<div class="gc-home2-champ-standing-row${rowClass}"><span class="gc-home2-champ-standing-pos">${renderChampionshipRankBadge(position)}</span><div class="gc-home2-champ-standing-meta"><strong>${escapeChampionshipText(displayName)}</strong></div><span class="gc-home2-champ-standing-points"><strong>${escapeChampionshipText(pointsText)}</strong><small>pts</small></span><img class="gc-home2-champ-standing-avatar" src="${avatar}" alt="" width="30" height="30" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/pilot-avatar-default.png';" /></div>`;
        }).join('');
      };


      const rowTrackLabelV1 = (row) => firstValue(row, [
        'trackName', 'canonicalTrackName', 'uiTrackName', 'trackCode', 'track.name', 'track.uiName', 'track.code', 'circuitName'
      ]);

      const runtimeTrackDistanceFromRowsV1 = (rows = [], trackNames = []) => {
        const wanted = trackPresentationKeysFromName(...trackNames).map((value) => slugify(value));
        const list = Array.isArray(rows) ? rows : [];
        const candidates = list.filter((row) => {
          const rowTrack = rowTrackLabelV1(row);
          if (!wanted.length) return true;
          const rowKeys = trackPresentationKeysFromName(rowTrack).map((value) => slugify(value));
          return rowKeys.some((key) => wanted.some((needle) => key === needle || key.includes(needle) || needle.includes(key)));
        });

        for (const row of (candidates.length ? candidates : list)) {
          const raw = firstValue(row, [
            'trackLength',
            'track.length',
            'track.lengthKm',
            'trackDistanceKm',
            'track.distanceKm',
            'track.distance',
            'lengthKm',
            'length',
            'distanceKm',
            'distance'
          ]);
          const formatted = formatTrackDistanceLocal(raw);
          if (formatted) return formatted;
        }
        return '';
      };

      const runtimeLiveTrackLabelV1 = (liveTimingPayload) => {
        const server = liveTimingPayload?.ok ? liveTimingPayload.server : null;
        if (!server) return '';
        return [server.track, server.trackConfig].filter(Boolean).join(' ').trim();
      };

      const renderChampionship = async () => {
        const payload =
          await fetchJson('/api/community/acsr-championship') ||
          await fetchJson('/api/community/acsr-championship?refresh=1') ||
          await fetchJson('/api/acsm/championship') ||
          await fetchJson('/api/campeonato');

        const box = $('[data-home2-championship]');
        if (!box || !payload || payload.ok === false || !payload.championship) {
          renderChampionshipStandings([]);
          return;
        }

        const championship = payload.championship;
        const next = championship.nextEvent || null;
        const events = Array.isArray(championship.events) ? championship.events : [];
        const standings = Array.isArray(championship.standings) ? championship.standings : [];
        const drivers = Array.isArray(championship.registeredDrivers) ? championship.registeredDrivers : [];
        const stats = championship.stats || {};

        setText('[data-home2-champ-name]', championship.name || 'Campeonato ACSM');
        setText('[data-home2-champ-events]', stats.events ?? events.length ?? '--');
        setText('[data-home2-champ-completed]', stats.completedEvents ?? '--');
        setText('[data-home2-champ-classes]', stats.classes ?? '--');
        setText('[data-home2-champ-entrants]', stats.entrants ?? drivers.length ?? standings.length ?? '--');

        if (next) {
          const track = firstValue(next, ['canonicalTrackName', 'trackName', 'track.name', 'track.displayName', 'track', 'circuitName', 'track.slug', 'track.code']);
          const champTrackPresentation = await resolveHomeTrackPresentation({}, next);
          const carSummary = firstValue(next, ['carSummary']);
          const scheduledAt = firstValue(next, ['scheduledAt', 'date', 'Date', 'start', 'startTime']);
          setText('[data-home2-champ-next]', champTrackPresentation.trackDisplayName || next.name || `Ronda ${next.index || ''}`.trim() || 'Próxima ronda');
          setText('[data-home2-champ-date]', formatChampDate(scheduledAt));
          setText('[data-home2-champ-next-meta]', [champTrackPresentation.trackDisplayName || track, carSummary].filter(Boolean).join(' · ') || 'Próxima sesión');

          const champTrackImage = $('[data-home2-champ-track-image]');
          if (champTrackImage && (track || champTrackPresentation.trackAssetKeys.length)) {
            const candidates = champTrackPresentation.photoUrl
              ? [champTrackPresentation.photoUrl]
              : trackImageCandidates('photo', champTrackPresentation.trackAssetKeys);
            await setImageSafe(champTrackImage, candidates, '/ui/home2/gc-home2-track-fallback.svg', { kind: 'photo' });
          }
        } else {
          setText('[data-home2-champ-next]', 'Calendario activo');
          setText('[data-home2-champ-date]', 'Fecha por confirmar');
          setText('[data-home2-champ-next-meta]', 'Ver próximas sesiones');
        }

        renderChampionshipStandings(standings);
      };

      const init = async () => {
        const now = new Date();
        setText('[data-home2-updated]', `ACTUALIZADO ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`);

        const [homeSummaryPayload, liveTimingPayload] = await Promise.all([
          fetchFirstJson([
            '/api/gc/home-summary?limit=25',
            '/api/gc/active-combo?recentLimit=20&leaderboardLimit=25'
          ]),
          fetchJson('/api/live-timing', 2500)
        ]);

        const homeSummaryData = homeSummaryPayload?.data || {};
        const homeStats = homeSummaryPayload?.stats || homeSummaryData.stats || homeSummaryData.scopedStats || {};
        const diagnostics = homeSummaryPayload ? {
          ok: homeSummaryPayload.ok !== false,
          health: homeSummaryPayload.ok === false ? 'warning' : 'ok',
          raceData: homeStats,
          stats: homeStats
        } : null;
        const homeActiveCombo =
          homeSummaryPayload?.activeCombo ||
          homeSummaryData.activeCombo ||
          homeSummaryPayload?.combo ||
          {};
        const homeLeaderboard =
          homeSummaryPayload?.leaderboard ||
          homeSummaryPayload?.topComboTimes ||
          homeSummaryData.leaderboard ||
          homeActiveCombo?.leaderboard ||
          [];
        const homeRecentLaps =
          homeSummaryPayload?.recentLaps ||
          homeSummaryData.recentLaps ||
          homeSummaryData.laps ||
          [];
        const combosPayload = homeActiveCombo && Object.keys(homeActiveCombo).length
          ? { ok: true, activeCombo: homeActiveCombo, items: [homeActiveCombo] }
          : null;
        const recentPayload = { ok: true, items: homeRecentLaps, laps: homeRecentLaps };
        const leaderboardPayload = { ok: true, items: homeLeaderboard, leaderboard: homeLeaderboard, hotlaps: homeLeaderboard };
        const comboStandoutsPayloadPromise = Promise.resolve({ ok: true, items: [] });

        const raceData = diagnostics && (diagnostics.raceData || diagnostics.stats || diagnostics);
        if (raceData) {
          const totalLaps = firstValue(raceData, ['lapsCount', 'validLapsCount', 'totalLaps', 'hotlaps']);
          const drivers = firstValue(raceData, ['driversCount', 'pilotsCount', 'totalDrivers', 'pilots']);
          const active = diagnostics && (diagnostics.health === 'ok' || diagnostics.ok);
          setText('[data-home2-live]', active ? 'LIVE' : 'STATUS');
          setText('[data-home2-server-state]', active ? 'Online' : 'Revisar');
          if (drivers) setText('[data-home2-drivers]', drivers);
          if (totalLaps) setText('[data-home2-laps]', totalLaps);
        }

        const combo = getArray(combosPayload)[0] || combosPayload?.activeCombo || combosPayload?.combo || {};
        const liveServer = liveTimingPayload?.ok ? liveTimingPayload.server : null;
        const liveTrackLabel = runtimeLiveTrackLabelV1(liveTimingPayload);
        const comboForPresentation = {
          ...combo,
          liveTrackName: liveTrackLabel,
          trackMapUrl: liveServer?.mapUrl || '',
          track: combo?.track && typeof combo.track === 'object'
            ? { ...combo.track, mapUrl: liveServer?.mapUrl || combo.track.mapUrl || combo.track.map || '' }
            : combo?.track
        };
        const trackPresentation = await resolveHomeTrackPresentation(comboForPresentation);
        const rawTrackName = trackPresentation.rawTrackName || liveTrackLabel || 'Actualizando';
        const trackAssetName = trackPresentation.trackAssetKeys[0] || rawTrackName;
        let track = trackPresentation.trackDisplayName || 'Actualizando';
        const trackPresentationKey = getHomeTrackPresentationKey(trackPresentation);
        const presentationChanged = !homeTrackPresentationCache || homeTrackPresentationCache.key !== trackPresentationKey;
        const cars = firstValue(combo, ['publicComboCars', 'carNames', 'cars', 'mainVariantAllCars']);
        const carList = Array.isArray(cars) ? cars.map((car) => typeof car === 'string' ? car : firstValue(car, ['name', 'carName', 'displayName'])).filter(Boolean) : String(cars || '').split(',').map((s) => s.trim()).filter(Boolean);
        const totalComboLaps = firstValue(combo, ['totalLaps', 'validLaps', 'lapsCount', 'summary.totalLaps']);
        const comboDrivers = firstValue(combo, ['driversCount', 'pilotsCount', 'summary.driversCount']);
        const bestDriver = firstValue(combo, ['bestDriverName', 'bestPilotName', 'leaderboard.0.driverName', 'best.driverName']) || '--';
        const bestCar = firstValue(combo, ['bestCarName', 'best.carName', 'leaderboard.0.carName']) || carList[0] || '--';
        const bestTime = formatLap(firstValue(combo, ['bestLapTimeFormatted', 'bestLapFormatted', 'bestLapTime', 'bestLap', 'best.time', 'leaderboard.0.lapTime'])) || '--';
        const recentRows = getArray(recentPayload);
        const leaderboardRows = getArray(leaderboardPayload);
        const runtimeDistance = runtimeTrackDistanceFromRowsV1([
          ...recentRows,
          ...leaderboardRows,
          ...getArray(combo.laps),
          ...getArray(combo.bestLaps),
          ...getArray(combo.leaderboard)
        ], [rawTrackName, track, liveTrackLabel]);

        const inferredCountry = trackPresentation.countryCode || inferTrackCountry(track, comboForPresentation) || '--';
        const inferredCountryCode =
          countryCodeFromValue(inferredCountry) ||
          countryCodeFromValue(track) ||
          countryCodeFromValue(rawTrackName) ||
          '';
        // GC_HOME_TRACK_RESOLVER_V2_DISTANCE
        const rawTrackDistance = firstValue(combo, [
          'trackDistanceKm',
          'distanceKm',
          'track.distanceKm',
          'track.lengthKm',
          'track.length',
          'lengthKm',
          'trackLengthKm',
          'trackLength',
          'track.distance',
          'distance'
        ]);
        const directDistance = formatTrackDistanceLocal(rawTrackDistance);
        if (presentationChanged) {
          setText('[data-home2-track]', track);
          setText('[data-home2-now-title]', track);
          setCountryBadge(inferredCountryCode || '', inferredCountry);
          setText('[data-home2-now-country]', inferredCountryCode || '--');
          setText('[data-home2-now-distance]', trackPresentation.distanceText || directDistance || runtimeDistance || '--');
        }
        setText('[data-home2-cars]', carList.slice(0, 3).join(' / ') || 'Sin coches publicados');
        setText('[data-home2-now-cars]', String(carList.length || '--'));
        setText('[data-home2-best-driver]', bestDriver);
        setText('[data-home2-reference-driver]', bestDriver);
        setText('[data-home2-best-car]', bestCar);
        setText('[data-home2-reference-car]', bestCar);
        setText('[data-home2-best-time]', bestTime);
        setText('[data-home2-reference-time]', bestTime);
        if (totalComboLaps) setText('[data-home2-laps]', totalComboLaps);
        if (comboDrivers) setText('[data-home2-drivers]', comboDrivers);

        setText('[data-home2-server-active-cars]', String(carList.length || '--'));
        setText('[data-home2-server-best-time]', bestTime || '--');

        const bestAvatar = pilotAvatarUrl(combo.best || combo.leaderboard?.[0] || combo);
        $$('[data-home2-best-avatar], [data-home2-reference-avatar]').forEach((img) => img.src = bestAvatar);

        if (presentationChanged) {
          const photoCandidates = trackPresentation.photoUrl
            ? [trackPresentation.photoUrl]
            : trackImageCandidates('photo', trackPresentation.trackAssetKeys);
          await setImageSafe($('[data-home2-track-image]'), photoCandidates, '/ui/home2/gc-home2-track-fallback.svg', { kind: 'photo' });
          const mapCandidates = trackPresentation.mapUrl
            ? [trackPresentation.mapUrl]
            : trackImageCandidates('map', trackPresentation.trackAssetKeys);
          await setImageSafe($('[data-home2-track-map]'), mapCandidates, '/ui/home2/gc-home2-track-outline.svg', { kind: 'map' });
          homeTrackPresentationCache = { key: trackPresentationKey, presentation: trackPresentation };
        }

        const champTrackImageFallback = $('[data-home2-champ-track-image]');
        const heroTrackImage = $('[data-home2-track-image]');
        if (champTrackImageFallback && heroTrackImage && champTrackImageFallback.src.includes('gc-home2-track-fallback')) {
          champTrackImageFallback.src = heroTrackImage.currentSrc || heroTrackImage.src;
        }
        renderRows('[data-home2-recent-laps]', recentRows);
        await updateReliableServerPanel(recentRows, combo, raceData || {});

        const comboDetailLeaderboardRows = await fetchComboDetailLeaderboard(combo);
        const activeComboRankingRows = comboDetailLeaderboardRows.length
          ? comboDetailLeaderboardRows
          : comboRankingRowsFromCombo(combo, trackAssetName || rawTrackName || track, carList);
        const renderedComboRankingRows = renderComboRanking(activeComboRankingRows, trackAssetName || rawTrackName || track, carList, { preserveOnEmpty: true });
        if (!renderedComboRankingRows.length) {
          console.warn('[GC Home] Top Combo no se ha sobrescrito: faltan filas del combo activo', {
            track: trackAssetName || rawTrackName || track,
            cars: carList,
            comboRows: activeComboRankingRows.length
          });
        }


        const comboStandoutsPayload = await comboStandoutsPayloadPromise;
        renderRaceStandoutsV1([
          ...getArray(comboStandoutsPayload),
          ...leaderboardRows,
          ...getArray(combo.laps),
          ...getArray(combo.bestLaps),
          ...getArray(combo.leaderboard),
          ...recentRows
        ], trackAssetName || rawTrackName || track, carList);

        await Promise.all([
          renderChampionship(),
          renderArchive(track, carList)
        ]);
      };

      let homeLiveRefreshRunning = false;
      const runHomeLiveRefresh = async () => {
        if (homeLiveRefreshRunning) return;
        homeLiveRefreshRunning = true;
        try {
          await init();
        } finally {
          homeLiveRefreshRunning = false;
        }
      };

      runHomeLiveRefresh();
      window.setInterval(runHomeLiveRefresh, HOME_LIVE_REFRESH_MS);
    })();
  </script>
</MarketingLayout>
