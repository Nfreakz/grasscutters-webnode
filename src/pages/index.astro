        syncBestFromRow(cleanRows[0]);

        host.innerHTML = cleanRows.map((lap, index) => {
          const driver = firstValue(lap, ['driverName', 'pilotName', 'playerName', 'name', 'driver.displayName', 'driver.name', 'player.name', 'DriverName', 'steamName']) || 'Piloto';
          const car = firstValue(lap, ['carName', 'car', 'carDisplayName', 'carVisibleName', 'vehicle', 'car.displayName', 'car.name', 'Car']) || 'Coche';
          const rawTime = firstValue(lap, ['lapTimeFormatted', 'timeFormatted', 'formattedLapTime', 'bestLapTimeFormatted', 'lapTime', 'lapMs', 'lapTimeMs', 'time', 'bestLap', 'bestLapTime']);
          const avatar = pilotAvatarUrl(lap);
          const compactClass = index >= 3 ? ' gc-home2-combo-rank--compact' : '';

          return '<div class="gc-home2-combo-rank' + compactClass + '">' +
