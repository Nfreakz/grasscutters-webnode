        rawCandidates.push(
          firstValue(item, ['image', 'imageUrl', 'image_url', 'imagen_url', 'imagen', 'cover', 'coverUrl', 'cover_url', 'mediaUrl', 'media_url', 'featuredImage', 'featured_image', 'heroImage', 'hero_image', 'thumbnail', 'thumb', 'mainImage', 'main_image', 'localUrl', 'url'])
        );

        mediaItems.forEach((media) => {
          rawCandidates.push(firstValue(media, ['url', 'publicUrl', 'public_url', 'src', 'imageUrl', 'image_url', 'path', 'filename', 'fileName']));
        });

        const cleanSlug = slugify(slug || title);
        if (cleanSlug) {
          rawCandidates.push(
