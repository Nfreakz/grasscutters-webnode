        }).join('');

        return cleanRows;
      };




      const escapeAttr = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));

      const publicImageCandidates = (item = {}) => {
        const title = firstValue(item, ['title', 'nombre', 'name']) || '';
        const slug = firstValue(item, ['slug', 'seoSlug', 'seo_slug']) || slugify(title);
        const type = normalizeArchiveType(firstValue(item, ['tipo', 'type', 'category', 'categoria', 'kind']) || '');
        const rawCandidates = [];

        const mediaArray = Array.isArray(item?.media) ? item.media : [];
        const mediaItems = [
          mediaArray.find((media) => media && (media.isCover || media.is_cover || media.portada || media.role === 'cover' || media.kind === 'cover')),
          ...mediaArray
