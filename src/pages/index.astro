        const candidates = [...publicImageCandidates(item), fallbacks[index % fallbacks.length]];
        const primary = candidates[0];
        const rest = candidates.slice(1).map(escapeAttr).join('|');

        return `src="${escapeAttr(primary)}" data-fallbacks="${rest}" data-fallback-index="0" onerror="const list=(this.dataset.fallbacks||'').split('|').filter(Boolean); const i=Number(this.dataset.fallbackIndex||0); if(list[i]){this.dataset.fallbackIndex=String(i+1); this.src=list[i];} else {this.style.display='none';}"`;
      };

      const formatChampDate = (value) => {
        const date = parseDateValue(value);
        if (!date) return 'Fecha por confirmar';
        return date.toLocaleString('es-ES', {
          weekday: 'short',
          day: '2-digit',
          month: 'short',
          hour: '2-digit',
          minute: '2-digit'
        }).replace(',', '');
      };


      const numericValue = (value) => {
        if (typeof value === 'number' && Number.isFinite(value)) return value;
        if (typeof value === 'string' && value.trim() !== '') {
          const parsed = Number(value.replace(/[^\d.-]/g, ''));
          if (Number.isFinite(parsed)) return parsed;
        }
        return null;
      };

      const fetchJsonFirstWithSource = async (urls) => {
        for (const url of urls) {
