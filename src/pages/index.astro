  <script is:inline>
    /* GC_HOME_STATIC_HERO_TRACK_V1 */
    (() => {
      const root = document.querySelector('[data-gc-home2]');
      const image = document.querySelector('[data-home2-track-image]');
      if (!root || !image) return;

      let images = [];
      try {
        images = JSON.parse(root.getAttribute('data-home2-static-track-images') || '[]');
      } catch {
        images = [];
      }

      if (!Array.isArray(images) || images.length === 0) return;
      const selected = images[Math.floor(Math.random() * images.length)];
      window.__GC_HOME_STATIC_HERO_IMAGE__ = selected;

      const applySelected = () => {
        if (image.getAttribute('src') !== selected) image.setAttribute('src', selected);
      };

      applySelected();
      new MutationObserver(applySelected).observe(image, { attributes: true, attributeFilter: ['src'] });
    })();
