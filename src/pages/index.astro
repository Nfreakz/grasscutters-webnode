  <script is:inline src="/js/gc-track-images.js"></script>
  <script is:inline src="/js/gc-home-track-resolver.js?v=25-online-delivery"></script>
  <script is:inline define:vars={{ home2ArchiveSeed }}>
    window.__GC_HOME2_ARCHIVE__ = home2ArchiveSeed;
