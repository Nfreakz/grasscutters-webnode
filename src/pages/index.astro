          'totalDriverCount',
          'uniqueDrivers',
          'totalUniqueDrivers',
          'playersTotal',
          'pilotsTotal',
          'usersTotal',
          'driversCount',
          'pilotsCount'
        ]);
        return value !== null ? Math.max(0, Math.round(value)) : null;
      };

      const animateServerNumber = (selector, value, suffix = '') => {
        const el = $(selector);
        if (!el) return;

        const numeric = numericValue(value);
        if (numeric === null) {
          el.textContent = value ?? '--';
          return;
        }

        const target = Math.max(0, Math.round(numeric));
        const duration = 850;
        const start = performance.now();
        const formatter = new Intl.NumberFormat('es-ES');

        const step = (now) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          const current = Math.round(target * eased);
          el.textContent = `${formatter.format(current)}${suffix}`;
          if (t < 1) requestAnimationFrame(step);
        };

        el.textContent = suffix ? `0${suffix}` : '0';
        requestAnimationFrame(step);
      };

      const setServerMetric = (selector, value, suffix = '') => {
        if (value === null || value === undefined || value === '') {
          setText(selector, '--');
          return;
        }
        animateServerNumber(selector, value, suffix);
      };

      const serverMetricFromPayload = (payload, keys) => {
        if (!payload) return null;

        const direct = findDeepNumericServerV5(payload, keys);
