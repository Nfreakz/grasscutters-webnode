      border-color:rgba(191,73,255,.36);
      background:
        radial-gradient(circle at 72% 48%, rgba(191,73,255,.18), transparent 58%),
        radial-gradient(circle at 14% 54%, rgba(150,255,47,.12), transparent 46%);
      box-shadow:
        0 0 0 1px rgba(191,73,255,.16),
        0 0 32px rgba(191,73,255,.16),
        0 0 48px rgba(150,255,47,.08),
        inset 0 1px 0 rgba(255,255,255,.065);
    }

    .gc-home2 .gc-home2-combo-card__time{
      position:relative;
      isolation:isolate;
      will-change:transform, filter, opacity;
      transform-origin:center;
    }

    .gc-home2 .gc-home2-combo-card__time::after{
      content:"";
      position:absolute;
      inset:-18% -34%;
      z-index:-1;
      pointer-events:none;
      opacity:0;
      background:
        linear-gradient(100deg,
          transparent 0%,
          rgba(255,255,255,.10) 32%,
          rgba(191,73,255,.46) 47%,
          rgba(150,255,47,.34) 54%,
          rgba(255,255,255,.08) 66%,
          transparent 100%);
      filter:blur(7px);
      transform:translateX(-120%) skewX(-14deg);
    }

    .gc-home2 .gc-home2-combo-card__time.is-gc-best-lap-loaded{
      animation:gcBestLapGlowInV5 1180ms cubic-bezier(.16,1,.3,1) both;
    }

    .gc-home2 .gc-home2-combo-card__time.is-gc-best-lap-loaded::after{
      animation:gcBestLapSweepV5 860ms cubic-bezier(.18,.84,.2,1) 110ms both;
    }

    @keyframes gcBestLapGlowInV5{
      0%{
        opacity:.18;
        transform:translateY(7px) scale(.92);
        filter:brightness(.85) saturate(.92);
        text-shadow:0 0 0 rgba(191,73,255,0);
      }
      34%{
        opacity:1;
        transform:translateY(0) scale(1.055);
        filter:brightness(1.38) saturate(1.28);
        text-shadow:
          0 0 8px rgba(255,255,255,.24),
          0 0 18px rgba(191,73,255,.68),
          0 0 34px rgba(191,73,255,.42),
          0 0 46px rgba(150,255,47,.18);
      }
      62%{
        transform:scale(.988);
        filter:brightness(1.16) saturate(1.12);
        text-shadow:
          0 0 6px rgba(255,255,255,.16),
          0 0 16px rgba(191,73,255,.50),
          0 0 28px rgba(191,73,255,.28);
      }
      100%{
        opacity:1;
        transform:scale(1);
        filter:none;
        text-shadow:
          0 0 10px rgba(191,73,255,.20),
          0 0 20px rgba(191,73,255,.10);
      }
    }

    @keyframes gcBestLapSweepV5{
      0%{opacity:0; transform:translateX(-120%) skewX(-14deg);}
      22%{opacity:.86;}
      100%{opacity:0; transform:translateX(118%) skewX(-14deg);}
