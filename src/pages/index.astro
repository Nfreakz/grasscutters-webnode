  <script>
    (() => {
      const srBody = document.querySelector('[data-home2-sr-ratings]');
      const gsrBody = document.querySelector('[data-home2-gsr-ratings]');
      if (!srBody && !gsrBody) return;

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char]));

      const toNumber = (value) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : null;
      };

      const classKey = (value) => String(value || 'unknown')
        .trim()
        .toLowerCase()
        .replace('+', 'plus')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'unknown';

      const readRatingValue = (obj, keys = []) => {
        for (const key of keys) {
          const parts = String(key).split('.').filter(Boolean);
          let current = obj;
          for (const part of parts) current = current?.[part];
          if (current !== undefined && current !== null && current !== '') return current;
        }
        return '';
      };

      const ratingPilotAvatarUrl = (row) => {
        const direct = readRatingValue(row, ['avatarUrl', 'avatar_url', 'imageUrl', 'image', 'driver.avatarUrl', 'player.avatarUrl', 'pilot.avatarUrl']);
        if (direct) return String(direct);
        const id = readRatingValue(row, ['profilePlayerId', 'strackerPlayerId', 'pilotId', 'playerId', 'driverId', 'id', 'player.id', 'driver.id']);
        if (id !== undefined && id !== null && id !== '') return `/api/pilot-avatar/${encodeURIComponent(String(id))}`;
        return '/images/pilot-avatar-default.png';
      };

      const formatDriverName = (value) => String(value || 'Piloto').toUpperCase();

      const formatDelta = (value, digits = 1) => {
        const numeric = toNumber(value);
        if (numeric === null) return '--';
        const formatted = digits === 0 ? String(Math.round(numeric)) : numeric.toFixed(digits);
        return `${numeric > 0 ? '+' : ''}${formatted}`;
      };

      const deltaClass = (value) => {
        const numeric = toNumber(value);
        if (numeric === null || numeric === 0) return 'gc-home2-rating-delta is-neutral';
        return numeric > 0 ? 'gc-home2-rating-delta is-positive' : 'gc-home2-rating-delta is-negative';
      };

      const rankTone = (position) => {
        const numeric = Number(position);
        if (numeric === 1) return 'gold';
        if (numeric === 2) return 'silver';
        if (numeric === 3) return 'bronze';
        return '';
      };

      const renderRankBadge = (position) => {
        const numeric = Number(position);
        const safePosition = Number.isFinite(numeric) ? numeric : 0;
        if (safePosition === 1) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--gold gc-home2-ranking-medal" aria-label="1º">🥇</span>';
        if (safePosition === 2) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--silver gc-home2-ranking-medal" aria-label="2º">🥈</span>';
        if (safePosition === 3) return '<span class="gc-home2-rank-badge gc-home2-rank-badge--bronze gc-home2-ranking-medal" aria-label="3º">🥉</span>';
        return `<span class="gc-home2-rank-badge gc-home2-rank-badge--plain gc-home2-ranking-medal">${escapeHtml(position)}</span>`;
      };

      const ratingBadge = (type, label, score) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const safeLabel = String(label || '--');
        const scoreText = score === undefined || score === null || score === '' ? '' : `<small>${escapeHtml(score)}</small>`;
        return `
          <span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${classKey(safeLabel)} gc-rating-badge--compact" aria-label="${safeType.toUpperCase()} ${escapeHtml(safeLabel)} ${escapeHtml(score || '')}">
            <strong>${escapeHtml(safeLabel)}</strong>
            ${scoreText}
          </span>`;
      };

      const driverLink = (row) => {
        const name = formatDriverName(row?.driver || row?.name || 'Piloto');
        const directPlayerId = row?.profilePlayerId || row?.strackerPlayerId || '';
        const driverKey = String(row?.driverKey || '');
        const playerId = directPlayerId || (driverKey.startsWith('player:') ? driverKey.replace('player:', '') : '');
        const avatar = escapeHtml(ratingPilotAvatarUrl(row));
        const main = playerId
          ? `<a href="/pilotos/${encodeURIComponent(String(playerId))}">${escapeHtml(name)}</a>`
          : `<strong>${escapeHtml(name)}</strong>`;
        return `<div class="gc-home2-rating-driver-cell"><div class="gc-home2-rating-driver">${main}<small>${playerId ? 'Perfil público' : 'Piloto GC'}</small></div><img class="gc-home2-rating-driver-avatar" src="${avatar}" alt="" width="30" height="30" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/pilot-avatar-default.png';" /></div>`;
      };

      const renderRows = (target, rows, type) => {
        if (!target) return;
        const list = Array.isArray(rows) ? rows.slice(0, 5) : [];
        if (!list.length) {
          target.innerHTML = `<tr><td colspan="4">Sin datos de ${type.toUpperCase()}.</td></tr>`;
          return;
        }

        target.innerHTML = list.map((row, index) => {
          const isSr = type === 'sr';
          const score = isSr ? toNumber(row.sr) : toNumber(row.gsr);
          const scoreText = score === null ? '--' : (isSr ? score.toFixed(1) : String(Math.round(score)));
          const label = isSr ? row.srClass : row.gsrClass;
          const deltaDigits = isSr ? 1 : 0;

          const position = row.position ?? index + 1;
          const tone = rankTone(position);
          const rowClass = ` class="gc-home2-rating-row${tone ? ` gc-home2-rating-row--podium gc-home2-rating-row--${tone}` : ' gc-home2-rating-row--plain'}"`;

          return `
            <tr${rowClass}>
              <td>${renderRankBadge(position)}</td>
              <td>${driverLink(row)}</td>
              <td>${ratingBadge(type, label || '--', scoreText)}</td>
              <td><span class="${deltaClass(row.lastDelta)}">${escapeHtml(formatDelta(row.lastDelta, deltaDigits))}</span></td>
            </tr>`;
        }).join('');
      };

      async function loadHomeRatings() {
        try {
          const response = await fetch('/api/gc/ratings/championship', { headers: { Accept: 'application/json' } });
          const data = await response.json();
          if (!data?.ok) throw new Error(data?.message || 'Ratings no disponibles.');
          renderRows(srBody, data.leaderboard?.sr || [], 'sr');
          renderRows(gsrBody, data.leaderboard?.gsr || [], 'gsr');
        } catch (error) {
          if (srBody) srBody.innerHTML = '<tr><td colspan="4">No se pudo cargar SR.</td></tr>';
          if (gsrBody) gsrBody.innerHTML = '<tr><td colspan="4">No se pudo cargar GSR.</td></tr>';
          console.warn('[GC Home] No se pudieron cargar ratings', error);
        }
      }

      window.setTimeout(loadHomeRatings, 1500);
    })();
  </script>
  <script>
    /* GC_HOME_PACK_5_12_STABLE_SINGLE_SOURCE_LOADER_START */
    (() => {
      const PACK = '5.12';
      const root = document.querySelector('[data-gc-home2]');
      if (!root) return;

      if (window.__GC_HOME_STABLE_SINGLE_SOURCE_LOADER__) {
        console.warn(`[GC Home ${PACK}] loader duplicado ignorado`);
        return;
      }
      window.__GC_HOME_STABLE_SINGLE_SOURCE_LOADER__ = true;

      const REFRESH_MS = 60000;
      const DEFAULT_AVATAR = '/images/pilot-avatar-default.png';
      const FALLBACK_TRACK = '/ui/home2/gc-home2-track-fallback.svg';
      let refreshTimer = 0;
      let running = false;
      let runSeq = 0;
      const lastGood = { mainRows: [], gt4Rows: [], recentRows: [], mainPayload: null, gt4Payload: null };

      const q = (selector, scope = root) => scope?.querySelector?.(selector) || null;
      const qa = (selector, scope = root) => Array.from(scope?.querySelectorAll?.(selector) || []);
      const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
      const normalize = (value) => String(value ?? '')
        .toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/&/g, ' and ')
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '');

      const first = (obj, keys, fallback = '') => {
        for (const key of keys) {
          const parts = String(key).split('.');
          let cur = obj;
          for (const part of parts) {
            if (cur == null) break;
            cur = cur[part];
          }
          if (cur !== undefined && cur !== null && String(cur).trim() !== '') return cur;
        }
        return fallback;
      };

      const setText = (selector, value, scope = root) => {
        const text = value === undefined || value === null || value === '' ? '--' : String(value);
        qa(selector, scope).forEach((el) => { el.textContent = text; });
      };

      const getArray = (payload) => {
        if (!payload) return [];
        if (Array.isArray(payload)) return payload;
        const candidates = [
          payload.items,
          payload.laps,
          payload.hotlaps,
          payload.leaderboard,
          payload.topComboTimes,
          payload.recentLaps,
          payload.data?.items,
          payload.data?.laps,
          payload.data?.hotlaps,
          payload.data?.leaderboard,
          payload.data?.recentLaps,
          payload.data?.activeCombo?.leaderboard,
          payload.activeCombo?.leaderboard,
          payload.combo?.leaderboard,
          payload.results,
          payload.data?.results
        ];
        for (const item of candidates) if (Array.isArray(item)) return item;
        return [];
      };

      const activeCombo = (payload) => payload?.data?.activeCombo || payload?.activeCombo || payload?.combo || payload?.data?.combo || null;
      const comboLeaderboard = (payload) => {
        const combo = activeCombo(payload);
        const rows = [
          payload?.data?.leaderboard,
          payload?.leaderboard,
          payload?.topComboTimes,
          combo?.leaderboard,
          combo?.bestLaps,
          payload?.data?.activeCombo?.leaderboard,
          payload?.data?.activeCombo?.bestLaps,
          payload?.data?.items,
          payload?.items
        ];
        for (const item of rows) if (Array.isArray(item) && item.length) return item;
        return [];
      };

      const fetchJson = async (url, timeoutMs = 12000) => {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), timeoutMs);
        try {
          const response = await fetch(url, {
            headers: { Accept: 'application/json' },
            signal: controller.signal,
            cache: 'no-store'
          });
          if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
          return await response.json();
        } finally {
          window.clearTimeout(timer);
        }
      };

      const fetchFirst = async (urls, timeoutMs = 12000) => {
        let lastError = null;
        for (const url of urls) {
          try {
            const data = await fetchJson(url, timeoutMs);
            if (data && data.ok !== false) return data;
            lastError = new Error(data?.message || 'Respuesta sin ok');
          } catch (error) {
            lastError = error;
          }
        }
        if (lastError) throw lastError;
        return null;
      };

      const parseTimeMs = (value) => {
        if (value === undefined || value === null || value === '') return null;
        if (typeof value === 'number' && Number.isFinite(value)) return value > 0 ? value : null;
        const raw = String(value).trim();
        if (!raw || raw === '--') return null;
        if (/^\d+(\.\d+)?$/.test(raw)) {
          const n = Number(raw);
          if (Number.isFinite(n)) return n > 1000 ? n : Math.round(n * 1000);
        }
        const parts = raw.split(':').map((part) => part.trim());
        if (parts.length >= 2) {
          const minutes = Number(parts[0]);
          const seconds = Number(parts[1].replace(',', '.'));
          if (Number.isFinite(minutes) && Number.isFinite(seconds)) return Math.round((minutes * 60 + seconds) * 1000);
        }
        return null;
      };

      const rowTimeMs = (row) => parseTimeMs(first(row, ['lapTimeMs', 'lap_time_ms', 'LapTime', 'lapTime', 'timeMs', 'bestLapMs', 'best_lap_ms', 'time', 'lapTimeFormatted', 'lapTimeText']));
      const formatTime = (input) => {
        const ms = typeof input === 'object' && input ? rowTimeMs(input) : parseTimeMs(input);
        if (!Number.isFinite(ms)) return typeof input === 'string' && input.trim() ? input : '--';
        const total = Math.max(0, Math.round(ms));
        const minutes = Math.floor(total / 60000);
        const seconds = Math.floor((total % 60000) / 1000);
        const millis = total % 1000;
        return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
      };

      const timestampMs = (row) => {
        const raw = first(row, ['timestamp', 'timestampMs', 'timestamp_ms', 'Timestamp', 'date', 'dateIso', 'timestampIso', 'Date', 'lastSeenTimestamp', 'last_lap_unix']);
        if (typeof raw === 'number' && Number.isFinite(raw)) return raw > 20000000000 ? raw : raw * 1000;
        if (raw) {
          const n = Number(raw);
          if (Number.isFinite(n)) return n > 20000000000 ? n : n * 1000;
          const parsed = Date.parse(String(raw));
          if (Number.isFinite(parsed)) return parsed;
        }
        return 0;
      };

      const ago = (row) => {
        const ms = timestampMs(row);
        if (!ms) return '--';
        const diff = Math.max(0, Date.now() - ms);
        const minutes = Math.floor(diff / 60000);
        if (minutes < 1) return 'ahora';
        if (minutes < 60) return `${minutes} min`;
        const hours = Math.floor(minutes / 60);
        if (hours < 48) return `${hours} h`;
        return `${Math.floor(hours / 24)} d`;
      };

      const driverName = (row) => first(row, ['driverName', 'driver_name', 'playerName', 'player_name', 'DriverName', 'Name', 'name', 'pilotName', 'driver.name', 'driver.displayName'], '--');
      const carName = (row) => first(row, ['carName', 'car_name', 'carDisplay', 'car_display', 'carCode', 'car_code', 'Car', 'car.name', 'car.displayName', 'vehicleName'], '--');
      const trackName = (row) => first(row, ['trackName', 'track_name', 'trackDisplay', 'track_display', 'trackCode', 'track_code', 'Track', 'track.name', 'track.displayName'], '--');
      const sourceKey = (row, fallback = '') => String(first(row, ['sourceKey', 'source_key', 'source', 'serverKey'], fallback) || fallback || '').toLowerCase();
      const avatar = (row) => first(row, ['avatarUrl', 'avatar_url', 'pilotAvatarUrl', 'driver.avatarUrl', 'avatar'], DEFAULT_AVATAR);
      const isValid = (row) => {
        const value = first(row, ['valid', 'Valid', 'isValid', 'is_valid'], true);
        return !(value === false || value === 0 || value === '0' || String(value).toLowerCase() === 'false');
      };

      const bestPerDriver = (rows) => {
        const pool = Array.isArray(rows) ? rows.filter((row) => Number.isFinite(rowTimeMs(row))) : [];
        const valid = pool.filter(isValid);
        const source = valid.length ? valid : pool;
        const map = new Map();
        for (const row of source) {
          const key = normalize(driverName(row)) || String(first(row, ['playerId', 'driverId', 'rawPlayerId'], Math.random()));
          const current = map.get(key);
          if (!current || rowTimeMs(row) < rowTimeMs(current)) map.set(key, row);
        }
        return [...map.values()].sort((a, b) => rowTimeMs(a) - rowTimeMs(b));
      };

      const comboTrack = (combo, rows = []) => first(combo, ['track.displayName', 'track.name', 'trackName', 'trackCode', 'track.code', 'circuitName', 'name'], trackName(rows[0] || {}));
      const comboCars = (combo, rows = []) => {
        const cars = first(combo, ['cars', 'publicComboCars', 'carNames', 'mainVariantAllCars'], null);
        if (Array.isArray(cars)) {
          const out = cars.map((car) => typeof car === 'string' ? car : first(car, ['displayName', 'name', 'carName', 'code'])).filter(Boolean);
          if (out.length) return out;
        }
        const summary = first(combo, ['carSummary', 'carsSummary', 'carName'], '');
        if (summary) return String(summary).split(/[,+/]/).map((item) => item.trim()).filter(Boolean);
        return [...new Set(rows.map(carName).filter((v) => v && v !== '--'))];
      };

      const matchesCombo = (row, combo, source) => {
        if (source && sourceKey(row, source) && sourceKey(row, source) !== source) return false;
        const cTrack = normalize(comboTrack(combo, [row]));
        const rTrack = normalize(trackName(row));
        const cCars = comboCars(combo, [row]).map(normalize).filter(Boolean);
        const rCar = normalize(carName(row));
        const trackOk = !cTrack || !rTrack || cTrack === rTrack || cTrack.includes(rTrack) || rTrack.includes(cTrack);
        const carOk = !cCars.length || !rCar || cCars.some((car) => car === rCar || car.includes(rCar) || rCar.includes(car));
        return trackOk && carOk;
      };

      const rowsForPanel = (activePayload, fallbackHotlaps, source) => {
        const combo = activeCombo(activePayload);
        const primary = comboLeaderboard(activePayload).map((row) => ({ ...row, sourceKey: source }));
        if (primary.length) return bestPerDriver(primary);
        const fallback = getArray(fallbackHotlaps).map((row) => ({ ...row, sourceKey: source }));
        const scoped = combo ? fallback.filter((row) => matchesCombo(row, combo, source)) : fallback;
        return bestPerDriver(scoped);
      };

      const rankBadge = (index) => index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : String(index + 1);
      const renderRanking = (selector, rows, preserve = true) => {
        const host = q(selector);
        if (!host) return [];
        const list = bestPerDriver(rows).slice(0, 8);
        if (!list.length) {
          if (!preserve || !host.dataset.gcHydrated) {
            host.innerHTML = `<div class="gc-home2-combo-rank gc-home2-combo-rank--loading"><span class="gc-home2-rank-badge">--</span><div><strong>--</strong><small>Sin vueltas para el combo activo</small></div><img class="gc-home2-combo-rank__avatar" src="${DEFAULT_AVATAR}" alt="" width="24" height="24" loading="lazy" decoding="async" /><em>--</em></div>`;
          }
          return [];
        }
        host.dataset.gcHydrated = '1';
        host.innerHTML = list.map((row, index) => `
          <div class="gc-home2-combo-rank">
            <span class="gc-home2-rank-badge">${rankBadge(index)}</span>
            <div><strong>${esc(driverName(row))}</strong><small>${esc(carName(row))}</small></div>
            <img class="gc-home2-combo-rank__avatar" src="${esc(avatar(row))}" alt="" width="24" height="24" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='${DEFAULT_AVATAR}';" />
            <em>${esc(formatTime(row))}</em>
          </div>`).join('');
        return list;
      };

      const renderRecent = (payload, fallbackMain, fallbackGt4) => {
        const host = q('[data-home2-recent-laps]');
        if (!host) return [];
        let rows = getArray(payload);
        if (!rows.length) rows = [...getArray(fallbackMain), ...getArray(fallbackGt4)];
        const seen = new Set();
        const list = rows
          .filter((row) => timestampMs(row) > 0)
          .map((row) => ({ ...row, sourceKey: sourceKey(row, '') || (String(carName(row)).toLowerCase().includes('supra') ? 'gt4' : 'main') }))
          .filter((row) => {
            const key = first(row, ['lapUid', 'uid', 'id', 'lapId'], '') || `${sourceKey(row)}:${driverName(row)}:${carName(row)}:${formatTime(row)}:${timestampMs(row)}`;
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          })
          .sort((a, b) => timestampMs(b) - timestampMs(a))
          .slice(0, 8);
        if (!list.length) return [];
        host.dataset.gcHydrated = '1';
        host.innerHTML = list.map((row) => {
          const src = sourceKey(row, 'main') === 'gt4' ? 'GT4' : 'LIGA';
          return `<div class="gc-home2-table__row" role="row"><span>${esc(driverName(row))}</span><span><small class="gc-home2-source-pill gc-home2-source-pill--${src === 'GT4' ? 'gt4' : 'main'}">${src}</small> ${esc(carName(row))}</span><strong>${esc(formatTime(row))}</strong><small>${esc(ago(row))}</small></div>`;
        }).join('');
        return list;
      };

      const setImageWithFallbacks = (img, candidates, fallback = FALLBACK_TRACK) => {
        if (!img) return;
        const list = [...new Set(candidates.filter(Boolean))];
        let index = 0;
        const apply = () => {
          const next = list[index++] || fallback;
          img.onerror = () => {
            if (index <= list.length) apply();
            else {
              img.onerror = null;
              img.src = fallback;
            }
          };
          if (img.getAttribute('src') !== next) img.src = next;
        };
        apply();
      };

      const trackImageCandidates = (name) => {
        const key = normalize(name);
        const out = [];
        if (/pascani|motorpark|00_pascani|a1/.test(key)) out.push('/images/tracks/pascani.jpg?v=512', '/images/tracks/a1.webp?v=512');
        if (/vila|vilareal|vila_real/.test(key)) out.push('/images/tracks/vilareal.jpg?v=512');
        const simple = key.replace(/^00_/, '').replace(/_motorpark.*$/, '').replace(/_hungary$/, '');
        if (simple) out.push(`/images/tracks/${simple}.webp`, `/images/tracks/${simple}.jpg`, `/images/tracks/${simple}.png`);
        return out;
      };

      const setHero = (mainPayload, rankingRows) => {
        const combo = activeCombo(mainPayload) || {};
        const rows = rankingRows.length ? rankingRows : comboLeaderboard(mainPayload);
        const best = rows[0] || first(combo, ['bestLap', 'summary.bestLap'], null) || {};
        const track = comboTrack(combo, rows);
        const cars = comboCars(combo, rows);
        setText('[data-home2-track]', track || 'Combo activo');
        setText('[data-home2-cars]', cars.slice(0, 3).join(' / ') || carName(best));
        setText('[data-home2-best-driver]', driverName(best));
        setText('[data-home2-best-car]', carName(best));
        setText('[data-home2-best-time]', formatTime(best));
        qa('[data-home2-best-avatar]').forEach((img) => { img.src = avatar(best); });
        setImageWithFallbacks(q('[data-home2-track-image]'), trackImageCandidates(track));
      };

      const renderPulse = (mainPayload, mainHotlaps) => {
        const combo = activeCombo(mainPayload) || {};
        const rows = getArray(mainPayload?.data?.recentLaps || mainPayload?.recentLaps).length
          ? getArray(mainPayload?.data?.recentLaps || mainPayload?.recentLaps)
          : getArray(mainHotlaps).filter((row) => matchesCombo(row, combo, 'main'));
        const leaderboard = comboLeaderboard(mainPayload);
        const total = Number(first(combo, ['summary.totalLaps', 'totalLaps', 'stats.totalLaps'], rows.length)) || rows.length;
        const valid = Math.min(total, Number(first(combo, ['summary.validLaps', 'validLaps', 'stats.validLaps'], rows.filter(isValid).length)) || rows.filter(isValid).length);
        const best = (leaderboard.length ? bestPerDriver(leaderboard) : bestPerDriver(rows))[0] || {};
        const latest = [...rows].sort((a, b) => timestampMs(b) - timestampMs(a))[0] || {};
        const counts = new Map();
        rows.forEach((row) => counts.set(driverName(row), (counts.get(driverName(row)) || 0) + 1));
        const most = [...counts.entries()].sort((a, b) => b[1] - a[1])[0];
        const vmax = Math.max(0, ...rows.map((row) => Number(first(row, ['maxSpeedKmh', 'vmax', 'maxSpeed', 'speedKmh'], 0)) || 0));
        const leaders = bestPerDriver(leaderboard.length ? leaderboard : rows).slice(0, 2);
        const diff = leaders.length >= 2 && Number.isFinite(rowTimeMs(leaders[0])) && Number.isFinite(rowTimeMs(leaders[1]))
          ? `+${((rowTimeMs(leaders[1]) - rowTimeMs(leaders[0])) / 1000).toFixed(3)}s`
          : '--';
        setText('[data-home2-standout-most-laps]', most?.[0] || driverName(best));
        setText('[data-home2-standout-most-laps-meta]', `${total || '--'} vueltas · ${valid || 0} válidas`);
        setText('[data-home2-standout-best-average]', driverName(best));
        setText('[data-home2-standout-best-average-meta]', `${formatTime(best)} mejor vuelta`);
        setText('[data-home2-standout-cleanest]', total ? `${Math.max(0, Math.min(100, Math.round((valid / total) * 100)))}%` : '--');
        setText('[data-home2-standout-cleanest-meta]', 'limpieza del combo');
        setText('[data-home2-standout-vmax]', vmax ? `${Math.round(vmax)} km/h` : '--');
        setText('[data-home2-standout-vmax-meta]', `${driverName(rows.find((row) => Math.round(Number(first(row, ['maxSpeedKmh', 'vmax', 'maxSpeed', 'speedKmh'], 0)) || 0) === Math.round(vmax)) || {})} · velocidad en combo`);
        setText('[data-home2-standout-last-driver]', driverName(latest));
        setText('[data-home2-standout-last-driver-meta]', `${ago(latest)} · última del combo`);
        setText('[data-home2-standout-duel]', diff);
        setText('[data-home2-standout-duel-meta]', 'diferencias del combo');
      };

      const champRoot = (payload) => payload?.championship || payload?.data?.championship || payload?.data || payload || {};
      const arr = (...items) => items.find((item) => Array.isArray(item)) || [];
      const champEvents = (payload) => {
        const c = champRoot(payload);
        return arr(c.events, c.calendar, payload?.events, payload?.data?.events);
      };
      const champRows = (payload) => {
        const c = champRoot(payload);
        return arr(c.standings, payload?.standings, payload?.data?.standings, c.registeredDrivers, payload?.registeredDrivers, payload?.data?.registeredDrivers);
      };
      const champName = (row, index) => first(row, ['driverName', 'name', 'displayName', 'pilotName', 'DriverName', 'user.name'], `Piloto ${index + 1}`);
      const champPts = (row) => first(row, ['points', 'pts', 'totalPoints', 'score'], '0');
      const champDate = (raw) => {
        if (!raw) return 'Fecha por confirmar';
        const d = new Date(raw);
        if (Number.isNaN(d.getTime())) return String(raw);
        return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'numeric' }) + ', ' + d.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
      };
      const renderChampionship = async (source) => {
        const block = q(`[data-home2-championship][data-home2-championship-source="${source}"]`);
        if (!block) return { source, ok: false, reason: 'missing-block' };
        try {
          const payload = await fetchFirst([
            `/api/community/acsr-championship?source=${encodeURIComponent(source)}&home=1&t=${Date.now()}`,
            `/api/community/acsr-championship?source=${encodeURIComponent(source)}&refresh=1&home=1&t=${Date.now()}`
          ], 12000);
          const c = champRoot(payload);
          const events = champEvents(payload);
          const rows = champRows(payload);
          const stats = c.stats || payload.stats || payload.data?.stats || {};
          const next = c.nextEvent || payload.nextEvent || payload.data?.nextEvent || events.find((event) => String(first(event, ['status', 'Status'], '')).toLowerCase() !== 'completed') || events[0] || null;
          setText('[data-home2-champ-name]', first(c, ['name', 'title'], source === 'gt4' ? 'GC Toyota Supra GT4' : 'Liga GrassCutters'), block);
          setText('[data-home2-champ-events]', first(stats, ['events'], events.length || '--'), block);
          setText('[data-home2-champ-completed]', first(stats, ['completedEvents', 'completed'], events.filter((event) => String(first(event, ['status', 'Status'], '')).toLowerCase() === 'completed').length || '--'), block);
          setText('[data-home2-champ-entrants]', first(stats, ['entrants'], rows.length || '--'), block);
          setText('[data-home2-champ-classes]', first(stats, ['classes'], Array.isArray(c.classes) ? c.classes.length : '--'), block);
          if (next) {
            const title = first(next, ['trackName', 'track', 'name', 'Name', 'title'], source === 'gt4' ? 'Pascani Motorpark A' : 'Próximo evento');
            const date = first(next, ['scheduledAt', 'date', 'Date', 'start', 'startTime'], '');
            const car = first(next, ['carSummary', 'cars', 'carName', 'car'], '');
            setText('[data-home2-champ-next]', title, block);
            setText('[data-home2-champ-date]', champDate(date), block);
            setText('[data-home2-champ-next-meta]', [title, car].filter(Boolean).join(' · ') || 'Próxima sesión', block);
            const imageLabel = source === 'gt4' ? `${title} pascani a1 00_pascani_motorpark-a1` : title;
            setImageWithFallbacks(q('[data-home2-champ-track-image]', block), trackImageCandidates(imageLabel));
          }
          const host = q('[data-home2-champ-drivers]', block);
          if (host && rows.length) {
            host.dataset.gcHydrated = '1';
            host.innerHTML = rows.slice(0, 6).map((row, index) => `<div class="gc-home2-champ-standing-row${index < 3 ? ` gc-home2-champ-standing-row--podium gc-home2-champ-standing-row--${['gold','silver','bronze'][index]}` : ' gc-home2-champ-standing-row--plain'}"><span class="gc-home2-champ-standing-pos">${rankBadge(index)}</span><div class="gc-home2-champ-standing-meta"><strong>${esc(champName(row, index))}</strong><small>General</small></div><span class="gc-home2-champ-standing-points"><strong>${esc(champPts(row))}</strong><small>pts</small></span><img class="gc-home2-champ-standing-avatar" src="${esc(avatar(row))}" alt="" width="30" height="30" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='${DEFAULT_AVATAR}';" /></div>`).join('');
          }
          return { source, ok: true, events: events.length, rows: rows.length };
        } catch (error) {
          console.warn(`[GC Home ${PACK}] campeonato no disponible`, source, error);
          return { source, ok: false, reason: String(error?.message || error) };
        }
      };

      const refresh = async () => {
        const seq = ++runSeq;
        const stamp = Date.now();
        setText('[data-home2-updated]', `ACTUALIZADO ${new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}`);
        const [mainActive, gt4Active, mainHotlaps, gt4Hotlaps, allHotlaps] = await Promise.all([
          fetchFirst([`/api/gc/active-combo?source=main&recentLimit=50&leaderboardLimit=50&home=1&t=${stamp}`, `/api/gc/home-summary?source=main&limit=25&home=1&t=${stamp}`]),
          fetchFirst([`/api/gc/active-combo?source=gt4&recentLimit=50&leaderboardLimit=50&home=1&t=${stamp}`, `/api/gc/home-summary?source=gt4&limit=25&home=1&t=${stamp}`]),
          fetchJson(`/api/gc/hotlaps2?source=main&limit=120&home=1&t=${stamp}`),
          fetchJson(`/api/gc/hotlaps2?source=gt4&limit=120&home=1&t=${stamp}`),
          fetchJson(`/api/gc/hotlaps2?source=all&limit=120&home=1&t=${stamp}`)
        ]);
        if (seq !== runSeq) return;

        const mainRows = rowsForPanel(mainActive, mainHotlaps, 'main');
        const gt4Rows = rowsForPanel(gt4Active, gt4Hotlaps, 'gt4');
        const renderedMain = renderRanking('[data-home2-combo-ranking]', mainRows, true);
        const renderedGt4 = renderRanking('[data-home2-combo-ranking-gt4]', gt4Rows, true);
        const recentRows = renderRecent(allHotlaps, mainHotlaps, gt4Hotlaps);
        setHero(mainActive, renderedMain.length ? renderedMain : mainRows);
        renderPulse(mainActive, mainHotlaps);
        const championshipResults = await Promise.all([renderChampionship('weekly'), renderChampionship('gt4')]);

        lastGood.mainRows = renderedMain;
        lastGood.gt4Rows = renderedGt4;
        lastGood.recentRows = recentRows;
        lastGood.mainPayload = mainActive;
        lastGood.gt4Payload = gt4Active;

        console.info(`[GC Home ${PACK} Stable]`, {
          calls: 7,
          mainActive: comboTrack(activeCombo(mainActive), renderedMain),
          gt4Active: comboTrack(activeCombo(gt4Active), renderedGt4),
          mainRows: renderedMain.length,
          gt4Rows: renderedGt4.length,
          timingRows: recentRows.length,
          championships: championshipResults
        });
      };

      const run = async () => {
        if (running) return;
        running = true;
        try {
          await refresh();
        } catch (error) {
          console.error(`[GC Home ${PACK} Stable] error`, error);
          if (lastGood.mainRows.length) renderRanking('[data-home2-combo-ranking]', lastGood.mainRows, true);
          if (lastGood.gt4Rows.length) renderRanking('[data-home2-combo-ranking-gt4]', lastGood.gt4Rows, true);
          if (lastGood.recentRows.length) renderRecent(lastGood.recentRows, [], []);
        } finally {
          running = false;
        }
      };

      window.GCHomeStableV512 = { refresh: run };
      run();
      refreshTimer = window.setInterval(run, REFRESH_MS);
      window.__GC_HOME_STABLE_INTERVAL__ = refreshTimer;
    })();
    /* GC_HOME_PACK_5_12_STABLE_SINGLE_SOURCE_LOADER_END */
  </script>

