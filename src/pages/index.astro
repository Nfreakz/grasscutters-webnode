---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PublicHeroFrame from '../components/public/PublicHeroFrame.astro';
import '../styles/public/gc-rating-badges.css';
const title = 'GrassCutters Racing | Sim racing, hotlaps y comunidad';
const description = 'GrassCutters Racing: comunidad de sim racing con servidor, combos, hotlaps, archivo motorsport y herramientas para pilotos.';

const home2ToolLinks = {
  hud: 'https://www.overtake.gg/downloads/grasscutters-lua-hud-lite.84201/',
  android: '/app-android',
  carsDrive: 'https://drive.google.com/drive/folders/1BXJJkPOo7ZuhIKf_VegI5g8serZsJw7W?usp=drive_link',
  tracksDrive: 'https://drive.google.com/drive/folders/1xSrI8aPBLH15wrytkR-IUjMQPWEVyfQw?usp=drive_link',
  profile: '/perfil',
  hotlaps: '/hotlaps',
  combos: '/combos',
  championship: '/campeonato',
};

const home2ArchiveSeed = [];


---

<!-- GC_PROMOTE_HOME2_TO_MAIN_HOME_V1 -->
<MarketingLayout title={title} description={description} canonicalPath="/" ogImage="/og/home-og-v1531.png" ogImageAlt="GrassCutters Racing">
  <main class="gc-home2 gc-home2--main-home" data-gc-home2="hybrid-v4">
    <section class="gc-home2-hero" aria-labelledby="gc-home2-title">
      <img
        class="gc-home2-hero__bg"
        data-home2-track-image
        src="/ui/home2/gc-home2-track-fallback.svg"
        alt=""
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
      />
      <div class="gc-home2-hero__overlay" aria-hidden="true"></div>
      <div class="gc-home2-hero__grid" aria-hidden="true"></div>

      <div class="gc-home2-shell gc-home2-hero__shell">
        <div class="gc-home2-hero__copy">
          <PublicHeroFrame
            id="gc-home2-title"
            kicker="GRASSCUTTERS RACE CONTROL"
            title={['Vive la', 'competición']}
            lead="Cada vuelta cuenta"
          />

          <div class="gc-home2-statusline" aria-label="Estado de la plataforma">
            <span class="gc-home2-badge gc-home2-badge--live" data-home2-live>LIVE</span>
            <span class="gc-home2-badge">TRACKER OK</span>
            <span class="gc-home2-badge" data-home2-updated>ACTUALIZANDO</span>
          </div>

          <div class="gc-home2-hero__actions">
            <a class="gc-home2-btn gc-home2-btn--primary" href="https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153" target="_blank" rel="noreferrer">
              Entrar al servidor
              <span aria-hidden="true">→</span>
            </a>
            <a class="gc-home2-btn gc-home2-btn--ghost" href="/app">Ver plataforma</a>
          </div>
        </div>

        <article class="gc-home2-combo-card" aria-labelledby="gc-home2-combo-title">
          <p class="gc-home2-combo-card__label">Combo activo</p>
          <h2 id="gc-home2-combo-title" data-home2-track>Actualizando</h2>
          <p class="gc-home2-combo-card__cars" data-home2-cars>Esperando datos del combo</p>

          <div class="gc-home2-combo-card__best">
            <div class="gc-home2-driver gc-home2-driver--compact">
              <div class="gc-home2-driver__avatar">
                <img data-home2-best-avatar src="/images/pilot-avatar-default.png" alt="" width="70" height="70" loading="lazy" decoding="async" />
                <span class="gc-home2-driver__dot" aria-hidden="true"></span>
              </div>
              <div class="gc-home2-driver__meta">
                <span class="gc-home2-card-label">Mejor vuelta</span>
                <strong data-home2-best-driver>--</strong>
                <small data-home2-best-car>--</small>
              </div>
            </div>
            <div class="gc-home2-combo-card__time" data-home2-best-time>--</div>
          </div>

          <a class="gc-home2-btn gc-home2-btn--primary gc-home2-combo-card__cta" href="https://acstuff.ru/s/q:race/online/join?httpPort=8381&ip=145.239.131.153" target="_blank" rel="noreferrer">
            Entrar al servidor
            <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </section>
    <!-- GC_HOME2_SWAP_RACE_CONTROL_COMBO_CAROUSEL_V5_HTML -->
    <section class="gc-home2-combo-strip gc-home2-shell" aria-label="Combo pulse del último combo">
      <div class="gc-home2-combo-strip__rail">
        <div class="gc-home2-combo-strip__title">
          <span class="gc-home2-server-dot" aria-hidden="true"></span>
          <strong>Combo Pulse</strong>
        </div>

        <div class="gc-home2-combo-marquee" aria-live="polite">
          <dl class="gc-home2-combo-marquee-track">
            <div>
              <dt>Rodador</dt>
              <dd data-home2-standout-most-laps>--</dd>
              <small data-home2-standout-most-laps-meta>vueltas del combo</small>
            </div>
            <div>
              <dt>Ritmo</dt>
              <dd data-home2-standout-best-average>--</dd>
              <small data-home2-standout-best-average-meta>media del combo</small>
            </div>
            <div>
              <dt>Limpio</dt>
              <dd data-home2-standout-cleanest>--</dd>
              <small data-home2-standout-cleanest-meta>limpieza del combo</small>
            </div>
            <div>
              <dt>Vmax</dt>
              <dd data-home2-standout-vmax>--</dd>
              <small data-home2-standout-vmax-meta>velocidad en combo</small>
            </div>
            <div>
              <dt>Última</dt>
              <dd data-home2-standout-last-driver>--</dd>
              <small data-home2-standout-last-driver-meta>última del combo</small>
            </div>
            <div>
              <dt>Duelo</dt>
              <dd data-home2-standout-duel>--</dd>
              <small data-home2-standout-duel-meta>diferencias del combo</small>
            </div>
          </dl>
        </div>
      </div>
    </section>

<section class="gc-home2-toprow gc-home2-shell" aria-label="Actividad destacada">
      <article class="gc-home2-panel gc-home2-panel--now">
        <div class="gc-home2-panel__head">
          <div>
            <p class="gc-home2-panel__eyebrow">Now Racing</p>
            <h2 data-home2-now-title>Actualizando</h2>
          </div>
          <span class="gc-home2-country" data-home2-track-country>--</span>
        </div>

        <div class="gc-home2-trackbox">
          <img data-home2-track-map src="/ui/home2/gc-home2-track-fallback.svg" alt="" width="365" height="192" loading="lazy" decoding="async" />
        </div>

        <dl class="gc-home2-metrics">
          <div><dt>Pilotos</dt><dd data-home2-drivers>--</dd></div>
          <div><dt>Vueltas hoy</dt><dd data-home2-laps>--</dd></div>
        </dl>

        <dl class="gc-home2-now-extra">
          <div><dt>País</dt><dd data-home2-now-country>--</dd></div>
          <div><dt>Distancia</dt><dd data-home2-now-distance>--</dd></div>
          <div><dt>Coches</dt><dd data-home2-now-cars>--</dd></div>
        </dl>

        <div class="gc-home2-panel__footer">
          <a href={home2ToolLinks.carsDrive} target="_blank" rel="noreferrer" class="gc-home2-btn gc-home2-btn--small gc-home2-download-btn" aria-label="Descargar coche"><span>Coche</span><span aria-hidden="true">&#8595;</span></a>
          <a href={home2ToolLinks.tracksDrive} target="_blank" rel="noreferrer" class="gc-home2-btn gc-home2-btn--small gc-home2-download-btn" aria-label="Descargar circuito"><span>Circuito</span><span aria-hidden="true">&#8595;</span></a>
        </div>
      </article>

      <article class="gc-home2-panel gc-home2-panel--combo-ranking">
        <div class="gc-home2-panel__head">
          <div>
            <p class="gc-home2-panel__eyebrow">Top combo</p>
            <h2>Mejores tiempos</h2>
          </div>
          <a href="/hotlaps" class="gc-home2-link">Ver todas →</a>
        </div>

        <div class="gc-home2-combo-ranking-list" data-home2-combo-ranking>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">1</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">2</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">3</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">4</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">5</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">6</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">7</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
          <div class="gc-home2-combo-rank gc-home2-combo-rank--loading">
            <span class="gc-home2-rank-badge">8</span>
            <div><strong>--</strong><small>Esperando datos</small></div>
            <img class="gc-home2-combo-rank__avatar" src="/images/pilot-avatar-default.png" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <em>--</em>
          </div>
        </div>
      </article>

      <article class="gc-home2-panel gc-home2-panel--timing">
        <div class="gc-home2-panel__head">
          <div>
            <p class="gc-home2-panel__eyebrow">Últimas vueltas</p>
            <h2>Timing sheet</h2>
          </div>
          <a href="/hotlaps" class="gc-home2-link">Ver todas →</a>
        </div>

        <div class="gc-home2-table" role="table" aria-label="Últimas vueltas">
          <div class="gc-home2-table__row gc-home2-table__row--head" role="row">
            <span>Piloto</span>
            <span>Coche</span>
            <span>Tiempo</span>
            <span>Hace</span>
          </div>
          <div data-home2-recent-laps>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
            <div class="gc-home2-table__row gc-home2-table__row--loading" role="row">
              <span>--</span><span>--</span><strong>--</strong><small>--</small>
            </div>
          </div>
        </div>
      </article>

      <article class="gc-home2-panel gc-home2-panel--server gc-home2-panel--server-v8">
        <div class="gc-home2-panel__head">
          <div>
            <p class="gc-home2-panel__eyebrow">Estado del servidor</p>
            <h2>Race Control</h2>
          </div>
        </div>

        <dl class="gc-home2-server-rows gc-home2-server-rows--v8">
          <div>
            <dt>Online</dt>
            <dd data-home2-server-state>Online</dd>
          </div>
          <div>
            <dt>Pilotos servidor</dt>
            <dd data-home2-server-total-drivers>--</dd>
          </div>
          <div>
            <dt>Días desde 1ª vuelta</dt>
            <dd data-home2-first-lap-days>--</dd>
          </div>
          <div>
            <dt>Vueltas servidor</dt>
            <dd data-home2-server-total-laps>--</dd>
          </div>
          <div>
            <dt>Hotlaps</dt>
            <dd data-home2-server-hotlaps>--</dd>
          </div>
          <div>
            <dt>Coches combo</dt>
            <dd data-home2-server-active-cars>--</dd>
          </div>
          <div>
            <dt>Mejor combo</dt>
            <dd data-home2-server-best-time>--</dd>
          </div>
          <div>
            <dt>Última vuelta</dt>
            <dd data-home2-last-lap-card>--</dd>
          </div>
        </dl>
      </article>
    </section>

    <section class="gc-home2-section gc-home2-shell gc-home2-championship-wrap" aria-labelledby="gc-home2-championship-title">
      <article class="gc-home2-panel gc-home2-panel--championship" data-home2-championship>
        <div class="gc-home2-championship-layout">
          <header class="gc-home2-championship-header">
            <div>
              <p class="gc-home2-panel__eyebrow">Campeonato ACSM</p>
              <h2 id="gc-home2-championship-title" data-home2-champ-name>Campeonato de combos semanales</h2>
              <p class="gc-home2-section__sub" data-home2-champ-sub>Clasificación, eventos y calendario</p>
            </div>
            <a href="/campeonato" class="gc-home2-btn gc-home2-btn--small gc-home2-championship-btn">Ver campeonato →</a>
          </header>

          <div class="gc-home2-championship-body">
            <section class="gc-home2-championship-next" aria-label="Próximo evento del campeonato">
              <div class="gc-home2-championship-next__copy">
                <span class="gc-home2-tag gc-home2-tag--green gc-home2-tag--mini" data-home2-champ-status>Activo</span>
                <strong data-home2-champ-next>Actualizando campeonato</strong>
                <time data-home2-champ-date>Fecha por confirmar</time>
                <small data-home2-champ-next-meta>Esperando datos ACSM</small>
              </div>
              <figure class="gc-home2-championship-next__thumb">
                <img data-home2-champ-track-image src="/ui/home2/gc-home2-track-fallback.svg" alt="" width="620" height="220" loading="lazy" decoding="async" />
              </figure>
            </section>

            <dl class="gc-home2-championship-stats">
              <div><dt>Eventos</dt><dd data-home2-champ-events>--</dd></div>
              <div><dt>Completados</dt><dd data-home2-champ-completed>--</dd></div>
              <div><dt>Inscritos</dt><dd data-home2-champ-entrants>--</dd></div>
              <div><dt>Clases</dt><dd data-home2-champ-classes>--</dd></div>
            </dl>

            <section class="gc-home2-championship-drivers" aria-label="Clasificación del campeonato">
              <div class="gc-home2-championship-drivers__head">
                <span>Clasificación</span>
                <a href="/campeonato">Ver completa →</a>
              </div>
              <div class="gc-home2-championship-drivers__list" data-home2-champ-drivers>
                <div><strong>Cargando clasificación</strong><small>ACSM</small></div>
              </div>
            </section>
          </div>
        </div>
      </article>
    </section>

    <section class="gc-home2-section gc-home2-shell gc-home2-mid-grid" aria-label="Archivo y ratings">
      <article class="gc-home2-panel gc-home2-panel--archive">
        <div class="gc-home2-panel__head">
          <div>
            <p class="gc-home2-panel__eyebrow">Archivo GC</p>
            <h2>Fichas técnicas e históricas</h2>
          </div>
          <a href="/archivo" class="gc-home2-btn gc-home2-btn--small">Ver todo el archivo →</a>
        </div>

        <div class="gc-home2-archive-grid" data-home2-archive>
          <a class="gc-home2-archive-card" href="/archivo/circuitos/autodromo-internazionale-del-mugello/">
            <img src="/ui/home2/gc-home2-archive-circuit.svg" alt="" width="340" height="190" loading="lazy" decoding="async" />
            <span class="gc-home2-archive-card__tag">Circuito</span>
            <strong>Mugello</strong>
            <small>Guía completa del circuito, referencias y líneas.</small>
            <em>Ver ficha →</em>
          </a>
          <a class="gc-home2-archive-card" href="/archivo/coches/bmw-m3-gt2/">
            <img src="/ui/home2/gc-home2-archive-car.svg" alt="" width="340" height="190" loading="lazy" decoding="async" />
            <span class="gc-home2-archive-card__tag">Coche</span>
            <strong>BMW M3 GT2</strong>
            <small>Ficha técnica, setup base y referencias.</small>
            <em>Ver ficha →</em>
          </a>
          <a class="gc-home2-archive-card" href="/archivo/coches/ferrari-f430-gt2/">
            <img src="/ui/home2/gc-home2-archive-driver.svg" alt="" width="340" height="190" loading="lazy" decoding="async" />
            <span class="gc-home2-archive-card__tag">Coche</span>
            <strong>Ferrari F430 GT2</strong>
            <small>Ficha, contexto histórico y datos técnicos.</small>
            <em>Ver ficha →</em>
          </a>
          <a class="gc-home2-archive-card" href="/archivo/pilotos/">
            <img src="/ui/home2/gc-home2-archive-driver.svg" alt="" width="340" height="190" loading="lazy" decoding="async" />
            <span class="gc-home2-archive-card__tag">Piloto</span>
            <strong>Police1370</strong>
            <small>Perfil de piloto, referencias y contexto competitivo.</small>
            <em>Ver ficha →</em>
          </a>
          <a class="gc-home2-archive-card" href="/combos/">
            <img src="/ui/home2/gc-home2-archive-circuit.svg" alt="" width="340" height="190" loading="lazy" decoding="async" />
            <span class="gc-home2-archive-card__tag">Combos</span>
            <strong>Combos activos</strong>
            <small>Consulta los combos, referencias, coches y circuitos disponibles.</small>
            <em>Ver combos →</em>
          </a>
        </div>
      </article>

      <article class="gc-home2-panel gc-home2-panel--ratings" data-home2-ratings-card>
        <div class="gc-home2-panel__head">
          <div>
            <p class="gc-home2-panel__eyebrow">Safety & Skill</p>
            <h2>Clasificaciones SR / GSR</h2>
          </div>
          <a href="/ratings" class="gc-home2-btn gc-home2-btn--small">Ver ratings →</a>
        </div>

        <div class="gc-home2-ratings-grid" aria-live="polite">
          <section class="gc-home2-rating-board" aria-labelledby="gc-home2-sr-title">
            <div class="gc-home2-rating-board__head">
              <span>Safety Rating</span>
              <strong id="gc-home2-sr-title">Leaderboard SR</strong>
            </div>
            <div class="gc-home2-rating-table-wrap">
              <table class="gc-home2-rating-table">
                <thead>
                  <tr>
                    <th>Pos</th>
                    <th>Piloto</th>
                    <th>SR</th>
                    <th>Var.</th>
                  </tr>
                </thead>
                <tbody data-home2-sr-ratings>
                  <tr><td colspan="4">Cargando SR...</td></tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="gc-home2-rating-board" aria-labelledby="gc-home2-gsr-title">
            <div class="gc-home2-rating-board__head">
              <span>GrassCutters Skill Rating</span>
              <strong id="gc-home2-gsr-title">Leaderboard GSR</strong>
            </div>
            <div class="gc-home2-rating-table-wrap">
              <table class="gc-home2-rating-table">
                <thead>
                  <tr>
                    <th>Pos</th>
                    <th>Piloto</th>
                    <th>GSR</th>
                    <th>Var.</th>
                  </tr>
                </thead>
                <tbody data-home2-gsr-ratings>
                  <tr><td colspan="4">Cargando GSR...</td></tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </article>
    </section>

    <section class="gc-home2-section gc-home2-shell" aria-label="Comunidad y CTA final">
      <div class="gc-home2-bottom gc-home2-bottom--v8">
        <article class="gc-home2-panel gc-home2-panel--community gc-home2-panel--community-v8 gc-home2-panel--raceflow-v23">
          <div class="gc-home2-community-copy">
