          );

          if (type === 'circuitos') {
            rawCandidates.push(
              `/images/tracks/${cleanSlug}.webp`,
              `/images/tracks/${cleanSlug}.jpg`,
              `/images/tracks/${cleanSlug}.png`,
              `/imagenes/tracks/${cleanSlug}.webp`,
