---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---
<MarketingLayout
  title="Equipos | GrassCutters Racing"
  description="Escuderías GrassCutters Racing: pilotos, identidad y base para ranking por equipos."
  canonicalPath="/equipos"
  bodyClass="gc-page-platform-data"
>
  <main class="gc-equipos gc-public-shell" data-gc-teams-page>
    <header class="gc-equipos-head">
      <p>GRASSCUTTERS / TEAMS</p>
      <h1>Escuderías.</h1>
      <span>Sistema propio de equipos para rankings, pilotos vinculados, país real y gestión desde perfil.</span>
    </header>
    <section class="gc-equipos-toolbar">
      <input id="gcTeamsSearch" type="search" placeholder="Buscar equipo" autocomplete="off" />
      <a href="/perfil" class="gc-equipos-btn">Crear / mi equipo</a>
    </section>
    <section class="gc-equipos-ranking" id="gcTeamsRanking"><article>Cargando ranking...</article></section>
    <section class="gc-equipos-grid" id="gcTeamsGrid">
      <article class="gc-equipos-card"><strong>Cargando equipos...</strong></article>
    </section>
  </main>

  <style is:global>
    .gc-equipos{display:grid;gap:18px;padding:22px 18px 52px;max-width:1440px;margin:0 auto;color:var(--text,#f4fff1)}
    .gc-equipos-head{border:1px solid rgba(150,255,47,.22);background:linear-gradient(135deg,rgba(150,255,47,.10),rgba(2,8,4,.96));padding:22px;box-shadow:0 0 38px rgba(150,255,47,.06)}
    .gc-equipos-head p{margin:0 0 8px;color:#96ff2f;font:800 12px/1 var(--gc-mono,monospace);letter-spacing:.16em}
    .gc-equipos-head h1{margin:0;font-size:clamp(34px,6vw,74px);line-height:.9;text-transform:uppercase}
    .gc-equipos-head span{display:block;margin-top:10px;color:rgba(244,255,241,.72)}
    .gc-equipos-toolbar{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}
    .gc-equipos-toolbar input{min-width:260px;flex:1;background:#050905;border:1px solid rgba(150,255,47,.28);color:#f4fff1;padding:12px 14px;font:800 12px/1 var(--gc-mono,monospace);text-transform:uppercase}
    .gc-equipos-btn{border:1px solid rgba(150,255,47,.5);background:rgba(150,255,47,.12);color:#96ff2f;text-decoration:none;padding:12px 14px;font:900 12px/1 var(--gc-mono,monospace);text-transform:uppercase;letter-spacing:.08em}
    .gc-equipos-ranking{border:1px solid rgba(150,255,47,.16);background:rgba(3,9,5,.92);display:grid;gap:1px;overflow:hidden}
    .gc-equipos-rank-row{display:grid;grid-template-columns:70px 1fr 120px 120px 120px;gap:10px;align-items:center;padding:11px 14px;background:#030904;font:900 12px/1.2 var(--gc-mono,monospace);text-transform:uppercase}
    .gc-equipos-rank-row strong{color:#96ff2f}.gc-equipos-rank-row span{color:rgba(244,255,241,.72)}
    .gc-equipos-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
    .gc-equipos-card{border:1px solid rgba(150,255,47,.18);background:rgba(3,9,5,.92);padding:16px;display:grid;gap:12px;min-height:130px;color:inherit;text-decoration:none}
    .gc-equipos-card__top{display:flex;align-items:center;gap:12px}
    .gc-equipos-card img{width:52px;height:52px;border-radius:50%;object-fit:cover;border:1px solid rgba(150,255,47,.45);background:#050905}
    .gc-equipos-card strong{font-size:18px;text-transform:uppercase}
    .gc-equipos-card small{color:rgba(244,255,241,.62);font:800 11px/1.3 var(--gc-mono,monospace);text-transform:uppercase}
    .gc-equipos-card dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0}
    .gc-equipos-card div dt{color:rgba(244,255,241,.52);font-size:10px;text-transform:uppercase}
    .gc-equipos-card div dd{margin:3px 0 0;font:900 17px/1 var(--gc-mono,monospace);color:#96ff2f}
  </style>

  <script is:inline>
    (() => {
      const grid = document.getElementById('gcTeamsGrid');
      const search = document.getElementById('gcTeamsSearch');
      const esc = (v) => String(v ?? '').replace(/[&<>'"]/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
      const flag = (code) => /^[A-Z]{2}$/.test(String(code||'')) ? String.fromCodePoint(...[...String(code).toUpperCase()].map((c)=>127397+c.charCodeAt(0))) : '🏳️';
      const ranking = document.getElementById('gcTeamsRanking');
      let teams = [];
      function renderRanking(items) {
        if (!ranking) return;
        const rows = (items || teams).slice(0, 10);
        ranking.innerHTML = rows.length ? rows.map((team, index) => `
          <a class="gc-equipos-rank-row" href="/equipos/${encodeURIComponent(team.slug || team.id)}" style="color:inherit;text-decoration:none">
            <strong>#${team.rank || index + 1}</strong><span>${esc(team.name || 'Equipo')}</span><strong>${Number(team.points || 0)}</strong><span>${Number(team.membersCount || 0)} pilotos</span><span>${esc(flag(team.countryCode))} ${esc(team.countryCode || '--')}</span>
          </a>`).join('') : '<article class="gc-equipos-rank-row"><span>Sin ranking todavía.</span></article>';
      }
      function render() {
        const q = String(search?.value || '').trim().toLowerCase();
        const rows = teams.filter((team) => !q || String(team.name || '').toLowerCase().includes(q));
        grid.innerHTML = rows.length ? rows.map((team) => `
          <a class="gc-equipos-card" href="/equipos/${encodeURIComponent(team.slug || team.id)}">
            <div class="gc-equipos-card__top">
              <img src="${esc(team.logoUrl || '/images/team-default-gc.svg')}" alt="" loading="lazy" onerror="this.src='/images/team-default-gc.svg'">
              <div><strong>${esc(team.name || 'Equipo')}</strong><small>${esc(flag(team.countryCode))} ${esc(team.shortName || team.slug || '')}</small></div>
            </div>
            <dl><div><dt>Pilotos</dt><dd>${Number(team.membersCount || team.members?.length || 0)}</dd></div><div><dt>Estado</dt><dd>${esc(team.status || 'active')}</dd></div></dl>
          </a>`).join('') : '<article class="gc-equipos-card"><strong>No hay equipos todavía.</strong><small>Crea el primero desde /perfil.</small></article>';
      }
      async function load() {
        try {
          const response = await fetch('/api/gc/teams', { cache:'no-store', credentials:'include' });
          const data = await response.json();
          teams = data.items || data.teams || [];
          render();
          try {
            const standingsResponse = await fetch('/api/gc/teams/standings', { cache:'no-store', credentials:'include' });
            const standingsData = await standingsResponse.json();
            renderRanking(standingsData.items || standingsData.standings || teams);
          } catch (_) { renderRanking(teams); }
        } catch (_) {
          grid.innerHTML = '<article class="gc-equipos-card"><strong>No se pudieron cargar los equipos.</strong></article>';
          if (ranking) ranking.innerHTML = '<article class="gc-equipos-rank-row"><span>No se pudo cargar el ranking.</span></article>';
        }
      }
      search?.addEventListener('input', render);
      load();
    })();
  </script>
</MarketingLayout>
