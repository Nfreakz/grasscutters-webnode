---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Recuperar contraseña | GrassCutters">
  <div class="gc-page gc-password-recovery-v15">
    <section class="gc-hero gc-hero--compact">
      <div>
        <span class="gc-kicker">Cuenta GrassCutters</span>
        <h1 class="gc-title">Recuperar contraseña.</h1>
        <p class="gc-subtitle">Pega el enlace de recuperación generado desde administración o solicita ayuda usando tu correo.</p>
      </div>
    </section>

    <section class="gc-section">
      <div class="gc-slab gc-password-recovery-box-v15">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Acceso</span>
            <h2>Nueva contraseña</h2>
            <p id="recoveryAccount">Pega un enlace/token de recuperación o solicita uno con tu correo.</p>
          </div>
        </div>

        <label class="gc-field" id="tokenField">
          <span>Enlace o token de recuperación</span>
          <input class="gc-input" id="tokenInput" type="text" autocomplete="off" placeholder="https://.../recuperar-password?token=..." />
        </label>

        <div class="gc-actions gc-actions--inline">
          <button class="gc-btn gc-btn--primary" id="verifyToken" type="button">Verificar enlace</button>
          <a class="gc-btn" href="/login">Volver al login</a>
        </div>

        <div class="gc-recovery-divider"><span>o</span></div>

        <label class="gc-field" id="emailField">
          <span>Correo de la cuenta</span>
          <input class="gc-input" id="recoveryEmail" type="email" autocomplete="email" placeholder="correo@dominio.com" />
        </label>

        <div class="gc-actions gc-actions--inline">
          <button class="gc-btn" id="requestRecovery" type="button">Solicitar recuperación</button>
        </div>

        <div class="gc-recovery-password-panel" id="passwordPanel" hidden>
          <label class="gc-field">
            <span>Contraseña nueva</span>
            <input class="gc-input" id="newPassword" type="password" autocomplete="new-password" minlength="8" disabled />
          </label>

          <label class="gc-field">
            <span>Confirmar contraseña</span>
            <input class="gc-input" id="confirmPassword" type="password" autocomplete="new-password" minlength="8" disabled />
          </label>

          <div class="gc-actions gc-actions--inline">
            <button class="gc-btn gc-btn--primary" id="savePassword" type="button" disabled>Guardar contraseña</button>
          </div>
        </div>

        <p class="gc-message" id="recoveryMessage"></p>
        <p class="gc-note">Los enlaces caducan. Si no tienes enlace válido, un administrador puede generarlo desde Usuarios.</p>
      </div>
    </section>
  </div>

  <style is:global>
    .gc-password-recovery-v15 { max-width: 960px; margin: 0 auto; }
    .gc-password-recovery-box-v15 { display: grid; gap: 16px; max-width: 680px; }
    .gc-password-recovery-box-v15 .gc-field { display: grid; gap: 7px; }
    .gc-password-recovery-box-v15 .gc-field span { color: var(--soft); font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
    .gc-password-recovery-box-v15 .gc-input { width: 100%; box-sizing: border-box; min-height: 44px; padding: 0 13px; border: 1px solid rgba(255,255,255,.13); border-radius: 12px; background: rgba(4,9,6,.62); color: inherit; font: inherit; outline: none; }
    .gc-password-recovery-box-v15 .gc-input:focus { border-color: rgba(150,255,47,.55); box-shadow: 0 0 0 3px rgba(150,255,47,.10); }
    .gc-actions--inline { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
    .gc-recovery-divider { display:flex; align-items:center; gap:12px; color:var(--soft); font-size:.72rem; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
    .gc-recovery-divider::before, .gc-recovery-divider::after { content:""; height:1px; flex:1; background:rgba(255,255,255,.12); }
    .gc-recovery-password-panel { display:grid; gap:16px; padding-top:4px; }
  </style>

  <script>
    (() => {
      const $ = (id) => document.getElementById(id);
      const params = new URLSearchParams(window.location.search);
      const tokenFromUrl = params.get('token') || params.get('resetToken') || params.get('reset') || '';
      const account = $('recoveryAccount');
      const message = $('recoveryMessage');
      const verifyButton = $('verifyToken');
      const requestButton = $('requestRecovery');
      const tokenInput = $('tokenInput');
      const emailInput = $('recoveryEmail');
      const passwordPanel = $('passwordPanel');
      const button = $('savePassword');
      const newPassword = $('newPassword');
      const confirmPassword = $('confirmPassword');
      let activeToken = '';

      const extractToken = (value) => {
        const raw = String(value || '').trim();
        if (!raw) return '';
        try {
          const url = new URL(raw, window.location.origin);
          return url.searchParams.get('token') || url.searchParams.get('resetToken') || url.searchParams.get('reset') || raw;
        } catch (_) {
          return raw;
        }
      };

      const setMessage = (text, type = '') => {
        message.textContent = text || '';
        message.style.color = type === 'ok' ? 'var(--accent)' : type === 'bad' ? '#ff8b8b' : 'var(--soft)';
      };

      const setBusy = (busy) => {
        [verifyButton, requestButton, button, tokenInput, emailInput, newPassword, confirmPassword].forEach((el) => {
          if (el) el.disabled = Boolean(busy) || (passwordPanel.hidden && (el === button || el === newPassword || el === confirmPassword));
        });
      };

      const setFormEnabled = (enabled) => {
        passwordPanel.hidden = !enabled;
        newPassword.disabled = !enabled;
        confirmPassword.disabled = !enabled;
        button.disabled = !enabled;
      };

      const postJson = async (url, payload) => {
        const response = await fetch(url, {
          method: 'POST',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.ok === false) throw new Error(data.message || 'No se pudo completar la operación.');
        return data;
      };

      const verify = async (value) => {
        const token = extractToken(value ?? tokenInput.value);
        activeToken = '';
        setFormEnabled(false);
        if (!token) {
          account.textContent = 'Falta el token de recuperación.';
          setMessage('Pega el enlace completo o el token generado desde administración.', 'bad');
          return;
        }
        tokenInput.value = token;
        setBusy(true);
        setMessage('Verificando enlace...');
        try {
          const data = await postJson('/api/auth/password-recovery/verify', { token });
          activeToken = token;
          const user = data.user || {};
          account.textContent = `Cuenta: ${user.displayName || user.email || 'usuario'} · válido hasta ${data.expiresAt ? new Date(data.expiresAt).toLocaleString() : 'pronto'}`;
          setFormEnabled(true);
          newPassword.focus();
          setMessage('Introduce una nueva contraseña.', 'ok');
        } catch (error) {
          account.textContent = 'El enlace no es válido.';
          setFormEnabled(false);
          setMessage(error.message || 'El enlace no es válido o ha caducado.', 'bad');
        } finally {
          setBusy(false);
        }
      };

      const requestRecovery = async () => {
        const email = String(emailInput.value || '').trim();
        if (!email || !email.includes('@')) {
          setMessage('Introduce el correo de la cuenta.', 'bad');
          return;
        }
        setBusy(true);
        setMessage('Preparando recuperación...');
        try {
          const data = await postJson('/api/auth/password-recovery/request', { email });
          if (data.resetUrl) {
            tokenInput.value = data.resetUrl;
            setMessage('Enlace generado. Puedes verificarlo ahora.', 'ok');
            await verify(data.resetUrl);
            return;
          }
          setMessage(data.message || 'Solicitud recibida. Pide el enlace a un administrador.', 'ok');
        } catch (error) {
          setMessage(error.message || 'No se pudo solicitar recuperación.', 'bad');
        } finally {
          setBusy(false);
        }
      };

      const save = async () => {
        const password = newPassword.value || '';
        const confirm = confirmPassword.value || '';
        if (!activeToken) {
          setMessage('Verifica primero el enlace de recuperación.', 'bad');
          return;
        }
        if (password.length < 8) {
          setMessage('La contraseña debe tener al menos 8 caracteres.', 'bad');
          return;
        }
        if (password !== confirm) {
          setMessage('Las contraseñas no coinciden.', 'bad');
          return;
        }
        setBusy(true);
        setMessage('Guardando contraseña...');
        try {
          await postJson('/api/auth/password-recovery/complete', { token: activeToken, password, confirmPassword: confirm });
          newPassword.value = '';
          confirmPassword.value = '';
          setFormEnabled(false);
          setMessage('Contraseña actualizada. Redirigiendo al login...', 'ok');
          setTimeout(() => { window.location.href = '/login'; }, 900);
        } catch (error) {
          setFormEnabled(true);
          setMessage(error.message || 'No se pudo actualizar la contraseña.', 'bad');
        } finally {
          setBusy(false);
        }
      };

      verifyButton.addEventListener('click', () => verify());
      requestButton.addEventListener('click', requestRecovery);
      button.addEventListener('click', save);
      [tokenInput, emailInput, newPassword, confirmPassword].forEach((input) => input.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        if (input === emailInput) requestRecovery();
        else if (input === tokenInput) verify();
        else if (!button.disabled) save();
      }));

      if (tokenFromUrl) verify(tokenFromUrl);
      else setFormEnabled(false);
    })();
  </script>
</AppLayout>
