---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Recuperar contraseña | GrassCutters">
  <div class="gc-page gc-password-recovery-v2">
    <section class="gc-hero gc-hero--compact">
      <div>
        <span class="gc-kicker">Cuenta GrassCutters</span>
        <h1 class="gc-title">Recuperar contraseña.</h1>
        <p class="gc-subtitle">Usa el enlace temporal generado desde administración para crear una nueva contraseña y recuperar el acceso.</p>
      </div>
    </section>

    <section class="gc-section">
      <div class="gc-slab gc-password-recovery-box-v2">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Acceso</span>
            <h2>Nueva contraseña</h2>
            <p id="recoveryAccount">Verificando enlace temporal...</p>
          </div>
        </div>

        <label class="gc-field">
          <span>Contraseña nueva</span>
          <input class="gc-input" id="newPassword" type="password" autocomplete="new-password" minlength="8" disabled />
        </label>

        <label class="gc-field">
          <span>Confirmar contraseña</span>
          <input class="gc-input" id="confirmPassword" type="password" autocomplete="new-password" minlength="8" disabled />
        </label>

        <div class="gc-actions">
          <button class="gc-btn gc-btn--primary" id="savePassword" type="button" disabled>Guardar contraseña</button>
          <a class="gc-btn" href="/login">Volver al login</a>
        </div>

        <p class="gc-message" id="recoveryMessage"></p>
        <p class="gc-note">Si el enlace ha caducado, genera uno nuevo desde administración.</p>
      </div>
    </section>
  </div>

  <style is:global>
    .gc-password-recovery-v2 {
      max-width: 960px;
      margin: 0 auto;
    }
    .gc-password-recovery-box-v2 {
      display: grid;
      gap: 16px;
      max-width: 620px;
    }
    .gc-password-recovery-box-v2 .gc-field {
      display: grid;
      gap: 7px;
    }
    .gc-password-recovery-box-v2 .gc-field span {
      color: var(--soft);
      font-size: .72rem;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .gc-password-recovery-box-v2 .gc-input {
      width: 100%;
      box-sizing: border-box;
      min-height: 44px;
      padding: 0 13px;
      border: 1px solid rgba(255,255,255,.13);
      border-radius: 12px;
      background: rgba(4,9,6,.62);
      color: inherit;
      font: inherit;
      outline: none;
    }
  </style>

  <script>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const token = params.get('token') || params.get('resetToken') || params.get('reset') || '';
      const account = document.getElementById('recoveryAccount');
      const message = document.getElementById('recoveryMessage');
      const button = document.getElementById('savePassword');
      const newPassword = document.getElementById('newPassword');
      const confirmPassword = document.getElementById('confirmPassword');

      const setMessage = (text, type = '') => {
        message.textContent = text || '';
        message.style.color = type === 'ok' ? 'var(--accent)' : type === 'bad' ? '#ff8b8b' : 'var(--soft)';
      };

      const setFormEnabled = (enabled) => {
        newPassword.disabled = !enabled;
        confirmPassword.disabled = !enabled;
        button.disabled = !enabled;
      };

      const postJson = async (url, payload) => {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.ok === false) throw new Error(data.message || 'No se pudo completar la operación.');
        return data;
      };

      const verify = async () => {
        if (!token) {
          account.textContent = 'Falta el token de recuperación.';
          setMessage('Pide a un administrador un enlace nuevo.', 'bad');
          return;
        }
        try {
          const data = await postJson('/api/auth/password-recovery/verify', { token });
          const user = data.user || {};
          account.textContent = `Cuenta: ${user.displayName || user.email || 'usuario'} · enlace válido hasta ${data.expiresAt ? new Date(data.expiresAt).toLocaleString() : 'pronto'}`;
          setFormEnabled(true);
          newPassword.focus();
          setMessage('Introduce una nueva contraseña.', 'ok');
        } catch (error) {
          account.textContent = 'El enlace no es válido.';
          setFormEnabled(false);
          setMessage(error.message || 'El enlace no es válido o ha caducado.', 'bad');
        }
      };

      const save = async () => {
        const password = newPassword.value || '';
        const confirm = confirmPassword.value || '';
        if (password.length < 8) {
          setMessage('La contraseña debe tener al menos 8 caracteres.', 'bad');
          return;
        }
        if (password !== confirm) {
          setMessage('Las contraseñas no coinciden.', 'bad');
          return;
        }
        button.disabled = true;
        setMessage('Guardando contraseña...');
        try {
          await postJson('/api/auth/password-recovery/complete', { token, password, confirmPassword: confirm });
          newPassword.value = '';
          confirmPassword.value = '';
          setFormEnabled(false);
          setMessage('Contraseña actualizada. Redirigiendo al login...', 'ok');
          setTimeout(() => { window.location.href = '/login'; }, 900);
        } catch (error) {
          setFormEnabled(true);
          setMessage(error.message || 'No se pudo actualizar la contraseña.', 'bad');
        }
      };

      button.addEventListener('click', save);
      [newPassword, confirmPassword].forEach((input) => input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && !button.disabled) save();
      }));
      verify();
    })();
  </script>
</AppLayout>
