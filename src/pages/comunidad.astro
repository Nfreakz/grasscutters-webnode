---
import MarketingLayout from '../layouts/MarketingLayout.astro';

import PublicHeroFrame from '../components/public/PublicHeroFrame.astro';
const discordUrl = 'https://discord.gg/jA4yuuH5T';
const whatsappUrl = 'https://chat.whatsapp.com/JMXKRF4XnG73D4xLzzrlHa';
const instagramUrl = 'https://www.instagram.com/grasscutters_ac/';
const gtxSupportUrl = 'https://www.gtxgaming.co.uk/clientarea/index.php?m=public_pay&hash_id=mW1QWBg9XVJn';

const quickActions = [
  ['👥', 'Ver pilotos', 'Miembros de la comunidad', '/pilotos'],
  ['🛡', 'Normas', 'Convivencia y reglas', '/normas'],
  ['♡', 'Apoyo al servidor', 'Ayuda a mantenerlo vivo', '/apoyo-servidor']
];

const summaryItems = [
  ['Hotlaps y carreras semanales', 'Rueda, compara tiempos y sigue tu progreso'],
  ['Combos por votación', 'La comunidad propone y elige qué se corre'],
  ['Pista limpia y buen ambiente', 'Competir fuerte sin convertirlo en una guerra']
];

const steps = [
  ['01', 'Únete', 'Entra al Discord o al WhatsApp y saluda sin ceremonia.'],
  ['02', 'Vota', 'Proponemos coches, circuitos y horarios. Luego se decide entre todos.'],
  ['03', 'Rueda', 'Entra al servidor, marca vueltas y comparte sensaciones.'],
  ['04', 'Repite', 'Cuando el ambiente acompaña, siempre apetece volver.']
];

const textChannels = [
  ['#', 'bienvenida', 'Primer paso y presentación'],
  ['#', 'anuncios', 'Avisos importantes'],
  ['#', 'votaciones', 'Combos, horarios y decisiones'],
  ['#', 'general', 'Charla de la comunidad'],
  ['#', 'setups', 'Ajustes, dudas y pruebas'],
  ['#', 'clips-y-repeticiones', 'Momentos de carrera'],
  ['#', 'soporte', 'Ayuda con servidor, mods o acceso']
];

---
<MarketingLayout
  title="Comunidad | GrassCutters Racing"
  description="Comunidad GrassCutters Racing: Discord, hotlaps semanales, setups, mods, votaciones, fair play y buen ambiente en Assetto Corsa."
  ogImage="/og/comunidad-og-v1531.png"
  bodyClass="gc-page-comunidad gc-community-mock43"
>
  <main class="gc43">
    <section class="gc43-hero" aria-labelledby="gc43-title">
      <video
        class="gc43-hero__video"
        src="/videos/comunidad-hero.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <div class="gc43-hero__shade" aria-hidden="true"></div>
      <div class="gc43-hero__grid" aria-hidden="true"></div>

      <div class="gc43-shell gc43-hero__inner">
        <div class="gc43-hero__marker" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>

        <div class="gc43-hero__copy">
          <PublicHeroFrame
            id="gc43-title"
            kicker="Comunidad GC"
            title={['Un grupo para', 'rodar, votar', 'y volver.']}
            lead="GrassCutters es una comunidad de Assetto Corsa para compartir pista, probar combos, seguir campeonatos y hablar de carreras con buen ambiente."
          />

          <div class="gc43-social" aria-label="Canales principales">
            <a class="gc43-social-btn gc43-social-btn--discord" href={discordUrl} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.55 5.45A16.4 16.4 0 0 0 15.45 4l-.2.4a12.6 12.6 0 0 1 3.52 1.77A14.9 14.9 0 0 0 12 4.55a14.9 14.9 0 0 0-6.77 1.62A12.6 12.6 0 0 1 8.75 4.4L8.55 4c-1.43.25-2.8.74-4.1 1.45C1.86 9.3 1.17 13.05 1.53 16.75A16.6 16.6 0 0 0 6.55 19.3l.62-.86a10.6 10.6 0 0 1-1.62-.77l.39-.29A11.55 11.55 0 0 0 12 19a11.55 11.55 0 0 0 6.06-1.62l.39.29a10.6 10.6 0 0 1-1.62.77l.62.86a16.6 16.6 0 0 0 5.02-2.55c.43-4.29-.73-8-2.92-11.3ZM8.32 14.35c-.96 0-1.74-.88-1.74-1.96s.77-1.96 1.74-1.96c.98 0 1.77.88 1.75 1.96 0 1.08-.77 1.96-1.75 1.96Zm7.36 0c-.96 0-1.75-.88-1.75-1.96s.77-1.96 1.75-1.96c.98 0 1.75.88 1.75 1.96s-.77 1.96-1.75 1.96Z" /></svg>
              <span><strong>Discord</strong><small>Únete al servidor</small></span>
            </a>

            <a class="gc43-social-btn gc43-social-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.05 3a8.82 8.82 0 0 0-7.49 13.49L3.7 21l4.6-1.2A8.82 8.82 0 1 0 12.05 3Zm0 1.7a7.12 7.12 0 0 1 6.05 10.87 7.09 7.09 0 0 1-8.85 2.65l-.32-.15-2.72.71.73-2.64-.18-.34A7.12 7.12 0 0 1 12.05 4.7Zm-3.1 3.78c-.2 0-.52.08-.8.38-.27.3-1.05 1.03-1.05 2.52 0 1.48 1.08 2.92 1.23 3.12.15.2 2.1 3.36 5.2 4.57 2.57 1 3.1.8 3.66.75.56-.05 1.8-.74 2.05-1.45.25-.72.25-1.33.18-1.46-.08-.13-.28-.2-.58-.36-.3-.15-1.8-.9-2.08-1-.28-.1-.48-.15-.68.15-.2.3-.78 1-.96 1.2-.18.2-.36.22-.66.07-.3-.15-1.26-.47-2.4-1.5-.88-.78-1.48-1.75-1.65-2.05-.18-.3-.02-.46.13-.61.13-.13.3-.36.45-.54.15-.18.2-.30.3-.5.1-.2.05-.38-.03-.53-.08-.15-.68-1.64-.94-2.25-.25-.6-.5-.51-.68-.52h-.58Z" /></svg>
              <span><strong>WhatsApp</strong><small>Grupo de la comunidad</small></span>
            </a>

            <a class="gc43-social-btn gc43-social-btn--instagram" href={instagramUrl} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3h9.6A4.2 4.2 0 0 1 21 7.2v9.6a4.2 4.2 0 0 1-4.2 4.2H7.2A4.2 4.2 0 0 1 3 16.8V7.2A4.2 4.2 0 0 1 7.2 3Zm0 1.8a2.4 2.4 0 0 0-2.4 2.4v9.6a2.4 2.4 0 0 0 2.4 2.4h9.6a2.4 2.4 0 0 0 2.4-2.4V7.2a2.4 2.4 0 0 0-2.4-2.4H7.2ZM12 8.15A3.85 3.85 0 1 1 12 15.85 3.85 3.85 0 0 1 12 8.15Zm0 1.8a2.05 2.05 0 1 0 0 4.1 2.05 2.05 0 0 0 0-4.1Zm4.15-2.85a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z" /></svg>
              <span><strong>Instagram</strong><small>Síguenos</small></span>
            </a>
          </div>

          <div class="gc43-quick">
            {quickActions.map(([icon, title, text, href]) => (
              <a href={href}>
                <span>{icon}</span>
                <strong>{title}</strong>
                <small>{text}</small>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="gc43-shell gc43-intro">
      <article class="gc43-card gc43-copy-card">
        <span class="gc43-kicker">Qué es GrassCutters</span>
        <h2>Un grupo para rodar <em>a gusto.</em></h2>
        <p>
          Aquí se viene a desconectar, probar coches, compartir setups, votar combos y hacer vueltas sin convertir cada tarde en una discusión eterna.
          Si hablas español, perfecto. Si no, pero entiendes el ambiente del grupo, también tienes sitio.
        </p>
      </article>

      <aside class="gc43-card gc43-summary">
        <div class="gc43-summary__logo">
          <img src="/images/newlogo-512.webp" alt="GrassCutters Simracing" loading="lazy" decoding="async" />
        </div>
        <div class="gc43-summary__items">
          {summaryItems.map(([title, text]) => (
            <div>
              <span>▣</span>
              <strong>{title}</strong>
              <small>{text}</small>
            </div>
          ))}
        </div>
      </aside>
    </section>

    <section class="gc43-shell gc43-section">
      <header class="gc43-section-title">
        <span></span>
        <h2>Cómo funciona la comunidad</h2>
      </header>

      <div class="gc43-steps">
        {steps.map(([number, title, text]) => (
          <article class="gc43-card gc43-step">
            <span>{number}</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="gc43-shell gc43-section gc43-discord-activity">
      <article class="gc43-card gc43-discord">
        <header>
          <div>
            <span class="gc43-kicker gc43-kicker--blue">Discord · tu casa</span>
            <h2>Canales principales</h2>
          </div>
          <strong>{textChannels.length}</strong>
        </header>

        <div class="gc43-channel-list">
          {textChannels.map(([icon, name, text]) => (
            <div class="gc43-channel">
              <span>{icon}</span>
              <strong>{name}</strong>
              <small>{text}</small>
            </div>
          ))}
        </div>

        <a class="gc43-outline gc43-outline--blue" href={discordUrl} target="_blank" rel="noreferrer">Ir al Discord</a>
      </article>

      <div class="gc43-activity-grid">
        <article class="gc43-card gc43-activity gc43-activity--wide">
          <span class="gc43-kicker">Actividad en pista</span>
          <h2>Próximas carreras</h2>
          <p>Entradas del calendario público. Antes de entrar, revisa ahí el combo, la hora y cualquier cambio de última hora.</p>
          <div class="gc43-calendar-preview" data-gc43-calendar-preview aria-live="polite">
            <span class="gc43-calendar-preview__empty">Cargando calendario...</span>
          </div>
          <a class="gc43-outline" href="/calendario">Ver calendario</a>
        </article>

        <article class="gc43-card gc43-activity">
          <span class="gc43-kicker">WhatsApp</span>
          <h2>Avisos rápidos</h2>
          <p>Para enterarte de quedadas, cambios de hora y carreras montadas sobre la marcha.</p>
          <a class="gc43-outline gc43-outline--whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">Unirse al WhatsApp</a>
        </article>

        <article class="gc43-card gc43-activity">
          <span class="gc43-kicker">Votaciones</span>
          <h2>El combo lo elige el grupo</h2>
          <p>Propuestas de coche, circuito y formato. Se vota, se prueba y se rueda.</p>
          <a class="gc43-outline" href="/combos">Ver combos</a>
        </article>
      </div>
    </section>

    <section class="gc43-shell gc43-section gc43-rules">
      <article class="gc43-card gc43-rules__intro">
        <span class="gc43-kicker">Filosofía GC</span>
        <h2>Pocas normas. Buen ambiente. Pista limpia.</h2>
        <p>
          No buscamos un servidor lleno de sanciones. Tampoco un sitio donde valga todo.
          La línea es sencilla: respeto en el chat, respeto en pista y hablar las cosas con calma cuando algo sale mal.
        </p>
      </article>

      <div class="gc43-rule-list">
        <article class="gc43-card"><span>01</span><h3>Actitud antes que ritmo</h3><p>No hace falta ser el más rápido. Hace falta sumar buen ambiente, respetar y querer mejorar.</p></article>
        <article class="gc43-card"><span>02</span><h3>Pista limpia</h3><p>Se puede competir fuerte, pero sin choques intencionados, sin zigzag y dejando espacio cuando toca.</p></article>
        <article class="gc43-card"><span>03</span><h3>Incidentes con calma</h3><p>Si hay toque, se revisa y se habla después. En caliente todos vemos la curva desde nuestro retrovisor.</p></article>
      </div>
    </section>

    <section class="gc43-shell gc43-section">
      <article class="gc43-card gc43-daily">
        <div>
          <span class="gc43-kicker">Daily Racers</span>
          <h2>No se pide. Se gana.</h2>
          <p>
            Daily Racers es para quienes están de verdad en el día a día de la comunidad.
            No va de ser el más rápido, va de aparecer, participar y mantener vivo el servidor.
          </p>
        </div>
        <ul>
          <li>Participar regularmente en carreras o hotlaps.</li>
          <li>Estar activo en la comunidad: chat, feedback, dudas y buen ambiente.</li>
          <li>Implicarse en eventos, votaciones o pruebas del servidor.</li>
          <li>Mantener una actitud positiva y respetuosa.</li>
        </ul>
      </article>
    </section>

    <section class="gc43-final">
      <div class="gc43-shell gc43-final__inner">
        <div>
          <span class="gc43-kicker">¿Te apuntas?</span>
          <h2>Únete a <em>GrassCutters</em></h2>
          <p>Gente con ganas de correr, comentar la jugada y mejorar sin convertirlo en trabajo.</p>
        </div>
        <a class="gc43-primary" href={discordUrl} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.55 5.45A16.4 16.4 0 0 0 15.45 4l-.2.4a12.6 12.6 0 0 1 3.52 1.77A14.9 14.9 0 0 0 12 4.55a14.9 14.9 0 0 0-6.77 1.62A12.6 12.6 0 0 1 8.75 4.4L8.55 4c-1.43.25-2.8.74-4.1 1.45C1.86 9.3 1.17 13.05 1.53 16.75A16.6 16.6 0 0 0 6.55 19.3l.62-.86a10.6 10.6 0 0 1-1.62-.77l.39-.29A11.55 11.55 0 0 0 12 19a11.55 11.55 0 0 0 6.06-1.62l.39.29a10.6 10.6 0 0 1-1.62.77l.62.86a16.6 16.6 0 0 0 5.02-2.55c.43-4.29-.73-8-2.92-11.3Z" /></svg>
          <span>Únete al Discord</span>
        </a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const preview = document.querySelector('[data-gc43-calendar-preview]');
      if (!preview) return;

      const typeLabels = {
        combo: 'Combo semanal',
        race_lfm: 'Carrera LFM',
        race_gc: 'Carrera GC'
      };
      const monthNames = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
      const pad = (value) => String(value).padStart(2, '0');
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
      const parseDate = (value) => {
        const text = String(value || '').slice(0, 10);
        if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return null;
        const [year, month, day] = text.split('-').map(Number);
        const date = new Date(year, month - 1, day);
        return Number.isNaN(date.getTime()) ? null : date;
      };
      const keyOf = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
      const addDays = (date, days) => {
        const next = new Date(date);
        next.setDate(next.getDate() + days);
        return next;
      };
      const startOfDay = (date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());
      const daysBetween = (a, b) => Math.round((startOfDay(b) - startOfDay(a)) / 86400000);
      const eventStart = (event) => parseDate(event.startDate || event.date);
      const eventEnd = (event) => parseDate(event.endDate) || eventStart(event);
      const isWeekly = (event) => Boolean(event.repeatEnabled || event.repeatFrequency === 'weekly');
      const eventTime = (event) => [event.startTime, event.endTime].filter(Boolean).join(' - ') || 'Horario por confirmar';

      function expandUpcoming(events, limit = 3) {
        const today = startOfDay(new Date());
        const rangeEnd = addDays(today, 120);
        const output = [];
        events
          .filter((event) => event && event.visible !== false && ['combo', 'race_lfm', 'race_gc'].includes(String(event.type || 'combo')))
          .forEach((event) => {
            const baseStart = eventStart(event);
            if (!baseStart) return;
            const baseEnd = eventEnd(event) || baseStart;
            const durationDays = Math.max(0, daysBetween(baseStart, baseEnd));
            const repeatUntil = parseDate(event.repeatUntil);
            const hardEnd = repeatUntil && repeatUntil < rangeEnd ? repeatUntil : rangeEnd;
            let current = startOfDay(baseStart);
            if (isWeekly(event)) {
              while (addDays(current, durationDays) < today) current = addDays(current, 7);
            }
            let guard = 0;
            do {
              const currentEnd = addDays(current, durationDays);
              if (currentEnd >= today && current <= rangeEnd) {
                output.push({ ...event, occurrenceDate: keyOf(current), occurrenceEndDate: keyOf(currentEnd), isOccurrence: keyOf(current) !== keyOf(baseStart), repeatLabel: isWeekly(event) ? 'Semanal' : '' });
              }
              if (!isWeekly(event)) break;
              current = addDays(current, 7);
              guard += 1;
            } while (current <= hardEnd && guard < 80);
          });
        return output
          .sort((a, b) => String(a.occurrenceDate || a.startDate || '').localeCompare(String(b.occurrenceDate || b.startDate || '')) || String(a.startTime || '').localeCompare(String(b.startTime || '')))
          .slice(0, limit);
      }

      function renderUpcoming(items) {
        if (!items.length) {
          preview.innerHTML = '<span class="gc43-calendar-preview__empty">Sin carreras próximas en el calendario.</span>';
          return;
        }
        preview.innerHTML = items.map((event) => {
          const date = parseDate(event.occurrenceDate || event.startDate || event.date);
          const dateText = date ? `${pad(date.getDate())} ${monthNames[date.getMonth()]}` : '--';
          const type = typeLabels[String(event.type || 'combo')] || 'Evento';
          const track = [event.trackName || event.track, event.carNames].filter(Boolean).join(' · ');
          const meta = [eventTime(event), event.repeatLabel].filter(Boolean).join(' · ');
          const body = `
            <span class="gc43-calendar-preview__date">${escapeHtml(dateText)}</span>
            <span class="gc43-calendar-preview__body">
              <strong>${escapeHtml(event.title || type)}</strong>
              <small>${escapeHtml(track || meta || type)}</small>
            </span>
            <span class="gc43-calendar-preview__time">${escapeHtml(event.startTime || '--:--')}</span>
          `;
          return event.linkUrl
            ? `<a class="gc43-calendar-preview__item" href="${escapeHtml(event.linkUrl)}" target="_blank" rel="noreferrer">${body}</a>`
            : `<div class="gc43-calendar-preview__item">${body}</div>`;
        }).join('');
      }

      fetch('/api/calendar-events', { cache: 'no-store' })
        .then((response) => response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`)))
        .then((data) => renderUpcoming(expandUpcoming(data.events || data.items || [], 3)))
        .catch(() => {
          preview.innerHTML = '<span class="gc43-calendar-preview__empty">No se pudo cargar el calendario.</span>';
        });
    })();
  </script>

  <style is:global>
    /* GC_COMMUNITY_HEADER_CLEAN_V51
       Header y logo flotante deben ser globales en todas las páginas públicas.
       No ocultamos .gc-floating-hero-logo y no tocamos .gc-public-header.
    */
    .gc43{
      --green:#96ff2f;
      --green2:#77df16;
      --ink:#f5f8f1;
      --muted:rgba(245,248,241,.70);
      --line:rgba(150,255,47,.18);
      --soft:rgba(150,255,47,.075);
      color:var(--ink);
      background:#010301;
      overflow:hidden;
    }

    .gc43-shell{
      width:min(1120px, calc(100% - 44px));
      margin:0 auto;
    }

    .gc43-kicker{
      display:block;
      color:var(--green);
      font-family:var(--gc-mono, "JetBrains Mono", monospace);
      font-size:11px;
      line-height:1;
      letter-spacing:.15em;
      font-weight:950;
      text-transform:uppercase;
      margin-bottom:12px;
    }

    .gc43-kicker--blue{
      color:#7f8cff;
    }

    .gc43-hero{
      position:relative;
      height:490px;
      min-height:490px;
      overflow:hidden;
      border-bottom:1px solid rgba(150,255,47,.20);
      isolation:isolate;
    }

    .gc43-hero__video{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      filter:saturate(.78) contrast(1.12) brightness(.64);
      transform:scale(1.02);
      z-index:-4;
    }

    .gc43-hero__shade{
      position:absolute;
      inset:0;
      z-index:-3;
      background:
        linear-gradient(90deg, rgba(1,3,1,.98) 0%, rgba(1,3,1,.90) 35%, rgba(1,3,1,.34) 64%, rgba(1,3,1,.13) 100%),
        linear-gradient(180deg, rgba(1,3,1,.15) 0%, rgba(1,3,1,.10) 55%, rgba(1,3,1,.82) 100%);
    }

    .gc43-hero__grid{
      position:absolute;
      inset:0;
      z-index:-2;
      opacity:.22;
      background:
        linear-gradient(rgba(150,255,47,.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(150,255,47,.038) 1px, transparent 1px);
      background-size:54px 54px;
      mask-image:linear-gradient(90deg,#000 0%, rgba(0,0,0,.88) 42%, transparent 78%);
      pointer-events:none;
    }

    .gc43-hero__inner{
      height:100%;
      position:relative;
      display:flex;
      align-items:center;
    }

    .gc43-hero__marker{
      position:absolute;
      left:-48px;
      top:122px;
      width:18px;
      height:118px;
      display:grid;
      justify-items:center;
      grid-template-rows:14px 1fr 14px;
      opacity:.9;
    }

    .gc43-hero__marker span{
      width:10px;
      height:10px;
      border-radius:50%;
      background:var(--green);
      box-shadow:0 0 18px rgba(150,255,47,.65);
    }

    .gc43-hero__marker i{
      width:1px;
      background:linear-gradient(180deg, transparent, var(--green), transparent);
    }

    .gc43-hero__copy{
      width:650px;
      max-width:100%;
      padding-top:4px;
    }

    .gc43-hero h1{
      margin:0 0 16px;
      max-width:650px;
      color:var(--ink);
      font-size:64px;
      line-height:.91;
      letter-spacing:-.052em;
      text-transform:uppercase;
    }

    .gc43-hero h1 span{
      display:block;
    }

    .gc43-hero h1 em{
      color:var(--green);
      font-style:normal;
      text-shadow:0 0 20px rgba(150,255,47,.23);
    }

    .gc43-hero p{
      max-width:560px;
      margin:0;
      color:var(--muted);
      font-size:16px;
      line-height:1.45;
    }

    .gc43-social,
    .gc43-quick{
      display:flex;
      flex-wrap:wrap;
