      }

      .gc-combos-data-actions{
        display:grid;
        grid-template-columns:1fr 1fr;
      }

      .gc-combos-data-highlight__link{
        grid-template-columns:112px minmax(0,1fr);
      }

      .gc-combos-data-row{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }

      .gc-combos-data-row__track,
      .gc-combos-data-row__cars,
      .gc-combos-data-row__reference{
        grid-column:1/-1;
      }

      .gc-combos-data-row__track{
        grid-template-columns:96px minmax(0,1fr);
      }

      .gc-combos-data-row__media{
        width:96px;
