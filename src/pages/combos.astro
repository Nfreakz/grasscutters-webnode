    @media(prefers-reduced-motion:reduce){
      .gc-combos-data-page *,
      .gc-combos-data-page *::before,
      .gc-combos-data-page *::after{
        scroll-behavior:auto!important;
        transition:none!important;
      }
    }
  </style>

  <script is:inline src="/js/gc-track-images.js"></script>
  <script is:inline>
    (() => {
      const CONFIG = {
        refreshMs: 45000,
        settleDelayMs: 350,
        retryDelayMs: 2200,
        pageSize: 20,
        requestLimit: 1000
      };

      const els = {
        sourceState: document.getElementById('comboSourceState'),
        total: document.getElementById('comboTotal'),
        visible: document.getElementById('comboVisible'),
        updated: document.getElementById('comboUpdated'),
        sortLabel: document.getElementById('comboSortLabel'),
        metricCombos: document.getElementById('metricCombos'),
        metricActive: document.getElementById('metricActive'),
        metricLaps: document.getElementById('metricLaps'),
        metricDrivers: document.getElementById('metricDrivers'),
        metricCars: document.getElementById('metricCars'),
        metricTracks: document.getElementById('metricTracks'),
        search: document.getElementById('comboSearch'),
        source: document.getElementById('comboSource'),
        activity: document.getElementById('comboActivity'),
        sort: document.getElementById('comboSort'),
        reload: document.getElementById('reloadCombos'),
        clear: document.getElementById('clearCombos'),
        cardsMeta: document.getElementById('cardsMeta'),
        cards: document.getElementById('comboCards'),
        loadMore: document.getElementById('comboLoadMore'),
        recent: document.getElementById('comboFeatureRecent'),
        laps: document.getElementById('comboFeatureLaps'),
        clean: document.getElementById('comboFeatureClean')
      };

      if (!els.cards) return;

      const state = {
        combos: [],
        summary: null,
        visibleLimit: CONFIG.pageSize,
        lastGood: null,
        running: false,
        timer: 0,
        imageCache: new Map()
      };

      const initialParams = new URLSearchParams(window.location.search || '');
      const initialSource = initialParams.get('source');
      if (els.source && ['all','main','gt4'].includes(initialSource || '')) els.source.value = initialSource;
      if (els.search && initialParams.get('q')) els.search.value = initialParams.get('q');

      const setText = (node, value) => {
        if (node) node.textContent = String(value ?? '--');
      };

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&':'&amp;',
        '<':'&lt;',
        '>':'&gt;',
        "'":'&#39;',
        '"':'&quot;'
      }[char]));

      const number = (value, fallback = 0) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      };

      const formatNumber = (value) => Math.max(0,Math.round(number(value,0))).toLocaleString('es-ES');

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source,path)) return source[path];
        return String(path).split('.').reduce((acc,part) => acc == null ? undefined : acc[part],source);
      };

      const pick = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source,path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return undefined;
      };

      const text = (value, fallback = '') => {
        if (value == null || value === '') return fallback;
        if (Array.isArray(value)) return value.length ? text(value[0],fallback) : fallback;
        if (typeof value === 'object') {
          return text(
            value.publicName ?? value.displayName ?? value.visibleName ?? value.cleanName ??
            value.display_name ?? value.uiName ?? value.uiCarName ?? value.uiTrackName ??
            value.name ?? value.Name ?? value.driverName ?? value.playerName ?? value.code,
            fallback
          );
        }
        return String(value).replace(/_/g,' ').replace(/\s+/g,' ').trim() || fallback;
      };

      const normalize = (value) => text(value,'')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g,'')
        .trim();

      const slugify = (value) => normalize(value)
        .replace(/[^a-z0-9]+/g,'_')
        .replace(/^_+|_+$/g,'');

      const items = (data) => {
        if (Array.isArray(data)) return data;
        if (!data || typeof data !== 'object') return [];

        const candidates = [
          data.items,
          data.combos,
          data.rows,
          data.results,
          data.data,
          data.data?.items,
          data.data?.combos,
          data.data?.rows,
          data.data?.results,
          data.data?.publicCombos,
          data.publicCombos
        ];

        return candidates.find(Array.isArray) || [];
      };

      const displayTrack = (combo) => text(pick(combo,[
        'track.publicName','track.displayName','track.visibleName','track.cleanName','track.uiName','track.name',
        'publicTrackName','displayTrackName','visibleTrackName','uiTrackName','trackName'
      ]),'Combo sin identificar');

      const trackCode = (combo) => String(pick(combo,[
        'track.trackCode','track.rawCode','track.code','trackCode','trackRaw','rawTrackName'
      ]) || '').trim();

      const trackConfig = (combo) => String(pick(combo,[
        'track.trackConfig','track.layout','track.config','trackConfig','layout'
      ]) || '').trim();

      const sourceKey = (combo) => {
        const source = normalize(pick(combo,['sourceKey','source','bestLap.sourceKey','latestLap.sourceKey']));
        return source === 'gt4' ? 'gt4' : 'main';
      };

      const sourceLabel = (combo) => {
        const direct = text(pick(combo,['sourceLabel','serverName','sourceName']),'');
        if (direct) return direct;
        return sourceKey(combo) === 'gt4' ? 'Supra GT4' : 'Liga GrassCutters';
      };

      const cars = (combo) => {
        const raw = pick(combo,['carNames','cars','carList','availableCars','comboCars']);
        const array = Array.isArray(raw) ? raw : (typeof raw === 'string' ? raw.split(/[,|;]/g) : []);
        const seen = new Set();
        return array
          .map((car) => text(car,''))
          .filter(Boolean)
          .filter((name) => {
            const key = normalize(name);
            if (!key || seen.has(key)) return false;
            seen.add(key);
            return true;
          });
      };

      const comboId = (combo) => pick(combo,['comboUid','comboKey','key','canonicalComboId','comboId','id']);

      const comboUrl = (combo) => {
        const id = comboId(combo);
        if (id !== null && id !== undefined && id !== '') return `/combos/${encodeURIComponent(id)}`;
        const detail = combo?.detailUrl || combo?.comboUrl || combo?.url;
        if (detail && !String(detail).includes('?')) return detail;
        return '/combos';
      };

      const totalLaps = (combo) => number(pick(combo,['totalLaps','stats.totalLaps','laps']),0);
      const validLaps = (combo) => number(pick(combo,['validLaps','stats.validLaps','cleanLaps']),0);
      const driversCount = (combo) => number(pick(combo,['driversCount','stats.driversCount','pilotsCount','totalDrivers']),0);
      const cleanRate = (combo) => totalLaps(combo)
        ? Math.round((validLaps(combo) / totalLaps(combo)) * 100)
        : number(pick(combo,['cleanRate','cleanPercentage']),0);
      const bestMs = (combo) => number(pick(combo,[
        'bestLapMs','bestLapTimeMs','bestLap.lapTimeMs','bestLap.LapTime'
      ]),Infinity);

      const bestTime = (combo) => {
        const direct = text(pick(combo,[
          'bestLapTimeFormatted','bestLapTime','bestTimeFormatted','bestTime',
          'bestLap.lapTimeFormatted','bestLap.lapTimeText','bestLap.lapTime'
        ]),'');
        if (direct) return direct;
        const ms = bestMs(combo);
        if (!Number.isFinite(ms) || ms <= 0) return '--';
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        const millis = Math.floor(ms % 1000);
        return `${minutes}:${String(seconds).padStart(2,'0')}.${String(millis).padStart(3,'0')}`;
      };

      const bestDriver = (combo) => text(pick(combo,[
        'bestLap.driver.displayName','bestLap.driver.name','bestLap.driverName','bestLap.playerName',
        'bestDriverName','fastestDriverName','leaderName'
      ]),'Sin piloto');

      const bestCar = (combo) => text(pick(combo,[
        'bestLap.car.displayName','bestLap.car.name','bestLap.carName','bestCarName','fastestCarName'
      ]),cars(combo)[0] || 'Coche sin identificar');

      const lastMs = (combo) => {
        const direct = pick(combo,[
          'lastSeenTimestamp','latestLap.timestamp','latestLap.timestampIso','lastActivityTimestamp'
        ]);
        if (typeof direct === 'number') return direct > 20000000000 ? direct : direct * 1000;
        if (direct) {
          const parsed = Date.parse(String(direct));
          if (Number.isFinite(parsed)) return parsed;
        }
        const raw = pick(combo,[
          'lastSeenAt','lastActivityIso','lastActivityAt','latestLapAt','updatedAt'
        ]);
        if (!raw) return 0;
        const parsed = Date.parse(String(raw));
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const formatDate = (combo) => {
        const ms = lastMs(combo);
        if (!ms) return 'Sin fecha';
        return new Date(ms).toLocaleString('es-ES',{
          day:'2-digit',
          month:'2-digit',
          hour:'2-digit',
          minute:'2-digit'
        });
      };

      const carLine = (combo) => {
        const list = cars(combo);
        if (!list.length) return 'Paquete por confirmar';
        const shown = list.slice(0,2).join(' + ');
        return list.length > 2 ? `${shown} + ${list.length - 2} más` : shown;
      };

      const imageCandidates = (combo) => {
        const candidates = [];
        const code = trackCode(combo);
        const config = trackConfig(combo);
        const track = displayTrack(combo);
        const params = new URLSearchParams();
        params.set('kind','photo');
        params.set('strict','1');
        params.set('source',sourceKey(combo) === 'gt4' ? 'gt4' : 'weekly');
        if (code) params.set('trackCode',code);
        if (config) params.set('trackConfig',config);
        if (track) params.set('name',track);
        if (code || track) candidates.push(`/api/gc/track-assets/file?${params.toString()}`);

        const helper = window.GCTrackImages;
        if (helper?.candidates) candidates.push(...helper.candidates(code || track));

        const slugs = [...new Set([slugify(code),slugify(track)].filter(Boolean))];
        slugs.forEach((slug) => {
          candidates.push(
            `/images/tracks/${slug}.webp`,
            `/images/tracks/${slug}.jpg`,
            `/images/tracks/${slug}.png`
          );
        });

        return [...new Set(candidates)].filter((url) => url && !url.includes('object_object'));
      };

      const imageKey = (combo) => `${sourceKey(combo)}|${normalize(trackCode(combo) || displayTrack(combo))}|${normalize(trackConfig(combo))}`;

      const resolveImage = (combo) => {
        const key = imageKey(combo);
        if (state.imageCache.has(key)) return state.imageCache.get(key);

        const task = (async () => {
          for (const url of imageCandidates(combo).slice(0,10)) {
            try {
              const response = await fetch(url,{ cache:'force-cache',credentials:'same-origin' });
              if (!response.ok) continue;
              const type = String(response.headers.get('content-type') || '').toLowerCase();
              const blob = await response.blob();
              if (!blob.size || type.includes('svg') || blob.type.includes('svg')) continue;
              if (blob.size < 800) continue;
              return URL.createObjectURL(blob);
            } catch {}
          }
          return '';
        })();

        state.imageCache.set(key,task);
        return task;
      };

      const hydrateImages = (root = document) => {
        root.querySelectorAll('img[data-combo-track-image]:not([data-image-hydrated])').forEach((img) => {
          img.dataset.imageHydrated = '1';
          const combo = state.combos.find((item) => String(comboId(item) ?? '') === img.dataset.comboId)
            || state.combos.find((item) => imageKey(item) === img.dataset.imageKey);
          if (!combo) return;
          resolveImage(combo).then((url) => {
            if (!url || !img.isConnected) return;
            img.src = url;
            img.hidden = false;
          });
        });
      };

      const imageMarkup = (combo, className = '') => `
        <div class="${className}">
          <img
            data-combo-track-image
            data-combo-id="${escapeHtml(String(comboId(combo) ?? ''))}"
            data-image-key="${escapeHtml(imageKey(combo))}"
            alt=""
            loading="lazy"
            decoding="async"
            hidden
          />
        </div>
      `;

      const renderFeature = (combo,label,target) => {
        if (!target) return;
        if (!combo) {
          target.innerHTML = '<p class="gc-combos-data-loading">Sin datos suficientes.</p>';
          return;
        }

        target.innerHTML = `
          <a class="gc-combos-data-highlight__link" href="${escapeHtml(comboUrl(combo))}">
            ${imageMarkup(combo,'gc-combos-data-highlight__media')}
            <span class="gc-combos-data-highlight__label">${escapeHtml(label)}</span>
            <div class="gc-combos-data-highlight__body">
              <h3>${escapeHtml(displayTrack(combo))}</h3>
              <p class="gc-combos-data-highlight__reference">${escapeHtml(bestDriver(combo))} · ${escapeHtml(bestTime(combo))}</p>
              <p class="gc-combos-data-highlight__stats">
                ${escapeHtml(formatNumber(totalLaps(combo)))} vueltas ·
                ${escapeHtml(formatNumber(driversCount(combo)))} pilotos ·
                ${escapeHtml(String(cleanRate(combo)))}% limpias
              </p>
            </div>
          </a>
        `;
      };

      const renderRow = (combo) => `
        <article class="gc-combos-data-row">
          <div class="gc-combos-data-row__track">
            ${imageMarkup(combo,'gc-combos-data-row__media')}
            <div>
              <h3>${escapeHtml(displayTrack(combo))}</h3>
              <span class="gc-combos-data-row__source">${escapeHtml(sourceLabel(combo))}</span>
              <span class="gc-combos-data-row__muted">ID ${escapeHtml(String(comboId(combo) ?? '--'))}</span>
            </div>
          </div>
          <div class="gc-combos-data-row__cars">${escapeHtml(carLine(combo))}</div>
          <div class="gc-combos-data-row__number gc-combos-data-row__laps">${escapeHtml(formatNumber(totalLaps(combo)))}</div>
          <div class="gc-combos-data-row__number gc-combos-data-row__drivers">${escapeHtml(formatNumber(driversCount(combo)))}</div>
          <div class="gc-combos-data-row__number gc-combos-data-row__clean">${escapeHtml(String(cleanRate(combo)))}%</div>
          <div class="gc-combos-data-row__reference">
            <strong>${escapeHtml(bestTime(combo))}</strong>
            <span>${escapeHtml(bestDriver(combo))} · ${escapeHtml(bestCar(combo))}</span>
          </div>
          <div class="gc-combos-data-row__date">${escapeHtml(formatDate(combo))}</div>
          <a class="gc-combos-data-row__open" href="${escapeHtml(comboUrl(combo))}" aria-label="Abrir ficha de ${escapeHtml(displayTrack(combo))}">Abrir</a>
        </article>
      `;

      const searchText = (combo) => [
        sourceKey(combo),
        sourceLabel(combo),
        displayTrack(combo),
        trackCode(combo),
        ...cars(combo),
        comboId(combo),
        combo?.carSummary,
        combo?.usedCarSummary
      ].join(' ').toLowerCase();

      const passesActivity = (combo) => {
        const value = els.activity?.value || 'all';
        if (value === 'all') return true;
        if (value === 'active') return totalLaps(combo) > 0;
        const days = Number(value);
        if (!Number.isFinite(days)) return true;
        return lastMs(combo) >= Date.now() - days * 86400000;
      };

      const sortRows = (rows) => {
        const mode = els.sort?.value || 'recent';
        return [...rows].sort((a,b) => {
          if (mode === 'laps') return totalLaps(b) - totalLaps(a);
          if (mode === 'drivers') return driversCount(b) - driversCount(a);
          if (mode === 'clean') return cleanRate(b) - cleanRate(a) || totalLaps(b) - totalLaps(a);
          if (mode === 'fastest') return bestMs(a) - bestMs(b);
          if (mode === 'cars') return cars(b).length - cars(a).length;
          return lastMs(b) - lastMs(a);
        });
      };

      const visibleRows = () => {
        const query = normalize(els.search?.value || '');
        return sortRows(state.combos.filter((combo) => {
          if (query && !normalize(searchText(combo)).includes(query)) return false;
          return passesActivity(combo);
        }));
      };

      const updateUrlState = () => {
        const params = new URLSearchParams(window.location.search || '');
        const source = els.source?.value || 'all';
        const query = String(els.search?.value || '').trim();
        if (source === 'all') params.delete('source');
        else params.set('source',source);
        if (query) params.set('q',query);
        else params.delete('q');
        const next = `${window.location.pathname}${params.size ? `?${params}` : ''}`;
        window.history.replaceState({},'',next);
      };

      const draw = () => {
        const rows = visibleRows();
        const shown = rows.slice(0,state.visibleLimit);

        setText(els.total,formatNumber(state.combos.length));
        setText(els.visible,formatNumber(rows.length));
        setText(els.updated,new Date().toLocaleTimeString('es-ES',{ hour:'2-digit',minute:'2-digit' }));
        setText(els.sortLabel,els.sort?.selectedOptions?.[0]?.textContent || 'Actividad reciente');

        const uniqueCars = new Set();
        const uniqueTracks = new Set();
        state.combos.forEach((combo) => {
          cars(combo).forEach((car) => uniqueCars.add(normalize(car)));
          uniqueTracks.add(normalize(trackCode(combo) || displayTrack(combo)));
        });

        const summaryDrivers = number(
          state.summary?.driversCount ?? state.summary?.totalDrivers ?? state.summary?.summary?.driversCount,
          NaN
        );
        const derivedDrivers = state.combos.reduce((max,combo) => Math.max(max,driversCount(combo)),0);

        setText(els.metricCombos,formatNumber(state.summary?.totalCombos ?? state.summary?.count ?? state.combos.length));
        setText(els.metricActive,formatNumber(state.summary?.activeCombos ?? state.combos.filter((combo) => totalLaps(combo) > 0).length));
        setText(els.metricLaps,formatNumber(state.summary?.totalLaps ?? state.combos.reduce((sum,combo) => sum + totalLaps(combo),0)));
        setText(els.metricDrivers,formatNumber(Number.isFinite(summaryDrivers) ? summaryDrivers : derivedDrivers));
        setText(els.metricCars,formatNumber(state.summary?.carsCount ?? state.summary?.totalCars ?? uniqueCars.size));
        setText(els.metricTracks,formatNumber(state.summary?.tracksCount ?? state.summary?.totalTracks ?? uniqueTracks.size));

        const activeCombo = state.summary?.activeCombo || null;
        const mostRecent = activeCombo || [...state.combos]
          .filter((combo) => totalLaps(combo) > 0)
          .sort((a,b) => lastMs(b) - lastMs(a))[0];
        const mostLaps = [...state.combos].sort((a,b) => totalLaps(b) - totalLaps(a))[0];
        const cleanest = [...state.combos]
          .filter((combo) => totalLaps(combo) >= 1)
          .sort((a,b) => cleanRate(b) - cleanRate(a) || totalLaps(b) - totalLaps(a))[0];

        renderFeature(mostRecent,'Combo activo',els.recent);
        renderFeature(mostLaps,'Más rodado',els.laps);
        renderFeature(cleanest,'Más limpio',els.clean);

        setText(els.cardsMeta,`${formatNumber(shown.length)} de ${formatNumber(rows.length)} visibles`);
        els.cards.innerHTML = shown.length
          ? shown.map(renderRow).join('')
          : '<article class="gc-combos-data-empty">Sin combos con esos filtros.</article>';

        if (els.loadMore) {
          els.loadMore.hidden = shown.length >= rows.length;
          els.loadMore.textContent = `Ver más combos (${formatNumber(rows.length - shown.length)})`;
        }

        hydrateImages(document);
        updateUrlState();
        document.documentElement.dataset.gcCombosDataCore = 'primary';
        document.documentElement.dataset.gcCombosDataCoreVersion = 'v2-technical-list';

        window.GCCombosDataCorePrimary = {
          status:'ok',
          combos:state.combos,
          summary:state.summary,
          visible:rows.length,
          renderedAt:new Date().toISOString()
        };
      };

      const showLoadState = (message,isError = false) => {
        if (!state.lastGood) {
          els.cards.innerHTML = `<article class="gc-combos-data-empty${isError ? ' gc-combos-data-error' : ''}">${escapeHtml(message)}</article>`;
        }
        setText(els.cardsMeta,message);
      };

      const fetchJson = async (url) => {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(),10000);
        try {
          const response = await fetch(url,{
            credentials:'include',
            cache:'no-store',
            signal:controller.signal
          });
          const data = await response.json().catch(() => null);
          if (!response.ok || !data) throw new Error(`${url} ${response.status}`);
          return data;
        } finally {
          window.clearTimeout(timeout);
        }
      };

      const load = async () => {
        if (state.running) return;
        state.running = true;
        if (els.reload) els.reload.disabled = true;
        showLoadState('Actualizando datos...');

        try {
          const source = ['all','main','gt4'].includes(els.source?.value || '')
            ? els.source.value
            : 'all';
          const url = new URL('/api/gc/combos',window.location.origin);
          url.searchParams.set('source',source);
          url.searchParams.set('limit',String(CONFIG.requestLimit));
          url.searchParams.set('sort',els.sort?.value || 'recent');
          const data = await fetchJson(url.pathname + url.search);

          const nextCombos = items(data);
          if (!Array.isArray(nextCombos)) throw new TypeError('La respuesta de combos no contiene un listado válido');
          state.combos = nextCombos;
          state.summary = data;
          state.lastGood = {
            combos:state.combos,
            summary:state.summary,
            loadedAt:new Date().toISOString()
          };

          setText(els.sourceState,text(data.source || data.normalizedBy,'GC Database'));
          draw();
        } catch (error) {
          console.warn('[GC /combos] Data Core unavailable:',error);
          document.documentElement.dataset.gcCombosDataCore = state.lastGood ? 'primary-stale' : 'error';
          if (state.lastGood) {
            state.combos = state.lastGood.combos;
            state.summary = state.lastGood.summary;
            draw();
            setText(els.cardsMeta,'Mostrando la última carga disponible');
          } else {
            showLoadState('No se han podido cargar los combos. Pulsa Actualizar.',true);
          }
        } finally {
          state.running = false;
          if (els.reload) els.reload.disabled = false;
        }
      };

      let searchTimer = 0;
      els.search?.addEventListener('input',() => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          state.visibleLimit = CONFIG.pageSize;
          draw();
        },120);
      });

      [els.activity,els.sort].forEach((input) => {
        input?.addEventListener('change',() => {
          state.visibleLimit = CONFIG.pageSize;
          draw();
        });
      });

      els.source?.addEventListener('change',() => {
        state.visibleLimit = CONFIG.pageSize;
        load();
      });

      els.reload?.addEventListener('click',load);

      els.clear?.addEventListener('click',() => {
        if (els.search) els.search.value = '';
        if (els.source) els.source.value = 'all';
        if (els.activity) els.activity.value = 'all';
        if (els.sort) els.sort.value = 'recent';
        state.visibleLimit = CONFIG.pageSize;
        load();
      });

      els.loadMore?.addEventListener('click',() => {
        state.visibleLimit += CONFIG.pageSize;
        draw();
      });

      const start = () => {
        window.clearInterval(state.timer);
        window.setTimeout(load,CONFIG.settleDelayMs);
        state.timer = window.setInterval(load,CONFIG.refreshMs);
      };

      window.GCCombosDataCorePrimaryReload = load;
      window.GCCombosRuntimeStatus = () => ({
        runtime:'data-core-technical-list-v2',
        dataCore:document.documentElement.dataset.gcCombosDataCore || null,
        dataCoreVersion:document.documentElement.dataset.gcCombosDataCoreVersion || null,
        loaded:state.combos.length,
        visible:visibleRows().length,
        trackImages:window.GCTrackImages?.version || null
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded',start,{ once:true });
      } else {
        start();
      }

      window.addEventListener('load',() => window.setTimeout(() => {
        if (!state.lastGood) load();
      },CONFIG.retryDelayMs),{ once:true });
    })();
  </script>
</AppLayout>
