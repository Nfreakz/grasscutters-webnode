      }

      .gc-combos-data-pulse div:nth-child(2n){
        border-right:0;
      }

      .gc-combos-data-pulse div:nth-child(-n+4){
        border-bottom:1px solid rgba(150,255,47,.16);
      }

      .gc-combos-data-filters{
