---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout
  title="Combos | GrassCutters Racing"
  description="Consulta técnica de combos GrassCutters con circuitos, coches, actividad, referencias y estadísticas consolidadas."
  canonicalPath="/combos"
  ogImage="/og/combos-og-v1531.png"
  ogImageAlt="Combos GrassCutters Racing"
>
  <div class="gc-page gc-combos-data-page" data-combos-data-page>
    <header class="gc-combos-data-head">
      <div class="gc-combos-data-head__copy">
        <p class="gc-combos-data-kicker">STRACKER / COMBO DATA</p>
        <h1>Combos Data.</h1>
        <p>Explora los circuitos y paquetes de coches registrados en la plataforma.</p>
        <p>Actividad, vueltas, pilotos y mejores referencias en una única vista técnica.</p>
      </div>

      <aside class="gc-combos-data-source" aria-label="Estado de los datos">
        <dl>
          <div><dt>Fuente</dt><dd id="comboSourceState">GC Database</dd></div>
          <div><dt>Cargados</dt><dd id="comboTotal">--</dd></div>
          <div><dt>Visibles</dt><dd id="comboVisible">--</dd></div>
          <div><dt>Actualizado</dt><dd id="comboUpdated">--</dd></div>
        </dl>
      </aside>
    </header>

    <section class="gc-combos-data-pulse" aria-label="Resumen de combos">
      <div><span>Combos</span><strong id="metricCombos">--</strong></div>
      <div><span>Con actividad</span><strong id="metricActive">--</strong></div>
      <div><span>Vueltas</span><strong id="metricLaps">--</strong></div>
      <div><span>Pilotos</span><strong id="metricDrivers">--</strong></div>
      <div><span>Coches</span><strong id="metricCars">--</strong></div>
      <div><span>Circuitos</span><strong id="metricTracks">--</strong></div>
    </section>

    <section class="gc-combos-data-filters" aria-label="Filtros de combos">
      <label class="gc-combos-data-search">
        <span>Buscar</span>
        <input id="comboSearch" type="search" placeholder="circuito, coche o Combo ID" autocomplete="off" />
      </label>

      <label>
        <span>Servidor</span>
        <select id="comboSource">
          <option value="all">Todos</option>
          <option value="main">Liga GrassCutters</option>
          <option value="gt4">Supra GT4</option>
        </select>
      </label>

      <label>
        <span>Actividad</span>
        <select id="comboActivity">
          <option value="all">Todos</option>
          <option value="active">Con vueltas</option>
          <option value="7">Últimos 7 días</option>
          <option value="30">Últimos 30 días</option>
        </select>
      </label>

      <label>
        <span>Orden</span>
        <select id="comboSort">
          <option value="recent">Actividad reciente</option>
          <option value="laps">Más vueltas</option>
          <option value="drivers">Más pilotos</option>
          <option value="clean">Mayor limpieza</option>
          <option value="fastest">Mejor tiempo</option>
          <option value="cars">Más coches</option>
        </select>
      </label>

      <div class="gc-combos-data-actions">
        <button id="reloadCombos" class="gc-combos-data-button gc-combos-data-button--primary" type="button">Actualizar</button>
        <button id="clearCombos" class="gc-combos-data-button" type="button">Limpiar</button>
      </div>
    </section>

    <section class="gc-combos-data-highlights" aria-label="Combos destacados">
      <article id="comboFeatureRecent" class="gc-combos-data-highlight" aria-live="polite">
        <p class="gc-combos-data-loading">Cargando combo activo...</p>
      </article>
      <article id="comboFeatureLaps" class="gc-combos-data-highlight" aria-live="polite">
        <p class="gc-combos-data-loading">Cargando combo más rodado...</p>
      </article>
      <article id="comboFeatureClean" class="gc-combos-data-highlight" aria-live="polite">
        <p class="gc-combos-data-loading">Cargando combo más limpio...</p>
      </article>
    </section>

    <section class="gc-combos-data-list-panel" aria-labelledby="combosListTitle">
      <header class="gc-combos-data-list-head">
        <div>
          <p class="gc-combos-data-kicker">EXPLORADOR</p>
          <h2 id="combosListTitle">Todos los combos</h2>
        </div>
        <div class="gc-combos-data-list-status">
          <span id="cardsMeta" role="status">Cargando combos...</span>
          <span id="comboSortLabel">Actividad reciente</span>
        </div>
      </header>

      <div class="gc-combos-data-columns" aria-hidden="true">
        <span>Circuito / servidor</span>
        <span>Paquete de coches</span>
        <span>Vueltas</span>
        <span>Pilotos</span>
        <span>Limpias</span>
        <span>Referencia</span>
        <span>Actividad</span>
        <span>Ficha</span>
      </div>

      <div id="comboCards" class="gc-combos-data-list" aria-live="polite">
        <article class="gc-combos-data-empty">Cargando combos...</article>
      </div>

      <div class="gc-combos-data-more">
        <button id="comboLoadMore" class="gc-combos-data-button gc-combos-data-button--primary" type="button">
          Ver más combos
        </button>
      </div>
    </section>
  </div>

  <style is:global>
    .gc-combos-data-page{
      --combos-green:var(--accent,#96ff2f);
      --combos-text:var(--text,#f4fff1);
      --combos-muted:var(--muted,#84907c);
      --combos-line:rgba(150,255,47,.22);
      --combos-line-soft:rgba(150,255,47,.13);
      --combos-panel:rgba(3,9,5,.92);
      display:grid;
      gap:12px;
      width:min(1680px,calc(100vw - 48px));
      max-width:1680px;
      margin:0 auto;
      padding:28px 0 56px;
      box-sizing:border-box;
    }

    html[data-gc-scope="marketing"] body.gc-page-platform-data .gc-public-main{
      padding-top:0;
    }

    .gc-combos-data-head{
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(300px,380px);
      align-items:stretch;
      border:1px solid var(--combos-line);
      background:linear-gradient(90deg,rgba(6,14,8,.96),rgba(9,24,10,.72));
    }

    .gc-combos-data-head__copy{
      padding:18px 22px;
    }

    .gc-combos-data-kicker,
    .gc-combos-data-source dt,
    .gc-combos-data-filters label > span,
    .gc-combos-data-columns{
      margin:0;
      color:var(--combos-green);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:10px;
      font-weight:950;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .gc-combos-data-head h1{
      margin:4px 0 5px;
      color:var(--combos-text);
      font-size:clamp(36px,4.6vw,74px);
      line-height:.86;
      letter-spacing:-.065em;
      text-transform:uppercase;
    }

    .gc-combos-data-head__copy > p:not(.gc-combos-data-kicker){
      max-width:850px;
      margin:0;
      color:rgba(244,255,241,.70);
      font-size:14px;
    }

    .gc-combos-data-source{
      border-left:1px solid var(--combos-line);
      background:rgba(0,0,0,.18);
    }

    .gc-combos-data-source dl{
      display:grid;
      grid-template-columns:1fr 1fr;
      height:100%;
      margin:0;
    }

    .gc-combos-data-source div{
      min-width:0;
      padding:14px;
      border-right:1px solid var(--combos-line-soft);
      border-bottom:1px solid var(--combos-line-soft);
    }

    .gc-combos-data-source div:nth-child(2n){
      border-right:0;
    }

    .gc-combos-data-source div:nth-last-child(-n+2){
      border-bottom:0;
    }

    .gc-combos-data-source dd{
      margin:4px 0 0;
      overflow:hidden;
      color:var(--combos-text);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:16px;
      font-weight:950;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .gc-combos-data-pulse{
      display:grid;
      grid-template-columns:repeat(6,minmax(0,1fr));
      border:1px solid var(--combos-line);
      background:var(--combos-panel);
    }

    .gc-combos-data-pulse div{
      min-width:0;
      padding:12px 14px;
      border-right:1px solid rgba(150,255,47,.16);
    }

    .gc-combos-data-pulse div:last-child{
      border-right:0;
    }

    .gc-combos-data-pulse span{
      display:block;
      color:var(--combos-muted);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:10px;
      font-weight:950;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .gc-combos-data-pulse strong{
      display:block;
      margin-top:4px;
      overflow:hidden;
      color:var(--combos-green);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:18px;
      font-weight:950;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .gc-combos-data-filters{
      display:grid;
      grid-template-columns:minmax(260px,1.7fr) repeat(3,minmax(160px,.8fr)) auto;
      gap:8px;
      align-items:end;
      padding:10px;
      border:1px solid var(--combos-line);
      background:rgba(3,9,5,.88);
    }

    .gc-combos-data-filters label{
      display:grid;
      gap:5px;
      min-width:0;
    }

    .gc-combos-data-filters input,
    .gc-combos-data-filters select{
      width:100%;
      height:38px;
      padding:0 10px;
      border:1px solid rgba(150,255,47,.32);
      border-radius:0;
      outline:none;
      background:#020603;
      color:var(--combos-text);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:12px;
      font-weight:800;
    }

    .gc-combos-data-filters input:focus,
    .gc-combos-data-filters select:focus{
      border-color:var(--combos-green);
      box-shadow:0 0 0 1px rgba(150,255,47,.18);
    }

    .gc-combos-data-actions{
      display:flex;
      gap:8px;
    }

    .gc-combos-data-button{
      min-height:38px;
      padding:0 14px;
      border:1px solid rgba(150,255,47,.38);
      border-radius:0;
      background:rgba(3,8,4,.9);
      color:var(--combos-text);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:11px;
      font-weight:950;
      letter-spacing:.08em;
      text-transform:uppercase;
      cursor:pointer;
    }

    .gc-combos-data-button:hover,
    .gc-combos-data-button:focus-visible{
      border-color:var(--combos-green);
      color:var(--combos-green);
    }

    .gc-combos-data-button--primary{
      border-color:var(--combos-green);
      background:var(--combos-green);
      color:#071005;
    }

    .gc-combos-data-button--primary:hover,
    .gc-combos-data-button--primary:focus-visible{
      background:#b5ff69;
      color:#071005;
    }

    .gc-combos-data-button:disabled{
      opacity:.45;
      cursor:wait;
    }

    .gc-combos-data-highlights{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      border:1px solid var(--combos-line);
      background:var(--combos-panel);
    }

    .gc-combos-data-highlight{
      position:relative;
      min-width:0;
      min-height:126px;
      border-right:1px solid var(--combos-line-soft);
      background:rgba(3,9,5,.9);
    }

    .gc-combos-data-highlight:last-child{
      border-right:0;
    }

    .gc-combos-data-highlight__link{
      display:grid;
      grid-template-columns:132px minmax(0,1fr);
      height:100%;
      color:inherit;
      text-decoration:none;
    }

    .gc-combos-data-highlight__media,
    .gc-combos-data-row__media{
      position:relative;
      overflow:hidden;
      min-height:100%;
      border-right:1px solid var(--combos-line-soft);
      background:
        linear-gradient(145deg,rgba(150,255,47,.08),transparent 55%),
        #071108;
    }

    .gc-combos-data-highlight__media::before,
    .gc-combos-data-row__media::before{
      content:"GC";
      position:absolute;
      right:8px;
      bottom:0;
      color:rgba(150,255,47,.12);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:34px;
      font-weight:950;
      letter-spacing:-.08em;
    }

    .gc-combos-data-highlight__media img,
    .gc-combos-data-row__media img{
      position:absolute;
      inset:0;
      z-index:1;
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .gc-combos-data-highlight__label{
      position:absolute;
      z-index:2;
      top:8px;
      left:8px;
      padding:4px 6px;
      border:1px solid rgba(150,255,47,.45);
      background:rgba(2,7,3,.9);
      color:var(--combos-green);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:9px;
      font-weight:950;
      letter-spacing:.1em;
      text-transform:uppercase;
    }

    .gc-combos-data-highlight__body{
      display:grid;
      align-content:center;
      gap:5px;
      min-width:0;
      padding:12px 14px;
    }

    .gc-combos-data-highlight h3{
      margin:0;
      overflow:hidden;
      color:var(--combos-text);
      font-size:20px;
      line-height:1;
      text-overflow:ellipsis;
      text-transform:uppercase;
      white-space:nowrap;
    }

    .gc-combos-data-highlight__reference,
    .gc-combos-data-highlight__stats{
      margin:0;
      overflow:hidden;
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .gc-combos-data-highlight__reference{
      color:rgba(244,255,241,.72);
      font-size:11px;
      font-weight:800;
    }

    .gc-combos-data-highlight__stats{
      color:var(--combos-green);
      font-size:10px;
      font-weight:900;
      letter-spacing:.04em;
      text-transform:uppercase;
    }

    .gc-combos-data-highlight__link:hover h3,
    .gc-combos-data-highlight__link:focus-visible h3{
      color:var(--combos-green);
    }

    .gc-combos-data-list-panel{
      border:1px solid var(--combos-line);
      background:var(--combos-panel);
    }

    .gc-combos-data-list-head{
      display:flex;
      justify-content:space-between;
      gap:20px;
      align-items:end;
      min-height:64px;
      padding:10px 14px;
      border-bottom:1px solid var(--combos-line);
      background:rgba(4,12,5,.96);
    }

    .gc-combos-data-list-head h2{
      margin:2px 0 0;
      color:var(--combos-text);
      font-size:23px;
      line-height:1;
      text-transform:uppercase;
    }

    .gc-combos-data-list-status{
      display:flex;
      gap:18px;
      align-items:center;
      color:var(--combos-muted);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:10px;
      font-weight:850;
      letter-spacing:.06em;
      text-transform:uppercase;
    }

    .gc-combos-data-list-status span:last-child{
      color:var(--combos-green);
    }

    .gc-combos-data-columns,
    .gc-combos-data-row{
      display:grid;
      grid-template-columns:minmax(260px,1.35fr) minmax(220px,1.1fr) 90px 76px 78px minmax(190px,1fr) 118px 76px;
      align-items:center;
    }

    .gc-combos-data-columns{
      min-height:34px;
      padding:0 12px;
      border-bottom:1px solid var(--combos-line);
      background:rgba(5,16,6,.98);
    }

    .gc-combos-data-columns span{
      min-width:0;
      padding:0 8px;
    }

    .gc-combos-data-list{
      display:grid;
    }

    .gc-combos-data-row{
      min-height:78px;
      border-bottom:1px solid var(--combos-line-soft);
      color:var(--combos-text);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
    }

    .gc-combos-data-row:nth-child(even){
      background:rgba(150,255,47,.022);
    }

    .gc-combos-data-row:hover{
      background:rgba(150,255,47,.055);
    }

    .gc-combos-data-row:last-child{
      border-bottom:0;
    }

    .gc-combos-data-row > div,
    .gc-combos-data-row > a{
      min-width:0;
      padding:8px;
    }

    .gc-combos-data-row__track{
      display:grid;
      grid-template-columns:104px minmax(0,1fr);
      gap:10px;
      align-items:center;
    }

    .gc-combos-data-row__media{
      width:104px;
      height:58px;
      border:1px solid var(--combos-line-soft);
    }

    .gc-combos-data-row__track h3{
      margin:0;
      overflow:hidden;
      color:var(--combos-text);
      font-family:Inter,system-ui,sans-serif;
      font-size:14px;
      font-weight:900;
      line-height:1.1;
      text-overflow:ellipsis;
      text-transform:uppercase;
      white-space:nowrap;
    }

    .gc-combos-data-row__source,
    .gc-combos-data-row__muted,
    .gc-combos-data-row__label{
      display:block;
      margin-top:4px;
      overflow:hidden;
      color:var(--combos-muted);
      font-size:9px;
      font-weight:850;
      letter-spacing:.06em;
      text-overflow:ellipsis;
      text-transform:uppercase;
      white-space:nowrap;
    }

    .gc-combos-data-row__cars{
      overflow:hidden;
      color:rgba(244,255,241,.78);
      font-size:10px;
      font-weight:800;
      line-height:1.35;
      text-overflow:ellipsis;
    }

    .gc-combos-data-row__number{
      color:var(--combos-text);
      font-size:13px;
      font-weight:950;
    }

    .gc-combos-data-row__clean{
      color:var(--combos-green);
    }

    .gc-combos-data-row__reference strong{
      display:block;
      overflow:hidden;
      color:var(--combos-green);
      font-size:12px;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .gc-combos-data-row__reference span{
      display:block;
      margin-top:3px;
      overflow:hidden;
      color:rgba(244,255,241,.68);
      font-size:9px;
      font-weight:800;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .gc-combos-data-row__date{
      color:rgba(244,255,241,.72);
      font-size:10px;
      font-weight:800;
      line-height:1.35;
    }

    .gc-combos-data-row__open{
      display:inline-flex;
      width:54px;
      min-height:32px;
      align-items:center;
      justify-content:center;
      justify-self:start;
      border:1px solid var(--combos-green);
      color:var(--combos-green);
      font-size:10px;
      font-weight:950;
      letter-spacing:.08em;
      text-decoration:none;
      text-transform:uppercase;
    }

    .gc-combos-data-row__open:hover,
    .gc-combos-data-row__open:focus-visible{
      background:var(--combos-green);
      color:#071005;
    }

    .gc-combos-data-more{
      display:flex;
      justify-content:center;
      padding:12px;
      border-top:1px solid var(--combos-line);
    }

    .gc-combos-data-more button{
      min-width:220px;
    }

    .gc-combos-data-empty,
    .gc-combos-data-loading{
      margin:0;
      padding:24px;
      color:var(--combos-muted);
      font-family:var(--gc-mono,"JetBrains Mono",monospace);
      font-size:11px;
      font-weight:850;
      letter-spacing:.06em;
      text-transform:uppercase;
    }

    .gc-combos-data-error{
      color:#ffcf5a;
    }

    @media(max-width:1280px){
      .gc-combos-data-columns,
      .gc-combos-data-row{
        grid-template-columns:minmax(240px,1.4fr) minmax(180px,1fr) 76px 68px 70px minmax(160px,.9fr) 104px 68px;
      }

      .gc-combos-data-row__track{
        grid-template-columns:86px minmax(0,1fr);
      }

      .gc-combos-data-row__media{
        width:86px;
      }
    }

    @media(max-width:1060px){
      .gc-combos-data-page{
        width:min(100% - 28px,1680px);
      }

      .gc-combos-data-filters{
        grid-template-columns:minmax(240px,1.5fr) repeat(3,minmax(140px,1fr));
      }

      .gc-combos-data-actions{
        grid-column:1/-1;
      }

      .gc-combos-data-highlight__link{
        grid-template-columns:92px minmax(0,1fr);
      }

      .gc-combos-data-highlight__body{
        padding:10px 12px;
      }

      .gc-combos-data-highlight h3{
        font-size:17px;
      }

      .gc-combos-data-highlight__stats{
        line-height:1.35;
        text-overflow:clip;
        white-space:normal;
      }

      .gc-combos-data-columns{
        display:none;
      }

      .gc-combos-data-list{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }

      .gc-combos-data-row{
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:0;
        align-content:start;
        border-right:1px solid var(--combos-line-soft);
      }

      .gc-combos-data-row:nth-child(2n){
        border-right:0;
      }

      .gc-combos-data-row__track{
        grid-column:1/-1;
        grid-template-columns:120px minmax(0,1fr);
        padding:10px!important;
        border-bottom:1px solid var(--combos-line-soft);
      }

      .gc-combos-data-row__media{
        width:120px;
        height:68px;
      }

      .gc-combos-data-row > div{
        border-bottom:1px solid rgba(150,255,47,.08);
      }

      .gc-combos-data-row__cars,
      .gc-combos-data-row__reference{
        grid-column:span 2;
      }

      .gc-combos-data-row__date,
      .gc-combos-data-row__open{
        align-self:center;
      }

      .gc-combos-data-row__number::before,
      .gc-combos-data-row__cars::before,
      .gc-combos-data-row__reference::before,
      .gc-combos-data-row__date::before{
        display:block;
        margin-bottom:4px;
        color:var(--combos-muted);
        font-size:8px;
        letter-spacing:.08em;
        text-transform:uppercase;
      }

      .gc-combos-data-row__cars::before{content:"Coches";}
      .gc-combos-data-row__laps::before{content:"Vueltas";}
      .gc-combos-data-row__drivers::before{content:"Pilotos";}
      .gc-combos-data-row__clean::before{content:"Limpias";}
      .gc-combos-data-row__reference::before{content:"Referencia";}
      .gc-combos-data-row__date::before{content:"Actividad";}
    }

