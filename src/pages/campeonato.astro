---
import MarketingLayout from '../layouts/MarketingLayout.astro';

import PublicHeroFrame from '../components/public/PublicHeroFrame.astro';
import '../styles/public/gc-rating-badges.css';
const acsmChampionshipUrl = 'http://145.239.131.153:8840/championship/ad89ce26-0206-40f2-adec-451cf221d4e6';
const acsmSignupUrl = `${acsmChampionshipUrl}/sign-up/steam`;
---

<MarketingLayout
  title="Campeonato actual | GrassCutters Racing"
  description="Campeonato ACSM actual de GrassCutters Racing: clasificación oficial, carreras puntuables y datos de pilotos."
  ogImage="/og/campeonato-og-v1531.png"
  bodyClass="gc-page-acsr"
  canonicalPath="/campeonato"
>
  <section class="gc-public-shell gc-public-section gc-community-championship" data-acsr-championship>
    <div class="gc-acsr-atmosphere" aria-hidden="true">
      <video
        class="gc-acsr-atmosphere-video"
        src="/videos/campeonato.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    </div>

    <div class="gc-public-section-head gc-acsr-head-row">
      <div>
        <PublicHeroFrame
            id="acsrChampionshipTitle"
            kicker="Campeonato actual"
            title={['Clasificación', 'Liga GrassCutters.']}
            lead="Clasificación de Liga GrassCutters, rondas puntuables y estado del campeonato actual."
            leadId="acsrChampionshipLead"
          />
        <div class="gc-acsr-hero-actions" aria-label="Accesos principales ACSM">
          <a class="gc-public-btn gc-public-btn-primary gc-acsr-hero-btn" href={acsmSignupUrl} id="acsrSignupHero" target="_blank" rel="noopener noreferrer">Inscripción ACSM</a>
          <a class="gc-public-btn gc-public-btn-secondary gc-acsr-hero-btn" href={acsmChampionshipUrl} id="acsrOfficialHero" target="_blank" rel="noopener noreferrer">Panel ACSM</a>
        </div>
      
</div>
    </div>

    <nav class="gc-acsr-quiet-nav gc-acsr-quiet-nav--main" aria-label="Accesos secundarios de campeonato">
      <a class="gc-data-link" href="/historico">Histórico ACSM</a>
      <button class="gc-data-link gc-data-link--button" type="button" id="acsrRefresh">Actualizar datos</button>
    </nav>


    <div class="gc-acsr-grid gc-acsr-grid--hub">
      <article class="gc-acsr-main-card gc-public-card">
        <span class="gc-public-kicker">Estado</span>
        <h3 id="acsrChampionshipName" class="gc-public-card-title">Campeonato actual</h3>
        <p id="acsrChampionshipMeta" class="gc-public-card-text">Conectando con Assetto Corsa Server Manager.</p>

        <div class="gc-acsr-stats gc-public-stat-grid">
          <div class="gc-public-stat"><span>Rondas</span><strong id="acsrStatEvents">--</strong></div>
          <div class="gc-public-stat"><span>Completadas</span><strong id="acsrStatCompleted">--</strong></div>
          <div class="gc-public-stat"><span>Inscritos</span><strong id="acsrStatEntrants">--</strong></div>
          <div class="gc-public-stat"><span>Clasificados</span><strong id="acsrStatStandings">--</strong></div>
        </div>

        <div class="gc-acsr-inline-links">
          <a href={acsmSignupUrl} id="acsrSignupLink" target="_blank" rel="noopener noreferrer">Inscribirse con Steam</a>
          <a href={acsmChampionshipUrl} id="acsrOfficialLink" target="_blank" rel="noopener noreferrer">Ver ACSM oficial</a>
        </div>
      </article>

      <article class="gc-acsr-next-card gc-public-card">
        <span class="gc-public-kicker">Próximo domingo</span>
        <h3 id="acsrNextTitle" class="gc-public-card-title">Por confirmar</h3>
        <p id="acsrNextMeta" class="gc-public-card-text">Cuando ACSM tenga la siguiente ronda, aparecerá aquí.</p>
        <div class="gc-acsr-track" id="acsrNextTrack">Circuito pendiente</div>
        <figure class="gc-acsr-track-media" id="acsrTrackFigure" hidden>
          <img id="acsrTrackImage" src="" alt="" loading="lazy" />
        </figure>
      </article>

      <article class="gc-acsr-last-card gc-public-card" id="acsrLastCard">
        <span class="gc-public-kicker">Última carrera</span>
        <h3 id="acsrLastTitle" class="gc-public-card-title">Sin resultados todavía</h3>
        <p id="acsrLastMeta" class="gc-public-card-text">Cuando termine una carrera, tendrás aquí el resumen.</p>
        <div class="gc-acsr-podium" id="acsrLastPodium"></div>
        <a class="gc-public-btn gc-public-btn-secondary gc-acsr-last-link" href="#" id="acsrLastLink">Ver resultados</a>
      </article>
    </div>

    <div class="gc-acsr-standings-shell" id="acsrStandings">
      <div class="gc-public-section-head">
        <span class="gc-public-kicker">Clasificación</span>
        <h2 class="gc-public-section-title">Clasificación Liga GrassCutters.</h2>
        <p class="gc-public-section-lead" id="acsrStandingsLead">Puntos y posición salen de Liga GrassCutters. Las carreras fuera de ACSM no suman en esta tabla ni modifican SR/GSR por defecto.</p>
      </div>

      <div class="gc-acsr-standings-table-wrap">
        <table class="gc-acsr-standings-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Piloto</th>
              <th>Puntos</th>
              <th>Victorias</th>
              <th>Podios</th>
              <th>Incidentes</th>
              <th>Último resultado ACSM</th>
              <th>SR global</th>
              <th>GSR global</th>
            </tr>
          </thead>
          <tbody id="acsrStandingsBody">
            <tr><td colspan="9">Cargando clasificación...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="gc-acsr-events-shell">
      <div class="gc-public-section-head">
        <span class="gc-public-kicker">Rondas</span>
        <h2 class="gc-public-section-title">Calendario del campeonato.</h2>
        <p class="gc-public-section-lead">Carreras pertenecientes al campeonato ACSM actual. Solo estas carreras suman puntos en esta clasificación.</p>
      </div>
      <div class="gc-acsr-events" id="acsrEventsList">
        <article class="gc-acsr-event"><strong>Cargando rondas...</strong></article>
      </div>
    </div>



    <div class="gc-acsr-drivers-shell">
      <div class="gc-public-section-head">
        <span class="gc-public-kicker">Inscritos</span>
        <h2 class="gc-public-section-title">Pilotos registrados.</h2>
        <p class="gc-public-section-lead">Pilotos inscritos en el campeonato actual según ACSM.</p>
      </div>
      <div class="gc-acsr-drivers" id="acsrDriversList">
        <article class="gc-acsr-driver"><strong>Cargando pilotos...</strong></article>
      </div>
    </div>
  </section>

  <style is:global>
    .gc-community-championship{
      position:relative;
      z-index:5;
      isolation:isolate;
      overflow:hidden;
      display:grid;
      gap:clamp(14px,2vw,24px);
      padding-top:clamp(96px,10vw,148px);
    }

    .gc-community-championship > *{
      position:relative;
      z-index:2;
    }

    .gc-acsr-atmosphere{
      position:absolute;
      inset:0 0 auto 0;
      height:clamp(300px,42vw,520px);
      z-index:0;
      overflow:hidden;
      pointer-events:none;
    }

    .gc-acsr-atmosphere::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:1;
      background:
        radial-gradient(circle at 72% 16%, rgba(126,255,39,.18), transparent 24rem),
        linear-gradient(180deg, rgba(7,10,8,.18) 0%, rgba(7,10,8,.58) 56%, rgba(7,10,8,.96) 100%),
        linear-gradient(90deg, rgba(7,10,8,.86) 0%, rgba(7,10,8,.34) 42%, rgba(7,10,8,.82) 100%);
    }

    .gc-acsr-atmosphere::after{
      content:"";
      position:absolute;
      inset:auto 0 0 0;
      height:clamp(120px,16vw,220px);
      z-index:2;
      background:linear-gradient(180deg, rgba(7,10,8,0) 0%, rgba(7,10,8,.72) 56%, var(--gc-mk-bg,#070a08) 100%);
    }

    .gc-acsr-atmosphere-video{
      width:100%;
      height:100%;
      object-fit:cover;
      opacity:.48;
      filter:saturate(1.04) contrast(1.04) brightness(.8);
    }

    .gc-acsr-head-row{
      display:flex;
      justify-content:space-between;
      align-items:end;
      gap:18px;
      margin-bottom:clamp(2px,.6vw,8px);
    }

    .gc-acsr-hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      align-items:center;
      margin-top:clamp(18px,2vw,26px);
    }

    .gc-acsr-hero-btn{
      min-width:clamp(178px,13vw,226px);
      min-height:48px;
      justify-content:center;
      letter-spacing:.08em;
      white-space:nowrap;
    }


    .gc-acsr-head-actions{
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .gc-acsr-grid{
      display:grid;
      grid-template-columns:minmax(0,1.05fr) minmax(280px,.82fr);
      gap:16px;
      align-items:stretch;
    }

    .gc-acsr-grid--hub{
      grid-template-columns:minmax(0,1.05fr) minmax(280px,.78fr) minmax(280px,.82fr);
    }

    .gc-acsr-main-card.gc-public-card,
    .gc-acsr-next-card.gc-public-card,
    .gc-acsr-last-card.gc-public-card{
      position:relative;
      overflow:hidden;
      padding:clamp(18px,2.2vw,28px);
      border:1px solid var(--line,var(--gc-mk-line,rgba(126,255,39,.22)));
      border-radius:var(--radius,18px);
      background:var(--panel,rgba(255,255,255,.025));
      box-shadow:0 20px 60px rgba(0,0,0,.32);
    }

    .gc-acsr-stats{
      grid-template-columns:repeat(2,minmax(0,1fr));
      margin:18px 0;
    }

    .gc-acsr-track{
      margin-top:16px;
      padding:12px;
      border:1px solid var(--line,var(--gc-mk-line,rgba(126,255,39,.22)));
      border-radius:var(--radius-sm,10px);
      color:var(--gc-mk-accent,#80ff1f);
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.05em;
      background:rgba(255,255,255,.035);
    }

    .gc-acsr-track-media,
    .gc-acsr-event-media{
      margin:16px 0 0;
      border:1px solid var(--line,var(--gc-mk-line,rgba(126,255,39,.22)));
      border-radius:var(--radius,18px);
      overflow:hidden;
      background:rgba(0,0,0,.18);
    }

    .gc-acsr-track-media[hidden],
    .gc-acsr-event-media[hidden]{ display:none!important; }

    .gc-acsr-track-media img{
      display:block;
      width:100%;
      height:clamp(170px,18vw,260px);
      object-fit:cover;
    }

    .gc-acsr-event-media{
      margin:0 0 4px;
      border-radius:13px;
    }

    .gc-acsr-event-media img{
      display:block;
      width:100%;
      height:clamp(105px,8.5vw,138px);
      object-fit:cover;
      filter:saturate(1.04) contrast(1.04) brightness(.9);
    }

    .gc-acsr-podium{
      display:grid;
      gap:8px;
      margin:18px 0;
    }

    .gc-acsr-podium-row{
      display:grid;
      grid-template-columns:auto minmax(0,1fr) auto;
      gap:10px;
      align-items:center;
      padding:10px 12px;
      border:1px solid rgba(126,255,39,.16);
      border-radius:12px;
      background:rgba(126,255,39,.045);
    }

    .gc-acsr-podium-row span{
      color:var(--gc-mk-accent,#80ff1f);
      font-weight:900;
      font-family:var(--font-mono,monospace);
    }

    .gc-acsr-podium-row small{
      color:var(--gc-mk-muted,#8d968c);
      text-align:right;
      font-family:var(--font-mono,monospace);
    }

    .gc-acsr-last-link{
      align-self:flex-start;
      padding:8px 14px;
      min-height:auto;
      font-size:.82rem;
      letter-spacing:.06em;
    }

    .gc-acsr-podium-row__rank{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:34px;
      min-height:34px;
      border-radius:999px;
      border:1px solid rgba(126,255,39,.16);
      background:rgba(255,255,255,.04);
      font-size:1rem;
    }

    .gc-acsr-podium-row__rank--gold{
      color:#ffd166;
      border-color:rgba(255,209,102,.32);
      background:rgba(255,209,102,.08);
    }

    .gc-acsr-podium-row__rank--silver{
      color:#d8dee9;
      border-color:rgba(216,222,233,.28);
      background:rgba(216,222,233,.08);
    }

    .gc-acsr-podium-row__rank--bronze{
      color:#d08b5b;
      border-color:rgba(208,139,91,.28);
      background:rgba(208,139,91,.08);
    }

    .gc-acsr-last-link[hidden]{ display:none!important; }

    .gc-acsr-events-shell,
    .gc-acsr-standings-shell,
    .gc-acsr-drivers-shell{
      display:grid;
      gap:16px;
    }

    .gc-acsr-events{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:14px;
      align-items:stretch;
    }

    .gc-acsr-event{
      position:relative;
      display:grid;
      grid-template-rows:auto auto auto 1fr auto;
      gap:9px;
      overflow:hidden;
      padding:12px;
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      border-radius:16px;
      background:rgba(255,255,255,.025);
      color:inherit;
      text-decoration:none;
      box-shadow:none;
      transition:transform .18s ease, border-color .18s ease, background .18s ease;
      min-height:100%;
    }

    a.gc-acsr-event:hover{
      transform:translateY(-2px);
      border-color:rgba(126,255,39,.48);
      background:rgba(126,255,39,.055);
    }

    .gc-acsr-event span,
    .gc-acsr-driver span{
      color:var(--gc-mk-accent,#80ff1f);
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.08em;
      font-family:var(--font-mono,monospace);
      font-size:.78rem;
    }

    .gc-acsr-event strong{
      display:block;
      margin-top:3px;
      font-size:clamp(.96rem,1.05vw,1.12rem);
      line-height:1.05;
    }

    .gc-acsr-event p{
      margin:0;
      color:var(--gc-mk-muted,#9ca59a);
      font-size:.88rem;
      line-height:1.35;
    }

    .gc-acsr-event__meta{
      display:flex;
      flex-wrap:wrap;
      gap:6px;
      margin-top:2px;
    }

    .gc-acsr-chip{
      display:inline-flex;
      align-items:center;
      width:max-content;
      max-width:100%;
      padding:4px 7px;
      border:1px solid rgba(126,255,39,.18);
      border-radius:999px;
      color:var(--gc-mk-muted,#9ca59a);
      font-size:.68rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .gc-acsr-standings-table-wrap{
      overflow:auto;
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      border-radius:18px;
      background:rgba(255,255,255,.018);
    }

    .gc-acsr-standings-table{
      width:100%;
      border-collapse:collapse;
      min-width:860px;
    }

    .gc-acsr-standings-table th,
    .gc-acsr-standings-table td{
      padding:14px 16px;
      border-bottom:1px solid rgba(126,255,39,.12);
      text-align:left;
      vertical-align:middle;
    }

    .gc-acsr-standings-table th{
      color:var(--gc-mk-muted,#9ca59a);
      font-family:var(--font-mono,monospace);
      font-size:.78rem;
      text-transform:uppercase;
      letter-spacing:.08em;
      background:rgba(126,255,39,.055);
    }

    .gc-acsr-standings-table tr:last-child td{ border-bottom:0; }

    .gc-acsr-standings-table td strong{
      font-weight:900;
    }

    .gc-acsr-points{
      color:var(--gc-mk-accent,#80ff1f);
      font-weight:950;
      font-family:var(--font-mono,monospace);
    }

    /* GC_SAFETY_RATING_UI_V1 */
    .gc-acsr-sr{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:52px;
      padding:5px 9px;
      border:1px solid rgba(126,255,39,.28);
      border-radius:999px;
      color:var(--gc-mk-accent,#80ff1f);
      background:rgba(126,255,39,.07);
      font-family:var(--font-mono,monospace);
      font-size:.78rem;
      font-weight:950;
      letter-spacing:.04em;
      white-space:nowrap;
    }

    .gc-acsr-sr small{
      margin-left:4px;
      color:var(--gc-mk-muted,#9ca59a);
      font-size:.72em;
      font-weight:800;
    }

    .gc-acsr-drivers{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:14px;
    }

    .gc-acsr-driver{
      display:grid;
      gap:8px;
      padding:16px;
      border:1px solid var(--gc-mk-line,rgba(126,255,39,.22));
      border-radius:16px;
      background:rgba(255,255,255,.025);
    }

    .gc-acsr-driver strong{
      font-size:1.02rem;
    }

    .gc-acsr-driver small{
      color:var(--gc-mk-muted,#9ca59a);
    }


    .gc-acsr-stracker-shell{
      border-top:1px solid rgba(126,255,39,.14);
      padding-top:clamp(18px,2.4vw,30px);
    }

    .gc-acsr-stracker-summary{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin:0 0 18px;
    }

    .gc-acsr-stracker-summary span{
      display:inline-flex;
      align-items:center;
      min-height:30px;
      padding:0 12px;
      border:1px solid rgba(126,255,39,.16);
      border-radius:999px;
      background:rgba(0,0,0,.22);
      color:var(--gc-mk-muted,#9ca59a);
      font-family:var(--font-mono,monospace);
      font-size:.75rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.06em;
    }

    .gc-acsr-stracker-summary strong{
      color:var(--gc-mk-accent,#80ff1f);
    }

    .gc-acsr-subsection-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      margin:20px 0 12px;
      padding-top:8px;
    }

    .gc-acsr-subsection-head strong{
      color:var(--gc-mk-text,#f5fff0);
      font-size:1.05rem;
    }

    .gc-acsr-subsection-head small{
      color:var(--gc-mk-muted,#9ca59a);
      text-align:right;
    }

    .gc-acsr-event--stracker{
      border-color:rgba(85,129,231,.28);
    }

    .gc-acsr-event--detected{
      background:linear-gradient(180deg, rgba(85,129,231,.075), rgba(255,255,255,.025));
    }

    .gc-acsr-stracker-actions{
      margin-top:10px;
    }

    .gc-acsr-stracker-actions .gc-public-btn{
      width:100%;
      justify-content:center;
    }



    .gc-acsr-quiet-nav,
    .gc-acsr-inline-links,
    .gc-acsr-data-links__list{
      display:flex;
      flex-wrap:wrap;
      gap:12px 18px;
      align-items:center;
    }

    .gc-acsr-quiet-nav{
      justify-content:flex-end;
      padding-bottom:8px;
    }

    .gc-acsr-quiet-nav--main{
      justify-content:flex-start;
      width:100%;
      max-width:100%;
      padding:0 0 clamp(6px,1vw,12px);
      margin-top:clamp(-4px,-.25vw,0px);
    }

    .gc-acsr-quiet-nav--main .gc-data-link{
      white-space:nowrap;
    }

    .gc-data-link--button{
      display:inline-flex;
      align-items:center;
    }

    .gc-data-link,
    .gc-acsr-inline-links a{
      appearance:none;
      border:0;
      background:transparent;
      padding:0;
      color:var(--gc-mk-accent,#80ff1f);
      font:inherit;
      font-family:var(--font-mono,monospace);
      font-size:.82rem;
      font-weight:900;
      letter-spacing:.06em;
      text-transform:uppercase;
      text-decoration:none;
      cursor:pointer;
      border-bottom:1px solid rgba(126,255,39,.32);
    }

    .gc-data-link:hover,
    .gc-acsr-inline-links a:hover{
      color:var(--gc-mk-text,#f2f6ef);
      border-bottom-color:var(--gc-mk-text,#f2f6ef);
    }

    .gc-acsr-data-links{
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:18px;
      align-items:end;
      padding-top:clamp(22px,3vw,34px);
      border-top:1px solid rgba(126,255,39,.14);
    }

    @media (max-width:1180px){
      .gc-acsr-grid--hub{
        grid-template-columns:1fr 1fr;
      }

      .gc-acsr-main-card{
        grid-column:1/-1;
      }

      .gc-acsr-events{
        grid-template-columns:repeat(3,minmax(0,1fr));
      }

      .gc-acsr-drivers{
        grid-template-columns:repeat(3,minmax(0,1fr));
      }
    }

    @media (max-width:860px){
      .gc-acsr-head-row{
        align-items:start;
        flex-direction:column;
      }

      .gc-acsr-quiet-nav{
        justify-content:flex-start;
      }

      .gc-acsr-hero-actions{
        width:100%;
      }

      .gc-acsr-hero-btn{
        flex:1 1 210px;
      }

      .gc-acsr-data-links{
        grid-template-columns:1fr;
      }

      .gc-acsr-grid,
      .gc-acsr-grid--hub{
        grid-template-columns:1fr;
      }

      .gc-acsr-events{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }

      .gc-acsr-drivers{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }

      .gc-acsr-track-media img{
        height:210px;
      }

      .gc-acsr-event-media img{
        height:128px;
      }
    }

    @media (max-width:560px){
      .gc-acsr-events,
      .gc-acsr-drivers{
        grid-template-columns:1fr;
      }

      .gc-acsr-stats{
        grid-template-columns:1fr 1fr;
      }

      .gc-acsr-event-media img{
        height:150px;
      }

      .gc-acsr-standings-table{
        min-width:720px;
      }
    }
  </style>

  <script>
    (() => {
      const root = document.querySelector('[data-acsr-championship]');
      if (!root) return;
      const ACSM_OFFICIAL_URL = 'http://145.239.131.153:8840/championship/ad89ce26-0206-40f2-adec-451cf221d4e6';
      const ACSM_SIGNUP_URL = `${ACSM_OFFICIAL_URL}/sign-up/steam`;

      /* GC_PHASE2C_CHAMPIONSHIP_TYPES_V1 */
      function $<T extends HTMLElement = HTMLElement>(id: string): T {
        return document.getElementById(id) as T;
      }
      const els = {
        lead: $('acsrChampionshipLead'),
        name: $('acsrChampionshipName'),
        meta: $('acsrChampionshipMeta'),
        events: $('acsrStatEvents'),
        completed: $('acsrStatCompleted'),
        entrants: $('acsrStatEntrants'),
        standings: $('acsrStatStandings'),
        official: $<HTMLAnchorElement>('acsrOfficialLink'),
        officialHero: $<HTMLAnchorElement>('acsrOfficialHero'),
        signup: $<HTMLAnchorElement>('acsrSignupLink'),
        signupHero: $<HTMLAnchorElement>('acsrSignupHero'),
        refresh: $<HTMLButtonElement>('acsrRefresh'),
        nextTitle: $('acsrNextTitle'),
        nextMeta: $('acsrNextMeta'),
        nextTrack: $('acsrNextTrack'),
        trackFigure: $<HTMLElement>('acsrTrackFigure'),
        trackImage: $<HTMLImageElement>('acsrTrackImage'),
        lastTitle: $('acsrLastTitle'),
        lastMeta: $('acsrLastMeta'),
        lastPodium: $('acsrLastPodium'),
        lastLink: $<HTMLAnchorElement>('acsrLastLink'),
        list: $('acsrEventsList'),
        drivers: $('acsrDriversList'),
        standingsBody: $('acsrStandingsBody'),
        standingsLead: $('acsrStandingsLead')
      };

      [els.official, els.officialHero, els.signup, els.signupHero].forEach((link: HTMLAnchorElement) => {
        if (!link) return;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      });
      if (els.official) els.official.href = ACSM_OFFICIAL_URL;
      if (els.officialHero) els.officialHero.href = ACSM_OFFICIAL_URL;
      if (els.signup) els.signup.href = ACSM_SIGNUP_URL;
      if (els.signupHero) els.signupHero.href = ACSM_SIGNUP_URL;

      const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' } as Record<string, string>)[char] ?? char);
      const ratingClassKey = (value: unknown) => String(value || 'unknown')
        .trim()
        .toLowerCase()
        .replace('+', 'plus')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'unknown';

      const ratingBadge = (type: unknown, value: unknown, score: unknown = null, options: { compact?: boolean } = {}) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const safeValue = String(value || '--');
        const classKey = ratingClassKey(safeValue);
        const compactClass = options.compact ? ' gc-rating-badge--compact' : '';
        const scoreMarkup = score !== null && score !== undefined && score !== ''
          ? `<small>${escapeHtml(score)}</small>`
          : '';

        return `
          <span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${classKey}${compactClass}">
            <span class="gc-rating-badge__type">${safeType.toUpperCase()}</span>
            <strong>${escapeHtml(safeValue)}</strong>
            ${scoreMarkup}
          </span>
        `;
      };

      const srInfo = (driver: any) => {
        const sr = driver?.safetyRating || {};
        const score = Number(sr.score ?? driver?.srScore);
        const label = sr.class || driver?.srClass || '';
        if (!driver?.hasPersistentRating || !Number.isFinite(score)) return null;
        return { score: Math.round(score * 10) / 10, label };
      };
      const srBadge = (driver: any) => {
        const sr = srInfo(driver);
        if (!sr) return ratingBadge('sr', '--', null, { compact: true });
        return ratingBadge('sr', sr.label || '--', sr.score);
      };
      const gsrInfo = (driver: any) => {
        const score = Number(driver?.gsrRating ?? driver?.gsr);
        const label = driver?.gsrClass || '';
        if (!driver?.hasPersistentRating || !Number.isFinite(score)) return null;
        return { score: Math.round(score), label };
      };
      const gsrBadge = (driver: any) => {
        const gsr = gsrInfo(driver);
        if (!gsr) return ratingBadge('gsr', '--', null, { compact: true });
        return ratingBadge('gsr', gsr.label || '--', gsr.score);
      };
      const fmtDate = (value: unknown) => {
        if (!value) return 'Fecha por confirmar';
        const date = value instanceof Date ? value : new Date(String(value));
        if (Number.isNaN(date.getTime())) return 'Fecha por confirmar';
        return date.toLocaleString('es-ES', { weekday:'short', day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' });
      };

      const statusLabel: Record<string, string> = {
        pending: 'Pendiente',
        scheduled: 'Programada',
        in_progress: 'En curso',
        completed: 'Completada',
        cancelled: 'Cancelada'
      };

      const sessionLabel = {
        PRACTICE: 'Práctica',
        QUALIFY: 'Qualy',
        QUALIFICATION: 'Qualy',
        RACE: 'Carrera'
      };

      const slugify = (value: unknown) => String(value || '')
        .toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '');

      const normalizeTrackSlug = (value: unknown) => {
        const raw = slugify(value);
        return raw
          .replace(/^(fn|ks|rt|mx|acu|nrms)_/, '')
          .replace(/_?(circuit|circuito|track|spain|italy|italia)$/g, '')
          .replace(/^_+|_+$/g, '') || raw;
      };

      // GC_TRACK_ASSETS_SINGLE_SOURCE_V19
      // Fuente estable para fotos/mapas de calendario. No depende de GCTrackImages ni de manifests.
      const TRACK_ASSET_REGISTRY: Record<string, { keys: string[]; photo: string; map?: string }> = {
        jerez: { keys: ['jerez', 'fn_jerez', 'circuito_de_jerez', 'circuito_de_jerez_spain', 'circuito_de_jerez_angel_nieto', 'jerez_angel_nieto', 'angel_nieto_jerez'], photo: '/images/tracks/jerez.png', map: '/images/tracks/jerez_mapa.png' },
        mugello: { keys: ['mugello', 'ks_mugello', 'autodromo_internazionale_del_mugello'], photo: '/images/tracks/mugello.webp', map: '/images/tracks/mugello_mapa.png' },
        fuji: { keys: ['fuji', 'rt_fuji_speedway', 'rt_fuji_speedway_layout_gp', 'fuji_speedway', 'fuji_speedway_gp', 'fuji_speedway_layout_gp', 'fuji_international_speedway', 'fujispeedway'], photo: '/images/tracks/fuji.jpg', map: '/images/tracks/fuji_map.png' },
        bathurst: { keys: ['bathurst', 'mount_panorama'], photo: '/images/tracks/bathurst.png' },
        brands_hatch: { keys: ['brands_hatch', 'ks_brands_hatch'], photo: '/images/tracks/brands_hatch.webp' },
        estoril: { keys: ['estoril'], photo: '/images/tracks/estoril.webp' },
        hockenheim: { keys: ['hockenheim', 'ks_hockenheim', 've_hockenheim_gp', 'hockenheimring'], photo: '/images/tracks/hockenheim.png' },
        imola: { keys: ['imola'], photo: '/images/tracks/imola.webp' },
        nordschleife: { keys: ['nordschleife', 'nurburgring_nordschleife'], photo: '/images/tracks/nordschleife.webp' },
        nurburgring: { keys: ['nurburgring', 'ks_nurburgring'], photo: '/images/tracks/nurburgring.jpg' },
        okayama: { keys: ['okayama', 'okayama_international', 'okayama_circuit'], photo: '/images/tracks/okayama.jpg' },
        phillip_island: { keys: ['phillip_island', 'phillipisland', 'phillip_island_2013'], photo: '/images/tracks/phillip_island.png' },
        road_atlanta: { keys: ['road_atlanta'], photo: '/images/tracks/road_atlanta.webp' },
        salzburgring: { keys: ['salzburgring', 'salzburg_ring', 'salzburg'], photo: '/images/tracks/salzburgring.png' },
        sebring: { keys: ['sebring', 'mx_sb_day_standing'], photo: '/images/tracks/sebring.png' },
        spa: { keys: ['spa', 'ks_spa', 'rt_spa', 'spa_francorchamps'], photo: '/images/tracks/spa.png' },
        suzuka: { keys: ['suzuka', 'ks_suzuka'], photo: '/images/tracks/suzuka.png' },
        vallelunga: { keys: ['vallelunga', 'ks_vallelunga'], photo: '/images/tracks/vallelunga.webp' },
        zolder: { keys: ['zolder', 'rt_zolder', 'circuit_zolder'], photo: '/images/tracks/zolder.webp' }
      };

      const trackAssetNames = (event: any): string[] => {
        const raw = [event?.trackRaw, event?.track, event?.name].filter(Boolean);
        const names = [...new Set(raw.flatMap((value) => [slugify(value), normalizeTrackSlug(value)]).filter(Boolean))];
        Object.values(TRACK_ASSET_REGISTRY).forEach((track) => {
          if ((track.keys || []).some((key) => names.some((name) => name === key || name.includes(key) || key.includes(name)))) {
            names.push(...track.keys);
          }
        });
        return [...new Set(names.filter(Boolean))];
      };

      const registeredTrackAsset = (event: any): { keys: string[]; photo?: string; map?: string } | null => {
        const names = trackAssetNames(event);
        return Object.values(TRACK_ASSET_REGISTRY).find((track) => (track.keys || []).some((key) => names.some((name) => name === key || name.includes(key) || key.includes(name)))) || null;
      };

      const localTrackMapCandidates = (event: any): string[] => {
        const names = trackAssetNames(event);
        const registered = registeredTrackAsset(event);
        const exact: string[] = registered?.map ? [registered.map] : [];
        const roots = ['/images/tracks', '/imagenes/tracks'];
        const exts = ['png', 'webp', 'jpg', 'jpeg', 'svg'];
        const out: string[] = [];
        names.forEach((name) => {
          ['_mapa', '_map'].forEach((suffix) => {
            roots.forEach((root) => {
              exts.forEach((ext) => out.push(`${root}/${name}${suffix}.${ext}`));
            });
          });
        });
        return [...new Set([...exact, ...out])];
      };

      const localTrackPhotoCandidates = (event: any): string[] => {
        const names = trackAssetNames(event);
        const registered = registeredTrackAsset(event);
        const exact: string[] = registered?.photo ? [registered.photo] : [];
        const roots = ['/images/tracks', '/imagenes/tracks'];
        const exts = ['webp', 'jpg', 'jpeg', 'png', 'avif'];
        const out: string[] = [];
        names.forEach((name) => {
          ['', '_photo', '_foto', '_hero'].forEach((suffix) => {
            roots.forEach((root) => {
              exts.forEach((ext) => out.push(`${root}/${name}${suffix}.${ext}`));
            });
          });
        });
        return [...new Set([...exact, ...out].filter((url) => !/_mapa\.|_map\.|_outline\./i.test(url)))];
      };

      const setImageWithFallback = (img: HTMLImageElement, figure: HTMLElement, candidates: string[]) => {
        const cleanCandidates = (Array.isArray(candidates) ? candidates : []).filter(Boolean);
        if (!img || !figure || !cleanCandidates.length) {
          if (figure) figure.hidden = true;
          return;
        }

        figure.hidden = false;
        img.style.display = '';
        img.dataset.fallbackIndex = '0';
        img.dataset.fallbacks = cleanCandidates.slice(1).join('|');
        img.onerror = function (this: HTMLImageElement) {
          const list = (this.dataset.fallbacks || '').split('|').filter(Boolean);
          const index = Number(this.dataset.fallbackIndex || 0);
          if (list[index]) {
            this.dataset.fallbackIndex = String(index + 1);
            this.src = list[index];
            return;
          }
          this.closest('figure')?.setAttribute('hidden', '');
          this.style.display = 'none';
        };
        img.src = cleanCandidates[0];
      };

      const eventImageHtml = (event: any): string => {
        const candidates = event?.trackPhotoCandidates?.length ? event.trackPhotoCandidates : localTrackPhotoCandidates(event);
        const primary = candidates[0] || '';
        const fallbacks = candidates.slice(1).join('|');
        if (!primary) return '';

        return `
          <figure class="gc-acsr-event-media gc-acsr-event-media--photo">
            <img
              src="${escapeHtml(primary)}"
              alt="${escapeHtml(event.track || event.name || '')}"
              loading="lazy"
              data-fallbacks="${escapeHtml(fallbacks)}"
              data-fallback-index="0"
              onerror="const list=(this.dataset.fallbacks||'').split('|').filter(Boolean);const i=Number(this.dataset.fallbackIndex||0);if(list[i]){this.dataset.fallbackIndex=String(i+1);this.src=list[i];}else{this.closest('figure')?.setAttribute('hidden','');this.style.display='none';}"
            />
          </figure>
        `;
      };

      const renderTrackImage = (event: any) => {
        const candidates = event?.trackMapCandidates?.length ? event.trackMapCandidates : localTrackMapCandidates(event);
        if (els.trackImage) els.trackImage.alt = event?.track || event?.name || '';
        setImageWithFallback(els.trackImage, els.trackFigure, candidates);
      };

      function renderDrivers(rows: any[]) {
        const drivers = Array.isArray(rows) ? rows : [];

        if (!drivers.length) {
          els.drivers.innerHTML = '<article class="gc-acsr-driver"><strong>Sin pilotos inscritos</strong><small>Cuando haya pilotos registrados, aparecerán aquí.</small></article>';
          return;
        }

        els.drivers.innerHTML = drivers.slice(0, 48).map((driver: any) => `
          <article class="gc-acsr-driver">
            <span>${escapeHtml(driver.className || 'General')}</span>
            <strong>${escapeHtml(driver.name || 'Piloto')}</strong>
            <small>${escapeHtml(driver.model || driver.team || 'Inscrito')}</small>
          </article>
        `).join('');
      }

      function renderStandings(rows: any[]) {
        const standings = Array.isArray(rows) ? rows : [];
        const ratedCount = standings.filter((driver) => driver?.hasPersistentRating).length;
        els.standingsLead.textContent = standings.length
          ? `${standings.length} pilotos en la clasificación Liga GrassCutters. Puntos, victorias, podios y último resultado salen solo de ACSM.${ratedCount ? ' SR/GSR se muestra como referencia global y no altera la tabla.' : ''}`
          : 'La clasificación Liga GrassCutters se actualizará cuando haya resultados oficiales de carrera.';

        els.standingsBody.innerHTML = standings.length ? standings.slice(0, 80).map((driver: any) => `
          <tr>
            <td><strong>${escapeHtml(driver.position)}</strong></td>
            <td>
              <strong>${escapeHtml(driver.name || 'Piloto')}</strong>
              <br><small>${escapeHtml(driver.model || '')}</small>
            </td>
            <td><span class="gc-acsr-points">${escapeHtml(driver.points ?? 0)}</span></td>
            <td>${escapeHtml(driver.wins ?? 0)}</td>
            <td>${escapeHtml(driver.podiums ?? 0)}</td>
            <td>${escapeHtml(driver.incidentPointsTotal ?? 0)}</td>
            <td>${driver.lastResult ? `${escapeHtml(driver.lastResult.eventName)} · P${escapeHtml(driver.lastResult.position)} · ${escapeHtml(driver.lastResult.points)} pts` : 'Sin carrera ACSM completada'}</td>
            <td>${srBadge(driver)}</td>
            <td>${gsrBadge(driver)}</td>
          </tr>
        `).join('') : '<tr><td colspan="9">La clasificación Liga GrassCutters se actualizará cuando haya resultados oficiales de carrera.</td></tr>';
      }


      function lastRaceRankBadge(position: unknown) {
        const pos = Number(position || 0);
        if (pos === 1) return '<span class="gc-acsr-podium-row__rank gc-acsr-podium-row__rank--gold" title="Ganador">🏆</span>';
        if (pos === 2) return '<span class="gc-acsr-podium-row__rank gc-acsr-podium-row__rank--silver" title="Segundo">🥈</span>';
        if (pos === 3) return '<span class="gc-acsr-podium-row__rank gc-acsr-podium-row__rank--bronze" title="Tercero">🥉</span>';
        return `<span class="gc-acsr-podium-row__rank">P${escapeHtml(pos || '-')}</span>`;
      }

      function renderLastCompleted(event: any) {
        if (!event) {
          els.lastTitle.textContent = 'Sin resultados todavía';
          els.lastMeta.textContent = 'Cuando termine una carrera, tendrás aquí el resumen.';
          els.lastPodium.innerHTML = '';
          els.lastLink.hidden = true;
          return;
        }

        els.lastTitle.textContent = event.name || `Ronda ${event.index}`;
        els.lastMeta.textContent = `${fmtDate(event.completedAt || event.scheduledAt)} · ${event.track || 'Circuito por confirmar'}`;
        els.lastLink.href = event.href || `/campeonato/ronda/${encodeURIComponent(event.id)}`;
        els.lastLink.hidden = false;

        const podium = Array.isArray(event.raceResults) && event.raceResults.length
          ? event.raceResults.slice(0, 5)
          : (Array.isArray(event.podium) ? event.podium : []);
        els.lastPodium.innerHTML = podium.length ? podium.map((driver: any) => `
          <div class="gc-acsr-podium-row">
            ${lastRaceRankBadge(driver.position)}
            <strong>${escapeHtml(driver.name)}</strong>
            <small>${escapeHtml(driver.points)} pts</small>
          </div>
        `).join('') : '<p>No hay resultados disponibles.</p>';
      }

      function renderError(data: any) {
        els.lead.textContent = data?.message || 'No se pudo cargar el campeonato.';
        els.meta.textContent = 'No se pudo cargar el campeonato en este momento.';
        els.list.innerHTML = `<article class="gc-acsr-event"><strong>No se pudo cargar el campeonato</strong><p>${escapeHtml(data?.message || 'Error desconocido')}</p></article>`;
        renderStandings([]);
        renderDrivers([]);
        renderLastCompleted(null);

        if (data?.acsm?.championshipUrl) {
          els.official.href = data.acsm.championshipUrl;
          if (els.officialHero) els.officialHero.href = data.acsm.championshipUrl;
        }
        if (data?.acsm?.signUpUrl) {
          els.signup.href = data.acsm.signUpUrl;
          els.signupHero.href = data.acsm.signUpUrl;
        }
      }





      // GC_CAMPEONATO_CLIENT_SYNC_V19
      // La página no puede depender de una sola fuente: ACSM trae puntos/eventos,
      // ratings trae SR/GSR. Aquí se fusionan para que Actualizar datos se note y no
      // deje una tabla a medias cuando una capa va por detrás.
      const parseDateTimeMs = (value: unknown) => {
        if (!value) return 0;
        const date = value instanceof Date ? value : new Date(String(value));
        const time = date.getTime();
        return Number.isFinite(time) ? time : 0;
      };

      const eventSortTime = (event: any) => Math.max(
        parseDateTimeMs(event?.completedAt),
        parseDateTimeMs(event?.scheduledAt),
        parseDateTimeMs(event?.startedAt)
      );

      const driverIdentityKey = (row: any): string => {
        const guid = String(row?.guid || row?.steamGuid || row?.steamId || row?.steamID || '').trim();
        if (guid) return `steam:${guid.toLowerCase()}`;
        const playerId = String(row?.playerId || row?.strackerPlayerId || '').trim();
        if (playerId) return `player:${playerId}`;
        return `name:${slugify(row?.name || row?.displayName || row?.driverName || '')}`;
      };

      const resultIdentityKeys = (row: any): string[] => {
        const keys: string[] = [];
        const guid = String(row?.guid || row?.steamGuid || row?.steamId || row?.steamID || '').trim();
        const playerId = String(row?.playerId || row?.strackerPlayerId || '').trim();
        const name = slugify(row?.name || row?.displayName || row?.driverName || '');
        if (guid) keys.push(`steam:${guid.toLowerCase()}`);
        if (playerId) keys.push(`player:${playerId}`);
        if (name) keys.push(`name:${name}`);
        return keys;
      };

      const latestCompletedEventFrom = (championship: any) => {
        const events = Array.isArray(championship?.events) ? championship.events : [];
        const candidates = events
          .filter((event: any) => event?.status === 'completed' || (Array.isArray(event?.raceResults) && event.raceResults.length))
          .sort((a: any, b: any) => eventSortTime(b) - eventSortTime(a));
        const explicit = championship?.lastCompletedEvent;
        if (!explicit) return candidates[0] || null;
        const candidate = candidates[0] || null;
        if (!candidate) return explicit;
        return eventSortTime(candidate) >= eventSortTime(explicit) ? candidate : explicit;
      };

      const acsmLastResultsByDriver = (championship: any) => {
        const map = new Map<string, any>();
        const events = (Array.isArray(championship?.events) ? championship.events : [])
          .filter((event: any) => event?.status === 'completed' || (Array.isArray(event?.raceResults) && event.raceResults.length))
          .sort((a: any, b: any) => eventSortTime(b) - eventSortTime(a));

        events.forEach((event: any) => {
          const rows = Array.isArray(event?.raceResults) ? event.raceResults : [];
          rows.forEach((result: any) => {
            const normalized = {
              eventId: event.id,
              eventName: event.name || `Ronda ${event.index || ''}`.trim() || 'Última carrera ACSM',
              eventAt: event.completedAt || event.scheduledAt || event.startedAt || null,
              position: result.position ?? result.pos ?? result.rank ?? '',
              points: result.points ?? result.score ?? 0
            };
            resultIdentityKeys(result).forEach((key) => {
              if (key && !map.has(key)) map.set(key, normalized);
            });
          });
        });
        return map;
      };

      const mergeChampionshipSources = (ratingsData: any, acsmData: any) => {
        const ratingsChamp = ratingsData?.championship || null;
        const acsmChamp = acsmData?.championship || null;
        if (!ratingsChamp && acsmChamp) return acsmData;
        if (!ratingsChamp) return ratingsData || acsmData;
        if (!acsmChamp) return ratingsData;

        const acsmEvents = Array.isArray(acsmChamp.events) ? acsmChamp.events : [];
        const ratingEvents = Array.isArray(ratingsChamp.events) ? ratingsChamp.events : [];
        const events = acsmEvents.length ? acsmEvents : ratingEvents;
        const lastCompletedEvent = latestCompletedEventFrom({
          ...ratingsChamp,
          events,
          lastCompletedEvent: latestCompletedEventFrom(acsmChamp) || ratingsChamp.lastCompletedEvent
        });

        const ratingRows = Array.isArray(ratingsChamp.standings) ? ratingsChamp.standings : [];
        const acsmRows = Array.isArray(acsmChamp.standings) ? acsmChamp.standings : [];
        const ratingByKey = new Map(ratingRows.map((row: any) => [driverIdentityKey(row), row]));
        const acsmLastByDriver = acsmLastResultsByDriver({ ...acsmChamp, events });

        const baseRows = acsmRows.length ? acsmRows : ratingRows;
        const standings = baseRows.map((row: any, index: number) => {
          const key = driverIdentityKey(row);
          const rated: any = ratingByKey.get(key) || {};
          const acsmLast = acsmLastByDriver.get(key) || row.lastResult || null;
          return {
            ...row,
            classificationSource: 'acsm',
            ratingDisplayScope: 'global-reference',
            driverKey: rated.driverKey ?? row.driverKey ?? null,
            position: row.position ?? rated.position ?? index + 1,
            name: row.name || rated.name || 'Piloto',
            model: row.model || rated.model || '',
            points: row.points ?? rated.points ?? 0,
            wins: row.wins ?? rated.wins ?? 0,
            podiums: row.podiums ?? rated.podiums ?? 0,
            incidentPointsTotal: rated.incidentPointsTotal ?? row.incidentPointsTotal ?? row.incidents ?? 0,
            hasPersistentRating: Boolean(rated.hasPersistentRating),
            srScore: rated.srScore ?? rated.safetyRating?.score ?? null,
            srClass: rated.srClass ?? rated.safetyRating?.class ?? null,
            gsrRating: rated.gsrRating ?? rated.gsr ?? null,
            gsrClass: rated.gsrClass ?? null,
            safetyRating: rated.safetyRating || (rated.srScore !== null && rated.srScore !== undefined ? { score: rated.srScore, class: rated.srClass } : null),
            lastResult: acsmLast || rated.lastResult || null
          };
        });

        const championship = {
          ...ratingsChamp,
          ...acsmChamp,
          events,
          standings,
          registeredDrivers: Array.isArray(acsmChamp.registeredDrivers) && acsmChamp.registeredDrivers.length ? acsmChamp.registeredDrivers : ratingsChamp.registeredDrivers,
          lastCompletedEvent,
          nextEvent: acsmChamp.nextEvent || ratingsChamp.nextEvent,
          stats: {
            ...(ratingsChamp.stats || {}),
            ...(acsmChamp.stats || {}),
            standings: standings.length
          },
          updatedAt: acsmChamp.updatedAt || ratingsChamp.updatedAt
        };

        return {
          ...ratingsData,
          ok: true,
          source: 'gc-campeonato-client-merge-v19',
          championship,
          acsm: ratingsData?.acsm || acsmData?.acsm || null,
          syncDiagnostics: {
            ratingsOk: Boolean(ratingsData?.ok),
            acsmOk: Boolean(acsmData?.ok),
            ratingsGeneratedAt: ratingsData?.generatedAt || null,
            acsmGeneratedAt: acsmData?.generatedAt || null,
            autoProcess: ratingsData?.autoProcess || null
          }
        };
      };


      function render(data: any) {
        if (!data?.ok || !data?.championship) {
          renderError(data);
          return;
        }

        const championship = data.championship;
        const next = championship.nextEvent;
        const last = championship.lastCompletedEvent;
        const events: any[] = Array.isArray(championship.events) ? championship.events : [];
        const standings: any[] = Array.isArray(championship.standings) ? championship.standings : [];
        const drivers: any[] = Array.isArray(championship.registeredDrivers) ? championship.registeredDrivers : [];
        const stats = championship.stats || {};

        els.lead.textContent = `Calendario actualizado. Progreso del campeonato: ${championship.progressPercent || 0}%.`;
        els.name.textContent = championship.name || 'Campeonato actual';
        els.meta.textContent = `ID ${championship.id} · ${championship.acsrEnabled ? 'ACSR activo' : 'ACSR no marcado'} · actualizado ${fmtDate(championship.updatedAt)}`;
        els.events.textContent = String(stats.events ?? events.length ?? '--');
        els.completed.textContent = String(stats.completedEvents ?? '--');
        els.entrants.textContent = String(stats.entrants ?? drivers.length ?? '--');
        els.standings.textContent = String(stats.standings ?? standings.length ?? '--');

        if (data.acsm?.championshipUrl) {
          els.official.href = data.acsm.championshipUrl;
          if (els.officialHero) els.officialHero.href = data.acsm.championshipUrl;
        }
        if (data.acsm?.signUpUrl) {
          els.signup.href = data.acsm.signUpUrl;
          els.signupHero.href = data.acsm.signUpUrl;
        }

        if (next) {
          els.nextTitle.textContent = next.name || `Ronda ${next.index}`;
          els.nextMeta.textContent = `${fmtDate(next.scheduledAt)} · ${statusLabel[String(next.status)] || next.status || 'Pendiente'}`;
          els.nextTrack.textContent = [next.track, next.carSummary].filter(Boolean).join(' · ') || 'Circuito pendiente';
          renderTrackImage(next);
        } else {
          els.nextTitle.textContent = 'Sin próxima ronda';
          els.nextMeta.textContent = 'Todas las rondas parecen completadas o no hay eventos programados.';
          els.nextTrack.textContent = 'Campeonato sin próxima fecha';
          renderTrackImage(null);
        }

        renderLastCompleted(last);
        renderStandings(standings);
        renderDrivers(drivers);

        els.list.innerHTML = events.slice(0, 24).map((event: any) => {
          const winner = event.winner ? `${event.winner.name} · ${event.winner.points} pts` : 'Resultados pendientes';
          return `
            <a class="gc-acsr-event" href="${escapeHtml(event.href || `/campeonato/ronda/${encodeURIComponent(event.id)}`)}" data-status="${escapeHtml(event.status || 'pending')}">
              ${eventImageHtml(event)}
              <div>
                <span>${escapeHtml(statusLabel[String(event.status)] || event.status || 'Pendiente')}</span>
                <strong>${escapeHtml(event.name || `Ronda ${event.index}`)}</strong>
              </div>
              <p>${escapeHtml(fmtDate(event.scheduledAt))}</p>
              <p>${escapeHtml([event.track, event.carSummary].filter(Boolean).join(' · ') || 'Combo por confirmar')}</p>
              <div class="gc-acsr-event__meta">
                <span class="gc-acsr-chip">${escapeHtml(event.raceResults?.length ? `${event.raceResults.length} pilotos` : 'Sin resultados')}</span>
                <span class="gc-acsr-chip">${escapeHtml(winner)}</span>
              </div>
            </a>
          `;
        }).join('') || '<article class="gc-acsr-event"><strong>Sin rondas</strong><p>Todavía no hay rondas visibles.</p></article>';

        // No aplicar GCTrackImages sobre las cards: ya llevan fallbacks locales estables.

        console.info('[GC campeonato ACSR-only standings v79]', {
          ok: true,
          events: events.length,
          standings: standings.length,
          registeredDrivers: drivers.length
        });
      }

      async function fetchJson(url: string): Promise<any> {
        const response = await fetch(url, { cache: 'no-store' });
        const data = await response.json().catch(() => null);
        if (!response.ok) throw new Error(data?.message || `HTTP ${response.status}`);
        return data;
      }

      const settledReasonMessage = (result: PromiseSettledResult<any>): string =>
        result.status === 'rejected'
          ? String(result.reason?.message || result.reason || '')
          : '';

      async function load(refresh = false) {
        const startedAt = Date.now();
        els.lead.textContent = refresh ? 'Actualizando campeonato...' : 'Cargando campeonato...';
        if (els.refresh) {
          els.refresh.disabled = true;
          els.refresh.textContent = refresh ? 'Actualizando...' : 'Actualizar datos';
        }

        const params = new URLSearchParams({ source: 'weekly', series: 'weekly', _: String(Date.now()) });
        if (refresh) {
          params.set('refresh', '1');
          params.set('process', '1');
        }
        const query = `?${params.toString()}`;

        const [ratingsResult, acsmResult] = await Promise.allSettled([
          fetchJson(`/api/gc/ratings/championship${query}`),
          fetchJson(`/api/community/acsr-championship${query}`)
        ]);

        const ratingsData = ratingsResult.status === 'fulfilled' ? ratingsResult.value : null;
        const acsmData = acsmResult.status === 'fulfilled' ? acsmResult.value : null;

        if (ratingsResult.status === 'rejected') console.warn('[GC campeonato] Falló ratings.', ratingsResult.reason);
        if (acsmResult.status === 'rejected') console.warn('[GC campeonato] Falló ACSM base.', acsmResult.reason);

        const merged = mergeChampionshipSources(ratingsData, acsmData);
        if (merged?.ok && merged?.championship) {
          render(merged);
          const autoProcess = merged?.syncDiagnostics?.autoProcess || ratingsData?.autoProcess || null;
          const processed = Array.isArray(autoProcess?.processedEvents) ? autoProcess.processedEvents.length : Number(autoProcess?.processedEvents || 0);
          const statusBits = [
            refresh ? 'Actualización solicitada' : 'Datos cargados',
            `ACSM ${acsmData?.ok ? 'OK' : 'sin respuesta'}`,
            `SR/GSR ${ratingsData?.ok ? 'OK' : 'sin respuesta'}`,
            autoProcess ? (autoProcess.ok === false ? `proceso ratings: ${autoProcess.message || 'sin cambios'}` : `ratings procesados: ${Number.isFinite(processed) ? processed : 0}`) : null,
            `${Math.max(1, Math.round((Date.now() - startedAt) / 100) / 10)}s`
          ].filter(Boolean);
          els.lead.textContent = statusBits.join(' · ');
        } else {
          renderError({ message: ratingsData?.message || acsmData?.message || settledReasonMessage(ratingsResult) || settledReasonMessage(acsmResult) || 'No se pudo cargar el campeonato.' });
        }

        if (els.refresh) {
          els.refresh.disabled = false;
          els.refresh.textContent = 'Actualizar datos';
        }
      }

      els.refresh?.addEventListener('click', () => load(true));
      load();
    })();
  </script>
</MarketingLayout>


