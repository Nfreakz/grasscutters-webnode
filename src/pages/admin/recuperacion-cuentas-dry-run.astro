---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { runtimeConfig } from '@/server/env';
import {
  buildAccountRecoveryDryRun,
  type RecoveryDryRunReport
} from '@/server/database/account-recovery-dry-run';

let report: RecoveryDryRunReport | null = null;
let errorCode: string | null = null;

if (runtimeConfig.appEnvironment !== 'local') {
  Astro.response.status = 404;
  errorCode = 'NOT_AVAILABLE';
} else {
  try {
    report = await buildAccountRecoveryDryRun();
  } catch (error) {
    errorCode = error instanceof Error ? error.message : 'DRY_RUN_FAILED';
  }
}

const labels = {
  keep: 'Conservar',
  link: 'Vincular',
  review: 'Revisar',
  archive: 'Archivar'
};
---

<BaseLayout title="GrassCutters · Dry-run de cuentas">
  <div class="page gc-container dryrun-page">
    <header class="page-intro">
      <span>Administración local · simulación</span>
      <h1>Dry-run de recuperación de cuentas</h1>
      <p>
        Propuesta individual de conservación, vínculo, revisión o archivo.
        No ejecuta escrituras.
      </p>
    </header>

    {errorCode ? (
      <article class="panel error-panel">
        <strong>No se ha podido generar el dry-run</strong>
        <p>{errorCode}</p>
      </article>
    ) : report ? (
      <>
        <section class="summary-grid">
          <article class="panel metric keep">
            <span>Conservar</span>
            <strong>{report.summary.keep}</strong>
          </article>
          <article class="panel metric link">
            <span>Vincular</span>
            <strong>{report.summary.link}</strong>
          </article>
          <article class="panel metric review">
            <span>Revisar</span>
            <strong>{report.summary.review}</strong>
          </article>
          <article class="panel metric archive">
            <span>Archivar</span>
            <strong>{report.summary.archive}</strong>
          </article>
          <article class="panel metric">
            <span>Perfiles sin cuenta</span>
            <strong>{report.summary.profilesWithoutUser}</strong>
          </article>
          <article class="panel metric">
            <span>Credenciales conocidas</span>
            <strong>{report.summary.knownCredentialSchemes}</strong>
          </article>
        </section>

        <section class="panel">
          <div class="panel-head">
            <div>
              <span>19 cuentas</span>
              <h2>Decisión propuesta por cuenta</h2>
            </div>
            <b>SOLO LECTURA</b>
          </div>

          <div class="table-wrap">
            <table class="data-table dryrun-table">
              <thead>
                <tr>
                  <th>Cuenta</th>
                  <th>Decisión</th>
                  <th>Perfil</th>
                  <th>Email</th>
                  <th>Credencial</th>
                  <th>Steam</th>
                  <th>Player ID</th>
                  <th>Prueba</th>
                  <th>Motivo</th>
                </tr>
              </thead>
              <tbody>
                {report.users.map((user) => (
                  <tr>
                    <td class="reference">{user.userRef}</td>
                    <td>
                      <span class:list={['decision', `decision-${user.decision}`]}>
                        {labels[user.decision]}
                      </span>
                    </td>
                    <td>{user.linkedProfileRef ?? '—'}</td>
                    <td>{user.hasEmail ? 'Sí' : 'No'}</td>
                    <td>{user.credentialScheme}</td>
                    <td>{user.hasSteamIdentity ? 'Sí' : 'No'}</td>
                    <td>{user.hasPlayerId ? 'Sí' : 'No'}</td>
                    <td>{user.likelyTestAccount ? 'Sí' : 'No'}</td>
                    <td class="reason">{user.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="two-columns">
          <article class="panel">
            <div class="panel-head">
              <div>
                <span>Contraseñas</span>
                <h2>Esquemas detectados</h2>
              </div>
            </div>

            <div class="detail-list">
              {Object.entries(report.credentialSchemes)
                .filter(([, count]) => count > 0)
                .map(([scheme, count]) => (
                  <p><span>{scheme}</span><strong>{count}</strong></p>
                ))}
            </div>
          </article>

          <article class="panel">
            <div class="panel-head">
              <div>
                <span>Identidad</span>
                <h2>Perfiles sin usuario</h2>
              </div>
            </div>

            <div class="unlinked-list">
              {report.unlinkedProfiles.length ? report.unlinkedProfiles.map((profile) => (
                <article>
                  <strong>{profile.profileRef}</strong>
                  <span>
                    Steam: {profile.hasSteamIdentity ? 'sí' : 'no'} ·
                    Player ID: {profile.hasPlayerId ? 'sí' : 'no'}
                  </span>
                  <p>{profile.recommendation}</p>
                </article>
              )) : (
                <p class="empty">Todos los perfiles tienen usuario.</p>
              )}
            </div>
          </article>
        </section>

        <section class="panel blockers">
          <div class="panel-head">
            <div>
              <span>Bloqueos</span>
              <h2>No aplicar todavía</h2>
            </div>
            <b>SAFE TO APPLY: NO</b>
          </div>

          <ul>
            {report.blockers.map((blocker) => <li>{blocker}</li>)}
          </ul>
          <p>{report.nextStep}</p>
        </section>
      </>
    ) : null}
  </div>
</BaseLayout>

<style>
  .dryrun-page { display: grid; gap: 16px; }
  .page-intro > span,
  .panel-head span,
  .metric span {
    color: var(--gc-muted);
    font-size: 9px;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .page-intro h1 { margin: 7px 0 5px; font-size: 27px; }
  .page-intro p { margin: 0; color: var(--gc-muted); }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .metric {
    min-height: 92px;
    padding: 15px;
    display: grid;
    align-content: center;
    gap: 7px;
  }

  .metric strong {
    color: var(--gc-text);
    font-family: var(--gc-font-data);
    font-size: 25px;
  }

  .metric.keep strong { color: var(--gc-lime); }
  .metric.link strong { color: var(--gc-teal); }
  .metric.review strong { color: var(--gc-amber); }
  .metric.archive strong { color: var(--gc-red); }

  .panel-head > b {
    color: var(--gc-muted);
    font-size: 9px;
  }

  .dryrun-table {
    min-width: 1180px;
  }

  .dryrun-table td {
    vertical-align: top;
  }

  .reference {
    font-family: var(--gc-font-data);
    color: var(--gc-teal);
  }

  .reason {
    min-width: 250px;
    color: var(--gc-muted);
    line-height: 1.45;
  }

  .decision {
    display: inline-flex;
    padding: 3px 7px;
    border: 1px solid var(--gc-line);
    border-radius: 4px;
    font-size: 9px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .decision-keep {
    border-color: #4b6900;
    color: var(--gc-lime);
    background: var(--gc-lime-soft);
  }

  .decision-link {
    border-color: #1b6864;
    color: var(--gc-teal);
    background: var(--gc-teal-soft);
  }

  .decision-review {
    color: var(--gc-amber);
  }

  .decision-archive {
    color: var(--gc-red);
  }

  .two-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .detail-list,
  .unlinked-list {
    padding: 13px 15px;
  }

  .detail-list p {
    min-height: 31px;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--gc-line-soft);
  }

  .detail-list p:last-child { border-bottom: 0; }

  .detail-list span,
  .unlinked-list span {
    color: var(--gc-muted);
    font-size: 10px;
  }

  .unlinked-list article {
    padding: 11px 0;
    border-bottom: 1px solid var(--gc-line-soft);
  }

  .unlinked-list article:last-child { border-bottom: 0; }

  .unlinked-list article {
    display: grid;
    gap: 4px;
  }

  .unlinked-list p {
    margin: 0;
    color: var(--gc-muted);
    font-size: 10px;
    line-height: 1.5;
  }

  .blockers .panel-head b { color: var(--gc-red); }

  .blockers ul {
    margin: 0;
    padding: 14px 32px 5px;
    color: var(--gc-amber);
    font-size: 11px;
    line-height: 1.7;
  }

  .blockers > p {
    margin: 0;
    padding: 10px 15px 15px;
    color: var(--gc-muted);
    font-size: 11px;
  }

  .error-panel { padding: 20px; color: var(--gc-red); }
  .empty { color: var(--gc-muted); }

  @media (max-width: 1100px) {
    .summary-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .summary-grid,
    .two-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
