---
import AppLayout from '../../../../layouts/AppLayout.astro';
import AdminSubnav from '../../../../components/AdminSubnav.astro';
---

<!-- GC_PHASE4H2_IDENTITY_PREVIEW_V1 -->
<!-- GC_PHASE4H2_1_IDENTITY_REVIEW_UX_V1 -->
<!-- GC_PHASE4H2_5_IDENTITY_PROFILE_LINK_REVIEW_V1 -->
<AppLayout title="Preview de identidades | GrassCutters">
  <div class="gc-page gc-admin-page-clean gc-id-preview">
    <section class="gc-hero gc-hero--compact">
      <div>
        <span class="gc-kicker">Administración · Ratings · Simulación</span>
        <h1 class="gc-title">Revisión de perfiles e identidades.</h1>
        <p class="gc-subtitle">Compara cada perfil huérfano con su piloto candidato y revisa por separado los conflictos reales.</p>
      </div>
      <button class="gc-btn" id="previewReload" type="button">Recargar MySQL</button>
    </section>

    <AdminSubnav />

    <div class="gc-id-warning">
      <strong>Esta pantalla no guarda decisiones ni ejecuta SQL.</strong>
      <span>Al recargar se pierde la selección. Una simulación válida sigue mostrando <code>safeToExecute: false</code>.</span>
    </div>

    <section class="gc-section gc-id-card">
      <div class="gc-section-head">
        <div>
          <span class="gc-kicker">Estado</span>
          <h2 id="previewStatus">Cargando…</h2>
          <p id="previewMessage">Leyendo el snapshot actual.</p>
        </div>
        <button class="gc-btn gc-btn--primary" id="previewBuild" type="button" disabled>Generar preview</button>
      </div>
    </section>

    <section class="gc-id-guide">
      <div><strong>1. Identifica al piloto</strong><span>Compara nombres, Steam, Player ID, perfiles, cuentas y equipos.</span></div>
      <div><strong>2. Decide con prudencia</strong><span>Si no puedes demostrar que es la misma persona, aplaza o mantén separado.</span></div>
      <div><strong>3. Genera la simulación</strong><span>Verás los cambios propuestos; esta pantalla nunca los ejecuta.</span></div>
    </section>

    <section class="gc-id-toolbar" aria-label="Filtros de revisión">
      <div><strong id="previewProgress">0 de 0 revisados</strong><span id="previewPending">Cargando grupos…</span></div>
      <label><span>Mostrar</span><select id="previewFilter"><option value="all">Todos los grupos</option><option value="pending">Solo pendientes</option><option value="risky">Solo alto riesgo</option><option value="decided">Solo revisados</option></select></label>
    </section>

    <section id="previewGroups" class="gc-id-groups" aria-live="polite"></section>

    <section class="gc-section gc-id-card" id="previewResult" hidden>
      <div class="gc-section-head">
        <div>
          <span class="gc-kicker">Plan simulado</span>
          <h2 id="previewVerdict">Pendiente</h2>
          <p id="previewSummary"></p>
        </div>
      </div>
      <div id="previewBlockers" class="gc-id-blockers"></div>
      <div class="gc-table-wrap">
        <table class="gc-table">
          <thead><tr><th>Tabla / fila</th><th>Operación futura</th><th>Antes</th><th>Después</th></tr></thead>
          <tbody id="previewChanges"></tbody>
        </table>
      </div>
      <details class="gc-id-json"><summary>JSON técnico</summary><pre id="previewJson"></pre></details>
    </section>
  </div>

  <style is:global>
    .gc-id-preview{display:grid;gap:18px}.gc-id-warning{display:grid;gap:5px;padding:14px 16px;border:1px solid rgba(255,174,66,.42);border-radius:14px;background:rgba(255,174,66,.07)}.gc-id-warning span{color:var(--soft)}
    .gc-id-card,.gc-id-group{padding:16px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.025)}.gc-id-groups{display:grid;gap:14px}.gc-id-group{display:grid;gap:14px}.gc-id-group[data-risk="high"]{border-color:rgba(255,87,87,.42)}.gc-id-group[data-state="decided"]{border-color:rgba(114,222,132,.42)}.gc-id-group-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.gc-id-group h3{margin:0}.gc-id-group p{margin:5px 0 0;color:var(--soft)}
    .gc-id-guide{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.gc-id-guide div{display:grid;gap:4px;padding:13px 14px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.02)}.gc-id-guide span,.gc-id-toolbar span{color:var(--soft);font-size:.82rem}.gc-id-toolbar{display:flex;align-items:end;justify-content:space-between;gap:14px;padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.02)}.gc-id-toolbar>div,.gc-id-toolbar label{display:grid;gap:4px}.gc-id-toolbar select{min-height:38px;border:1px solid var(--line);border-radius:9px;background:#07100a;color:var(--text);padding:0 10px}
    .gc-id-recommendation{display:grid;gap:4px;padding:11px 13px;border-left:4px solid #ffb348;background:rgba(255,179,72,.08);border-radius:8px}.gc-id-recommendation--danger{border-color:#ff6b6b;background:rgba(255,87,87,.08)}.gc-id-recommendation--soft{border-color:#75d886;background:rgba(117,216,134,.07)}.gc-id-recommendation span{color:var(--soft);font-size:.82rem}.gc-id-signal-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.gc-id-signal{min-width:0;padding:10px;border:1px solid var(--line);border-radius:10px}.gc-id-signal span{display:block;margin-bottom:5px;color:var(--dim);font-size:.65rem;font-weight:900;text-transform:uppercase}.gc-id-signal strong{display:block;overflow-wrap:anywhere;font-size:.82rem}.gc-id-details{border:1px solid var(--line);border-radius:11px}.gc-id-details summary{cursor:pointer;padding:11px 12px;font-weight:850}.gc-id-details[open] summary{border-bottom:1px solid var(--line)}.gc-id-records{display:grid;gap:10px;padding:11px}.gc-id-record-type{display:grid;gap:5px}.gc-id-record-type>strong{color:var(--dim);font-size:.68rem;text-transform:uppercase}.gc-id-record-row{display:flex;gap:8px;flex-wrap:wrap;padding:8px 10px;border-radius:8px;background:rgba(255,255,255,.025);font-size:.78rem}.gc-id-record-row b{color:var(--text)}.gc-id-record-row span{color:var(--soft)}
    .gc-id-compare{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:stretch}.gc-id-compare-side{display:grid;gap:9px;padding:13px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.02)}.gc-id-compare-side--candidate{border-color:rgba(117,216,134,.38);background:rgba(117,216,134,.045)}.gc-id-compare-side>span{color:var(--dim);font-size:.68rem;font-weight:900;text-transform:uppercase}.gc-id-compare-side h4{margin:0}.gc-id-compare-arrow{align-self:center;color:#75d886;font-size:1.4rem;font-weight:900}.gc-id-compare-facts{display:grid;gap:5px;font-size:.78rem}.gc-id-compare-facts span{color:var(--soft)}
    .gc-id-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.gc-id-action{position:relative;display:grid;gap:4px;padding:12px;border:1px solid var(--line);border-radius:11px;cursor:pointer}.gc-id-action:hover{background:rgba(255,255,255,.035)}.gc-id-action:has(input:checked){border-color:#75d886;background:rgba(117,216,134,.08)}.gc-id-action input{position:absolute;right:10px;top:10px}.gc-id-action strong{padding-right:24px}.gc-id-action span{color:var(--soft);font-size:.78rem}.gc-id-decision-select{position:absolute;opacity:0;pointer-events:none}
    .gc-id-chips{display:flex;gap:6px;flex-wrap:wrap}.gc-id-chip{display:inline-flex;padding:4px 8px;border:1px solid var(--line);border-radius:999px;font:700 .68rem/1.2 var(--font-mono,monospace);overflow-wrap:anywhere}.gc-id-chip--bad{border-color:rgba(255,87,87,.48);color:#ffb4b4}
    .gc-id-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.gc-id-field{display:grid;gap:6px}.gc-id-field span{color:var(--dim);font-size:.68rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.gc-id-field select,.gc-id-field input{width:100%;min-height:42px;border:1px solid var(--line);border-radius:10px;background:#07100a;color:var(--text);padding:0 10px}.gc-id-duplicates{display:grid;gap:8px;padding:12px;border:1px dashed rgba(255,174,66,.35);border-radius:12px}.gc-id-duplicates:empty{display:none}
    .gc-table-wrap{overflow:auto}.gc-table{width:100%;border-collapse:collapse;min-width:920px}.gc-table th,.gc-table td{padding:11px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}.gc-table th{color:var(--dim);font-size:.68rem;text-transform:uppercase}.gc-table pre{margin:0;max-width:330px;white-space:pre-wrap;overflow-wrap:anywhere;color:var(--soft)}.gc-id-blockers{display:grid;gap:6px;margin:12px 0}.gc-id-blocker{padding:9px 11px;border-left:3px solid #ff6b6b;background:rgba(255,87,87,.08)}.gc-id-json{margin-top:14px}.gc-id-json summary{cursor:pointer;font-weight:900}.gc-id-json pre{max-height:540px;overflow:auto;white-space:pre-wrap;background:#050805;color:#dfffd8;padding:14px;border-radius:12px}
    @media(max-width:900px){.gc-id-fields,.gc-id-guide{grid-template-columns:1fr 1fr}.gc-id-signal-grid{grid-template-columns:1fr 1fr}}@media(max-width:620px){.gc-id-fields,.gc-id-guide,.gc-id-actions,.gc-id-signal-grid,.gc-id-compare{grid-template-columns:1fr}.gc-id-compare-arrow{transform:rotate(90deg);justify-self:center}.gc-id-group-head,.gc-id-toolbar{display:grid}}
  </style>

  <script>
    (() => {
      type AnyRow = Record<string, any>;
      const get = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
      const els = {
        reload:get<HTMLButtonElement>('previewReload'),build:get<HTMLButtonElement>('previewBuild'),status:get('previewStatus'),message:get('previewMessage'),filter:get<HTMLSelectElement>('previewFilter'),progress:get('previewProgress'),pending:get('previewPending'),
        groups:get('previewGroups'),result:get('previewResult'),verdict:get('previewVerdict'),summary:get('previewSummary'),blockers:get('previewBlockers'),
        changes:get<HTMLTableSectionElement>('previewChanges'),json:get('previewJson')
      };
      let bootstrap:AnyRow|null=null;
      const esc=(value:unknown)=>String(value??'').replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]||char));
      const json=(value:unknown)=>esc(JSON.stringify(value,null,2));
      async function request(url:string,options:RequestInit={}){const response=await fetch(url,{credentials:'include',cache:'no-store',...options});const data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw new Error(data.message||`HTTP ${response.status}`);return data}
      const option=(value:unknown,label:unknown,selected=false)=>`<option value="${esc(value)}" ${selected?'selected':''}>${esc(label)}</option>`;
      // GC_PHASE4H2_5_IDENTITY_PROFILE_LINK_REVIEW_V1
      const conflictLabels:Record<string,string>={MULTIPLE_PLAYER_IDS_SAME_SOURCE:'Varios Player ID en el mismo servidor',MULTIPLE_UNRESOLVED_UNSCOPED_PLAYER_IDS:'Varios Player ID heredados sin correspondencia de servidor',MULTIPLE_STEAM_GUIDS:'Varios Steam',MULTIPLE_USER_LINKS:'Varias cuentas',MULTIPLE_PROFILES:'Varios perfiles',COUNTRY_MISMATCH:'Países distintos',TEAM_MISMATCH:'Equipos distintos',AVATAR_MISMATCH:'Avatares distintos',DUPLICATE_EVENT_STATISTICS:'Resultados duplicados en el mismo servidor y evento'};
      const values=(items:unknown[],empty='No consta')=>(items||[]).length?(items||[]).map(esc).join('<br>'):empty;
      function risk(group:AnyRow){return (group.steamGuids||[]).length>1||(group.userIds||[]).length>1||(group.statistics?.duplicateEventScopes||[]).length>0?'high':'review'}
      function recommendation(group:AnyRow){if(group.reviewKind==='profile_link')return {tone:'soft',title:'Perfil huérfano: falta vincularlo o descartarlo',text:'La coincidencia de nombre propone un candidato, pero tú confirmas si pertenece al mismo piloto.'};if((group.steamGuids||[]).length>1)return {tone:'danger',title:'Recomendación: no consolidar',text:'Hay Steam distintos. Trátalos como personas diferentes salvo prueba externa concluyente.'};if((group.statistics?.duplicateEventScopes||[]).length)return {tone:'danger',title:'Revisión manual obligatoria',text:'Hay más de un resultado atribuido al piloto en el mismo evento y servidor.'};if((group.profileIds||[]).length>1||(group.userIds||[]).length>1)return {tone:'',title:'Conflicto real dentro de la identidad',text:'Confirma qué perfil o cuenta debe conservarse antes de consolidar.'};return {tone:'soft',title:'Revisión manual',text:'Mantén aplazado si no reconoces al piloto.'}}
      function rowsHtml(group:AnyRow){const sections=[['Ratings',group.rowOptions?.ratings||[],(row:AnyRow)=>`<b>${esc(row.displayName||'Sin nombre')}</b><span>Clave: ${esc(row.driverKey||'—')}</span><span>Fila: ${esc(row.id)}</span>`],['Resultados',group.rowOptions?.results||[],(row:AnyRow)=>`<b>${esc(row.displayName||'Sin nombre')}</b><span>${esc(row.eventScopeKey)}</span><span>P${esc(row.position||'—')}</span><span>${esc(row.driverKey||'—')}</span>`],['Perfiles',group.rowOptions?.profiles||[],(row:AnyRow)=>`<b>${esc(row.displayName||'Sin nombre')}</b><span>Clave: ${esc(row.driverKey||'—')}</span><span>Cuenta: ${esc(row.linkedUserId||'sin enlazar')}</span><span>Perfil: ${esc(row.id)}</span>`],['Cuentas',group.rowOptions?.users||[],(row:AnyRow)=>`<b>${esc(row.displayName||row.pilotName||'Sin nombre')}</b><span>Piloto: ${esc(row.pilotName||'—')}</span><span>Steam: ${esc(row.steamGuid||'—')}</span><span>Player ID: ${esc(row.playerId||'—')}</span><span>Cuenta: ${esc(row.id)}</span>`]];return sections.filter(([,rows])=>(rows as AnyRow[]).length).map(([label,rows,render])=>`<div class="gc-id-record-type"><strong>${label} · ${(rows as AnyRow[]).length}</strong>${(rows as AnyRow[]).map((row:AnyRow)=>`<div class="gc-id-record-row">${(render as (row:AnyRow)=>string)(row)}</div>`).join('')}</div>`).join('')}
      function duplicateScopes(group:AnyRow){const map=new Map<string,AnyRow[]>();for(const row of group.rowOptions?.results||[]){const rows=map.get(row.eventScopeKey)||[];rows.push(row);map.set(row.eventScopeKey,rows)}return [...map.entries()].filter(([,rows])=>rows.length>1)}
      function mergedValues(group:AnyRow,targetRef:string){const target=(bootstrap?.groups||[]).find((item:AnyRow)=>item.groupRef===targetRef);const groups=target&&group.reviewKind==='profile_link'?[target,group]:target?[group,target]:[group];return {driverKeys:[...new Set(groups.flatMap((item:AnyRow)=>item.driverKeys||[]))],profiles:groups.flatMap((item:AnyRow)=>item.rowOptions?.profiles||[]),users:groups.flatMap((item:AnyRow)=>item.rowOptions?.users||[]),names:[...new Set(groups.flatMap((item:AnyRow)=>item.names||[]))]}}
      function compareSide(group:AnyRow,label:string,candidate=false){return `<div class="gc-id-compare-side ${candidate?'gc-id-compare-side--candidate':''}"><span>${esc(label)}</span><h4>${esc(group?.names?.join(' / ')||'Sin nombre')}</h4><div class="gc-id-compare-facts"><span>Steam: ${esc((group?.steamGuids||[]).join(', ')||'no consta')}</span><span>Player ID: ${esc((group?.playerScopes||group?.playerIds||[]).join(', ')||'no consta')}</span><span>Perfil: ${esc((group?.profileIds||[]).join(', ')||'no consta')}</span><span>Equipo: ${esc((group?.teams?.names||[]).join(' / ')||'no consta')}</span><span>${esc(group?.statistics?.uniqueEvents||0)} eventos · ${esc(group?.recordCounts?.total||0)} registros</span></div></div>`}
      function comparisonHtml(group:AnyRow){if(group.reviewKind!=='profile_link')return '';const candidates=(group.ambiguousWith||[]).map((ref:string)=>(bootstrap?.groups||[]).find((item:AnyRow)=>item.groupRef===ref)).filter(Boolean);return candidates.map((candidate:AnyRow)=>`<div class="gc-id-compare">${compareSide(group,'Perfil huérfano')}<div class="gc-id-compare-arrow">→</div>${compareSide(candidate,'Identidad candidata',true)}</div>`).join('')}
      function refreshFields(card:HTMLElement,group:AnyRow){const action=get<HTMLSelectElement>(`${group.groupRef}-action`).value;const target=get<HTMLSelectElement>(`${group.groupRef}-target`).value;const merge=action==='merge';card.querySelectorAll<HTMLElement>('[data-merge]').forEach((node)=>node.hidden=!merge);if(!merge)return;const values=mergedValues(group,target);const driver=get<HTMLSelectElement>(`${group.groupRef}-driver`);const previous=driver.value;driver.innerHTML=values.driverKeys.map((key:string,index:number)=>option(key,key,key===previous||!previous&&index===0)).join('')||option('','Sin clave');const profile=get<HTMLSelectElement>(`${group.groupRef}-profile`);profile.innerHTML=option('','No elegir todavía')+values.profiles.map((row:AnyRow)=>option(row.id,`${row.displayName||row.id} · ${row.driverKey}`,row.id===profile.value)).join('');const user=get<HTMLSelectElement>(`${group.groupRef}-user`);user.innerHTML=option('','No elegir todavía')+values.users.map((row:AnyRow)=>option(row.id,`${row.displayName||row.pilotName||row.id}`,row.id===user.value)).join('')}
      function updateProgress(){const cards=[...els.groups.querySelectorAll<HTMLElement>('[data-group-ref]')];const decided=cards.filter((card)=>card.dataset.state==='decided').length;els.progress.textContent=`${decided} de ${cards.length} revisados`;els.pending.textContent=decided===cards.length?'Todas las decisiones están marcadas. Ya puedes generar el preview.':`${cards.length-decided} pendientes o aplazados.`;applyFilter()}
      function applyFilter(){const mode=els.filter.value;els.groups.querySelectorAll<HTMLElement>('[data-group-ref]').forEach((card)=>{const show=mode==='all'||mode==='pending'&&card.dataset.state!=='decided'||mode==='decided'&&card.dataset.state==='decided'||mode==='risky'&&card.dataset.risk==='high';card.hidden=!show})}
      function renderGroups(){if(!bootstrap)return;const attention=(bootstrap.groups||[]).filter((group:AnyRow)=>group.requiresDecision);els.groups.innerHTML=attention.length?attention.map((group:AnyRow)=>{
        const targetOptions=(group.ambiguousWith||[]).map((ref:string,index:number)=>{const target=bootstrap?.groups.find((item:AnyRow)=>item.groupRef===ref);return option(ref,`${target?.names?.join(' / ')||ref} · ${ref}`,group.reviewKind==='profile_link'&&index===0)}).join('');
        const duplicates=duplicateScopes(group).map(([scope,rows])=>`<label class="gc-id-field" data-merge><span>Fila que se conserva · ${esc(scope)}</span><select data-keep-scope="${esc(scope)}">${option('','Elegir manualmente')}${rows.map((row:AnyRow)=>option(row.id,`${row.displayName} · P${row.position} · ${row.id}`)).join('')}</select></label>`).join('');
        const isLink=group.reviewKind==='profile_link';const rec=recommendation(group);const separateTitle=isLink?'No vincular este perfil':'Son personas distintas';const separateText=isLink?'Conserva el perfil huérfano separado de este piloto.':'Mantiene los registros separados.';const mergeTitle=isLink?'Vincular este perfil':'Es la misma persona';const mergeText=isLink?'Simula el enlace con la identidad candidata.':'Abre las opciones para consolidar.';const badge=isLink?'<span class="gc-id-chip">Perfil huérfano + candidato</span>':(group.conflicts||[]).map((item:string)=>`<span class="gc-id-chip gc-id-chip--bad">${esc(conflictLabels[item]||item)}</span>`).join('')||'<span class="gc-id-chip">Revisión de identidad</span>';const signals=isLink?'':`<div class="gc-id-signal-grid"><div class="gc-id-signal"><span>Steam</span><strong>${values(group.steamGuids||[])}</strong></div><div class="gc-id-signal"><span>Player ID por origen</span><strong>${values(group.playerScopes?.length?group.playerScopes:group.playerIds||[])}</strong></div><div class="gc-id-signal"><span>Equipo</span><strong>${values(group.teams?.names||[])}</strong></div><div class="gc-id-signal"><span>Claves internas</span><strong>${values(group.driverKeys||[])}</strong></div></div>`;return `<article class="gc-id-group" data-group-ref="${esc(group.groupRef)}" data-risk="${risk(group)}" data-state="pending"><div class="gc-id-group-head"><div><h3>${isLink?'Vincular perfil de ':''}${esc(group.names?.join(' / ')||'Identidad sin nombre')}</h3><p>${isLink?'Compara ambos lados antes de decidir':`${group.statistics?.uniqueEvents||0} eventos · ${group.recordCounts?.total||0} registros`}</p></div><div class="gc-id-chips">${badge}</div></div>${comparisonHtml(group)}<div class="gc-id-recommendation gc-id-recommendation--${rec.tone}"><strong>${rec.title}</strong><span>${rec.text}</span></div>${signals}<details class="gc-id-details"><summary>Ver los ${group.recordCounts?.total||0} registros del perfil pendiente</summary><div class="gc-id-records">${rowsHtml(group)}</div></details><div class="gc-id-actions"><label class="gc-id-action"><input type="radio" name="${esc(group.groupRef)}-choice" value="defer" checked><strong>No lo sé / aplazar</strong><span>Bloquea este caso y no propone cambios.</span></label><label class="gc-id-action"><input type="radio" name="${esc(group.groupRef)}-choice" value="keep_separate"><strong>${separateTitle}</strong><span>${separateText}</span></label><label class="gc-id-action"><input type="radio" name="${esc(group.groupRef)}-choice" value="merge"><strong>${mergeTitle}</strong><span>${mergeText}</span></label></div><select class="gc-id-decision-select" id="${esc(group.groupRef)}-action" aria-hidden="true"><option value="defer">Aplazar</option><option value="keep_separate">Mantener separado</option><option value="merge">Consolidar</option></select><div class="gc-id-fields"><label class="gc-id-field" data-merge hidden><span>${isLink?'Identidad candidata':'Adjuntar a otro grupo ambiguo'}</span><select id="${esc(group.groupRef)}-target">${option('',isLink?'Elegir candidato':'No adjuntar')}${targetOptions}</select></label><label class="gc-id-field" data-merge hidden><span>Clave que se conserva</span><select id="${esc(group.groupRef)}-driver"></select></label><label class="gc-id-field" data-merge hidden><span>Perfil que se conserva</span><select id="${esc(group.groupRef)}-profile"></select></label><label class="gc-id-field" data-merge hidden><span>Cuenta que se conserva</span><select id="${esc(group.groupRef)}-user"></select></label><label class="gc-id-field" data-merge hidden><span>Nombre público final</span><input id="${esc(group.groupRef)}-name" value="${esc(group.names?.[0]||'')}" /></label></div><div class="gc-id-duplicates">${duplicates}</div></article>`}).join(''):'<div class="gc-id-card">No hay casos que requieran decisión.</div>';
        for(const group of attention){const card=els.groups.querySelector<HTMLElement>(`[data-group-ref="${group.groupRef}"]`);if(!card)continue;const action=get<HTMLSelectElement>(`${group.groupRef}-action`);const target=get<HTMLSelectElement>(`${group.groupRef}-target`);card.querySelectorAll<HTMLInputElement>(`input[name="${group.groupRef}-choice"]`).forEach((radio)=>radio.addEventListener('change',()=>{action.value=radio.value;card.dataset.state=radio.value==='defer'?'pending':'decided';refreshFields(card,group);updateProgress()}));target.addEventListener('change',()=>refreshFields(card,group));refreshFields(card,group)}updateProgress()
      }
      function collect(){if(!bootstrap)return[];return (bootstrap.groups||[]).filter((group:AnyRow)=>group.requiresDecision).map((group:AnyRow)=>{const card=els.groups.querySelector<HTMLElement>(`[data-group-ref="${group.groupRef}"]`)!;const keeps:Record<string,string>={};card.querySelectorAll<HTMLSelectElement>('[data-keep-scope]').forEach((select)=>{if(select.value)keeps[select.dataset.keepScope||'']=select.value});return {groupRef:group.groupRef,action:get<HTMLSelectElement>(`${group.groupRef}-action`).value,targetGroupRef:get<HTMLSelectElement>(`${group.groupRef}-target`).value,canonicalDriverKey:get<HTMLSelectElement>(`${group.groupRef}-driver`).value,canonicalProfileId:get<HTMLSelectElement>(`${group.groupRef}-profile`).value,canonicalUserId:get<HTMLSelectElement>(`${group.groupRef}-user`).value,displayName:get<HTMLInputElement>(`${group.groupRef}-name`).value,keepResultIdsByScope:keeps}})}
      function renderPreview(data:AnyRow){els.result.hidden=false;els.verdict.textContent=data.readyForExecutorDesign?'Preview completo, todavía no ejecutable':'Preview bloqueado';els.summary.textContent=`${data.summary?.plans||0} planes · ${data.summary?.proposedChanges||0} cambios simulados · ${data.summary?.blockers||0} bloqueos.`;els.blockers.innerHTML=(data.blockers||[]).map((item:string)=>`<div class="gc-id-blocker">${esc(item)}</div>`).join('');const changes=(data.plans||[]).flatMap((plan:AnyRow)=>(plan.changes||[]).map((item:AnyRow)=>({...item,groupRef:plan.groupRef})));els.changes.innerHTML=changes.length?changes.map((item:AnyRow)=>`<tr><td><strong>${esc(item.table)}</strong><br><small>${esc(item.rowId)}</small></td><td>${esc(item.operation)}${item.note?`<br><small>${esc(item.note)}</small>`:''}</td><td><pre>${json(item.before)}</pre></td><td><pre>${json(item.after)}</pre></td></tr>`).join(''):'<tr><td colspan="4">No se propone ningún cambio.</td></tr>';els.json.textContent=JSON.stringify(data,null,2);els.result.scrollIntoView({behavior:'smooth',block:'start'})}
      async function load(){els.reload.disabled=true;els.build.disabled=true;els.status.textContent='Cargando…';els.message.textContent='Leyendo identidades y perfiles de MySQL.';els.result.hidden=true;try{const loaded=await request('/api/gc/ratings/identity-preview');bootstrap=loaded;renderGroups();const count=(loaded.groups||[]).filter((group:AnyRow)=>group.requiresDecision).length;els.status.textContent=`${count} casos requieren revisión`;els.message.textContent=`${loaded.reviewSummary?.profileLinks||0} vínculos de perfil · ${loaded.reviewSummary?.identityConflicts||0} conflictos reales. Snapshot ${loaded.snapshotId}.`;els.build.disabled=false}catch(error){bootstrap=null;els.groups.innerHTML='';els.status.textContent='No disponible';els.message.textContent=error instanceof Error?error.message:String(error)}finally{els.reload.disabled=false}}
      els.filter.addEventListener('change',applyFilter);els.reload.addEventListener('click',load);els.build.addEventListener('click',async()=>{if(!bootstrap)return;els.build.disabled=true;els.status.textContent='Simulando…';try{const data=await request('/api/gc/ratings/identity-preview',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({snapshotId:bootstrap.snapshotId,decisions:collect()})});renderPreview(data);els.status.textContent='Preview generado';els.message.textContent='No se ha escrito ninguna fila.'}catch(error){els.status.textContent='Error de preview';els.message.textContent=error instanceof Error?error.message:String(error)}finally{els.build.disabled=false}});void load();
    })();
  </script>
</AppLayout>
