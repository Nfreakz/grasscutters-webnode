---
import AppLayout from '../../../../layouts/AppLayout.astro';
import AdminSubnav from '../../../../components/AdminSubnav.astro';
---

<!-- GC_PHASE4H2_IDENTITY_PREVIEW_V1 -->
<AppLayout title="Preview de identidades | GrassCutters">
  <div class="gc-page gc-admin-page-clean gc-id-preview">
    <section class="gc-hero gc-hero--compact">
      <div>
        <span class="gc-kicker">Administración · Ratings · Simulación</span>
        <h1 class="gc-title">Revisión humana de identidades.</h1>
        <p class="gc-subtitle">Decide qué identidades se mantienen separadas y simula cada consolidación antes de diseñar una operación real.</p>
      </div>
      <button class="gc-btn" id="previewReload" type="button">Recargar MySQL</button>
    </section>

    <AdminSubnav />

    <div class="gc-id-warning">
      <strong>Esta pantalla no guarda decisiones ni ejecuta SQL.</strong>
      <span>Al recargar se pierde la selección. Una simulación válida sigue mostrando <code>safeToExecute: false</code>.</span>
    </div>

    <section class="gc-section gc-id-card">
      <div class="gc-section-head">
        <div>
          <span class="gc-kicker">Estado</span>
          <h2 id="previewStatus">Cargando…</h2>
          <p id="previewMessage">Leyendo el snapshot actual.</p>
        </div>
        <button class="gc-btn gc-btn--primary" id="previewBuild" type="button" disabled>Generar preview</button>
      </div>
    </section>

    <section id="previewGroups" class="gc-id-groups" aria-live="polite"></section>

    <section class="gc-section gc-id-card" id="previewResult" hidden>
      <div class="gc-section-head">
        <div>
          <span class="gc-kicker">Plan simulado</span>
          <h2 id="previewVerdict">Pendiente</h2>
          <p id="previewSummary"></p>
        </div>
      </div>
      <div id="previewBlockers" class="gc-id-blockers"></div>
      <div class="gc-table-wrap">
        <table class="gc-table">
          <thead><tr><th>Tabla / fila</th><th>Operación futura</th><th>Antes</th><th>Después</th></tr></thead>
          <tbody id="previewChanges"></tbody>
        </table>
      </div>
      <details class="gc-id-json"><summary>JSON técnico</summary><pre id="previewJson"></pre></details>
    </section>
  </div>

  <style>
    .gc-id-preview{display:grid;gap:18px}.gc-id-warning{display:grid;gap:5px;padding:14px 16px;border:1px solid rgba(255,174,66,.42);border-radius:14px;background:rgba(255,174,66,.07)}.gc-id-warning span{color:var(--soft)}
    .gc-id-card,.gc-id-group{padding:16px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.025)}.gc-id-groups{display:grid;gap:14px}.gc-id-group{display:grid;gap:14px}.gc-id-group-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.gc-id-group h3{margin:0}.gc-id-group p{margin:5px 0 0;color:var(--soft)}
    .gc-id-chips{display:flex;gap:6px;flex-wrap:wrap}.gc-id-chip{display:inline-flex;padding:4px 8px;border:1px solid var(--line);border-radius:999px;font:700 .68rem/1.2 var(--font-mono,monospace);overflow-wrap:anywhere}.gc-id-chip--bad{border-color:rgba(255,87,87,.48);color:#ffb4b4}
    .gc-id-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.gc-id-field{display:grid;gap:6px}.gc-id-field span{color:var(--dim);font-size:.68rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.gc-id-field select,.gc-id-field input{width:100%;min-height:42px;border:1px solid var(--line);border-radius:10px;background:#07100a;color:var(--text);padding:0 10px}.gc-id-duplicates{display:grid;gap:8px;padding:12px;border:1px dashed rgba(255,174,66,.35);border-radius:12px}.gc-id-duplicates:empty{display:none}
    .gc-table-wrap{overflow:auto}.gc-table{width:100%;border-collapse:collapse;min-width:920px}.gc-table th,.gc-table td{padding:11px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}.gc-table th{color:var(--dim);font-size:.68rem;text-transform:uppercase}.gc-table pre{margin:0;max-width:330px;white-space:pre-wrap;overflow-wrap:anywhere;color:var(--soft)}.gc-id-blockers{display:grid;gap:6px;margin:12px 0}.gc-id-blocker{padding:9px 11px;border-left:3px solid #ff6b6b;background:rgba(255,87,87,.08)}.gc-id-json{margin-top:14px}.gc-id-json summary{cursor:pointer;font-weight:900}.gc-id-json pre{max-height:540px;overflow:auto;white-space:pre-wrap;background:#050805;color:#dfffd8;padding:14px;border-radius:12px}
    @media(max-width:900px){.gc-id-fields{grid-template-columns:1fr 1fr}}@media(max-width:620px){.gc-id-fields{grid-template-columns:1fr}.gc-id-group-head{display:grid}}
  </style>

  <script>
    (() => {
      type AnyRow = Record<string, any>;
      const get = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
      const els = {
        reload:get<HTMLButtonElement>('previewReload'),build:get<HTMLButtonElement>('previewBuild'),status:get('previewStatus'),message:get('previewMessage'),
        groups:get('previewGroups'),result:get('previewResult'),verdict:get('previewVerdict'),summary:get('previewSummary'),blockers:get('previewBlockers'),
        changes:get<HTMLTableSectionElement>('previewChanges'),json:get('previewJson')
      };
      let bootstrap:AnyRow|null=null;
      const esc=(value:unknown)=>String(value??'').replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]||char));
      const json=(value:unknown)=>esc(JSON.stringify(value,null,2));
      async function request(url:string,options:RequestInit={}){const response=await fetch(url,{credentials:'include',cache:'no-store',...options});const data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw new Error(data.message||`HTTP ${response.status}`);return data}
      const option=(value:unknown,label:unknown,selected=false)=>`<option value="${esc(value)}" ${selected?'selected':''}>${esc(label)}</option>`;
      function duplicateScopes(group:AnyRow){const map=new Map<string,AnyRow[]>();for(const row of group.rowOptions?.results||[]){const rows=map.get(row.eventScopeKey)||[];rows.push(row);map.set(row.eventScopeKey,rows)}return [...map.entries()].filter(([,rows])=>rows.length>1)}
      function mergedValues(group:AnyRow,targetRef:string){const target=(bootstrap?.groups||[]).find((item:AnyRow)=>item.groupRef===targetRef);const groups=target?[group,target]:[group];return {driverKeys:[...new Set(groups.flatMap((item:AnyRow)=>item.driverKeys||[]))],profiles:groups.flatMap((item:AnyRow)=>item.rowOptions?.profiles||[]),users:groups.flatMap((item:AnyRow)=>item.rowOptions?.users||[]),names:[...new Set(groups.flatMap((item:AnyRow)=>item.names||[]))]}}
      function refreshFields(card:HTMLElement,group:AnyRow){const action=get<HTMLSelectElement>(`${group.groupRef}-action`).value;const target=get<HTMLSelectElement>(`${group.groupRef}-target`).value;const merge=action==='merge';card.querySelectorAll<HTMLElement>('[data-merge]').forEach((node)=>node.hidden=!merge);if(!merge)return;const values=mergedValues(group,target);const driver=get<HTMLSelectElement>(`${group.groupRef}-driver`);const previous=driver.value;driver.innerHTML=values.driverKeys.map((key:string,index:number)=>option(key,key,key===previous||!previous&&index===0)).join('')||option('','Sin clave');const profile=get<HTMLSelectElement>(`${group.groupRef}-profile`);profile.innerHTML=option('','No elegir todavía')+values.profiles.map((row:AnyRow)=>option(row.id,`${row.displayName||row.id} · ${row.driverKey}`,row.id===profile.value)).join('');const user=get<HTMLSelectElement>(`${group.groupRef}-user`);user.innerHTML=option('','No elegir todavía')+values.users.map((row:AnyRow)=>option(row.id,`${row.displayName||row.pilotName||row.id}`,row.id===user.value)).join('')}
      function renderGroups(){if(!bootstrap)return;const attention=(bootstrap.groups||[]).filter((group:AnyRow)=>group.requiresDecision);els.groups.innerHTML=attention.length?attention.map((group:AnyRow)=>{
        const targetOptions=(group.ambiguousWith||[]).map((ref:string)=>{const target=bootstrap?.groups.find((item:AnyRow)=>item.groupRef===ref);return option(ref,`${target?.names?.join(' / ')||ref} · ${ref}`)}).join('');
        const duplicates=duplicateScopes(group).map(([scope,rows])=>`<label class="gc-id-field" data-merge><span>Fila que se conserva · ${esc(scope)}</span><select data-keep-scope="${esc(scope)}">${option('','Elegir manualmente')}${rows.map((row:AnyRow)=>option(row.id,`${row.displayName} · P${row.position} · ${row.id}`)).join('')}</select></label>`).join('');
        return `<article class="gc-id-group" data-group-ref="${esc(group.groupRef)}"><div class="gc-id-group-head"><div><h3>${esc(group.names?.join(' / ')||group.groupRef)}</h3><p>${esc(group.groupRef)} · ${group.statistics?.uniqueEvents||0} eventos · ${group.recordCounts?.total||0} registros</p></div><div class="gc-id-chips">${(group.conflicts||[]).map((item:string)=>`<span class="gc-id-chip gc-id-chip--bad">${esc(item)}</span>`).join('')||'<span class="gc-id-chip">AMBIGÜEDAD DE NOMBRE</span>'}</div></div><div class="gc-id-chips">${(group.driverKeys||[]).map((key:string)=>`<span class="gc-id-chip">${esc(key)}</span>`).join('')}</div><div class="gc-id-fields"><label class="gc-id-field"><span>Decisión</span><select id="${esc(group.groupRef)}-action"><option value="defer">Aplazar / bloquear</option><option value="keep_separate">Mantener separado</option><option value="merge">Consolidar identidad</option></select></label><label class="gc-id-field" data-merge hidden><span>Adjuntar a grupo ambiguo</span><select id="${esc(group.groupRef)}-target">${option('','No adjuntar')}${targetOptions}</select></label><label class="gc-id-field" data-merge hidden><span>Clave canónica</span><select id="${esc(group.groupRef)}-driver"></select></label><label class="gc-id-field" data-merge hidden><span>Perfil canónico</span><select id="${esc(group.groupRef)}-profile"></select></label><label class="gc-id-field" data-merge hidden><span>Cuenta canónica</span><select id="${esc(group.groupRef)}-user"></select></label><label class="gc-id-field" data-merge hidden><span>Nombre público</span><input id="${esc(group.groupRef)}-name" value="${esc(group.names?.[0]||'')}" /></label></div><div class="gc-id-duplicates">${duplicates}</div></article>`}).join(''):'<div class="gc-id-card">No hay grupos que requieran decisión.</div>';
        for(const group of attention){const card=els.groups.querySelector<HTMLElement>(`[data-group-ref="${group.groupRef}"]`);if(!card)continue;const action=get<HTMLSelectElement>(`${group.groupRef}-action`);const target=get<HTMLSelectElement>(`${group.groupRef}-target`);action.addEventListener('change',()=>refreshFields(card,group));target.addEventListener('change',()=>refreshFields(card,group));refreshFields(card,group)}
      }
      function collect(){if(!bootstrap)return[];return (bootstrap.groups||[]).filter((group:AnyRow)=>group.requiresDecision).map((group:AnyRow)=>{const card=els.groups.querySelector<HTMLElement>(`[data-group-ref="${group.groupRef}"]`)!;const keeps:Record<string,string>={};card.querySelectorAll<HTMLSelectElement>('[data-keep-scope]').forEach((select)=>{if(select.value)keeps[select.dataset.keepScope||'']=select.value});return {groupRef:group.groupRef,action:get<HTMLSelectElement>(`${group.groupRef}-action`).value,targetGroupRef:get<HTMLSelectElement>(`${group.groupRef}-target`).value,canonicalDriverKey:get<HTMLSelectElement>(`${group.groupRef}-driver`).value,canonicalProfileId:get<HTMLSelectElement>(`${group.groupRef}-profile`).value,canonicalUserId:get<HTMLSelectElement>(`${group.groupRef}-user`).value,displayName:get<HTMLInputElement>(`${group.groupRef}-name`).value,keepResultIdsByScope:keeps}})}
      function renderPreview(data:AnyRow){els.result.hidden=false;els.verdict.textContent=data.readyForExecutorDesign?'Preview completo, todavía no ejecutable':'Preview bloqueado';els.summary.textContent=`${data.summary?.plans||0} planes · ${data.summary?.proposedChanges||0} cambios simulados · ${data.summary?.blockers||0} bloqueos.`;els.blockers.innerHTML=(data.blockers||[]).map((item:string)=>`<div class="gc-id-blocker">${esc(item)}</div>`).join('');const changes=(data.plans||[]).flatMap((plan:AnyRow)=>(plan.changes||[]).map((item:AnyRow)=>({...item,groupRef:plan.groupRef})));els.changes.innerHTML=changes.length?changes.map((item:AnyRow)=>`<tr><td><strong>${esc(item.table)}</strong><br><small>${esc(item.rowId)}</small></td><td>${esc(item.operation)}${item.note?`<br><small>${esc(item.note)}</small>`:''}</td><td><pre>${json(item.before)}</pre></td><td><pre>${json(item.after)}</pre></td></tr>`).join(''):'<tr><td colspan="4">No se propone ningún cambio.</td></tr>';els.json.textContent=JSON.stringify(data,null,2);els.result.scrollIntoView({behavior:'smooth',block:'start'})}
      async function load(){els.reload.disabled=true;els.build.disabled=true;els.status.textContent='Cargando…';els.message.textContent='Leyendo identidades y filas de MySQL.';els.result.hidden=true;try{const loaded=await request('/api/gc/ratings/identity-preview');bootstrap=loaded;renderGroups();const count=(loaded.groups||[]).filter((group:AnyRow)=>group.requiresDecision).length;els.status.textContent=`${count} grupos requieren revisión`;els.message.textContent=`Snapshot ${loaded.snapshotId}. Las decisiones solo existen en este navegador.`;els.build.disabled=false}catch(error){bootstrap=null;els.groups.innerHTML='';els.status.textContent='No disponible';els.message.textContent=error instanceof Error?error.message:String(error)}finally{els.reload.disabled=false}}
      els.reload.addEventListener('click',load);els.build.addEventListener('click',async()=>{if(!bootstrap)return;els.build.disabled=true;els.status.textContent='Simulando…';try{const data=await request('/api/gc/ratings/identity-preview',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({snapshotId:bootstrap.snapshotId,decisions:collect()})});renderPreview(data);els.status.textContent='Preview generado';els.message.textContent='No se ha escrito ninguna fila.'}catch(error){els.status.textContent='Error de preview';els.message.textContent=error instanceof Error?error.message:String(error)}finally{els.build.disabled=false}});void load();
    })();
  </script>
</AppLayout>
