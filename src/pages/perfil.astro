---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/public/gc-rating-badges.css';
---
<AppLayout title="Perfil piloto | GrassCutters">
  <div class="gc-page gc-profile-page gc-profile-page-v20">
    <section class="gc-hero gc-hero--compact gc-profile-hero-v20">
      <div class="gc-profile-driver-head-v30">
        <div class="gc-profile-avatar-ring-v30">
          <img id="profilePilotAvatar" src="/images/pilot-avatar-default.png" alt="Avatar del piloto" loading="lazy" decoding="async" />
        </div>
        <div class="gc-profile-identity-v30">
          <span class="gc-kicker">Race Control ID</span>
          <h1 class="gc-title" id="profileTitle">Panel de piloto</h1>
          <p class="gc-subtitle" id="profileText">Rendimiento, equipo, hotlaps y actividad competitiva desde stracker.</p>
          <div class="gc-hero__meta" id="profileBadges">
            <span class="gc-chip">Cuenta</span>
            <span class="gc-chip">Piloto stracker</span>
            <span class="gc-chip" id="profileTeamBadge">Equipo pendiente</span>
          </div>
        </div>
      </div>

      <aside class="gc-live-panel gc-profile-account-panel-v20">
        <div class="gc-live-panel__title">
          <span>Licencia</span>
          <strong id="accountState">...</strong>
        </div>
        <div class="gc-status-list" id="profileMeta">
          <div class="gc-status-row"><span>Estado</span><strong>Cargando</strong></div>
        </div>
      </aside>
    </section>

    <section class="gc-metrics gc-profile-metrics-v20" id="profileMetrics">
      <div class="gc-metric"><span>Mejor vuelta</span><strong id="metricBestLap">...</strong><small>personal</small></div>
      <div class="gc-metric"><span>Ranking global</span><strong id="metricRank">...</strong><small>por mejor vuelta</small></div>
      <div class="gc-metric"><span>Vueltas válidas</span><strong id="metricValid">...</strong><small>limpieza</small></div>
      <div class="gc-metric"><span>Consistencia</span><strong id="metricConsistency">...</strong><small>desviación</small></div>
    </section>

    <section class="gc-profile-main-grid-v20">
      <div class="gc-section gc-profile-summary-card-v20">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Race data</span>
            <h2>Resumen competitivo</h2>
            <p id="summaryMeta">Cargando métricas...</p>
          </div>
        </div>
        <div class="gc-slab-list gc-profile-summary-list-v20" id="summaryRows">
          <div><span>Estado</span><strong>Cargando</strong></div>
        </div>
      </div>

      <aside class="gc-section gc-profile-link-card-v1 gc-profile-link-card-v20">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Paddock</span>
            <h2>Identidad del piloto</h2>
            <p>Cuenta, avatar, equipo y vínculo stracker.</p>
          </div>
        </div>

        <div class="gc-slab gc-profile-linked-pilot-v20" id="linkedPilot">Cargando...</div>

        <div class="gc-profile-team-panel-v30" id="profileTeamPanel">
          <div class="gc-profile-team-head-v30">
            <div class="gc-profile-team-logo-v30">
              <img id="profileTeamLogo" src="/images/pilot-avatar-default.png" alt="Logo del equipo" loading="lazy" decoding="async" />
            </div>
            <div>
              <span class="gc-kicker">Equipo</span>
              <strong id="profileTeamName">Sin equipo</strong>
              <small id="profileTeamRole">Añade tu equipo o escudería.</small>
            </div>
          </div>

          <div class="gc-profile-team-form-v30">
            <label class="gc-field">
              <span>Equipo</span>
              <input class="gc-input" id="profileTeamNameInput" type="text" placeholder="Nombre del equipo" maxlength="80" autocomplete="organization" />
            </label>
            <label class="gc-field">
              <span>Logo equipo</span>
              <input class="gc-input" id="profileTeamLogoInput" type="url" placeholder="https://... o /images/logo.png" maxlength="500" />
            </label>
            <label class="gc-field">
              <span>Rol</span>
              <input class="gc-input" id="profileTeamRoleInput" type="text" placeholder="Piloto, capitán..." maxlength="48" />
            </label>
          </div>

          <div class="gc-profile-team-actions-v30">
            <button class="gc-btn gc-btn--primary" id="saveTeamProfileBtn" type="button">Guardar equipo</button>
            <button class="gc-btn" id="clearTeamProfileBtn" type="button">Quitar equipo</button>
          </div>
          <p class="gc-message" id="profileTeamMessage"></p>
        </div>

        <div class="gc-actions gc-profile-link-actions">
          <button class="gc-btn gc-btn--primary" id="openPilotLink" type="button" hidden>Vincular piloto</button>
          <button class="gc-btn" id="unlinkPilotAction" type="button" hidden>Desvincular piloto</button>
          <a class="gc-btn" href="/login">Cambiar cuenta</a>
          <a class="gc-btn" id="publicProfileAction" href="/pilotos" hidden>Perfil público</a>
          <a class="gc-btn gc-btn--primary" href="/hotlaps">Ver hotlaps</a>
        </div>

        <div class="gc-slab gc-profile-link-panel" id="pilotLinkPanel" hidden>
          <h3>Vincular cuenta con piloto</h3>
          <p>Busca tu piloto real de stracker y guarda el vínculo. Si ya está vinculado a otra cuenta, la API lo bloqueará.</p>

          <label class="gc-field gc-profile-link-search">
            <span>Buscar piloto</span>
            <input class="gc-input" id="pilotLinkSearch" type="search" placeholder="Nombre, Player ID o Steam GUID" autocomplete="off" />
          </label>

          <label class="gc-field">
            <span>Piloto stracker</span>
            <select class="gc-select" id="pilotLinkSelect">
              <option value="">Cargando pilotos...</option>
            </select>
          </label>

          <div class="gc-profile-link-preview" id="pilotLinkPreview">Selecciona un piloto para ver el resumen.</div>

          <div class="gc-actions">
            <button class="gc-btn gc-btn--primary" id="confirmPilotLink" type="button">Guardar vínculo</button>
            <button class="gc-btn" id="cancelPilotLink" type="button">Cancelar</button>
          </div>

          <p class="gc-message" id="pilotLinkMessage"></p>
        </div>
      </aside>
    </section>

    <section class="gc-profile-data-grid-v20">
      <div class="gc-section gc-profile-table-section-v20">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Combos</span>
            <h2>Mejores combos</h2>
            <p>Coche + circuito con posición de referencia.</p>
          </div>
        </div>
        <div class="gc-table-wrap gc-profile-table-wrap-v20">
          <table class="gc-table gc-table--compact">
            <thead>
              <tr><th>#</th><th>Coche</th><th>Circuito</th><th>Tiempo</th><th>Rank</th><th>Limpias</th></tr>
            </thead>
            <tbody id="bestCombos"><tr><td colspan="6">Cargando...</td></tr></tbody>
          </table>
        </div>
      </div>

      <div class="gc-section gc-profile-table-section-v20">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Actividad</span>
            <h2>Últimas vueltas</h2>
            <p>Actividad reciente real.</p>
          </div>
        </div>
        <div class="gc-table-wrap gc-profile-table-wrap-v20">
          <table class="gc-table gc-table--compact">
            <thead>
              <tr><th>Fecha</th><th>Coche</th><th>Circuito</th><th>Tiempo</th><th>Estado</th><th>Vmax</th></tr>
            </thead>
            <tbody id="recentLaps"><tr><td colspan="6">Cargando...</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="gc-profile-data-grid-v20">
      <div class="gc-section gc-profile-table-section-v20">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Garaje</span>
            <h2>Coches</h2>
            <p>Coches usados por el piloto.</p>
          </div>
        </div>
        <div class="gc-table-wrap gc-profile-table-wrap-v20">
          <table class="gc-table gc-table--compact">
            <thead>
              <tr><th>Coche</th><th>Vueltas</th><th>Limpias</th><th>Mejor</th><th>Circuitos</th><th>Vmax</th></tr>
            </thead>
            <tbody id="garageRows"><tr><td colspan="6">Cargando...</td></tr></tbody>
          </table>
        </div>
      </div>

      <div class="gc-section gc-profile-table-section-v20">
        <div class="gc-section-head">
          <div>
            <span class="gc-kicker">Pistas</span>
            <h2>Circuitos</h2>
            <p>Pistas donde ha rodado.</p>
          </div>
        </div>
        <div class="gc-table-wrap gc-profile-table-wrap-v20">
          <table class="gc-table gc-table--compact">
            <thead>
              <tr><th>Circuito</th><th>Vueltas</th><th>Limpias</th><th>Mejor</th><th>Coches</th><th>Última</th></tr>
            </thead>
            <tbody id="trackRows"><tr><td colspan="6">Cargando...</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
    <section class="gc-section gc-profile-password-card gc-profile-password-card-v20" id="passwordSection" hidden>
      <div class="gc-section-head">
        <div>
          <span class="gc-kicker">Seguridad</span>
          <h2>Cambiar contraseña</h2>
          <p>Actualiza tu acceso. Si has recibido una contraseña temporal, cámbiala aquí.</p>
        </div>
      </div>

      <div class="gc-grid-3 gc-profile-password-grid">
        <label class="gc-field">
          <span>Contraseña actual</span>
          <input class="gc-input" id="currentPasswordInput" type="password" autocomplete="current-password" />
        </label>
        <label class="gc-field">
          <span>Nueva contraseña</span>
          <input class="gc-input" id="newPasswordInput" type="password" autocomplete="new-password" minlength="8" />
        </label>
        <label class="gc-field">
          <span>Repetir nueva contraseña</span>
          <input class="gc-input" id="confirmPasswordInput" type="password" autocomplete="new-password" minlength="8" />
        </label>
      </div>

      <div class="gc-actions">
        <button class="gc-btn gc-btn--primary" id="changePasswordBtn" type="button">Guardar nueva contraseña</button>
      </div>
      <p class="gc-message" id="changePasswordMessage"></p>
    </section>

  </div>

  <style is:global>
    .gc-profile-page-v20{
      display:grid;
      gap:clamp(18px,2.3vw,28px);
      width:100%;
      max-width:1480px;
      margin-inline:auto;
      padding-inline:clamp(8px,1.2vw,18px);
      box-sizing:border-box;
    }

    .gc-profile-hero-v20{
      position:relative;
      overflow:hidden;
      margin:0;
      padding-block:clamp(26px,3.4vw,40px)!important;
      border:1px solid color-mix(in srgb,var(--accent,#9dff00) 30%,var(--line));
      border-radius:28px;
      background:
        linear-gradient(120deg,rgba(255,255,255,.07),rgba(255,255,255,.018)),
        radial-gradient(circle at 82% 12%, color-mix(in srgb,var(--accent2,#35d3ff) 10%,transparent), transparent 22rem),
        radial-gradient(circle at 8% 18%, color-mix(in srgb,var(--accent,#9dff00) 12%,transparent), transparent 20rem);
      box-shadow:0 18px 70px rgba(0,0,0,.20), inset 0 0 0 1px rgba(255,255,255,.035);
    }

    .gc-profile-hero-v20::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px),
        linear-gradient(0deg,rgba(255,255,255,.026) 1px,transparent 1px);
      background-size:42px 42px;
      opacity:.34;
      mask-image:linear-gradient(90deg,rgba(0,0,0,.48),transparent 72%);
    }

    .gc-profile-hero-v20 > *{
      position:relative;
      z-index:1;
    }

    .gc-profile-hero-v20 > div:first-child{
      padding-left:clamp(30px,4.2vw,86px);
    }

    .gc-profile-hero-v20 .gc-title{
      font-size:clamp(3.2rem,7vw,6rem);
      line-height:.86;
      letter-spacing:-.075em;
      margin:8px 0 12px;
    }

    .gc-profile-hero-v20 .gc-subtitle{
      max-width:820px;
      color:color-mix(in srgb,var(--text,#f2fff0) 74%,var(--muted));
    }

    .gc-profile-account-panel-v20{
      width:min(440px,100%);
      justify-self:end;
      margin-right:clamp(28px,4vw,78px);
      align-self:center;
      min-height:auto;
      padding:0;
      overflow:hidden;
      background:
        radial-gradient(circle at 100% 0%, color-mix(in srgb,var(--accent,#9dff00) 16%,transparent), transparent 10rem),
        rgba(0,0,0,.18);
      border-color:color-mix(in srgb,var(--accent,#9dff00) 18%,var(--line));
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.035);
    }

    .gc-profile-account-panel-v20 .gc-live-panel__title{
      padding:14px 16px;
      margin:0;
      border-bottom:1px solid rgba(255,255,255,.08);
      background:rgba(0,0,0,.14);
    }

    .gc-profile-account-panel-v20 .gc-status-list{
      padding:0;
      gap:0;
    }

    .gc-profile-account-panel-v20 .gc-status-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      padding:13px 16px;
      border-width:0 0 1px;
      border-radius:0;
      background:rgba(0,0,0,.08);
    }

    .gc-profile-account-panel-v20 .gc-status-row:last-child{
      border-bottom:0;
    }

    .gc-profile-account-panel-v20 .gc-status-row strong{
      max-width:250px;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
      text-align:right;
    }

    .gc-profile-metrics-v20{
      margin:0;
      gap:0;
      border:1px solid color-mix(in srgb,var(--accent,#9dff00) 18%,var(--line));
      border-radius:0;
      overflow:hidden;
      background:rgba(255,255,255,.018);
    }

    .gc-profile-metrics-v20 .gc-metric{
      border-width:0 1px 0 0;
      border-radius:0;
      min-height:112px;
      box-shadow:none;
      background:
        radial-gradient(circle at 100% 0%, color-mix(in srgb,var(--accent,#9dff00) 9%,transparent), transparent 8rem),
        linear-gradient(135deg,rgba(255,255,255,.052),rgba(255,255,255,.018));
    }

    .gc-profile-metrics-v20 .gc-metric:last-child{
      border-right:0;
    }

    .gc-profile-metrics-v20 .gc-metric strong{
      max-width:100%;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
      font-size:clamp(1.85rem,3.2vw,2.85rem);
      line-height:.92;
      letter-spacing:-.06em;
      color:var(--text);
      font-variant-numeric:tabular-nums;
    }

    .gc-profile-main-grid-v20,
    .gc-profile-data-grid-v20{
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(360px,.72fr);
      gap:clamp(18px,2.3vw,28px);
      align-items:start;
    }

    .gc-profile-data-grid-v20{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .gc-profile-summary-card-v20,
    .gc-profile-link-card-v20,
    .gc-profile-password-card-v20,
    .gc-profile-table-section-v20{
      min-width:0;
      margin:0;
      border-radius:28px;
      background:
        radial-gradient(circle at 100% 0%, color-mix(in srgb,var(--accent,#9dff00) 7%,transparent), transparent 16rem),
        linear-gradient(135deg,rgba(255,255,255,.045),rgba(255,255,255,.014));
      border:1px solid rgba(255,255,255,.08);
      box-shadow:0 18px 70px rgba(0,0,0,.16);
      overflow:hidden;
    }

    .gc-profile-summary-card-v20 .gc-section-head,
    .gc-profile-link-card-v20 .gc-section-head,
    .gc-profile-password-card-v20 .gc-section-head,
    .gc-profile-table-section-v20 .gc-section-head{
      padding:clamp(22px,2.4vw,32px) clamp(22px,2.6vw,34px) 16px;
      margin:0;
      border-bottom:1px solid rgba(255,255,255,.07);
    }

    .gc-profile-summary-card-v20 .gc-slab-list,
    .gc-profile-linked-pilot-v20,
    .gc-profile-link-card-v20 .gc-actions,
    .gc-profile-password-card-v20 .gc-grid-3,
    .gc-profile-password-card-v20 > .gc-actions,
    .gc-profile-password-card-v20 > .gc-message{
      margin:0;
      padding:clamp(16px,2vw,24px) clamp(22px,2.6vw,34px);
    }

    .gc-profile-summary-list-v20{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .gc-profile-summary-list-v20 div{
      min-height:86px;
      padding:14px;
      border:1px solid rgba(255,255,255,.08);
      border-radius:16px;
      background:rgba(0,0,0,.12);
    }

    .gc-profile-summary-list-v20 span{
      display:block;
      color:var(--dim);
      font-size:.68rem;
      font-weight:950;
      letter-spacing:.1em;
      text-transform:uppercase;
    }

    .gc-profile-summary-list-v20 strong{
      display:block;
      margin-top:8px;
      color:var(--text);
      font-size:1.12rem;
      line-height:1.15;
    }


    .gc-profile-summary-list-v20 .gc-profile-rating-stack{
      display:grid;
      justify-items:start;
      gap:8px;
    }

    .gc-profile-summary-list-v20 .gc-rating-badge{
      min-height:34px;
      padding:0 12px;
      gap:8px;
    }

    .gc-profile-summary-list-v20 .gc-rating-badge .gc-rating-badge__type{
      font-size:10px;
      opacity:.72;
    }

    .gc-profile-summary-list-v20 .gc-profile-rating-copy{
      display:block;
      margin:0;
      color:var(--dim);
      font-size:.78rem;
      line-height:1.35;
      text-transform:none;
      letter-spacing:.01em;
      font-weight:700;
    }

    .gc-profile-linked-pilot-v20{
      background:transparent;
      border:0;
      color:var(--soft);
    }

    .gc-profile-linked-pilot-v20 p{
      margin:.2rem 0;
    }

    .gc-profile-linked-pilot-v20 strong{
      color:var(--text);
      font-size:1.2rem;
    }

    .gc-profile-link-card-v20 .gc-actions{
      padding-top:0;
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    .gc-profile-link-card-v20 .gc-actions .gc-btn{
      border-radius:999px;
    }

    .gc-profile-link-panel{
      margin:0 clamp(22px,2.6vw,34px) clamp(22px,2.6vw,34px);
      padding:16px;
      border:1px solid rgba(255,255,255,.08);
      border-radius:18px;
      background:rgba(0,0,0,.15);
    }

    .gc-profile-link-panel[hidden]{
      display:none!important;
    }

    .gc-profile-link-panel h3{
      margin:0 0 8px;
      text-transform:uppercase;
      letter-spacing:-.035em;
      font-size:1.05rem;
    }

    .gc-profile-link-panel p{
      margin:0 0 12px;
      color:var(--soft);
    }

    .gc-profile-link-search{
      margin-bottom:10px;
    }

    .gc-profile-link-preview{
      min-height:82px;
      margin-top:12px;
      padding:12px;
      border:1px solid var(--line);
      border-radius:14px;
      background:rgba(255,255,255,.018);
      color:var(--soft);
    }

    .gc-profile-link-preview strong{
      display:block;
      color:var(--text);
      font-size:1.08rem;
    }

    .gc-profile-link-preview span{
      display:block;
      color:var(--dim);
      font-size:.82rem;
      margin-top:4px;
    }

    .gc-profile-password-card-v20 .gc-profile-password-grid{
      align-items:end;
      padding-bottom:0;
    }

    .gc-profile-table-wrap-v20{
      max-height:440px;
      margin:clamp(16px,2vw,22px) clamp(22px,2.6vw,34px) clamp(22px,2.6vw,34px);
      overflow:auto;
      border:1px solid rgba(255,255,255,.08);
      border-radius:22px;
      background:rgba(0,0,0,.12);
    }

    .gc-profile-table-wrap-v20 .gc-table{
      min-width:760px;
    }

    .gc-profile-table-wrap-v20 .gc-table thead th{
      position:sticky;
      top:0;
      z-index:2;
      background:color-mix(in srgb,var(--panel,#07110a) 92%,#000);
      color:color-mix(in srgb,var(--accent,#9dff00) 52%,var(--soft));
      backdrop-filter:blur(12px);
    }

    .gc-profile-table-wrap-v20 .gc-table tbody tr{
      transition:background .16s ease;
    }

    .gc-profile-table-wrap-v20 .gc-table tbody tr:hover td{
      background:color-mix(in srgb,var(--accent,#9dff00) 7%,transparent);
    }

    .gc-profile-table-wrap-v20 td,
    .gc-profile-table-wrap-v20 th{
      white-space:nowrap;
      font-variant-numeric:tabular-nums;
    }

    .gc-profile-table-wrap-v20 td:nth-child(2),
    .gc-profile-table-wrap-v20 td:nth-child(3){
      white-space:normal;
      min-width:160px;
    }



    /* GC_PROFILE_PADDOCK_V1_START */
    .gc-profile-page-v20{
      max-width:1440px;
      gap:18px;
    }

    .gc-profile-hero-v20{
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(340px,420px);
      gap:20px;
      padding:0!important;
      border-radius:0;
      background:
        linear-gradient(90deg,rgba(157,255,0,.08),rgba(0,0,0,.22) 42%,rgba(0,0,0,.06)),
        radial-gradient(circle at 72% 10%,rgba(53,211,255,.09),transparent 26rem),
        rgba(4,10,6,.86);
      box-shadow:inset 0 0 0 1px rgba(157,255,0,.16),0 22px 80px rgba(0,0,0,.26);
    }

    .gc-profile-driver-head-v30{
      display:grid;
      grid-template-columns:auto minmax(0,1fr);
      gap:22px;
      align-items:center;
      padding:clamp(22px,3vw,34px)!important;
      min-width:0;
    }

    .gc-profile-avatar-ring-v30{
