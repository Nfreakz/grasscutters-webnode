---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import '../styles/public/gc-rating-badges.css';

const title = 'Perfil piloto | GrassCutters Racing';
const description = 'Perfil de piloto GrassCutters Racing con identidad, equipo, ratings y datos de pista.';
---

<MarketingLayout
  title={title}
  description={description}
  bodyClass="gc-page-profile2"
  canonicalPath="/perfil"
  noindex={true}
>
  <main class="gc-profile2 gc-public-shell" data-profile2-page>
    <section class="gc-profile2-hero" aria-labelledby="profile2Name">
      <div class="gc-profile2-hero__bg" aria-hidden="true"></div>
      <div class="gc-profile2-hero__copy">
        <p class="gc-profile2-eyebrow">GrassCutters Driver Data</p>
        <h1 id="profile2Name">Cargando perfil</h1>
        <p id="profile2Lead">Leyendo datos de cuenta, piloto, ratings y equipo.</p>

        <div class="gc-profile2-statusline" id="profile2Badges" aria-label="Estado del perfil">
          <span class="gc-profile2-badge gc-profile2-badge--live">Cuenta</span>
          <span class="gc-profile2-badge">Piloto</span>
          <span class="gc-profile2-badge">Equipo</span>
        </div>


        <div class="gc-profile2-actions gc-profile2-actions--hero">
          <a class="gc-profile2-btn gc-profile2-btn--primary" id="profile2PublicLink" href="/pilotos" hidden>Perfil público <span aria-hidden="true">→</span></a>
          <a class="gc-profile2-btn gc-profile2-btn--ghost" href="/hotlaps">Ver hotlaps <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class="gc-profile2-driver-card" aria-label="Ficha rápida del piloto">
        <div class="gc-profile2-driver-card__avatar">
          <img id="profile2Avatar" class="gc-profile2-avatar" src="/images/pilot-avatar-default.png" alt="Avatar del piloto" loading="lazy" decoding="async" />
          <span aria-hidden="true"></span>
        </div>

        <div class="gc-profile2-driver-card__ratings" id="profile2RatingBadges" aria-label="Ratings del piloto">
          <span class="gc-profile2-rating-group">
            <span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-unknown gc-rating-badge--compact"><span class="gc-rating-badge__type">--</span><strong>--</strong></span>
            <span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-unknown gc-rating-badge--compact gc-rating-badge--rating-label"><strong>--</strong></span>
          </span>
          <span class="gc-profile2-rating-group">
            <span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-unknown gc-rating-badge--compact"><span class="gc-rating-badge__type">--</span><strong>--</strong></span>
            <span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-unknown gc-rating-badge--compact gc-rating-badge--rating-label"><strong>--</strong></span>
          </span>
        </div>

        <div class="gc-profile2-driver-card__content">
          <div class="gc-profile2-team-lockup">
            <img id="profile2TeamLogo" src="/images/team-default-gc.svg" alt="Logo del equipo" loading="lazy" decoding="async" />
            <div>
              <strong id="profile2TeamName">Sin equipo</strong>
              <small id="profile2TeamRole">Añade tu escudería</small>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <section class="gc-profile2-pulse" aria-label="Driver Pulse">
      <div class="gc-profile2-pulse__title">
        <span class="gc-profile2-live-dot" aria-hidden="true"></span>
        <strong>Driver Pulse</strong>
      </div>
      <dl class="gc-profile2-pulse__track">
        <div>
          <dt>Vueltas</dt>
          <dd id="profile2TotalLaps">--</dd>
        </div>
        <div>
          <dt>Mejor lap</dt>
          <dd id="profile2BestLap">--</dd>
        </div>
        <div>
          <dt>Limpieza</dt>
          <dd id="profile2CleanRate">--</dd>
        </div>
        <div>
          <dt>Vmax</dt>
          <dd id="profile2MaxSpeed">--</dd>
        </div>
        <div>
          <dt>Última vuelta</dt>
          <dd id="profile2LastLap">--</dd>
        </div>
      </dl>
    </section>

    <nav class="gc-profile2-tabs" aria-label="Secciones del perfil">
      <button class="gc-profile2-tab is-active" type="button" data-profile2-tab="summary">Resumen</button>
      <button class="gc-profile2-tab" type="button" data-profile2-tab="hotlaps">Hotlaps</button>
      <button class="gc-profile2-tab" type="button" data-profile2-tab="team">Escudería</button>
      <button class="gc-profile2-tab" type="button" data-profile2-tab="account">Cuenta</button>
    </nav>

    <section class="gc-profile2-content">
      <section class="gc-profile2-panel is-active" data-profile2-panel="summary">
        <article class="gc-profile2-board gc-profile2-board--stats gc-profile2-board--fullstats">
          <header class="gc-profile2-board__head gc-profile2-board__head--row">
            <div>
              <p class="gc-profile2-panel__eyebrow">Datos del piloto</p>
              <h2>Estadísticas completas</h2>
              <p class="gc-profile2-muted">Resumen único de rendimiento, ritmo, limpieza, actividad y uso del servidor.</p>
            </div>
            <a class="gc-profile2-link" href="/hotlaps">Ver hotlaps →</a>
          </header>
          <div class="gc-profile2-table-wrap">
            <table class="gc-profile2-table gc-profile2-stats-table">
              <thead>
                <tr>
                  <th>Área</th>
                  <th>Métrica</th>
                  <th>Valor</th>
                  <th>Detalle</th>
                </tr>
              </thead>
              <tbody id="profile2StatsBody">
                <tr><td colspan="4">Cargando estadísticas...</td></tr>
              </tbody>
            </table>
          </div>
        </article>
      </section>

      <section class="gc-profile2-panel" data-profile2-panel="hotlaps" hidden>
        <article class="gc-profile2-board gc-profile2-board--table">
          <header class="gc-profile2-board__head gc-profile2-board__head--row">
            <div>
              <p class="gc-profile2-panel__eyebrow">Hotlaps destacadas</p>
              <h2>Mejores combos del piloto</h2>
            </div>
            <a class="gc-profile2-link" href="/hotlaps">Ver Hotlaps →</a>
          </header>
          <div class="gc-profile2-filterbar" aria-label="Filtros de vueltas del piloto">
            <label>
              <span>Buscar</span>
              <input id="profile2LapSearch" type="search" placeholder="Circuito, coche o tiempo" />
            </label>
            <label>
              <span>Circuito</span>
              <select id="profile2LapTrack"><option value="">Todos</option></select>
            </label>
            <label>
              <span>Coche</span>
              <select id="profile2LapCar"><option value="">Todos</option></select>
            </label>
            <label>
              <span>Validez</span>
              <select id="profile2LapValidity">
                <option value="all">Todas</option>
                <option value="valid">Válidas</option>
                <option value="invalid">No válidas</option>
              </select>
            </label>
            <label>
              <span>Vista</span>
              <select id="profile2LapView">
                <option value="best-track">Mejor por circuito</option>
                <option value="all">Todas las vueltas</option>
              </select>
            </label>
            <label>
              <span>Orden</span>
              <select id="profile2LapSort">
                <option value="best">Mejor tiempo</option>
                <option value="recent">Fecha reciente</option>
                <option value="track">Circuito</option>
                <option value="car">Coche</option>
                <option value="speed">Top speed</option>
              </select>
            </label>
          </div>
          <div class="gc-profile2-table-meta" id="profile2HotlapsMeta">Cargando vueltas...</div>
          <div class="gc-profile2-table-wrap">
            <table class="gc-profile2-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Circuito</th>
                  <th>Coche</th>
                  <th>Tiempo</th>
                  <th>Fecha</th>
                  <th>Validez</th>
                  <th>Top speed</th>
                  <th>Pos</th>
                </tr>
              </thead>
              <tbody id="profile2HotlapsBody">
                <tr><td colspan="8">Cargando hotlaps...</td></tr>
              </tbody>
            </table>
          </div>
        </article>
      </section>

      <section class="gc-profile2-panel" data-profile2-panel="team" hidden>
        <div class="gc-profile2-dashboard gc-profile2-dashboard--team-editor">
          <article class="gc-profile2-board gc-profile2-board--editor">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Escudería</p>
              <h2>Identidad de equipo</h2>
              <p class="gc-profile2-muted">Dato base para futuras clasificaciones por equipos.</p>
            </header>

            <label class="gc-profile2-field">
              <span>Nombre del equipo</span>
              <input id="profile2TeamNameInput" type="text" maxlength="80" autocomplete="organization" placeholder="GrassCutters Racing Team" />
            </label>
            <label class="gc-profile2-field">
              <span>Logo del equipo</span>
              <input id="profile2TeamLogoInput" type="url" maxlength="500" placeholder="https://... o /images/logo.png" />
            </label>
            <label class="gc-profile2-field">
              <span>Rol</span>
              <input id="profile2TeamRoleInput" type="text" maxlength="60" placeholder="Piloto" />
            </label>

            <div class="gc-profile2-actions">
              <button class="gc-profile2-btn gc-profile2-btn--primary" id="profile2SaveTeam" type="button">Guardar equipo</button>
              <button class="gc-profile2-btn gc-profile2-btn--ghost" id="profile2ClearTeam" type="button">Quitar equipo</button>
            </div>
            <p class="gc-profile2-message" id="profile2TeamMessage" aria-live="polite"></p>
          </article>

          <article class="gc-profile2-board gc-profile2-board--preview">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Preview</p>
              <h2>Ficha de escudería</h2>
            </header>
            <div class="gc-profile2-team-plate">
              <img id="profile2TeamLogoPreview" src="/images/team-default-gc.svg" alt="Logo preview del equipo" loading="lazy" decoding="async" />
              <div>
                <strong id="profile2TeamNamePreview">Sin equipo</strong>
                <small id="profile2TeamRolePreview">Piloto</small>
              </div>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--team-members">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Gestión</p>
              <h2>Pilotos del equipo</h2>
              <p class="gc-profile2-muted">Owner/captain pueden añadir o quitar pilotos para el ranking por equipos.</p>
            </header>
            <div class="gc-profile2-data-list" id="profile2TeamMembers">
              <div><span><b>Miembros</b><small>cargando</small></span><strong>--</strong></div>
            </div>
            <div class="gc-profile2-form-grid">
              <label class="gc-profile2-field">
                <span>Añadir piloto</span>
                <input id="profile2TeamMemberName" type="text" maxlength="120" placeholder="Nombre exacto o piloto no reclamado" />
              </label>
              <label class="gc-profile2-field">
                <span>Rol</span>
                <select id="profile2TeamMemberRole">
                  <option value="driver">Piloto</option>
                  <option value="reserve">Reserva</option>
                  <option value="captain">Captain</option>
                </select>
              </label>
            </div>
            <div class="gc-profile2-actions">
              <button class="gc-profile2-btn gc-profile2-btn--primary" id="profile2AddTeamMember" type="button">Añadir piloto</button>
            </div>
            <p class="gc-profile2-message" id="profile2TeamMembersMessage" aria-live="polite"></p>
          </article>
        </div>
      </section>

      <section class="gc-profile2-panel" data-profile2-panel="account" hidden>
        <div class="gc-profile2-account-grid gc-profile2-account-grid--full">
          <article class="gc-profile2-board gc-profile2-board--account-main">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Cuenta</p>
              <h2>Cuenta GrassCutters</h2>
              <p class="gc-profile2-muted gc-profile2-muted--inline">Datos base de acceso y estado actual de la cuenta.</p>
            </header>
            <div class="gc-profile2-data-list" id="profile2AccountRows">
              <div><span><b>Estado</b><small>Cargando cuenta</small></span><strong>Cargando</strong></div>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--pilot-link">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Piloto</p>
              <h2>Vínculo sTracker</h2>
              <p class="gc-profile2-muted gc-profile2-muted--inline">Asocia esta cuenta al piloto real de sTracker.</p>
            </header>
            <div class="gc-profile2-data-list" id="profile2PilotLinkRows">
              <div><span><b>Estado</b><small>vínculo con piloto</small></span><strong>Cargando</strong></div>
            </div>
            <div class="gc-profile2-account-actions">
              <button class="gc-profile2-btn gc-profile2-btn--primary gc-profile2-btn--small" id="profile2OpenPilotLink" type="button">Vincular / cambiar</button>
              <button class="gc-profile2-btn gc-profile2-btn--ghost gc-profile2-btn--small" id="profile2UnlinkPilot" type="button">Desvincular</button>
              <a class="gc-profile2-btn gc-profile2-btn--ghost gc-profile2-btn--small" id="profile2PublicProfileAccount" href="/pilotos" hidden>Perfil público</a>
            </div>
            <div class="gc-profile2-inline-panel" id="profile2PilotLinkPanel" hidden>
              <div class="gc-profile2-form-grid">
                <label class="gc-profile2-field">
                  <span>Buscar piloto</span>
                  <input id="profile2PilotSearch" type="search" placeholder="Nombre, Player ID o Steam GUID" autocomplete="off" />
                </label>
                <label class="gc-profile2-field">
                  <span>Piloto sTracker</span>
                  <select id="profile2PilotSelect">
                    <option value="">Cargando pilotos...</option>
                  </select>
                </label>
              </div>
              <div class="gc-profile2-preview" id="profile2PilotPreview">Selecciona un piloto para ver el resumen.</div>
              <div class="gc-profile2-account-actions">
                <button class="gc-profile2-btn gc-profile2-btn--primary gc-profile2-btn--small" id="profile2ConfirmPilotLink" type="button">Guardar vínculo</button>
                <button class="gc-profile2-btn gc-profile2-btn--ghost gc-profile2-btn--small" id="profile2CancelPilotLink" type="button">Cancelar</button>
              </div>
              <p class="gc-profile2-message" id="profile2PilotMessage" aria-live="polite"></p>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--country">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Piloto</p>
              <h2>País / bandera</h2>
              <p class="gc-profile2-muted gc-profile2-muted--inline">Dato propio de GrassCutters. sTracker no lo aporta de forma fiable.</p>
            </header>
            <div class="gc-profile2-form-body">
              <label class="gc-profile2-field">
                <span>País del piloto</span>
                <select id="profile2CountryInput">
                  <option value="">Bandera blanca / sin país</option>
                  <option value="ES">🇪🇸 España</option>
                  <option value="AD">🇦🇩 Andorra</option>
                  <option value="FR">🇫🇷 Francia</option>
                  <option value="IT">🇮🇹 Italia</option>
                  <option value="PT">🇵🇹 Portugal</option>
                  <option value="DE">🇩🇪 Alemania</option>
                  <option value="GB">🇬🇧 Reino Unido</option>
                  <option value="US">🇺🇸 Estados Unidos</option>
                  <option value="AR">🇦🇷 Argentina</option>
                  <option value="MX">🇲🇽 México</option>
                  <option value="BR">🇧🇷 Brasil</option>
                </select>
              </label>
              <div class="gc-profile2-account-actions">
                <button class="gc-profile2-btn gc-profile2-btn--primary gc-profile2-btn--small" id="profile2SaveCountry" type="button">Guardar país</button>
              </div>
              <p class="gc-profile2-message" id="profile2CountryMessage" aria-live="polite"></p>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--identity">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Identidad</p>
              <h2>Perfil visible</h2>
              <p class="gc-profile2-muted gc-profile2-muted--inline">Nombre público y correo asociado a la cuenta.</p>
            </header>
            <div class="gc-profile2-form-body">
              <div class="gc-profile2-form-grid">
                <label class="gc-profile2-field">
                  <span>Nombre visible</span>
                  <input id="profile2DisplayNameInput" type="text" maxlength="80" autocomplete="nickname" placeholder="Neo" />
                </label>
                <label class="gc-profile2-field">
                  <span>Correo asociado</span>
                  <input id="profile2EmailInput" type="email" maxlength="160" autocomplete="email" placeholder="correo@dominio.com" />
                </label>
              </div>
              <label class="gc-profile2-field gc-profile2-field--compact">
                <span>Contraseña actual <small>solo necesaria si cambias el correo</small></span>
                <input id="profile2EmailPasswordInput" type="password" autocomplete="current-password" placeholder="Contraseña actual" />
              </label>
              <div class="gc-profile2-account-actions">
                <button class="gc-profile2-btn gc-profile2-btn--primary gc-profile2-btn--small" id="profile2SaveIdentity" type="button">Guardar identidad</button>
              </div>
              <p class="gc-profile2-message" id="profile2AccountMessage" aria-live="polite"></p>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--avatar">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Avatar</p>
              <h2>Imagen pública</h2>
              <p class="gc-profile2-muted gc-profile2-muted--inline">Avatar visible en rankings, piloto y ficha pública.</p>
            </header>
            <div class="gc-profile2-form-body">
              <label class="gc-profile2-field">
                <span>Subir avatar</span>
                <input id="profile2AvatarFile" type="file" accept="image/png,image/jpeg,image/webp" />
              </label>
              <div class="gc-profile2-account-actions gc-profile2-account-actions--avatar">
                <button class="gc-profile2-btn gc-profile2-btn--primary gc-profile2-btn--small" id="profile2UploadAvatar" type="button">Subir avatar</button>
                <button class="gc-profile2-btn gc-profile2-btn--ghost gc-profile2-btn--small" id="profile2ResetAvatar" type="button">Usar base GC</button>
                <img id="profile2AvatarPreview" class="gc-profile2-avatar-thumb" src="/images/pilot-avatar-default.png" alt="Avatar público actual" loading="lazy" decoding="async" />
              </div>
              <p class="gc-profile2-message" id="profile2AvatarMessage" aria-live="polite"></p>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--security">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Seguridad</p>
              <h2>Acceso y contraseña</h2>
              <p class="gc-profile2-muted gc-profile2-muted--inline">Actualiza el acceso de la cuenta desde aquí.</p>
            </header>
            <div class="gc-profile2-form-body">
              <div class="gc-profile2-form-grid gc-profile2-form-grid--three">
                <label class="gc-profile2-field">
                  <span>Contraseña actual</span>
                  <input id="profile2CurrentPasswordInput" type="password" autocomplete="current-password" />
                </label>
                <label class="gc-profile2-field">
                  <span>Nueva contraseña</span>
                  <input id="profile2NewPasswordInput" type="password" autocomplete="new-password" minlength="8" />
                </label>
                <label class="gc-profile2-field">
                  <span>Repetir contraseña</span>
                  <input id="profile2ConfirmPasswordInput" type="password" autocomplete="new-password" minlength="8" />
                </label>
              </div>
              <div class="gc-profile2-account-actions">
                <button class="gc-profile2-btn gc-profile2-btn--primary gc-profile2-btn--small" id="profile2SavePassword" type="button">Cambiar contraseña</button>
                <a class="gc-profile2-btn gc-profile2-btn--ghost gc-profile2-btn--small" href="/recuperar-password">Recuperar acceso</a>
              </div>
              <p class="gc-profile2-message" id="profile2SecurityMessage" aria-live="polite"></p>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--danger">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Zona sensible</p>
              <h2>Borrar cuenta</h2>
              <p class="gc-profile2-muted gc-profile2-muted--inline">Elimina el acceso de usuario. Las vueltas de sTracker no se eliminan.</p>
            </header>
            <div class="gc-profile2-form-body">
              <div class="gc-profile2-form-grid">
                <label class="gc-profile2-field">
                  <span>Contraseña actual</span>
                  <input id="profile2DeletePasswordInput" type="password" autocomplete="current-password" />
                </label>
                <label class="gc-profile2-field">
                  <span>Confirmación <small>escribe ELIMINAR</small></span>
                  <input id="profile2DeleteConfirmInput" type="text" placeholder="ELIMINAR" />
                </label>
              </div>
              <div class="gc-profile2-account-actions">
                <button class="gc-profile2-btn gc-profile2-btn--danger gc-profile2-btn--small" id="profile2DeleteAccount" type="button">Borrar cuenta</button>
              </div>
              <p class="gc-profile2-message" id="profile2DangerMessage" aria-live="polite"></p>
            </div>
          </article>
        </div>
      </section>
    </section>
  </main>

  <style is:global>
    html[data-gc-scope="marketing"] body.gc-page-profile2 {
      background:
        radial-gradient(circle at 18% 0%, rgba(150,255,47,.10), transparent 31rem),
        radial-gradient(circle at 88% 8%, rgba(150,255,47,.07), transparent 34rem),
        linear-gradient(180deg, #030706 0%, #020403 100%);
    }

    html[data-gc-scope="marketing"] .gc-profile2 {
      --green:#96ff2f;
      --text:#f4fff1;
      --muted:#74816e;
      --line:rgba(150,255,47,.18);
      --line-soft:rgba(150,255,47,.10);
      --panel:rgba(4,10,6,.91);
      --panel-2:rgba(7,15,9,.86);
      --mono:var(--gc-mono,"JetBrains Mono",monospace);
      position:relative;
      isolation:isolate;
      padding-top:0;
      padding-bottom:clamp(48px, 6vw, 88px);
      color:var(--text);
    }


    html[data-gc-scope="marketing"] .gc-profile2-hero {
      position:relative;
      min-height:clamp(330px, 43vw, 520px);
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(330px, 420px);
      gap:clamp(20px, 4vw, 58px);
      align-items:center;
      padding:clamp(28px, 6vw, 76px);
      overflow:hidden;
      border-bottom:1px solid rgba(150,255,47,.16);
      margin-inline:calc(50% - 50vw);
      padding-inline:calc((100vw - min(1160px, calc(100vw - 32px))) / 2);
    }

