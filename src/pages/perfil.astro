  </style>
  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const fallbackAvatar = '/images/pilot-avatar-default.png';
      const fallbackTeamLogo = '/images/team-default-gc.svg';
      let currentProfileData = null;
      let pilotCandidates = [];
      let currentTeamData = null;

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;'
      }[char]));

      const cleanName = (value, fallback = '-') => {
        if (value === undefined || value === null || value === '') return fallback;
        if (typeof value === 'object') {
          return cleanName(value.displayName ?? value.visibleName ?? value.cleanName ?? value.uiName ?? value.uiCarName ?? value.uiTrackName ?? value.name ?? value.driverName ?? value.playerName ?? value.code, fallback);
        }
        return String(value).replace(/_/g, ' ').replace(/\s+/g, ' ').trim() || fallback;
      };

      const normalizeCountryCode = (value) => {
        const raw = String(value || '').trim().toUpperCase().replace(/[^A-Z]/g,'');
        const alpha3 = { ESP:'ES', SPA:'ES', ITA:'IT', FRA:'FR', DEU:'DE', GER:'DE', GBR:'GB', UK:'GB', USA:'US', PRT:'PT', POR:'PT' };
        if (!raw) return '';
        if (raw.length === 2) return raw;
        return alpha3[raw] || '';
      };
      const flagEmoji = (code) => /^[A-Z]{2}$/.test(code) ? String.fromCodePoint(...[...code].map((c)=>127397+c.charCodeAt(0))) : '🏳️';

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source, path)) return source[path];
        return String(path).split('.').reduce((acc, part) => acc == null ? undefined : acc[part], source);
      };

      const firstValue = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source, path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return '';
      };

      const displayFrom = (source, paths, fallback = '-') => cleanName(firstValue(source, paths), fallback);
      const carName = (row) => displayFrom(row, ['carDisplayName','carVisibleName','carName','car.displayName','car.visibleName','car.cleanName','car.uiName','car.uiCarName','car.name','car.code','car'], '-');
      const trackName = (row) => displayFrom(row, ['trackDisplayName','trackVisibleName','trackName','track.displayName','track.visibleName','track.cleanName','track.uiName','track.uiTrackName','track.name','track.code','track'], '-');
      const pilotName = (pilot, fallback = 'Piloto') => displayFrom(pilot, ['displayName','visibleName','cleanName','name','driverName','playerName','strackerName'], fallback);

      const fmtMs = (ms) => {
        const n = Number(ms);
        if (!Number.isFinite(n) || n <= 0) return '--';
        const m = Math.floor(n / 60000);
        const s = Math.floor((n % 60000) / 1000);
        const x = String(Math.floor(n % 1000)).padStart(3, '0');
        return `${m}:${String(s).padStart(2, '0')}.${x}`;
      };

      const lapTime = (lap) => cleanName(firstValue(lap, ['lapTimeFormatted','lapTime','bestLapTimeFormatted','bestLap','bestTime']), '') || fmtMs(firstValue(lap, ['lapTimeMs','bestLapMs','LapTime']));
      const fmtSpeed = (value) => Number.isFinite(Number(value)) && Number(value) > 0 ? `${Math.round(Number(value))} km/h` : '--';
      const fmtNumber = (value) => Number.isFinite(Number(value)) ? new Intl.NumberFormat('es-ES').format(Number(value)) : '--';

      const fmtDate = (value) => {
        if (value === undefined || value === null || value === '') return '--';
        let ms = 0;
        if (typeof value === 'number') ms = value > 20000000000 ? value : value * 1000;
        else {
          const raw = String(value).trim();
          if (/^\d+$/.test(raw)) {
            const numeric = Number(raw);
            ms = numeric > 20000000000 ? numeric : numeric * 1000;
          } else {
            ms = new Date(raw).getTime();
            if (!Number.isFinite(ms)) ms = new Date(raw.replace(' ', 'T')).getTime();
          }
        }
        if (!Number.isFinite(ms) || ms <= 0) return '--';
        return new Date(ms).toLocaleString('es-ES', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
      };

      const cleanRate = (valid, total) => {
        const v = Number(valid || 0);
        const t = Number(total || 0);
        if (!t) return '--';
        return `${Math.round((v / t) * 1000) / 10}%`;
      };

      const ratingClassKey = (value) => String(value || 'unknown')
        .trim().toLowerCase().replace('+', 'plus').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'unknown';

      const normalizeClassValue = (value) => String(value || '--').trim().toUpperCase();

      const ratingMeta = (type, value) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const raw = normalizeClassValue(value);
        if (safeType === 'gsr') {
          if (raw === 'S' || raw === 'DIAMOND') return { key:'s', value:'S', label:'Diamond' };
          if (raw === 'A' || raw === 'RUBY') return { key:'a', value:'A', label:'Ruby' };
          if (raw === 'B' || raw === 'SAPPHIRE') return { key:'b', value:'B', label:'Sapphire' };
          if (raw === 'C' || raw === 'EMERALD') return { key:'c', value:'C', label:'Emerald' };
          if (raw === 'D' || raw === 'AMBER') return { key:'d', value:'D', label:'Amber' };
          return { key:'rookie', value:raw && raw !== '--' ? raw : '--', label:raw && raw !== '--' ? raw : 'Onyx' };
        }
        if (raw === 'A+' || raw === 'APLUS' || raw === 'LEGEND') return { key:'aplus', value:'A+', label:'Legend' };
        if (raw === 'A' || raw === 'ELITE') return { key:'a', value:'A', label:'Elite' };
        if (raw === 'B' || raw === 'PRO') return { key:'b', value:'B', label:'Pro' };
        if (raw === 'C' || raw === 'ADVANCED') return { key:'c', value:'C', label:'Advanced' };
        if (raw === 'D' || raw === 'ROOKIE') return { key:'d', value:'D', label:'Rookie' };
        if (raw === 'E' || raw === 'PITLANE') return { key:'e', value:'E', label:'Pitlane' };
        return { key:'unknown', value:'--', label:'--' };
      };

      const fmtRatingScore = (type, score) => {
        const n = Number(score);
        if (!Number.isFinite(n)) return '--';
        return String(type).toLowerCase() === 'gsr' ? String(Math.round(n)) : String(Math.round(n * 10) / 10);
      };

      const ratingScoreBadge = (type, value, score = null) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const meta = ratingMeta(safeType, value);
        const scoreText = score !== null && score !== undefined && score !== '' ? fmtRatingScore(safeType, score) : safeType.toUpperCase();
        return `<span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${meta.key} gc-rating-badge--compact" aria-label="${safeType.toUpperCase()} ${escapeHtml(scoreText)} ${escapeHtml(meta.value)}"><span class="gc-rating-badge__type">${escapeHtml(scoreText)}</span><strong>${escapeHtml(meta.value)}</strong></span>`;
      };

      const ratingClassBadge = (type, value) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const meta = ratingMeta(safeType, value);
        return `<span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${meta.key} gc-rating-badge--compact gc-rating-badge--rating-label" aria-label="Clase ${escapeHtml(meta.label)}"><strong>${escapeHtml(meta.label)}</strong></span>`;
      };

      const ratingPair = (type, value, score = null) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'GSR' : 'SR';
        return `<span class="gc-profile2-rating-pair"><span class="gc-profile2-rating-title">${safeType}</span>${ratingScoreBadge(type, value, score)}${ratingClassBadge(type, value)}</span>`;
      };

      const valueRow = (label, valueMarkup, hint = '') => `
        <div class="gc-profile2-data-row">
          <span><b>${escapeHtml(label)}</b>${hint ? `<small>${escapeHtml(hint)}</small>` : ''}</span>
          <strong>${valueMarkup}</strong>
        </div>
      `;

      const teamFromProfileData = (data) => {
        const team = data?.team || data?.user?.team || null;
        return {
          name: String(team?.name || data?.equipo || data?.user?.equipo || data?.teamName || data?.user?.teamName || '').trim(),
          logoUrl: String(team?.logoUrl || team?.logo_equipo || data?.logo_equipo || data?.user?.logo_equipo || data?.teamLogoUrl || data?.user?.teamLogoUrl || '').trim(),
          role: String(team?.role || data?.teamRole || data?.user?.teamRole || '').trim()
        };
      };

      const setText = (id, value) => { const el = $(id); if (el) el.textContent = String(value ?? '--'); };
      const noRows = (cols, text) => `<tr><td colspan="${cols}">${escapeHtml(text)}</td></tr>`;

      function setTeamImages(url) {
        const safe = url || fallbackTeamLogo;
        ['profile2TeamLogo','profile2TeamLogoMini','profile2TeamLogoPreview'].forEach((id) => {
          const el = $(id);
          if (!el) return;
          el.src = safe;
          el.onerror = () => { el.src = fallbackTeamLogo; };
        });
      }

      function renderTeam(data) {
        const team = teamFromProfileData(data);
        const hasTeam = Boolean(team.name || team.logoUrl);
        const name = team.name || 'Sin equipo';
        const role = team.role || (hasTeam ? 'Piloto' : 'Añade tu escudería');
        const logo = team.logoUrl || fallbackTeamLogo;

        ['profile2TeamName','profile2TeamNameMini','profile2TeamNamePreview'].forEach((id) => setText(id, name));
        ['profile2TeamRole','profile2TeamRoleMini','profile2TeamRolePreview'].forEach((id) => setText(id, role));
        setText('profile2TeamSummaryTitle', hasTeam ? 'Equipo actual.' : 'Sin equipo.');
        setText('profile2TeamSummaryText', hasTeam ? `${name} queda asociado a este perfil para futuras funciones de equipos.` : 'Añade una escudería para preparar participación por equipos.');
        setTeamImages(logo);

        const nameInput = $('profile2TeamNameInput');
        const logoInput = $('profile2TeamLogoInput');
        const roleInput = $('profile2TeamRoleInput');
        if (nameInput) nameInput.value = team.name;
        if (logoInput) logoInput.value = team.logoUrl;
        if (roleInput) roleInput.value = team.role;
      }


      const lapTimeMs = (lap) => {
        const raw = firstValue(lap, ['lapTimeMs','bestLapMs','LapTime','lapTimeRawMs','timeMs']);
        const n = Number(raw);
        if (Number.isFinite(n) && n > 0) return n;
        const text = String(firstValue(lap, ['lapTimeFormatted','lapTime','bestLapTimeFormatted','bestLap','bestTime']) || '').trim();
        const match = text.match(/^(?:(\d+):)?(\d{1,2})[\.:](\d{3})$/);
        if (!match) return Infinity;
        return (Number(match[1] || 0) * 60000) + (Number(match[2]) * 1000) + Number(match[3]);
      };

      const lapTimestampMs = (lap) => {
        const raw = firstValue(lap, ['timestamp','timestampUnix','timestampMs','timestampIso','createdAt','dateIso','date','lapDate']);
        if (raw === undefined || raw === null || raw === '') return 0;
        if (typeof raw === 'number') return raw > 20000000000 ? raw : raw * 1000;
        const s = String(raw).trim();
        if (/^\d+$/.test(s)) {
          const n = Number(s);
          return n > 20000000000 ? n : n * 1000;
        }
        const d = new Date(s).getTime();
        return Number.isFinite(d) ? d : 0;
      };

      const lapIsValid = (lap) => {
        const raw = firstValue(lap, ['valid','isValid','validLap','validity']);
        if (typeof raw === 'boolean') return raw;
        if (typeof raw === 'number') return raw > 0;
        const s = String(raw ?? '').trim().toLowerCase();
        if (['valid','válida','valida','true','yes','1'].includes(s)) return true;
        if (['invalid','no válida','no valida','false','no','0'].includes(s)) return false;
        return true;
      };

      const lapRankText = (lap) => {
        const pos = lap.rank?.position || lap.position || lap.comboRank || lap.rankPosition || '';
        const total = lap.rank?.total || lap.totalDrivers || lap.comboTotal || lap.rankTotal || '';
        return pos ? `${pos}${total ? '/' + total : ''}` : '--';
      };

      const collectPilotLaps = (data) => {
        const pools = [data.laps, data.allLaps, data.hotlaps, data.recentLaps, data.bestCombos];
        const map = new Map();
        for (const pool of pools) {
          if (!Array.isArray(pool)) continue;
          for (const lap of pool) {
            if (!lap || typeof lap !== 'object') continue;
            const key = [
              firstValue(lap, ['id','lapId','lap.id']),
              trackName(lap),
              carName(lap),
              lapTimeMs(lap),
              lapTimestampMs(lap)
            ].join('|');
            if (!map.has(key)) map.set(key, lap);
          }
        }
        return [...map.values()];
      };

      const uniqueSorted = (items, mapper) => [...new Set(items.map(mapper).filter((x) => x && x !== '-'))].sort((a, b) => a.localeCompare(b, 'es'));

      const fillSelect = (id, values, label = 'Todos') => {
        const el = $(id);
        if (!el) return;
        const current = el.value;
        el.innerHTML = `<option value="">${escapeHtml(label)}</option>` + values.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('');
        if (values.includes(current)) el.value = current;
      };

      let profile2AllLaps = [];

      const renderStatsTable = (data, laps) => {
        const summary = data.summary || {};
        const ratingStats = data.ratings?.stats || {};
        const totalLaps = Number(summary.totalLaps || laps.length || 0);
        const validLaps = Number(summary.validLaps ?? laps.filter(lapIsValid).length ?? 0);
        const invalidLaps = Math.max(0, Number(summary.invalidLaps ?? (totalLaps - validLaps)) || 0);
        const carCount = Number(summary.carsCount || uniqueSorted(laps, carName).length || 0);
        const trackCount = Number(summary.tracksCount || uniqueSorted(laps, trackName).length || 0);
        const combosCount = Number(summary.combosCount || new Set(laps.map((lap) => `${trackName(lap)}|${carName(lap)}`)).size || 0);
        const drivenMs = laps.reduce((sum, lap) => {
          const ms = lapTimeMs(lap);
          return Number.isFinite(ms) ? sum + ms : sum;
        }, 0);
        const minutes = drivenMs ? Math.round(drivenMs / 60000) : null;
        const hours = drivenMs ? Math.round((drivenMs / 3600000) * 10) / 10 : null;
        const rows = [
          ['Actividad', 'Total vueltas', fmtNumber(totalLaps), 'todas las vueltas registradas'],
          ['Actividad', 'Vueltas válidas', fmtNumber(validLaps), 'vueltas limpias/aceptadas'],
          ['Actividad', 'Vueltas no válidas', fmtNumber(invalidLaps), 'track limits, cortes o invalidadas'],
          ['Actividad', 'Minutos conducidos', minutes !== null ? fmtNumber(minutes) : '--', 'estimación por suma de tiempos'],
          ['Actividad', 'Horas conducidas', hours !== null ? `${fmtNumber(hours)} h` : '--', 'estimación por suma de tiempos'],
          ['Actividad', 'Última vuelta', fmtDate(summary.lastSeenAt || summary.lastActivityAt || summary.latestLapAt), 'último registro del piloto'],
          ['Uso', 'Coches usados', fmtNumber(carCount), 'coches distintos conducidos'],
          ['Uso', 'Circuitos usados', fmtNumber(trackCount), 'circuitos distintos rodados'],
          ['Uso', 'Combos distintos', fmtNumber(combosCount), 'coche + circuito'],
          ['Ritmo', 'Mejor vuelta', lapTime(summary.bestLap), 'mejor tiempo personal'],
          ['Ritmo', 'Media Top 10', summary.best10Average || '--', 'media de mejores vueltas'],
          ['Ritmo', 'Delta Top 10', summary.best10Delta || '--', 'consistencia respecto al mejor tiempo'],
          ['Ritmo', 'Ranking global', summary.bestRank ? `${summary.bestRank.position}/${summary.bestRank.total}` : '--', 'posición por mejor vuelta registrada'],
          ['Velocidad', 'Vmax', fmtSpeed(summary.maxSpeedKmh), 'velocidad máxima registrada'],
          ['Velocidad', 'Velocidad media', fmtSpeed(summary.avgSpeedKmh), 'media de velocidades registradas'],
          ['Racecraft', 'Limpieza', summary.cleanRate !== undefined ? `${summary.cleanRate}%` : cleanRate(validLaps, totalLaps), 'porcentaje de vueltas válidas'],
          ['Racecraft', 'Cortes totales', fmtNumber(summary.totalCuts ?? 0), 'track limits acumulados'],
          ['Racecraft', 'Cortes/vuelta', summary.avgCuts ?? '--', 'media de cortes por vuelta'],
          ['Rating', 'Carreras rating', fmtNumber(ratingStats.races ?? ratingStats.ratingRaces ?? ratingStats.totalRaces ?? 0), 'carreras con rating'],
          ['Rating', 'Victorias', fmtNumber(ratingStats.wins ?? 0), 'resultados en rating'],
          ['Rating', 'Podios', fmtNumber(ratingStats.podiums ?? 0), 'resultados en rating'],
          ['Rating', 'Carreras limpias', fmtNumber(ratingStats.cleanRaces ?? 0), 'sin penalización relevante'],
          ['Preferencias', 'Coche favorito', carName(summary.favoriteCar || {}), 'más usado o representativo'],
          ['Preferencias', 'Circuito favorito', trackName(summary.favoriteTrack || {}), 'más usado o representativo']
        ];
        const body = $('profile2StatsBody');
        if (!body) return;
        body.innerHTML = rows.map((row) => `
          <tr>
            <td><span class="gc-profile2-stat-area">${escapeHtml(row[0])}</span></td>
            <td>${escapeHtml(row[1])}</td>
            <td><strong>${escapeHtml(row[2])}</strong></td>
            <td>${escapeHtml(row[3])}</td>
          </tr>
        `).join('');
      };

      const bestByTrack = (laps) => {
        const map = new Map();
        for (const lap of laps) {
          const track = trackName(lap);
          if (!track || track === '-') continue;
          const current = map.get(track);
          const valid = lapIsValid(lap);
          if (!current) { map.set(track, lap); continue; }
          const currentValid = lapIsValid(current);
          if (valid && !currentValid) { map.set(track, lap); continue; }
          if (valid === currentValid && lapTimeMs(lap) < lapTimeMs(current)) map.set(track, lap);
        }
        return [...map.values()];
      };

      const renderHotlapFilters = (laps) => {
        fillSelect('profile2LapTrack', uniqueSorted(laps, trackName));
        fillSelect('profile2LapCar', uniqueSorted(laps, carName));
      };

      const renderHotlapsTable = () => {
        const search = String($('profile2LapSearch')?.value || '').trim().toLowerCase();
        const track = $('profile2LapTrack')?.value || '';
        const car = $('profile2LapCar')?.value || '';
        const validity = $('profile2LapValidity')?.value || 'all';
        const view = $('profile2LapView')?.value || 'best-track';
        const sort = $('profile2LapSort')?.value || 'best';
        let rows = [...profile2AllLaps];
        rows = rows.filter((lap) => {
          const t = trackName(lap);
          const c = carName(lap);
          const v = lapIsValid(lap);
          if (track && t !== track) return false;
          if (car && c !== car) return false;
          if (validity === 'valid' && !v) return false;
          if (validity === 'invalid' && v) return false;
          if (search) {
            const haystack = `${t} ${c} ${lapTime(lap)} ${fmtDate(lap.timestampIso || lap.createdAt || lap.dateIso || lap.timestamp)}`.toLowerCase();
            if (!haystack.includes(search)) return false;
          }
          return true;
        });
        if (view === 'best-track') rows = bestByTrack(rows);
        rows.sort((a, b) => {
          if (sort === 'recent') return lapTimestampMs(b) - lapTimestampMs(a);
          if (sort === 'track') return trackName(a).localeCompare(trackName(b), 'es') || lapTimeMs(a) - lapTimeMs(b);
          if (sort === 'car') return carName(a).localeCompare(carName(b), 'es') || lapTimeMs(a) - lapTimeMs(b);
          if (sort === 'speed') return Number(firstValue(b, ['maxSpeedKmh','topSpeedKmh','speedKmh']) || 0) - Number(firstValue(a, ['maxSpeedKmh','topSpeedKmh','speedKmh']) || 0);
          return lapTimeMs(a) - lapTimeMs(b);
        });
        const meta = $('profile2HotlapsMeta');
        if (meta) meta.textContent = view === 'best-track'
          ? `${fmtNumber(rows.length)} mejores tiempos: uno por circuito. ${fmtNumber(profile2AllLaps.length)} vueltas disponibles.`
          : `${fmtNumber(rows.length)} vueltas filtradas de ${fmtNumber(profile2AllLaps.length)} disponibles.`;
        const body = $('profile2HotlapsBody');
        if (!body) return;
        body.innerHTML = rows.length
          ? rows.slice(0, 300).map((lap, index) => {
            const valid = lapIsValid(lap);
            return `<tr>
              <td>${index + 1}</td>
              <td>${escapeHtml(trackName(lap))}</td>
              <td>${escapeHtml(carName(lap))}</td>
              <td><strong>${escapeHtml(lapTime(lap))}</strong></td>
              <td>${escapeHtml(fmtDate(lap.timestampIso || lap.createdAt || lap.dateIso || lap.timestamp))}</td>
              <td><span class="${valid ? 'gc-profile2-lap-valid' : 'gc-profile2-lap-invalid'}">${valid ? 'Válida' : 'No válida'}</span></td>
              <td>${escapeHtml(fmtSpeed(firstValue(lap, ['maxSpeedKmh','topSpeedKmh','speedKmh'])))}</td>
              <td>${escapeHtml(lapRankText(lap))}</td>
            </tr>`;
          }).join('')
          : noRows(8, 'No hay vueltas con estos filtros.');
      };

      function renderUnauthenticated(data) {
        setText('profile2Name', 'Login requerido');
        setText('profile2Lead', data?.message || 'Entra con tu cuenta para ver tu perfil de piloto.');
        $('profile2Badges').innerHTML = '<span class="gc-profile2-chip">Sesión no activa</span>';
        $('profile2RatingBadges').innerHTML = `<span class="gc-profile2-rating-group">${ratingScoreBadge('sr', '--', null)}${ratingClassBadge('sr', '--')}</span><span class="gc-profile2-rating-group">${ratingScoreBadge('gsr', '--', null)}${ratingClassBadge('gsr', '--')}</span>`;
        ['profile2TotalLaps','profile2BestLap','profile2CleanRate','profile2MaxSpeed','profile2LastLap'].forEach((id) => setText(id, '--'));
        if ($('profile2StatsBody')) $('profile2StatsBody').innerHTML = '<tr><td colspan="4">Inicia sesión para cargar estadísticas.</td></tr>';
        $('profile2HotlapsBody').innerHTML = noRows(8, 'Inicia sesión para ver hotlaps.');
        if ($('profile2HotlapsMeta')) $('profile2HotlapsMeta').textContent = 'Sin sesión activa';
        $('profile2AccountRows').innerHTML = '<div><span>Sesión</span><strong>No activa</strong></div>';
        if ($('profile2PilotLinkRows')) $('profile2PilotLinkRows').innerHTML = '<div><span>Piloto</span><strong>No disponible</strong></div>';
      }

      function renderProfile(data) {
        currentProfileData = data;
        const user = data.user || {};
        const pilot = data.pilot || {};
        const summary = data.summary || {};
        const ratingDriver = data.ratings?.driver || {};
        const ratingStats = data.ratings?.stats || {};
        const linkedPlayerId = pilot.id || data.pilotLink?.playerId || null;
        const name = data.linked ? pilotName(pilot, cleanName(user.displayName, 'Piloto')) : cleanName(user.displayName, 'Cuenta GC');
        const team = teamFromProfileData(data);

        setText('profile2Name', name);
        setText('profile2Lead', data.linked ? `Perfil competitivo desde stracker${team.name ? ' · ' + team.name : ''}.` : 'Cuenta activa, pendiente de vincular a un piloto real.');

        const avatarUrl = linkedPlayerId ? `/api/pilot-avatar/${encodeURIComponent(String(linkedPlayerId))}` : fallbackAvatar;
        ['profile2Avatar','profile2AvatarPreview'].forEach((id) => {
          const avatar = $(id);
          if (!avatar) return;
          avatar.src = avatarUrl;
          avatar.onerror = () => { avatar.src = fallbackAvatar; };
        });

        $('profile2Badges').innerHTML = [
          `<span class="gc-profile2-chip is-accent">${escapeHtml(cleanName(user.role, 'pilot'))}</span>`,
          `<span class="gc-profile2-chip">${escapeHtml(data.linked ? 'Piloto vinculado' : 'Sin piloto vinculado')}</span>`,
          `<span class="gc-profile2-chip${team.name ? ' is-accent' : ''}">${escapeHtml(team.name ? 'Equipo · ' + team.name : 'Sin equipo')}</span>`
        ].join('');


        $('profile2RatingBadges').innerHTML = `<span class="gc-profile2-rating-group">${ratingScoreBadge('sr', ratingDriver.srClass || '--', ratingDriver.srScore ?? null)}${ratingClassBadge('sr', ratingDriver.srClass || '--')}</span><span class="gc-profile2-rating-group">${ratingScoreBadge('gsr', ratingDriver.gsrClass || '--', ratingDriver.gsrRating ?? null)}${ratingClassBadge('gsr', ratingDriver.gsrClass || '--')}</span>`;

        setText('profile2TotalLaps', fmtNumber(summary.totalLaps || 0));
        setText('profile2BestLap', lapTime(summary.bestLap));
        setText('profile2CleanRate', summary.cleanRate !== undefined ? `${summary.cleanRate}%` : cleanRate(summary.validLaps, summary.totalLaps));
        setText('profile2MaxSpeed', fmtSpeed(summary.maxSpeedKmh));
        setText('profile2LastLap', fmtDate(summary.lastSeenAt || summary.lastActivityAt || summary.latestLapAt));

        renderTeam(data);

        const publicLink = $('profile2PublicLink');
        if (publicLink) {
          publicLink.hidden = !data.linked || !linkedPlayerId;
          if (data.linked && linkedPlayerId) publicLink.href = `/pilotos/${encodeURIComponent(String(linkedPlayerId))}`;
        }

        const totalLaps = Number(summary.totalLaps || 0);
        const validLaps = Number(summary.validLaps || 0);
        const invalidLaps = Math.max(0, totalLaps - validLaps);
        const cleanPct = summary.cleanRate !== undefined ? `${summary.cleanRate}%` : cleanRate(validLaps, totalLaps);
        const cleanRaces = Number(ratingStats.cleanRaces ?? 0);
        const raceCount = ratingStats.races ?? ratingStats.ratingRaces ?? ratingStats.totalRaces ?? summary.ratingRaces ?? '';
        const raceCountText = raceCount !== '' && raceCount !== null && raceCount !== undefined ? ` / ${fmtNumber(raceCount)}` : '';

        profile2AllLaps = collectPilotLaps(data);
        renderStatsTable(data, profile2AllLaps);
        renderHotlapFilters(profile2AllLaps);
        renderHotlapsTable();

        const rawGuid = String(pilot.steamGuid || data.pilotLink?.steamGuid || '');
        const shortGuid = rawGuid ? `${rawGuid.slice(0, 12)}...${rawGuid.slice(-8)}` : '--';
        $('profile2AccountRows').innerHTML = [
          `<div><span><b>Email</b><small>correo asociado a la cuenta</small></span><strong>${escapeHtml(user.email || '--')}</strong></div>`,
          `<div><span><b>Nombre visible</b><small>identidad mostrada en la plataforma</small></span><strong>${escapeHtml(cleanName(user.displayName || user.name, name))}</strong></div>`,
          `<div><span><b>Rol</b><small>permisos actuales</small></span><strong>${escapeHtml(cleanName(user.role, 'pilot'))}</strong></div>`,
          `<div><span><b>País</b><small>bandera pública del piloto</small></span><strong>${escapeHtml(flagEmoji(normalizeCountryCode(user.countryCode || data.countryCode)) + ' ' + (normalizeCountryCode(user.countryCode || data.countryCode) || 'Sin país'))}</strong></div>`,
          `<div><span><b>Fecha de registro</b><small>alta de la cuenta</small></span><strong>${escapeHtml(fmtDate(user.createdAt || data.createdAt || data.session?.createdAt))}</strong></div>`
        ].join('');

        if ($('profile2PilotLinkRows')) {
          $('profile2PilotLinkRows').innerHTML = [
            `<div><span><b>Estado</b><small>vínculo con piloto de sTracker</small></span><strong>${escapeHtml(data.linked ? 'Vinculado' : 'Sin vincular')}</strong></div>`,
            `<div><span><b>Player ID</b><small>identificador del piloto</small></span><strong>${escapeHtml(linkedPlayerId || '--')}</strong></div>`,
            `<div><span><b>Steam GUID</b><small>identificador técnico</small></span><strong title="${escapeHtml(rawGuid)}">${escapeHtml(shortGuid)}</strong></div>`,
            `<div><span><b>Vínculo creado</b><small>fecha del vínculo</small></span><strong>${escapeHtml(fmtDate(data.pilotLink?.linkedAt))}</strong></div>`
          ].join('');
        }

        const accountPublic = $('profile2PublicProfileAccount');
        if (accountPublic) {
          accountPublic.hidden = !data.linked || !linkedPlayerId;
          if (data.linked && linkedPlayerId) accountPublic.href = `/pilotos/${encodeURIComponent(String(linkedPlayerId))}`;
        }

        const displayInput = $('profile2DisplayNameInput');
        const emailInput = $('profile2EmailInput');
        if (displayInput) displayInput.value = cleanName(user.displayName || user.name, name);
        if (emailInput) emailInput.value = user.email || '';
        const countryInput = $('profile2CountryInput');
        if (countryInput) countryInput.value = normalizeCountryCode(user.countryCode || data.countryCode);
        const unlinkButton = $('profile2UnlinkPilot');
        if (unlinkButton) unlinkButton.disabled = !data.linked;
        loadTeamManagement().catch(() => {});
      }

      function setTeamMessage(text, tone = '') {
        const el = $('profile2TeamMessage');
        if (!el) return;
        el.textContent = text || '';
        el.style.color = tone === 'ok' ? '#96ff2f' : tone === 'error' ? '#ff5757' : 'rgba(232,241,224,.68)';
      }

      async function saveTeam(clear = false) {
        const payload = clear ? { equipo: '', logo_equipo: '', teamRole: '' } : {
          name: $('profile2TeamNameInput')?.value || '',
          logoUrl: $('profile2TeamLogoInput')?.value || '',
          role: $('profile2TeamRoleInput')?.value || 'owner',
          countryCode: $('profile2CountryInput')?.value || ''
        };

        ['profile2SaveTeam','profile2ClearTeam','profile2TeamNameInput','profile2TeamLogoInput','profile2TeamRoleInput'].forEach((id) => {
          const el = $(id);
          if (el) el.disabled = true;
        });
        setTeamMessage(clear ? 'Quitando equipo...' : 'Guardando equipo...');

        try {
          const response = await fetch(clear ? '/api/profile/team' : '/api/gc/teams', {
            method:'POST',
            credentials:'include',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result?.ok === false) throw new Error(result?.message || 'No se pudo actualizar el equipo.');
          await loadProfile();
          setTeamMessage(clear ? 'Equipo eliminado.' : 'Equipo guardado.', 'ok');
        } catch (error) {
          setTeamMessage(error.message || 'No se pudo actualizar el equipo.', 'error');
        } finally {
          ['profile2SaveTeam','profile2ClearTeam','profile2TeamNameInput','profile2TeamLogoInput','profile2TeamRoleInput'].forEach((id) => {
            const el = $(id);
            if (el) el.disabled = false;
          });
        }
      }


      function setProfile2Message(id, text, tone = '') {
        const el = $(id);
        if (!el) return;
        el.textContent = text || '';
        el.style.color = tone === 'ok' ? '#96ff2f' : tone === 'error' ? '#ff7777' : 'rgba(244,255,241,.78)';
      }

      function setBusy(ids, busy) {
        ids.forEach((id) => { const el = $(id); if (el) el.disabled = Boolean(busy); });
      }


      async function saveCountry() {
        setBusy(['profile2SaveCountry','profile2CountryInput'], true);
        setProfile2Message('profile2CountryMessage', 'Guardando país...');
        try {
          const response = await fetch('/api/gc/drivers/me/profile', {
            method:'POST', credentials:'include', cache:'no-store', headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify({ countryCode: $('profile2CountryInput')?.value || '' })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo guardar el país.');
          await loadProfile();
          setProfile2Message('profile2CountryMessage', data.message || 'País actualizado.', 'ok');
        } catch (error) {
          setProfile2Message('profile2CountryMessage', error.message || 'No se pudo guardar el país.', 'error');
        } finally {
          setBusy(['profile2SaveCountry','profile2CountryInput'], false);
        }
      }

      async function loadTeamManagement() {
        const membersBox = $('profile2TeamMembers');
        if (!membersBox) return;
        const response = await fetch('/api/gc/teams/me', { credentials:'include', cache:'no-store' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data?.ok === false || !data.team) {
          currentTeamData = null;
          membersBox.innerHTML = '<div><span><b>Equipo</b><small>crea una escudería primero</small></span><strong>Sin equipo</strong></div>';
          return;
        }
        currentTeamData = data.team;
        const members = Array.isArray(data.members) ? data.members : (Array.isArray(data.team.members) ? data.team.members : []);
        membersBox.innerHTML = members.length ? members.map((member) => {
          const country = normalizeCountryCode(member.countryCode);
          const role = cleanName(member.role, 'driver');
          return `<div><span><b>${escapeHtml(cleanName(member.displayName || member.driverName, 'Piloto'))}</b><small>${escapeHtml(role)} · ${escapeHtml(member.playerId || member.steamGuid || 'no reclamado')}</small></span><strong>${escapeHtml(flagEmoji(country) + ' ' + (country || '--'))}</strong></div>`;
        }).join('') : '<div><span><b>Miembros</b><small>sin pilotos todavía</small></span><strong>0</strong></div>';
      }

      async function addTeamMember() {
        if (!currentTeamData?.id) {
          setProfile2Message('profile2TeamMembersMessage', 'Primero crea o guarda tu equipo.', 'error');
          return;
        }
        const driverName = $('profile2TeamMemberName')?.value || '';
        if (!driverName.trim()) {
          setProfile2Message('profile2TeamMembersMessage', 'Introduce el nombre del piloto.', 'error');
          return;
        }
        setBusy(['profile2AddTeamMember','profile2TeamMemberName','profile2TeamMemberRole'], true);
        setProfile2Message('profile2TeamMembersMessage', 'Añadiendo piloto...');
        try {
          const response = await fetch(`/api/gc/teams/${encodeURIComponent(currentTeamData.id)}/members`, {
            method:'POST', credentials:'include', cache:'no-store', headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify({ driverName, role: $('profile2TeamMemberRole')?.value || 'driver' })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo añadir piloto.');
          $('profile2TeamMemberName').value = '';
          await loadTeamManagement();
          setProfile2Message('profile2TeamMembersMessage', data.message || 'Piloto añadido.', 'ok');
        } catch (error) {
          setProfile2Message('profile2TeamMembersMessage', error.message || 'No se pudo añadir piloto.', 'error');
        } finally {
          setBusy(['profile2AddTeamMember','profile2TeamMemberName','profile2TeamMemberRole'], false);
        }
      }

      async function saveIdentity() {
        setBusy(['profile2SaveIdentity','profile2DisplayNameInput','profile2EmailInput','profile2EmailPasswordInput'], true);
        setProfile2Message('profile2AccountMessage', 'Guardando identidad...');
        try {
          const response = await fetch('/api/auth/account', {
            method:'POST',
            credentials:'include',
            cache:'no-store',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify({
              displayName: $('profile2DisplayNameInput')?.value || '',
              email: $('profile2EmailInput')?.value || '',
              currentPassword: $('profile2EmailPasswordInput')?.value || ''
            })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo actualizar la cuenta.');
          $('profile2EmailPasswordInput').value = '';
          await loadProfile();
          setProfile2Message('profile2AccountMessage', data.message || 'Identidad actualizada.', 'ok');
        } catch (error) {
          setProfile2Message('profile2AccountMessage', error.message || 'No se pudo actualizar la cuenta.', 'error');
        } finally {
          setBusy(['profile2SaveIdentity','profile2DisplayNameInput','profile2EmailInput','profile2EmailPasswordInput'], false);
        }
      }

      async function changePassword() {
        const currentPassword = $('profile2CurrentPasswordInput')?.value || '';
        const newPassword = $('profile2NewPasswordInput')?.value || '';
        const confirmPassword = $('profile2ConfirmPasswordInput')?.value || '';

        if (!currentPassword) {
          setProfile2Message('profile2SecurityMessage', 'Introduce tu contraseña actual.', 'error');
          $('profile2CurrentPasswordInput')?.focus();
          return;
        }
        if (newPassword.length < 8) {
          setProfile2Message('profile2SecurityMessage', 'La nueva contraseña debe tener al menos 8 caracteres.', 'error');
          $('profile2NewPasswordInput')?.focus();
          return;
        }
        if (newPassword !== confirmPassword) {
          setProfile2Message('profile2SecurityMessage', 'Las contraseñas no coinciden.', 'error');
          $('profile2ConfirmPasswordInput')?.focus();
          return;
        }
        if (newPassword === currentPassword) {
          setProfile2Message('profile2SecurityMessage', 'La nueva contraseña debe ser distinta a la actual.', 'error');
          $('profile2NewPasswordInput')?.focus();
          return;
        }

        setBusy(['profile2SavePassword','profile2CurrentPasswordInput','profile2NewPasswordInput','profile2ConfirmPasswordInput'], true);
        setProfile2Message('profile2SecurityMessage', 'Actualizando contraseña...');
        try {
          const response = await fetch('/api/auth/password', {
            method:'POST',
            credentials:'include',
            cache:'no-store',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo cambiar la contraseña.');
          ['profile2CurrentPasswordInput','profile2NewPasswordInput','profile2ConfirmPasswordInput'].forEach((id) => { const el = $(id); if (el) el.value = ''; });
          setProfile2Message('profile2SecurityMessage', data.message || 'Contraseña actualizada.', 'ok');
        } catch (error) {
          setProfile2Message('profile2SecurityMessage', error.message || 'No se pudo cambiar la contraseña.', 'error');
        } finally {
          setBusy(['profile2SavePassword','profile2CurrentPasswordInput','profile2NewPasswordInput','profile2ConfirmPasswordInput'], false);
        }
      }

      function fileToDataUrl(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result || ''));
          reader.onerror = () => reject(new Error('No se pudo leer el archivo.'));
          reader.readAsDataURL(file);
        });
      }

      async function uploadAvatar() {
        const file = $('profile2AvatarFile')?.files?.[0] || null;
        if (!file) {
          setProfile2Message('profile2AvatarMessage', 'Selecciona una imagen antes de subir.', 'error');
          return;
        }
        setBusy(['profile2UploadAvatar','profile2ResetAvatar','profile2AvatarFile'], true);
        setProfile2Message('profile2AvatarMessage', 'Subiendo avatar...');
        try {
          const imageData = await fileToDataUrl(file);
          const response = await fetch('/api/pilot-avatar/me', {
            method:'POST',
            credentials:'include',
            cache:'no-store',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify({ imageData, fileName: file.name })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo guardar el avatar.');
          if (data.avatarUrl) {
            const versionedAvatarUrl = `${data.avatarUrl}?v=${Date.now()}`;
            ['profile2Avatar','profile2AvatarPreview'].forEach((id) => {
              const avatar = $(id);
              if (avatar) avatar.src = versionedAvatarUrl;
            });
          }
          setProfile2Message('profile2AvatarMessage', 'Avatar actualizado.', 'ok');
        } catch (error) {
          setProfile2Message('profile2AvatarMessage', error.message || 'No se pudo subir el avatar.', 'error');
        } finally {
          setBusy(['profile2UploadAvatar','profile2ResetAvatar','profile2AvatarFile'], false);
        }
      }

      async function resetAvatar() {
        setBusy(['profile2UploadAvatar','profile2ResetAvatar','profile2AvatarFile'], true);
        setProfile2Message('profile2AvatarMessage', 'Restableciendo avatar...');
        try {
          const response = await fetch('/api/pilot-avatar/me', { method:'DELETE', credentials:'include', cache:'no-store' });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo restablecer el avatar.');
          await loadProfile();
          setProfile2Message('profile2AvatarMessage', 'Avatar base restaurado.', 'ok');
        } catch (error) {
          setProfile2Message('profile2AvatarMessage', error.message || 'No se pudo restablecer el avatar.', 'error');
        } finally {
          setBusy(['profile2UploadAvatar','profile2ResetAvatar','profile2AvatarFile'], false);
        }
      }

      const candidateName = (pilot) => cleanName(pilot.displayName ?? pilot.visibleName ?? pilot.cleanName ?? pilot.name ?? pilot.driverName ?? pilot.playerName, 'Piloto');
      const candidatePlayerId = (pilot) => pilot.playerId ?? pilot.id ?? pilot.PlayerId ?? pilot.player_id ?? '';
      const candidateGuid = (pilot) => String(pilot.steamGuid ?? pilot.guid ?? pilot.Guid ?? pilot.steam_guid ?? '');

      function renderPilotPreview() {
        const id = String($('profile2PilotSelect')?.value || '');
        const pilot = pilotCandidates.find((item) => String(candidatePlayerId(item)) === id);
        const preview = $('profile2PilotPreview');
        if (!preview) return;
        if (!pilot) {
          preview.textContent = 'Selecciona un piloto para ver el resumen.';
          return;
        }
        preview.innerHTML = `<strong>${escapeHtml(candidateName(pilot))}</strong><br><span>Player ID ${escapeHtml(candidatePlayerId(pilot))}${candidateGuid(pilot) ? ' · ' + escapeHtml(candidateGuid(pilot).slice(0, 18)) + '…' : ''}</span>`;
      }

      function renderPilotCandidates() {
        const select = $('profile2PilotSelect');
        if (!select) return;
        const q = String($('profile2PilotSearch')?.value || '').trim().toLowerCase();
        const rows = pilotCandidates.filter((pilot) => {
          const hay = `${candidateName(pilot)} ${candidatePlayerId(pilot)} ${candidateGuid(pilot)}`.toLowerCase();
          return !q || hay.includes(q);
        }).slice(0, 500);
        select.innerHTML = rows.length
          ? '<option value="">Selecciona piloto...</option>' + rows.map((pilot) => `<option value="${escapeHtml(candidatePlayerId(pilot))}">${escapeHtml(candidateName(pilot))} · ID ${escapeHtml(candidatePlayerId(pilot))}</option>`).join('')
          : '<option value="">Sin resultados</option>';
        renderPilotPreview();
      }

      async function loadPilotCandidates() {
        if (pilotCandidates.length) { renderPilotCandidates(); return; }
        setProfile2Message('profile2PilotMessage', 'Cargando pilotos de sTracker...');
        const response = await fetch('/api/pilots?limit=500', { credentials:'include', cache:'no-store' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudieron cargar los pilotos.');
        pilotCandidates = Array.isArray(data.items) ? data.items : Array.isArray(data.pilots) ? data.pilots : [];
        renderPilotCandidates();
        setProfile2Message('profile2PilotMessage', pilotCandidates.length ? 'Selecciona piloto y guarda el vínculo.' : 'No hay pilotos disponibles.', pilotCandidates.length ? '' : 'error');
      }

      async function togglePilotPanel() {
        const panel = $('profile2PilotLinkPanel');
        if (!panel) return;
        panel.hidden = !panel.hidden;
        if (!panel.hidden) {
          try { await loadPilotCandidates(); }
          catch (error) { setProfile2Message('profile2PilotMessage', error.message || 'No se pudieron cargar los pilotos.', 'error'); }
        }
      }

      async function savePilotLink() {
        const playerId = String($('profile2PilotSelect')?.value || '').trim();
        if (!playerId) {
          setProfile2Message('profile2PilotMessage', 'Selecciona un piloto antes de guardar.', 'error');
          return;
        }
        setBusy(['profile2ConfirmPilotLink','profile2CancelPilotLink','profile2OpenPilotLink','profile2UnlinkPilot','profile2PilotSearch','profile2PilotSelect'], true);
        setProfile2Message('profile2PilotMessage', 'Guardando vínculo...');
        try {
          const response = await fetch('/api/auth/link-pilot', {
            method:'POST', credentials:'include', cache:'no-store', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ playerId })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo vincular el piloto.');
          if ($('profile2PilotLinkPanel')) $('profile2PilotLinkPanel').hidden = true;
          await loadProfile();
          setProfile2Message('profile2PilotMessage', data.message || 'Piloto vinculado.', 'ok');
        } catch (error) {
          setProfile2Message('profile2PilotMessage', error.message || 'No se pudo vincular el piloto.', 'error');
        } finally {
          setBusy(['profile2ConfirmPilotLink','profile2CancelPilotLink','profile2OpenPilotLink','profile2UnlinkPilot','profile2PilotSearch','profile2PilotSelect'], false);
        }
      }

      async function unlinkPilot() {
        if (!currentProfileData?.linked) {
          setProfile2Message('profile2PilotMessage', 'No hay piloto vinculado.', 'error');
          return;
        }
        if (!window.confirm('¿Desvincular este piloto de tu cuenta?')) return;
        setBusy(['profile2OpenPilotLink','profile2UnlinkPilot'], true);
        setProfile2Message('profile2PilotMessage', 'Desvinculando piloto...');
        try {
          const response = await fetch('/api/auth/unlink-pilot', { method:'POST', credentials:'include', cache:'no-store' });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo desvincular el piloto.');
          await loadProfile();
          setProfile2Message('profile2PilotMessage', data.message || 'Piloto desvinculado.', 'ok');
        } catch (error) {
          setProfile2Message('profile2PilotMessage', error.message || 'No se pudo desvincular el piloto.', 'error');
        } finally {
          setBusy(['profile2OpenPilotLink','profile2UnlinkPilot'], false);
        }
      }

      async function deleteAccount() {
        const currentPassword = $('profile2DeletePasswordInput')?.value || '';
        const confirmText = $('profile2DeleteConfirmInput')?.value || '';
        if (String(confirmText).trim().toUpperCase() !== 'ELIMINAR') {
          setProfile2Message('profile2DangerMessage', 'Escribe ELIMINAR para confirmar.', 'error');
          return;
        }
        if (!window.confirm('Esta acción eliminará el acceso de la cuenta. ¿Continuar?')) return;
        setBusy(['profile2DeleteAccount','profile2DeletePasswordInput','profile2DeleteConfirmInput'], true);
        setProfile2Message('profile2DangerMessage', 'Eliminando cuenta...');
        try {
          const response = await fetch('/api/auth/delete-account', {
            method:'POST', credentials:'include', cache:'no-store', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ currentPassword, confirmText })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data?.ok === false) throw new Error(data?.message || 'No se pudo borrar la cuenta.');
          setProfile2Message('profile2DangerMessage', data.message || 'Cuenta eliminada.', 'ok');
          window.setTimeout(() => { window.location.href = '/login'; }, 900);
        } catch (error) {
          setProfile2Message('profile2DangerMessage', error.message || 'No se pudo borrar la cuenta.', 'error');
          setBusy(['profile2DeleteAccount','profile2DeletePasswordInput','profile2DeleteConfirmInput'], false);
        }
      }

      async function loadProfile() {
        const response = await fetch('/api/profile', { credentials:'include', cache:'no-store' });
        const data = await response.json().catch(() => ({}));
        if (!data.ok && data.authenticated === false) renderUnauthenticated(data);
        else renderProfile(data);
      }

      document.querySelectorAll('[data-profile2-tab]').forEach((button) => {
        button.addEventListener('click', () => {
          const tab = button.getAttribute('data-profile2-tab');
          document.querySelectorAll('[data-profile2-tab]').forEach((item) => item.classList.toggle('is-active', item === button));
          document.querySelectorAll('[data-profile2-panel]').forEach((panel) => {
            const active = panel.getAttribute('data-profile2-panel') === tab;
            panel.hidden = !active;
            panel.classList.toggle('is-active', active);
          });
        });
      });

      document.querySelectorAll('[data-profile2-tab-jump]').forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.getAttribute('data-profile2-tab-jump');
          document.querySelector(`[data-profile2-tab="${target}"]`)?.click();
        });
      });

      ['profile2TeamNameInput','profile2TeamLogoInput','profile2TeamRoleInput'].forEach((id) => {
        const el = $(id);
        if (!el) return;
        el.addEventListener('input', () => {
          const name = $('profile2TeamNameInput')?.value || 'Sin equipo';
          const logo = $('profile2TeamLogoInput')?.value || fallbackTeamLogo;
          const role = $('profile2TeamRoleInput')?.value || 'Piloto';
          setText('profile2TeamNamePreview', name);
          setText('profile2TeamRolePreview', role);
          const img = $('profile2TeamLogoPreview');
          if (img) img.src = logo;
        });
      });


      ['profile2LapSearch','profile2LapTrack','profile2LapCar','profile2LapValidity','profile2LapView','profile2LapSort'].forEach((id) => {
        const el = $(id);
        if (!el) return;
        el.addEventListener(id === 'profile2LapSearch' ? 'input' : 'change', renderHotlapsTable);
      });

      $('profile2SaveTeam')?.addEventListener('click', () => saveTeam(false));
      $('profile2ClearTeam')?.addEventListener('click', () => saveTeam(true));


      $('profile2SaveIdentity')?.addEventListener('click', saveIdentity);
      $('profile2SaveCountry')?.addEventListener('click', saveCountry);
      $('profile2AddTeamMember')?.addEventListener('click', addTeamMember);
      $('profile2SavePassword')?.addEventListener('click', changePassword);
      ['profile2CurrentPasswordInput','profile2NewPasswordInput','profile2ConfirmPasswordInput'].forEach((id) => {
        const el = $(id);
        if (!el) return;
        el.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            changePassword();
          }
        });
      });
      $('profile2UploadAvatar')?.addEventListener('click', uploadAvatar);
      $('profile2ResetAvatar')?.addEventListener('click', resetAvatar);
      $('profile2OpenPilotLink')?.addEventListener('click', togglePilotPanel);
      $('profile2CancelPilotLink')?.addEventListener('click', () => { const panel = $('profile2PilotLinkPanel'); if (panel) panel.hidden = true; setProfile2Message('profile2PilotMessage', ''); });
      $('profile2ConfirmPilotLink')?.addEventListener('click', savePilotLink);
      $('profile2UnlinkPilot')?.addEventListener('click', unlinkPilot);
      $('profile2PilotSearch')?.addEventListener('input', renderPilotCandidates);
      $('profile2PilotSelect')?.addEventListener('change', renderPilotPreview);
      $('profile2DeleteAccount')?.addEventListener('click', deleteAccount);

      loadProfile().catch((error) => {
        setText('profile2Name', 'Error');
        setText('profile2Lead', error.message || 'No se pudo cargar el perfil.');
        if ($('profile2StatsBody')) $('profile2StatsBody').innerHTML = '<tr><td colspan="4">No se pudo cargar /api/profile.</td></tr>';
        if ($('profile2HotlapsBody')) $('profile2HotlapsBody').innerHTML = noRows(8, 'No se pudo cargar /api/profile.');
        if ($('profile2HotlapsMeta')) $('profile2HotlapsMeta').textContent = 'Error cargando perfil';
      });
    })();
  </script>
</MarketingLayout>