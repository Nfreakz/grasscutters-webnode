  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);

      const escapeHtml = (value) => String(value ?? '-').replace(/[&<>'"]/g, (char) => ({
        '&':'&amp;',
        '<':'&lt;',
        '>':'&gt;',
        "'":'&#39;',
        '"':'&quot;'
      }[char]));

      const ratingClassKey = (value) => String(value || 'unknown')
        .trim()
        .toLowerCase()
        .replace('+', 'plus')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'unknown';


      const ratingDisplayName = (type, value) => {
        const raw = String(value || '--');
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const srLabels = {
          'A+': 'Legend',
          A: 'Elite',
          B: 'Pro',
          C: 'Advanced',
          D: 'Rookie',
          E: 'Pitlane',
          '--': '--'
        };
        const gsrLabels = {
          S: 'Diamond',
          A: 'Ruby',
          B: 'Sapphire',
          C: 'Emerald',
          D: 'Amber',
          Rookie: 'Onyx',
          ROOKIE: 'Onyx',
          '--': '--'
        };
        return safeType === 'gsr' ? (gsrLabels[raw] || raw) : (srLabels[raw] || raw);
      };

      const ratingBadge = (type, value, score = null, options = {}) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const safeValue = String(value || '--');
        const displayValue = ratingDisplayName(safeType, safeValue);
        const classKey = ratingClassKey(safeValue);
        const compactClass = options.compact ? ' gc-rating-badge--compact' : '';
        const scoreMarkup = score !== null && score !== undefined && score !== ''
          ? `<small>${escapeHtml(score)}</small>`
          : '';

        return `
          <span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${classKey}${compactClass}">
            <span class="gc-rating-badge__type">${safeType.toUpperCase()}</span>
            <strong>${escapeHtml(displayValue)}</strong>
            ${scoreMarkup}
          </span>
        `;
      };

      const ratingSummaryBlock = (label, type, value, score = null, helper = '') => {
        return `
          <div class="gc-profile-rating-stack">
            ${ratingBadge(type, value, score)}
            ${helper ? `<small class="gc-profile-rating-copy">${escapeHtml(helper)}</small>` : ''}
          </div>
        `;
      };

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source, path)) return source[path];
        return String(path).split('.').reduce((acc, part) => acc == null ? undefined : acc[part], source);
      };

      const firstValue = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source, path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return '';
      };

      const cleanName = (value, fallback = '-') => {
        if (value === undefined || value === null || value === '') return fallback;
        if (typeof value === 'object') {
          return cleanName(
            value.displayName ??
            value.visibleName ??
            value.cleanName ??
            value.display_name ??
            value.uiName ??
            value.uiCarName ??
            value.uiTrackName ??
            value.name ??
            value.Name ??
            value.driverName ??
            value.playerName ??
            value.code,
            fallback
          );
        }
        return String(value).replace(/_/g,' ').replace(/\s+/g,' ').trim() || fallback;
      };

      const displayFrom = (source, paths, fallback = '-') => cleanName(firstValue(source, paths), fallback);

      const fmtMs = (ms) => {
        const n = Number(ms);
        if (!Number.isFinite(n) || n <= 0) return '--';
        const m = Math.floor(n / 60000);
        const s = Math.floor((n % 60000) / 1000);
        const x = String(Math.floor(n % 1000)).padStart(3, '0');
        return `${m}:${String(s).padStart(2, '0')}.${x}`;
      };

      const fmtDate = (value) => {
        if (value === undefined || value === null || value === '') return '-';

        let ms = 0;

        if (typeof value === 'number') {
          ms = value > 20000000000 ? value : value * 1000;
        } else {
          const raw = String(value).trim();

          if (/^\d+$/.test(raw)) {
            const numeric = Number(raw);
            ms = numeric > 20000000000 ? numeric : numeric * 1000;
          } else {
            ms = new Date(raw).getTime();

            if (!Number.isFinite(ms)) {
              ms = new Date(raw.replace(' ', 'T')).getTime();
            }

            if (!Number.isFinite(ms)) {
              const slash = raw.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{2,4})(?:[,\s]+(\d{1,2}):(\d{2}))?/);
              if (slash) {
                const day = Number(slash[1]);
                const month = Number(slash[2]) - 1;
                const yearRaw = Number(slash[3]);
                const year = yearRaw < 100 ? 2000 + yearRaw : yearRaw;
                const hour = Number(slash[4] || 0);
                const minute = Number(slash[5] || 0);
                ms = new Date(year, month, day, hour, minute).getTime();
              }
            }
          }
        }

        if (!Number.isFinite(ms) || ms <= 0) return '-';

        return new Date(ms).toLocaleString('es-ES', {
          day:'2-digit',
          month:'2-digit',
          hour:'2-digit',
          minute:'2-digit'
        });
      };

      const fmtSpeed = (value) => Number.isFinite(Number(value)) && Number(value) > 0 ? `${Math.round(Number(value))} km/h` : '--';
      const lapTime = (lap) => cleanName(firstValue(lap, ['lapTimeFormatted','lapTime','bestLapTimeFormatted','bestLap','bestTime']), '') || fmtMs(firstValue(lap, ['lapTimeMs','bestLapMs','LapTime']));
      const carName = (row) => displayFrom(row, ['carDisplayName','carVisibleName','carName','car.displayName','car.visibleName','car.cleanName','car.uiName','car.uiCarName','car.name','car.code','car'], '-');
      const trackName = (row) => displayFrom(row, ['trackDisplayName','trackVisibleName','trackName','track.displayName','track.visibleName','track.cleanName','track.uiName','track.uiTrackName','track.name','track.code','track'], '-');
      const pilotName = (pilot) => displayFrom(pilot, ['displayName','visibleName','cleanName','name','driverName','playerName','strackerName'], 'Perfil piloto');
      const cleanRate = (valid, total) => total ? `${Math.round((Number(valid || 0) / Number(total || 0)) * 1000) / 10}%` : '--';
      const setMetric = (id, value) => { const el = $(id); if (el) el.textContent = String(value ?? '--'); };
      const noRows = (cols, text) => `<tr><td colspan="${cols}">${escapeHtml(text)}</td></tr>`;

      const linkUi = {
        panel: $('pilotLinkPanel'),
        open: $('openPilotLink'),
        cancel: $('cancelPilotLink'),
        confirm: $('confirmPilotLink'),
        unlink: $('unlinkPilotAction'),
        search: $('pilotLinkSearch'),
        select: $('pilotLinkSelect'),
        preview: $('pilotLinkPreview'),
        message: $('pilotLinkMessage')
      };

      const teamUi = {
        panel: $('profileTeamPanel'),
        name: $('profileTeamName'),
        logo: $('profileTeamLogo'),
        role: $('profileTeamRole'),
        nameInput: $('profileTeamNameInput'),
        logoInput: $('profileTeamLogoInput'),
        roleInput: $('profileTeamRoleInput'),
        save: $('saveTeamProfileBtn'),
        clear: $('clearTeamProfileBtn'),
        message: $('profileTeamMessage'),
        badge: $('profileTeamBadge')
      };

      let pilotCandidates = [];
      let currentProfileData = null;

      const normalizeSearch = (value) => String(value ?? '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
      const candidateName = (pilot) => cleanName(pilot.displayName ?? pilot.visibleName ?? pilot.cleanName ?? pilot.name ?? pilot.driverName ?? pilot.playerName, 'Piloto');
      const candidateId = (pilot) => pilot.id ?? pilot.playerId ?? pilot.PlayerId ?? pilot.driverId ?? '';
      const candidateGuid = (pilot) => String(pilot.steamGuid ?? pilot.SteamGuid ?? '').trim();

      const setLinkMessage = (text, tone = "") => {
        if (!linkUi.message) return;
        linkUi.message.textContent = text || "";
        linkUi.message.style.color = tone === "error" ? "var(--danger)" : tone === "ok" ? "var(--accent)" : "var(--soft)";
      };

      function setLinkBusy(isBusy) {
        [linkUi.open, linkUi.cancel, linkUi.confirm, linkUi.unlink, linkUi.search, linkUi.select].forEach((el) => {
          if (el) el.disabled = Boolean(isBusy);
        });
      }

      const defaultTeamLogo = '/images/pilot-avatar-default.png';

      const teamFromProfileData = (data) => {
        const team = data?.team || data?.user?.team || null;
        const name = team?.name || data?.equipo || data?.user?.equipo || data?.teamName || data?.user?.teamName || '';
        const logoUrl = team?.logoUrl || team?.logo_equipo || data?.logo_equipo || data?.user?.logo_equipo || data?.teamLogoUrl || data?.user?.teamLogoUrl || '';
        const role = team?.role || data?.teamRole || data?.user?.teamRole || '';
        return { name: String(name || '').trim(), logoUrl: String(logoUrl || '').trim(), role: String(role || '').trim() };
      };

      const setTeamMessage = (text, tone = '') => {
        if (!teamUi.message) return;
        teamUi.message.textContent = text || '';
        teamUi.message.style.color = tone === 'error' ? 'var(--danger)' : tone === 'ok' ? 'var(--accent)' : 'var(--soft)';
      };

      function renderTeam(data) {
        const team = teamFromProfileData(data);
        const hasTeam = Boolean(team.name || team.logoUrl);
        const name = team.name || 'Sin equipo';
        const role = team.role || (hasTeam ? 'Piloto' : 'Añade tu equipo o escudería.');
        const logo = team.logoUrl || defaultTeamLogo;

        if (teamUi.name) teamUi.name.textContent = name;
        if (teamUi.role) teamUi.role.textContent = role;
        if (teamUi.logo) {
          teamUi.logo.src = logo;
          teamUi.logo.onerror = () => { teamUi.logo.src = defaultTeamLogo; };
        }
        if (teamUi.nameInput) teamUi.nameInput.value = team.name || '';
        if (teamUi.logoInput) teamUi.logoInput.value = team.logoUrl || '';
        if (teamUi.roleInput) teamUi.roleInput.value = team.role || '';
        if (teamUi.badge) {
          teamUi.badge.textContent = hasTeam ? `Equipo · ${name}` : 'Sin equipo';
          teamUi.badge.classList.toggle('gc-chip--accent', hasTeam);
        }
      }

      async function saveTeamProfile(clear = false) {
        if (!currentProfileData?.authenticated) return;
        const payload = clear ? { equipo: '', logo_equipo: '', teamRole: '' } : {
          equipo: teamUi.nameInput?.value || '',
          logo_equipo: teamUi.logoInput?.value || '',
          teamRole: teamUi.roleInput?.value || ''
        };

        [teamUi.save, teamUi.clear, teamUi.nameInput, teamUi.logoInput, teamUi.roleInput].forEach((el) => { if (el) el.disabled = true; });
        setTeamMessage(clear ? 'Quitando equipo...' : 'Guardando equipo...');

        try {
          const response = await fetch('/api/profile/team', {
            method:'POST',
            credentials:'include',
            cache:'no-store',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await response.json().catch(() => null);
          if (!response.ok || result?.ok === false) throw new Error(result?.message || 'No se pudo actualizar el equipo.');
          currentProfileData = { ...currentProfileData, team: result.team, user: result.user || currentProfileData.user, equipo: result.equipo, logo_equipo: result.logo_equipo };
          renderTeam(currentProfileData);
          setTeamMessage(result.message || 'Equipo actualizado.', 'ok');
        } catch (error) {
          setTeamMessage(error.message || 'No se pudo actualizar el equipo.', 'error');
        } finally {
          [teamUi.save, teamUi.clear, teamUi.nameInput, teamUi.logoInput, teamUi.roleInput].forEach((el) => { if (el) el.disabled = false; });
        }
      }

      teamUi.save?.addEventListener('click', () => saveTeamProfile(false));
      teamUi.clear?.addEventListener('click', () => saveTeamProfile(true));

      function updatePilotLinkControls(data) {
        currentProfileData = data || null;
        const linked = Boolean(data?.linked);

        if (linkUi.open) {
          linkUi.open.hidden = false;
          linkUi.open.textContent = linked ? "Cambiar piloto" : "Vincular piloto";
        }

        if (linkUi.unlink) linkUi.unlink.hidden = !linked;
        if (linkUi.panel) linkUi.panel.hidden = true;

        setLinkMessage("");
      }

      function renderPilotCandidates() {
        if (!linkUi.select) return;

        const query = normalizeSearch(linkUi.search?.value || "");
        const filtered = pilotCandidates.filter((pilot) => {
          const haystack = normalizeSearch([candidateName(pilot), candidateId(pilot), candidateGuid(pilot)].join(" "));
          return !query || haystack.includes(query);
        }).slice(0, 150);

        if (!filtered.length) {
          linkUi.select.innerHTML = '<option value="">Sin pilotos con ese filtro</option>';
          renderPilotPreview();
          return;
        }

        linkUi.select.innerHTML = filtered.map((pilot) => {
          const id = candidateId(pilot);
          const laps = Number(pilot.totalLaps ?? pilot.laps ?? 0);
          const label = candidateName(pilot) + " · ID " + id + (laps ? " · " + laps + " vueltas" : "");
          return '<option value="' + escapeHtml(id) + '">' + escapeHtml(label) + '</option>';
        }).join("");

        renderPilotPreview();
      }

      function selectedPilot() {
        const id = String(linkUi.select?.value || "");
        return pilotCandidates.find((pilot) => String(candidateId(pilot)) === id) || null;
      }

      function renderPilotPreview() {
        if (!linkUi.preview) return;

        const pilot = selectedPilot();

        if (!pilot) {
          linkUi.preview.textContent = "Selecciona un piloto para ver el resumen.";
          return;
        }

        const guid = candidateGuid(pilot);
        const shortGuid = guid ? guid.slice(0, 16) + "..." + guid.slice(-8) : "-";

        linkUi.preview.innerHTML =
          "<strong>" + escapeHtml(candidateName(pilot)) + "</strong>" +
          "<span>Player ID: " + escapeHtml(candidateId(pilot)) + "</span>" +
          "<span>Vueltas: " + escapeHtml(pilot.totalLaps ?? pilot.laps ?? 0) + " · Válidas: " + escapeHtml(pilot.validLaps ?? 0) + "</span>" +
          "<span>Mejor vuelta: " + escapeHtml(pilot.bestLap || fmtMs(pilot.bestLapMs)) + "</span>" +
          '<span title="' + escapeHtml(guid) + '">Steam GUID: ' + escapeHtml(shortGuid) + '</span>';
      }

      async function loadPilotCandidates() {
        if (pilotCandidates.length) {
          renderPilotCandidates();
          return;
        }

        if (linkUi.select) linkUi.select.innerHTML = '<option value="">Cargando pilotos...</option>';
        setLinkMessage("Cargando pilotos de stracker...");

        const response = await fetch("/api/pilots?limit=500", {
          credentials:"include",
          cache:"no-store"
        });

        const data = await response.json().catch(() => null);

        if (!response.ok || !data?.ok) {
          throw new Error(data?.message || "No se pudieron cargar los pilotos.");
        }

        pilotCandidates = Array.isArray(data.items) ? data.items : Array.isArray(data.pilots) ? data.pilots : [];
        renderPilotCandidates();
        setLinkMessage(pilotCandidates.length ? "Selecciona tu piloto y guarda el vínculo." : "No hay pilotos disponibles en stracker.");
      }

      async function openPilotPanel() {
        if (!linkUi.panel) return;

        linkUi.panel.hidden = !linkUi.panel.hidden;

        if (!linkUi.panel.hidden) {
          try {
            await loadPilotCandidates();
          } catch (error) {
            setLinkMessage(error.message || "No se pudieron cargar los pilotos.", "error");
          }
        }
      }

      async function savePilotLink() {
        const playerId = String(linkUi.select?.value || "").trim();

        if (!playerId) {
          setLinkMessage("Selecciona un piloto antes de guardar.", "error");
          return;
        }

        setLinkBusy(true);
        setLinkMessage("Guardando vínculo...");

        try {
          const response = await fetch("/api/auth/link-pilot", {
            method:"POST",
            credentials:"include",
            cache:"no-store",
            headers:{ "Content-Type":"application/json" },
            body: JSON.stringify({ playerId })
          });

          const data = await response.json().catch(() => null);

          if (!response.ok || !data?.ok) {
            throw new Error(data?.message || "No se pudo vincular el piloto.");
          }

          setLinkMessage("Piloto vinculado correctamente. Recargando perfil...", "ok");
          window.setTimeout(() => window.location.reload(), 650);
        } catch (error) {
          setLinkMessage(error.message || "No se pudo vincular el piloto.", "error");
          setLinkBusy(false);
        }
      }

      async function unlinkPilot() {
        if (!currentProfileData?.linked) return;
        if (!window.confirm("¿Desvincular este piloto de tu cuenta?")) return;

        setLinkBusy(true);
        setLinkMessage("Desvinculando piloto...");

        try {
          const response = await fetch("/api/auth/unlink-pilot", {
            method:"POST",
            credentials:"include",
            cache:"no-store"
          });

          const data = await response.json().catch(() => null);

          if (!response.ok || !data?.ok) {
            throw new Error(data?.message || "No se pudo desvincular el piloto.");
          }

          setLinkMessage("Piloto desvinculado. Recargando perfil...", "ok");
          window.setTimeout(() => window.location.reload(), 650);
        } catch (error) {
          setLinkMessage(error.message || "No se pudo desvincular el piloto.", "error");
          setLinkBusy(false);
        }
      }

      linkUi.open?.addEventListener("click", openPilotPanel);
      linkUi.cancel?.addEventListener("click", () => {
        if (linkUi.panel) linkUi.panel.hidden = true;
        setLinkMessage("");
      });
      linkUi.confirm?.addEventListener("click", savePilotLink);
      linkUi.unlink?.addEventListener("click", unlinkPilot);
      linkUi.search?.addEventListener("input", renderPilotCandidates);
      linkUi.select?.addEventListener("change", renderPilotPreview);

      function renderUnauthenticated(data) {
        if (linkUi.open) linkUi.open.hidden = true;
        if (linkUi.unlink) linkUi.unlink.hidden = true;
        if (linkUi.panel) linkUi.panel.hidden = true;
        if (teamUi.panel) teamUi.panel.hidden = true;

        $('accountState').textContent = 'Sin login';
        $('accountState').style.color = 'var(--warn)';
        $('profileText').textContent = data.message || 'Entra con tu cuenta para ver tus datos de piloto.';
        $('profileBadges').innerHTML = '<span class="gc-chip gc-chip--warn">Sesión requerida</span>';
        $('profileMeta').innerHTML = '<div class="gc-status-row"><span>Sesión</span><strong>No activa</strong></div>';
        $('linkedPilot').innerHTML = '<p>No hay sesión activa.</p><div class="gc-actions"><a class="gc-btn gc-btn--primary" href="/login">Entrar ahora</a></div>';

        ['metricBestLap','metricRank','metricValid','metricConsistency'].forEach((id) => setMetric(id, '-'));

        $('summaryRows').innerHTML = '<div><span>Estado</span><strong>Login requerido</strong></div>';
        $('bestCombos').innerHTML = noRows(6, 'Inicia sesión para ver combos.');
        $('recentLaps').innerHTML = noRows(6, 'Inicia sesión para ver actividad.');
        $('garageRows').innerHTML = noRows(6, 'Inicia sesión para ver garaje.');
        $('trackRows').innerHTML = noRows(6, 'Inicia sesión para ver circuitos.');
      }

      function renderProfile(data) {
        const summary = data.summary || {};
        const user = data.user || {};
        const pilot = data.pilot || {};
        const ratingDriver = data.ratings?.driver || {};
        const ratingStats = data.ratings?.stats || {};
        const linkedPlayerId = pilot.id || data.pilotLink?.playerId || null;
        const team = teamFromProfileData(data);

        updatePilotLinkControls(data);
        if (teamUi.panel) teamUi.panel.hidden = false;
        renderTeam(data);
        const avatar = $('profilePilotAvatar');
        if (avatar) {
          avatar.src = linkedPlayerId ? `/api/pilot-avatar/${encodeURIComponent(String(linkedPlayerId))}` : '/images/pilot-avatar-default.png';
          avatar.onerror = () => { avatar.src = '/images/pilot-avatar-default.png'; };
        }

        $('profileTitle').textContent = pilotName(pilot) || cleanName(user.displayName, 'Perfil piloto');
        $('profileText').textContent = data.linked
          ? `Datos reales de rendimiento desde stracker${team.name ? ' · Equipo ' + team.name : ''}.`
          : 'Cuenta activa, pendiente de vincular a un piloto real.';

        $('accountState').textContent = data.linked ? 'Vinculado' : 'Sin piloto';
        $('accountState').style.color = data.linked ? 'var(--accent)' : 'var(--warn)';

        $('profileBadges').innerHTML =
          `<span class="gc-chip gc-chip--accent">${escapeHtml(cleanName(user.role,'pilot'))}</span>` +
          `<span class="gc-chip">${escapeHtml(pilotName(pilot))}</span>` +
          `<span class="gc-chip">${escapeHtml(summary.totalLaps || 0)} vueltas</span>` +
          `<span class="gc-chip${team.name ? ' gc-chip--accent' : ''}" id="profileTeamBadge">${escapeHtml(team.name ? 'Equipo · ' + team.name : 'Sin equipo')}</span>`;
        teamUi.badge = $('profileTeamBadge');

        $('profileMeta').innerHTML =
          `<div class="gc-status-row"><span>Email</span><strong>${escapeHtml(user.email)}</strong></div>` +
          `<div class="gc-status-row"><span>Rol</span><strong>${escapeHtml(cleanName(user.role,'pilot'))}</strong></div>` +
          `<div class="gc-status-row"><span>Última actividad</span><strong>${escapeHtml(fmtDate(summary.lastSeenAt || summary.lastActivityAt || summary.latestLapAt))}</strong></div>` +
          `<div class="gc-status-row"><span>Ratings</span><strong class="gc-profile-rating-inline">${ratingBadge('sr', ratingDriver.srClass || '--', ratingDriver.srScore ?? null)}${ratingBadge('gsr', ratingDriver.gsrClass || '--', ratingDriver.gsrRating ?? null)}</strong></div>`;

        const rank = summary.bestRank ? `${summary.bestRank.position}/${summary.bestRank.total}` : '--';

        setMetric('metricBestLap', lapTime(summary.bestLap));
        setMetric('metricRank', rank);
        setMetric('metricValid', `${summary.validLaps || 0}/${summary.totalLaps || 0}`);
        setMetric('metricConsistency', summary.consistency || '--');

        $('summaryMeta').textContent = `${summary.carsCount || 0} coches · ${summary.tracksCount || 0} circuitos · ${summary.combosCount || 0} combos · ${ratingStats.races || 0} carreras rating`;

        $('summaryRows').innerHTML =
          `<div><span>Racecraft</span><strong>${ratingSummaryBlock('Racecraft', 'sr', ratingDriver.srClass || '--', ratingDriver.srScore ?? null, 'Racecraft limpio y consistente')}</strong></div>` +
          `<div><span>Race Pace</span><strong>${ratingSummaryBlock('Race Pace', 'gsr', ratingDriver.gsrClass || '--', ratingDriver.gsrRating ?? null, 'Rango competitivo en parrilla')}</strong></div>` +
          `<div><span>Limpieza</span><strong>${escapeHtml(summary.cleanRate ?? summary.validityRate ?? 0)}%</strong></div>` +
          `<div><span>Carreras limpias</span><strong>${escapeHtml(ratingStats.cleanRaces ?? 0)}</strong></div>` +
          `<div><span>Incid./carrera</span><strong>${escapeHtml(ratingStats.incidentsPerRace ?? '--')}</strong></div>` +
          `<div><span>Victorias / Podios</span><strong>${escapeHtml(ratingStats.wins ?? 0)} / ${escapeHtml(ratingStats.podiums ?? 0)}</strong></div>` +
          `<div><span>Media mejores 10</span><strong>${escapeHtml(summary.best10Average || '--')}</strong></div>` +
          `<div><span>Delta top 10</span><strong>${escapeHtml(summary.best10Delta || '--')}</strong></div>` +
          `<div><span>Vmax</span><strong>${escapeHtml(fmtSpeed(summary.maxSpeedKmh))}</strong></div>` +
          `<div><span>Cortes totales</span><strong>${escapeHtml(summary.totalCuts ?? 0)}</strong></div>` +
          `<div><span>Coche favorito</span><strong>${escapeHtml(carName(summary.favoriteCar || {}))}</strong></div>` +
          `<div><span>Circuito favorito</span><strong>${escapeHtml(trackName(summary.favoriteTrack || {}))}</strong></div>`;

        const publicAction = $('publicProfileAction');

        if (publicAction) {
          publicAction.hidden = !data.linked || !linkedPlayerId;
          if (data.linked && linkedPlayerId) publicAction.href = `/pilotos/${encodeURIComponent(linkedPlayerId)}`;
        }

        const rawGuid = String(pilot.steamGuid || data.pilotLink?.steamGuid || '');
        const shortGuid = rawGuid ? `${rawGuid.slice(0, 16)}...${rawGuid.slice(-8)}` : '-';

        $('linkedPilot').innerHTML = data.linked
          ? `<p><strong>${escapeHtml(pilotName(pilot) || data.pilotLink?.strackerName || '-')}</strong></p>` +
            `<p class="gc-small">Player ID: ${escapeHtml(linkedPlayerId || '-')}</p>` +
            `<p class="gc-small" title="${escapeHtml(rawGuid)}">Steam GUID: ${escapeHtml(shortGuid)}</p>` +
            `<p class="gc-note">Vínculo creado: ${escapeHtml(fmtDate(data.pilotLink?.linkedAt))}</p>` +
            `<div class="gc-actions"><a class="gc-btn gc-btn--primary" href="/pilotos/${encodeURIComponent(linkedPlayerId || '')}">Abrir perfil público</a></div>`
          : `<p>Tu cuenta todavía no está vinculada a un piloto de stracker.</p><p class="gc-note">Selecciona tu piloto real desde el perfil para activar tus datos.</p>`;

        const combos = data.bestCombos || [];
        $('bestCombos').innerHTML = combos.length
          ? combos.slice(0,18).map((lap,index) =>
              `<tr><td>${index+1}</td><td>${escapeHtml(carName(lap))}</td><td>${escapeHtml(trackName(lap))}</td><td><strong>${escapeHtml(lapTime(lap))}</strong></td><td>${lap.rank ? `${escapeHtml(lap.rank.position)}/${escapeHtml(lap.rank.total)}` : '-'}</td><td>${escapeHtml(cleanRate(lap.validLaps, lap.totalLaps))}</td></tr>`
            ).join('')
          : noRows(6, 'Sin combos válidos todavía.');

        const recent = data.recentLaps || [];
        $('recentLaps').innerHTML = recent.length
          ? recent.slice(0,18).map((lap) =>
              `<tr><td>${escapeHtml(fmtDate(lap.timestampIso || lap.createdAt || lap.dateIso))}</td><td>${escapeHtml(carName(lap))}</td><td>${escapeHtml(trackName(lap))}</td><td><strong>${escapeHtml(lapTime(lap))}</strong></td><td>${lap.valid ? '<span class="gc-chip gc-chip--accent">Válida</span>' : '<span class="gc-chip">No válida</span>'}</td><td>${escapeHtml(fmtSpeed(lap.maxSpeedKmh))}</td></tr>`
            ).join('')
          : noRows(6, 'Sin vueltas recientes.');

        const cars = data.cars || [];
        $('garageRows').innerHTML = cars.length
          ? cars.slice(0,18).map((item) =>
              `<tr><td><strong>${escapeHtml(carName(item))}</strong><br><span class="gc-muted-text">${escapeHtml(item.car?.brand || item.car?.code || '')}</span></td><td>${escapeHtml(item.totalLaps || 0)}</td><td>${escapeHtml(cleanRate(item.validLaps, item.totalLaps))}</td><td><strong>${escapeHtml(item.bestLap || fmtMs(item.bestLapMs))}</strong></td><td>${escapeHtml(item.tracksCount || 0)}</td><td>${escapeHtml(fmtSpeed(item.maxSpeedKmh))}</td></tr>`
            ).join('')
          : noRows(6, 'Sin coches usados.');

        const tracks = data.tracks || [];
        $('trackRows').innerHTML = tracks.length
          ? tracks.slice(0,18).map((item) =>
              `<tr><td><strong>${escapeHtml(trackName(item))}</strong><br><span class="gc-muted-text">${escapeHtml(item.track?.code || '')}</span></td><td>${escapeHtml(item.totalLaps || 0)}</td><td>${escapeHtml(cleanRate(item.validLaps, item.totalLaps))}</td><td><strong>${escapeHtml(item.bestLap || fmtMs(item.bestLapMs))}</strong></td><td>${escapeHtml(item.carsCount || 0)}</td><td>${escapeHtml(fmtDate(item.lastSeenAt || item.lastActivityAt || item.updatedAt))}</td></tr>`
            ).join('')
          : noRows(6, 'Sin circuitos usados.');
      }

      fetch('/api/profile', {
        credentials:'include',
        cache:'no-store'
      })
        .then((response) => response.json())
        .then((data) => {
          if (!data.ok && data.authenticated === false) renderUnauthenticated(data);
          else renderProfile(data);
        })
        .catch((error) => {
          $('accountState').textContent = 'Error';
          $('accountState').style.color = 'var(--warn)';
          $('profileText').textContent = error.message || 'No se pudo cargar /api/profile.';
          $('recentLaps').innerHTML = noRows(6, 'No se pudo cargar el perfil.');
        });
    })();
  </script>

  <script is:inline>
    (() => {
      const section = document.getElementById('passwordSection');
      const currentInput = document.getElementById('currentPasswordInput');
      const newInput = document.getElementById('newPasswordInput');
      const confirmInput = document.getElementById('confirmPasswordInput');
      const button = document.getElementById('changePasswordBtn');
      const message = document.getElementById('changePasswordMessage');

      if (!section || !currentInput || !newInput || !confirmInput || !button || !message) return;

      const setMessage = (text, tone = '') => {
        message.textContent = text || '';
        message.style.color = tone === 'ok' ? 'var(--accent)' : tone === 'error' ? 'var(--danger)' : 'var(--soft)';
      };

      const setBusy = (busy) => {
        button.disabled = Boolean(busy);
        currentInput.disabled = Boolean(busy);
        newInput.disabled = Boolean(busy);
        confirmInput.disabled = Boolean(busy);
      };

      async function checkSession() {
        try {
          const response = await fetch('/api/auth/me', { credentials:'include', cache:'no-store' });
          const data = await response.json().catch(() => null);
          section.hidden = !(response.ok && data?.authenticated === true);
        } catch {
          section.hidden = true;
        }
      }

      async function changePassword() {
        const currentPassword = String(currentInput.value || '');
        const newPassword = String(newInput.value || '');
        const confirmPassword = String(confirmInput.value || '');

        if (!currentPassword) {
          setMessage('Introduce tu contraseña actual.', 'error');
          currentInput.focus();
          return;
        }

        if (newPassword.length < 8) {
          setMessage('La nueva contraseña debe tener al menos 8 caracteres.', 'error');
          newInput.focus();
          return;
        }

        if (newPassword !== confirmPassword) {
          setMessage('Las nuevas contraseñas no coinciden.', 'error');
          confirmInput.focus();
          return;
        }

        setBusy(true);
        setMessage('Actualizando contraseña...');

        try {
          const response = await fetch('/api/auth/password', {
            method:'POST',
            credentials:'include',
            cache:'no-store',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify({ currentPassword, newPassword })
          });

          const data = await response.json().catch(() => ({}));

          if (!response.ok || data.ok === false) {
            throw new Error(data.message || 'No se pudo cambiar la contraseña.');
          }

          currentInput.value = '';
          newInput.value = '';
          confirmInput.value = '';
          setMessage(data.message || 'Contraseña actualizada correctamente.', 'ok');
        } catch (error) {
          setMessage(error.message || 'No se pudo cambiar la contraseña.', 'error');
        } finally {
          setBusy(false);
        }
      }

      button.addEventListener('click', changePassword);

      [currentInput, newInput, confirmInput].forEach((input) => {
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') changePassword();
        });
      });

      checkSession();
    })();
  </script>
</AppLayout>
