---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/public/gc-rating-badges.css';
---
<AppLayout
  title="Pilotos | GrassCutters Racing"
  description="Laboratorio de pilotos GrassCutters con tabla técnica, filtros, ordenación y estadísticas completas."
  canonicalPath="/pilotos"
>
  <div class="gc-page gc-pilotos2-page" data-pilotos2-page>
    <header class="gc-pilotos2-head">
      <div>
        <p class="gc-pilotos2-kicker">STRACKER / DRIVER DATA</p>
        <h1>Pilotos Data.</h1>
        <p>Explora y analiza el rendimiento de todos los pilotos de la plataforma.</p>
        <p>Datos consolidados de vueltas, actividad, coches, circuitos y mejores referencias.</p>
      </div>
      <aside class="gc-pilotos2-source" aria-label="Estado de datos">
        <dl>
          <div><dt>Fuente</dt><dd id="p2Source">--</dd></div>
          <div><dt>Cargados</dt><dd id="p2Loaded">--</dd></div>
          <div><dt>Visibles</dt><dd id="p2Visible">--</dd></div>
          <div><dt>Actualizado</dt><dd id="p2Updated">--</dd></div>
        </dl>
      </aside>
    </header>

    <section class="gc-pilotos2-pulse" aria-label="Resumen de pilotos">
      <div><span>Pilotos</span><strong id="p2MetricPilots">--</strong></div>
      <div><span>Activos 30d</span><strong id="p2MetricActive">--</strong></div>
      <div><span>Vueltas</span><strong id="p2MetricLaps">--</strong></div>
      <div><span>Coches</span><strong id="p2MetricCars">--</strong></div>
      <div><span>Circuitos</span><strong id="p2MetricTracks">--</strong></div>
      <div><span>Vmax</span><strong id="p2MetricBest">--</strong></div>
    </section>

    <section class="gc-pilotos2-filters" aria-label="Filtros de pilotos">
      <label>
        <span>Buscar</span>
        <input id="p2Search" type="search" placeholder="piloto, país, equipo, coche, circuito" autocomplete="off" />
      </label>
      <label>
        <span>Equipo</span>
        <select id="p2Team"><option value="all">Todos</option></select>
      </label>
      <label>
        <span>Clase SR</span>
        <select id="p2Sr"><option value="all">Todas</option></select>
      </label>
      <label>
        <span>Clase GSR</span>
        <select id="p2Gsr"><option value="all">Todas</option></select>
      </label>
      <label>
        <span>Estado</span>
        <select id="p2State">
          <option value="all">Todos</option>
          <option value="active">Activos 30d</option>
          <option value="inactive">Sin actividad 30d</option>
        </select>
      </label>
      <label>
        <span>Coche fav.</span>
        <select id="p2Car"><option value="all">Todos</option></select>
      </label>
      <label>
        <span>Circuito fav.</span>
        <select id="p2Track"><option value="all">Todos</option></select>
      </label>
      <label>
        <span>Orden</span>
        <select id="p2Sort">
          <option value="laps" selected>Vueltas desc</option>
          <option value="active">Actividad 30d</option>
          <option value="valid">Vueltas válidas</option>
          <option value="clean">Limpieza</option>
          <option value="speed">Vmax</option>
          <option value="name">Piloto</option>
        </select>
      </label>
      <label>
        <span>Por página</span>
        <select id="p2PageSize">
          <option value="25" selected>25</option>
          <option value="50">50</option>
          <option value="100">100</option>
          <option value="200">200</option>
        </select>
      </label>
      <div class="gc-pilotos2-actions">
        <button id="p2Reload" type="button">Actualizar</button>
        <button id="p2Clear" type="button">Limpiar</button>
      </div>
    </section>

    <section class="gc-pilotos2-meta" aria-label="Estado del listado">
      <span id="p2Hint">Cargando pilotos...</span>
      <span id="p2PageInfo">Página 1</span>
      <div class="gc-pilotos2-pager">
        <button id="p2Prev" type="button">Anterior</button>
        <button id="p2Next" type="button">Siguiente</button>
      </div>
    </section>

    <section class="gc-pilotos2-table-wrap" aria-label="Tabla de pilotos">
      <table class="gc-pilotos2-table">
        <thead>
          <tr>
            <th data-sort="rank">#</th>
            <th>Avatar</th>
            <th data-sort="name">Piloto</th>
            <th data-sort="country">País</th>
            <th data-sort="team">Equipo</th>
            <th data-sort="sr">SR</th>
            <th data-sort="gsr">GSR</th>
            <th data-sort="laps">Vueltas</th>
            <th data-sort="cars">Coches</th>
            <th data-sort="tracks">Circuitos</th>
            <th data-sort="hours">Horas</th>
            <th data-sort="speed">Vmax</th>
            <th data-sort="favoriteCar">Coche fav. <span class="gc-pilotos2-est">est.</span></th>
            <th data-sort="favoriteTrack">Circuito fav. <span class="gc-pilotos2-est">est.</span></th>
            <th data-sort="last">Última actividad</th>
          </tr>
        </thead>
        <tbody id="p2Rows"><tr><td colspan="15">Cargando...</td></tr></tbody>
      </table>
    </section>
  </div>

  <style is:global>
    .gc-pilotos2-page{--p2-green:var(--accent,#96ff2f);--p2-text:var(--text,#f4fff1);--p2-muted:var(--muted,#84907c);--p2-line:rgba(150,255,47,.22);--p2-soft:rgba(150,255,47,.08);display:grid;gap:12px;width:min(1680px, calc(100vw - 48px));max-width:1680px;margin:0 auto;padding:28px 0 56px;box-sizing:border-box;}
    html[data-gc-scope="marketing"] body.gc-page-platform-data .gc-public-main{padding-top:0;}
    .gc-pilotos2-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,380px);gap:14px;align-items:stretch;border:1px solid var(--p2-line);background:linear-gradient(90deg,rgba(6,14,8,.96),rgba(9,24,10,.72));}
    .gc-pilotos2-head>div:first-child{padding:18px 22px;}
    .gc-pilotos2-kicker,.gc-pilotos2-filters span,.gc-pilotos2-table th,.gc-pilotos2-source dt{margin:0;color:var(--p2-green);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:10px;font-weight:950;letter-spacing:.12em;text-transform:uppercase;}
    .gc-pilotos2-head h1{margin:4px 0 5px;color:var(--p2-text);font-size:clamp(36px,4.6vw,74px);line-height:.86;letter-spacing:-.065em;text-transform:uppercase;}
    .gc-pilotos2-head p:not(.gc-pilotos2-kicker){margin:0;max-width:840px;color:rgba(244,255,241,.70);font-size:14px;}
    .gc-pilotos2-source{border-left:1px solid var(--p2-line);background:rgba(0,0,0,.18);}.gc-pilotos2-source dl{display:grid;grid-template-columns:1fr 1fr;height:100%;margin:0;}.gc-pilotos2-source div{padding:14px;border-right:1px solid rgba(150,255,47,.12);border-bottom:1px solid rgba(150,255,47,.12);}.gc-pilotos2-source div:nth-child(2n){border-right:0;}.gc-pilotos2-source dd{margin:4px 0 0;color:var(--p2-text);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:16px;font-weight:950;}
    .gc-pilotos2-pulse{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border:1px solid var(--p2-line);background:rgba(3,9,5,.92);}.gc-pilotos2-pulse div{min-width:0;padding:12px 14px;border-right:1px solid rgba(150,255,47,.16);}.gc-pilotos2-pulse div:last-child{border-right:0;}.gc-pilotos2-pulse span{display:block;color:var(--p2-muted);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:10px;font-weight:950;letter-spacing:.12em;text-transform:uppercase;}.gc-pilotos2-pulse strong{display:block;margin-top:4px;color:var(--p2-green);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:18px;font-weight:950;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .gc-pilotos2-filters{display:grid;grid-template-columns:minmax(230px,1.5fr) repeat(8,minmax(110px,1fr)) auto;gap:8px;align-items:end;padding:10px;border:1px solid var(--p2-line);background:rgba(3,9,5,.88);}.gc-pilotos2-filters label{display:grid;gap:5px;min-width:0;}.gc-pilotos2-filters input,.gc-pilotos2-filters select{width:100%;height:38px;border:1px solid rgba(150,255,47,.32);border-radius:0;background:#020603;color:var(--p2-text);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:12px;font-weight:800;padding:0 10px;outline:none;}.gc-pilotos2-filters input:focus,.gc-pilotos2-filters select:focus{border-color:var(--p2-green);box-shadow:0 0 0 1px rgba(150,255,47,.18);} .gc-pilotos2-actions{display:flex;gap:8px;align-items:end;}.gc-pilotos2-actions button,.gc-pilotos2-pager button{height:38px;border:1px solid rgba(150,255,47,.38);background:rgba(3,8,4,.9);color:var(--p2-text);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:11px;font-weight:950;letter-spacing:.08em;text-transform:uppercase;padding:0 14px;cursor:pointer;}.gc-pilotos2-actions button:first-child{border-color:rgba(150,255,47,.92);background:linear-gradient(90deg,#96ff2f,#50e7ff);color:#071005;}
    .gc-pilotos2-meta{display:grid;grid-template-columns:1fr auto auto;gap:16px;align-items:center;padding:10px 12px;border:1px solid var(--p2-line);background:rgba(3,9,5,.84);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:11px;font-weight:850;color:var(--p2-muted);text-transform:uppercase;}.gc-pilotos2-pager{display:flex;gap:8px;}.gc-pilotos2-pager button:disabled{opacity:.35;cursor:not-allowed;}
    .gc-pilotos2-table-wrap{border:1px solid var(--p2-line);background:rgba(3,9,5,.94);overflow:auto;}.gc-pilotos2-table{width:100%;min-width:1260px;border-collapse:collapse;color:var(--p2-text);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:12px;}.gc-pilotos2-table th{position:sticky;top:0;z-index:2;padding:10px 9px;text-align:left;background:rgba(5,16,6,.98);border-bottom:1px solid rgba(150,255,47,.22);white-space:nowrap;cursor:pointer;}.gc-pilotos2-table td{padding:10px 9px;border-bottom:1px solid rgba(150,255,47,.13);vertical-align:middle;white-space:nowrap;}.gc-pilotos2-table tr:nth-child(even) td{background:rgba(150,255,47,.025);}.gc-pilotos2-table tr:hover td{background:rgba(150,255,47,.065);} .gc-pilotos2-table strong{font-weight:950;color:var(--p2-text);}.gc-pilotos2-time{color:var(--p2-green)!important;font-size:13px;}.gc-pilotos2-muted{display:block;margin-top:2px;color:var(--p2-muted);font-size:10px;font-weight:800;}.gc-pilotos2-avatar{width:34px;height:34px;border-radius:999px;object-fit:cover;border:1px solid rgba(150,255,47,.55);box-shadow:0 0 12px rgba(150,255,47,.10);background:#050905;}.gc-pilotos2-country{display:inline-flex;align-items:center;gap:6px;min-width:54px;}.gc-pilotos2-flag{font-size:17px;line-height:1;filter:saturate(1.1);}.gc-pilotos2-country-code{color:rgba(244,255,241,.78);font-size:10px;font-weight:950;letter-spacing:.08em;text-transform:uppercase;}.gc-pilotos2-team-logo{width:20px;height:20px;border-radius:50%;object-fit:cover;vertical-align:middle;margin-right:6px;border:1px solid rgba(150,255,47,.35);}.gc-pilotos2-est{display:inline-block;margin-left:3px;color:rgba(244,255,241,.48);font-size:8px;letter-spacing:.06em;}.gc-pilotos2-pilot{display:grid;gap:2px;}.gc-pilotos2-chip{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:22px;padding:0 8px;border:1px solid rgba(150,255,47,.35);background:rgba(150,255,47,.08);color:var(--p2-green);font-family:var(--gc-mono,"JetBrains Mono",monospace);font-size:11px;font-weight:950;letter-spacing:.04em;text-transform:uppercase;}.gc-pilotos2-chip--muted{border-color:rgba(244,255,241,.20);background:rgba(244,255,241,.04);color:rgba(244,255,241,.70);} .gc-pilotos2-state{color:var(--p2-muted);padding:20px!important;text-align:center;}
    @media (max-width:1180px){.gc-pilotos2-head{grid-template-columns:1fr;}.gc-pilotos2-source{border-left:0;border-top:1px solid var(--p2-line);}.gc-pilotos2-pulse{grid-template-columns:repeat(3,minmax(0,1fr));}.gc-pilotos2-filters{grid-template-columns:repeat(3,minmax(0,1fr));}.gc-pilotos2-actions{grid-column:1/-1;}.gc-pilotos2-meta{grid-template-columns:1fr;}}
  </style>

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const state = { rows: [], filtered: [], page: 1, sort: 'laps', sortDir: 'desc' };
      const fmtNumber = (value) => Number.isFinite(Number(value)) ? new Intl.NumberFormat('es-ES').format(Number(value)) : '--';
      const fmtMs = (ms) => { const n=Number(ms); if(!Number.isFinite(n)||n<=0) return '--'; const m=Math.floor(n/60000); const s=Math.floor((n%60000)/1000); const x=String(Math.floor(n%1000)).padStart(3,'0'); return `${m}:${String(s).padStart(2,'0')}.${x}`; };
      const lapTime = (lap) => lap?.lapTimeFormatted || lap?.lapTime || fmtMs(lap?.lapTimeMs);
      const cleanText = (value, fallback='-') => String(value ?? '').replace(/_/g,' ').replace(/\s+/g,' ').trim() || fallback;
      const dateText = (value) => { if(!value) return '--'; const raw=Number(value); const ms=Number.isFinite(raw)&&raw>0?(raw>20000000000?raw:raw*1000):Date.parse(String(value)); if(!Number.isFinite(ms)) return '--'; return new Date(ms).toLocaleString('es-ES',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}); };
      const alpha3To2 = { ESP:'ES', SPA:'ES', ITA:'IT', FRA:'FR', DEU:'DE', GER:'DE', GBR:'GB', UK:'GB', USA:'US', BEL:'BE', AUT:'AT', NLD:'NL', POR:'PT', PRT:'PT', ARG:'AR', MEX:'MX', BRA:'BR', JPN:'JP' };
      const countryCode = (row) => {
        const raw = cleanText(row.countryCode || row.countryIso || row.country || row.nationality || '', '').toUpperCase().replace(/[^A-Z]/g,'');
        if (!raw) return '';
        if (raw.length === 2) return raw;
        if (alpha3To2[raw]) return alpha3To2[raw];
        if (raw.includes('SPAIN') || raw.includes('ESPA')) return 'ES';
        if (raw.includes('ITAL')) return 'IT';
        if (raw.includes('FRAN')) return 'FR';
        if (raw.includes('GERM') || raw.includes('ALEM')) return 'DE';
        return '';
      };
      const flagEmoji = (code) => /^[A-Z]{2}$/.test(code) ? String.fromCodePoint(...[...code].map((c)=>127397 + c.charCodeAt(0))) : '';
      const countryMarkup = (row) => { const code = countryCode(row); const flag = flagEmoji(code); return `<span class="gc-pilotos2-country"><span class="gc-pilotos2-flag" aria-hidden="true">${code ? (flag || '🏁') : '🏳️'}</span><span class="gc-pilotos2-country-code">${escapeHtml(code || '--')}</span></span>`; };
      const rowTimestamp = (row) => row.lastLap?.timestamp || row.lastLap?.timestampIso || '';
      const asNumber = (value, fallback=0) => { const n=Number(value); return Number.isFinite(n)?n:fallback; };
      const uniq = (values) => Array.from(new Set(values.map((v)=>cleanText(v,'')).filter(Boolean))).sort((a,b)=>a.localeCompare(b,'es'));
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
      const normalizeRatingName = (value) => String(value ?? '')
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      async function enrichRowsWithRatings(rows) {
        try {
          const response = await fetch('/api/gc/ratings/leaderboard', { credentials:'same-origin', cache:'no-store' });
          const payload = await response.json();
          const srRows = payload?.leaderboard?.sr || payload?.data?.leaderboard?.sr || [];
          const gsrRows = payload?.leaderboard?.gsr || payload?.data?.leaderboard?.gsr || [];
          if (!Array.isArray(srRows) && !Array.isArray(gsrRows)) return rows;
          const byPlayerId = new Map();
          const byName = new Map();
          const mergeRating = (row, patch) => {
            const playerId = String(row?.profilePlayerId ?? row?.playerId ?? '').trim();
            const name = normalizeRatingName(row?.driver || row?.displayName || row?.name);
            const currentById = playerId ? (byPlayerId.get(playerId) || {}) : {};
            const currentByName = name ? (byName.get(name) || {}) : {};
            const merged = { ...currentByName, ...currentById, ...patch };
            if (playerId) byPlayerId.set(playerId, merged);
            if (name) byName.set(name, merged);
          };
          if (Array.isArray(srRows)) srRows.forEach((row) => mergeRating(row, { srScore: row.sr ?? row.srScore, srClass: row.srClass }));
          if (Array.isArray(gsrRows)) gsrRows.forEach((row) => mergeRating(row, { gsrScore: row.gsr ?? row.gsrRating ?? row.gsrScore, gsrClass: row.gsrClass }));
          return rows.map((row) => {
            const byId = byPlayerId.get(String(row?.playerId ?? '').trim()) || {};
            const byDriverName = byName.get(normalizeRatingName(row?.displayName || row?.name)) || {};
            const match = { ...byDriverName, ...byId };
            return {
              ...row,
              srScore: row.srScore ?? match.srScore ?? null,
              srClass: row.srClass ?? match.srClass ?? null,
              gsrScore: row.gsrScore ?? match.gsrScore ?? null,
              gsrClass: row.gsrClass ?? match.gsrClass ?? null
            };
          });
        } catch (error) {
          console.warn('[pilotos2] ratings fallback unavailable', error);
          return rows;
        }
      }

      const ratingMeta = (type, value) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const raw = String(value || '--').trim().toUpperCase();
        if (safeType === 'gsr') {
          if (raw === 'S' || raw === 'DIAMOND') return { key:'s', value:'S', label:'Diamond' };
          if (raw === 'A' || raw === 'RUBY') return { key:'a', value:'A', label:'Ruby' };
          if (raw === 'B' || raw === 'SAPPHIRE') return { key:'b', value:'B', label:'Sapphire' };
          if (raw === 'C' || raw === 'EMERALD') return { key:'c', value:'C', label:'Emerald' };
          if (raw === 'D' || raw === 'AMBER') return { key:'d', value:'D', label:'Amber' };
          return { key:'unknown', value:'--', label:'--' };
        }
        if (raw === 'A+' || raw === 'APLUS' || raw === 'LEGEND') return { key:'aplus', value:'A+', label:'Legend' };
        if (raw === 'A' || raw === 'ELITE') return { key:'a', value:'A', label:'Elite' };
        if (raw === 'B' || raw === 'PRO') return { key:'b', value:'B', label:'Pro' };
        if (raw === 'C' || raw === 'ADVANCED') return { key:'c', value:'C', label:'Advanced' };
        if (raw === 'D' || raw === 'ROOKIE') return { key:'d', value:'D', label:'Rookie' };
        if (raw === 'E' || raw === 'PITLANE') return { key:'e', value:'E', label:'Pitlane' };
        return { key:'unknown', value:'--', label:'--' };
      };
      const ratingScoreText = (type, score) => {
        const n = Number(score);
        if (!Number.isFinite(n)) return '--';
        return String(type).toLowerCase() === 'gsr' ? String(Math.round(n)) : String(Math.round(n * 10) / 10);
      };
      const ratingScoreBadge = (type, cls, score) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const meta = ratingMeta(safeType, cls);
        const value = ratingScoreText(safeType, score);
        return `<span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${meta.key} gc-rating-badge--compact"><span class="gc-rating-badge__type">${escapeHtml(value)}</span><strong>${escapeHtml(meta.value)}</strong></span>`;
      };
      const ratingClassBadge = (type, cls) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const meta = ratingMeta(safeType, cls);
        return `<span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${meta.key} gc-rating-badge--compact gc-rating-badge--rating-label"><strong>${escapeHtml(meta.label)}</strong></span>`;
      };

      function populateSelect(id, values) {
        const el = $(id); if (!el) return;
        const current = el.value;
        el.innerHTML = '<option value="all">Todos</option>' + values.map((value)=>`<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('');
        if ([...el.options].some((opt)=>opt.value===current)) el.value = current;
      }

      function updateFilters() {
        populateSelect('p2Team', uniq(state.rows.map((row)=>row.team || 'Sin equipo')));
        populateSelect('p2Sr', uniq(state.rows.map((row)=>row.srClass || '--')));
        populateSelect('p2Gsr', uniq(state.rows.map((row)=>row.gsrClass || '--')));
        populateSelect('p2Car', uniq(state.rows.map((row)=>row.favoriteCar || '')));
        populateSelect('p2Track', uniq(state.rows.map((row)=>row.favoriteTrack || '')));
      }

      function rowSearchText(row) {
        return [row.name,row.displayName,row.team,row.country,row.favoriteCar,row.favoriteTrack,row.bestLap?.carName,row.bestLap?.trackName,row.lastLap?.carName,row.lastLap?.trackName].map((v)=>cleanText(v,'')).join(' ').toLowerCase();
      }

      function applyFilters() {
        const q = $('p2Search')?.value.trim().toLowerCase() || '';
        const team = $('p2Team')?.value || 'all';
        const sr = $('p2Sr')?.value || 'all';
        const gsr = $('p2Gsr')?.value || 'all';
        const car = $('p2Car')?.value || 'all';
        const track = $('p2Track')?.value || 'all';
        const active = $('p2State')?.value || 'all';
        state.sort = $('p2Sort')?.value || state.sort;
        let rows = state.rows.filter((row) => {
          if (q && !rowSearchText(row).includes(q)) return false;
          if (team !== 'all' && cleanText(row.team || 'Sin equipo') !== team) return false;
          if (sr !== 'all' && cleanText(row.srClass || '--') !== sr) return false;
          if (gsr !== 'all' && cleanText(row.gsrClass || '--') !== gsr) return false;
          if (car !== 'all' && cleanText(row.favoriteCar) !== car) return false;
          if (track !== 'all' && cleanText(row.favoriteTrack) !== track) return false;
          if (active === 'active' && asNumber(row.active30dLaps) <= 0) return false;
          if (active === 'inactive' && asNumber(row.active30dLaps) > 0) return false;
          return true;
        });
        rows.sort(compareRows);
        state.filtered = rows;
        const loaded = state.rows.length;
        const visible = state.filtered.length;
        $('p2Loaded').textContent = fmtNumber(loaded);
        $('p2Visible').textContent = fmtNumber(visible);
        $('p2Hint').textContent = `${fmtNumber(visible)} visibles · ${fmtNumber(loaded)} cargados`;
        renderTable();
      }

      function compareRows(a,b) {
        const dir = state.sortDir === 'asc' ? 1 : -1;
        const sort = state.sort;
        let va, vb;
        if (sort === 'name') { va=cleanText(a.name); vb=cleanText(b.name); return va.localeCompare(vb,'es') * (state.sortDir === 'asc' ? 1 : -1); }
        if (sort === 'team') { va=cleanText(a.team); vb=cleanText(b.team); return va.localeCompare(vb,'es') * (state.sortDir === 'asc' ? 1 : -1); }
        if (sort === 'country') { va=countryCode(a); vb=countryCode(b); return va.localeCompare(vb,'es') * (state.sortDir === 'asc' ? 1 : -1); }
        if (sort === 'active') { va=asNumber(a.active30dLaps); vb=asNumber(b.active30dLaps); }
        else if (sort === 'valid') { va=asNumber(a.validLaps); vb=asNumber(b.validLaps); }
        else if (sort === 'clean') { va=asNumber(a.cleanRate); vb=asNumber(b.cleanRate); }
        else if (sort === 'speed') { va=asNumber(a.maxSpeedKmh); vb=asNumber(b.maxSpeedKmh); }
        else { va=asNumber(a.totalLaps); vb=asNumber(b.totalLaps); }
        return (va-vb) * dir;
      }

      function renderMetrics(stats = {}) {
        $('p2MetricPilots').textContent = fmtNumber(stats.pilotsCount ?? state.rows.length);
        $('p2MetricActive').textContent = fmtNumber(stats.activePilots30d ?? state.rows.filter((row)=>asNumber(row.active30dLaps)>0).length);
        $('p2MetricLaps').textContent = fmtNumber(stats.totalLaps ?? state.rows.reduce((sum,row)=>sum+asNumber(row.totalLaps),0));
        $('p2MetricCars').textContent = fmtNumber(stats.carsCount ?? 0);
        $('p2MetricTracks').textContent = fmtNumber(stats.tracksCount ?? 0);
        $('p2MetricBest').textContent = stats.fastestLap?.maxSpeedKmh ? `${Math.round(stats.fastestLap.maxSpeedKmh)} km/h` : '--';
      }

      function renderTable() {
        const size = Number($('p2PageSize')?.value || 25);
        const totalPages = Math.max(1, Math.ceil(state.filtered.length / size));
        state.page = Math.min(Math.max(1, state.page), totalPages);
        const start = (state.page - 1) * size;
        const rows = state.filtered.slice(start, start + size);
        $('p2PageInfo').textContent = `Página ${state.page}/${totalPages}`;
        $('p2Prev').disabled = state.page <= 1;
        $('p2Next').disabled = state.page >= totalPages;
        $('p2Rows').innerHTML = rows.length ? rows.map((row, i) => {
          const rank = start + i + 1;
          const last = row.lastLap || {};
          const avatar = row.avatarUrl || '/images/pilot-avatar-default.png';
          return `<tr>
            <td>${rank}</td>
            <td><img class="gc-pilotos2-avatar" src="${escapeHtml(avatar)}" alt="Avatar ${escapeHtml(row.name)}" loading="lazy" onerror="this.src='/images/pilot-avatar-default.png'"></td>
            <td><span class="gc-pilotos2-pilot"><strong>${escapeHtml(cleanText(row.name,'Piloto'))}</strong><span class="gc-pilotos2-muted">ID ${escapeHtml(row.playerId || row.id || '--')}</span></span></td>
            <td>${countryMarkup(row)}</td>
            <td>${row.teamLogoUrl ? `<img class="gc-pilotos2-team-logo" src="${escapeHtml(row.teamLogoUrl)}" alt="" loading="lazy" onerror="this.style.display='none'">` : ''}${escapeHtml(cleanText(row.team,'Sin equipo'))}</td>
            <td>${ratingScoreBadge('sr', row.srClass || '--', row.srScore)}</td>
            <td>${ratingScoreBadge('gsr', row.gsrClass || '--', row.gsrScore)}</td>
            <td>${escapeHtml(fmtNumber(row.totalLaps))}</td>
            <td>${escapeHtml(fmtNumber(row.carsCount))}</td>
            <td>${escapeHtml(fmtNumber(row.tracksCount))}</td>
            <td>${escapeHtml(fmtNumber(row.totalHours))}</td>
            <td>${row.maxSpeedKmh ? `${Math.round(row.maxSpeedKmh)} km/h` : '--'}</td>
            <td>${escapeHtml(cleanText(row.favoriteCar,'--'))}<span class="gc-pilotos2-muted">estimado por uso</span></td>
            <td>${escapeHtml(cleanText(row.favoriteTrack,'--'))}<span class="gc-pilotos2-muted">estimado por uso</span></td>
            <td>${escapeHtml(dateText(rowTimestamp(row)))}<span class="gc-pilotos2-muted">${escapeHtml(cleanText(last.carName,''))}</span></td>
          </tr>`;
        }).join('') : '<tr><td class="gc-pilotos2-state" colspan="15">Sin pilotos para los filtros seleccionados.</td></tr>';
      }

      async function loadPilots() {
        $('p2Hint').textContent = 'Cargando pilotos...';
        try {
          const response = await fetch('/api/gc/pilots2?limit=all', { credentials:'same-origin' });
          const payload = await response.json();
          const rows = payload.items || payload.pilots || payload.data?.items || [];
          state.rows = await enrichRowsWithRatings(Array.isArray(rows) ? rows : []);
          $('p2Source').textContent = payload.source || payload.mode || '--';
          $('p2Updated').textContent = dateText(payload.generatedAt || Date.now());
          renderMetrics(payload.data?.stats || {});
          updateFilters();
          state.page = 1;
          applyFilters();
        } catch (error) {
          console.error('[pilotos2]', error);
          $('p2Hint').textContent = 'No se pudieron cargar pilotos.';
          $('p2Rows').innerHTML = '<tr><td class="gc-pilotos2-state" colspan="15">Error cargando pilotos.</td></tr>';
        }
      }

      ['p2Search','p2Team','p2Sr','p2Gsr','p2State','p2Car','p2Track','p2Sort','p2PageSize'].forEach((id)=>$(id)?.addEventListener('input',()=>{state.page=1;applyFilters();}));
      $('p2Prev')?.addEventListener('click',()=>{state.page-=1;renderTable();});
      $('p2Next')?.addEventListener('click',()=>{state.page+=1;renderTable();});
      $('p2Reload')?.addEventListener('click',loadPilots);
      $('p2Clear')?.addEventListener('click',()=>{['p2Search'].forEach((id)=>$(id).value='');['p2Team','p2Sr','p2Gsr','p2State','p2Car','p2Track'].forEach((id)=>$(id).value='all');$('p2Sort').value='laps';state.page=1;applyFilters();});
      document.querySelectorAll('.gc-pilotos2-table th[data-sort]').forEach((th)=>th.addEventListener('click',()=>{const sort=th.getAttribute('data-sort'); const map={rank:'laps',driver:'name',name:'name',team:'team',sr:'clean',gsr:'clean',best:'best',laps:'laps',valid:'valid',speed:'speed'}; const next=map[sort]||sort; if(state.sort===next) state.sortDir=state.sortDir==='asc'?'desc':'asc'; else {state.sort=next; state.sortDir=next==='best'?'asc':'desc';} const select=$('p2Sort'); if(select && [...select.options].some((o)=>o.value===next)) select.value=next; applyFilters();}));
      loadPilots();
    })();
  </script>
</AppLayout>
