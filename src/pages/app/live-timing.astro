---
import AppLayout from '../../layouts/AppLayout.astro';

const pageTitle = 'Live Timing | GrassCutters Racing';
---
<AppLayout
  title={pageTitle}
  description="Live Timing de GrassCutters Racing con datos directos de ACSM."
  canonicalPath="/app/live-timing"
  noindex={true}
>
  <div class="gc-live-timing-v1">
    <style>

      .gc-live-timing-v1{
        color-scheme:dark;
        --bg:#050707;
        --panel:rgba(8,16,11,.92);
        --panel-2:rgba(12,23,15,.92);
        --line:rgba(181,255,152,.16);
        --line-strong:rgba(181,255,152,.30);
        --text:#f4fff0;
        --muted:#a8beab;
        --dim:#6f8573;
        --accent:#9bff3d;
        --accent-2:#48d8ff;
        --danger:#ff687d;
        --shadow:0 22px 80px rgba(0,0,0,.38);
        font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        color:var(--text);
        position:relative;
        isolation:isolate;
      }

      .gc-live-timing-v1,
      .gc-live-timing-v1 *{box-sizing:border-box}
      .gc-live-timing-v1 a{color:inherit;text-decoration:none}
      .gc-live-timing-v1 button{font:inherit}

      .page{
        width:100%;
        margin:0;
        padding:0;
        display:grid;
        gap:16px;
        grid-template-columns:1fr;
      }

      .hero,
      .panel,
      .map-panel{
        position:relative;
        border:1px solid var(--line);
        border-radius:22px;
        background:linear-gradient(180deg, rgba(255,255,255,.03), transparent 24%), var(--panel);
        box-shadow:var(--shadow);
      }

      .hero{
        padding:clamp(18px,2.6vw,28px);
        overflow:hidden;
      }

      .eyebrow{
        margin:0 0 10px;
        color:var(--accent);
        text-transform:uppercase;
        letter-spacing:.18em;
        font-size:.72rem;
        font-weight:900;
      }

      h1{
        margin:0;
        font-size:clamp(2.4rem,5vw,5.6rem);
        line-height:.88;
        letter-spacing:-.075em;
        text-transform:uppercase;
      }

      .subtitle{
        max-width:80ch;
        margin:14px 0 0;
        color:var(--muted);
        font-size:1rem;
        line-height:1.55;
      }

      .hero-grid{
        margin-top:18px;
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        gap:12px;
      }

      .hero-stat{
        padding:14px 15px;
        border:1px solid var(--line);
        border-radius:16px;
        background:rgba(255,255,255,.02);
        min-width:0;
      }

      .hero-stat span{
        display:block;
        margin-bottom:7px;
        color:var(--dim);
        text-transform:uppercase;
        letter-spacing:.12em;
        font-size:.68rem;
        font-weight:900;
      }

      .hero-stat strong{
        display:block;
        font-size:clamp(1rem,1.9vw,1.6rem);
        line-height:1.1;
        letter-spacing:-.04em;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
      }

      .hero-stat small{
        display:block;
        margin-top:5px;
        color:var(--muted);
      }

      .status-row{
        margin-top:16px;
        display:flex;
        flex-wrap:wrap;
        gap:8px;
        align-items:center;
      }

      .chip{
        display:inline-flex;
        align-items:center;
        min-height:32px;
        padding:0 12px;
        border:1px solid var(--line);
        border-radius:999px;
        background:rgba(255,255,255,.02);
        color:var(--muted);
        font-size:.76rem;
        text-transform:uppercase;
        letter-spacing:.1em;
        font-weight:850;
      }

      .chip.is-accent{
        border-color:rgba(155,255,61,.34);
        color:var(--accent);
      }

      .chip.is-danger{
        border-color:rgba(255,104,125,.35);
        color:var(--danger);
      }

      .map-panel{
        display:grid;
        align-content:start;
        padding:16px;
        gap:14px;
        min-height:0;
        width:100%;
      }

      .panel{
        padding:16px;
        min-width:0;
        width:100%;
      }

      .panel-head{
        display:flex;
        justify-content:space-between;
        align-items:flex-end;
        gap:12px;
        margin-bottom:14px;
        padding-bottom:12px;
        border-bottom:1px solid var(--line);
      }

      .panel-head h2{
        margin:0;
        font-size:1.1rem;
        letter-spacing:-.03em;
        text-transform:uppercase;
      }

      .panel-head p{
        margin:6px 0 0;
        color:var(--dim);
        font-size:.88rem;
      }

      .panel-head .meta{
        color:var(--dim);
        font-size:.78rem;
        text-transform:uppercase;
        letter-spacing:.1em;
        font-weight:850;
      }

      .table-wrap{
        width:100%;
        overflow-x:auto;
        overflow-y:visible;
        border:1px solid var(--line);
        border-radius:16px;
        background:rgba(255,255,255,.018);
      }

      .live-table{
        width:100%;
        min-width:0;
        border-collapse:collapse;
        table-layout:auto;
      }

      .live-table th,
      .live-table td{
        white-space:nowrap;
        padding:.58rem .62rem;
        border-bottom:1px solid rgba(255,255,255,.06);
        text-align:left;
        vertical-align:middle;
      }

      .live-table th{
        position:sticky;
        top:0;
        z-index:1;
        background:rgba(10,18,12,.98);
        color:var(--dim);
        text-transform:uppercase;
        letter-spacing:.1em;
        font-size:.7rem;
      }

      .live-table td{
        color:var(--muted);
        font-size:.88rem;
      }

      .live-table td strong{
        color:var(--text);
      }

      tbody tr:hover td{
        background:rgba(255,255,255,.03);
      }

      .live-map-frame{
        position:relative;
        width:100%;
        min-height:300px;
        max-height:520px;
        aspect-ratio:21 / 9;
        height:auto;
        border:1px solid var(--line);
        border-radius:18px;
        display:flex;
        align-items:center;
        justify-content:center;
        overflow:hidden;
        padding:18px;
        background:linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.01));
      }

      .live-map-image{
        display:block;
        width:auto !important;
        height:auto !important;
        max-width:86% !important;
        max-height:86% !important;
        object-fit:scale-down;
        object-position:center;
        flex:0 0 auto;
      }

      .map-placeholder{
        display:flex;
        align-items:center;
        justify-content:center;
        width:100%;
        height:100%;
        color:var(--dim);
        text-transform:uppercase;
        letter-spacing:.12em;
        font-size:.78rem;
        font-weight:850;
        padding:22px;
        text-align:center;
      }

      .split-list{
        display:flex;
        flex-wrap:wrap;
        gap:6px;
      }

      .split-pill{
        display:inline-flex;
        align-items:center;
        min-height:24px;
        padding:0 8px;
        border-radius:999px;
        border:1px solid rgba(155,255,61,.18);
        background:rgba(155,255,61,.06);
        color:var(--text);
        font-size:.74rem;
        font-variant-numeric:tabular-nums;
      }

      .subtle{
        color:var(--dim);
      }

      .live-pit-badge{
        display:inline-flex;
        align-items:center;
        min-height:22px;
        padding:0 7px;
        margin-left:6px;
        border:1px solid rgba(255,104,125,.36);
        border-radius:999px;
        color:var(--danger);
        font-size:.68rem;
        font-weight:900;
        text-transform:uppercase;
        letter-spacing:.1em;
      }

      .message{
        min-height:24px;
        margin:0;
        color:var(--dim);
        font-size:.92rem;
      }

      .message.is-error{ color:var(--danger); }

      .loading{
        display:inline-flex;
        align-items:center;
        gap:8px;
      }

      .dot{
        width:8px;
        height:8px;
        border-radius:999px;
        background:var(--accent);
        box-shadow:0 0 18px rgba(155,255,61,.55);
      }

      .page.is-loading .dot{
        animation:pulse 1.1s ease-in-out infinite;
      }

      @keyframes pulse{
        0%,100%{ transform:scale(.78); opacity:.45; }
        50%{ transform:scale(1.1); opacity:1; }
      }


      @media (min-width: 721px){
        .live-table th:nth-child(1), .live-table td:nth-child(1){ width:44px; }
        .live-table th:nth-child(3), .live-table td:nth-child(3){ max-width:260px; overflow:hidden; text-overflow:ellipsis; }
        .live-table th:nth-child(4), .live-table td:nth-child(4){ width:70px; }
        .live-table th:nth-child(8), .live-table td:nth-child(8),
        .live-table th:nth-child(9), .live-table td:nth-child(9),
        .live-table th:nth-child(10), .live-table td:nth-child(10){ width:82px; }
      }

      @media (max-width: 1100px){
        .page{
          grid-template-columns:1fr;
        }
        .hero-grid{ grid-template-columns:repeat(2,minmax(0,1fr)); }
        .live-table{ min-width:780px; }
      }

      @media (max-width: 720px){
        .page{ width:100%; padding-top:0; }
        .hero-grid{ grid-template-columns:1fr; }
        .panel-head{ align-items:flex-start; flex-direction:column; }
        .live-map-frame{ aspect-ratio:4 / 3; min-height:240px; padding:10px; }
        .live-map-image{ max-width:92% !important; max-height:92% !important; }
        .live-table{ min-width:780px; }
      }
    
    </style>
    <main class="page is-loading" id="page">
      <section class="hero">
        <p class="eyebrow">ACSM Live Timing</p>
        <h1>Live Timing</h1>
        <p class="subtitle">
          Página de prueba independiente para leer directamente el leaderboard de ACSM, sin guardar datos y sin usar race control ni WebSocket.
        </p>

        <div class="hero-grid" aria-label="Resumen de sesión">
          <div class="hero-stat">
            <span>Servidor</span>
            <strong id="serverName">-</strong>
            <small id="sessionName">-</small>
          </div>
          <div class="hero-stat">
            <span>Track</span>
            <strong id="trackName">-</strong>
            <small id="layoutName">-</small>
          </div>
          <div class="hero-stat">
            <span>Tiempo restante</span>
            <strong id="remainingTime">-</strong>
            <small id="sessionTime">-</small>
          </div>
          <div class="hero-stat">
            <span>Clima</span>
            <strong id="weatherValue">-</strong>
            <small id="weatherDetail">-</small>
          </div>
        </div>

        <div class="status-row">
          <span class="chip is-accent" id="stateChip">Loading</span>
          <span class="chip" id="ambientChip">Ambiente -</span>
          <span class="chip" id="roadChip">Pista -</span>
          <span class="chip" id="updatedChip">Actualizado -</span>
        </div>
        <p class="message" id="messageLine"></p>
      </section>

      <p class="map-note">Mapa retirado en v1: ACSM no expone posiciones transformadas para un mapa live fiable.</p>

      <section class="panel live-panel">
        <div class="panel-head">
          <div>
            <h2>Live Drivers</h2>
            <p>Conductores conectados en ACSM.</p>
          </div>
          <span class="meta" id="liveCount">0 drivers</span>
        </div>
        <div class="table-wrap">
          <table class="live-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Driver</th>
                <th>Car</th>
                <th>Tyres</th>
                <th>Current/Last Lap</th>
                <th>Best Lap</th>
                <th>Gap/Split</th>
                <th>Laps</th>
                <th>Pits</th>
                <th>Ping</th>
              </tr>
            </thead>
            <tbody id="liveBody">
              <tr><td colspan="10">Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel stored-panel">
        <div class="panel-head">
          <div>
            <h2>Stored Times</h2>
            <p>Conductores desconectados con sus mejores referencias.</p>
          </div>
          <span class="meta" id="storedCount">0 drivers</span>
        </div>
        <div class="table-wrap">
          <table class="live-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Driver</th>
                <th>Car</th>
                <th>Tyres</th>
                <th>Best Lap</th>
                <th>S1</th>
                <th>S2</th>
                <th>S3</th>
                <th>Laps</th>
                <th>Top Speed</th>
              </tr>
            </thead>
            <tbody id="storedBody">
              <tr><td colspan="10">Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <script is:inline>
      (() => {
        const page = document.getElementById('page');
        const stateChip = document.getElementById('stateChip');
        const messageLine = document.getElementById('messageLine');
        const els = {
          serverName: document.getElementById('serverName'),
          sessionName: document.getElementById('sessionName'),
          trackName: document.getElementById('trackName'),
          layoutName: document.getElementById('layoutName'),
          remainingTime: document.getElementById('remainingTime'),
          sessionTime: document.getElementById('sessionTime'),
          weatherValue: document.getElementById('weatherValue'),
          weatherDetail: document.getElementById('weatherDetail'),
          ambientChip: document.getElementById('ambientChip'),
          roadChip: document.getElementById('roadChip'),
          updatedChip: document.getElementById('updatedChip'),
          liveCount: document.getElementById('liveCount'),
          storedCount: document.getElementById('storedCount'),
          liveBody: document.getElementById('liveBody'),
          storedBody: document.getElementById('storedBody')
        };

        const text = (node, value, fallback = '-') => {
          if (node) node.textContent = value === undefined || value === null || value === '' ? fallback : String(value);
        };

        const pretty = (value) => String(value ?? '-').replace(/_/g, ' ').replace(/\s+/g, ' ').trim() || '-';

        const formatDuration = (rawMs) => {
          const total = Math.max(0, Math.floor(Number(rawMs) || 0));
          const days = Math.floor(total / 86400000);
          const hours = Math.floor((total % 86400000) / 3600000);
          const minutes = Math.floor((total % 3600000) / 60000);
          const seconds = Math.floor((total % 60000) / 1000);
          const parts = [];
          if (days > 0) parts.push(`${days}d`);
          if (days > 0 || hours > 0) parts.push(`${hours}h`);
          parts.push(`${String(minutes).padStart(2, '0')}m`);
          parts.push(`${String(seconds).padStart(2, '0')}s`);
          return parts.join(' ');
        };

        const formatSpeed = (value) => {
          const parsed = Number(value);
          if (!Number.isFinite(parsed) || parsed <= 0) return '-';
          return `${parsed.toFixed(0)} km/h`;
        };


        const safeLapDisplay = (value) => {
          const raw = String(value ?? '-');
          if (!raw || raw === '-' || raw.includes('/') || raw.includes(',')) return '-';
          return raw;
        };

        const formatLastSeen = (value) => {
          if (!value) return '-';
          const parsed = Date.parse(String(value));
          if (!Number.isFinite(parsed)) return String(value);
          return new Date(parsed).toLocaleString('es-ES', {
            day: '2-digit',
            month: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
          });
        };

        const splitPills = (splits) => {
          if (!Array.isArray(splits) || !splits.length) return '<span class="subtle">-</span>';
          return `<div class="split-list">${splits
            .slice(0, 3)
            .map((split) => `<span class="split-pill">${String(split?.splitTimeFormatted ?? '-') }</span>`)
            .join('')}</div>`;
        };

        const rowsToHtml = (rows, kind) => {
          if (!rows.length) return `<tr><td colspan="${kind === 'live' ? 10 : 10}">Sin datos.</td></tr>`;

          return rows.map((row, index) => {
            const splitCells = kind === 'live'
              ? [
                  `<td><strong>${escapeHtml(row.bestLapFormatted || '-')}</strong></td>`,
                  `<td>${escapeHtml(row.split ?? '-')}</td>`
                ]
              : [
                  `<td><strong>${escapeHtml(row.bestLapFormatted || '-')}</strong></td>`,
                  `<td>${splitPills(row.bestSplits?.slice?.(0, 1) || row.bestSplits)}</td>`,
                  `<td>${splitPills((row.bestSplits || []).slice?.(1, 2) || [])}</td>`,
                  `<td>${splitPills((row.bestSplits || []).slice?.(2, 3) || [])}</td>`
                ];

            return kind === 'live'
              ? `<tr>
                  <td>${escapeHtml(String(row.position ?? index + 1))}</td>
                  <td><strong>${escapeHtml(row.driverName || '-')}</strong>${row.isInPits ? '<span class="live-pit-badge">PIT</span>' : ''}<div class="subtle">${escapeHtml(row.driverInitials || '')}</div></td>
                  <td>${escapeHtml(row.carName || row.carModel || '-')}</td>
                  <td>${escapeHtml(row.tyres || '-')}</td>
                  <td><strong>${escapeHtml(safeLapDisplay(row.lastLapFormatted))}</strong></td>
                  ${splitCells[0]}
                  ${splitCells[1]}
                  <td>${escapeHtml(String(row.laps ?? '-'))}</td>
                  <td>${escapeHtml(String(row.numPits ?? '-'))}${row.isInPits ? ' <span class="live-pit-badge">PIT</span>' : ''}</td>
                  <td>${escapeHtml(String(row.ping ?? '-'))}</td>
                </tr>`
              : `<tr>
                  <td>${escapeHtml(String(row.position ?? index + 1))}</td>
                  <td><strong>${escapeHtml(row.driverName || '-')}</strong><div class="subtle">${escapeHtml(row.driverInitials || '')}</div></td>
                  <td>${escapeHtml(row.carName || row.carModel || '-')}</td>
                  <td>${escapeHtml(row.tyres || '-')}</td>
                  ${splitCells[0]}
                  <td>${splitPills(row.bestSplits?.slice?.(0, 1) || row.bestSplits)}</td>
                  <td>${splitPills((row.bestSplits || []).slice?.(1, 2) || [])}</td>
                  <td>${splitPills((row.bestSplits || []).slice?.(2, 3) || [])}</td>
                  <td>${escapeHtml(String(row.laps ?? '-'))}</td>
                  <td>${escapeHtml(formatSpeed(row.topSpeedBestLap ?? row.topSpeedThisLap))}</td>
                </tr>`;
          }).join('');
        };

        const escapeHtml = (value) => String(value ?? '-').replace(/[&<>'"]/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[char]));

        const render = (payload) => {
          const server = payload?.server ?? {};
          const connectedDrivers = Array.isArray(payload?.connectedDrivers) ? payload.connectedDrivers : [];
          const storedTimes = Array.isArray(payload?.storedTimes) ? payload.storedTimes : [];

          text(els.serverName, server.name || '-');
          text(els.sessionName, server.sessionName ? `Sesión ${server.sessionName}` : '-');
          text(els.trackName, pretty(server.track));
          text(els.layoutName, server.trackConfig ? `Layout ${pretty(server.trackConfig)}` : 'Sin layout');
          text(els.weatherValue, server.weatherGraphics ? pretty(server.weatherGraphics) : '-');
          text(els.weatherDetail, `${server.ambientTemp ?? '-'} °C ambiente · ${server.roadTemp ?? '-'} °C pista`);
          text(els.ambientChip, `Ambiente ${server.ambientTemp ?? '-'} °C`);
          text(els.roadChip, `Pista ${server.roadTemp ?? '-'} °C`);
          text(els.updatedChip, payload.updatedAt ? `Actualizado ${formatLastSeen(payload.updatedAt)}` : 'Actualizado -');

          const remainingMs = Number(server.time) > 0 && Number(server.elapsedMilliseconds) >= 0
            ? Math.max(0, Number(server.time) * 60000 - Number(server.elapsedMilliseconds))
            : null;
          text(els.remainingTime, remainingMs === null ? '-' : formatDuration(remainingMs));
          text(els.sessionTime, server.time !== null && server.time !== undefined ? `${server.time} min total` : '-');

          text(els.liveCount, `${connectedDrivers.length} drivers`);
          text(els.storedCount, `${storedTimes.length} drivers`);

          els.liveBody.innerHTML = rowsToHtml(connectedDrivers, 'live');
          els.storedBody.innerHTML = rowsToHtml(storedTimes, 'stored');

          page.classList.remove('is-loading');
          stateChip.textContent = 'Live';
          stateChip.className = 'chip is-accent';
          messageLine.textContent = 'Datos cargados desde ACSM.';
          messageLine.className = 'message';
        };

        const setError = (message) => {
          page.classList.remove('is-loading');
          stateChip.textContent = 'Error';
          stateChip.className = 'chip is-danger';
          messageLine.textContent = message || 'No se pudo cargar ACSM.';
          messageLine.className = 'message is-error';
          els.liveBody.innerHTML = '<tr><td colspan="10">Sin datos.</td></tr>';
          els.storedBody.innerHTML = '<tr><td colspan="10">Sin datos.</td></tr>';
        };

        async function fetchLiveTiming() {
          try {
            const response = await fetch('/api/live-timing', { cache: 'no-store' });
            const payload = await response.json().catch(() => null);
            if (!response.ok || !payload || payload.ok !== true) {
              throw new Error(payload?.error || 'ACSM unavailable');
            }
            render(payload);
          } catch (error) {
            setError(error?.message || 'ACSM unavailable');
          }
        }

        fetchLiveTiming();
        window.setInterval(fetchLiveTiming, 5000);
      })();
    </script>

  </div>
</AppLayout>
