---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import '../styles/public/gc-rating-badges.css';

const title = 'Perfil piloto 2 | GrassCutters Racing';
const description = 'Laboratorio de perfil de piloto GrassCutters Racing con identidad, equipo, ratings y datos de pista.';
---

<MarketingLayout
  title={title}
  description={description}
  bodyClass="gc-page-profile2"
  canonicalPath="/perfil2"
  noindex={true}
>
  <main class="gc-profile2 gc-public-shell" data-profile2-page>
    <section class="gc-profile2-hero" aria-labelledby="profile2Name">
      <div class="gc-profile2-hero__bg" aria-hidden="true"></div>
      <div class="gc-profile2-hero__copy">
        <p class="gc-profile2-eyebrow">GrassCutters Driver Data</p>
        <h1 id="profile2Name">Cargando perfil</h1>
        <p id="profile2Lead">Leyendo datos de cuenta, piloto, ratings y equipo.</p>

        <div class="gc-profile2-statusline" id="profile2Badges" aria-label="Estado del perfil">
          <span class="gc-profile2-badge gc-profile2-badge--live">Cuenta</span>
          <span class="gc-profile2-badge">Piloto</span>
          <span class="gc-profile2-badge">Equipo</span>
        </div>


        <div class="gc-profile2-actions gc-profile2-actions--hero">
          <a class="gc-profile2-btn gc-profile2-btn--primary" id="profile2PublicLink" href="/pilotos" hidden>Perfil público <span aria-hidden="true">→</span></a>
          <a class="gc-profile2-btn gc-profile2-btn--ghost" href="/hotlaps">Ver hotlaps <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class="gc-profile2-driver-card" aria-label="Ficha rápida del piloto">
        <div class="gc-profile2-driver-card__avatar">
          <img id="profile2Avatar" class="gc-profile2-avatar" src="/images/pilot-avatar-default.png" alt="Avatar del piloto" loading="lazy" decoding="async" />
          <span aria-hidden="true"></span>
        </div>

        <div class="gc-profile2-driver-card__ratings" id="profile2RatingBadges" aria-label="Ratings del piloto">
          <span class="gc-profile2-rating-group">
            <span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-unknown gc-rating-badge--compact"><span class="gc-rating-badge__type">--</span><strong>--</strong></span>
            <span class="gc-rating-badge gc-rating-badge--sr gc-rating-badge--sr-unknown gc-rating-badge--compact gc-rating-badge--rating-label"><strong>--</strong></span>
          </span>
          <span class="gc-profile2-rating-group">
            <span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-unknown gc-rating-badge--compact"><span class="gc-rating-badge__type">--</span><strong>--</strong></span>
            <span class="gc-rating-badge gc-rating-badge--gsr gc-rating-badge--gsr-unknown gc-rating-badge--compact gc-rating-badge--rating-label"><strong>--</strong></span>
          </span>
        </div>

        <div class="gc-profile2-driver-card__content">
          <div class="gc-profile2-team-lockup">
            <img id="profile2TeamLogo" src="/images/team-default-gc.svg" alt="Logo del equipo" loading="lazy" decoding="async" />
            <div>
              <strong id="profile2TeamName">Sin equipo</strong>
              <small id="profile2TeamRole">Añade tu escudería</small>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <section class="gc-profile2-pulse" aria-label="Driver Pulse">
      <div class="gc-profile2-pulse__title">
        <span class="gc-profile2-live-dot" aria-hidden="true"></span>
        <strong>Driver Pulse</strong>
      </div>
      <dl class="gc-profile2-pulse__track">
        <div>
          <dt>Vueltas</dt>
          <dd id="profile2TotalLaps">--</dd>
        </div>
        <div>
          <dt>Mejor lap</dt>
          <dd id="profile2BestLap">--</dd>
        </div>
        <div>
          <dt>Limpieza</dt>
          <dd id="profile2CleanRate">--</dd>
        </div>
        <div>
          <dt>Vmax</dt>
          <dd id="profile2MaxSpeed">--</dd>
        </div>
        <div>
          <dt>Última vuelta</dt>
          <dd id="profile2LastLap">--</dd>
        </div>
      </dl>
    </section>

    <nav class="gc-profile2-tabs" aria-label="Secciones del perfil">
      <button class="gc-profile2-tab is-active" type="button" data-profile2-tab="summary">Resumen</button>
      <button class="gc-profile2-tab" type="button" data-profile2-tab="hotlaps">Hotlaps</button>
      <button class="gc-profile2-tab" type="button" data-profile2-tab="team">Escudería</button>
      <button class="gc-profile2-tab" type="button" data-profile2-tab="account">Cuenta</button>
    </nav>

    <section class="gc-profile2-content">
      <section class="gc-profile2-panel is-active" data-profile2-panel="summary">
        <div class="gc-profile2-dashboard">
          <article class="gc-profile2-board gc-profile2-board--racecraft">
            <header class="gc-profile2-board__head">
              <div>
                <p class="gc-profile2-panel__eyebrow">Racecraft</p>
                <h2>Seguridad y control</h2>
              </div>
            </header>
            <div class="gc-profile2-data-list" id="profile2RacecraftRows">
              <div><span>Estado</span><strong>Cargando</strong></div>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--pace">
            <header class="gc-profile2-board__head">
              <div>
                <p class="gc-profile2-panel__eyebrow">Pace</p>
                <h2>Ritmo competitivo</h2>
              </div>
            </header>
            <div class="gc-profile2-data-list" id="profile2PaceRows">
              <div><span>Estado</span><strong>Cargando</strong></div>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--activity">
            <header class="gc-profile2-board__head gc-profile2-board__head--row">
              <div>
                <p class="gc-profile2-panel__eyebrow">Actividad reciente</p>
                <h2>Últimas vueltas</h2>
              </div>
              <a class="gc-profile2-link" href="/hotlaps">Ver todas →</a>
            </header>
            <div class="gc-profile2-activity" id="profile2ActivityList">
              <p>Cargando actividad...</p>
            </div>
          </article>

          <article class="gc-profile2-board gc-profile2-board--team">
            <header class="gc-profile2-board__head">
              <div>
                <p class="gc-profile2-panel__eyebrow">Escudería</p>
                <h2 id="profile2TeamSummaryTitle">Equipo actual</h2>
              </div>
            </header>
            <p id="profile2TeamSummaryText" class="gc-profile2-muted">Cargando equipo...</p>
            <div class="gc-profile2-team-mini">
              <img id="profile2TeamLogoMini" src="/images/team-default-gc.svg" alt="Logo del equipo" loading="lazy" decoding="async" />
              <div>
                <strong id="profile2TeamNameMini">Sin equipo</strong>
                <small id="profile2TeamRoleMini">Pendiente</small>
              </div>
            </div>
            <button class="gc-profile2-btn gc-profile2-btn--ghost gc-profile2-btn--wide" type="button" data-profile2-tab-jump="team">Editar escudería</button>
          </article>
        </div>
      </section>

      <section class="gc-profile2-panel" data-profile2-panel="hotlaps" hidden>
        <article class="gc-profile2-board gc-profile2-board--table">
          <header class="gc-profile2-board__head gc-profile2-board__head--row">
            <div>
              <p class="gc-profile2-panel__eyebrow">Hotlaps destacadas</p>
              <h2>Mejores combos del piloto</h2>
            </div>
            <a class="gc-profile2-link" href="/hotlaps">Ver Hotlaps →</a>
          </header>
          <div class="gc-profile2-table-wrap">
            <table class="gc-profile2-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Coche</th>
                  <th>Circuito</th>
                  <th>Tiempo</th>
                  <th>Pos</th>
                  <th>Limpieza</th>
                </tr>
              </thead>
              <tbody id="profile2HotlapsBody">
                <tr><td colspan="6">Cargando hotlaps...</td></tr>
              </tbody>
            </table>
          </div>
        </article>
      </section>

      <section class="gc-profile2-panel" data-profile2-panel="team" hidden>
        <div class="gc-profile2-dashboard gc-profile2-dashboard--team-editor">
          <article class="gc-profile2-board gc-profile2-board--editor">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Escudería</p>
              <h2>Identidad de equipo</h2>
              <p class="gc-profile2-muted">Dato base para futuras clasificaciones por equipos.</p>
            </header>

            <label class="gc-profile2-field">
              <span>Nombre del equipo</span>
              <input id="profile2TeamNameInput" type="text" maxlength="80" autocomplete="organization" placeholder="GrassCutters Racing Team" />
            </label>
            <label class="gc-profile2-field">
              <span>Logo del equipo</span>
              <input id="profile2TeamLogoInput" type="url" maxlength="500" placeholder="https://... o /images/logo.png" />
            </label>
            <label class="gc-profile2-field">
              <span>Rol</span>
              <input id="profile2TeamRoleInput" type="text" maxlength="60" placeholder="Piloto" />
            </label>

            <div class="gc-profile2-actions">
              <button class="gc-profile2-btn gc-profile2-btn--primary" id="profile2SaveTeam" type="button">Guardar equipo</button>
              <button class="gc-profile2-btn gc-profile2-btn--ghost" id="profile2ClearTeam" type="button">Quitar equipo</button>
            </div>
            <p class="gc-profile2-message" id="profile2TeamMessage" aria-live="polite"></p>
          </article>

          <article class="gc-profile2-board gc-profile2-board--preview">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Preview</p>
              <h2>Ficha de escudería</h2>
            </header>
            <div class="gc-profile2-team-plate">
              <img id="profile2TeamLogoPreview" src="/images/team-default-gc.svg" alt="Logo preview del equipo" loading="lazy" decoding="async" />
              <div>
                <strong id="profile2TeamNamePreview">Sin equipo</strong>
                <small id="profile2TeamRolePreview">Piloto</small>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="gc-profile2-panel" data-profile2-panel="account" hidden>
        <div class="gc-profile2-dashboard gc-profile2-dashboard--account">
          <article class="gc-profile2-board">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Cuenta</p>
              <h2>Licencia de piloto</h2>
            </header>
            <div class="gc-profile2-data-list" id="profile2AccountRows">
              <div><span>Estado</span><strong>Cargando</strong></div>
            </div>
          </article>

          <article class="gc-profile2-board">
            <header class="gc-profile2-board__head">
              <p class="gc-profile2-panel__eyebrow">Ajustes</p>
              <h2>Gestión avanzada</h2>
              <p class="gc-profile2-muted">Las acciones sensibles siguen en el perfil actual hasta sustituir esta versión.</p>
            </header>
            <div class="gc-profile2-actions gc-profile2-actions--stack">
              <a class="gc-profile2-btn gc-profile2-btn--primary" href="/perfil">Abrir perfil actual</a>
              <a class="gc-profile2-btn gc-profile2-btn--ghost" href="/login">Cambiar cuenta</a>
            </div>
          </article>
        </div>
      </section>
    </section>
  </main>

  <style is:global>
    html[data-gc-scope="marketing"] body.gc-page-profile2 {
      background:
        radial-gradient(circle at 18% 0%, rgba(150,255,47,.10), transparent 31rem),
        radial-gradient(circle at 88% 8%, rgba(150,255,47,.07), transparent 34rem),
        linear-gradient(180deg, #030706 0%, #020403 100%);
    }

    html[data-gc-scope="marketing"] .gc-profile2 {
      --green:#96ff2f;
      --text:#f4fff1;
      --muted:#74816e;
      --line:rgba(150,255,47,.18);
      --line-soft:rgba(150,255,47,.10);
      --panel:rgba(4,10,6,.91);
      --panel-2:rgba(7,15,9,.86);
      --mono:var(--gc-mono,"JetBrains Mono",monospace);
      position:relative;
      isolation:isolate;
      padding-top:0;
      padding-bottom:clamp(48px, 6vw, 88px);
      color:var(--text);
    }


    html[data-gc-scope="marketing"] .gc-profile2-hero {
      position:relative;
      min-height:clamp(330px, 43vw, 520px);
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(330px, 420px);
      gap:clamp(20px, 4vw, 58px);
      align-items:center;
      padding:clamp(28px, 6vw, 76px);
      overflow:hidden;
      border-bottom:1px solid rgba(150,255,47,.16);
      margin-inline:calc(50% - 50vw);
      padding-inline:calc((100vw - min(1160px, calc(100vw - 32px))) / 2);
    }

    html[data-gc-scope="marketing"] .gc-profile2-hero__bg {
      position:absolute;
      inset:0;
      z-index:-1;
      background:
        linear-gradient(90deg, rgba(3,7,6,.90) 0%, rgba(3,7,6,.82) 38%, rgba(3,7,6,.74) 58%, rgba(3,7,6,.86) 100%),
        radial-gradient(circle at 78% 32%, rgba(150,255,47,.10), transparent 20rem),
        url('/images/perfil.webp') center center / cover no-repeat;
      opacity:1;
    }


    html[data-gc-scope="marketing"] .gc-profile2-hero__copy {
      position:relative;
      z-index:1;
      max-width:640px;
      min-width:0;
    }

    html[data-gc-scope="marketing"] .gc-profile2-eyebrow,
    html[data-gc-scope="marketing"] .gc-profile2-panel__eyebrow,
    html[data-gc-scope="marketing"] .gc-profile2-card-label {
      margin:0;
      color:var(--green);
      font-family:var(--mono);
      font-size:11px;
      font-weight:950;
      letter-spacing:.13em;
      line-height:1;
      text-transform:uppercase;
    }

    html[data-gc-scope="marketing"] .gc-profile2-hero h1 {
      margin:.15em 0 .16em;
      color:var(--text);
      font-size:clamp(64px, 10vw, 128px);
      line-height:.86;
      font-weight:1000;
      letter-spacing:-.075em;
      text-transform:uppercase;
      text-shadow:0 20px 60px rgba(0,0,0,.56);
    }

    html[data-gc-scope="marketing"] .gc-profile2-hero p#profile2Lead {
      max-width:520px;
      margin:0 0 18px;
      color:rgba(244,255,241,.72);
      font-size:clamp(16px, 2vw, 21px);
      line-height:1.35;
    }

    html[data-gc-scope="marketing"] .gc-profile2-statusline,
    html[data-gc-scope="marketing"] .gc-profile2-actions {
      display:flex;
      flex-wrap:wrap;
      align-items:center;
      gap:8px;
    }

    html[data-gc-scope="marketing"] .gc-profile2-driver-card__ratings {
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap:10px;
      margin-top:0;
      margin-bottom:4px;
    }

    html[data-gc-scope="marketing"] .gc-profile2-rating-group {
      display:inline-flex;
      align-items:center;
      gap:6px;
    }


    html[data-gc-scope="marketing"] .gc-profile2 .gc-rating-badge--rating-label .gc-rating-badge__type {
      display:none !important;
    }

    html[data-gc-scope="marketing"] .gc-profile2 .gc-rating-badge--rating-label strong {
      text-transform:uppercase;
    }

    html[data-gc-scope="marketing"] .gc-profile2-actions--hero { margin-top:22px; }

    html[data-gc-scope="marketing"] .gc-profile2-badge {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:26px;
      padding:0 10px;
      border:1px solid rgba(245,248,241,.13);
      background:rgba(5,8,5,.68);
      color:rgba(244,255,241,.78);
      font-family:var(--mono);
      font-size:10px;
      font-weight:900;
      letter-spacing:.08em;
      text-transform:uppercase;
      border-radius:3px;
    }

    html[data-gc-scope="marketing"] .gc-profile2-badge--live,
    html[data-gc-scope="marketing"] .gc-profile2-badge.is-accent,
    html[data-gc-scope="marketing"] .gc-profile2-chip.is-accent {
      border-color:rgba(150,255,47,.34);
      background:rgba(150,255,47,.12);
      color:var(--green);
    }

    html[data-gc-scope="marketing"] .gc-profile2-btn {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-height:42px;
      padding:0 18px;
      border:1px solid rgba(150,255,47,.22);
      border-radius:4px;
      background:rgba(4,9,6,.78);
      color:var(--text);
      font-family:var(--mono);
      font-size:11px;
      font-weight:950;
      letter-spacing:.08em;
      text-transform:uppercase;
      text-decoration:none;
      cursor:pointer;
    }

    html[data-gc-scope="marketing"] .gc-profile2-btn:hover {
      border-color:rgba(150,255,47,.55);
      color:var(--green);
      background:rgba(150,255,47,.08);
    }

    html[data-gc-scope="marketing"] .gc-profile2-btn--primary {
      border-color:rgba(150,255,47,.95);
      background:linear-gradient(90deg, #96ff2f 0%, #baff51 58%, #50e7ff 100%);
      color:#071005;
      box-shadow:0 0 28px rgba(150,255,47,.22);
    }

    html[data-gc-scope="marketing"] .gc-profile2-btn--primary:hover {
      color:#071005;
      filter:brightness(1.05);
    }

    html[data-gc-scope="marketing"] .gc-profile2-btn--wide { width:100%; margin-top:16px; }

    html[data-gc-scope="marketing"] .gc-profile2-driver-card {
      position:relative;
      z-index:1;
      align-self:center;
      display:grid;
      gap:10px;
      padding:16px 18px 18px;
      border:1px solid var(--line);
      border-radius:10px;
      background:
        radial-gradient(circle at 96% 0%, rgba(150,255,47,.10), transparent 12rem),
        linear-gradient(180deg, rgba(9,17,11,.90), rgba(2,6,4,.96));
      box-shadow:0 20px 70px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.035);
    }


    html[data-gc-scope="marketing"] .gc-profile2-driver-card__avatar {
      position:relative;
      width:100%;
      height:clamp(112px, 13vw, 154px);
      overflow:visible;
      display:grid;
      place-items:center;
      background:transparent;
    }

    html[data-gc-scope="marketing"] .gc-profile2-avatar {
      width:104px;
      height:104px;
      border-radius:999px;
      object-fit:cover;
      border:2px solid rgba(150,255,47,.62);
      box-shadow:0 0 0 7px rgba(150,255,47,.08), 0 0 38px rgba(150,255,47,.18);
      background:#050905;
    }

    html[data-gc-scope="marketing"] .gc-profile2-driver-card__avatar span {
      position:absolute;
      right:calc(50% - 53px);
      bottom:calc(50% - 51px);
      width:16px;
      height:16px;
      border:2px solid #071005;
      border-radius:999px;
      background:var(--green);
      box-shadow:0 0 22px rgba(150,255,47,.72);
    }

    html[data-gc-scope="marketing"] .gc-profile2-team-lockup,
    html[data-gc-scope="marketing"] .gc-profile2-team-mini,
    html[data-gc-scope="marketing"] .gc-profile2-team-plate {
      display:grid;
      grid-template-columns:auto minmax(0,1fr);
      align-items:center;
      gap:12px;
      min-width:0;
    }

    html[data-gc-scope="marketing"] .gc-profile2-team-lockup {
      margin-top:4px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      gap:8px;
    }

    html[data-gc-scope="marketing"] .gc-profile2-team-lockup img,
    html[data-gc-scope="marketing"] .gc-profile2-team-mini img,
    html[data-gc-scope="marketing"] .gc-profile2-team-plate img {
      width:58px;
      height:58px;
      object-fit:contain;
      border-radius:8px;
      border:1px solid rgba(150,255,47,.18);
      background:rgba(0,0,0,.32);
      padding:6px;
    }

    html[data-gc-scope="marketing"] .gc-profile2-team-lockup img {
      width:52px;
      height:52px;
      border:0;
      border-radius:0;
      background:transparent;
      padding:0;
      filter:drop-shadow(0 0 15px rgba(150,255,47,.22));
    }

    html[data-gc-scope="marketing"] .gc-profile2-team-lockup strong,
    html[data-gc-scope="marketing"] .gc-profile2-team-mini strong,
    html[data-gc-scope="marketing"] .gc-profile2-team-plate strong {
      display:block;
      color:var(--text);
      font-size:clamp(20px, 2.5vw, 31px);
      line-height:.98;
      letter-spacing:-.04em;
      text-transform:uppercase;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    html[data-gc-scope="marketing"] .gc-profile2-team-lockup small,
    html[data-gc-scope="marketing"] .gc-profile2-team-mini small,
    html[data-gc-scope="marketing"] .gc-profile2-team-plate small {
      display:block;
      margin-top:5px;
      color:rgba(244,255,241,.56);
      font-family:var(--mono);
      font-size:10px;
      font-weight:850;
      letter-spacing:.07em;
      text-transform:uppercase;
    }


    html[data-gc-scope="marketing"] .gc-profile2-team-lockup strong {
      font-size:clamp(22px, 2.2vw, 28px);
      text-align:center;
    }

    html[data-gc-scope="marketing"] .gc-profile2-team-lockup small {
      margin-top:4px;
      text-align:center;
    }

    html[data-gc-scope="marketing"] .gc-profile2-pulse {
      display:grid;
      grid-template-columns:170px minmax(0,1fr);
      margin-top:26px;
      border:1px solid rgba(150,255,47,.28);
      background:rgba(3,9,5,.88);
      overflow:hidden;
    }

    html[data-gc-scope="marketing"] .gc-profile2-pulse__title {
      display:flex;
      align-items:center;
      gap:10px;
      min-height:55px;
      padding:0 16px;
      border-right:1px solid rgba(150,255,47,.20);
      background:rgba(150,255,47,.035);
      font-family:var(--mono);
      font-size:12px;
      font-weight:950;
      letter-spacing:.08em;
      text-transform:uppercase;
    }

    html[data-gc-scope="marketing"] .gc-profile2-live-dot {
      width:10px;
      height:10px;
      border-radius:999px;
      background:var(--green);
      box-shadow:0 0 18px rgba(150,255,47,.8);
    }

    html[data-gc-scope="marketing"] .gc-profile2-pulse__track {
