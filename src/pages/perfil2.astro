  </style>
  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const fallbackAvatar = '/images/pilot-avatar-default.png';
      const fallbackTeamLogo = '/images/team-default-gc.svg';

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;'
      }[char]));

      const cleanName = (value, fallback = '-') => {
        if (value === undefined || value === null || value === '') return fallback;
        if (typeof value === 'object') {
          return cleanName(value.displayName ?? value.visibleName ?? value.cleanName ?? value.uiName ?? value.uiCarName ?? value.uiTrackName ?? value.name ?? value.driverName ?? value.playerName ?? value.code, fallback);
        }
        return String(value).replace(/_/g, ' ').replace(/\s+/g, ' ').trim() || fallback;
      };

      const valueAt = (source, path) => {
        if (!source || typeof source !== 'object') return undefined;
        if (Object.prototype.hasOwnProperty.call(source, path)) return source[path];
        return String(path).split('.').reduce((acc, part) => acc == null ? undefined : acc[part], source);
      };

      const firstValue = (source, paths) => {
        for (const path of paths) {
          const value = valueAt(source, path);
          if (value !== undefined && value !== null && value !== '') return value;
        }
        return '';
      };

      const displayFrom = (source, paths, fallback = '-') => cleanName(firstValue(source, paths), fallback);
      const carName = (row) => displayFrom(row, ['carDisplayName','carVisibleName','carName','car.displayName','car.visibleName','car.cleanName','car.uiName','car.uiCarName','car.name','car.code','car'], '-');
      const trackName = (row) => displayFrom(row, ['trackDisplayName','trackVisibleName','trackName','track.displayName','track.visibleName','track.cleanName','track.uiName','track.uiTrackName','track.name','track.code','track'], '-');
      const pilotName = (pilot, fallback = 'Piloto') => displayFrom(pilot, ['displayName','visibleName','cleanName','name','driverName','playerName','strackerName'], fallback);

      const fmtMs = (ms) => {
        const n = Number(ms);
        if (!Number.isFinite(n) || n <= 0) return '--';
        const m = Math.floor(n / 60000);
        const s = Math.floor((n % 60000) / 1000);
        const x = String(Math.floor(n % 1000)).padStart(3, '0');
        return `${m}:${String(s).padStart(2, '0')}.${x}`;
      };

      const lapTime = (lap) => cleanName(firstValue(lap, ['lapTimeFormatted','lapTime','bestLapTimeFormatted','bestLap','bestTime']), '') || fmtMs(firstValue(lap, ['lapTimeMs','bestLapMs','LapTime']));
      const fmtSpeed = (value) => Number.isFinite(Number(value)) && Number(value) > 0 ? `${Math.round(Number(value))} km/h` : '--';
      const fmtNumber = (value) => Number.isFinite(Number(value)) ? new Intl.NumberFormat('es-ES').format(Number(value)) : '--';

      const fmtDate = (value) => {
        if (value === undefined || value === null || value === '') return '--';
        let ms = 0;
        if (typeof value === 'number') ms = value > 20000000000 ? value : value * 1000;
        else {
          const raw = String(value).trim();
          if (/^\d+$/.test(raw)) {
            const numeric = Number(raw);
            ms = numeric > 20000000000 ? numeric : numeric * 1000;
          } else {
            ms = new Date(raw).getTime();
            if (!Number.isFinite(ms)) ms = new Date(raw.replace(' ', 'T')).getTime();
          }
        }
        if (!Number.isFinite(ms) || ms <= 0) return '--';
        return new Date(ms).toLocaleString('es-ES', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
      };

      const cleanRate = (valid, total) => {
        const v = Number(valid || 0);
        const t = Number(total || 0);
        if (!t) return '--';
        return `${Math.round((v / t) * 1000) / 10}%`;
      };

      const ratingClassKey = (value) => String(value || 'unknown')
        .trim().toLowerCase().replace('+', 'plus').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'unknown';

      const normalizeClassValue = (value) => String(value || '--').trim().toUpperCase();

      const ratingMeta = (type, value) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const raw = normalizeClassValue(value);
        if (safeType === 'gsr') {
          if (raw === 'S' || raw === 'DIAMOND') return { key:'s', value:'S', label:'Diamond' };
          if (raw === 'A' || raw === 'RUBY') return { key:'a', value:'A', label:'Ruby' };
          if (raw === 'B' || raw === 'SAPPHIRE') return { key:'b', value:'B', label:'Sapphire' };
          if (raw === 'C' || raw === 'EMERALD') return { key:'c', value:'C', label:'Emerald' };
          if (raw === 'D' || raw === 'AMBER') return { key:'d', value:'D', label:'Amber' };
          return { key:'rookie', value:raw && raw !== '--' ? raw : '--', label:raw && raw !== '--' ? raw : 'Onyx' };
        }
        if (raw === 'A+' || raw === 'APLUS' || raw === 'LEGEND') return { key:'aplus', value:'A+', label:'Legend' };
        if (raw === 'A' || raw === 'ELITE') return { key:'a', value:'A', label:'Elite' };
        if (raw === 'B' || raw === 'PRO') return { key:'b', value:'B', label:'Pro' };
        if (raw === 'C' || raw === 'ADVANCED') return { key:'c', value:'C', label:'Advanced' };
        if (raw === 'D' || raw === 'ROOKIE') return { key:'d', value:'D', label:'Rookie' };
        if (raw === 'E' || raw === 'PITLANE') return { key:'e', value:'E', label:'Pitlane' };
        return { key:'unknown', value:'--', label:'--' };
      };

      const fmtRatingScore = (type, score) => {
        const n = Number(score);
        if (!Number.isFinite(n)) return '--';
        return String(type).toLowerCase() === 'gsr' ? String(Math.round(n)) : String(Math.round(n * 10) / 10);
      };

      const ratingScoreBadge = (type, value, score = null) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const meta = ratingMeta(safeType, value);
        const scoreText = score !== null && score !== undefined && score !== '' ? fmtRatingScore(safeType, score) : safeType.toUpperCase();
        return `<span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${meta.key} gc-rating-badge--compact" aria-label="${safeType.toUpperCase()} ${escapeHtml(scoreText)} ${escapeHtml(meta.value)}"><span class="gc-rating-badge__type">${escapeHtml(scoreText)}</span><strong>${escapeHtml(meta.value)}</strong></span>`;
      };

      const ratingClassBadge = (type, value) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'gsr' : 'sr';
        const meta = ratingMeta(safeType, value);
        return `<span class="gc-rating-badge gc-rating-badge--${safeType} gc-rating-badge--${safeType}-${meta.key} gc-rating-badge--compact gc-rating-badge--rating-label" aria-label="Clase ${escapeHtml(meta.label)}"><strong>${escapeHtml(meta.label)}</strong></span>`;
      };

      const ratingPair = (type, value, score = null) => {
        const safeType = String(type || '').toLowerCase() === 'gsr' ? 'GSR' : 'SR';
        return `<span class="gc-profile2-rating-pair"><span class="gc-profile2-rating-title">${safeType}</span>${ratingScoreBadge(type, value, score)}${ratingClassBadge(type, value)}</span>`;
      };

      const valueRow = (label, valueMarkup, hint = '') => `
        <div class="gc-profile2-data-row">
          <span><b>${escapeHtml(label)}</b>${hint ? `<small>${escapeHtml(hint)}</small>` : ''}</span>
          <strong>${valueMarkup}</strong>
        </div>
      `;

      const teamFromProfileData = (data) => {
        const team = data?.team || data?.user?.team || null;
        return {
          name: String(team?.name || data?.equipo || data?.user?.equipo || data?.teamName || data?.user?.teamName || '').trim(),
          logoUrl: String(team?.logoUrl || team?.logo_equipo || data?.logo_equipo || data?.user?.logo_equipo || data?.teamLogoUrl || data?.user?.teamLogoUrl || '').trim(),
          role: String(team?.role || data?.teamRole || data?.user?.teamRole || '').trim()
        };
      };

      const setText = (id, value) => { const el = $(id); if (el) el.textContent = String(value ?? '--'); };
      const noRows = (cols, text) => `<tr><td colspan="${cols}">${escapeHtml(text)}</td></tr>`;

      function setTeamImages(url) {
        const safe = url || fallbackTeamLogo;
        ['profile2TeamLogo','profile2TeamLogoMini','profile2TeamLogoPreview'].forEach((id) => {
          const el = $(id);
          if (!el) return;
          el.src = safe;
          el.onerror = () => { el.src = fallbackTeamLogo; };
        });
      }

      function renderTeam(data) {
        const team = teamFromProfileData(data);
        const hasTeam = Boolean(team.name || team.logoUrl);
        const name = team.name || 'Sin equipo';
        const role = team.role || (hasTeam ? 'Piloto' : 'Añade tu escudería');
        const logo = team.logoUrl || fallbackTeamLogo;

        ['profile2TeamName','profile2TeamNameMini','profile2TeamNamePreview'].forEach((id) => setText(id, name));
        ['profile2TeamRole','profile2TeamRoleMini','profile2TeamRolePreview'].forEach((id) => setText(id, role));
        setText('profile2TeamSummaryTitle', hasTeam ? 'Equipo actual.' : 'Sin equipo.');
        setText('profile2TeamSummaryText', hasTeam ? `${name} queda asociado a este perfil para futuras funciones de equipos.` : 'Añade una escudería para preparar participación por equipos.');
        setTeamImages(logo);

        const nameInput = $('profile2TeamNameInput');
        const logoInput = $('profile2TeamLogoInput');
        const roleInput = $('profile2TeamRoleInput');
        if (nameInput) nameInput.value = team.name;
        if (logoInput) logoInput.value = team.logoUrl;
        if (roleInput) roleInput.value = team.role;
      }

      function renderUnauthenticated(data) {
        setText('profile2Name', 'Login requerido');
        setText('profile2Lead', data?.message || 'Entra con tu cuenta para ver tu perfil de piloto.');
        $('profile2Badges').innerHTML = '<span class="gc-profile2-chip">Sesión no activa</span>';
        $('profile2RatingBadges').innerHTML = `<span class="gc-profile2-rating-group">${ratingScoreBadge('sr', '--', null)}${ratingClassBadge('sr', '--')}</span><span class="gc-profile2-rating-group">${ratingScoreBadge('gsr', '--', null)}${ratingClassBadge('gsr', '--')}</span>`;
        ['profile2TotalLaps','profile2BestLap','profile2CleanRate','profile2MaxSpeed','profile2LastLap'].forEach((id) => setText(id, '--'));
        $('profile2RacecraftRows').innerHTML = '<div><span>Estado</span><strong>Login requerido</strong></div>';
        $('profile2PaceRows').innerHTML = '<div><span>Acceso</span><strong><a href="/login">Entrar</a></strong></div>';
        $('profile2ActivityList').innerHTML = '<div class="gc-profile2-state">Inicia sesión para cargar tus vueltas, ratings y datos de equipo.</div>';
        $('profile2HotlapsBody').innerHTML = noRows(6, 'Inicia sesión para ver hotlaps.');
        $('profile2AccountRows').innerHTML = '<div><span>Sesión</span><strong>No activa</strong></div>';
      }

      function renderProfile(data) {
        const user = data.user || {};
        const pilot = data.pilot || {};
        const summary = data.summary || {};
        const ratingDriver = data.ratings?.driver || {};
        const ratingStats = data.ratings?.stats || {};
        const linkedPlayerId = pilot.id || data.pilotLink?.playerId || null;
        const name = data.linked ? pilotName(pilot, cleanName(user.displayName, 'Piloto')) : cleanName(user.displayName, 'Cuenta GC');
        const team = teamFromProfileData(data);

        setText('profile2Name', name);
        setText('profile2Lead', data.linked ? `Perfil competitivo desde stracker${team.name ? ' · ' + team.name : ''}.` : 'Cuenta activa, pendiente de vincular a un piloto real.');

        const avatar = $('profile2Avatar');
        if (avatar) {
          avatar.src = linkedPlayerId ? `/api/pilot-avatar/${encodeURIComponent(String(linkedPlayerId))}` : fallbackAvatar;
          avatar.onerror = () => { avatar.src = fallbackAvatar; };
        }

        $('profile2Badges').innerHTML = [
          `<span class="gc-profile2-chip is-accent">${escapeHtml(cleanName(user.role, 'pilot'))}</span>`,
          `<span class="gc-profile2-chip">${escapeHtml(data.linked ? 'Piloto vinculado' : 'Sin piloto vinculado')}</span>`,
          `<span class="gc-profile2-chip${team.name ? ' is-accent' : ''}">${escapeHtml(team.name ? 'Equipo · ' + team.name : 'Sin equipo')}</span>`
        ].join('');


        $('profile2RatingBadges').innerHTML = `<span class="gc-profile2-rating-group">${ratingScoreBadge('sr', ratingDriver.srClass || '--', ratingDriver.srScore ?? null)}${ratingClassBadge('sr', ratingDriver.srClass || '--')}</span><span class="gc-profile2-rating-group">${ratingScoreBadge('gsr', ratingDriver.gsrClass || '--', ratingDriver.gsrRating ?? null)}${ratingClassBadge('gsr', ratingDriver.gsrClass || '--')}</span>`;

        setText('profile2TotalLaps', fmtNumber(summary.totalLaps || 0));
        setText('profile2BestLap', lapTime(summary.bestLap));
        setText('profile2CleanRate', summary.cleanRate !== undefined ? `${summary.cleanRate}%` : cleanRate(summary.validLaps, summary.totalLaps));
        setText('profile2MaxSpeed', fmtSpeed(summary.maxSpeedKmh));
        setText('profile2LastLap', fmtDate(summary.lastSeenAt || summary.lastActivityAt || summary.latestLapAt));

        renderTeam(data);

        const publicLink = $('profile2PublicLink');
        if (publicLink) {
          publicLink.hidden = !data.linked || !linkedPlayerId;
          if (data.linked && linkedPlayerId) publicLink.href = `/pilotos/${encodeURIComponent(String(linkedPlayerId))}`;
        }

        const totalLaps = Number(summary.totalLaps || 0);
        const validLaps = Number(summary.validLaps || 0);
        const invalidLaps = Math.max(0, totalLaps - validLaps);
        const cleanPct = summary.cleanRate !== undefined ? `${summary.cleanRate}%` : cleanRate(validLaps, totalLaps);
        const cleanRaces = Number(ratingStats.cleanRaces ?? 0);
        const raceCount = ratingStats.races ?? ratingStats.ratingRaces ?? ratingStats.totalRaces ?? summary.ratingRaces ?? '';
        const raceCountText = raceCount !== '' && raceCount !== null && raceCount !== undefined ? ` / ${fmtNumber(raceCount)}` : '';

        $('profile2RacecraftRows').innerHTML = [
          valueRow('Limpieza', escapeHtml(cleanPct), `${fmtNumber(validLaps)} válidas de ${fmtNumber(totalLaps)} vueltas`),
          valueRow('Vueltas no válidas', escapeHtml(fmtNumber(invalidLaps)), 'referencia directa para mejorar consistencia'),
          valueRow('Incidencias / carrera', escapeHtml(ratingStats.incidentsPerRace ?? '--'), 'media en carreras rating'),
          valueRow('Carreras limpias', `${escapeHtml(fmtNumber(cleanRaces))}${escapeHtml(raceCountText)}`, 'carreras sin penalización relevante'),
          valueRow('Cortes totales', escapeHtml(fmtNumber(summary.totalCuts ?? 0)), 'track limits acumulados')
        ].join('');

        const rank = summary.bestRank ? `${summary.bestRank.position}/${summary.bestRank.total}` : '--';
        $('profile2PaceRows').innerHTML = [
          valueRow('Ranking global', escapeHtml(rank), 'posición por mejor vuelta registrada'),
          valueRow('Mejor vuelta', escapeHtml(lapTime(summary.bestLap)), 'mejor tiempo personal'),
          valueRow('Media Top 10', escapeHtml(summary.best10Average || '--'), 'ritmo medio de tus 10 mejores vueltas'),
          valueRow('Delta Top 10', escapeHtml(summary.best10Delta || '--'), 'distancia respecto a tu referencia top'),
          valueRow('Victorias / Podios', `${escapeHtml(fmtNumber(ratingStats.wins ?? 0))} / ${escapeHtml(fmtNumber(ratingStats.podiums ?? 0))}`, 'resultado en carreras rating'),
          valueRow('Coche favorito', escapeHtml(carName(summary.favoriteCar || {})), 'coche con más peso en tu historial'),
          valueRow('Circuito favorito', escapeHtml(trackName(summary.favoriteTrack || {})), 'circuito más representativo')
        ].join('');

        const recent = Array.isArray(data.recentLaps) ? data.recentLaps : [];
        $('profile2ActivityList').innerHTML = recent.length
          ? recent.slice(0, 5).map((lap) => `
            <div class="gc-profile2-activity-row">
              <div>
                <strong>${escapeHtml(trackName(lap))}</strong>
                <span>${escapeHtml(carName(lap))} · ${escapeHtml(lapTime(lap))} · ${lap.valid ? 'válida' : 'no válida'}</span>
              </div>
              <small class="gc-profile2-activity-time">${escapeHtml(fmtDate(lap.timestampIso || lap.createdAt || lap.dateIso))}</small>
            </div>
          `).join('')
          : '<div class="gc-profile2-state">Sin vueltas recientes.</div>';

        const combos = Array.isArray(data.bestCombos) ? data.bestCombos : [];
        $('profile2HotlapsBody').innerHTML = combos.length
          ? combos.slice(0, 20).map((lap, index) => `
            <tr>
              <td>${index + 1}</td>
              <td>${escapeHtml(carName(lap))}</td>
              <td>${escapeHtml(trackName(lap))}</td>
              <td><strong>${escapeHtml(lapTime(lap))}</strong></td>
              <td>${lap.rank ? `${escapeHtml(lap.rank.position)}/${escapeHtml(lap.rank.total)}` : '--'}</td>
              <td>${escapeHtml(cleanRate(lap.validLaps, lap.totalLaps))}</td>
            </tr>
          `).join('')
          : noRows(6, 'Sin combos válidos todavía.');

        const rawGuid = String(pilot.steamGuid || data.pilotLink?.steamGuid || '');
        const shortGuid = rawGuid ? `${rawGuid.slice(0, 12)}...${rawGuid.slice(-8)}` : '--';
        $('profile2AccountRows').innerHTML = [
          `<div><span>Email</span><strong>${escapeHtml(user.email || '--')}</strong></div>`,
          `<div><span>Rol</span><strong>${escapeHtml(cleanName(user.role, 'pilot'))}</strong></div>`,
          `<div><span>Player ID</span><strong>${escapeHtml(linkedPlayerId || '--')}</strong></div>`,
          `<div><span>Steam GUID</span><strong title="${escapeHtml(rawGuid)}">${escapeHtml(shortGuid)}</strong></div>`,
          `<div><span>Vínculo</span><strong>${escapeHtml(fmtDate(data.pilotLink?.linkedAt))}</strong></div>`
        ].join('');
      }

      function setTeamMessage(text, tone = '') {
        const el = $('profile2TeamMessage');
        if (!el) return;
        el.textContent = text || '';
        el.style.color = tone === 'ok' ? '#96ff2f' : tone === 'error' ? '#ff5757' : 'rgba(232,241,224,.68)';
      }

      async function saveTeam(clear = false) {
        const payload = clear ? { equipo: '', logo_equipo: '', teamRole: '' } : {
          equipo: $('profile2TeamNameInput')?.value || '',
          logo_equipo: $('profile2TeamLogoInput')?.value || '',
          teamRole: $('profile2TeamRoleInput')?.value || ''
        };

        ['profile2SaveTeam','profile2ClearTeam','profile2TeamNameInput','profile2TeamLogoInput','profile2TeamRoleInput'].forEach((id) => {
          const el = $(id);
          if (el) el.disabled = true;
        });
        setTeamMessage(clear ? 'Quitando equipo...' : 'Guardando equipo...');

        try {
          const response = await fetch('/api/profile/team', {
            method:'POST',
            credentials:'include',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result?.ok === false) throw new Error(result?.message || 'No se pudo actualizar el equipo.');
          await loadProfile();
          setTeamMessage(clear ? 'Equipo eliminado.' : 'Equipo guardado.', 'ok');
        } catch (error) {
          setTeamMessage(error.message || 'No se pudo actualizar el equipo.', 'error');
        } finally {
          ['profile2SaveTeam','profile2ClearTeam','profile2TeamNameInput','profile2TeamLogoInput','profile2TeamRoleInput'].forEach((id) => {
            const el = $(id);
            if (el) el.disabled = false;
          });
        }
      }

      async function loadProfile() {
        const response = await fetch('/api/profile', { credentials:'include', cache:'no-store' });
        const data = await response.json().catch(() => ({}));
        if (!data.ok && data.authenticated === false) renderUnauthenticated(data);
        else renderProfile(data);
      }

      document.querySelectorAll('[data-profile2-tab]').forEach((button) => {
        button.addEventListener('click', () => {
          const tab = button.getAttribute('data-profile2-tab');
          document.querySelectorAll('[data-profile2-tab]').forEach((item) => item.classList.toggle('is-active', item === button));
          document.querySelectorAll('[data-profile2-panel]').forEach((panel) => {
            const active = panel.getAttribute('data-profile2-panel') === tab;
            panel.hidden = !active;
            panel.classList.toggle('is-active', active);
          });
        });
      });

      document.querySelectorAll('[data-profile2-tab-jump]').forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.getAttribute('data-profile2-tab-jump');
          document.querySelector(`[data-profile2-tab="${target}"]`)?.click();
        });
      });

      ['profile2TeamNameInput','profile2TeamLogoInput','profile2TeamRoleInput'].forEach((id) => {
        const el = $(id);
        if (!el) return;
        el.addEventListener('input', () => {
          const name = $('profile2TeamNameInput')?.value || 'Sin equipo';
          const logo = $('profile2TeamLogoInput')?.value || fallbackTeamLogo;
          const role = $('profile2TeamRoleInput')?.value || 'Piloto';
          setText('profile2TeamNamePreview', name);
          setText('profile2TeamRolePreview', role);
          const img = $('profile2TeamLogoPreview');
          if (img) img.src = logo;
        });
      });

      $('profile2SaveTeam')?.addEventListener('click', () => saveTeam(false));
      $('profile2ClearTeam')?.addEventListener('click', () => saveTeam(true));

      loadProfile().catch((error) => {
        setText('profile2Name', 'Error');
        setText('profile2Lead', error.message || 'No se pudo cargar el perfil.');
        $('profile2ActivityList').innerHTML = '<div class="gc-profile2-state">No se pudo cargar /api/profile.</div>';
      });
    })();
  </script>
</MarketingLayout>
