---
export const prerender = false;

import MarketingLayout from '../../layouts/MarketingLayout.astro';
import PublicHeroFrame from '../../components/public/PublicHeroFrame.astro';
import '../../styles/home2.css';
import '../../styles/archive-home2-polish.css';
import '../../styles/archive-home-cleanup-v1.css';
import {
  archiveItemHref,
  archiveTypeHref,
  getArchiveCountry,
  getArchiveImage,
  getArchivePeriod,
  getArchiveStats,
  getArchiveSummary,
  prettifyArchiveType,
  singularArchiveType,
} from '../../lib/archive/archiveRuntime';

const stats = await getArchiveStats();
const items = stats.items || [];
const types = (stats.types || []).filter((type) => ['circuitos', 'coches', 'pilotos', 'glosario'].includes(type.tipo));

const itemsWithImage = items.filter((item) => getArchiveImage(item));
const featuredCandidates = itemsWithImage.length ? itemsWithImage : items;
const initialFeaturedIndex = featuredCandidates.length ? Math.floor(Math.random() * featuredCandidates.length) : -1;
const featured = initialFeaturedIndex >= 0 ? featuredCandidates[initialFeaturedIndex] : null;

const featuredClientPayload = featuredCandidates.map((item) => ({
  slug: item.slug,
  nombre: item.nombre,
  tipo: item.tipo,
  tipoLabel: singularArchiveType(item.tipo),
  href: archiveItemHref(item),
  image: getArchiveImage(item),
  imageAlt: item.coverAlt || item.imagen_alt || item.nombre,
  summary: getArchiveSummary(item) || 'Entrada destacada de la base de datos motorsport.',
  country: getArchiveCountry(item) || '',
  period: getArchivePeriod(item) || '',
}));

const heroImage = featured ? getArchiveImage(featured) : '';
const heroStyle = heroImage ? `--archive-hero-image:url('${String(heroImage).replace(/'/g, '%27')}');` : '';

const pageTitle = 'Archivo GrassCutters | Base de datos de motorsport';
const pageDescription = 'Base de datos editorial de motorsport con fichas de circuitos, coches, pilotos, conceptos técnicos, historia y cultura racing.';
---

<MarketingLayout
  bodyClass="gc-archive-public"
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/archivo/"
  ogImage="/og/archivo-og.png"
  ogImageAlt="Archivo GrassCutters Racing"
>
  <main class="gc-archive-home2" data-archive-home>
    <section class={`gc-archive-race-hero ${heroImage ? 'has-image' : ''}`} style={heroStyle} data-archive-hero-section>
      <div class="gc-archive-shell gc-archive-race-hero__grid">
        <div>
          <PublicHeroFrame
            id="archiveHeroTitle"
            kicker="GRASSCUTTERS DATABASE"
            title={['Archivo']}
            lead="Base de datos editorial sobre motorsport: circuitos, coches, pilotos, conceptos técnicos, historia y cultura racing organizada para consultar y ampliar contexto."
          />

          <div class="gc-archive-statusline">
            <span class="gc-archive-badge">Motorsport database</span>
            <span class="gc-archive-badge">Fichas editoriales</span>
            <span class="gc-archive-badge">Historia y técnica</span>
          </div>

          <form class="gc-archive-search" role="search" aria-label="Buscar en el archivo">
            <label for="archiveHomeSearch">Buscar en el archivo</label>
            <div>
              <input
                id="archiveHomeSearch"
                type="search"
                placeholder="Mugello, GT2, piloto, motor, trazado..."
                data-archive-search-input
                autocomplete="off"
              />
              <button type="button" data-archive-clear>Limpiar</button>
            </div>
            <small><span data-archive-result-count>{items.length}</span> fichas visibles</small>
          </form>
        </div>

        <aside class="gc-archive-command-card" aria-label="Resumen del archivo">
          <span>Base de datos</span>
          <strong>{items.length}</strong>
          <small>fichas publicadas</small>

          <div class="gc-archive-command-grid">
            {types.map((type) => (
              <a href={archiveTypeHref(type.tipo)}>
                <small>{type.label}</small>
                <strong>{type.count}</strong>
              </a>
            ))}
          </div>
        </aside>
      </div>
    </section>

    {featured && (
      <section class="gc-archive-shell gc-archive-section" data-archive-featured>
        <article class="gc-archive-spotlight">
          <div class="gc-archive-spotlight__copy">
            <span class="gc-archive-panel__eyebrow">Ficha destacada</span>
            <h2 data-archive-featured-title>{featured.nombre}</h2>
            <p data-archive-featured-summary>{getArchiveSummary(featured) || 'Entrada destacada de la base de datos motorsport.'}</p>

            <dl>
              <div>
                <dt>Ficha</dt>
                <dd data-archive-featured-type>{singularArchiveType(featured.tipo)}</dd>
              </div>
              {getArchiveCountry(featured) && (
                <div data-archive-featured-country-wrap>
                  <dt>Origen</dt>
                  <dd data-archive-featured-country>{getArchiveCountry(featured)}</dd>
                </div>
              )}
              {getArchivePeriod(featured) && (
                <div data-archive-featured-period-wrap>
                  <dt>Periodo</dt>
                  <dd data-archive-featured-period>{getArchivePeriod(featured)}</dd>
                </div>
              )}
            </dl>

            <a href={archiveItemHref(featured)} data-archive-featured-link>Abrir ficha</a>
          </div>

          {getArchiveImage(featured) ? (
            <figure data-archive-featured-figure>
              <img src={getArchiveImage(featured)} alt={featured.coverAlt || featured.imagen_alt || featured.nombre} loading="eager" data-archive-featured-image />
            </figure>
          ) : (
            <div class="gc-archive-spotlight__mark" data-archive-featured-mark>
              <span>{singularArchiveType(featured.tipo)}</span>
              <strong>{featured.nombre}</strong>
            </div>
          )}
        </article>
      </section>
    )}

    <section class="gc-archive-shell gc-archive-section gc-archive-section--panel" id="archivo-catalogo">
      <div class="gc-archive-section-head">
        <div>
          <span>Catálogo</span>
          <h2>Todas las fichas</h2>
        </div>
        <p>Explora la base de datos por categoría o busca por título, país, época, motor, equipo, trazado, piloto o concepto técnico.</p>
      </div>

      <div class="gc-archive-filter-row" aria-label="Filtros del archivo">
        <button type="button" class="is-active" data-archive-type="all">Todo</button>
        {types.map((type) => (
          <button type="button" data-archive-type={type.tipo}>{type.label}</button>
        ))}
      </div>

      {items.length ? (
        <div class="gc-archive-grid" data-archive-results>
          {items.map((item) => (
            <a
              class="gc-archive-card"
              href={archiveItemHref(item)}
              data-archive-card
              data-type={item.tipo}
              data-search={`${item.nombre} ${item.slug} ${item.tipo} ${prettifyArchiveType(item.tipo)} ${getArchiveSummary(item)} ${getArchiveCountry(item)} ${getArchivePeriod(item)} ${item.tags || ''} ${item.fabricante || ''} ${item.motor || ''} ${item.disciplina || ''}`}
            >
              {getArchiveImage(item) ? (
                <img src={getArchiveImage(item)} alt={item.coverAlt || item.imagen_alt || item.nombre} loading="lazy" />
              ) : (
                <span class="gc-archive-card__mark">{singularArchiveType(item.tipo)}</span>
              )}

              <div>
                <small>{prettifyArchiveType(item.tipo)}</small>
                <strong>{item.nombre}</strong>
                <p>{getArchiveSummary(item) || 'Ficha editorial de la base de datos motorsport.'}</p>
                <footer>
                  {getArchiveCountry(item) && <em>{getArchiveCountry(item)}</em>}
                  {getArchivePeriod(item) && <em>{getArchivePeriod(item)}</em>}
                  <b>Abrir</b>
                </footer>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="gc-archive-empty">
          <strong>Aún no hay fichas publicadas.</strong>
          <p>Cuando publiques fichas desde el admin aparecerán aquí automáticamente.</p>
        </div>
      )}

      <div class="gc-archive-empty" data-archive-empty hidden>
        <strong>No hay resultados.</strong>
        <p>Prueba con otro término o limpia los filtros.</p>
      </div>
    </section>
  </main>

  <script type="application/json" id="archive-featured-data" set:html={JSON.stringify(featuredClientPayload)} />

  <script>
    const root = document.querySelector('[data-archive-home]');
    const input = root?.querySelector('[data-archive-search-input]');
    const clearBtn = root?.querySelector('[data-archive-clear]');
    const cards = [...root?.querySelectorAll('[data-archive-card]') || []];
    const count = root?.querySelector('[data-archive-result-count]');
    const empty = root?.querySelector('[data-archive-empty]');
    const typeButtons = [...root?.querySelectorAll('button[data-archive-type]') || []];

    let activeType = 'all';

    function normalize(value) {
      return String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function setActiveType(value) {
      activeType = value;
      typeButtons.forEach((button) => {
        const selected = button.dataset.archiveType === value;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    }

    function applyFilters() {
      const query = normalize(input?.value || '');
      let visible = 0;

      cards.forEach((card) => {
        const typeOk = activeType === 'all' || card.dataset.type === activeType;
        const textOk = !query || normalize(card.dataset.search).includes(query);
        const show = typeOk && textOk;
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    }

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActiveType(button.dataset.archiveType || 'all');
        applyFilters();
      });
    });

    clearBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      setActiveType('all');
      applyFilters();
      input?.focus();
    });

    function pickFeatured(candidates) {
      if (!Array.isArray(candidates) || candidates.length < 2) return candidates?.[0] || null;

      const previous = window.sessionStorage?.getItem('gcArchiveFeaturedSlug') || '';
      const pool = candidates.filter((item) => item && item.slug !== previous);
      const source = pool.length ? pool : candidates;
      const next = source[Math.floor(Math.random() * source.length)] || candidates[0];
      if (next?.slug) window.sessionStorage?.setItem('gcArchiveFeaturedSlug', next.slug);
      return next;
    }

    function renderFeatured(item) {
      if (!item) return;

      const hero = root?.querySelector('[data-archive-hero-section]');
      const title = root?.querySelector('[data-archive-featured-title]');
      const summary = root?.querySelector('[data-archive-featured-summary]');
      const type = root?.querySelector('[data-archive-featured-type]');
      const country = root?.querySelector('[data-archive-featured-country]');
      const countryWrap = root?.querySelector('[data-archive-featured-country-wrap]');
      const period = root?.querySelector('[data-archive-featured-period]');
      const periodWrap = root?.querySelector('[data-archive-featured-period-wrap]');
      const link = root?.querySelector('[data-archive-featured-link]');
      const image = root?.querySelector('[data-archive-featured-image]');

      if (title) title.textContent = item.nombre || 'Ficha destacada';
      if (summary) summary.textContent = item.summary || 'Entrada destacada de la base de datos motorsport.';
      if (type) type.textContent = item.tipoLabel || item.tipo || 'Ficha';
      if (country) country.textContent = item.country || '';
      if (countryWrap) countryWrap.hidden = !item.country;
      if (period) period.textContent = item.period || '';
      if (periodWrap) periodWrap.hidden = !item.period;
      if (link && item.href) link.setAttribute('href', item.href);

      if (image && item.image) {
        image.setAttribute('src', item.image);
        image.setAttribute('alt', item.imageAlt || item.nombre || 'Ficha destacada');
      }

      if (hero && item.image) {
        hero.classList.add('has-image');
        hero.style.setProperty('--archive-hero-image', `url("${String(item.image).replace(/"/g, '%22')}")`);
      }
    }

    try {
      const featuredData = JSON.parse(document.getElementById('archive-featured-data')?.textContent || '[]');
      renderFeatured(pickFeatured(featuredData));
    } catch (error) {
      console.warn('[GC Archivo] No se pudo rotar la ficha destacada', error);
    }

    applyFilters();
  </script>
</MarketingLayout>
