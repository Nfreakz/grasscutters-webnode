# GrassCutters WebNode — ejemplo sin secretos reales

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_SITE_URL=http://localhost:4321

# Runtime / almacenamiento
APP_STORAGE_DRIVER=json
APP_DATA_DIR=./data
APP_USERS_PATH=./data/app/users.json
APP_SQLITE_PATH=./data/app/gc-local.sqlite

# MySQL/MariaDB (recomendado en producción)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5

# Auth
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_DAYS=14
AUTH_SESSION_TOUCH_SECONDS=300
AUTH_COOKIE_SECURE=auto
ADMIN_SETUP_SECRET=

# Proxy y seguridad
# En Hostinger suele ser 1, pero debe confirmarse con la infraestructura.
GC_TRUST_PROXY_HOPS=0
GC_ALLOWED_ORIGINS=http://localhost:4321
GC_PUBLIC_API_RATE_MAX=600
GC_PUBLIC_API_RATE_WINDOW_MS=60000
GC_EXPOSE_DIAGNOSTICS_IN_PRODUCTION=false
GC_HTTP_LOG_ENABLED=false
GC_HTTP_LOG_SLOW_MS=500

# Analítica propia sin cookies
GC_ANALYTICS_ENABLED=false
GC_ANALYTICS_RETENTION_DAYS=90
GC_ANALYTICS_ACTIVE_MINUTES=5
GC_ANALYTICS_DEDUP_SECONDS=15
GC_ANALYTICS_TIME_ZONE=Europe/Madrid
GC_ANALYTICS_HASH_SECRET=
GC_ANALYTICS_FILE_PATH=./data/app/analytics-pageviews.ndjson

GC_COOP_ENABLED=false
GC_CSP_REPORT_ONLY=

# sTracker principal
STRACKER_DB_PATH=./data/stracker/stracker.db3
STRACKER_AUTO_SYNC_ENABLED=false
STRACKER_AUTO_SYNC_INTERVAL_MINUTES=5
STRACKER_AUTO_SYNC_INITIAL_DELAY_SECONDS=30
STRACKER_AUTO_SYNC_SOURCES=all
STRACKER_SYNC_SECRET=
STRACKER_SFTP_HOST=
STRACKER_SFTP_PORT=22
STRACKER_SFTP_USER=
STRACKER_SFTP_PASSWORD=
STRACKER_SFTP_REMOTE_PATH=

# sTracker GT4
GT4_STRACKER_DB_PATH=./data/stracker/stracker-gt4.db3
GT4_STRACKER_SFTP_HOST=
GT4_STRACKER_SFTP_PORT=22
GT4_STRACKER_SFTP_USER=
GT4_STRACKER_SFTP_PASSWORD=
GT4_STRACKER_SFTP_REMOTE_PATH=

# ACSM principal
ACSM_BASE_URL=
ACSM_CHAMPIONSHIP_ID=
ACSM_CHAMPIONSHIP_SIGNUP_URL=
ACSM_CHAMPIONSHIP_ENABLED=true
ACSM_CHAMPIONSHIP_CACHE_SECONDS=60
ACSM_SFTP_HOST=
ACSM_SFTP_PORT=22
ACSM_SFTP_USER=
ACSM_SFTP_PASSWORD=

# ACSM GT4
ACSM_GT4_BASE_URL=
ACSM_GT4_CHAMPIONSHIP_ID=
ACSM_GT4_CHAMPIONSHIP_SIGNUP_URL=
ACSM_GT4_CHAMPIONSHIP_ENABLED=true
ACSM_GT4_CHAMPIONSHIP_CACHE_SECONDS=60

# Ratings
GC_ENABLE_MANUAL_STRACKER_RATINGS=false
GC_SR_MIN_STRACKER_MATCH_CONFIDENCE=0.55
GC_INTERNAL_BASE_URL=http://127.0.0.1:3000

# Avatares
PILOT_AVATAR_MAX_BYTES=2500000
PILOT_AVATAR_STORE_PATH=./data/app/pilot-avatars.json
PILOT_AVATAR_DIR=./data/app/pilot-avatar-files

# Discord
DISCORD_ENABLED=false
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
